// The game itself, built from its directory one up: the safe point a well makes.
//
// A plain program, not a `tests/` file: under `loft --tests` a `--lib` library's `[c] shim`
// is not opened (loft#2234), and the game draws through `tiles`, which is one.  Run it with
// `loft --lib libs checks/game.loft`; it moves into tests/ when that is fixed.  The first
// climb (levels/first_climb.json) starts the hero at (1, 1) on layer 0; a well is put at (1, 2)
// below it.  Layer 1's ledge runs x 8..11 at y 1, with the void at x 7 over layer 0's floor:
// stepping west off it is a fall of one layer, which costs 1 health.
use tile_world;
use rules;
use game;
use talk;

fn main() {
  assert(game::new_game("..") != null, "the game loads from its directory");
  test_a_well_brings_the_hero_back();
  test_b_twice_goes_back();
  test_a_doomed_save_rolls_back_once();
  test_a_wall_in_front_of_the_hero_is_cut_away();
  test_only_walls_hide_what_the_hero_does_not_see();
  test_the_world_starts_in_the_village();
  test_a_house_door_leads_in_and_back_out();
  test_a_place_left_keeps_its_state();
  test_every_house_has_a_way_back();
  test_what_the_hero_holds_goes_through();
  test_r_in_a_room_is_the_room_as_entered();
  test_floor_text_is_walked_over();
  test_walking_up_to_the_elder();
  test_the_right_hand_acts();
  test_a_potion_is_carried_and_drunk_with_the_keys();
  test_a_fountain_saves_like_a_well();
  test_the_cave_in_with_the_game();
  test_the_alchemist_takes_from_the_sack();
  test_a_torch_at_night_is_seen_going_in();
  test_sables_day_and_trap_in_the_game();
  println("checks/game.loft: 20 passed");
}

// A fresh game on the first climb with a well under the start, the hero having drunk from it.
fn at_the_well(g: game::Game) {
  game::start_level(g, 0);
  tile_world::set_terrain(g.world.w, 1, 2, 0, rules::tr(g.world, "well"));
  game::move(g, 0, 1, false);
}

fn where(g: const game::Game) -> text {
  w = g.world;
  "{w.hero_x},{w.hero_y},{w.hero_z} health {w.health}"
}

// Drinking saves; a fall that takes the last health brings the hero back to the well, with the
// health it had there.
fn test_a_well_brings_the_hero_back() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  at_the_well(g);
  assert(g.has_save && g.note == "SAVED" && where(g) == "1,1,0 health 6", "saved: {where(g)}");
  rules::put_hero(g.world, 8, 1, 1);
  g.world.health = 1;
  game::move(g, -1, 0, false);
  assert(where(g) == "1,1,0 health 6", "back at the well: {where(g)}");
  assert(g.note == "BACK AT WELL", "said so: {g.note}");
}

// B asks first and goes on the second; a move between the two cancels the ask.  A restart
// drops the save, and then B does nothing.
fn test_b_twice_goes_back() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  at_the_well(g);
  game::move(g, 1, 0, false);
  assert(game::back(g) && where(g) == "2,1,0 health 6" && g.note == "BACK? B AGAIN", "asks: {where(g)}");
  game::move(g, 1, 0, false);
  assert(game::back(g) && where(g) == "3,1,0 health 6", "a move cancelled the ask: {where(g)}");
  assert(game::back(g) && where(g) == "1,1,0 health 6", "the second B goes: {where(g)}");
  game::restart(g);
  assert(!g.has_save && !game::back(g), "no well drunk from, no way back");
}

// A doomed save need not brick the game: saved at a second well, a fall takes the last health and
// sends the hero back there; B twice then goes one well further back, which becomes the save — B
// twice again goes there, no further.  A move after a return cancels the further way back.
fn test_a_doomed_save_rolls_back_once() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  at_the_well(g);
  tile_world::set_terrain(g.world.w, 3, 2, 0, rules::tr(g.world, "well"));
  game::move(g, 1, 0, false);
  game::move(g, 1, 0, false);
  game::move(g, 0, 1, false);
  assert(g.note == "SAVED" && g.has_previous && where(g) == "3,1,0 health 6", "the second save: {where(g)}");
  rules::put_hero(g.world, 8, 1, 1);
  g.world.health = 1;
  game::move(g, -1, 0, false);
  assert(where(g) == "3,1,0 health 6" && g.note == "BACK AT WELL", "back at the second well: {where(g)}");
  assert(game::back(g) && g.note == "EARLIER? B AGAIN", "asks for the earlier one: {g.note}");
  assert(game::back(g) && where(g) == "1,1,0 health 6" && g.note == "BACK AT EARLIER WELL",
         "one well further back: {where(g)}");
  assert(!g.has_previous, "and none before it");
  game::move(g, 1, 0, false);
  assert(game::back(g) && game::back(g) && where(g) == "1,1,0 health 6", "B twice: the earlier well is the save now");
  assert(game::back(g) && g.note == "BACK? B AGAIN", "no further: {g.note}");
}

// --- What the picture leaves out (owner): a wall in front of the hero, and what the hero does not
// see past the walls ---

// A clean room for these: layer 0's x 0 .. 9, y 0 .. 4 floor in walls, nothing on layer 1, the
// hero on (1, 1).
fn room(g: game::Game) {
  game::start_level(g, 0);
  g.world.enemies = [];
  tile_world::fill(g.world.w, -1, -1, 10, 5, 0, rules::tr(g.world, "wall"));
  tile_world::fill(g.world.w, 0, 0, 9, 4, 0, rules::tr(g.world, "floor"));
  tile_world::fill(g.world.w, -1, -1, 10, 5, 1, tile_world::VOID);
  for c in tile_world::stacks(g.world.w) {
    while tile_world::top(g.world.w, c.0, c.1, c.2) != 0 { _ = tile_world::take(g.world.w, c.0, c.1, c.2); }
  }
  rules::put_hero(g.world, 1, 1, 0);
}

// The frame `g` draws, its pixels; and how many pixels differ between two frames.
fn frame(g: game::Game) -> vector<i32> {
  game::draw(g);
  tiles::pixels(g.surface, game::COLS * g.look.tile_size, game::ROWS * g.look.tile_size)
}

fn changed(a: const vector<i32>, b: const vector<i32>) -> integer {
  n = 0;
  for i in 0..len(a) { if (a[i] ?? 0) != (b[i] ?? 0) { n += 1; } }
  n
}

// The hero's pixels with a ledge's floor on (1, 2) of layer 1, drawn a row up over the hero, on
// `under` below it — against the frame without the hero's picture.
fn hero_behind(ledge: boolean, under: text) -> integer {
  m = game::new_game("..");
  if !m { return -1; }
  g = m;
  room(g);
  tile_world::set_terrain(g.world.w, 1, 2, 0, rules::tr(g.world, under));
  if ledge { tile_world::set_terrain(g.world.w, 1, 2, 1, rules::tr(g.world, "floor")); }
  with = frame(g);
  g.look.hero = -1;
  changed(with, frame(g))
}

// A ledge on a wall in front of the hero is cut away: the hero is seen as whole as with no ledge
// there.  Over no wall it is not: the hero is hidden by it.
fn test_a_wall_in_front_of_the_hero_is_cut_away() {
  open = hero_behind(false, "wall");
  assert(open > 0 && hero_behind(true, "wall") == open, "a wall in front: cut away");
  assert(hero_behind(true, "floor") < open, "no wall: not cut");
}

// A rat on (6, 1) and a column on x 4 between it and the hero: the rat's pixels (the frame with it
// against the frame without).  A wall column hides it; a door or a tree there does not.  The same
// for a chest there.
fn rat_past(between: text) -> integer {
  m = game::new_game("..");
  if !m { return -1; }
  g = m;
  room(g);
  tile_world::fill(g.world.w, 4, 0, 4, 4, 0, rules::tr(g.world, "wall"));
  if between != "wall" { tile_world::set_terrain(g.world.w, 4, 1, 0, rules::tr(g.world, between)); }
  _ = rules::add_enemy(g.world, "rat", 6, 1, 0);
  with = frame(g);
  g.world.enemies = [];
  changed(with, frame(g))
}

fn chest_past(between: text) -> integer {
  m = game::new_game("..");
  if !m { return -1; }
  g = m;
  room(g);
  tile_world::fill(g.world.w, 4, 0, 4, 4, 0, rules::tr(g.world, "wall"));
  if between != "wall" { tile_world::set_terrain(g.world.w, 4, 1, 0, rules::tr(g.world, between)); }
  tile_world::place(g.world.w, 6, 1, 0, rules::th(g.world, "chest"));
  with = frame(g);
  _ = tile_world::take(g.world.w, 6, 1, 0);
  changed(with, frame(g))
}

fn test_only_walls_hide_what_the_hero_does_not_see() {
  assert(rat_past("wall") == 0, "past a wall: not drawn ({rat_past("wall")})");
  assert(rat_past("door") > 0 && rat_past("tree") > 0, "past a door, a tree: drawn");
  assert(chest_past("wall") == 0 && chest_past("door") > 0, "a chest the same: {chest_past("wall")}, {chest_past("door")}");
}

// --- The world (WORLD.md § The world): the village, a house per room, doors both ways ---

fn world() -> game::Game? {
  m = game::new_game("..");
  if !m { return null; }
  g = m ?? return null;
  if !game::start_world(g, "demo") { return null; }
  g
}

fn at(g: const game::Game) -> text {
  w = g.world;
  "{g.place} {w.hero_x},{w.hero_y},{w.hero_z}"
}

fn walk(g: game::Game, dx: integer, dy: integer, n: integer) {
  for _ in 0..n { game::move(g, dx, dy, false); }
}

fn test_the_world_starts_in_the_village() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  assert(at(g) == "demo 14,19,0", "in the village: {at(g)}");
  assert(len(g.file.doors) == 25 && len(g.file.labels) == 26, "twenty-five houses, each named: {len(g.file.doors)} {len(g.file.labels)}");
}

// Up the road to the stone house and onto its door: the cellar, standing inside its door (1, 3)
// facing into the room; down onto that door: back outside the house, facing away from it.
fn test_a_house_door_leads_in_and_back_out() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, 0, -1, 14);
  assert(at(g) == "demo 14,5,0", "before the door: {at(g)}");
  game::move(g, 0, -1, false);
  assert(at(g) == "the_cellar 1,2,0", "in the cellar: {at(g)}");
  assert(g.world.face_x == 0 && g.world.face_y == -1, "facing into it: {g.world.face_x},{g.world.face_y}");
  game::move(g, 0, 1, false);
  assert(at(g) == "demo 14,5,0", "out again: {at(g)}");
  assert(g.world.face_y == 1, "facing away from the house");
}

// The rock pushed in the cellar is where it was left, after going out and coming back in.
fn test_a_place_left_keeps_its_state() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  rock = rules::thing_id(g.kinds, "rock");
  walk(g, 0, -1, 15);
  assert(tile_world::top(g.world.w, 5, 2, 0) == rock, "the rock at (5, 2)");
  walk(g, 1, 0, 4);
  assert(at(g) == "the_cellar 5,2,0" && tile_world::top(g.world.w, 6, 2, 0) == rock, "pushed to (6, 2): {at(g)}");
  walk(g, -1, 0, 4);
  game::move(g, 0, 1, false);
  assert(g.place == "demo", "out: {at(g)}");
  game::move(g, 0, -1, false);
  assert(at(g) == "the_cellar 1,2,0", "back in: {at(g)}");
  assert(tile_world::top(g.world.w, 6, 2, 0) == rock && tile_world::top(g.world.w, 5, 2, 0) == 0,
         "the rock where it was left");
}

// Every door of the village leads into a place with a door back to it, and that door brings the
// hero out in front of the house it went into.
fn test_every_house_has_a_way_back() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  n = len(g.file.doors);
  for i in 0..n {
    to = g.file.doors[i]!.to;
    x = g.file.doors[i]!.x;
    y = g.file.doors[i]!.y;
    assert(game::go_through(g, i), "door {i} leads somewhere");
    assert(g.place == to, "door {i} into {to}: {g.place}");
    back = levels::door_named(g.file, "demo");
    assert(back >= 0, "{to} has a door to the village");
    assert(game::go_through(g, back), "{to}'s door back");
    assert(at(g) == "demo {x},{y + 1},0", "out in front of {to}'s house: {at(g)}");
  }
}

// What the hero holds, its health and money pass through a door.
fn test_what_the_hero_holds_goes_through() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  sword = rules::thing_id(g.kinds, "sword");
  g.world.hero_item = sword;
  g.world.health = 3;
  g.world.money = 12;
  walk(g, 0, -1, 15);
  assert(g.place == "the_cellar", "in: {at(g)}");
  assert(g.world.hero_item == sword && g.world.health == 3 && g.world.money == 12,
         "carried: {g.world.hero_item} {g.world.health} {g.world.money}");
}

// R in a room is the room as the hero came into it, the hero at the door, still in the world.
fn test_r_in_a_room_is_the_room_as_entered() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, 0, -1, 15);
  walk(g, 1, 0, 4);
  game::restart(g);
  assert(at(g) == "the_cellar 1,2,0" && g.in_world, "back at the door: {at(g)}");
  assert(tile_world::top(g.world.w, 5, 2, 0) == rules::thing_id(g.kinds, "rock"), "the rock as it was");
}

// The village's text is written on the ground: it shows, and the hero standing on it is drawn
// over it.
fn test_floor_text_is_walked_over() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, 0, -1, 13);
  assert(at(g) == "demo 14,6,0", "on THE CELLAR's text: {at(g)}");
  with = frame(g);
  labels = g.file.labels;
  g.file.labels = [];
  bare = frame(g);
  g.file.labels = labels;
  assert(changed(with, bare) > 0, "the text shows");
  g.look.hero = -1;
  assert(changed(with, frame(g)) > 0, "the hero is drawn over it");
}

// The elder at (10, 18): two steps west of the start the hero passes three steps from him — a bark
// (HI THERE.), not a talk; up a row and beside him, the talk: WELCOME TO THE DEMO VILLAGE.
fn test_walking_up_to_the_elder() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, -1, 0, 2);
  e = 0;
  for i in 0..len(g.world.enemies) { if (g.world.enemies[i]!.kind) == "elder" { e = i; } }
  assert(at(g) == "demo 12,19,0" && talk::barking(g.world, e) == 0 && talk::current(g.world, e) == -1,
         "walking by: a bark: {at(g)}");
  game::move(g, 0, -1, false);
  game::move(g, -1, 0, false);
  assert(at(g) == "demo 11,18,0" && talk::current(g.world, e) == 0, "beside him: the talk: {at(g)}");
}

// Hold `code` from wall-clock `at` for `held` ms, then let go; the world does not move meanwhile.
fn tap(g: game::Game, code: integer, at: integer, held: integer) {
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  down = up;
  down[code] = true;
  g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, at);
  g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, at + held);
}

// The keys by hand (owner): with WASD under the left hand the right acts — J tapped a light swing,
// held a heavy one (ready again 800 ms on), K alone a parry, L puts down; with the arrows, Space,
// Shift and X do the same.  In the rat run, the sword taken by the door, nothing near.
fn test_the_right_hand_acts() {
  for keys in [(106, 107, 108), (32, 132, 120)] {
    m = game::new_game("..");
    if !m { assert(false, "the game loads"); return; }
    g = m;
    assert(game::start_world(g, "the_rat_run"), "the rat run opens");
    game::move(g, 0, -1, false);
    assert(g.world.hero_item != 0, "{keys.0}: the sword taken");
    _ = game::update(g, 1000, 0);
    tap(g, keys.0, 10000, 100);
    assert(g.world.struck == 1 && g.world.blow_until == g.world.now + 400, "{keys.0} tapped: a light swing: {g.world.struck}");
    _ = game::update(g, 1000, 20000);
    tap(g, keys.0, 30000, 600);
    assert(g.world.struck == 2 && g.world.blow_until == g.world.now + 800, "{keys.0} held: a heavy swing: {g.world.blow_until - g.world.now}");
    tap(g, keys.1, 40000, 100);
    assert(g.world.parry_at == g.world.now, "{keys.1} alone: a parry");
    tap(g, keys.2, 50000, 100);
    assert(g.world.hero_item == 0, "{keys.2}: put down");
  }
}

// A potion in the game (owner): in the cyclops den, empty-handed, the hero walks onto the potion on
// (1, 16) and picks it up; L puts it down; walked off and on again it is picked up again; J drinks
// it — nothing at once, from 2.  Out through the den's door into the village before the first
// point: the healing goes along, 3 there 1500 ms on, 4 at 3000, 5 at 4500.
fn test_a_potion_is_carried_and_drunk_with_the_keys() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_cyclops_den"), "the den opens");
  potion = rules::th(g.world, "health_potion");
  game::move(g, -1, 0, false);
  game::move(g, -1, 0, false);
  assert(g.world.hero_x == 1 && g.world.hero_item == potion && g.world.drunk == 0, "picked up: {at(g)}");
  tap(g, 108, 1000, 100);
  assert(g.world.hero_item == 0 && tile_world::top(g.world.w, 1, 16, 0) == potion, "L: put down");
  game::move(g, 1, 0, false);
  game::move(g, -1, 0, false);
  assert(g.world.hero_item == potion, "picked up again");
  g.world.health = 2;
  tap(g, 106, 2000, 100);
  assert(g.world.hero_item == 0 && g.world.drunk == 1 && g.world.health == 2, "J: drunk, nothing at once: {g.world.health}");
  game::move(g, 1, 0, false);
  game::move(g, 1, 0, false);
  game::move(g, 0, 1, false);
  assert(g.place == "demo" && g.world.health == 2, "out in the village, still 2: {at(g)} {g.world.health}");
  _ = game::update(g, 1500, 3000);
  assert(g.world.health == 3, "1500 on: 3: {g.world.health}");
  _ = game::update(g, 1500, 4500);
  _ = game::update(g, 1500, 6000);
  assert(g.world.health == 5 && g.world.heal_due == 0, "4500 on: 5, done: {g.world.health}");
}

// The fountain (C6b): in the demo's fountain house, drunk from — SAVED, at a fountain.  Then into
// the rats' chamber at the last health: a bite there, and the hero is back beside the fountain,
// told so: BACK AT FOUNTAIN.
fn test_a_fountain_saves_like_a_well() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_fountain"), "the fountain opens");
  for _ in 0..5 { game::move(g, 0, -1, false); }
  assert(g.has_save && g.note == "SAVED" && g.saved_at == "FOUNTAIN" && at(g) == "the_fountain 6,11,0", "saved at the fountain: {at(g)} {g.note}");
  rules::put_hero(g.world, 4, 2, 0);
  g.world.health = 1;
  t = 0;
  while t < 20000 && g.note != "BACK AT FOUNTAIN" {
    _ = game::update(g, 100, t);
    t += 100;
  }
  assert(g.note == "BACK AT FOUNTAIN" && at(g) == "the_fountain 6,11,0" && g.world.health == 6, "bitten to nothing, back: {at(g)} {g.note}");
}

// The cave-in (B2) through the game: in from the village by its house's door, the pick taken, the
// rubble struck with the cart behind: the rock in the cart, the way to the chest open; the world
// runs on (the lit things there kindled) without a fault.
fn test_the_cave_in_with_the_game() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  assert(game::start_world(g, "the_cave_in"), "the cave-in opens");
  game::move(g, 0, -1, false);
  game::move(g, 1, 0, false);
  game::move(g, 1, 0, false);
  game::move(g, 0, -1, false);
  assert(rules::thing_name(g.world.k, tile_world::top(g.world.w, 4, 7, 0)) == "full_cart" && tile_world::top(g.world.w, 4, 5, 0) == 0,
    "the rock in the cart: {at(g)}");
  _ = game::update(g, 5000, 1000);
  assert(rules::alive(g.world), "the world runs on");
}

// The herb patch (B7b) through the game: the sack worn, two herbs foraged — the status line says
// SACK 2/6 — then the alchemist, bumped: every herb taken from the sack, the pick in the hand kept,
// a potion given (at the hero's feet, the hand being full).  Out through the door the sack goes
// along, holding what is left.
fn test_the_alchemist_takes_from_the_sack() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_herb_patch"), "the herb patch opens");
  w = g.world;
  rules::put_hero(w, 7, 10, 0);
  game::move(g, -1, 0, false);
  w.hero_item = rules::th(w, "pick");
  for c in [(3, 3), (5, 2), (4, 7)] {
    rules::put_hero(w, c.0, c.1 + 1, 0);
    game::move(g, 0, -1, false);
  }
  assert(rules::sack_room(w) == (3, 6), "three foraged: {rules::sack_room(w).0}");
  rules::put_hero(w, 8, 4, 0);
  game::move(g, 0, -1, false);
  _ = game::update(g, 100, 100);
  assert(rules::sack_room(g.world).0 == 1 && g.world.hero_item == rules::th(g.world, "pick"), "the herbs taken, the mushroom and the pick kept: {rules::sack_room(g.world).0}");
  assert(rules::thing_name(g.world.k, tile_world::top(g.world.w, 8, 4, 0)) == "health_potion", "a potion at the hero's feet");
}

// The night street (C2b) through the game: into the house in the dark — nothing known; out, the
// torch taken up, in again — seen: `snooped` is known.  Out, and up to the neighbour: they start
// at what they saw.
fn test_a_torch_at_night_is_seen_going_in() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_night_street"), "the night street opens");
  rules::put_hero(g.world, 8, 4, 0);
  game::move(g, 0, -1, false);
  assert(g.place == "the_night_house" && !rules::knows(g.world, "snooped"), "in, in the dark, unseen: {at(g)}");
  game::move(g, 0, 1, false);
  assert(g.place == "the_night_street", "out again: {at(g)}");
  g.world.hero_item = rules::th(g.world, "burning_torch");
  g.world.hero_until = g.world.now + 600000;
  rules::put_hero(g.world, 8, 4, 0);
  game::move(g, 0, -1, false);
  assert(g.place == "the_night_house" && rules::knows(g.world, "snooped"), "in with a torch: seen, known");
  game::move(g, 0, 1, false);
  e = -1;
  for i in 0..len(g.world.enemies) { if g.world.enemies[i].kind == "neighbour" { e = i; } }
  n = g.world.enemies[e]!;
  rules::put_hero(g.world, n.x, n.y - 2, 0);
  game::move(g, 0, 1, false);
  assert(talk::current(g.world, e) == 1, "they start at what they saw: line {talk::current(g.world, e)}");
}

// Sable (C3b) through the game: his day runs on the game's clock — at his dig by 15 s; and his
// trap springs on the hero who pushes its rock off the rails and stays on them.
fn test_sables_day_and_trap_in_the_game() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_rival_gallery"), "the gallery opens");
  t = 0;
  while t < 15000 {
    _ = game::update(g, 100, t);
    t += 100;
  }
  s = -1;
  for i in 0..len(g.world.enemies) { if g.world.enemies[i].kind == "rival" { s = i; } }
  e = g.world.enemies[s]!;
  assert(e.x == 17 && e.y == 3, "at his dig: {e.x},{e.y}");
  rules::put_hero(g.world, 14, 10, 1);
  game::move(g, -1, 0, false);
  while t < 18000 {
    _ = game::update(g, 100, t);
    t += 100;
  }
  assert(g.world.health < 6, "the cart came down: health {g.world.health}");
}
