// The game itself, built from its directory one up: the safe point a well makes.
//
// A plain program, not a `tests/` file: under `loft --tests` a `--lib` library's `[c] shim`
// is not opened (loft#2234), and the game draws through `tiles`, which is one.  Run it with
// `loft --lib libs checks/game.loft`; it moves into tests/ when that is fixed.  The first
// climb (levels/first_climb.json) starts the hero at (1, 1) on layer 0; a well is put at (1, 2)
// below it.  Layer 1's ledge runs x 8..11 at y 1, with the void at x 7 over layer 0's floor:
// stepping west off it is a fall of one layer, which costs 1 health.
use tile_world;
use rules;
use game;
use motion;
use theme;
use talk;
use tiles;

fn main() {
  assert(game::new_game("..") != null, "the game loads from its directory");
  test_a_well_brings_the_hero_back();
  test_b_twice_goes_back();
  test_a_doomed_save_rolls_back_once();
  test_a_wall_in_front_of_the_hero_is_cut_away();
  test_only_walls_hide_what_the_hero_does_not_see();
  test_the_world_starts_in_the_village();
  test_a_house_door_leads_in_and_back_out();
  test_a_place_left_keeps_its_state();
  test_every_house_has_a_way_back();
  test_what_the_hero_holds_goes_through();
  test_r_in_a_room_is_the_room_as_entered();
  test_floor_text_is_walked_over();
  test_walking_up_to_the_elder();
  test_a_slanted_wall_is_drawn_cut();
  test_the_right_hand_acts();
  test_free_roaming();
  test_the_play_log();
  test_looking_down_through_an_opening();
  test_a_potion_is_carried_and_drunk_with_the_keys();
  test_a_fountain_saves_like_a_well();
  test_the_cave_in_with_the_game();
  test_the_alchemist_takes_from_the_sack();
  test_a_torch_at_night_is_seen_going_in();
  test_sables_day_and_trap_in_the_game();
  test_day_and_night();
  test_the_alchemist_teaches_the_lore();
  test_the_scholar_makes_urgha_understood();
  test_a_person_follows_through_doors();
  test_the_worker_keeps_to_its_day();
  test_the_dunns_bargain();
  test_a_save_read_back_is_the_same();
  test_the_epilogue_follows_the_facts();
  test_a_door_made_in_the_editor();
  test_a_block_and_a_parry_are_seen();
  test_the_haunted_dream();
  println("checks/game.loft: 35 passed");
}

// A fresh game on the first climb with a well under the start, the hero having drunk from it.
fn at_the_well(g: game::Game) {
  game::start_level(g, 0);
  tile_world::set_terrain(g.world.w, 1, 2, 0, rules::tr(g.world, "well"));
  game::move(g, 0, 1, false);
}

fn where(g: const game::Game) -> text {
  w = g.world;
  "{w.hero_x},{w.hero_y},{w.hero_z} health {w.health}"
}

// Drinking saves; a fall that takes the last health brings the hero back to the well, with the
// health it had there.
fn test_a_well_brings_the_hero_back() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  at_the_well(g);
  assert(g.has_save && g.note == "SAVED" && where(g) == "1,1,0 health 6", "saved: {where(g)}");
  rules::put_hero(g.world, 8, 1, 1);
  g.world.health = 1;
  game::move(g, -1, 0, false);
  assert(where(g) == "1,1,0 health 6", "back at the well: {where(g)}");
  assert(g.note == "BACK AT WELL", "said so: {g.note}");
}

// B asks first and goes on the second; a move between the two cancels the ask.  A restart
// drops the save, and then B does nothing.
fn test_b_twice_goes_back() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  at_the_well(g);
  game::move(g, 1, 0, false);
  assert(game::back(g) && where(g) == "2,1,0 health 6" && g.note == "BACK? B AGAIN", "asks: {where(g)}");
  game::move(g, 1, 0, false);
  assert(game::back(g) && where(g) == "3,1,0 health 6", "a move cancelled the ask: {where(g)}");
  assert(game::back(g) && where(g) == "1,1,0 health 6", "the second B goes: {where(g)}");
  game::restart(g);
  assert(!g.has_save && !game::back(g), "no well drunk from, no way back");
}

// A doomed save need not brick the game: saved at a second well, a fall takes the last health and
// sends the hero back there; B twice then goes one well further back, which becomes the save — B
// twice again goes there, no further.  A move after a return cancels the further way back.
fn test_a_doomed_save_rolls_back_once() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  at_the_well(g);
  tile_world::set_terrain(g.world.w, 3, 2, 0, rules::tr(g.world, "well"));
  game::move(g, 1, 0, false);
  game::move(g, 1, 0, false);
  game::move(g, 0, 1, false);
  assert(g.note == "SAVED" && g.has_previous && where(g) == "3,1,0 health 6", "the second save: {where(g)}");
  rules::put_hero(g.world, 8, 1, 1);
  g.world.health = 1;
  game::move(g, -1, 0, false);
  assert(where(g) == "3,1,0 health 6" && g.note == "BACK AT WELL", "back at the second well: {where(g)}");
  assert(game::back(g) && g.note == "EARLIER? B AGAIN", "asks for the earlier one: {g.note}");
  assert(game::back(g) && where(g) == "1,1,0 health 6" && g.note == "BACK AT EARLIER WELL",
         "one well further back: {where(g)}");
  assert(!g.has_previous, "and none before it");
  game::move(g, 1, 0, false);
  assert(game::back(g) && game::back(g) && where(g) == "1,1,0 health 6", "B twice: the earlier well is the save now");
  assert(game::back(g) && g.note == "BACK? B AGAIN", "no further: {g.note}");
}

// --- What the picture leaves out (owner): a wall in front of the hero, and what the hero does not
// see past the walls ---

// A clean room for these: layer 0's x 0 .. 9, y 0 .. 4 floor in walls, nothing on layer 1, the
// hero on (1, 1).
fn room(g: game::Game) {
  game::start_level(g, 0);
  g.world.enemies = [];
  tile_world::fill(g.world.w, -1, -1, 10, 5, 0, rules::tr(g.world, "wall"));
  tile_world::fill(g.world.w, 0, 0, 9, 4, 0, rules::tr(g.world, "floor"));
  tile_world::fill(g.world.w, -1, -1, 10, 5, 1, tile_world::VOID);
  for c in tile_world::stacks(g.world.w) {
    while tile_world::top(g.world.w, c.0, c.1, c.2) != 0 { _ = tile_world::take(g.world.w, c.0, c.1, c.2); }
  }
  rules::put_hero(g.world, 1, 1, 0);
}

// The frame `g` draws, its pixels; and how many pixels differ between two frames.
fn frame(g: game::Game) -> vector<i32> {
  game::draw(g);
  tiles::pixels(g.surface, game::COLS * g.look.tile_size, game::ROWS * g.look.tile_size)
}

fn changed(a: const vector<i32>, b: const vector<i32>) -> integer {
  n = 0;
  for i in 0..len(a) { if (a[i] ?? 0) != (b[i] ?? 0) { n += 1; } }
  n
}

// The hero's pixels with a ledge's floor on (1, 2) of layer 1, drawn a row up over the hero, on
// `under` below it — against the frame without the hero's picture.
fn hero_behind(ledge: boolean, under: text) -> integer {
  m = game::new_game("..");
  if !m { return -1; }
  g = m;
  room(g);
  tile_world::set_terrain(g.world.w, 1, 2, 0, rules::tr(g.world, under));
  if ledge { tile_world::set_terrain(g.world.w, 1, 2, 1, rules::tr(g.world, "floor")); }
  with = frame(g);
  g.look.hero = -1;
  changed(with, frame(g))
}

// A ledge on a wall in front of the hero is cut away: the hero is seen as whole as with no ledge
// there.  Over no wall it is not: the hero is hidden by it.
fn test_a_wall_in_front_of_the_hero_is_cut_away() {
  open = hero_behind(false, "wall");
  assert(open > 0 && hero_behind(true, "wall") == open, "a wall in front: cut away");
  assert(hero_behind(true, "floor") < open, "no wall: not cut");
}

// A rat on (6, 1) and a column on x 4 between it and the hero: the rat's pixels (the frame with it
// against the frame without).  A wall column hides it; a door or a tree there does not.  The same
// for a chest there.
fn rat_past(between: text) -> integer {
  m = game::new_game("..");
  if !m { return -1; }
  g = m;
  room(g);
  tile_world::fill(g.world.w, 4, 0, 4, 4, 0, rules::tr(g.world, "wall"));
  if between != "wall" { tile_world::set_terrain(g.world.w, 4, 1, 0, rules::tr(g.world, between)); }
  _ = rules::add_enemy(g.world, "rat", 6, 1, 0);
  with = frame(g);
  g.world.enemies = [];
  changed(with, frame(g))
}

fn chest_past(between: text) -> integer {
  m = game::new_game("..");
  if !m { return -1; }
  g = m;
  room(g);
  tile_world::fill(g.world.w, 4, 0, 4, 4, 0, rules::tr(g.world, "wall"));
  if between != "wall" { tile_world::set_terrain(g.world.w, 4, 1, 0, rules::tr(g.world, between)); }
  tile_world::place(g.world.w, 6, 1, 0, rules::th(g.world, "chest"));
  with = frame(g);
  _ = tile_world::take(g.world.w, 6, 1, 0);
  changed(with, frame(g))
}

fn test_only_walls_hide_what_the_hero_does_not_see() {
  assert(rat_past("wall") == 0, "past a wall: not drawn ({rat_past("wall")})");
  assert(rat_past("door") > 0 && rat_past("tree") > 0, "past a door, a tree: drawn");
  assert(chest_past("wall") == 0 && chest_past("door") > 0, "a chest the same: {chest_past("wall")}, {chest_past("door")}");
}

// --- The world (WORLD.md § The world): the village, a house per room, doors both ways ---

fn world() -> game::Game? {
  m = game::new_game("..");
  if !m { return null; }
  g = m ?? return null;
  if !game::start_world(g, "demo") { return null; }
  g
}

fn at(g: const game::Game) -> text {
  w = g.world;
  "{g.place} {w.hero_x},{w.hero_y},{w.hero_z}"
}

fn walk(g: game::Game, dx: integer, dy: integer, n: integer) {
  for _ in 0..n { game::move(g, dx, dy, false); }
}

fn test_the_world_starts_in_the_village() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  assert(at(g) == "demo 14,19,0", "in the village: {at(g)}");
  assert(len(g.file.doors) == 33 && len(g.file.labels) == 35, "thirty-two houses and the way out, each named: {len(g.file.doors)} {len(g.file.labels)}");
}

// Up the road to the stone house and onto its door: the cellar, standing inside its door (1, 3)
// facing into the room; down onto that door: back outside the house, facing away from it.
fn test_a_house_door_leads_in_and_back_out() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, 0, -1, 14);
  assert(at(g) == "demo 14,5,0", "before the door: {at(g)}");
  game::move(g, 0, -1, false);
  assert(at(g) == "the_cellar 1,2,0", "in the cellar: {at(g)}");
  assert(g.world.face_x == 0 && g.world.face_y == -1, "facing into it: {g.world.face_x},{g.world.face_y}");
  game::move(g, 0, 1, false);
  assert(at(g) == "demo 14,5,0", "out again: {at(g)}");
  assert(g.world.face_y == 1, "facing away from the house");
}

// The rock pushed in the cellar is where it was left, after going out and coming back in.
fn test_a_place_left_keeps_its_state() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  rock = rules::thing_id(g.kinds, "rock");
  walk(g, 0, -1, 15);
  assert(tile_world::top(g.world.w, 5, 2, 0) == rock, "the rock at (5, 2)");
  walk(g, 1, 0, 4);
  assert(at(g) == "the_cellar 5,2,0" && tile_world::top(g.world.w, 6, 2, 0) == rock, "pushed to (6, 2): {at(g)}");
  walk(g, -1, 0, 4);
  game::move(g, 0, 1, false);
  assert(g.place == "demo", "out: {at(g)}");
  game::move(g, 0, -1, false);
  assert(at(g) == "the_cellar 1,2,0", "back in: {at(g)}");
  assert(tile_world::top(g.world.w, 6, 2, 0) == rock && tile_world::top(g.world.w, 5, 2, 0) == 0,
         "the rock where it was left");
}

// Every door of the village leads into a place with a door back to it, and that door brings the
// hero out in front of the house it went into — but the way out, which ends the game (C7).
fn test_every_house_has_a_way_back() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  n = len(g.file.doors);
  for i in 0..n {
    if g.file.doors[i]!.ends { continue; }
    to = g.file.doors[i]!.to;
    x = g.file.doors[i]!.x;
    y = g.file.doors[i]!.y;
    assert(game::go_through(g, i), "door {i} leads somewhere");
    assert(g.place == to, "door {i} into {to}: {g.place}");
    back = levels::door_named(g.file, "demo");
    assert(back >= 0, "{to} has a door to the village");
    assert(game::go_through(g, back), "{to}'s door back");
    assert(at(g) == "demo {x},{y + 1},0", "out in front of {to}'s house: {at(g)}");
  }
}

// What the hero holds, its health and money pass through a door.
fn test_what_the_hero_holds_goes_through() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  sword = rules::thing_id(g.kinds, "sword");
  g.world.hero_item = sword;
  g.world.health = 3;
  g.world.money = 12;
  walk(g, 0, -1, 15);
  assert(g.place == "the_cellar", "in: {at(g)}");
  assert(g.world.hero_item == sword && g.world.health == 3 && g.world.money == 12,
         "carried: {g.world.hero_item} {g.world.health} {g.world.money}");
}

// R in a room is the room as the hero came into it, the hero at the door, still in the world.
fn test_r_in_a_room_is_the_room_as_entered() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, 0, -1, 15);
  walk(g, 1, 0, 4);
  game::restart(g);
  assert(at(g) == "the_cellar 1,2,0" && g.in_world, "back at the door: {at(g)}");
  assert(tile_world::top(g.world.w, 5, 2, 0) == rules::thing_id(g.kinds, "rock"), "the rock as it was");
}

// The village's text is written on the ground: it shows, and the hero standing on it is drawn
// over it.
fn test_floor_text_is_walked_over() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, 0, -1, 13);
  assert(at(g) == "demo 14,6,0", "on THE CELLAR's text: {at(g)}");
  with = frame(g);
  labels = g.file.labels;
  g.file.labels = [];
  bare = frame(g);
  g.file.labels = labels;
  assert(changed(with, bare) > 0, "the text shows");
  g.look.hero = -1;
  assert(changed(with, frame(g)) > 0, "the hero is drawn over it");
}

// The elder at (10, 18): two steps west of the start the hero passes three steps from him — a bark
// (HI THERE.), not a talk; up a row and beside him, the talk: WELCOME TO THE DEMO VILLAGE.
fn test_walking_up_to_the_elder() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  walk(g, -1, 0, 2);
  e = 0;
  for i in 0..len(g.world.enemies) { if (g.world.enemies[i]!.kind) == "elder" { e = i; } }
  assert(at(g) == "demo 12,19,0" && talk::barking(g.world, e) == 0 && talk::current(g.world, e) == -1,
         "walking by: a bark: {at(g)}");
  game::move(g, 0, -1, false);
  game::move(g, -1, 0, false);
  assert(at(g) == "demo 11,18,0" && talk::current(g.world, e) == 0, "beside him: the talk: {at(g)}");
}

// Hold `code` from wall-clock `at` for `held` ms, then let go; the world does not move meanwhile.
fn tap(g: game::Game, code: integer, at: integer, held: integer) {
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  down = up;
  down[code] = true;
  g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, at);
  g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, at + held);
}

// The keys (owner, 2026-11-07): Q tapped takes the sword before the hero; E tapped a light swing, held
// a heavy one (ready again 800 ms on); Shift alone a parry (the built guard, until the clash); Q
// tapped again puts the sword down before it.  In the rat run, the sword by the door, nothing near.
fn test_the_right_hand_acts() {
  for keys in [(101, 132, 113)] {
    m = game::new_game("..");
    if !m { assert(false, "the game loads"); return; }
    g = m;
    assert(game::start_world(g, "the_rat_run"), "the rat run opens");
    g.world.face_x = 0;
    g.world.face_y = -1;
    tap(g, keys.2, 500, 100);
    assert(g.world.hero_item != 0, "{keys.2}: the sword before the hero taken");
    game::move(g, 0, -1, false);
    _ = game::update(g, 1000, 0);
    tap(g, keys.0, 10000, 100);
    assert(g.world.struck == 1 && g.world.blow_until == g.world.now + 400, "{keys.0} tapped: a light swing: {g.world.struck}");
    _ = game::update(g, 1000, 20000);
    tap(g, keys.0, 30000, 600);
    assert(g.world.struck == 2 && g.world.blow_until == g.world.now + 800, "{keys.0} held: a heavy swing: {g.world.blow_until - g.world.now}");
    tap(g, keys.1, 40000, 100);
    assert(g.world.parry_at == g.world.now, "{keys.1} alone: a parry");
    tap(g, keys.2, 50000, 100);
    assert(g.world.hero_item == 0, "{keys.2}: put down");
  }
}

// Free roaming (F3, owner 2026-11-07): in the rat run, F3 on; W held 50 ms the body is a third of a
// cell north, still on its cell; held 50 more it is past half a cell — the step taken, the body a
// little south of the new cell; let go, it stays there; F3 again, back on the tiles.
fn test_free_roaming() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_rat_run"), "the rat run opens");
  y0 = g.world.hero_y;
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  f3 = up;
  f3[137] = true;
  g.keys.input_tick_from_state(f3, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, 1000);
  g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, 1010);
  assert(g.free, "F3: free roaming");
  w_held = up;
  w_held[119] = true;
  g.keys.input_tick_from_state(w_held, 0.0, 0.0, 0, 0);
  _ = game::update(g, 50, 1060);
  assert(g.world.hero_y == y0 && g.free_y == -91, "50 ms: on its cell, the body {g.free_y}/256 north");
  g.keys.input_tick_from_state(w_held, 0.0, 0.0, 0, 0);
  _ = game::update(g, 50, 1110);
  assert(g.world.hero_y == y0 - 1 && g.free_y == 74, "100 ms: the step taken, the body {g.free_y}/256 south of the new cell");
  g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0);
  _ = game::update(g, 200, 1310);
  assert(g.world.hero_y == y0 - 1 && g.free_y == 74, "let go: it stays where it stands");
  g.keys.input_tick_from_state(f3, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, 1400);
  assert(!g.free && game::free_offset(g).1 == 0.0, "F3 again: back on the tiles");
}

// Looking down (owner, 2026-11-07): in the old mine, on the rails at (4, 3) of layer 1 beside the
// opening where they go down, the layer below shows through it — the rails below the opening and
// the room they lead into (8, 3) within DOWN_LOOK — but not the room's far end (14, 3).
fn test_looking_down_through_an_opening() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_old_mine"), "the old mine opens");
  rules::put_hero(g.world, 4, 3, 1);
  game::aim_view(g);
  seen = game::look_down(g, g.world, 1);
  assert(len(seen) > 0, "an opening seen");
  assert(seen_at(g, seen, 6, 3) && seen_at(g, seen, 8, 3), "the rails below and the room's near side: seen");
  assert(!seen_at(g, seen, 14, 3), "the room's far end: not");
}

// Is cell (x, y) of layer 0 flagged in a look down from layer 1 (its view rows start at cam_y)?
fn seen_at(g: const game::Game, seen: const vector<boolean>, x: integer, y: integer) -> boolean {
  vx = x - g.cam_x;
  vy = y - g.cam_y;
  if vx < 0 || vx >= game::COLS || vy < 0 { return false; }
  seen[vy * game::COLS + vx] ?? false
}

// The play log (TW_LOG): in the bat cave, a bat put 4 steps from the hero, the log on — its swoop
// is logged step by step at the clock's moments, its nip with the hero's health, and the hero's
// own change.
fn test_the_play_log() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_bat_cave"), "the bat cave opens");
  g.world.enemies = [];
  rules::put_hero(g.world, 3, 10, 0);
  g.world.hero_item = rules::th(g.world, "burning_torch");
  _ = rules::add_enemy(g.world, "bat", 3, 6, 0);
  g.logging = true;
  t = 0;
  while t < 3000 {
    t += 20;
    _ = game::update(g, 20, t);
  }
  all = "";
  for line in g.log { all += line + "\n"; }
  assert(all.contains("template swoop, next step") && all.contains("(dive)"), "the swoop's steps logged:\n{all}");
  assert(all.contains("nips for 1 on (3,10)") && all.contains("hero health 6->5"), "the nip logged:\n{all}");
  assert(all.contains("hero the_bat_cave"), "the hero's change logged:\n{all}");
}

// A potion in the game (owner): in the cyclops den, empty-handed, the hero walks onto the potion on
// (1, 16) from beside it and takes it (Q); Q again puts it down there; Q takes it again; E drinks
// it — nothing at once, from 2.  Out through the den's door into the village before the first
// point: the healing goes along, 3 there 1500 ms on, 4 at 3000, 5 at 4500.
fn test_a_potion_is_carried_and_drunk_with_the_keys() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_cyclops_den"), "the den opens");
  potion = rules::th(g.world, "health_potion");
  game::move(g, -1, 0, false);
  tap(g, 113, 500, 100);
  assert(g.world.hero_x == 2 && g.world.hero_item == potion && g.world.drunk == 0, "Q: the potion before the hero picked up: {at(g)}");
  tap(g, 113, 1000, 100);
  assert(g.world.hero_item == 0 && tile_world::top(g.world.w, 1, 16, 0) == potion, "Q: put down before it");
  game::move(g, 1, 0, false);
  game::move(g, -1, 0, false);
  tap(g, 113, 1500, 100);
  assert(g.world.hero_item == potion, "Q: picked up again");
  g.world.health = 2;
  tap(g, 101, 2000, 100);
  assert(g.world.hero_item == 0 && g.world.drunk == 1 && g.world.health == 2, "E: drunk, nothing at once: {g.world.health}");
  game::move(g, 1, 0, false);
  game::move(g, 0, 1, false);
  assert(g.place == "demo" && g.world.health == 2, "out in the village, still 2: {at(g)} {g.world.health}");
  _ = game::update(g, 1500, 3000);
  assert(g.world.health == 3, "1500 on: 3: {g.world.health}");
  _ = game::update(g, 1500, 4500);
  _ = game::update(g, 1500, 6000);
  assert(g.world.health == 5 && g.world.heal_due == 0, "4500 on: 5, done: {g.world.health}");
}

// The fountain (C6b): in the demo's fountain house, drunk from — SAVED, at a fountain.  Then into
// the rats' chamber at the last health: a bite there, and the hero is back beside the fountain,
// told so: BACK AT FOUNTAIN.
fn test_a_fountain_saves_like_a_well() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_fountain"), "the fountain opens");
  for _ in 0..5 { game::move(g, 0, -1, false); }
  assert(g.has_save && g.note == "SAVED" && g.saved_at == "FOUNTAIN" && at(g) == "the_fountain 6,11,0", "saved at the fountain: {at(g)} {g.note}");
  rules::put_hero(g.world, 4, 2, 0);
  g.world.health = 1;
  t = 0;
  while t < 20000 && g.note != "BACK AT FOUNTAIN" {
    _ = game::update(g, 100, t);
    t += 100;
  }
  assert(g.note == "BACK AT FOUNTAIN" && at(g) == "the_fountain 6,11,0" && g.world.health == 6, "bitten to nothing, back: {at(g)} {g.note}");
}

// The cave-in (B2) through the game: in from the village by its house's door, the pick taken, the
// rubble struck with the cart behind: the rock in the cart, the way to the chest open; the world
// runs on (the lit things there kindled) without a fault.
fn test_the_cave_in_with_the_game() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  assert(game::start_world(g, "the_cave_in"), "the cave-in opens");
  g.world.face_x = 0;
  g.world.face_y = -1;
  tap(g, 113, 500, 100);
  game::move(g, 0, -1, false);
  game::move(g, 1, 0, false);
  game::move(g, 1, 0, false);
  game::move(g, 0, -1, false);
  assert(rules::thing_name(g.world.k, tile_world::top(g.world.w, 4, 7, 0)) == "full_cart" && tile_world::top(g.world.w, 4, 5, 0) == 0,
    "the rock in the cart: {at(g)}");
  _ = game::update(g, 5000, 1000);
  assert(rules::alive(g.world), "the world runs on");
}

// The herb patch (B7b, B7) through the game: the sack worn, two herbs and a mushroom foraged, then
// the alchemist, bumped: his recipe's two herbs and mushroom taken from the sack, the pick kept,
// a potion given (at the hero's feet, the hand being full).  Out through the door the sack goes
// along, holding what is left.
fn test_the_alchemist_takes_from_the_sack() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_herb_patch"), "the herb patch opens");
  w = g.world;
  rules::put_hero(w, 7, 10, 0);
  w.face_x = -1;
  w.face_y = 0;
  tap(g, 113, 100, 50);
  game::move(g, -1, 0, false);
  w.hero_item = rules::th(w, "pick");
  for c in [(3, 3), (5, 2), (4, 7)] {
    rules::put_hero(w, c.0, c.1 + 1, 0);
    w.face_x = 0;
    w.face_y = -1;
    tap(g, 113, 200, 50);
    game::move(g, 0, -1, false);
  }
  assert(rules::sack_room(w) == (3, 6), "three foraged: {rules::sack_room(w).0}");
  rules::put_hero(w, 8, 4, 0);
  game::move(g, 0, -1, false);
  _ = game::update(g, 100, 100);
  assert(rules::sack_room(g.world).0 == 0 && g.world.hero_item == rules::th(g.world, "pick"), "the recipe's two herbs and mushroom taken, the pick kept: {rules::sack_room(g.world).0}");
  assert(rules::thing_name(g.world.k, tile_world::top(g.world.w, 8, 4, 0)) == "health_potion", "a potion at the hero's feet");
}

// The night street (C2b) through the game: into the house in the dark — nothing known; out, the
// torch taken up, in again — seen: `snooped` is known.  Out, and up to the neighbour: they start
// at what they saw.
fn test_a_torch_at_night_is_seen_going_in() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_night_street"), "the night street opens");
  rules::put_hero(g.world, 8, 4, 0);
  game::move(g, 0, -1, false);
  assert(g.place == "the_night_house" && !rules::knows(g.world, "snooped"), "in, in the dark, unseen: {at(g)}");
  game::move(g, 0, 1, false);
  assert(g.place == "the_night_street", "out again: {at(g)}");
  g.world.hero_item = rules::th(g.world, "burning_torch");
  g.world.hero_until = g.world.now + 600000;
  rules::put_hero(g.world, 8, 4, 0);
  game::move(g, 0, -1, false);
  assert(g.place == "the_night_house" && rules::knows(g.world, "snooped") && g.world.goodwill == -1, "in with a torch: seen, known, liked less");
  game::move(g, 0, 1, false);
  e = -1;
  for i in 0..len(g.world.enemies) { if g.world.enemies[i].kind == "neighbour" { e = i; } }
  n = g.world.enemies[e]!;
  rules::put_hero(g.world, n.x, n.y - 2, 0);
  game::move(g, 0, 1, false);
  assert(talk::current(g.world, e) == 1, "they start at what they saw: line {talk::current(g.world, e)}");
}

// Sable (C3b) through the game: his day runs on the game's clock — at his dig by 15 s; and his
// trap springs on the hero who pushes its rock off the rails and stays on them.
fn test_sables_day_and_trap_in_the_game() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_rival_gallery"), "the gallery opens");
  t = 0;
  while t < 15000 {
    _ = game::update(g, 100, t);
    t += 100;
  }
  s = -1;
  for i in 0..len(g.world.enemies) { if g.world.enemies[i].kind == "rival" { s = i; } }
  e = g.world.enemies[s]!;
  assert(e.x == 17 && e.y == 3, "at his dig: {e.x},{e.y}");
  rules::put_hero(g.world, 14, 10, 1);
  game::move(g, -1, 0, false);
  while t < 18000 {
    _ = game::update(g, 100, t);
    t += 100;
  }
  assert(g.world.health < 6, "the cart came down: health {g.world.health}");
}

// The clock (C1): one for the world, from 07:00; the bed by the village's start: slept in by day,
// the hero wakes at 20:00 — night: the open sky gives no light, the hero in the street unlit — and
// slept in again, at 07:00 the next day.  The pump room, entered after days have passed, has
// refilled for them.
fn test_day_and_night() {
  m = world();
  if !m { assert(false, "the world starts"); return; }
  g = m;
  assert(!game::is_night(g) && rules::hero_lit(g.world), "07:00, day: lit");
  rules::put_hero(g.world, 14, 19, 0);
  game::move(g, 1, 0, false);
  assert(game::is_night(g) && g.note == "SLEPT TILL 20:00" && g.world.night && !rules::hero_lit(g.world), "slept till night: {g.note}");
  game::move(g, 1, 0, false);
  assert(!game::is_night(g) && g.note == "SLEPT TILL 07:00" && g.clock / game::DAY_MS == 1, "and till the next morning: {g.note}");
}

// The smithy (B6): coming beside the alchemist there, his line makes the artefact's lore known (a
// talk line setting a fact, C2).
fn test_the_alchemist_teaches_the_lore() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_smithy"), "the smithy opens");
  e = g.world.enemies[0]!;
  tile_world::set_terrain(g.world.w, e.x - 2, e.y, 0, rules::tr(g.world, "floor"));
  tile_world::set_terrain(g.world.w, e.x - 1, e.y, 0, rules::tr(g.world, "floor"));
  while tile_world::top(g.world.w, e.x - 1, e.y, 0) != 0 { _ = tile_world::take(g.world.w, e.x - 1, e.y, 0); }
  rules::put_hero(g.world, e.x - 2, e.y, 0);
  game::move(g, 1, 0, false);
  assert(rules::knows(g.world, "artefact_lore"), "the lore known: at {at(g)}");
}

// The words house (C2d): Urgha's line comes through in part; beside the scholar, his line makes
// the cyclopes' words known, and Urgha's line is heard whole.
fn test_the_scholar_makes_urgha_understood() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_words"), "the words opens");
  urgha = g.file.talks[0]!.lines[0]!;
  assert(talk::heard(g.world, urgha) == "YOU .. KHARN. .. FRIEND .. VILLAGE?", "in part: {talk::heard(g.world, urgha)}");
  rules::put_hero(g.world, 10, 2, 0);
  game::move(g, 1, 0, false);
  assert(rules::knows(g.world, "cyclops_words") && talk::heard(g.world, urgha) == "YOU NOT KHARN. YOU FRIEND OF VILLAGE?", "understood: at {at(g)}");
}

// Following through a door (C3, C3c): the wanderer, spoken to, follows; through the east door it
// comes along, its talk with it; back through the west door, both come back — its talk there once,
// found at its new home.
fn test_a_person_follows_through_doors() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_follow"), "the follow opens");
  rules::put_hero(g.world, 5, 2, 0);
  game::move(g, -1, 0, false);
  assert(g.world.enemies[0]!.led, "spoken to, it follows: at {at(g)}");
  // Its line said to the end (about 2 s, ten seconds given), it still follows.
  for s in 1..=10 { _ = game::update(g, 1000, s * 1000); }
  assert(g.world.enemies[0]!.led, "its line over, it still follows");
  rules::put_hero(g.world, 11, 3, 0);
  game::move(g, 1, 0, false);
  assert(g.place == "the_follow_b", "through the east door: {g.place}");
  assert(len(g.world.enemies) == 1 && (g.world.enemies[0]!.led) && len(g.file.talks) == 1, "it came along, its talk too");
  assert(talk::owner(g.file.talks[0]!, g.world) == 0, "its talk finds it");
  back = levels::door_named(g.file, "the_follow");
  assert(game::go_through(g, back), "back west");
  assert(g.place == "the_follow" && len(g.file.talks) == 1, "home, one talk: {len(g.file.talks)}");
  o = talk::owner(g.file.talks[0]!, g.world);
  assert(o >= 0 && (g.world.enemies[o]!.kind) == "villager", "found at its new home");
}

// The worker's day (C3; levels/people.json, a cycle of 60 s): from 0 in the street at (68, 20) —
// there on entering at 10 s; at 30 s off to work, walking to the work house's door, and gone from
// the street by 40 s; the hero going in, finds the worker at work on (5, 2), its talk with it.
fn test_the_worker_keeps_to_its_day() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  g.clock = 600000 + 10000;
  assert(game::start_world(g, "demo"), "the demo opens");
  i = rules::person_index(g.world, "worker");
  assert(i >= 0 && (g.world.enemies[i]!.x) == 68 && (g.world.enemies[i]!.y) == 20, "10 s: in the street");
  talks = 0;
  for t in g.file.talks { if t.name == "worker" { talks += 1; } }
  assert(talks == 1, "its talk here");
  rules::put_hero(g.world, 40, 7, 0);
  g.clock = 600000 + 30000;
  for _ in 0..10 { _ = game::update(g, 1000, 0); }
  assert(rules::person_index(g.world, "worker") < 0, "40 s: gone to work");
  for t in g.file.talks { assert(t.name != "worker", "its talk gone with it"); }
  d = levels::door_named(g.file, "the_work");
  assert(game::go_through(g, d), "into the work house");
  w = rules::person_index(g.world, "worker");
  assert(w >= 0 && (g.world.enemies[w]!.x) == 5 && (g.world.enemies[w]!.y) == 2, "at work: at {at(g)}");
}

// The Dunns' bargain (C9): the barn shut; the horse, spoken to, follows; Dunn's offer, taken by
// bumping him while he makes it, strikes the bargain — once, kept — and the horse stays with the
// farm: the barn opens, and the hero goes in without it.
fn test_the_dunns_bargain() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_farm"), "the farm opens");
  closed = theme::terrain_sprite(g.look, rules::tr(g.world, "door"), 12, 3, false);
  assert(game::kind_sprite(g, g.world, 12, 3, 0, false) == closed, "the barn door drawn closed");
  rules::put_hero(g.world, 11, 3, 0);
  game::move(g, 1, 0, false);
  assert(g.place == "the_farm" && g.note == "SHUT", "the barn shut: {g.note}");
  rules::put_hero(g.world, 4, 3, 0);
  game::move(g, -1, 0, false);
  h = -1;
  for i in 0..len(g.world.enemies) { if g.world.enemies[i]!.kind == "horse" { h = i; } }
  assert(h >= 0 && (g.world.enemies[h]!.led), "the horse follows");
  rules::put_hero(g.world, 6, 2, 0);
  game::move(g, 1, 0, false);
  game::move(g, 1, 0, false);
  assert(rules::knows(g.world, "bargain") && !(g.world.enemies[h]!.led), "struck: the horse stays");
  assert(game::kind_sprite(g, g.world, 12, 3, 0, false) != closed, "the barn door drawn open");
  rules::put_hero(g.world, 11, 3, 0);
  game::move(g, 1, 0, false);
  assert(g.place == "the_barn", "the barn open: {g.place} {g.note}");
  for e in g.world.enemies { assert(e.kind != "horse", "the horse not with the hero"); }
}

// Saves (C6): in the demo, a chest's coin taken in the smithy's street and the bargain struck at
// the farm — the clock on, a fact known, the farm as left; saved, played on (the hero moved, a
// fact forgotten), and read back: the same place, cell, clock, facts, money, places.
fn test_a_save_read_back_is_the_same() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_farm"), "the farm opens");
  rules::learn(g.world, "bargain");
  g.world.money = 7;
  g.clock = 444000;
  rules::put_hero(g.world, 4, 5, 0);
  tile_world::place(g.world.w, 9, 5, 0, rules::th(g.world, "chair"));
  d = levels::door_named(g.file, "demo");
  assert(game::go_through(g, d), "out to the village");
  hx = g.world.hero_x;
  hy = g.world.hero_y;
  files = game::save_files(g);
  assert(len(files) == 3, "the save, the farm and the village: {len(files)}");
  rules::put_hero(g.world, 40, 7, 0);
  g.world.facts = [];
  g.world.money = 0;
  g.clock = 0;
  assert(game::load_files(g, files), "read back");
  assert(g.place == "demo" && g.world.hero_x == hx && g.world.hero_y == hy, "the same cell: {at(g)}");
  assert(g.clock == 444000 && rules::knows(g.world, "bargain") && g.world.money == 7, "the clock, the facts, the money");
  f = levels::door_named(g.file, "the_farm");
  assert(game::go_through(g, f), "into the farm");
  assert(tile_world::top(g.world.w, 9, 5, 0) == rules::th(g.world, "chair"), "the farm as it was left");
}

// The epilogue (C7): the stills for a set of facts — with the bargain struck and the hero seen
// snooping, the road east, the horse, the night visitor (not the friend, not Lark's path); then
// out by the LEAVE gap in the village's east edge: the stills in turn, 6 s each, then THE END.
fn test_the_epilogue_follows_the_facts() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "demo"), "the demo opens");
  rules::learn(g.world, "bargain");
  rules::snoop(g.world);
  s = game::epilogue(g);
  places = "";
  for st in s { places += "{st.place} "; }
  assert(places == "demo the_farm the_night_street ", "the stills: {places}");
  rules::put_hero(g.world, 77, 15, 0);
  game::move(g, 1, 0, false);
  assert(g.ending && g.still == 0 && len(g.stills) == 3, "walked away: {at(g)}");
  _ = game::update(g, 6000, 0);
  assert(g.still == 1 && g.place == "demo", "the next still: {g.still}");
  for _ in 0..3 { _ = game::update(g, 6000, 0); }
  assert(g.still == 3, "THE END: {g.still}");
}

// The editor's doors and figures (A1, A2): in the words house, a door to the barn made on (3, 6)
// and a rat put on (11, 5); back to play, the rat is there, and the hero, stepping onto the new
// door, goes through it into the barn.
fn test_a_door_made_in_the_editor() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_words"), "the words opens");
  game::toggle_editor(g);
  g.ed.x = 3;
  g.ed.y = 6;
  g.ed.z = 0;
  game::edit(g, "door=the_barn");
  g.ed.x = 11;
  g.ed.y = 5;
  game::edit(g, "figure=rat");
  game::edit(g, "paint");
  game::toggle_editor(g);
  assert(rules::enemy_at(g.world, 11, 5, 0) >= 0, "the rat there");
  rules::put_hero(g.world, 3, 5, 0);
  game::move(g, 0, 1, false);
  assert(g.place == "the_barn", "through the new door: {at(g)} {g.note}");
}

// The block and the parry seen (@GM-Combat): in the farm, a rat put beside the hero (sword in
// hand, facing it).  Shift pressed and held: the rat's bite lands on the guard — counted, a small
// spark, the hero pushed back (a brace, not a stagger), no health lost.  Then, with the rat
// winding up again, Shift tapped in the last 100 ms: the bite turned aside — a big spark, the hero's
// weapon flicked, the rat flung back twice as hard as a hit (a stagger of strength 2).
fn test_a_block_and_a_parry_are_seen() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  assert(game::start_world(g, "the_farm"), "the farm opens");
  g.world.enemies = [];
  rules::put_hero(g.world, 6, 5, 0);
  g.world.hero_item = rules::th(g.world, "sword");
  g.world.face_x = 1;
  g.world.face_y = 0;
  rat = rules::add_enemy(g.world, "rat", 7, 5, 0);
  r = len(g.world.enemies) - 1;
  // The frames drawn meanwhile: each one follows the enemies' moves (game::draw does it).
  game::follow_enemies(g);
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  down = up;
  down[132] = true;
  // Pressed (a parry, too early for any bite), then held: a block.
  g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0);
  t = 1000;
  _ = game::update(g, 0, t);
  g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0);
  for _ in 0..40 {
    if g.world.blocks > 0 { break; }
    t += 50;
    _ = game::update(g, 50, t);
    game::follow_enemies(g);
  }
  assert(g.world.blocking && g.world.blocks == 1 && g.world.parries == 0, "the bite on the guard: {g.world.blocks} blocked, {g.world.parries} parried");
  assert(len(g.sparks) == 1 && !(g.sparks[0]!.big), "a small spark: {len(g.sparks)}");
  assert(g.motion.act == motion::Act.Brace && g.world.health == 6, "pushed back, not hurt: {g.world.health}");
  // Let go; wait for the next wind-up, and tap Shift in its last 100 ms.
  g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0);
  for _ in 0..80 {
    e = g.world.enemies[r]!;
    if e.wind_until > 0 && e.wind_until - g.world.now <= 100 { break; }
    t += 25;
    _ = game::update(g, 25, t);
    game::follow_enemies(g);
  }
  assert((g.world.enemies[r]!.wind_until) > 0, "winding up again");
  g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0);
  _ = game::update(g, 0, t);
  assert(g.motion.act == motion::Act.Flick, "the weapon flicked");
  g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0);
  for _ in 0..10 {
    if g.world.parries > 0 { break; }
    t += 25;
    _ = game::update(g, 25, t);
    game::follow_enemies(g);
  }
  big = false;
  for sp in g.sparks { if sp.big { big = true; } }
  assert(g.world.parries == 1 && big && g.world.health == 6, "turned aside, a big spark: {g.world.parries} {big} {g.world.health}");
  mo = game::motion_of(g, rat);
  assert(mo.act == motion::Act.Stagger && mo.strength == 2 && (g.world.enemies[r]!.open_until) > g.world.now, "the rat flung back, open");
}

// A wall's picture cut at 45 degrees (DESIGN.md § Slanted rock), made from its own when the theme
// loads: open to the south-east, its north-west half is the wall's (pixel (2, 2) as the whole
// picture draws it), the cell's south-east corner shows what was under it (pixel (13, 13)), and
// the cut runs along the diagonal (15, 0) .. (0, 15) in the picture's darkest colour.  The four
// ways are four pictures; a picture with no cut (the floor) stays itself.
fn test_a_slanted_wall_is_drawn_cut() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  k = rules::kinds();
  wall = theme::terrain_sprite(g.look, rules::terrain_id(k, "wall"), 0, 0, false);
  ways: vector<integer> = [];
  for t in [tile_world::NORTH_EAST, tile_world::SOUTH_EAST, tile_world::SOUTH_WEST, tile_world::NORTH_WEST] {
    s = theme::slant_sprite(g.look, wall, t);
    assert(s != wall && !ways.contains(s), "a picture of its own for way {t}");
    ways += [s];
  }
  floor = theme::terrain_sprite(g.look, rules::terrain_id(k, "floor"), 0, 0, false);
  assert(theme::slant_sprite(g.look, floor, tile_world::SOUTH_EAST) == floor, "the floor has no cut");
  back = 2016;
  whole = tiles::surface(16, 16) ?? 0;
  tiles::clear(whole, back);
  theme::put(whole, wall, 0, 0, 0);
  wp = tiles::pixels(whole, 16, 16);
  cut = tiles::surface(16, 16) ?? 0;
  tiles::clear(cut, back);
  theme::put(cut, theme::slant_sprite(g.look, wall, tile_world::SOUTH_EAST), 0, 0, 0);
  cp = tiles::pixels(cut, 16, 16);
  assert(cp[2 * 16 + 2] == wp[2 * 16 + 2] && cp[2 * 16 + 2] != back, "the north-west half is the wall");
  assert(cp[13 * 16 + 13] == back && wp[13 * 16 + 13] != back, "the south-east corner is open");
  line = cp[0 * 16 + 15];
  for i in 0..16 { assert(cp[i * 16 + 15 - i] == line && line != back, "the cut along the diagonal, at ({15 - i}, {i})"); }
}

// The haunted dream (STORY.md @ST-Urn): in Orbury, with the founder's urn given and left behind, a
// nap by day heals nothing; by night the ghost haunts, and a night slept is a haunted dream — the
// hero healed, but to a top health of 5 for the day.  The urn back in his hands, the next night is
// a plain one: the top health 6 again, the hero healed to it.
fn test_the_haunted_dream() {
  m = game::new_game("..");
  if !m { assert(false, "the game loads"); return; }
  g = m;
  g.seed = 7;
  assert(game::start_world(g, "orbury"), "Orbury opens");
  rules::learn(g.world, "urn_given");
  g.world.hero_item = rules::th(g.world, "urn");
  g.world.health = 3;
  rules::put_hero(g.world, 25, 60, 0);
  game::move(g, -1, 0, false);
  assert(g.note == "SLEPT TILL 20:00" && g.world.health == 3, "a nap by day heals nothing: {g.note}, health {g.world.health}");
  assert(g.world.haunting && rules::knows(g.world, "haunting"), "by night, the urn left behind: haunted");
  rules::put_hero(g.world, 25, 60, 0);
  game::move(g, -1, 0, false);
  assert(g.note == "A HAUNTED DREAM. SLEPT TILL 07:00", "a haunted dream: {g.note}");
  // The dream shown on waking: the ghost in the dark, saying one of his haunting barks; gone after
  // DREAM_MS.
  assert(g.dreaming && (g.dream_says == "MY URN... YOU LEFT MY URN." || g.dream_says == "BRING IT HOME OR TO HER."),
         "the dream: {g.dreaming} '{g.dream_says}'");
  _ = game::update(g, game::DREAM_MS, 0);
  assert(!g.dreaming, "and over");
  assert(rules::top_health(g.world) == 5 && g.world.health == 5, "healed, to 5: {g.world.health} of {rules::top_health(g.world)}");
  assert(!g.world.haunting && !rules::knows(g.world, "haunting"), "by day the haunting is over");
  // The urn home in his hands; a day and a night slept.
  g.world.hero_item = 0;
  for i in 0..len(g.world.enemies) {
    if (g.world.enemies[i]!.kind) == "ghost" { g.world.enemies[i].item = rules::th(g.world, "urn"); }
  }
  g.world.health = 2;
  rules::put_hero(g.world, 25, 60, 0);
  game::move(g, -1, 0, false);
  assert(!g.world.haunting, "with the urn home, no haunting");
  rules::put_hero(g.world, 25, 60, 0);
  game::move(g, -1, 0, false);
  assert(g.note == "SLEPT TILL 07:00" && rules::top_health(g.world) == 6 && g.world.health == 6,
         "a plain night: {g.note}, {g.world.health} of {rules::top_health(g.world)}");
}
