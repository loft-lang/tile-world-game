// The first-person view's place (render3d.loft): its faces from what the cells hold, checked by
// hand on a small place.  A plain program, as checks/game.loft is (loft#2234: the tiles shim).
// Run with `loft --lib libs checks/view3d.loft`.  Nothing here opens a window.
//
// A floor x 0 .. 8, y 0 .. 8 on layer 0, the hero on (1, 1) facing north.  Every face's corners are
// (x, y, z, u, v): x east, y up in layers, z south.
use tile_world;
use rules;
use game;
use render3d;
use materials;

fn place() -> game::Game {
  g = game::new_game("..")!;
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, 0, 0, 8, 8, 0, rules::tr(w, "floor"));
  g.world = w;
  rules::put_hero(g.world, 1, 1, 0);
  g.world.face_x = 0;
  g.world.face_y = -1;
  g
}

// The faces that touch cell (x, y) on layer z's span: every corner inside the cell's box.
fn of_cell(fs: const vector<render3d::Face>, x: integer, y: integer, z: integer) -> vector<render3d::Face> {
  out: vector<render3d::Face> = [];
  for f in fs {
    inside = true;
    n = len(f.at) / 5 ?? 0;
    for c in 0..n {
      fx = f.at[c * 5] ?? -9.0;
      fy = f.at[c * 5 + 1] ?? -9.0;
      fz = f.at[c * 5 + 2] ?? -9.0;
      if fx < (x as float) - 0.001 || fx > ((x + 1) as float) + 0.001 || fz < (y as float) - 0.001
          || fz > ((y + 1) as float) + 0.001 || fy < (z as float) - 0.001 || fy > ((z + 1) as float) + 0.001 {
        inside = false;
      }
    }
    if inside { out += [f]; }
  }
  out
}

fn corners(f: const render3d::Face) -> integer { len(f.at) / 5 ?? 0 }

fn main() {
  test_a_wall_is_a_box();
  test_a_slanted_wall_is_a_prism();
  test_a_ceiling_hangs_at_its_drop();
  test_a_slope_bends_the_floor();
  test_thin_walls_stand_on_their_edges();
  test_stairs_rise_toward_their_wall();
  test_a_floor_above_has_an_underside();
  test_a_roof_is_pitched();
  println("checks/view3d.loft: 8 passed");
}

// A whole wall on (4, 4) among floor: four sides and a top, each four corners; no floor under it.
fn test_a_wall_is_a_box() {
  g = place();
  tile_world::set_terrain(g.world.w, 4, 4, 0, rules::tr(g.world, "wall"), 0);
  fs = of_cell(render3d::faces(g), 4, 4, 0);
  quads = 0;
  tops = 0;
  for f in fs {
    if corners(f) == 4 { quads += 1; }
    flat = true;
    for c in 0..4 { if (f.at[c * 5 + 1] ?? 0.0) < 0.999 { flat = false; } }
    if flat { tops += 1; }
  }
  // Its four neighbours' floors also touch its box on an edge — at y 0, outside the wall's
  // faces: of_cell keeps faces wholly inside the box, and a neighbour's floor is not.
  assert(len(fs) == 5 && quads == 5, "four sides and a top: {len(fs)} faces, {quads} of 4 corners");
  assert(tops == 1, "one at the top (y 1): {tops}");
}

// A wall on (4, 4) slanted open to the north-east: its solid half is the triangle NW, SW, SE.  Its
// two whole sides (west and south), its cut face from NW (4, 4) to SE (5, 5), the floor's triangle
// in the open half (from the floor beside), and its top triangle: five faces, two of 3 corners.
fn test_a_slanted_wall_is_a_prism() {
  g = place();
  tile_world::set_terrain(g.world.w, 4, 4, 0, rules::tr(g.world, "wall"), 0);
  tile_world::set_slant(g.world.w, 4, 4, 0, tile_world::NORTH_EAST);
  fs = of_cell(render3d::faces(g), 4, 4, 0);
  tri = 0;
  cut = false;
  for f in fs {
    if corners(f) == 3 { tri += 1; }
    if corners(f) == 4 {
      // The cut face: a corner at (4, ., 4) and one at (5, ., 5).
      a = false;
      b = false;
      for c in 0..4 {
        x = f.at[c * 5] ?? 0.0;
        z = f.at[c * 5 + 2] ?? 0.0;
        if x == 4.0 && z == 4.0 { a = true; }
        if x == 5.0 && z == 5.0 { b = true; }
      }
      if a && b { cut = true; }
    }
  }
  assert(len(fs) == 5 && tri == 2, "two sides, the cut, the open half's floor and the top: {len(fs)} faces, {tri} triangles");
  assert(cut, "the cut runs from (4, 4) to (5, 5)");
}

// Under rock (a wall over the whole place on layer 1), the floor cell (6, 6) with its ceiling 2
// steps down — and its eight neighbours too, so every corner's mean is 2 — has its ceiling at 0.5.
fn test_a_ceiling_hangs_at_its_drop() {
  g = place();
  tile_world::fill(g.world.w, 0, 0, 8, 8, 1, rules::tr(g.world, "wall"));
  for y in 5..8 { for x in 5..8 { tile_world::set_ceiling(g.world.w, x, y, 0, 2); } }
  fs = of_cell(render3d::faces(g), 6, 6, 0);
  low = 0;
  for f in fs {
    all = true;
    for c in 0..corners(f) { if (f.at[c * 5 + 1] ?? 0.0) != 0.5 { all = false; } }
    if all { low += 1; }
  }
  assert(low == 1, "one face at 0.5, the ceiling: {low} of {len(fs)}");
}

// A cell rising a step beside flat floor: its corners shared with flat cells within a step take
// the mean — (4, 4) at rise 1 alone, so each of its corners is the mean of 1 and three 0s, ¼ of a
// step: 1/16 of a layer.
fn test_a_slope_bends_the_floor() {
  g = place();
  tile_world::set_rise(g.world.w, 4, 4, 0, 1);
  fs = of_cell(render3d::faces(g), 4, 4, 0);
  ok = false;
  for f in fs {
    if corners(f) != 4 { continue; }
    all = true;
    for c in 0..4 { if (f.at[c * 5 + 1] ?? 0.0) != 0.0625 { all = false; } }
    if all { ok = true; }
  }
  assert(ok, "the floor's corners at 1/16: {len(fs)} faces");
}

// The faces standing on the line z = `line` (the view's z, a row's north side) from x0 to x0 + 1.
fn on_line(fs: const vector<render3d::Face>, x0: integer, line: integer) -> integer {
  n = 0;
  for f in fs {
    on = true;
    for c in 0..corners(f) {
      fx = f.at[c * 5] ?? -9.0;
      fz = f.at[c * 5 + 2] ?? -9.0;
      if fz < (line as float) - 0.001 || fz > (line as float) + 0.001 || fx < (x0 as float) - 0.001 || fx > ((x0 + 1) as float) + 0.001 { on = false; }
    }
    if on { n += 1; }
  }
  n
}

// A house's thin walls (owner, 2026-11-08: walls not seen in 3D): on the north side of (3, 3) a
// wall is one panel standing there, a door its two posts and the lintel, a window four parts.
fn test_thin_walls_stand_on_their_edges() {
  g = place();
  tile_world::set_edge(g.world.w, 3, 3, 0, tile_world::NORTH, rules::edge_id(g.world.k, "wall"));
  tile_world::set_edge(g.world.w, 5, 3, 0, tile_world::NORTH, rules::edge_id(g.world.k, "door"));
  tile_world::set_edge(g.world.w, 6, 3, 0, tile_world::NORTH, rules::edge_id(g.world.k, "window"));
  fs = render3d::faces(g);
  assert(on_line(fs, 3, 3) == 1, "a wall: {on_line(fs, 3, 3)}");
  assert(on_line(fs, 5, 3) == 3, "a door: {on_line(fs, 5, 3)}");
  assert(on_line(fs, 6, 3) == 4, "a window: {on_line(fs, 6, 3)}");
}

// Stairs up on (5, 5) against a wall to the north: four treads, the lowest at the south a quarter
// of a layer up, the highest at the wall a whole layer up; over them on layer 1 the stairwell is
// open — no floor across the cell there.
fn test_stairs_rise_toward_their_wall() {
  g = place();
  w = g.world;
  tile_world::set_terrain(w.w, 5, 4, 0, rules::tr(w, "wall"), 0);
  tile_world::set_terrain(w.w, 5, 5, 0, rules::tr(w, "stairs_up"), 0);
  tile_world::set_terrain(w.w, 5, 5, 1, rules::tr(w, "stairs_down"), 0);
  d = render3d::stairs_way(g, w, 5, 5, 0);
  assert(d.0 == 0 && d.1 == -1, "up toward the wall: ({d.0}, {d.1})");
  low = false;
  high = false;
  floor_over = false;
  for f in render3d::faces(g) {
    if corners(f) != 4 { continue; }
    zmin = 99.0;
    zmax = -99.0;
    xmin = 99.0;
    xmax = -99.0;
    flat = true;
    y0 = f.at[1] ?? -9.0;
    for c in 0..4 {
      fy = f.at[c * 5 + 1] ?? -9.0;
      fx = f.at[c * 5] ?? -9.0;
      fz = f.at[c * 5 + 2] ?? -9.0;
      if fy < y0 - 0.001 || fy > y0 + 0.001 { flat = false; }
      if fz < zmin { zmin = fz; }
      if fz > zmax { zmax = fz; }
      if fx < xmin { xmin = fx; }
      if fx > xmax { xmax = fx; }
    }
    if !flat || xmin < 4.999 || xmax > 6.001 { continue; }
    if y0 > 0.249 && y0 < 0.251 && zmin > 5.749 && zmax < 6.001 { low = true; }
    if y0 > 0.999 && y0 < 1.001 && zmin > 4.999 && zmax < 5.251 { high = true; }
    if y0 > 0.999 && y0 < 1.001 && zmin < 5.001 && zmax > 5.999 { floor_over = true; }
  }
  assert(low && high, "the lowest tread at the foot, the highest at the wall: {low} {high}");
  assert(!floor_over, "the stairwell over them is open");
}

// A floor on layer 1 over the hero's room on layer 0 is seen from below: its underside, a hair
// under layer 1 — a house's ceiling, a bridge seen from its bed.
fn test_a_floor_above_has_an_underside() {
  g = place();
  tile_world::set_terrain(g.world.w, 2, 2, 1, rules::tr(g.world, "floor"), 0);
  under = false;
  for f in of_cell(render3d::faces(g), 2, 2, 0) {
    if corners(f) == 4 && (f.at[1] ?? 0.0) > 0.98 && (f.at[1] ?? 0.0) < 0.995 { under = true; }
  }
  assert(under, "the floor above has an underside");
}

// A house's roof, 3 wide and 4 deep on layer 1 over (2..4, 2..5) (owner, 2026-11-08): its eaves on
// the layer's floor at the north and south edges, its ridge a layer higher at the middle (z = 4);
// at its west and east ends a gable; the hero below on layer 0 sees no flat floor across it.
fn test_a_roof_is_pitched() {
  g = place();
  r = materials::named(g.mats, "house_roof");
  for y in 2..6 {
    for x in 2..5 { materials::paint(g.mats, g.world.w, r, x, y, 1); }
  }
  ridge = false;
  eaves_n = false;
  eaves_s = false;
  flat = false;
  gables = 0;
  for f in render3d::faces(g) {
    for c in 0..corners(f) {
      fx = f.at[c * 5] ?? -9.0;
      fy = f.at[c * 5 + 1] ?? -9.0;
      fz = f.at[c * 5 + 2] ?? -9.0;
      if fx > 1.999 && fx < 5.001 && fz > 3.999 && fz < 4.001 && fy > 1.999 && fy < 2.001 { ridge = true; }
      if fx > 1.999 && fx < 5.001 && fz > 1.999 && fz < 2.001 && fy > 0.999 && fy < 1.001 { eaves_n = true; }
      if fx > 1.999 && fx < 5.001 && fz > 5.999 && fz < 6.001 && fy > 0.999 && fy < 1.001 { eaves_s = true; }
    }
    if corners(f) == 4 {
      same_y = true;
      same_x = true;
      for c in 1..4 {
        if (f.at[c * 5 + 1] ?? 0.0) != (f.at[1] ?? 0.0) { same_y = false; }
        if (f.at[c * 5] ?? 0.0) != (f.at[0] ?? 0.0) { same_x = false; }
      }
      if same_y && (f.at[1] ?? 0.0) > 0.999 && (f.at[1] ?? 0.0) < 1.001 && (f.at[0] ?? 0.0) > 1.999 && (f.at[0] ?? 0.0) < 5.001 { flat = true; }
      if same_x && ((f.at[0] ?? 0.0) == 2.0 || (f.at[0] ?? 0.0) == 5.0) && (f.at[2] ?? 0.0) >= 2.0 && (f.at[2] ?? 0.0) <= 6.0 { gables += 1; }
    }
  }
  assert(ridge && eaves_n && eaves_s, "the ridge a layer up in the middle, the eaves at both edges: {ridge} {eaves_n} {eaves_s}");
  assert(!flat, "no flat roof");
  assert(gables == 8, "a gable at each end, a quad a row: {gables}");
}
