//
// How a character moves on screen, as a cut-out: the body is one picture that glides, hops and
// rocks; the weapon is a second one, held at the hand, pointing the way the character faces,
// swinging a little on its own.  No frames are drawn for it — the motion is all there is.
//
// A character's `Motion` is what it last did (a step, a stagger, a swing) and when; `pose` reads
// where its pieces are at any moment of the world clock.  The rules stay cell by cell: this is
// drawing only, the same for the hero and, later, every enemy.  Once an act is over the
// character stands still.
//
// Angles are degrees clockwise, the weapon's measured from pointing up: facing right it points
// at 90, down 180, left 270.  Pixels are the 1x surface's.  Every number is an integer, and a
// negative one is always a sign times a magnitude, so the rounding of a division never depends
// on the sign.

/// How long each act takes, in milliseconds.  A step is no longer than the key's repeat, so a
/// held key walks without a pause.
pub const WALK_MS = 140;
pub const STAGGER_MS = 280;
pub const SWING_MS = 240;

/// The hobble: a step hops `HOP` pixels and rocks `ROCK` degrees at its height, one way on one
/// step and the other on the next; the weapon trails the rock by a quarter of the step and
/// sways `SWAY` degrees.
pub const HOP = 2;
pub const ROCK = 7;
pub const SWAY = 8;

/// A stagger knocks the body `KNOCK` pixels back and flings the weapon `FLING` degrees.
pub const KNOCK = 3;
pub const FLING = 35;

/// A swing winds up `ARC` degrees behind the facing and strikes through to `ARC` beyond it,
/// lunging `LUNGE` pixels: the wind-up takes `WIND_MS`, the strike `STRIKE_MS`, the rest is the
/// recovery.
pub const ARC = 70;
pub const LUNGE = 2;
pub const WIND_MS = 80;
pub const STRIKE_MS = 60;

/// Combat's stances and answers (@GM-Combat; proposed, to tune in play).  Guarding, the weapon is
/// turned `GUARD_TURN` degrees across the body (a bar between the figure and the blow), drawn in a
/// pixel, the body crouched a pixel and leaning `GUARD_LEAN` back.  A parry is a flick: from
/// across the body out to `FLICK_OUT` beyond the facing in `SNAP_MS`, back to the facing by
/// `FLICK_MS`.  A blocked blow pushes the guard `BRACE_PUSH` pixels back over `BRACE_MS`.
pub const GUARD_TURN = 75;
pub const GUARD_LEAN = 3;
pub const FLICK_OUT = 45;
pub const SNAP_MS = 60;
pub const FLICK_MS = 160;
pub const BRACE_PUSH = 2;
pub const BRACE_MS = 180;
/// An enemy winding up raises its weapon back as the hero's swing does (ARC); a sweep, which
/// cannot be parried, swings it far back level instead, `SWEEP_WIND` degrees.  Left open by a
/// parry, its weapon hangs `OPEN_DROP` degrees out past its stroke, the body off balance.  A
/// figure at a third of its health or less sags a pixel and, standing, sways `SWAY_HURT` degrees
/// over `HURT_MS`.
pub const SWEEP_WIND = 150;
pub const OPEN_DROP = 120;
pub const SWAY_HURT = 3;
pub const HURT_MS = 1600;

pub enum Act {
  Still,
  Walk,
  Stagger,
  Swing,
  /// A parry: the weapon flicked out from across the body.
  Flick,
  /// A blow taken on the guard: pushed back, the guard held.
  Brace
}

/// What a character last did, from when (the world clock).  A step glides from (from_x,
/// from_y), its offset from its cell when the step began; a stagger knocks it (knock_x,
/// knock_y); `steps` counts the steps, so the rock changes side each step.
pub struct Motion {
  pub act: Act,
  pub start: integer,
  pub from_x: integer,
  pub from_y: integer,
  pub knock_x: integer,
  pub knock_y: integer,
  pub steps: integer,
  /// A stagger's force: 1 a hit, 2 a riposte or a parried blow (knock, fling and wobble doubled).
  pub strength: integer = 1
}

/// Where a character's pieces are: the body (x, y) pixels off its place (y up is negative, the
/// hop included — `hop` is that part: where its feet are on the ground is y + hop) and turned
/// `tilt` degrees about its feet; the weapon at `weapon` degrees, pushed `reach` pixels out the
/// way it points.
pub struct Pose {
  pub x: integer,
  pub y: integer,
  pub hop: integer,
  pub tilt: integer,
  pub weapon: integer,
  pub reach: integer
}

/// Standing still.
pub fn still() -> Motion {
  Motion { act: Act.Still, start: 0, from_x: 0, from_y: 0, knock_x: 0, knock_y: 0, steps: 0 }
}

/// The weapon's angle facing (fx, fy): up 0, right 90, down 180, left 270.
pub fn facing(fx: integer, fy: integer) -> integer {
  if fx > 0 { 90 } else if fx < 0 { 270 } else if fy > 0 { 180 } else { 0 }
}

// How long act `a` lasts.
fn length(a: Act) -> integer {
  if a == Act.Walk { WALK_MS } else if a == Act.Stagger { STAGGER_MS } else if a == Act.Swing { SWING_MS }
  else if a == Act.Flick { FLICK_MS } else if a == Act.Brace { BRACE_MS } else { 0 }
}

/// Is the character still moving at `now`?
pub fn busy(m: const Motion, now: integer) -> boolean {
  m.act != Act.Still && now >= m.start && now < m.start + length(m.act)
}

// `top` scaled by e / n, rounded half up, for 0 <= e <= n; a motion of no length is at its end.
fn part(top: integer, e: integer, n: integer) -> integer {
  if n <= 0 { return top; }
  ((top * e * 2 + n) / (2 * n))!
}

// A rise and fall to `top` over a phase e of n: the triangle top * min(e, n - e) / (n / 2),
// rounded half up.
fn arc(top: integer, e: integer, n: integer) -> integer {
  part(top, if e < n - e { e } else { n - e }, n - n / 2)
}

fn sign(v: integer) -> integer {
  if v > 0 { 1 } else if v < 0 { -1 } else { 0 }
}

fn magnitude(v: integer) -> integer {
  if v < 0 { -v } else { v }
}

// The sweep of a swing facing (fx, fy): clockwise (+1) facing right or down, the other way
// facing left or up — the weapon arm's natural stroke on either side.
fn sweep(fx: integer, fy: integer) -> integer {
  if fx > 0 || fy > 0 { 1 } else { -1 }
}

/// The pose of a character with motion `m`, facing (fx, fy), at `now`.
pub fn pose(m: const Motion, fx: integer, fy: integer, now: integer) -> Pose {
  face = facing(fx, fy);
  out = Pose { x: 0, y: 0, hop: 0, tilt: 0, weapon: face, reach: 0 };
  if !busy(m, now) { return out; }
  e = now - m.start;
  if m.act == Act.Walk {
    n = WALK_MS;
    // Gliding in from where the step began, hopping and rocking; the weapon leads the way and
    // trails the rock by a quarter step.
    out.x = sign(m.from_x) * part(magnitude(m.from_x), n - e, n);
    out.hop = arc(HOP, e, n);
    out.y = sign(m.from_y) * part(magnitude(m.from_y), n - e, n) - out.hop;
    side = if m.steps % 2 == 0 { 1 } else { -1 };
    out.tilt = side * arc(ROCK, e, n);
    lag = if e < n / 4 { 0 } else { e - n / 4 };
    out.weapon = face - side * arc(SWAY, lag, n - n / 4);
    out.reach = 1;
  } else if m.act == Act.Stagger {
    n = STAGGER_MS;
    // Knocked back fast (a quarter of the time), then back slowly — gliding in, when the knock
    // moved it a cell; the body wobbles away from the knock and the weapon is flung back
    // against its stroke.
    q = n / 4;
    st = if m.strength > 1 { m.strength } else { 1 };
    d = if e < q { part(KNOCK * st, e, q) } else { part(KNOCK * st, n - e, n - q) };
    out.x = sign(m.from_x) * part(magnitude(m.from_x), n - e, n) + m.knock_x * d;
    out.y = sign(m.from_y) * part(magnitude(m.from_y), n - e, n) + m.knock_y * d;
    wobble = [-6, 5, -3, 1];
    away = if m.knock_x < 0 { -1 } else { 1 };
    slot = if n > 0 { (e * 4 / n)! } else { 0 };
    out.tilt = away * st * (wobble[slot] ?? 0);
    out.weapon = face - sweep(fx, fy) * part(FLING * st, n - e, n);
  } else if m.act == Act.Swing {
    n = SWING_MS;
    dir = sweep(fx, fy);
    if e < WIND_MS {
      // Winding up: back behind the facing, leaning away.
      out.weapon = face - dir * part(ARC, e, WIND_MS);
      out.tilt = -dir * 2;
    } else if e < WIND_MS + STRIKE_MS {
      // The strike: through the facing to beyond it, lunging into it.
      out.weapon = face - dir * ARC + dir * part(2 * ARC, e - WIND_MS, STRIKE_MS);
      out.tilt = dir * 3;
      out.x = fx * LUNGE;
      out.y = fy * LUNGE;
      out.reach = 2;
    } else {
      // Recovering: back to the facing, the lunge drawn in.
      r = n - e;
      rest = n - WIND_MS - STRIKE_MS;
      out.weapon = face + dir * part(ARC, r, rest);
      out.tilt = dir * part(3, r, rest);
      out.x = fx * part(LUNGE, r, rest);
      out.y = fy * part(LUNGE, r, rest);
      out.reach = part(2, r, rest);
    }
  } else if m.act == Act.Flick {
    n = FLICK_MS;
    dir = sweep(fx, fy);
    if e < SNAP_MS {
      // The snap: from across the body out past the facing, leaning into it.
      out.weapon = face - dir * GUARD_TURN + dir * part(GUARD_TURN + FLICK_OUT, e, SNAP_MS);
      out.tilt = dir * 2;
      out.reach = part(2, e, SNAP_MS);
    } else {
      // Back to the facing.
      r = n - e;
      rest = n - SNAP_MS;
      out.weapon = face + dir * part(FLICK_OUT, r, rest);
      out.tilt = dir * part(2, r, rest);
      out.reach = part(2, r, rest);
    }
  } else if m.act == Act.Brace {
    n = BRACE_MS;
    // Pushed back fast (a quarter of the time), then back slowly; the guard is held.
    q = n / 4;
    d = if e < q { part(BRACE_PUSH, e, q) } else { part(BRACE_PUSH, n - e, n - q) };
    out.x = m.knock_x * d;
    out.y = m.knock_y * d;
  }
  out
}

/// A pose in fractions: `pose`'s motions as smooth curves, for drawing at a display's own
/// resolution.  The glide runs straight in, the hop and the rock are sine arches, a stagger's
/// knock eases out and back and its wobble is a damped wave through the same peaks as `pose`'s
/// (6, 5, 3 and 1 degrees, side to side), and a swing turns continuously.  `pose` stays the
/// whole-pixel reading the rules use — which row hides a figure.
pub struct FinePose {
  pub x: float,
  pub y: float,
  pub hop: float,
  pub tilt: float,
  pub weapon: float,
  pub reach: float
}

// e / n as a fraction, 1 for a motion of no length.
fn done(e: integer, n: integer) -> float {
  if n <= 0 { return 1.0; }
  ((e as float) / (n as float))!
}

// A sine arch to `top` over a phase e of n: 0 at both ends, `top` halfway.
fn arch(top: integer, e: integer, n: integer) -> float {
  (top as float) * sin(PI * done(e, n))
}

/// The fine pose of a character with motion `m`, facing (fx, fy), at `now`.
pub fn fine_pose(m: const Motion, fx: integer, fy: integer, now: integer) -> FinePose {
  face = facing(fx, fy) as float;
  out = FinePose { x: 0.0, y: 0.0, hop: 0.0, tilt: 0.0, weapon: face, reach: 0.0 };
  if !busy(m, now) { return out; }
  e = now - m.start;
  if m.act == Act.Walk {
    n = WALK_MS;
    left = 1.0 - done(e, n);
    out.x = (m.from_x as float) * left;
    out.hop = arch(HOP, e, n);
    out.y = (m.from_y as float) * left - out.hop;
    side = if m.steps % 2 == 0 { 1.0 } else { -1.0 };
    out.tilt = side * arch(ROCK, e, n);
    lag = if e < n / 4 { 0 } else { e - n / 4 };
    out.weapon = face - side * arch(SWAY, lag, n - n / 4);
    out.reach = 1.0;
  } else if m.act == Act.Stagger {
    n = STAGGER_MS;
    q = n / 4;
    st = (if m.strength > 1 { m.strength } else { 1 }) as float;
    k = (KNOCK as float) * st;
    d = if e < q { k * sin(PI / 2.0 * done(e, q)) } else { k * (0.5 + 0.5 * cos(PI * done(e - q, n - q))) };
    left = 1.0 - done(e, n);
    out.x = (m.from_x as float) * left + (m.knock_x as float) * d;
    out.y = (m.from_y as float) * left + (m.knock_y as float) * d;
    away = if m.knock_x < 0 { -1.0 } else { 1.0 };
    t = done(e, n);
    out.tilt = -away * 7.0 * st * (1.0 - t) * cos(4.0 * PI * (t - 0.125));
    out.weapon = face - (sweep(fx, fy) as float) * (FLING as float) * st * left;
  } else if m.act == Act.Swing {
    n = SWING_MS;
    dir = sweep(fx, fy) as float;
    arc_deg = ARC as float;
    if e < WIND_MS {
      w = done(e, WIND_MS);
      out.weapon = face - dir * arc_deg * w;
      out.tilt = -dir * 2.0 * sin(PI / 2.0 * w);
    } else if e < WIND_MS + STRIKE_MS {
      s = done(e - WIND_MS, STRIKE_MS);
      out.weapon = face - dir * arc_deg + dir * 2.0 * arc_deg * s;
      out.tilt = -dir * 2.0 + dir * 5.0 * s;
      out.x = (fx * LUNGE) as float * s;
      out.y = (fy * LUNGE) as float * s;
      out.reach = 1.0 + s;
    } else {
      r = done(n - e, n - WIND_MS - STRIKE_MS);
      out.weapon = face + dir * arc_deg * r;
      out.tilt = dir * 3.0 * r;
      out.x = (fx * LUNGE) as float * r;
      out.y = (fy * LUNGE) as float * r;
      out.reach = 2.0 * r;
    }
  } else if m.act == Act.Flick {
    n = FLICK_MS;
    dir = sweep(fx, fy) as float;
    if e < SNAP_MS {
      s = done(e, SNAP_MS);
      out.weapon = face - dir * (GUARD_TURN as float) + dir * ((GUARD_TURN + FLICK_OUT) as float) * s;
      out.tilt = dir * 2.0;
      out.reach = 2.0 * s;
    } else {
      r = done(n - e, n - SNAP_MS);
      out.weapon = face + dir * (FLICK_OUT as float) * r;
      out.tilt = dir * 2.0 * r;
      out.reach = 2.0 * r;
    }
  } else if m.act == Act.Brace {
    n = BRACE_MS;
    q = n / 4;
    k = BRACE_PUSH as float;
    d = if e < q { k * sin(PI / 2.0 * done(e, q)) } else { k * (0.5 + 0.5 * cos(PI * done(e - q, n - q))) };
    out.x = (m.knock_x as float) * d;
    out.y = (m.knock_y as float) * d;
  }
  out
}

/// A step begins at `now`: the character's cell moved by (cell_dx, cell_dy) cells and its height
/// by `rise` pixels (up is positive), so it glides in from where it was drawn — mid-step too,
/// when the key is held.
pub fn walk(m: Motion, now: integer, cell_dx: integer, cell_dy: integer, rise: integer, fx: integer, fy: integer) {
  was = pose(m, fx, fy, now);
  hop = if m.act == Act.Walk && busy(m, now) { arc(HOP, now - m.start, WALK_MS) } else { 0 };
  m.from_x = was.x - cell_dx * 16;
  m.from_y = was.y + hop - cell_dy * 16 + rise;
  m.act = Act.Walk;
  m.start = now;
  m.steps += 1;
}

/// The character staggers at `now`, knocked (kx, ky): back from a wall it walked into, or by a
/// hit — which may move it (cell_dx, cell_dy) cells (a cart shoving it aside), so it glides
/// there from where it was drawn while it staggers.
pub fn stagger(m: Motion, now: integer, kx: integer, ky: integer, cell_dx: integer, cell_dy: integer,
               fx: integer, fy: integer, strength: integer = 1) {
  was = pose(m, fx, fy, now);
  m.from_x = was.x - cell_dx * 16;
  m.from_y = was.y - cell_dy * 16;
  m.act = Act.Stagger;
  m.start = now;
  m.knock_x = kx;
  m.knock_y = ky;
  m.strength = strength;
}

/// The character swings its weapon at `now`.
pub fn swing(m: Motion, now: integer) {
  m.act = Act.Swing;
  m.start = now;
}

/// The character parries at `now`: its weapon flicks out from across the body.
pub fn flick(m: Motion, now: integer) {
  m.act = Act.Flick;
  m.start = now;
}

/// A blow lands on the character's guard at `now`: pushed back (kx, ky), the guard held.
pub fn brace(m: Motion, now: integer, kx: integer, ky: integer) {
  m.act = Act.Brace;
  m.start = now;
  m.knock_x = kx;
  m.knock_y = ky;
}

// The stances: drawn over a figure's fine pose for as long as the rules hold them — no act of
// their own, so the act under them (a step, a brace) still moves the body.

/// Guarding (blocking): the weapon across the body, drawn in, the body crouched and leaning back.
pub fn guard(p: FinePose, fx: integer, fy: integer) {
  dir = sweep(fx, fy) as float;
  p.weapon = (facing(fx, fy) as float) - dir * (GUARD_TURN as float);
  p.reach = -1.0;
  p.y += 1.0;
  p.tilt -= dir * (GUARD_LEAN as float);
}

/// Winding up a blow, `w` of the way (0.0 to 1.0): the weapon raised back as a swing's wind-up,
/// or, for a sweep, swung far back level; leaning away, more for a sweep.
pub fn windup(p: FinePose, fx: integer, fy: integer, w: float, wide: boolean) {
  dir = sweep(fx, fy) as float;
  back = (if wide { SWEEP_WIND } else { ARC }) as float;
  p.weapon = (facing(fx, fy) as float) - dir * back * w;
  p.tilt -= dir * (if wide { 5.0 } else { 2.0 }) * w;
}

/// Left open by a parry: the weapon hanging out past its stroke, the body back and off balance.
pub fn open(p: FinePose, fx: integer, fy: integer) {
  dir = sweep(fx, fy) as float;
  p.weapon = (facing(fx, fy) as float) + dir * (OPEN_DROP as float);
  p.tilt -= dir * 6.0;
  p.x -= (fx * 2) as float;
  p.y -= (fy * 2) as float;
}

/// Wounded (a third of its health or less): sagging a pixel; standing (`still`), swaying.
pub fn wounded(p: FinePose, now: integer, still: boolean) {
  p.y += 1.0;
  if still { p.tilt += (SWAY_HURT as float) * sin(2.0 * PI * ((now % HURT_MS) as float) / (HURT_MS as float)); }
}
