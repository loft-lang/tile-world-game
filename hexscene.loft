//
// A place's hex version as the game reads it (`levels/<place>.hex.json`, written by
// tools/hextown.loft from the place's port, hextown.loft): its ground (a height and a surface kind
// per cell) and its houses (their outlines, the heights of their walls' foot, floor and eaves,
// their doors and windows).  The 3D view draws it in place of the square cells where a place has
// one (render3d.loft); play stays the square game's.
//
// Measures are metres, north up (x east, y north), a square tile i at x = 1.5 i, y = -1.5 j.
use hex_field;
use hex_ground;
use hex_draw;
use hexwalls;

/// A hex step, in metres: the scene's ground is `hex_ground`'s at this step.
pub const STEP = 1.5;

/// A door or a window: its kind (1 a door, 2 a window, 3 a bay window), the wall it is in, its span
/// from a to b.
pub struct Gap {
  pub kind: integer,
  pub wall: integer,
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float
}

/// A part of a house (owner, 2026-11-14: more kinds of houses): the house itself, a wing — its
/// four corners, the height of its eaves, its roof (0 pitched, 1 a roof garden, 2 flat, 3 an
/// attic's: gabled, with dormers, 4 a roof terrace), and where along its length its roof has a
/// dormer on each slope (metres from its middle).
pub struct Part {
  pub xs: vector<float>,
  pub ys: vector<float>,
  pub top: float,
  pub roof: integer,
  pub dormers: vector<float> = []
}

/// A stretch of wall from a to b, from height z0 up to z1: a house's wall over a lower wing's roof.
pub struct Rise {
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float,
  pub z0: float,
  pub z1: float
}

/// A house: the heights of its walls' foot, its floor and its eaves; its outline, corner by corner
/// (wall i runs from corner i - 1 to corner i); its doors and windows.
pub struct House {
  pub base: float,
  pub floor: float,
  pub top: float,
  pub xs: vector<float>,
  pub ys: vector<float>,
  pub gaps: vector<Gap>,
  /// Its roof: 0 pitched, 1 a roof garden (flat, a low wall round it).
  pub roof: integer = 0,
  /// Its inner court's corners, when it has one (four): open to the sky.
  pub court_xs: vector<float> = [],
  pub court_ys: vector<float> = [],
  /// Its parts, the house itself first; per wall of its outline the eaves of the part it belongs
  /// to and how far it is carried up past them as a low wall; its wall over its lower wings.
  pub parts: vector<Part> = [],
  pub tops: vector<float> = [],
  pub rims: vector<float> = [],
  pub rises: vector<Rise> = [],
  /// Its inner walls, each a stretch on one floor (z0 the floor's height; z1 1 for a doorway).
  pub inner: vector<Rise> = []
}

/// What stands along a yard's side (owner, 2026-11-14): its kind (1 a low wall, 2 a low hedge, 3 a
/// hedge a storey high, 4 a fence), from a to b, its height and its thickness; on the ground.
pub struct Fence {
  pub kind: integer,
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float,
  pub height: float,
  pub thick: float
}

/// A roof on pillars (a gazebo's): its middle, the height of its eaves, its width.
pub struct Canopy {
  pub x: float,
  pub y: float,
  pub z: float,
  pub size: float
}

/// The ground's structures with sides of no height (owner, 2026-11-09: a road's sides are walls
/// with no height): a road (the path cells), a rail, a stream (its bed and its pools).  Each is
/// cells inside and out like a house, its sides the straight walls `hexwalls::outlines` draws
/// from them, every loop of them (the blocks a road goes round too).
pub const ROAD = 1;
pub const RAIL = 2;
pub const STREAM = 3;
/// A cliff: a front the ground does not slope across (the place's cliff areas), its side a wall
/// as high as the drop, the ground of `level` and up on its left.
pub const CLIFF = 4;

/// One side of a structure's outline, a straight wall with no height, from (x1, y1) to (x2, y2)
/// metres, and the structure it bounds.
pub struct Side {
  pub area: integer,
  /// For a cliff: the level of the ground on its left (the drop is to level - 1 on its right).
  pub level: integer = 0,
  pub x1: float,
  pub y1: float,
  pub x2: float,
  pub y2: float
}

/// The sides near a cell, by its key: those that may cross its fan.
struct Near {
  key: integer,
  ids: vector<integer>
}

pub struct Scene {
  pub q0: integer,
  pub r0: integer,
  pub w: integer,
  pub h: integer,
  /// Its ground: a height (metres) and a surface kind per cell (`hex_ground`, a hex step 1.5 m).
  pub ground: hex_ground::Ground,
  pub storey: float,
  pub wall: float,
  /// How thick a wall between a house's rooms is drawn (hexsizes.json's inner wall).
  pub inner_wall: float = 0.45,
  pub houses: vector<House>,
  pub sides: vector<Side> = [],
  near: hash<Near[key]> = [],
  /// Each cell's terrace level, where the place gives them (0 where it gives none).
  pub levels: hex_field::Labels,
  pub fences: vector<Fence> = [],
  pub canopies: vector<Canopy> = []
}

fn num(v: const JsonValue) -> float {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { v.as_number() } else { 0.0 }
}

fn corner_key(k: integer, m: integer) -> integer { (k + 100000) * 200000 + m + 100000 }

/// The hex version in `text`, or none when there is none.
pub fn load(text: text) -> Scene? {
  if text == "" { return null; }
  v = json_parse(text);
  s = v.field("scene");
  g = s.field("ground");
  if g.kind() != "JObject" { return null; }
  q0 = num(g.field("q0")) as integer;
  r0 = num(g.field("r0")) as integer;
  gw = num(g.field("w")) as integer;
  gh_cells = num(g.field("h")) as integer;
  ground = hex_ground::ground_new(q0, r0, gw, gh_cells, STEP, 0);
  levels = hex_field::labels_new(q0, r0, gw, gh_cells);
  gh = g.field("heights");
  gk = g.field("kinds");
  gl = g.field("levels");
  for i in 0..gw * gh_cells {
    q = q0 + (i % gw ?? 0);
    r = r0 + (i / gw ?? 0);
    hex_field::height_set(ground.gr_heights, q, r, if i < gh.len() { num(gh.item(i)) } else { 0.0 });
    hex_field::label_set(ground.gr_kinds, q, r, if i < gk.len() { num(gk.item(i)) as integer } else { 0 });
    hex_field::label_set(levels, q, r, if i < gl.len() { num(gl.item(i)) as integer } else { 0 });
  }
  houses: vector<House> = [];
  hv = s.field("houses");
  for i in 0..hv.len() {
    h = hv.item(i);
    cs = h.field("corners");
    xs: vector<float> = [];
    ys: vector<float> = [];
    for j in 0..cs.len() {
      xs += [num(cs.item(j).item(0))];
      ys += [num(cs.item(j).item(1))];
    }
    gaps: vector<Gap> = [];
    os = h.field("openings");
    for j in 0..os.len() {
      o = os.item(j);
      gaps += [Gap { kind: num(o.field("kind")) as integer, wall: num(o.field("wall")) as integer,
                     ax: num(o.field("a").item(0)), ay: num(o.field("a").item(1)),
                     bx: num(o.field("b").item(0)), by: num(o.field("b").item(1)) }];
    }
    cxs: vector<float> = [];
    cys: vector<float> = [];
    ct = h.field("court");
    for j in 0..ct.len() {
      cxs += [num(ct.item(j).item(0))];
      cys += [num(ct.item(j).item(1))];
    }
    parts: vector<Part> = [];
    pv = h.field("parts");
    for j in 0..pv.len() {
      pt = pv.item(j);
      pxs: vector<float> = [];
      pys: vector<float> = [];
      pc = pt.field("corners");
      for c in 0..pc.len() {
        pxs += [num(pc.item(c).item(0))];
        pys += [num(pc.item(c).item(1))];
      }
      ds: vector<float> = [];
      dv = pt.field("dormers");
      for c in 0..dv.len() { ds += [num(dv.item(c))]; }
      parts += [Part { xs: pxs, ys: pys, top: num(pt.field("top")), roof: num(pt.field("roof")) as integer, dormers: ds }];
    }
    tops: vector<float> = [];
    rims: vector<float> = [];
    tv2 = h.field("tops");
    rv2 = h.field("rims");
    for j in 0..tv2.len() {
      tops += [num(tv2.item(j))];
      rims += [num(rv2.item(j))];
    }
    rises: vector<Rise> = [];
    rs = h.field("rises");
    for j in 0..rs.len() {
      r = rs.item(j);
      rises += [Rise { ax: num(r.field("a").item(0)), ay: num(r.field("a").item(1)), bx: num(r.field("b").item(0)),
                       by: num(r.field("b").item(1)), z0: num(r.field("z0")), z1: num(r.field("z1")) }];
    }
    inner: vector<Rise> = [];
    iv = h.field("inner");
    for j in 0..iv.len() {
      r = iv.item(j);
      inner += [Rise { ax: num(r.field("a").item(0)), ay: num(r.field("a").item(1)), bx: num(r.field("b").item(0)),
                       by: num(r.field("b").item(1)), z0: num(r.field("z")), z1: num(r.field("door")) }];
    }
    houses += [House { base: num(h.field("base")), floor: num(h.field("floor")), top: num(h.field("top")),
                       xs: xs, ys: ys, gaps: gaps, roof: num(h.field("roof")) as integer, court_xs: cxs, court_ys: cys,
                       parts: parts, tops: tops, rims: rims, rises: rises, inner: inner }];
  }
  sc = Scene { q0: q0, r0: r0, w: gw, h: gh_cells, ground: ground,
               storey: num(v.field("storey")), wall: num(v.field("wall")), houses: houses, levels: levels };
  if num(v.field("inner")) > 0.0 { sc.inner_wall = num(v.field("inner")); }
  fv = s.field("fences");
  for i in 0..fv.len() {
    f = fv.item(i);
    sc.fences += [Fence { kind: num(f.field("kind")) as integer, ax: num(f.field("a").item(0)), ay: num(f.field("a").item(1)),
                          bx: num(f.field("b").item(0)), by: num(f.field("b").item(1)), height: num(f.field("height")),
                          thick: num(f.field("thick")) }];
  }
  tv = s.field("things");
  for i in 0..tv.len() {
    th = tv.item(i);
    if th.field("kind").as_text() != "gazebo_roof" { continue; }
    sc.canopies += [Canopy { x: num(th.field("x")), y: num(th.field("y")), z: num(th.field("z")), size: num(th.field("size")) }];
  }
  // The cliffs, each cut in stretches of 1.5 m at most: a stretch is drawn with the cell its
  // middle lies in.
  cv = s.field("cliffs");
  for i in 0..cv.len() {
    c = cv.item(i);
    ax = num(c.field("a").item(0));
    ay = num(c.field("a").item(1));
    bx = num(c.field("b").item(0));
    by = num(c.field("b").item(1));
    l = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
    n = ceil(l / 1.5 ?? 1.0) as integer;
    if n < 1 { n = 1; }
    for j in 0..n {
      t0 = ((j as float) / (n as float)) ?? 0.0;
      t1 = (((j + 1) as float) / (n as float)) ?? 1.0;
      sc.sides += [Side { area: CLIFF, level: num(c.field("level")) as integer, x1: ax + (bx - ax) * t0, y1: ay + (by - ay) * t0,
                          x2: ax + (bx - ax) * t1, y2: ay + (by - ay) * t1 }];
    }
  }
  outline_areas(sc);
  sc
}

/// The cell kinds (hexterrain.loft) each structure is made of.
fn of_area(area: integer, kind: integer) -> boolean {
  if area == ROAD { return kind == 1; }
  if area == RAIL { return kind == 2; }
  kind == 3 || kind == 4
}

// @FR-HR-Sides: a road's sides are straight walls with no height, from its cells
/// Each structure's sides, from its cells (`hexwalls::outlines`), and which cells each may cross.
fn outline_areas(sc: Scene) {
  m = 0.8660254037844386;
  for area in [ROAD, RAIL, STREAM] {
    cells = hex_field::hexset_chunk(sc.q0, sc.r0, sc.w, sc.h);
    for r in sc.r0..sc.r0 + sc.h {
      for q in sc.q0..sc.q0 + sc.w {
        if of_area(area, cell_kind(sc, q, r)) { hex_field::hexset_set(cells, q, r, true); }
      }
    }
    for o in hex_draw::cells_outlines(cells, 0) {
      n = len(o.co_corners);
      for i in 0..n {
        (x1, y1) = o.co_corners[(i + n - 1) % n ?? 0] ?? (0.0, 0.0);
        (x2, y2) = o.co_corners[i] ?? (0.0, 0.0);
        sc.sides += [Side { area: area, x1: x1 * m, y1: y1 * m, x2: x2 * m, y2: y2 * m }];
      }
    }
  }
  // each side listed at every cell whose fan it may cross (a fan reaches 0.87 m from its centre)
  for id in 0..len(sc.sides) {
    sd = sc.sides[id];
    lo_x = (if sd.x1 < sd.x2 { sd.x1 } else { sd.x2 }) - 1.0;
    hi_x = (if sd.x1 < sd.x2 { sd.x2 } else { sd.x1 }) + 1.0;
    lo_y = (if sd.y1 < sd.y2 { sd.y1 } else { sd.y2 }) - 1.0;
    hi_y = (if sd.y1 < sd.y2 { sd.y2 } else { sd.y1 }) + 1.0;
    r0 = floor(lo_y / 1.299038105676658 ?? 0.0) as integer;
    r1 = ceil(hi_y / 1.299038105676658 ?? 0.0) as integer;
    q0 = floor(lo_x / 1.5 ?? 0.0) as integer - 1;
    q1 = ceil(hi_x / 1.5 ?? 0.0) as integer + 1;
    for r in r0..r1 + 1 {
      for q in q0..q1 + 1 {
        (cx, cy) = centre(q, r);
        if cx < lo_x || cx > hi_x || cy < lo_y || cy > hi_y { continue; }
        key = corner_key(q, r);
        e = sc.near[key];
        if e == null { sc.near += [Near { key: key, ids: [id] }]; } else { e.ids += [id]; }
      }
    }
  }
}

/// The sides that may cross cell (q, r)'s fan.
pub fn sides_near(s: const Scene, q: integer, r: integer) -> vector<integer> {
  e = s.near[corner_key(q, r)];
  if e == null { return []; }
  e.ids
}

/// The structure the point (x, y) metres lies in (ROAD, RAIL or STREAM), 0 for none: inside its
/// sides, counted over all its loops.
pub fn area_at(s: const Scene, x: float, y: float) -> integer {
  for area in [ROAD, RAIL, STREAM] {
    inside = false;
    for sd in s.sides {
      if sd.area != area { continue; }
      if (sd.y1 > y) != (sd.y2 > y) {
        cx = sd.x1 + (y - sd.y1) * (sd.x2 - sd.x1) / (sd.y2 - sd.y1) ?? sd.x1;
        if x < cx { inside = !inside; }
      }
    }
    if inside { return area; }
  }
  0
}

/// The height of cell (q, r), 0 beyond the scene.
pub fn cell_height(s: const Scene, q: integer, r: integer) -> float { hex_field::height_get(s.ground.gr_heights, q, r) }

/// The surface kind of cell (q, r), 0 (grass) beyond the scene.
pub fn cell_kind(s: const Scene, q: integer, r: integer) -> integer {
  if q < s.q0 || q >= s.q0 + s.w || r < s.r0 || r >= s.r0 + s.h { return 0; }
  hex_field::label_get(s.ground.gr_kinds, q, r)
}

// @FR-HG-Surface: a corner's height is the mean of the cells round it
/// The height of corner (k, m) of the lattice (doubled coordinates): the mean of its cells
/// (`hex_ground::ground_corner_height`).
pub fn corner_height(s: const Scene, k: integer, m: integer) -> float { hex_ground::ground_corner_height(s.ground, k, m) }

/// A cell's centre, in metres.
pub fn centre(q: integer, r: integer) -> (float, float) { hex_ground::ground_centre(STEP, q, r) }

/// The cell whose centre is nearest (x, y) metres.
pub fn cell_near(x: float, y: float) -> (integer, integer) { hex_ground::ground_cell_near(STEP, x, y) }

/// The ground's height at (x, y) metres, as it is drawn: by a cliff, the surface of the side the
/// point lies on; elsewhere within the triangle of its cell's fan that holds the point
/// (`hex_ground::ground_height_at`).
pub fn height_at(s: const Scene, x: float, y: float) -> float {
  (q, r) = cell_near(x, y);
  id = cliff_near(s, q, r, x, y);
  if id >= 0 {
    sd = s.sides[id];
    return height_on(s, x, y, sd.level, above_cliff(s, id, x, y));
  }
  hex_ground::ground_height_at(s.ground, x, y)
}

/// Is (x, y) inside the ring of corners (xs, ys) (crossings of a ray towards +x)?
fn in_ring(xs: const vector<float>, ys: const vector<float>, x: float, y: float) -> boolean {
  n = len(xs);
  inside = false;
  for j in 0..n {
    x1 = xs[(j + n - 1) % n ?? 0] ?? 0.0;
    y1 = ys[(j + n - 1) % n ?? 0] ?? 0.0;
    x2 = xs[j] ?? 0.0;
    y2 = ys[j] ?? 0.0;
    if (y1 > y) != (y2 > y) {
      cx = x1 + (y - y1) * (x2 - x1) / (y2 - y1) ?? x1;
      if x < cx { inside = !inside; }
    }
  }
  inside
}

/// The house whose outline holds (x, y) metres, or -1.
pub fn house_at(s: const Scene, x: float, y: float) -> integer {
  for i in 0..len(s.houses) {
    if in_ring(s.houses[i].xs, s.houses[i].ys, x, y) { return i; }
  }
  -1
}

/// Does (x, y) lie in house `i`'s inner court?
pub fn in_court(s: const Scene, i: integer, x: float, y: float) -> boolean {
  in_ring(s.houses[i].court_xs, s.houses[i].court_ys, x, y)
}

// ── cliffs ──────────────────────────────────────────────────────────────────

/// A cell's terrace level (0 where the place gives none, and beyond the scene).
pub fn cell_level(s: const Scene, q: integer, r: integer) -> integer {
  if q < s.q0 || q >= s.q0 + s.w || r < s.r0 || r >= s.r0 + s.h { return 0; }
  hex_field::label_get(s.levels, q, r)
}

/// The cliff nearest (x, y) among those that may cross cell (q, r)'s fan, -1 for none.
pub fn cliff_near(s: const Scene, q: integer, r: integer, x: float, y: float) -> integer {
  best = -1;
  best_d = 0.0;
  for id in sides_near(s, q, r) {
    sd = s.sides[id];
    if sd.area != CLIFF { continue; }
    dx = sd.x2 - sd.x1;
    dy = sd.y2 - sd.y1;
    l2 = dx * dx + dy * dy;
    t = if l2 > 0.0 { ((x - sd.x1) * dx + (y - sd.y1) * dy) / l2 ?? 0.0 } else { 0.0 };
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    ex = x - sd.x1 - t * dx;
    ey = y - sd.y1 - t * dy;
    d = ex * ex + ey * ey;
    if best < 0 || d < best_d {
      best = id;
      best_d = d;
    }
  }
  best
}

/// Does (x, y) lie on the high side of cliff `id` (its left)?
pub fn above_cliff(s: const Scene, id: integer, x: float, y: float) -> boolean {
  sd = s.sides[id];
  (sd.x2 - sd.x1) * (y - sd.y1) - (sd.y2 - sd.y1) * (x - sd.x1) > 0.0
}

// @FR-HG-Cliff: either side of a cliff its own surface, from the cells on that side only
/// The ground's height at (x, y) on one side of a cliff: on its high side (`high`, the cells of
/// `level` and up) or its low one (`hex_ground::ground_height_on`).
pub fn height_on(s: const Scene, x: float, y: float, level: integer, high: boolean) -> float {
  hex_ground::ground_height_on(s.ground, s.levels, x, y, level, high, s.storey)
}

/// The ground's height at (x, y) for one standing on layer `z`: by a cliff, the surface of the
/// side that layer is on; elsewhere the ground's.
pub fn height_at_layer(s: const Scene, x: float, y: float, z: integer) -> float {
  (q, r) = cell_near(x, y);
  id = cliff_near(s, q, r, x, y);
  if id < 0 { return height_at(s, x, y); }
  sd = s.sides[id];
  height_on(s, x, y, sd.level, z >= sd.level)
}
