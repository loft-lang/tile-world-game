//
// A place's hex version as the game reads it (`levels/<place>.hex.json`, written by
// tools/hextown.loft from the place's port, hextown.loft): its ground (a height and a surface kind
// per cell) and its houses (their outlines, the heights of their walls' foot, floor and eaves,
// their doors and windows).  The 3D view draws it in place of the square cells where a place has
// one (render3d.loft); play stays the square game's.
//
// Measures are metres, north up (x east, y north), a square tile i at x = 1.5 i, y = -1.5 j.
use hex_field;
use hexwalls;

/// A door or a window: its kind (1 a door, 2 a window), the wall it is in, its span from a to b.
pub struct Gap {
  pub kind: integer,
  pub wall: integer,
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float
}

/// A house: the heights of its walls' foot, its floor and its eaves; its outline, corner by corner
/// (wall i runs from corner i - 1 to corner i); its doors and windows.
pub struct House {
  pub base: float,
  pub floor: float,
  pub top: float,
  pub xs: vector<float>,
  pub ys: vector<float>,
  pub gaps: vector<Gap>
}

struct Corner {
  key: integer,
  h: float
}

/// The ground's structures with sides of no height (owner, 2026-11-09: a road's sides are walls
/// with no height): a road (the path cells), a rail, a stream (its bed and its pools).  Each is
/// cells inside and out like a house, its sides the straight walls `hexwalls::outlines` draws
/// from them, every loop of them (the blocks a road goes round too).
pub const ROAD = 1;
pub const RAIL = 2;
pub const STREAM = 3;
/// A cliff: a front the ground does not slope across (the place's cliff areas), its side a wall
/// as high as the drop, the ground of `level` and up on its left.
pub const CLIFF = 4;

/// One side of a structure's outline, a straight wall with no height, from (x1, y1) to (x2, y2)
/// metres, and the structure it bounds.
pub struct Side {
  pub area: integer,
  /// For a cliff: the level of the ground on its left (the drop is to level - 1 on its right).
  pub level: integer = 0,
  pub x1: float,
  pub y1: float,
  pub x2: float,
  pub y2: float
}

/// The sides near a cell, by its key: those that may cross its fan.
struct Near {
  key: integer,
  ids: vector<integer>
}

pub struct Scene {
  pub q0: integer,
  pub r0: integer,
  pub w: integer,
  pub h: integer,
  pub heights: vector<float>,
  pub kinds: vector<integer>,
  pub storey: float,
  pub wall: float,
  pub houses: vector<House>,
  corners: hash<Corner[key]>,
  pub sides: vector<Side> = [],
  near: hash<Near[key]> = [],
  /// Each cell's terrace level, where the place gives them.
  pub levels: vector<integer> = []
}

fn num(v: const JsonValue) -> float {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { v.as_number() } else { 0.0 }
}

fn corner_key(k: integer, m: integer) -> integer { (k + 100000) * 200000 + m + 100000 }

const CK = [0, -1, -1, 0, 1, 1];
const CM = [2, 1, -1, -2, -1, 1];

/// The hex version in `text`, or none when there is none.
pub fn load(text: text) -> Scene? {
  if text == "" { return null; }
  v = json_parse(text);
  s = v.field("scene");
  g = s.field("ground");
  if g.kind() != "JObject" { return null; }
  hs: vector<float> = [];
  ks: vector<integer> = [];
  ls: vector<integer> = [];
  gh = g.field("heights");
  gk = g.field("kinds");
  gl = g.field("levels");
  for i in 0..gh.len() {
    hs += [num(gh.item(i))];
    ks += [num(gk.item(i)) as integer];
    if gl.len() > i { ls += [num(gl.item(i)) as integer]; }
  }
  houses: vector<House> = [];
  hv = s.field("houses");
  for i in 0..hv.len() {
    h = hv.item(i);
    cs = h.field("corners");
    xs: vector<float> = [];
    ys: vector<float> = [];
    for j in 0..cs.len() {
      xs += [num(cs.item(j).item(0))];
      ys += [num(cs.item(j).item(1))];
    }
    gaps: vector<Gap> = [];
    os = h.field("openings");
    for j in 0..os.len() {
      o = os.item(j);
      gaps += [Gap { kind: num(o.field("kind")) as integer, wall: num(o.field("wall")) as integer,
                     ax: num(o.field("a").item(0)), ay: num(o.field("a").item(1)),
                     bx: num(o.field("b").item(0)), by: num(o.field("b").item(1)) }];
    }
    houses += [House { base: num(h.field("base")), floor: num(h.field("floor")), top: num(h.field("top")),
                       xs: xs, ys: ys, gaps: gaps }];
  }
  sc = Scene { q0: num(g.field("q0")) as integer, r0: num(g.field("r0")) as integer,
               w: num(g.field("w")) as integer, h: num(g.field("h")) as integer, heights: hs, kinds: ks,
               storey: num(v.field("storey")), wall: num(v.field("wall")), houses: houses, corners: [], levels: ls };
  // The cliffs, each cut in stretches of 1.5 m at most: a stretch is drawn with the cell its
  // middle lies in.
  cv = s.field("cliffs");
  for i in 0..cv.len() {
    c = cv.item(i);
    ax = num(c.field("a").item(0));
    ay = num(c.field("a").item(1));
    bx = num(c.field("b").item(0));
    by = num(c.field("b").item(1));
    l = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
    n = ceil(l / 1.5 ?? 1.0) as integer;
    if n < 1 { n = 1; }
    for j in 0..n {
      t0 = ((j as float) / (n as float)) ?? 0.0;
      t1 = (((j + 1) as float) / (n as float)) ?? 1.0;
      sc.sides += [Side { area: CLIFF, level: num(c.field("level")) as integer, x1: ax + (bx - ax) * t0, y1: ay + (by - ay) * t0,
                          x2: ax + (bx - ax) * t1, y2: ay + (by - ay) * t1 }];
    }
  }
  // Each corner at the mean height of the cells round it.
  sums: hash<Corner[key]> = [];
  counts: hash<Corner[key]> = [];
  for r in sc.r0..sc.r0 + sc.h {
    for q in sc.q0..sc.q0 + sc.w {
      z = cell_height(sc, q, r);
      k = hex_field::lattice_k(q, r);
      m = hex_field::lattice_m(q, r);
      for j in 0..6 {
        key = corner_key(k + (CK[j] ?? 0), m + (CM[j] ?? 0));
        s0 = sums[key];
        if s0 == null {
          sums += [Corner { key: key, h: z }];
          counts += [Corner { key: key, h: 1.0 }];
        } else {
          s0.h += z;
          c0 = counts[key]!;
          c0.h += 1.0;
        }
      }
    }
  }
  for c in sums { sc.corners += [Corner { key: c.key, h: (c.h / (counts[c.key]!).h) ?? 0.0 }]; }
  outline_areas(sc);
  sc
}

/// The cell kinds (hexterrain.loft) each structure is made of.
fn of_area(area: integer, kind: integer) -> boolean {
  if area == ROAD { return kind == 1; }
  if area == RAIL { return kind == 2; }
  kind == 3 || kind == 4
}

// @FR-HR-Sides: a road's sides are straight walls with no height, from its cells
/// Each structure's sides, from its cells (`hexwalls::outlines`), and which cells each may cross.
fn outline_areas(sc: Scene) {
  m = 0.8660254037844386;
  for area in [ROAD, RAIL, STREAM] {
    cells = hex_field::hexset_chunk(sc.q0, sc.r0, sc.w, sc.h);
    for r in sc.r0..sc.r0 + sc.h {
      for q in sc.q0..sc.q0 + sc.w {
        if of_area(area, cell_kind(sc, q, r)) { hex_field::hexset_set(cells, q, r, true); }
      }
    }
    for o in hexwalls::outlines(cells, 0) {
      n = len(o.corners);
      for i in 0..n {
        (x1, y1) = o.corners[(i + n - 1) % n ?? 0] ?? (0.0, 0.0);
        (x2, y2) = o.corners[i] ?? (0.0, 0.0);
        sc.sides += [Side { area: area, x1: x1 * m, y1: y1 * m, x2: x2 * m, y2: y2 * m }];
      }
    }
  }
  // each side listed at every cell whose fan it may cross (a fan reaches 0.87 m from its centre)
  for id in 0..len(sc.sides) {
    sd = sc.sides[id];
    lo_x = (if sd.x1 < sd.x2 { sd.x1 } else { sd.x2 }) - 1.0;
    hi_x = (if sd.x1 < sd.x2 { sd.x2 } else { sd.x1 }) + 1.0;
    lo_y = (if sd.y1 < sd.y2 { sd.y1 } else { sd.y2 }) - 1.0;
    hi_y = (if sd.y1 < sd.y2 { sd.y2 } else { sd.y1 }) + 1.0;
    r0 = floor(lo_y / 1.299038105676658 ?? 0.0) as integer;
    r1 = ceil(hi_y / 1.299038105676658 ?? 0.0) as integer;
    q0 = floor(lo_x / 1.5 ?? 0.0) as integer - 1;
    q1 = ceil(hi_x / 1.5 ?? 0.0) as integer + 1;
    for r in r0..r1 + 1 {
      for q in q0..q1 + 1 {
        (cx, cy) = centre(q, r);
        if cx < lo_x || cx > hi_x || cy < lo_y || cy > hi_y { continue; }
        key = corner_key(q, r);
        e = sc.near[key];
        if e == null { sc.near += [Near { key: key, ids: [id] }]; } else { e.ids += [id]; }
      }
    }
  }
}

/// The sides that may cross cell (q, r)'s fan.
pub fn sides_near(s: const Scene, q: integer, r: integer) -> vector<integer> {
  e = s.near[corner_key(q, r)];
  if e == null { return []; }
  e.ids
}

/// The structure the point (x, y) metres lies in (ROAD, RAIL or STREAM), 0 for none: inside its
/// sides, counted over all its loops.
pub fn area_at(s: const Scene, x: float, y: float) -> integer {
  for area in [ROAD, RAIL, STREAM] {
    inside = false;
    for sd in s.sides {
      if sd.area != area { continue; }
      if (sd.y1 > y) != (sd.y2 > y) {
        cx = sd.x1 + (y - sd.y1) * (sd.x2 - sd.x1) / (sd.y2 - sd.y1) ?? sd.x1;
        if x < cx { inside = !inside; }
      }
    }
    if inside { return area; }
  }
  0
}

/// The height of cell (q, r), 0 beyond the scene.
pub fn cell_height(s: const Scene, q: integer, r: integer) -> float {
  if q < s.q0 || q >= s.q0 + s.w || r < s.r0 || r >= s.r0 + s.h { return 0.0; }
  s.heights[(r - s.r0) * s.w + (q - s.q0)] ?? 0.0
}

/// The surface kind of cell (q, r), 0 (grass) beyond the scene.
pub fn cell_kind(s: const Scene, q: integer, r: integer) -> integer {
  if q < s.q0 || q >= s.q0 + s.w || r < s.r0 || r >= s.r0 + s.h { return 0; }
  s.kinds[(r - s.r0) * s.w + (q - s.q0)] ?? 0
}

/// The height of corner (k, m) of the lattice (doubled coordinates): the mean of its three cells.
pub fn corner_height(s: const Scene, k: integer, m: integer) -> float {
  c = s.corners[corner_key(k, m)];
  if c == null { return 0.0; }
  c.h
}

/// A cell's centre, in metres.
pub fn centre(q: integer, r: integer) -> (float, float) {
  ((hex_field::lattice_k(q, r) as float) * 0.75, (hex_field::lattice_m(q, r) as float) * 0.4330127018922193)
}

/// The cell whose centre is nearest (x, y) metres.
pub fn cell_near(x: float, y: float) -> (integer, integer) {
  r = round(y / 1.299038105676658) as integer;
  q = round(((x / 0.75) - ((r & 1) as float)) * 0.5) as integer;
  best_q = q;
  best_r = r;
  best = -1.0;
  for dr in -1..2 {
    for dq in -1..2 {
      (cx, cy) = centre(q + dq, r + dr);
      d = (cx - x) * (cx - x) + (cy - y) * (cy - y);
      if best < 0.0 || d < best {
        best = d;
        best_q = q + dq;
        best_r = r + dr;
      }
    }
  }
  (best_q, best_r)
}

/// The ground's height at (x, y) metres, as it is drawn: within the triangle of its cell's fan
/// that holds the point, between the cell's centre and the two corners.
pub fn height_at(s: const Scene, x: float, y: float) -> float {
  (q, r) = cell_near(x, y);
  id = cliff_near(s, q, r, x, y);
  if id >= 0 {
    sd = s.sides[id];
    return height_on(s, x, y, sd.level, above_cliff(s, id, x, y));
  }
  (cx, cy) = centre(q, r);
  k = hex_field::lattice_k(q, r);
  m = hex_field::lattice_m(q, r);
  // the corner the point lies past, going round anticlockwise from corner 0 (north)
  a = atan2(y - cy, x - cx) * 180.0 / PI;
  // corner j sits at 90 + 60 j degrees
  t = (a - 90.0) / 60.0;
  j = floor(t) as integer;
  f = t - (j as float);
  j0 = ((j % 6) + 6) % 6 ?? 0;
  j1 = (j0 + 1) % 6 ?? 0;
  (ax, ay) = ((CK[j0] ?? 0) as float * 0.75, (CM[j0] ?? 0) as float * 0.4330127018922193);
  (bx, by) = ((CK[j1] ?? 0) as float * 0.75, (CM[j1] ?? 0) as float * 0.4330127018922193);
  // barycentric in the triangle (centre, a, b)
  px = x - cx;
  py = y - cy;
  det = ax * by - ay * bx;
  wa = ((px * by - py * bx) / det) ?? 0.0;
  wb = ((ax * py - ay * px) / det) ?? 0.0;
  wc = 1.0 - wa - wb;
  _ = f;
  wc * cell_height(s, q, r) + wa * corner_height(s, k + (CK[j0] ?? 0), m + (CM[j0] ?? 0))
    + wb * corner_height(s, k + (CK[j1] ?? 0), m + (CM[j1] ?? 0))
}

/// The house whose outline holds (x, y) metres, or -1.
pub fn house_at(s: const Scene, x: float, y: float) -> integer {
  for i in 0..len(s.houses) {
    h = s.houses[i];
    n = len(h.xs);
    inside = false;
    for j in 0..n {
      x1 = h.xs[(j + n - 1) % n ?? 0] ?? 0.0;
      y1 = h.ys[(j + n - 1) % n ?? 0] ?? 0.0;
      x2 = h.xs[j] ?? 0.0;
      y2 = h.ys[j] ?? 0.0;
      if (y1 > y) != (y2 > y) {
        cx = x1 + (y - y1) * (x2 - x1) / (y2 - y1) ?? x1;
        if x < cx { inside = !inside; }
      }
    }
    if inside { return i; }
  }
  -1
}

// ── cliffs ──────────────────────────────────────────────────────────────────

/// A cell's terrace level (0 where the place gives none).
pub fn cell_level(s: const Scene, q: integer, r: integer) -> integer {
  if q < s.q0 || q >= s.q0 + s.w || r < s.r0 || r >= s.r0 + s.h { return 0; }
  s.levels[(r - s.r0) * s.w + (q - s.q0)] ?? 0
}

/// The cliff nearest (x, y) among those that may cross cell (q, r)'s fan, -1 for none.
pub fn cliff_near(s: const Scene, q: integer, r: integer, x: float, y: float) -> integer {
  best = -1;
  best_d = 0.0;
  for id in sides_near(s, q, r) {
    sd = s.sides[id];
    if sd.area != CLIFF { continue; }
    dx = sd.x2 - sd.x1;
    dy = sd.y2 - sd.y1;
    l2 = dx * dx + dy * dy;
    t = if l2 > 0.0 { ((x - sd.x1) * dx + (y - sd.y1) * dy) / l2 ?? 0.0 } else { 0.0 };
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    ex = x - sd.x1 - t * dx;
    ey = y - sd.y1 - t * dy;
    d = ex * ex + ey * ey;
    if best < 0 || d < best_d {
      best = id;
      best_d = d;
    }
  }
  best
}

/// Does (x, y) lie on the high side of cliff `id` (its left)?
pub fn above_cliff(s: const Scene, id: integer, x: float, y: float) -> boolean {
  sd = s.sides[id];
  (sd.x2 - sd.x1) * (y - sd.y1) - (sd.y2 - sd.y1) * (x - sd.x1) > 0.0
}

// @FR-HG-Cliff: either side of a cliff its own surface, from the cells on that side only
/// The ground's height at (x, y) on one side of a cliff: on its high side (`high`, the cells of
/// `level` and up) or its low one, each corner the mean of the cells round it on that side only,
/// so the ground does not slope down the cliff.  A corner with no cell on that side, or the centre
/// of a cell on the other, takes that side's storey.
pub fn height_on(s: const Scene, x: float, y: float, level: integer, high: boolean) -> float {
  (q, r) = cell_near(x, y);
  (cx, cy) = centre(q, r);
  k = hex_field::lattice_k(q, r);
  m = hex_field::lattice_m(q, r);
  a = atan2(y - cy, x - cx) * 180.0 / PI;
  j0 = (((floor((a - 90.0) / 60.0) as integer) % 6) + 6) % 6 ?? 0;
  j1 = (j0 + 1) % 6 ?? 0;
  own = (if high { level } else { level - 1 } as float) * s.storey;
  hc = if (cell_level(s, q, r) >= level) == high { cell_height(s, q, r) } else { own };
  ha = corner_on(s, k + (CK[j0] ?? 0), m + (CM[j0] ?? 0), j0, level, high, own);
  hb = corner_on(s, k + (CK[j1] ?? 0), m + (CM[j1] ?? 0), j1, level, high, own);
  (ax, ay) = ((CK[j0] ?? 0) as float * 0.75, (CM[j0] ?? 0) as float * 0.4330127018922193);
  (bx, by) = ((CK[j1] ?? 0) as float * 0.75, (CM[j1] ?? 0) as float * 0.4330127018922193);
  px = x - cx;
  py = y - cy;
  det = ax * by - ay * bx;
  wa = ((px * by - py * bx) / det) ?? 0.0;
  wb = ((ax * py - ay * px) / det) ?? 0.0;
  (1.0 - wa - wb) * hc + wa * ha + wb * hb
}

/// Corner (k, m), the j-th of a cell, as the mean of the cells round it on one side of the cliff
/// of `level`: the cells lie away from it along headings j, j + 2 and j + 4.
fn corner_on(s: const Scene, k: integer, m: integer, j: integer, level: integer, high: boolean, own: float) -> float {
  sum = 0.0;
  n = 0;
  for t in 0..3 {
    i = (j + 2 * t) % 6 ?? 0;
    ck = k - (CK[i] ?? 0);
    cm = m - (CM[i] ?? 0);
    r = cm / 3 ?? 0;
    q = (ck - (r & 1)) / 2 ?? 0;
    if (cell_level(s, q, r) >= level) == high {
      sum += cell_height(s, q, r);
      n += 1;
    }
  }
  if n == 0 { own } else { (sum / (n as float)) ?? own }
}

/// The ground's height at (x, y) for one standing on layer `z`: by a cliff, the surface of the
/// side that layer is on; elsewhere the ground's.
pub fn height_at_layer(s: const Scene, x: float, y: float, z: integer) -> float {
  (q, r) = cell_near(x, y);
  id = cliff_near(s, q, r, x, y);
  if id < 0 { return height_at(s, x, y); }
  sd = s.sides[id];
  height_on(s, x, y, sd.level, z >= sd.level)
}
