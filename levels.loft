// Level files: one place as JSON (EDITOR.md § 2).  The cells of each layer as chunks of rows,
// one character per cell through a legend; the ground of a layer; the edges between cells and
// the rise of a cell; the things as named stacks; where the hero starts; the goal and the
// camera, as data.  A chunk is tile_world's 32x32, and the file holds only the chunks that
// exist.
//
//   {
//     "name": "the first climb",
//     "camera": "follow",
//     "legend": { "#": "wall", ".": "floor", "_": "void" },
//     "ground": [ { "z": 0, "kind": "floor", "tile": 0 } ],
//     "chunks": [ { "cx": 0, "cy": 0, "z": 0, "rows": ["#####", "#._.#"] } ],
//     "things": [ { "at": [9, 2, 0], "stack": ["table", "chair"] } ],
//     "tiles": [ [3, 4, 0, 12] ],
//     "edges": [ [2, 1, 0, "N", "wall"], [3, 1, 0, "W", "door"] ],
//     "rises": [ [5, 5, 0, 2] ],
//     "enemies": [ ["rat", 7, 3, 0] ],
//     "doors": [ { "at": [1, 8, 0], "to": "world", "door": "first_climb" } ],
//     "labels": [ { "at": [6, 3, 0], "text": "THE CELLAR" } ],
//     "start": [1, 1, 0],
//     "goal": { "type": "layer", "z": 1 }
//   }
//
// A row's characters run from the chunk's west edge.  A space, or a cell past the row's end, is
// UNSET: it reads as its layer's ground, or void when the layer has none.  `_` is void set on
// purpose (a pit in the ground).  `tiles` lists only the set cells whose tile number is not 0;
// `edges` each cell's north and west edge that is not empty (an E or S side reads as the
// neighbour's W or N); `rises` the cells that rise.  Saving writes the world in a fixed order,
// so the same level always writes the same file.
//
// A DOOR joins this place to another (WORLD.md § The world): walking onto its cell takes the
// hero to door `door` of place `to` (a file in levels/), standing just outside it.  A door's
// name is the place it leads to unless the file names it (`"name"`, for a second door to the
// same place).  Which side the hero comes out on is derived — the first of south, north, east
// and west with ground to stand on — and `"out": "N"` sets it by hand.  A LABEL is text written
// on the map at a cell: what a house holds, where a road goes.
use tile_world;
use rules;
use materials;
use intent;
use talk;

const CHUNK = 32;

// The legend's mark for void set on purpose.
const PIT = -1;

/// What solves a level: "layer" (the hero reaches layer z), "daylight" (the hero stands under
/// the open sky), "cell" (the hero reaches (x, y, z)), or "chests" (every chest is open).
pub struct Goal {
  pub kind: text,
  pub x: integer,
  pub y: integer,
  pub z: integer
}

/// A door to another place: its name here, its cell, the place it leads to and the door there;
/// `out` the side the hero comes out on when set by hand ("N", "E", "S", "W"), "" derived.
pub struct Door {
  pub name: text,
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub to: text,
  pub door: text,
  pub out: text,
  /// Someone's home (BUILD.md C2b): going in while seen is snooping (rules::seen_by_people).
  pub home: boolean = false,
  /// Shut until this holds (C9: the barn, open once the bargain is struck; `rules::holds`).
  pub needs: text = ""
}

/// Text written on the map, centred on cell (x, y) of layer z.
pub struct Label {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub says: text
}

/// A level as its file holds it: the level itself, its name, where the hero starts, what solves
/// it, and how the view follows the hero: "follow" (it scrolls when the hero nears the edge) or
/// "rooms" (it flips a screen at a time).
pub struct LevelFile {
  pub name: text,
  pub camera: text,
  pub level: rules::Level,
  pub start_x: integer,
  pub start_y: integer,
  pub start_z: integer,
  pub goal: Goal,
  /// What the developer said about the place (rooms and corridors with their words), and the
  /// cells set by hand that filling it in again keeps (intent::key_of each).  The cells above are
  /// the place as it is; these are what `editor::refill` works from.
  pub intent: intent::Intent = intent::no_intent(),
  pub adjusted: vector<integer> = [],
  /// The doors to other places, and the text written on the map.
  pub doors: vector<Door> = [],
  pub labels: vector<Label> = [],
  /// What the figures that talk say, and the choices in it (talk.loft).
  pub talks: vector<talk::Talk> = [],
  /// What the place serves: parts of the story (`@ST-Decree`, STORY.md) and gameplay mechanics
  /// (`@GM-CartLift`, DESIGN.md); checked by `loft tools/tags.loft check`.
  pub serves: vector<text> = []
}

struct LegendChar {
  const ch: text,
  kind: integer,
  /// The material the character names (materials.loft), -1 for a bare terrain kind.
  material: integer
}

pub fn num(v: const JsonValue, default: integer) -> integer {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { (v.as_number() as integer) ?? default } else { default }
}

pub fn str(v: const JsonValue, default: text) -> text {
  if v.kind() == "JString" { v.as_text() } else { default }
}

fn side_of(letter: text) -> integer {
  if letter == "N" { tile_world::NORTH }
  else if letter == "E" { tile_world::EAST }
  else if letter == "S" { tile_world::SOUTH }
  else { tile_world::WEST }
}

/// The level a level file's JSON holds, its kinds named through `k`.  Null when it does not
/// parse; a name `k` does not declare reads as unset, nothing, no edge.
pub fn load(raw: text, k: const rules::Kinds) -> LevelFile? {
  load_with(raw, k, materials::none())
}

/// The same, with the materials the legend may name (theme.json's): a material's cells get its
/// kind and, once every cell is read, the tile it shows there — a variant by position, an
/// autotile piece by its neighbours.  A `tiles` override is applied after, and wins.
pub fn load_with(raw: text, k: const rules::Kinds, mats: const materials::Materials) -> LevelFile? {
  v = json_parse(raw);
  if v.kind() != "JObject" { return null; }
  l = rules::level(k);
  for t in mats.track { rules::add_piece(l, t.tile, t.joins, t.toe, t.straight, t.turn, t.set_turn, t.twin); }
  legend: hash<LegendChar[ch]> = [];
  lg = v.field("legend");
  for c in lg.keys() {
    name = lg.field(c).as_text();
    mi = materials::named(mats, name);
    mk = if mi >= 0 { (mats.list[mi] ?? materials::none_material()).kind } else { 0 };
    legend += [LegendChar {
      ch: c, kind: if mi >= 0 { mk } else if name == "void" { PIT } else { rules::terrain_id(k, name) },
      material: mi
    }];
  }
  gr = v.field("ground");
  for i in 0..gr.len() {
    g = gr.item(i);
    tile_world::set_ground(l.w, num(g.field("z"), 0), rules::terrain_id(k, str(g.field("kind"), "")),
                           num(g.field("tile"), 0));
  }
  chunks = v.field("chunks");
  for i in 0..chunks.len() {
    c = chunks.item(i);
    x0 = num(c.field("cx"), 0) * CHUNK;
    y0 = num(c.field("cy"), 0) * CHUNK;
    z = num(c.field("z"), 0);
    rows = c.field("rows");
    for j in 0..rows.len() {
      x = x0;
      for ch in rows.item(j).as_text() {
        e = legend["{ch}"];
        kind = if e { e.kind } else { 0 };
        mi = if e { e.material } else { -1 };
        if kind == PIT {
          tile_world::set_terrain(l.w, x, y0 + j, z, tile_world::VOID);
        } else if mi >= 0 {
          tile_world::set_terrain(l.w, x, y0 + j, z, kind, (mats.list[mi] ?? materials::none_material()).tile);
        } else if kind != 0 {
          tile_world::set_terrain(l.w, x, y0 + j, z, kind);
        }
        x += 1;
      }
    }
  }
  things = v.field("things");
  for i in 0..things.len() {
    t = things.item(i);
    at = t.field("at");
    stack = t.field("stack");
    for s in 0..stack.len() {
      id = rules::thing_id(k, stack.item(s).as_text());
      if id != 0 {
        tile_world::place(l.w, num(at.item(0), 0), num(at.item(1), 0), num(at.item(2), 0), id);
      }
    }
  }
  materials::retile_all(mats, l.w);
  tiles = v.field("tiles");
  for i in 0..tiles.len() {
    t = tiles.item(i);
    x = num(t.item(0), 0);
    y = num(t.item(1), 0);
    z = num(t.item(2), 0);
    tile_world::set_terrain(l.w, x, y, z, tile_world::terrain(l.w, x, y, z), num(t.item(3), 0));
  }
  edges = v.field("edges");
  for i in 0..edges.len() {
    e = edges.item(i);
    tile_world::set_edge(l.w, num(e.item(0), 0), num(e.item(1), 0), num(e.item(2), 0),
                         side_of(str(e.item(3), "")), rules::edge_id(k, str(e.item(4), "")));
  }
  rises = v.field("rises");
  for i in 0..rises.len() {
    r = rises.item(i);
    tile_world::set_rise(l.w, num(r.item(0), 0), num(r.item(1), 0), num(r.item(2), 0), num(r.item(3), 0));
  }
  // Enemies, each at its nest (a level without any writes no `enemies`).
  ens = v.field("enemies");
  for i in 0..ens.len() {
    e = ens.item(i);
    _ = rules::add_enemy(l, e.item(0).as_text(), num(e.item(1), 0), num(e.item(2), 0), num(e.item(3), 0));
    // A fifth: what it holds, when not what its kind holds ("none": nothing).
    if e.len() > 4 { rules::arm_enemy(l, len(l.enemies) - 1, e.item(4).as_text()); }
  }
  // The file's list is a set: its order does not matter.
  rules::order_enemies(l);
  st = v.field("start");
  sx = num(st.item(0), 0);
  sy = num(st.item(1), 0);
  sz = num(st.item(2), 0);
  rules::put_hero(l, sx, sy, sz);
  g = v.field("goal");
  ga = g.field("at");
  goal = Goal {
    kind: str(g.field("type"), ""),
    x: num(ga.item(0), 0), y: num(ga.item(1), 0),
    z: if g.has_field("z") { num(g.field("z"), 0) } else { num(ga.item(2), 0) }
  };
  adjusted: vector<integer> = [];
  av = v.field("adjusted");
  for i in 0..av.len() {
    a = av.item(i);
    adjusted += [intent::key_of(num(a.item(0), 0), num(a.item(1), 0), num(a.item(2), 0))];
  }
  doors: vector<Door> = [];
  dv = v.field("doors");
  for i in 0..dv.len() {
    d = dv.item(i);
    at = d.field("at");
    to = str(d.field("to"), "");
    doors += [Door {
      name: str(d.field("name"), to), x: num(at.item(0), 0), y: num(at.item(1), 0), z: num(at.item(2), 0),
      to: to, door: str(d.field("door"), ""), out: str(d.field("out"), ""),
      home: d.field("home").as_bool() ?? false, needs: str(d.field("needs"), "")
    }];
  }
  // The doors held shut by a beam (DESIGN.md § Bombs): each cell, and the side its beam is on.
  bv = v.field("bars");
  for i in 0..bv.len() {
    b = bv.item(i);
    l.bars += [rules::Bar { x: num(b.item(0), 0), y: num(b.item(1), 0), z: num(b.item(2), 0), side: b.item(3).as_text() }];
  }
  // The barricades to build (C5): their cells in order, and the pile of beams.
  kv = v.field("works");
  for i in 0..kv.len() {
    wk = kv.item(i);
    cs: vector<(integer, integer, integer)> = [];
    cv = wk.field("cells");
    for j in 0..cv.len() { cs += [(num(cv.item(j).item(0), 0), num(cv.item(j).item(1), 0), num(cv.item(j).item(2), 0))]; }
    pl = wk.field("pile");
    l.works += [rules::Work { cells: cs, pile_x: num(pl.item(0), 0), pile_y: num(pl.item(1), 0), pile_z: num(pl.item(2), 0) }];
  }
  // A group acting together (C4): its kind, prey, how often it eats, its prey's kinds, its raid.
  tv = v.field("tribe");
  if tv.kind() == "JObject" {
    pk: vector<text> = [];
    pv = tv.field("prey_kinds");
    for j in 0..pv.len() { pk += [pv.item(j).as_text()]; }
    rd = tv.field("raid");
    l.tribes += [rules::Tribe { kind: str(tv.field("kind"), ""), prey: num(tv.field("prey"), 0), eat_ms: num(tv.field("eat_ms"), 0),
                                prey_kinds: pk, raid_x: num(rd.item(0), 0), raid_y: num(rd.item(1), 0), raid_z: num(rd.item(2), 0) }];
  }
  // What lies under the water (B4), and the place's storm (a strike every so many ms).
  wv = v.field("beneath");
  for i in 0..wv.len() {
    b = wv.item(i);
    l.beneath += [rules::Beneath { x: num(b.item(0), 0), y: num(b.item(1), 0), z: num(b.item(2), 0), kind: b.item(3).as_text() }];
  }
  l.storm = num(v.field("storm"), 0);
  // The cart lifts (B3): each shaft, the layer its platform is at, its stops.
  lv2 = v.field("lifts");
  for i in 0..lv2.len() {
    e = lv2.item(i);
    at = e.field("at");
    sv: vector<integer> = [];
    ss = e.field("stops");
    for j in 0..ss.len() { sv += [num(ss.item(j), 0)]; }
    z0 = num(e.field("z"), 0);
    l.lifts += [rules::Lift { x: num(at.item(0), 0), y: num(at.item(1), 0), z: z0, stops: sv, to: z0, due: 0 }];
  }
  // The people's days (C3): each by where they nest, its cycle and its points.
  rv = v.field("routes");
  for i in 0..rv.len() {
    r = rv.item(i);
    at = r.field("at");
    pts: vector<rules::RoutePoint> = [];
    pv = r.field("points");
    for j in 0..pv.len() {
      q = pv.item(j);
      pts += [rules::RoutePoint { x: num(q.item(0), 0), y: num(q.item(1), 0), z: num(q.item(2), 0), from: num(q.item(3), 0) }];
    }
    l.routes += [rules::Route { x: num(at.item(0), 0), y: num(at.item(1), 0), z: num(at.item(2), 0),
                                cycle: num(r.field("cycle"), 0), points: pts }];
  }
  labels: vector<Label> = [];
  lv = v.field("labels");
  for i in 0..lv.len() {
    b = lv.item(i);
    at = b.field("at");
    labels += [Label { x: num(at.item(0), 0), y: num(at.item(1), 0), z: num(at.item(2), 0), says: str(b.field("text"), "") }];
  }
  LevelFile {
    name: str(v.field("name"), ""), camera: str(v.field("camera"), "follow"), level: l,
    start_x: sx, start_y: sy, start_z: sz, goal: goal, intent: intent::intent_from(v.field("intent")),
    adjusted: adjusted, doors: doors, labels: labels, talks: talk::from_json(v.field("talks")),
    serves: serves_of(v.field("serves"))
  }
}

// A place file's `serves`: the tags it lists.
fn serves_of(v: const JsonValue) -> vector<text> {
  out: vector<text> = [];
  for i in 0..v.len() { out += [v.item(i).as_text()]; }
  out
}

/// The door on cell (x, y, z), by its index in `lf.doors`; -1 for none.
pub fn door_at(lf: const LevelFile, x: integer, y: integer, z: integer) -> integer {
  for i in 0..len(lf.doors) {
    d = lf.doors[i];
    if d.x == x && d.y == y && d.z == z { return i; }
  }
  -1
}

/// The door named `name`, by its index in `lf.doors`; -1 for none.
pub fn door_named(lf: const LevelFile, name: text) -> integer {
  for i in 0..len(lf.doors) { if lf.doors[i].name == name { return i; } }
  -1
}

/// The side (dx, dy) of door `i` the hero comes out on, in place `l`: the one the file sets, or
/// the first of south, north, east and west whose cell is set ground the hero can stand on and
/// cross to.  (0, 0) when there is none: the hero then stands on the door itself.
pub fn out_of(lf: const LevelFile, l: const rules::Level, i: integer) -> (integer, integer) {
  d = lf.doors[i];
  if !d { return (0, 0); }
  if d.out != "" {
    s = side_of(d.out);
    return if s == tile_world::NORTH { (0, -1) } else if s == tile_world::EAST { (1, 0) }
           else if s == tile_world::SOUTH { (0, 1) } else { (-1, 0) };
  }
  for side in [(0, 1), (0, -1), (1, 0), (-1, 0)] {
    x = d.x + side.0;
    y = d.y + side.1;
    if tile_world::is_set(l.w, x, y, d.z) && rules::walkable(l, tile_world::terrain(l.w, x, y, d.z))
       && rules::hero_crosses(l, d.x, d.y, d.z, side.0, side.1) && door_at(lf, x, y, d.z) < 0 {
      return side;
    }
  }
  (0, 0)
}

/// The level in file `path`, or null when it does not read or parse.
pub fn load_file(path: text, k: const rules::Kinds) -> LevelFile? {
  raw = file(path).content() ?? "";
  if raw == "" { return null; }
  load(raw, k)
}

/// Is the level solved, by its goal?
pub fn solved(lf: const LevelFile, l: const rules::Level) -> boolean {
  if lf.goal.kind == "layer" { return l.hero_z == lf.goal.z; }
  if lf.goal.kind == "daylight" { return rules::in_daylight(l); }
  if lf.goal.kind == "cell" {
    return l.hero_x == lf.goal.x && l.hero_y == lf.goal.y && l.hero_z == lf.goal.z;
  }
  if lf.goal.kind == "chests" { return rules::closed(l) == 0; }
  false
}

// A JSON string literal of `s`.
fn quoted(s: text) -> text {
  out = "\"";
  for c in s {
    if c == '"' { out += "\\\""; }
    else if c == '\\' { out += "\\\\"; }
    else if c == '\n' { out += "\\n"; }
    else { out += "{c}"; }
  }
  out + "\""
}

// `g` when it can be a legend character not yet taken, else the first free spare one; "" when
// none is left.
fn free_char(legend: const hash<LegendChar[ch]>, g: text) -> text {
  if len(g) == 1 && g != " " && !legend[g] { return g; }
  for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789" {
    if !legend["{c}"] { return "{c}"; }
  }
  ""
}

// The legend: each terrain kind's glyph, then each material's, or the first free character when
// a glyph is taken, is a space or `_`, or is not one character.
fn legend_of(k: const rules::Kinds, mats: const materials::Materials) -> hash<LegendChar[ch]> {
  legend: hash<LegendChar[ch]> = [];
  legend += [LegendChar { ch: "_", kind: PIT, material: -1 }];
  for id in rules::terrain_ids(k) {
    g = free_char(legend, rules::terrain_glyph(k, id));
    if g != "" { legend += [LegendChar { ch: g, kind: id, material: -1 }]; }
  }
  for i in 0..len(mats.list) {
    mat = mats.list[i] ?? materials::none_material();
    g = free_char(legend, mat.glyph);
    if g != "" { legend += [LegendChar { ch: g, kind: mat.kind, material: i }]; }
  }
  legend
}

// The legend character of a cell: a space when it is unset, `_` when it is void set on purpose.
fn cell_char(l: const rules::Level, legend: const hash<LegendChar[ch]>, mats: const materials::Materials,
             x: integer, y: integer, z: integer) -> text {
  if !tile_world::is_set(l.w, x, y, z) { return " "; }
  kind = tile_world::terrain(l.w, x, y, z);
  if kind == tile_world::VOID { return "_"; }
  mi = materials::at(mats, l.w, x, y, z);
  for e in legend {
    if e.material == mi && (mi >= 0 || e.kind == kind) { return e.ch; }
  }
  " "
}

/// The level file's JSON for `lf`, with its level as it is now: the world's cells, grounds,
/// edges, rises and things, the start, the goal and the camera of `lf`.  The same level always
/// writes the same text.
pub fn save(lf: const LevelFile) -> text {
  save_with(lf, materials::none())
}

/// The same, with the materials theme.json declares: a material's cell is written by its
/// character, and only a tile no material shows there is an override.
pub fn save_with(lf: const LevelFile, mats: const materials::Materials) -> text {
  l = lf.level;
  k = l.k;
  legend = legend_of(k, mats);
  chunks_text = "";
  pits = false;
  overrides: vector<(integer, integer, integer, integer)> = [];
  edges: vector<(integer, integer, integer, text, integer)> = [];
  rises: vector<(integer, integer, integer, integer)> = [];
  // The legend lists only the kinds the level uses, so a file does not change when kinds.json
  // gains a kind.
  used: vector<text> = [];
  first = true;
  for z in tile_world::layers(l.w) {
    for c in tile_world::chunks(l.w, z) {
      rows: vector<text> = [];
      for j in 0..CHUNK {
        row = "";
        for i in 0..CHUNK {
          x = c.0 * CHUNK + i;
          y = c.1 * CHUNK + j;
          ch = cell_char(l, legend, mats, x, y, z);
          if ch == "_" { pits = true; }
          if ch != " " && ch != "_" && !used.contains(ch) { used += [ch]; }
          row += ch;
          if ch != " " && ch != "_" && materials::at(mats, l.w, x, y, z) < 0 {
            t = tile_world::tile(l.w, x, y, z);
            if t != 0 { overrides += [(x, y, z, t)]; }
          }
          n = tile_world::edge(l.w, x, y, z, tile_world::NORTH);
          if n != 0 { edges += [(x, y, z, "N", n)]; }
          wst = tile_world::edge(l.w, x, y, z, tile_world::WEST);
          if wst != 0 { edges += [(x, y, z, "W", wst)]; }
          up = tile_world::rise(l.w, x, y, z);
          if up != 0 { rises += [(x, y, z, up)]; }
        }
        rows += [row.trim_end()];
      }
      while len(rows) > 0 && rows[len(rows) - 1] == "" { rows = rows[0..len(rows) - 1]; }
      if len(rows) == 0 { continue; }
      chunks_text += if first { "\n" } else { ",\n" };
      chunks_text += "    {{ \"cx\": {c.0}, \"cy\": {c.1}, \"z\": {z}, \"rows\": [\n";
      for r in 0..len(rows) {
        chunks_text += "      {quoted(rows[r])}";
        chunks_text += if r + 1 < len(rows) { ",\n" } else { "\n" };
      }
      chunks_text += "    ] }}";
      first = false;
    }
  }
  out = "{{\n  \"name\": {quoted(lf.name)},";
  if len(lf.serves) > 0 {
    out += "\n  \"serves\": [";
    sf = true;
    for t in lf.serves {
      out += if sf { " " } else { ", " };
      out += quoted(t);
      sf = false;
    }
    out += " ],";
  }
  out += "\n  \"camera\": {quoted(lf.camera)},\n  \"legend\": {{";
  first = true;
  for id in rules::terrain_ids(k) {
    for e in legend {
      if e.material < 0 && e.kind == id && used.contains(e.ch) {
        out += if first { " " } else { ", " };
        out += "{quoted(e.ch)}: {quoted(rules::terrain_name(k, id))}";
        first = false;
      }
    }
  }
  for i in 0..len(mats.list) {
    for e in legend {
      if e.material == i && used.contains(e.ch) {
        out += if first { " " } else { ", " };
        out += "{quoted(e.ch)}: {quoted((mats.list[i] ?? materials::none_material()).name)}";
        first = false;
      }
    }
  }
  if pits {
    out += if first { " " } else { ", " };
    out += "\"_\": \"void\"";
  }
  out += " }},\n  \"ground\": [";
  first = true;
  for z in tile_world::ground_layers(l.w) {
    out += if first { " " } else { ", " };
    out += "{{ \"z\": {z}, \"kind\": {quoted(rules::terrain_name(k, tile_world::ground(l.w, z)))}, \"tile\": {tile_world::ground_tile(l.w, z)} }}";
    first = false;
  }
  out += " ],\n  \"chunks\": [" + chunks_text + "\n  ],\n  \"things\": [";
  first = true;
  for s in tile_world::stacks(l.w) {
    names = "";
    for th in tile_world::things(l.w, s.0, s.1, s.2) {
      names += if names == "" { "" } else { ", " };
      names += quoted(rules::thing_name(k, th));
    }
    out += if first { "\n" } else { ",\n" };
    out += "    {{ \"at\": [{s.0}, {s.1}, {s.2}], \"stack\": [{names}] }}";
    first = false;
  }
  out += "\n  ],\n  \"tiles\": [";
  first = true;
  for o in overrides {
    out += if first { " " } else { ", " };
    out += "[{o.0}, {o.1}, {o.2}, {o.3}]";
    first = false;
  }
  out += " ],\n  \"edges\": [";
  first = true;
  for e in edges {
    out += if first { " " } else { ", " };
    out += "[{e.0}, {e.1}, {e.2}, {quoted(e.3)}, {quoted(rules::edge_name(k, e.4))}]";
    first = false;
  }
  out += " ],\n  \"rises\": [";
  first = true;
  for r in rises {
    out += if first { " " } else { ", " };
    out += "[{r.0}, {r.1}, {r.2}, {r.3}]";
    first = false;
  }
  out += " ],";
  if len(l.enemies) > 0 {
    out += "\n  \"enemies\": [";
    first = true;
    for e in l.enemies {
      out += if first { " " } else { ", " };
      held = if rules::armed_as_kind(l, e) { "" } else if e.item == 0 { ", \"none\"" } else { ", {quoted(rules::thing_name(l.k, e.item))}" };
      out += "[{quoted(e.kind)}, {e.nest_x}, {e.nest_y}, {e.nest_z}{held}]";
      first = false;
    }
    out += " ],";
  }
  // The developer's intent and the cells set by hand, when the place has them.
  if !intent::is_empty(lf.intent) || len(lf.adjusted) > 0 {
    out += "\n  \"intent\": {intent::intent_json(lf.intent)},\n  \"adjusted\": [";
    first = true;
    for a in lf.adjusted {
      out += if first { " " } else { ", " };
      out += "[{intent::x_of(a)}, {intent::y_of(a)}, {intent::z_of(a)}]";
      first = false;
    }
    out += " ],";
  }
  if len(lf.doors) > 0 {
    out += "\n  \"doors\": [";
    first = true;
    for d in lf.doors {
      out += if first { "\n" } else { ",\n" };
      out += "    {{ \"at\": [{d.x}, {d.y}, {d.z}], \"to\": {quoted(d.to)}, \"door\": {quoted(d.door)}";
      if d.name != d.to { out += ", \"name\": {quoted(d.name)}"; }
      if d.out != "" { out += ", \"out\": {quoted(d.out)}"; }
      if d.home { out += ", \"home\": true"; }
      if d.needs != "" { out += ", \"needs\": {quoted(d.needs)}"; }
      out += " }}";
      first = false;
    }
    out += "\n  ],";
  }
  if len(lf.labels) > 0 {
    out += "\n  \"labels\": [";
    first = true;
    for b in lf.labels {
      out += if first { "\n" } else { ",\n" };
      out += "    {{ \"at\": [{b.x}, {b.y}, {b.z}], \"text\": {quoted(b.says)} }}";
      first = false;
    }
    out += "\n  ],";
  }
  if len(lf.talks) > 0 { out += "\n  \"talks\": {talk::json(lf.talks)},"; }
  if len(lf.level.beneath) > 0 {
    out += "\n  \"beneath\": [";
    first = true;
    for b in lf.level.beneath {
      out += if first { " " } else { ", " };
      out += "[{b.x}, {b.y}, {b.z}, {quoted(b.kind)}]";
      first = false;
    }
    out += " ],";
  }
  if lf.level.storm > 0 { out += "\n  \"storm\": {lf.level.storm},"; }
  if len(lf.level.lifts) > 0 {
    out += "\n  \"lifts\": [";
    first = true;
    for f in lf.level.lifts {
      out += if first { " " } else { ", " };
      st = "";
      for s in f.stops { st += if st == "" { "{s}" } else { ", {s}" }; }
      out += "{{ \"at\": [{f.x}, {f.y}], \"z\": {f.z}, \"stops\": [{st}] }}";
      first = false;
    }
    out += " ],";
  }
  if len(lf.level.works) > 0 {
    out += "\n  \"works\": [";
    first = true;
    for wk in lf.level.works {
      out += if first { " " } else { ", " };
      cs = "";
      for c in wk.cells { cs += if cs == "" { "[{c.0}, {c.1}, {c.2}]" } else { ", [{c.0}, {c.1}, {c.2}]" }; }
      out += "{{ \"cells\": [{cs}], \"pile\": [{wk.pile_x}, {wk.pile_y}, {wk.pile_z}] }}";
      first = false;
    }
    out += " ],";
  }
  for tb in lf.level.tribes {
    pk = "";
    for pn in tb.prey_kinds { pk += if pk == "" { quoted(pn) } else { ", {quoted(pn)}" }; }
    out += "\n  \"tribe\": {{ \"kind\": {quoted(tb.kind)}, \"prey\": {tb.prey}, \"eat_ms\": {tb.eat_ms}, \"prey_kinds\": [{pk}], \"raid\": [{tb.raid_x}, {tb.raid_y}, {tb.raid_z}] }},";
  }
  if len(lf.level.bars) > 0 {
    out += "\n  \"bars\": [";
    first = true;
    for b in lf.level.bars {
      out += if first { " " } else { ", " };
      out += "[{b.x}, {b.y}, {b.z}, {quoted(b.side)}]";
      first = false;
    }
    out += " ],";
  }
  if len(lf.level.routes) > 0 {
    out += "\n  \"routes\": [";
    first = true;
    for r in lf.level.routes {
      out += if first { "\n" } else { ",\n" };
      out += "    {{ \"at\": [{r.x}, {r.y}, {r.z}], \"cycle\": {r.cycle}, \"points\": [";
      pf = true;
      for q in r.points {
        out += if pf { " " } else { ", " };
        out += "[{q.x}, {q.y}, {q.z}, {q.from}]";
        pf = false;
      }
      out += " ] }}";
      first = false;
    }
    out += "\n  ],";
  }
  out += "\n  \"start\": [{lf.start_x}, {lf.start_y}, {lf.start_z}],\n  \"goal\": ";
  g = lf.goal;
  if g.kind == "layer" {
    out += "{{ \"type\": \"layer\", \"z\": {g.z} }}";
  } else if g.kind == "cell" {
    out += "{{ \"type\": \"cell\", \"at\": [{g.x}, {g.y}, {g.z}] }}";
  } else {
    out += "{{ \"type\": {quoted(g.kind)} }}";
  }
  out + "\n}}\n"
}
