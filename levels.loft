// Level files: one place as JSON (EDITOR.md § 2).  The cells of each layer as chunks of rows,
// one character per cell through a legend; the ground of a layer; the edges between cells and
// the rise of a cell; the things as named stacks; where the hero starts; the goal and the
// camera, as data.  A chunk is tile_world's 32x32, and the file holds only the chunks that
// exist.
//
//   {
//     "name": "the first climb",
//     "camera": "follow",
//     "legend": { "#": "wall", ".": "floor", "_": "void" },
//     "ground": [ { "z": 0, "kind": "floor", "tile": 0 } ],
//     "chunks": [ { "cx": 0, "cy": 0, "z": 0, "rows": ["#####", "#._.#"] } ],
//     "things": [ { "at": [9, 2, 0], "stack": ["table", "chair"] } ],
//     "tiles": [ [3, 4, 0, 12] ],
//     "edges": [ [2, 1, 0, "N", "wall"], [3, 1, 0, "W", "door"] ],
//     "rises": [ [5, 5, 0, 2] ],
//     "start": [1, 1, 0],
//     "goal": { "type": "layer", "z": 1 }
//   }
//
// A row's characters run from the chunk's west edge.  A space, or a cell past the row's end, is
// UNSET: it reads as its layer's ground, or void when the layer has none.  `_` is void set on
// purpose (a pit in the ground).  `tiles` lists only the set cells whose tile number is not 0;
// `edges` each cell's north and west edge that is not empty (an E or S side reads as the
// neighbour's W or N); `rises` the cells that rise.  Saving writes the world in a fixed order,
// so the same level always writes the same file.
use tile_world;
use rules;
use materials;

const CHUNK = 32;

// The legend's mark for void set on purpose.
const PIT = -1;

/// What solves a level: "layer" (the hero reaches layer z), "daylight" (the hero stands under
/// the open sky), "cell" (the hero reaches (x, y, z)), or "chests" (every chest is open).
pub struct Goal {
  pub kind: text,
  pub x: integer,
  pub y: integer,
  pub z: integer
}

/// A level as its file holds it: the level itself, its name, where the hero starts, what solves
/// it, and how the view follows the hero: "follow" (it scrolls when the hero nears the edge) or
/// "rooms" (it flips a screen at a time).
pub struct LevelFile {
  pub name: text,
  pub camera: text,
  pub level: rules::Level,
  pub start_x: integer,
  pub start_y: integer,
  pub start_z: integer,
  pub goal: Goal
}

struct LegendChar {
  const ch: text,
  kind: integer,
  /// The material the character names (materials.loft), -1 for a bare terrain kind.
  material: integer
}

fn num(v: const JsonValue, default: integer) -> integer {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { (v.as_number() as integer) ?? default } else { default }
}

fn str(v: const JsonValue, default: text) -> text {
  if v.kind() == "JString" { v.as_text() } else { default }
}

fn side_of(letter: text) -> integer {
  if letter == "N" { tile_world::NORTH }
  else if letter == "E" { tile_world::EAST }
  else if letter == "S" { tile_world::SOUTH }
  else { tile_world::WEST }
}

/// The level a level file's JSON holds, its kinds named through `k`.  Null when it does not
/// parse; a name `k` does not declare reads as unset, nothing, no edge.
pub fn load(raw: text, k: const rules::Kinds) -> LevelFile? {
  load_with(raw, k, materials::none())
}

/// The same, with the materials the legend may name (theme.json's): a material's cells get its
/// kind and, once every cell is read, the tile it shows there — a variant by position, an
/// autotile piece by its neighbours.  A `tiles` override is applied after, and wins.
pub fn load_with(raw: text, k: const rules::Kinds, mats: const materials::Materials) -> LevelFile? {
  v = json_parse(raw);
  if v.kind() != "JObject" { return null; }
  l = rules::level(k);
  legend: hash<LegendChar[ch]> = [];
  lg = v.field("legend");
  for c in lg.keys() {
    name = lg.field(c).as_text();
    mi = materials::named(mats, name);
    mk = if mi >= 0 { (mats.list[mi] ?? materials::none_material()).kind } else { 0 };
    legend += [LegendChar {
      ch: c, kind: if mi >= 0 { mk } else if name == "void" { PIT } else { rules::terrain_id(k, name) },
      material: mi
    }];
  }
  gr = v.field("ground");
  for i in 0..gr.len() {
    g = gr.item(i);
    tile_world::set_ground(l.w, num(g.field("z"), 0), rules::terrain_id(k, str(g.field("kind"), "")),
                           num(g.field("tile"), 0));
  }
  chunks = v.field("chunks");
  for i in 0..chunks.len() {
    c = chunks.item(i);
    x0 = num(c.field("cx"), 0) * CHUNK;
    y0 = num(c.field("cy"), 0) * CHUNK;
    z = num(c.field("z"), 0);
    rows = c.field("rows");
    for j in 0..rows.len() {
      x = x0;
      for ch in rows.item(j).as_text() {
        e = legend["{ch}"];
        kind = if e { e.kind } else { 0 };
        mi = if e { e.material } else { -1 };
        if kind == PIT {
          tile_world::set_terrain(l.w, x, y0 + j, z, tile_world::VOID);
        } else if mi >= 0 {
          tile_world::set_terrain(l.w, x, y0 + j, z, kind, (mats.list[mi] ?? materials::none_material()).tile);
        } else if kind != 0 {
          tile_world::set_terrain(l.w, x, y0 + j, z, kind);
        }
        x += 1;
      }
    }
  }
  things = v.field("things");
  for i in 0..things.len() {
    t = things.item(i);
    at = t.field("at");
    stack = t.field("stack");
    for s in 0..stack.len() {
      id = rules::thing_id(k, stack.item(s).as_text());
      if id != 0 {
        tile_world::place(l.w, num(at.item(0), 0), num(at.item(1), 0), num(at.item(2), 0), id);
      }
    }
  }
  materials::retile_all(mats, l.w);
  tiles = v.field("tiles");
  for i in 0..tiles.len() {
    t = tiles.item(i);
    x = num(t.item(0), 0);
    y = num(t.item(1), 0);
    z = num(t.item(2), 0);
    tile_world::set_terrain(l.w, x, y, z, tile_world::terrain(l.w, x, y, z), num(t.item(3), 0));
  }
  edges = v.field("edges");
  for i in 0..edges.len() {
    e = edges.item(i);
    tile_world::set_edge(l.w, num(e.item(0), 0), num(e.item(1), 0), num(e.item(2), 0),
                         side_of(str(e.item(3), "")), rules::edge_id(k, str(e.item(4), "")));
  }
  rises = v.field("rises");
  for i in 0..rises.len() {
    r = rises.item(i);
    tile_world::set_rise(l.w, num(r.item(0), 0), num(r.item(1), 0), num(r.item(2), 0), num(r.item(3), 0));
  }
  st = v.field("start");
  sx = num(st.item(0), 0);
  sy = num(st.item(1), 0);
  sz = num(st.item(2), 0);
  rules::put_hero(l, sx, sy, sz);
  g = v.field("goal");
  ga = g.field("at");
  goal = Goal {
    kind: str(g.field("type"), ""),
    x: num(ga.item(0), 0), y: num(ga.item(1), 0),
    z: if g.has_field("z") { num(g.field("z"), 0) } else { num(ga.item(2), 0) }
  };
  LevelFile {
    name: str(v.field("name"), ""), camera: str(v.field("camera"), "follow"), level: l,
    start_x: sx, start_y: sy, start_z: sz, goal: goal
  }
}

/// The level in file `path`, or null when it does not read or parse.
pub fn load_file(path: text, k: const rules::Kinds) -> LevelFile? {
  raw = file(path).content() ?? "";
  if raw == "" { return null; }
  load(raw, k)
}

/// Is the level solved, by its goal?
pub fn solved(lf: const LevelFile, l: const rules::Level) -> boolean {
  if lf.goal.kind == "layer" { return l.hero_z == lf.goal.z; }
  if lf.goal.kind == "daylight" { return rules::in_daylight(l); }
  if lf.goal.kind == "cell" {
    return l.hero_x == lf.goal.x && l.hero_y == lf.goal.y && l.hero_z == lf.goal.z;
  }
  if lf.goal.kind == "chests" { return rules::closed(l) == 0; }
  false
}

// A JSON string literal of `s`.
fn quoted(s: text) -> text {
  out = "\"";
  for c in s {
    if c == '"' { out += "\\\""; }
    else if c == '\\' { out += "\\\\"; }
    else if c == '\n' { out += "\\n"; }
    else { out += "{c}"; }
  }
  out + "\""
}

// `g` when it can be a legend character not yet taken, else the first free spare one; "" when
// none is left.
fn free_char(legend: const hash<LegendChar[ch]>, g: text) -> text {
  if len(g) == 1 && g != " " && !legend[g] { return g; }
  for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789" {
    if !legend["{c}"] { return "{c}"; }
  }
  ""
}

// The legend: each terrain kind's glyph, then each material's, or the first free character when
// a glyph is taken, is a space or `_`, or is not one character.
fn legend_of(k: const rules::Kinds, mats: const materials::Materials) -> hash<LegendChar[ch]> {
  legend: hash<LegendChar[ch]> = [];
  legend += [LegendChar { ch: "_", kind: PIT, material: -1 }];
  for id in rules::terrain_ids(k) {
    g = free_char(legend, rules::terrain_glyph(k, id));
    if g != "" { legend += [LegendChar { ch: g, kind: id, material: -1 }]; }
  }
  for i in 0..len(mats.list) {
    mat = mats.list[i] ?? materials::none_material();
    g = free_char(legend, mat.glyph);
    if g != "" { legend += [LegendChar { ch: g, kind: mat.kind, material: i }]; }
  }
  legend
}

// The legend character of a cell: a space when it is unset, `_` when it is void set on purpose.
fn cell_char(l: const rules::Level, legend: const hash<LegendChar[ch]>, mats: const materials::Materials,
             x: integer, y: integer, z: integer) -> text {
  if !tile_world::is_set(l.w, x, y, z) { return " "; }
  kind = tile_world::terrain(l.w, x, y, z);
  if kind == tile_world::VOID { return "_"; }
  mi = materials::at(mats, l.w, x, y, z);
  for e in legend {
    if e.material == mi && (mi >= 0 || e.kind == kind) { return e.ch; }
  }
  " "
}

/// The level file's JSON for `lf`, with its level as it is now: the world's cells, grounds,
/// edges, rises and things, the start, the goal and the camera of `lf`.  The same level always
/// writes the same text.
pub fn save(lf: const LevelFile) -> text {
  save_with(lf, materials::none())
}

/// The same, with the materials theme.json declares: a material's cell is written by its
/// character, and only a tile no material shows there is an override.
pub fn save_with(lf: const LevelFile, mats: const materials::Materials) -> text {
  l = lf.level;
  k = l.k;
  legend = legend_of(k, mats);
  chunks_text = "";
  pits = false;
  overrides: vector<(integer, integer, integer, integer)> = [];
  edges: vector<(integer, integer, integer, text, integer)> = [];
  rises: vector<(integer, integer, integer, integer)> = [];
  // The legend lists only the kinds the level uses, so a file does not change when kinds.json
  // gains a kind.
  used: vector<text> = [];
  first = true;
  for z in tile_world::layers(l.w) {
    for c in tile_world::chunks(l.w, z) {
      rows: vector<text> = [];
      for j in 0..CHUNK {
        row = "";
        for i in 0..CHUNK {
          x = c.0 * CHUNK + i;
          y = c.1 * CHUNK + j;
          ch = cell_char(l, legend, mats, x, y, z);
          if ch == "_" { pits = true; }
          if ch != " " && ch != "_" && !used.contains(ch) { used += [ch]; }
          row += ch;
          if ch != " " && ch != "_" && materials::at(mats, l.w, x, y, z) < 0 {
            t = tile_world::tile(l.w, x, y, z);
            if t != 0 { overrides += [(x, y, z, t)]; }
          }
          n = tile_world::edge(l.w, x, y, z, tile_world::NORTH);
          if n != 0 { edges += [(x, y, z, "N", n)]; }
          wst = tile_world::edge(l.w, x, y, z, tile_world::WEST);
          if wst != 0 { edges += [(x, y, z, "W", wst)]; }
          up = tile_world::rise(l.w, x, y, z);
          if up != 0 { rises += [(x, y, z, up)]; }
        }
        rows += [row.trim_end()];
      }
      while len(rows) > 0 && rows[len(rows) - 1] == "" { rows = rows[0..len(rows) - 1]; }
      if len(rows) == 0 { continue; }
      chunks_text += if first { "\n" } else { ",\n" };
      chunks_text += "    {{ \"cx\": {c.0}, \"cy\": {c.1}, \"z\": {z}, \"rows\": [\n";
      for r in 0..len(rows) {
        chunks_text += "      {quoted(rows[r])}";
        chunks_text += if r + 1 < len(rows) { ",\n" } else { "\n" };
      }
      chunks_text += "    ] }}";
      first = false;
    }
  }
  out = "{{\n  \"name\": {quoted(lf.name)},\n  \"camera\": {quoted(lf.camera)},\n  \"legend\": {{";
  first = true;
  for id in rules::terrain_ids(k) {
    for e in legend {
      if e.material < 0 && e.kind == id && used.contains(e.ch) {
        out += if first { " " } else { ", " };
        out += "{quoted(e.ch)}: {quoted(rules::terrain_name(k, id))}";
        first = false;
      }
    }
  }
  for i in 0..len(mats.list) {
    for e in legend {
      if e.material == i && used.contains(e.ch) {
        out += if first { " " } else { ", " };
        out += "{quoted(e.ch)}: {quoted((mats.list[i] ?? materials::none_material()).name)}";
        first = false;
      }
    }
  }
  if pits {
    out += if first { " " } else { ", " };
    out += "\"_\": \"void\"";
  }
  out += " }},\n  \"ground\": [";
  first = true;
  for z in tile_world::ground_layers(l.w) {
    out += if first { " " } else { ", " };
    out += "{{ \"z\": {z}, \"kind\": {quoted(rules::terrain_name(k, tile_world::ground(l.w, z)))}, \"tile\": {tile_world::ground_tile(l.w, z)} }}";
    first = false;
  }
  out += " ],\n  \"chunks\": [" + chunks_text + "\n  ],\n  \"things\": [";
  first = true;
  for s in tile_world::stacks(l.w) {
    names = "";
    for th in tile_world::things(l.w, s.0, s.1, s.2) {
      names += if names == "" { "" } else { ", " };
      names += quoted(rules::thing_name(k, th));
    }
    out += if first { "\n" } else { ",\n" };
    out += "    {{ \"at\": [{s.0}, {s.1}, {s.2}], \"stack\": [{names}] }}";
    first = false;
  }
  out += "\n  ],\n  \"tiles\": [";
  first = true;
  for o in overrides {
    out += if first { " " } else { ", " };
    out += "[{o.0}, {o.1}, {o.2}, {o.3}]";
    first = false;
  }
  out += " ],\n  \"edges\": [";
  first = true;
  for e in edges {
    out += if first { " " } else { ", " };
    out += "[{e.0}, {e.1}, {e.2}, {quoted(e.3)}, {quoted(rules::edge_name(k, e.4))}]";
    first = false;
  }
  out += " ],\n  \"rises\": [";
  first = true;
  for r in rises {
    out += if first { " " } else { ", " };
    out += "[{r.0}, {r.1}, {r.2}, {r.3}]";
    first = false;
  }
  out += " ],\n  \"start\": [{lf.start_x}, {lf.start_y}, {lf.start_z}],\n  \"goal\": ";
  g = lf.goal;
  if g.kind == "layer" {
    out += "{{ \"type\": \"layer\", \"z\": {g.z} }}";
  } else if g.kind == "cell" {
    out += "{{ \"type\": \"cell\", \"at\": [{g.x}, {g.y}, {g.z}] }}";
  } else {
    out += "{{ \"type\": {quoted(g.kind)} }}";
  }
  out + "\n}}\n"
}
