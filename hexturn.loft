//
// Turning a structure on the hex grid: the editor's step (owner, 2026-11-09: turning is an editor
// step, and the world is drawn only from the hex cells).  Any structure drawn in one direction,
// given only as its cells, turned about a cell by any multiple of 30°.
//
// The turn itself is `hex_place`'s (its cellturn.loft: a 60° step exact, an odd step from the drawn
// walls, the offset it moved the structure by handed back; HEX_LIBRARIES.md phase 6, where these
// routines went), and placing a door or a window at a point is `hex_draw`'s (cellopen.loft).
// What is here is the game's names for them, with the game's measurements.
use hex_field;
use hex_draw;
use hex_place;
use hexwalls;

/// The ways an odd step of 30° is made, kept side by side to compare (owner, 2026-11-09).
pub const BY_WALLS = hex_place::TURN_BY_WALLS;
pub const BY_OUTLINE = hex_place::TURN_BY_OUTLINE;

/// The spacing of the lines a wall can stand on, across the rows of hex centres, in world units.
pub const ROW_ODD = hex_place::TURN_ROW_ODD;
pub const ROW_EVEN = hex_place::TURN_ROW_EVEN;

/// `cells` turned by `steps` × 30° anticlockwise about cell (pq, pr), as a new set round the
/// pivot.
// @FR-HT-Pivot, @FR-HT-Turn60, @FR-HT-Drawing: whole 30° steps about a cell; 60° steps cell for cell
pub fn turn(cells: hex_field::HexSet, pq: integer, pr: integer, steps: integer,
            way: integer = BY_WALLS) -> hex_field::HexSet {
  hex_place::cells_turn(cells, pq, pr, steps, way).tn_cells
}

/// The cell whose centre is at doubled coordinates (k, m) (`hex_field::lattice_to_cell`).
pub fn cell_at(k: integer, m: integer) -> (integer, integer) { hex_field::lattice_to_cell(k, m) }

/// The structure's cell nearest its middle: a pivot to turn it about when none is given.
pub fn middle(cells: hex_field::HexSet) -> (integer, integer) { hex_place::cells_middle(cells) }

/// A structure as the editor holds it: its cells and the doors and windows marked on its edges.
pub struct Data {
  pub cells: hex_field::HexSet,
  pub marks: hex_field::EdgeSet
}

// @FR-HO-Place: an opening at a point marks the nearest wall's edges within half its width
/// Mark an opening of `kind` at the point (x, y) (world units) on the structure's nearest wall
/// (`hex_draw::cells_place_opening`).  For several openings on one structure, build its walls
/// once (`hex_draw::cells_built`) and place each on them, as hexhouse.loft does.
pub fn place(d: Data, kind: integer, x: float, y: float, hint: integer = -1,
             sz: hexwalls::Sizes = hexwalls::default_sizes()) -> boolean {
  hex_draw::cells_place_opening(hex_draw::cells_built(d.cells, hexwalls::WALL, hint), d.marks, kind, x, y,
                                hexwalls::open_sizes(sz))
}

// @FR-HO-Turn60, @FR-HO-Turn30: the openings carried through a turn
/// The structure turned `steps` × 30° about cell (pq, pr), its doors and windows with it.
pub fn turn_data(d: Data, pq: integer, pr: integer, steps: integer, way: integer = BY_WALLS,
                 hint: integer = -1, sz: hexwalls::Sizes = hexwalls::default_sizes()) -> Data {
  t = hex_place::marked_turn(hex_place::Marked { mk_cells: d.cells, mk_marks: d.marks }, pq, pr, steps, way, hint,
                             hexwalls::open_sizes(sz));
  Data { cells: t.mk_cells, marks: t.mk_marks }
}

/// Where the point (x, y) of the structure `cells` lands when it is turned `steps` × 30° about
/// cell (pq, pr).  For many points of one structure, keep the turn (`hex_place::cells_turn`) and
/// ask it (`hex_place::turned_point`), as hextown.loft does.
pub fn turned_point(cells: hex_field::HexSet, pq: integer, pr: integer, steps: integer, way: integer,
                    x: float, y: float) -> (float, float) {
  hex_place::turned_point(hex_place::cells_turn(cells, pq, pr, steps, way), x, y)
}
