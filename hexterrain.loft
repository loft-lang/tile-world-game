//
// The ground on the hex grid: a height and a surface kind per cell (the world's data, drawn as a
// smooth surface: a corner's height is the mean of the three cells round it), and the routines
// that shape it (the editor's): terraces made smooth, round hills, and a structure seated on the
// ground, its footprint level and the ground round it blended in.  Built here first; the routines
// move to the hex libraries once they are right (owner, 2026-11-09).
//
// Horizontal measures are in metres here, the grid's own world units times 0.866: a cell centre is
// at x = k · 0.75 m, y = m · 0.433 m for doubled coordinates (k, m), y growing north.  Heights are
// in metres.  The measurements (a storey's height, how wide a hillside and a bank are, how far a
// seated structure blends in) are read from hexsizes.json.
use hex_field;
use hexwalls;

/// Surface kinds.
pub const GRASS = 0;
pub const PATH = 1;
pub const RAIL = 2;
/// A stream's dry bed.
pub const BED = 3;
/// Shallow water.
pub const WATER = 4;
/// A house's floor.
pub const FLOOR = 5;

/// Metres per world unit.
pub const METRE = 0.8660254037844386;

/// The ground over a window of cells: a height (metres) and a surface kind per cell.
pub struct Ground {
  pub heights: hex_field::Heights,
  pub kinds: hex_field::Labels,
  pub q0: integer,
  pub r0: integer,
  pub w: integer,
  pub h: integer
}

pub fn ground_new(q0: integer, r0: integer, w: integer, h: integer) -> Ground {
  kinds = hex_field::labels_new(q0, r0, w, h);
  for r in r0..r0 + h { for q in q0..q0 + w { hex_field::label_set(kinds, q, r, GRASS); } }
  Ground { heights: hex_field::heights_new(q0, r0, w, h), kinds: kinds, q0: q0, r0: r0, w: w, h: h }
}

/// A cell's centre, in metres.
pub fn centre(q: integer, r: integer) -> (float, float) {
  ((hex_field::lattice_k(q, r) as float) * 0.75, (hex_field::lattice_m(q, r) as float) * 0.4330127018922193)
}

/// The cell whose centre is nearest (x, y) metres.
pub fn cell_near(x: float, y: float) -> (integer, integer) {
  r = round(y / 1.299038105676658) as integer;
  q = round(((x / 0.75) - ((r & 1) as float)) * 0.5) as integer;
  best_q = q;
  best_r = r;
  best = -1.0;
  for dr in -1..2 {
    for dq in -1..2 {
      (cx, cy) = centre(q + dq, r + dr);
      d = (cx - x) * (cx - x) + (cy - y) * (cy - y);
      if best < 0.0 || d < best {
        best = d;
        best_q = q + dq;
        best_r = r + dr;
      }
    }
  }
  (best_q, best_r)
}

// ── the measurements ────────────────────────────────────────────────────────

/// The ground's measurements, in metres: a storey (a layer of the square world), how wide a
/// hillside is between two terraces, how wide a stream's bank, and how far round a seated
/// structure the ground blends back to its own height.
pub struct Measures {
  pub storey: float,
  pub hillside: float,
  pub bank: float,
  pub blend: float
}

pub fn default_measures() -> Measures { Measures { storey: 2.6, hillside: 6.0, bank: 2.5, blend: 2.5 } }

/// The measurements in hexsizes.json's "terrain"; a measurement it lacks keeps its default.
pub fn measures_file(path: text) -> Measures {
  d = default_measures();
  text = file(path).content() ?? "";
  if text == "" { return d; }
  t = json_parse(text).field("terrain");
  Measures { storey: num(t.field("storey"), d.storey), hillside: num(t.field("hill_falloff"), d.hillside),
             bank: num(t.field("bank_falloff"), d.bank), blend: num(t.field("seat_blend"), d.blend) }
}

fn num(v: const JsonValue, default: float) -> float {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { v.as_number() } else { default }
}

// ── terraces made smooth ────────────────────────────────────────────────────

/// A stepped height map on a square grid: a level per square (`level[j * nx + i]`), squares
/// `size` metres a side, square (0, 0) with its south-west corner at (x0, y0), j growing north.
pub struct Steps {
  pub x0: float,
  pub y0: float,
  pub size: float,
  pub nx: integer,
  pub ny: integer,
  pub level: vector<integer>
}

/// The level of square (i, j), the nearest square's beyond the map.
pub fn level_at(s: const Steps, i: integer, j: integer) -> integer {
  ci = if i < 0 { 0 } else if i >= s.nx { s.nx - 1 } else { i };
  cj = if j < 0 { 0 } else if j >= s.ny { s.ny - 1 } else { j };
  s.level[cj * s.nx + ci] ?? 0
}

fn smoothstep(t: float) -> float {
  c = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t };
  c * c * (3.0 - 2.0 * c)
}

// @FR-HG-Terrace: each step up a smooth slope across its edge; the flat tops stay flat
/// The smooth height at (x, y) metres of the stepped map `s`: its lowest level's height, and for
/// every step up a smooth rise of a storey across the step's edge, `hillside` wide and centred on
/// it (a step up from below level 0, a stream's bank, `bank` wide).  Away from the edges the
/// terraces stay flat at their storeys; across one, the ground climbs a storey without a cliff.
pub fn terrace_height(s: const Steps, x: float, y: float, m: const Measures, lo: integer, hi: integer) -> float {
  i = floor((x - s.x0) / s.size ?? 0.0) as integer;
  j = floor((y - s.y0) / s.size ?? 0.0) as integer;
  h = (lo as float) * m.storey;
  for step in lo + 1..hi + 1 {
    wide = if step <= 0 { m.bank } else { m.hillside };
    reach = (ceil((wide * 0.5) / s.size ?? 1.0) as integer) + 1;
    inside = level_at(s, i, j) >= step;
    near = wide;
    for dj in -reach..reach + 1 {
      for di in -reach..reach + 1 {
        if (level_at(s, i + di, j + dj) >= step) == inside { continue; }
        // the distance from (x, y) to square (i + di, j + dj)
        ax = s.x0 + ((i + di) as float) * s.size;
        ay = s.y0 + ((j + dj) as float) * s.size;
        dx = if x < ax { ax - x } else if x > ax + s.size { x - ax - s.size } else { 0.0 };
        dy = if y < ay { ay - y } else if y > ay + s.size { y - ay - s.size } else { 0.0 };
        d = sqrt(dx * dx + dy * dy);
        if d < near { near = d; }
      }
    }
    signed = if inside { near } else { -near };
    h += m.storey * smoothstep((signed + wide * 0.5) / wide);
  }
  h
}

/// Every cell of the ground at the smooth height of the stepped map.
pub fn terraces(g: Ground, s: const Steps, m: const Measures, lo: integer, hi: integer) {
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w {
      (x, y) = centre(q, r);
      hex_field::height_set(g.heights, q, r, terrace_height(s, x, y, m, lo, hi));
    }
  }
}

// @FR-HG-Hill: a smooth round hill
/// A round hill `height` metres high, `radius` metres across from its top at (x, y) to its foot:
/// added to the ground, its sides a cosine, level at the top and at the foot.
pub fn hill(g: Ground, x: float, y: float, radius: float, height: float) {
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w {
      (cx, cy) = centre(q, r);
      d = sqrt((cx - x) * (cx - x) + (cy - y) * (cy - y));
      if d >= radius { continue; }
      bump = height * 0.5 * (1.0 + cos(PI * d / radius));
      hex_field::height_set(g.heights, q, r, hex_field::height_get(g.heights, q, r) + bump);
    }
  }
}

// @FR-HG-Seat: a structure's footprint level, the ground round it blended back
/// Seat a structure on the ground: its cells at `height`, and the ground round it blended from
/// that height back to its own over `m.blend` metres from the footprint's edge (a cell's centre
/// lies 0.75 m inside the edge).  Answers the lowest the ground was under the footprint, where its
/// walls go down to.
pub fn seat(g: Ground, cells: hex_field::HexSet, height: float, m: const Measures) -> float {
  low = 1000000.0;
  foot: vector<(float, float)> = [];
  for r in hex_field::hexset_r0(cells)..hex_field::hexset_r0(cells) + hex_field::hexset_h(cells) {
    for q in hex_field::hexset_q0(cells)..hex_field::hexset_q0(cells) + hex_field::hexset_w(cells) {
      if hex_field::hexset_get(cells, q, r) {
        foot += [centre(q, r)];
        z = hex_field::height_get(g.heights, q, r);
        if z < low { low = z; }
      }
    }
  }
  if len(foot) == 0 { return height; }
  // the window round the footprint the blend reaches
  pad = (ceil(m.blend / 1.3) as integer) + 2;
  q0 = hex_field::hexset_q0(cells) - pad;
  r0 = hex_field::hexset_r0(cells) - pad;
  q1 = hex_field::hexset_q0(cells) + hex_field::hexset_w(cells) + pad;
  r1 = hex_field::hexset_r0(cells) + hex_field::hexset_h(cells) + pad;
  for r in r0..r1 {
    for q in q0..q1 {
      if hex_field::hexset_get(cells, q, r) {
        hex_field::height_set(g.heights, q, r, height);
        continue;
      }
      (x, y) = centre(q, r);
      near = 1000000.0;
      for f in foot {
        d = (f.0 - x) * (f.0 - x) + (f.1 - y) * (f.1 - y);
        if d < near { near = d; }
      }
      d = sqrt(near) - 0.75;
      if d >= m.blend { continue; }
      t = smoothstep(d / m.blend);
      z = hex_field::height_get(g.heights, q, r);
      hex_field::height_set(g.heights, q, r, height + (z - height) * t);
    }
  }
  low
}

// @FR-HG-Dig: a structure dug in, its bank centred on its straight sides
/// Dig a structure into the ground (a stream's bed): the ground inside its sides `depth` metres
/// lower, across a bank `m.bank` wide centred on its sides (`hexwalls::outlines`, the same straight
/// sides the view draws its edge along), shaped by a smoothstep.  So the bank runs along the sides,
/// not along the cells' zigzag or the square map's staircase.
pub fn dig(g: Ground, cells: hex_field::HexSet, depth: float, m: const Measures) {
  sides: vector<(float, float, float, float)> = [];
  for o in hexwalls::outlines(cells, 0) {
    n = len(o.corners);
    for i in 0..n {
      (x1, y1) = o.corners[(i + n - 1) % n ?? 0] ?? (0.0, 0.0);
      (x2, y2) = o.corners[i] ?? (0.0, 0.0);
      sides += [(x1 * METRE, y1 * METRE, x2 * METRE, y2 * METRE)];
    }
  }
  if len(sides) == 0 { return; }
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w {
      (x, y) = centre(q, r);
      d = signed_distance(sides, x, y);
      z = hex_field::height_get(g.heights, q, r);
      hex_field::height_set(g.heights, q, r, z - depth * smoothstep((d + m.bank * 0.5) / m.bank ?? 0.0));
    }
  }
}

/// How far (x, y) lies from the nearest of the sides, positive inside them (counted over all their
/// loops), negative outside.
pub fn signed_distance(sides: const vector<(float, float, float, float)>, x: float, y: float) -> float {
  inside = false;
  near = 1000000.0;
  for sd in sides {
    (x1, y1, x2, y2) = sd;
    if (y1 > y) != (y2 > y) {
      cx = x1 + (y - y1) * (x2 - x1) / (y2 - y1) ?? x1;
      if x < cx { inside = !inside; }
    }
    dx = x2 - x1;
    dy = y2 - y1;
    l2 = dx * dx + dy * dy;
    t = if l2 > 0.0 { ((x - x1) * dx + (y - y1) * dy) / l2 ?? 0.0 } else { 0.0 };
    if t < 0.0 { t = 0.0; }
    if t > 1.0 { t = 1.0; }
    ex = x - x1 - t * dx;
    ey = y - y1 - t * dy;
    e = ex * ex + ey * ey;
    if e < near { near = e; }
  }
  if inside { sqrt(near) } else { -sqrt(near) }
}
