//
// The ground on the hex grid: a height and a surface kind per cell (the world's data, drawn as a
// smooth surface: a corner's height is the mean of the three cells round it), and the routines
// that shape it (the editor's): terraces made smooth, round hills, a structure seated on the
// ground, a bed dug, cliffs.
//
// The routines are `hex_ground`'s (HEX_LIBRARIES.md phase 7, where they went; the seat is
// `hex_place`'s).  What is here is the game's: its ground is in metres, a hex step 1.5 m (`STEP`),
// its surface kinds, and its measurements read from hexsizes.json.
//
// Horizontal measures are in metres here, the grid's own world units times 0.866: a cell centre is
// at x = k · 0.75 m, y = m · 0.433 m for doubled coordinates (k, m), y growing north.  Heights are
// in metres.
use hex_field;
use hex_ground;

/// Surface kinds.
pub const GRASS = 0;
pub const PATH = 1;
pub const RAIL = 2;
/// A stream's dry bed.
pub const BED = 3;
/// Shallow water.
pub const WATER = 4;
/// A house's floor.
pub const FLOOR = 5;

/// Metres per world unit.
pub const METRE = 0.8660254037844386;

/// A hex step, in metres: the game's ground is `hex_ground`'s at this step.
pub const STEP = 1.5;

/// Grass at height 0 over a window of cells.
pub fn ground_new(q0: integer, r0: integer, w: integer, h: integer) -> hex_ground::Ground {
  hex_ground::ground_new(q0, r0, w, h, STEP, GRASS)
}

/// A cell's centre, in metres.
pub fn centre(q: integer, r: integer) -> (float, float) { hex_ground::ground_centre(STEP, q, r) }

/// The cell whose centre is nearest (x, y) metres.
pub fn cell_near(x: float, y: float) -> (integer, integer) { hex_ground::ground_cell_near(STEP, x, y) }

// ── the measurements ────────────────────────────────────────────────────────

/// The ground's measurements, in metres: a storey (a layer of the square world), how wide a
/// hillside is between two terraces, how wide a stream's bank, and how far round a seated
/// structure the ground blends back to its own height.
pub struct Measures {
  pub storey: float,
  pub hillside: float,
  pub bank: float,
  pub blend: float
}

pub fn default_measures() -> Measures { Measures { storey: 2.6, hillside: 6.0, bank: 2.5, blend: 2.5 } }

/// The measurements in hexsizes.json's "terrain"; a measurement it lacks keeps its default.
pub fn measures_file(path: text) -> Measures {
  d = default_measures();
  text = file(path).content() ?? "";
  if text == "" { return d; }
  // the parsed text bound first: a field read straight off the call frees its store twice (loft, 2026-11-13)
  t_doc = json_parse(text);
  t = t_doc.field("terrain");
  Measures { storey: num(t.field("storey"), d.storey), hillside: num(t.field("hill_falloff"), d.hillside),
             bank: num(t.field("bank_falloff"), d.bank), blend: num(t.field("seat_blend"), d.blend) }
}

fn num(v: const JsonValue, default: float) -> float {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { v.as_number() } else { default }
}

/// The measurements as `hex_ground` takes them.
pub fn measures_of(m: const Measures) -> hex_ground::GroundMeasures {
  hex_ground::ground_measures(m.storey, m.hillside, m.bank, m.blend)
}

// ── the routines, with the game's step and measurements ─────────────────────

// @FR-HG-Terrace: each step up a smooth slope across its edge; the flat tops stay flat
/// The smooth height at (x, y) metres of the stepped map `s`.
pub fn terrace_height(s: const hex_ground::GroundSteps, x: float, y: float, m: const Measures, lo: integer, hi: integer) -> float {
  hex_ground::terrace_height(s, x, y, measures_of(m), lo, hi)
}

/// Every cell of the ground at the smooth height of the stepped map.
pub fn terraces(g: hex_ground::Ground, s: const hex_ground::GroundSteps, m: const Measures, lo: integer, hi: integer) {
  hex_ground::ground_terraces(g, s, measures_of(m), lo, hi);
}

// @FR-HG-Hill: a smooth round hill
/// A round hill `height` metres high, `radius` metres across from its top at (x, y) to its foot.
pub fn hill(g: hex_ground::Ground, x: float, y: float, radius: float, height: float) {
  hex_ground::ground_hill(g, x, y, radius, height);
}

// @FR-HG-Seat: a structure's footprint level, the ground round it blended back
/// Seat a structure on the ground: its cells at `height`, the ground round it blended back over
/// `m.blend` metres.  Answers the lowest the ground was under the footprint.
pub fn seat(g: hex_ground::Ground, cells: hex_field::HexSet, height: float, m: const Measures) -> float {
  hex_ground::ground_seat(g, cells, height, measures_of(m))
}

// @FR-HG-Dig: a structure dug in, its bank centred on its straight sides
/// Dig a structure into the ground (a stream's bed), `depth` metres, its bank `m.bank` wide.
pub fn dig(g: hex_ground::Ground, cells: hex_field::HexSet, depth: float, m: const Measures) {
  hex_ground::ground_dig(g, cells, depth, measures_of(m));
}

/// How far (x, y) lies from the nearest of the sides, positive inside them.
pub fn signed_distance(sides: const vector<(float, float, float, float)>, x: float, y: float) -> float {
  hex_ground::sides_distance(sides, x, y)
}

// @FR-HG-Cliff: a cliff where the ground steps a level within a cliff area, along its straight sides
/// The cliffs of ground whose cells stand at `levels` (lo .. hi), inside the cliff areas.
pub fn cliffs(levels: hex_field::Labels, q0: integer, r0: integer, w: integer, h: integer,
              lo: integer, hi: integer, areas: const vector<hex_ground::GroundBox>) -> vector<hex_ground::GroundCliff> {
  hex_ground::ground_cliffs(levels, q0, r0, w, h, lo, hi, areas, STEP)
}

/// How far (x, y) lies outside the box (0 inside).
pub fn box_distance(b: const hex_ground::GroundBox, x: float, y: float) -> float { hex_ground::ground_box_distance(b, x, y) }

/// Make the ground's fronts sharp in the cliff areas.
pub fn sharpen(g: hex_ground::Ground, sharp: hex_field::Heights, areas: const vector<hex_ground::GroundBox>, m: const Measures) {
  hex_ground::ground_sharpen(g, sharp, areas, measures_of(m));
}
