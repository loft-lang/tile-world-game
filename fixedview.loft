#width 32
// The fixed camera from the south, drawn on a CPU (RENDER_3D.md § The camera and what is seen;
// BUILD.md Phase E): the landscape round the hero, as render3d builds it, kept as a picture by
// raster3d and drawn again only where it changes; the hero, the enemies and the people drawn over
// it as actors every frame, the walls in front of the hero cut away.  A parallel projection
// (owner, 2026-11-15), so the camera following the hero shifts the kept picture exactly.
//
// The landscape is kept in tiles of TILE x TILE cells, as moros's hex_mesh keeps its mesh: a tile
// is built when it comes near, dropped when it is left far behind, and built again when what it
// shows changed — and only that tile goes to raster3d again, which draws again only where it was
// and is.  What changed is told as hex_mesh's editor marks its dirty chunks, by what changed it
// (BUILD.md E1): the world counts its changes (`tile_world::changes`, `changed_since`), and a tile
// whose cells changed is built again at once; one within READS of a change (its light, a thin
// wall's picture along its line) is looked at — built again and compared with the faces it has, as
// `mesh_crc` tells two meshes apart — and, slowly in turn, every tile: what the rules hold and the
// world does not (a door shut until something holds) is caught so.  The light is data (owner,
// 2026-11-15): each face says which cell it is lit from, raster3d keeps the cells' light, and a
// light that moves, dims or goes out (a torch carried, burning down, flickering) sends the light
// of the cells it reaches: the triangles lit from them are lit again, no tile built again.  A thing whose picture moves (a flame) is not in its tile: it is
// an actor, drawn every frame as the figures are, so its tile is not built again as it flickers.
//
// What draws it is the scene contract's (SCENE_CONTRACT.md): `raster3d` on the CPU, the frame shown
// through `screen` (the Tanmatsu, or a desktop without a GPU); or `scene3d` on a GPU, in the
// device's own window, its keys read from the device (loft's FOR_THE_GAME.md § which window).  The
// view builds the same scene for either; § What draws holds the only place that tells them apart.
//
// F5 switches it on and off; TW_VIEW=fixed starts the game in it.  The game's code is the 2D game's:
// this reads what is there and draws it.
use tile_world;
use tiles;
use rules;
use theme;
use game;
use faces3d;
use raster3d;
use gpu;
use scene3d;

/// A tile's side in cells.
const TILE = 8;
/// The cells round the hero the tiles are kept for: the screen is about 17 x 12 cells, the camera
/// keeps the hero within FOLLOW cells of its middle and the layers below show lower down, so a tile
/// comes into view about 11 cells from the hero; the ones out to REACH are built ahead of that, a
/// few a frame.  A tile more than DROP cells off is dropped.
const REACH = 16;
const SEEN_X = 12;
const SEEN_Y = 11;
const DROP = 24;
/// What a frame may spend building tiles that are not in view yet, and looking for changes (us).
const BUDGET = 3000;
/// How far round its cells a tile's faces read the world: two cells for its shape (render3d's
/// HALO), DARKEST for its light, and a thin wall's picture is the first wall along its line, up to
/// render3d's 12 cells.
const READS = 12;
/// How far a light reaches: the shades go one darker a cell.
const SHINE = tile_world::DARKEST + 1;
/// Every tile is looked at in turn, one every SWEEP frames the game says something changed.
const SWEEP = 8;
/// How far the hero may go from the depth's origin (cells) before it is set again: raster3d's
/// depths reach about 40 cells.
const ORIGIN = 20;
/// How far the hero may stand off the middle of the screen (cells) before the camera follows,
/// and how fast it follows (pixels a frame).
const FOLLOW = 2;
const SLIDE = 8;
/// A figure's card, as render3d draws it; what it holds and wears is drawn at the same scale, as
/// the 2D draws them.  The point of its picture it turns about: the bottom middle (8.5, 15.5 of 16).
const FIGURE = 0.85;
const PIVOT_U = 0.53125;
const PIVOT_V = 0.96875;
/// The hero's actor id; the others are numbered from the layer and their place in the list, the
/// things whose picture moves from FLAME.
const HERO = 1000000;
const FLAME = 2000000;
/// F5, in screen's key codes.
const K_FIXED = 139;
/// The status line and the talk bubbles are drawn as the 2D draws them, at the world's pixels (a
/// cell 16 of them, the frame's 48): on a surface a third of the frame's size, drawn three times
/// larger over it by raster3d.
const OVER = 3;
/// Where nothing is: RGB565 for raster3d, 0xAARRGGBB for scene3d.
const SKY = 0;
const SKY_ARGB = 0xFF000000l;
/// The device's window, as large as the CPU's frame: the fixed camera draws a cell 48 pixels across
/// on either, so the same cells are seen.
const TITLE = "tile_world - the fixed view";

struct Pic {
  const sprite: integer,
  index: integer
}

/// A tile as it went to raster3d: its faces (lit from their cells, so they hold no light), to tell
/// a change, and the cells with a thing whose picture moves, drawn as actors.
struct Tile {
  const key: integer,
  tx: integer,
  ty: integer,
  faces: vector<float>,
  flames: vector<(integer, integer, integer)>
}

/// What the view spent its time on, for tools/fixedshot.loft: new scenes, tiles built as the hero
/// walked, tiles looked at for a change (and how many of those had changed), in us.
pub struct Spent {
  pub fresh: integer = 0,
  pub fresh_us: integer = 0,
  pub built: integer = 0,
  pub built_us: integer = 0,
  pub looked: integer = 0,
  pub looked_us: integer = 0,
  pub changed: integer = 0,
  /// The things whose picture moves drawn as actors in the last frame.
  pub flames: integer = 0,
  /// Lights that moved, dimmed or went out, the cells they reach lit again.
  pub shone: integer = 0,
  /// The cells whose light raster3d keeps, after the last frame.
  pub lights: integer = 0
}

pub struct FixedView {
  pub on: boolean = false,
  /// The CPU's scene (raster3d's handle), 0: none.
  scene: integer = 0,
  /// The GPU backend's table (`gpu_gl::table()`), 0: draw on the CPU; its device and the scene on
  /// it, while the view is on.
  table: i64 = 0l,
  dev: gpu::Device? = null,
  gs: scene3d::Scene? = null,
  place: text = "",
  z: integer = 0,
  z0: integer = 0,
  z1: integer = 0,
  night: boolean = false,
  /// The depth's origin.
  ox: integer = 0,
  oy: integer = 0,
  tiles: hash<Tile[key]> = [],
  /// The tiles in the order they are swept, and the next one.
  all: vector<integer> = [],
  next: integer = 0,
  frame: integer = 0,
  /// The tiles to look at, the world's count when the view last looked, and the lights it saw:
  /// (x, y, layer, the shade it starts at) each.
  suspects: vector<integer> = [],
  seen: integer = 0,
  lights: vector<(integer, integer, integer, integer)> = [],
  /// The pictures, numbered in the order first met; each scene is given them all in that order.
  pics: hash<Pic[sprite]> = [],
  sprites: vector<integer> = [],
  given: integer = 0,
  scratch: integer = 0,
  over: integer = 0,
  over_w: integer = 0,
  over_h: integer = 0,
  cam_x: integer = 0,
  cam_y: integer = 0,
  placed: boolean = false,
  was: boolean = false,
  pub spent: Spent = Spent {},
  /// The CPU's frame, raster3d::WIDTH x raster3d::HEIGHT, for `screen::show`.
  pub px: vector<i32> = []
}

/// A view, off.
pub fn view() -> FixedView {
  FixedView {}
}

/// Draw on a GPU through the backend whose table is `table` (a backend library's `table()`), where
/// its window opens; the CPU where it does not.
pub fn use_gpu(v: FixedView, table: i64) {
  v.table = table;
}

/// F5 pressed: the view switched.  Answers whether it is on.  Switched off, the device's window
/// closes.
pub fn toggle(v: FixedView, keys: const vector<boolean>) -> boolean {
  down = keys[K_FIXED] ?? false;
  if down && !v.was {
    v.on = !v.on;
    if !v.on { close(v); }
  }
  v.was = down;
  v.on
}

/// The keys of this frame: `raw` (screen's), and while the device's window is open the keys
/// pressed in it, in the same codes.  The window closed by its owner switches the view off.
pub fn keys(v: FixedView, raw: const vector<boolean>) -> vector<boolean> {
  if !v.dev { return raw; }
  if !v.dev!.poll() {
    close(v);
    v.on = false;
    return raw;
  }
  dk = v.dev!.keys();
  [for i in 0..len(raw) { (raw[i] ?? false) || (dk[i] ?? false) }]
}

/// The frame drawn by `draw` shown in the device's window: false when it is the CPU's, in `v.px`,
/// for `screen::show`.
pub fn present(v: FixedView) -> boolean {
  if !v.dev || !v.gs { return false; }
  v.dev!.present();
  true
}

// --- What draws: raster3d on the CPU, or scene3d on a GPU (SCENE_CONTRACT.md) ---

// The device's window closed, and the scene on it gone with it: a new one when the view is on again.
fn close(v: FixedView) {
  v.gs = null;
  v.dev = null;
}

// A scene to draw in: the device's window opened where there is a GPU (once, while the view is on),
// the CPU's scene where there is none or it does not open.
fn new_scene(v: FixedView) {
  if v.table != 0l && !v.dev {
    v.dev = gpu::open(v.table, raster3d::WIDTH, raster3d::HEIGHT, TITLE);
    if !v.dev { v.table = 0l; }
  }
  if v.dev {
    v.gs = scene3d::new_scene(v.dev!, gpu::INTO_WINDOW, SKY_ARGB);
    if v.gs { return; }
    close(v);
    v.table = 0l;
  }
  if v.scene != 0 { raster3d::free_scene(v.scene); }
  v.scene = raster3d::new_scene(SKY) ?? 0;
}

// Whether there is a scene to give things to.
fn live(v: const FixedView) -> boolean {
  if v.gs { true } else { v.scene != 0 }
}

// The screen's size: the device's window, or the CPU's frame.
fn screen_size(v: const FixedView) -> (integer, integer) {
  if v.dev && v.gs { (v.dev!.width(), v.dev!.height()) } else { (raster3d::WIDTH, raster3d::HEIGHT) }
}

fn e_picture(v: FixedView, px: const vector<i32>) {
  if v.gs { _ = v.gs!.add_picture(px); } else { _ = raster3d::add_picture(v.scene, px); }
}

fn e_tile(v: FixedView, key: integer, faces: const vector<float>) {
  if v.gs { v.gs!.set_tile(v.dev!, key, faces); } else { raster3d::set_tile(v.scene, key, faces); }
}

fn e_drop(v: FixedView, key: integer) {
  if v.gs { v.gs!.drop_tile(key); } else { raster3d::drop_tile(v.scene, key); }
}

fn e_light(v: FixedView, d: const vector<float>) {
  if v.gs { v.gs!.set_light(d); } else { raster3d::set_light(v.scene, d); }
}

// The depth's origin: the CPU's own (its depths are kept near it); a GPU has none to set.
fn e_origin(v: FixedView, x: integer, y: integer, z: integer) {
  if !v.gs { raster3d::build_scene(v.scene, x as float, y as float, z as float); }
}

// A cell's light as the scene holds it; null where it holds none (and on a GPU, which keeps it on
// the GPU): the caller reads the world's.
fn e_light_at(v: const FixedView, x: integer, y: integer, z: integer) -> float? {
  if v.gs { return null; }
  raster3d::light_at(v.scene, x, y, z)
}

fn e_overlay(v: FixedView, px: const vector<i32>, w: integer, h: integer) {
  if v.gs { v.gs!.set_overlay(v.dev!, px, w, h, OVER); } else { raster3d::set_overlay(v.scene, px, w, h, OVER); }
}

// The frame: the camera at (cam_x, cam_y), the actors, drawn — into the device's window (shown by
// `present`) or into `v.px`.
fn e_frame(v: FixedView, acts: const vector<float>) {
  if v.gs {
    size = screen_size(v);
    v.gs!.resize(size.0, size.1);
    v.gs!.fixed_camera(v.cam_x, v.cam_y);
    v.gs!.set_actors(acts, HERO);
    v.gs!.draw(v.dev!);
    v.spent.lights = 0;
    return;
  }
  if len(v.px) != raster3d::WIDTH * raster3d::HEIGHT { v.px = [0 as i32; raster3d::WIDTH * raster3d::HEIGHT]; }
  raster3d::move_camera(v.scene, v.cam_x, v.cam_y);
  raster3d::set_actors(v.scene, acts, HERO);
  raster3d::draw_frame(v.scene, v.px);
  v.spent.lights = raster3d::lights_kept(v.scene);
}

// The picture's number, given to the scene the first time it is met.
fn pic_of(v: FixedView, sprite: integer) -> integer {
  p = v.pics[sprite];
  if p { return p.index; }
  n = len(v.sprites);
  v.pics += [Pic { sprite: sprite, index: n }];
  v.sprites += [sprite];
  n
}

// The pictures not yet given to the scene, given.
fn give(v: FixedView, g: const game::Game) {
  if !live(v) { return; }
  ts = g.look.tile_size;
  if v.scratch == 0 { v.scratch = tiles::surface(ts, ts) ?? 0; }
  while v.given < len(v.sprites) {
    // `rect`, not `clear`: on the interpreter `tiles::clear` reaches tile_world's native of the
    // same name (loft#2510).
    tiles::rect(v.scratch, 0, 0, ts, ts, raster3d::NONE);
    theme::put(v.scratch, v.sprites[v.given] ?? 0, 0, 0, 0);
    e_picture(v, tiles::pixels(v.scratch, ts, ts));
    v.given += 1;
  }
}

// The layers shown: two below the hero's, and the one above under the open sky only.
fn layers(g: const game::Game) -> (integer, integer) {
  w = g.world;
  hz: integer = w.hero_z;
  (hz - 2, if tile_world::open_sky(w.w, w.hero_x, w.hero_y, w.hero_z) { hz + 1 } else { hz })
}

// The tile a cell is in.
fn tile_of(c: integer) -> integer {
  if c >= 0 { c / TILE ?? 0 } else { 0 - ((TILE - 1 - c) / TILE ?? 0) }
}

// A tile's key: raster3d draws the tiles in the order of their keys.
fn key_of(tx: integer, ty: integer) -> integer {
  (ty + 4096) * 8192 + (tx + 4096)
}

// The group a face is hidden with: one cell's walls on one layer (what the hero's cut-away takes
// out), -1 for a floor or a card.
fn group_of(v: const FixedView, f: const faces3d::Face) -> integer {
  n = len(f.at) / 5 ?? 0;
  x = 1000000.0;
  zz = 1000000.0;
  y0 = 1000000.0;
  y1 = -1000000.0;
  for c in 0..n {
    fx = f.at[c * 5] ?? 0.0;
    fy = f.at[c * 5 + 1] ?? 0.0;
    fz = f.at[c * 5 + 2] ?? 0.0;
    if fx < x { x = fx; }
    if fz < zz { zz = fz; }
    if fy < y0 { y0 = fy; }
    if fy > y1 { y1 = fy; }
  }
  floor_y = floor(y0 + 0.000001);
  if y1 - floor_y < 0.5 { return -1; }
  gx = floor(x + 0.001) as integer;
  gz = floor(zz + 0.001) as integer;
  gl = (floor_y as integer) - v.z0 + 4;
  ((gl & 15) * 2048 + (gz & 2047)) * 2048 + (gx & 2047)
}

// The faces and cards of tile (tx, ty), as raster3d takes them, from `cl` and `lt` (which hold
// the tile, HALO round it, a layer under and over).
fn tile_faces(v: FixedView, g: const game::Game, cl: const faces3d::Cells, lt: const faces3d::Light, tx: integer,
              ty: integer) -> vector<float> {
  x0 = tx * TILE;
  y0 = ty * TILE;
  x1 = x0 + TILE - 1;
  y1 = y0 + TILE - 1;
  out: vector<float> = [];
  for pass in 0..2 {
    fs = if pass == 0 { faces3d::faces_box(g, cl, lt, x0, y0, x1, y1, v.z0, v.z1, false) }
         else { faces3d::cards_box(g, cl, lt, x0, y0, x1, y1, v.z0, v.z1, 0.0, false) };
    for f in fs {
      n = len(f.at) / 5 ?? 0;
      grp = if pass == 0 { group_of(v, f) } else { -1 };
      out += [pic_of(v, f.sprite) as float, grp as float, n as float, f.lx as float, f.ly as float, f.lz as float, f.lk];
      // Lit from its cell, its corners hold no light of their own; else their own.
      own = f.lz == faces3d::NO_LIGHT;
      for c in 0..n {
        i = c * 5;
        out += [f.at[i] ?? 0.0, f.at[i + 1] ?? 0.0, f.at[i + 2] ?? 0.0, f.at[i + 3] ?? 0.0, f.at[i + 4] ?? 0.0,
                if own { f.lights[c] ?? f.light } else { 0.0 }];
      }
    }
  }
  out
}

// What tile (tx, ty) reads: its cells and its light, read for it alone.
fn tile_cells(v: const FixedView, g: const game::Game, tx: integer, ty: integer) -> faces3d::Cells {
  x0 = tx * TILE;
  y0 = ty * TILE;
  faces3d::cells(g, x0 - faces3d::HALO, y0 - faces3d::HALO, x0 + TILE - 1 + faces3d::HALO,
                  y0 + TILE - 1 + faces3d::HALO, v.z0 - 1, v.z1 + 1)
}

// The light a tile's faces are lit from: its layers and the one above (a wall's top); not the one
// below, which lights only the faces seen from below, left out here.
fn tile_light(v: const FixedView, g: const game::Game, tx: integer, ty: integer) -> faces3d::Light {
  x0 = tx * TILE;
  y0 = ty * TILE;
  faces3d::light_box(g, x0, y0, x0 + TILE - 1, y0 + TILE - 1, v.z0, v.z1 + 1)
}

fn same(a: const vector<float>, b: const vector<float>) -> boolean {
  if len(a) != len(b) { return false; }
  for i in 0..len(a) { if (a[i] ?? 0.0) != (b[i] ?? 0.0) { return false; } }
  true
}

// Tile (tx, ty) given to the scene (again) as `faces`.
fn put_tile(v: FixedView, g: const game::Game, tx: integer, ty: integer, faces: const vector<float>) {
  give(v, g);
  key = key_of(tx, ty);
  e_tile(v, key, faces);
  flames = moving(v, g, tx, ty);
  t = v.tiles[key];
  if t {
    t.faces = faces;
    t.flames = flames;
    return;
  }
  v.tiles += [Tile { key: key, tx: tx, ty: ty, faces: faces, flames: flames }];
  v.all += [key];
}

// The light `lt` holds, given to the scene as the cells' light.
fn send_light(v: FixedView, lt: const faces3d::Light) {
  for i in 0..faces3d::light_layers(lt) { e_light(v, faces3d::light_data(lt, i)); }
}

// The cells of tile (tx, ty) with a thing whose picture moves.
fn moving(v: const FixedView, g: const game::Game, tx: integer, ty: integer) -> vector<(integer, integer, integer)> {
  w = g.world;
  out: vector<(integer, integer, integer)> = [];
  for z in v.z0..=v.z1 {
    for y in ty * TILE..ty * TILE + TILE {
      for x in tx * TILE..tx * TILE + TILE {
        if tile_world::top(w.w, x, y, z) == 0 { continue; }
        for t in tile_world::things(w.w, x, y, z) {
          if theme::thing_moves(g.look, t) {
            out += [(x, y, z)];
            break;
          }
        }
      }
    }
  }
  out
}

// Tile (tx, ty) built, from its own cells and light.
fn build_tile(v: FixedView, g: const game::Game, tx: integer, ty: integer) {
  at = ticks();
  cl = tile_cells(v, g, tx, ty);
  lt = tile_light(v, g, tx, ty);
  send_light(v, lt);
  put_tile(v, g, tx, ty, tile_faces(v, g, cl, lt, tx, ty));
  v.spent.built += 1;
  v.spent.built_us += ticks() - at;
}

// A new scene round the hero: every tile out to REACH built, from one read of the cells and the
// light for them all.
fn fresh(v: FixedView, g: const game::Game) {
  at = ticks();
  w = g.world;
  new_scene(v);
  v.given = 0;
  v.tiles = [];
  v.all = [];
  v.next = 0;
  v.suspects = [];
  v.seen = tile_world::changes(w.w);
  v.lights = lights_of(g, layers(g));
  v.place = g.place;
  v.z = w.hero_z;
  v.night = w.night;
  (z0, z1) = layers(g);
  v.z0 = z0;
  v.z1 = z1;
  v.placed = false;
  tx0 = tile_of(w.hero_x - REACH);
  ty0 = tile_of(w.hero_y - REACH);
  tx1 = tile_of(w.hero_x + REACH);
  ty1 = tile_of(w.hero_y + REACH);
  x0 = tx0 * TILE;
  y0 = ty0 * TILE;
  x1 = tx1 * TILE + TILE - 1;
  y1 = ty1 * TILE + TILE - 1;
  cl = faces3d::cells(g, x0 - faces3d::HALO, y0 - faces3d::HALO, x1 + faces3d::HALO, y1 + faces3d::HALO, z0 - 1, z1 + 1);
  lt = faces3d::light_box(g, x0, y0, x1, y1, z0, z1 + 1);
  send_light(v, lt);
  for ty in ty0..=ty1 {
    for tx in tx0..=tx1 { put_tile(v, g, tx, ty, tile_faces(v, g, cl, lt, tx, ty)); }
  }
  v.ox = w.hero_x;
  v.oy = w.hero_y;
  e_origin(v, v.ox, z1, v.oy);
  v.spent.fresh += 1;
  v.spent.fresh_us += ticks() - at;
}

// The tiles kept up as the hero walks: those coming into view built at once, the rest out to
// REACH nearest first while the frame's budget lasts, those left far behind dropped.
fn walk(v: FixedView, g: const game::Game, until: integer) {
  w = g.world;
  hx = w.hero_x;
  hy = w.hero_y;
  // Left behind.
  gone: vector<integer> = [];
  for t in v.tiles {
    cx = t.tx * TILE + TILE / 2;
    cy = t.ty * TILE + TILE / 2;
    if cx - hx > DROP || hx - cx > DROP || cy - hy > DROP || hy - cy > DROP { gone += [t.key]; }
  }
  for k in gone {
    e_drop(v, k);
    v.tiles[k] = null;
    keep: vector<integer> = [];
    for d in v.all { if d != k { keep += [d]; } }
    v.all = keep;
  }
  // Missing, nearest first: those in view now, together; the rest while the budget lasts.
  seen: vector<(integer, integer)> = [];
  ahead: vector<(integer, integer)> = [];
  for ring in 0..=(REACH / TILE + 1) {
    for ty in tile_of(hy) - ring..=tile_of(hy) + ring {
      for tx in tile_of(hx) - ring..=tile_of(hx) + ring {
        if tx != tile_of(hx) - ring && tx != tile_of(hx) + ring && ty != tile_of(hy) - ring && ty != tile_of(hy) + ring {
          continue;
        }
        if v.tiles[key_of(tx, ty)] { continue; }
        // The cells of the tile nearest the hero, each way.
        nx = if hx < tx * TILE { tx * TILE - hx } else if hx >= tx * TILE + TILE { hx - tx * TILE - TILE + 1 } else { 0 };
        ny = if hy < ty * TILE { ty * TILE - hy } else if hy >= ty * TILE + TILE { hy - ty * TILE - TILE + 1 } else { 0 };
        if nx > REACH || ny > REACH { continue; }
        if nx > SEEN_X || ny > SEEN_Y { ahead += [(tx, ty)]; } else { seen += [(tx, ty)]; }
      }
    }
  }
  build_tiles(v, g, seen);
  for t in ahead {
    if ticks() > until { break; }
    build_tile(v, g, t.0, t.1);
  }
}

// Tiles built together, from one read of the cells and the light of the box round them all: a
// tile's light is mostly its margin (the shades read DARKEST round the box), so a row of tiles
// read at once costs about what two read apart do.
fn build_tiles(v: FixedView, g: const game::Game, ts: const vector<(integer, integer)>) {
  if len(ts) == 0 { return; }
  if len(ts) == 1 {
    build_tile(v, g, (ts[0] ?? (0, 0)).0, (ts[0] ?? (0, 0)).1);
    return;
  }
  at = ticks();
  tx0 = 1000000;
  ty0 = 1000000;
  tx1 = -1000000;
  ty1 = -1000000;
  for t in ts {
    if t.0 < tx0 { tx0 = t.0; }
    if t.1 < ty0 { ty0 = t.1; }
    if t.0 > tx1 { tx1 = t.0; }
    if t.1 > ty1 { ty1 = t.1; }
  }
  x0 = tx0 * TILE;
  y0 = ty0 * TILE;
  x1 = tx1 * TILE + TILE - 1;
  y1 = ty1 * TILE + TILE - 1;
  h = faces3d::HALO;
  cl = faces3d::cells(g, x0 - h, y0 - h, x1 + h, y1 + h, v.z0 - 1, v.z1 + 1);
  lt = faces3d::light_box(g, x0, y0, x1, y1, v.z0, v.z1 + 1);
  send_light(v, lt);
  for t in ts { put_tile(v, g, t.0, t.1, tile_faces(v, g, cl, lt, t.0, t.1)); }
  v.spent.built += len(ts);
  v.spent.built_us += ticks() - at;
}

// Tile `key` looked at: built again, and given to raster3d when its faces differ.
fn look(v: FixedView, g: const game::Game, key: integer) {
  t = v.tiles[key];
  if !t { return; }
  at = ticks();
  tx = t.tx;
  ty = t.ty;
  cl = tile_cells(v, g, tx, ty);
  lt = tile_light(v, g, tx, ty);
  faces = tile_faces(v, g, cl, lt, tx, ty);
  v.spent.looked += 1;
  // Its light, whether its faces changed or not: raster3d lights again only what differs.
  send_light(v, lt);
  if !same(faces, t.faces) {
    put_tile(v, g, tx, ty, faces);
    v.spent.changed += 1;
  }
  v.spent.looked_us += ticks() - at;
}

// The lights on the layers a tile's faces read, as `lights` keeps them.
fn lights_of(g: const game::Game, zs: (integer, integer)) -> vector<(integer, integer, integer, integer)> {
  w = g.world;
  out: vector<(integer, integer, integer, integer)> = [];
  for z in zs.0 - 1..=zs.1 + 1 {
    starts = rules::light_starts(w, z);
    i = 0;
    for l in rules::lights(w, z) {
      out += [(l.0, l.1, z, starts[i] ?? 0)];
      i += 1;
    }
  }
  out
}

fn suspect(v: FixedView, key: integer) {
  if !v.tiles[key] { return; }
  for k in v.suspects { if k == key { return; } }
  v.suspects += [key];
}

// The cells a light at (x, y) on layer z reaches, their light given again.
fn shine(v: FixedView, g: const game::Game, x: integer, y: integer, z: integer) {
  send_light(v, faces3d::light_box(g, x - SHINE, y - SHINE, x + SHINE, y + SHINE, z, z));
  v.spent.shone += 1;
}

// What changed since the last frame, told: the world's changes (the tiles whose cells changed,
// answered, to be looked at now; those within READS suspected), the lights that moved, dimmed or
// went out (the light of the cells they reach given again).
fn told(v: FixedView, g: const game::Game) -> vector<integer> {
  w = g.world;
  now: vector<integer> = [];
  n = tile_world::changes(w.w);
  if n != v.seen {
    for t in v.tiles {
      x0 = t.tx * TILE;
      y0 = t.ty * TILE;
      x1 = x0 + TILE - 1;
      y1 = y0 + TILE - 1;
      if !tile_world::changed_since(w.w, x0 - READS, y0 - READS, x1 + READS, y1 + READS, v.z0 - 1, v.z1 + 1, v.seen) {
        continue;
      }
      h = faces3d::HALO;
      if tile_world::changed_since(w.w, x0 - h, y0 - h, x1 + h, y1 + h, v.z0 - 1, v.z1 + 1, v.seen) {
        now += [t.key];
      } else {
        suspect(v, t.key);
      }
    }
    v.seen = n;
  }
  ls = lights_of(g, (v.z0, v.z1));
  if ls != v.lights {
    for l in ls { if !v.lights.contains(l) { shine(v, g, l.0, l.1, l.2); } }
    for l in v.lights { if !ls.contains(l) { shine(v, g, l.0, l.1, l.2); } }
    v.lights = ls;
  }
  now
}

// The landscape as it is now: a new scene when the hero changed place or layer (or the layers
// shown changed), or night fell or day broke (every tile's light at once: a look a frame would
// show night and day side by side), or the world is another one (it counts fewer changes than
// were seen); else the tiles kept up as the hero walks, and those changes touched looked at —
// the ones whose cells changed first, all of them now, the rest while the frame's budget lasts —
// and, while the game changes, one tile in turn every SWEEP frames; the depth's origin moved when
// the hero went far from it.
fn keep_up(v: FixedView, g: const game::Game, changed: boolean) {
  w = g.world;
  (z0, z1) = layers(g);
  if !live(v) || g.place != v.place || w.hero_z != v.z || z0 != v.z0 || z1 != v.z1 || w.night != v.night
     || tile_world::changes(w.w) < v.seen {
    fresh(v, g);
    return;
  }
  until = ticks() + BUDGET;
  walk(v, g, until);
  // The tiles whose cells changed: now, whatever the budget; the suspects while it lasts.
  for k in told(v, g) { look(v, g, k); }
  while len(v.suspects) > 0 && ticks() <= until {
    k = v.suspects[0] ?? 0;
    v.suspects.remove(0);
    look(v, g, k);
  }
  v.frame += 1;
  n = len(v.all);
  if changed && n > 0 && v.frame % SWEEP == 0 && ticks() <= until {
    v.next = (v.next + 1) % n ?? 0;
    look(v, g, v.all[v.next] ?? 0);
  }
  if w.hero_x - v.ox > ORIGIN || v.ox - w.hero_x > ORIGIN || w.hero_y - v.oy > ORIGIN || v.oy - w.hero_y > ORIGIN {
    v.ox = w.hero_x;
    v.oy = w.hero_y;
    e_origin(v, v.ox, v.z1, v.oy);
  }
}

// The camera: kept within FOLLOW cells of the hero, sliding SLIDE pixels a frame; placed on the
// hero at once after a new scene.
fn follow(v: FixedView, hero: const game::Figure, z: integer) {
  size = screen_size(v);
  tx = (((hero.x as float) + 0.5 + hero.fine.x / 16.0) * (raster3d::WIDE as float)) as integer - size.0 / 2;
  ty = (((hero.y as float) + 0.5 + hero.fine.y / 16.0) * (raster3d::DEEP as float)
        - ((z as float) + 0.25 * (hero.h as float)) * (raster3d::TALL as float)) as integer - size.1 / 2;
  if !v.placed {
    v.cam_x = tx;
    v.cam_y = ty;
    v.placed = true;
    return;
  }
  v.cam_x = towards(v.cam_x, tx, FOLLOW * raster3d::WIDE);
  v.cam_y = towards(v.cam_y, ty, FOLLOW * raster3d::DEEP);
}

// `at` moved at most SLIDE towards `to`, until it is within `slack` of it.
fn towards(at: integer, to: integer, slack: integer) -> integer {
  d = to - at;
  if d > slack { return at + (if d - slack > SLIDE { SLIDE } else { d - slack }); }
  if d < -slack { return at - (if -slack - d > SLIDE { SLIDE } else { -slack - d }); }
  at
}

// The light on a figure at (x, y, z): its cell's, as raster3d holds it.
fn light_on(v: const FixedView, g: const game::Game, x: integer, y: integer, z: integer) -> float {
  l = e_light_at(v, x, y, z);
  if l { return l!; }
  faces3d::light_at(g, x, y, z)
}

// The figures on the layers shown, as actors: a body card each and what it holds beside it; and
// the things whose picture moves, as the tiles that leave them out list them.
fn actors(v: FixedView, g: const game::Game) -> vector<float> {
  w = g.world;
  out: vector<float> = [];
  id = FLAME;
  for k in v.all {
    t = v.tiles[k];
    if !t { continue; }
    for c in t.flames {
      light = light_on(v, g, c.0, c.1, c.2);
      for f in faces3d::thing_cards(g, c.0, c.1, c.2) {
        if f.0 < 0 { continue; }
        out += [id as float, pic_of(v, f.0) as float, (c.0 as float) + 0.5, f.1, (c.1 as float) + 0.5, f.2, light,
                0.0, 0.5, 1.0, 0.0];
        id += 1;
      }
    }
  }
  v.spent.flames = id - FLAME;
  for z in v.z0..=v.z1 {
    i = 0;
    for f in game::figures(g, w, z) {
      id = if f.facing_shown { HERO } else { (z - v.z0) * 10000 + i * 3 };
      i += 1;
      // The pose in this file's single precision: the game's numbers are 64-bit, narrowed once here.
      fine = (f.fine.x as single, f.fine.y as single, f.fine.hop as single, f.fine.tilt as single,
              f.fine.weapon as single, f.fine.reach as single);
      x = (f.x as float) + 0.5 + fine.0 / 16.0;
      zz = (f.y as float) + 0.5 + fine.1 / 16.0;
      y = (z as float) + 0.25 * (f.h as float) - fine.2 / 16.0;
      light = light_on(v, g, f.x, f.y, z);
      // As the 2D poses it (game::figure_turn): turned about the bottom middle of its picture,
      // mirrored for the hero facing west.
      turn = game::figure_turn(f);
      out += [id as float, pic_of(v, f.sprite) as float, x, y, zz, FIGURE, light, turn.0 as single, PIVOT_U, PIVOT_V,
              if turn.1 { 1.0 } else { 0.0 }];
      // Its picture's pixels as the card's: 16 of them across FIGURE.
      k = FIGURE / 16.0;
      left = x - FIGURE / 2.0;
      top = y + FIGURE;
      // What is on the shoulders hangs at the back, away from the way it faces.
      if f.shoulder != 0 {
        sx = left - ((f.face_x * 4) as float) * k + FIGURE / 2.0;
        sy = top + ((f.face_y * 3 + 2) as float) * k - FIGURE;
        out += [(id + 2) as float, pic_of(v, theme::thing_sprite(g.look, f.shoulder)) as float, sx, sy, zz - 0.03, FIGURE,
                light, fine.3, PIVOT_U, PIVOT_V, 0.0];
      }
      // What it holds: its carried picture at the hand, turned as the swing turns it about its
      // grip and pushed out by its reach (theme::held_place), behind it facing north.
      if f.item != 0 {
        hd = game::hand(f.face_x, f.face_y);
        p = theme::held_place(g.look, f.item, hd.0 as f64, hd.1 as f64, f.fine.weapon, f.fine.reach, w.now, f.low);
        if p.0 >= 0 {
          ix = left + (p.1 as single) * k + FIGURE / 2.0;
          iy = top - (p.2 as single) * k - FIGURE;
          iz = if game::held_behind(f) { zz - 0.02 } else { zz + 0.02 };
          out += [(id + 1) as float, pic_of(v, p.0) as float, ix, iy, iz, FIGURE, light, fine.4, (p.3 as single) / 16.0,
                  (p.4 as single) / 16.0, 0.0];
        }
      }
      if f.facing_shown { follow(v, f, z); }
    }
  }
  out
}

// The status line along the bottom and a bubble over whoever speaks, as the 2D draws them
// (`game::draw_status_on`, `game::draw_bubble`), over the frame.
fn overlay(v: FixedView, g: const game::Game) {
  size = screen_size(v);
  w = (size.0 + OVER - 1) / OVER ?? 0;
  h = size.1 / OVER ?? 0;
  ts = g.look.tile_size;
  if v.over != 0 && (w != v.over_w || h != v.over_h) {
    tiles::free_surface(v.over);
    v.over = 0;
  }
  if v.over == 0 {
    v.over = tiles::surface(w, h) ?? 0;
    v.over_w = w;
    v.over_h = h;
  }
  if v.over == 0 { return; }
  tiles::rect(v.over, 0, 0, w, h, raster3d::NONE);
  // editing: the editor's palette and status over the frame, the hero standing as its cursor
  if g.editing {
    game::draw_editor_on(g, v.over, w, h);
    e_overlay(v, tiles::pixels(v.over, w, h), w, h);
    return;
  }
  game::draw_status_on(g, v.over, h - ts, (w * 2 / ts) ?? 0);
  for t in game::talking(g) {
    // Over the speaker's card as the camera sees it: its cell's middle, a figure's height up.
    sx = (((t.x as float) + 0.5) * (raster3d::WIDE as float)) as integer - v.cam_x;
    sy = (((t.y as float) + 0.5) * (raster3d::DEEP as float)
          - ((t.z as float) + FIGURE) * (raster3d::TALL as float)) as integer - v.cam_y;
    game::draw_bubble(g, v.over, t, sx / OVER ?? 0, (sy / OVER ?? 0) - 1, w);
  }
  e_overlay(v, tiles::pixels(v.over, w, h), w, h);
}

/// This frame: the landscape kept up, the camera on the hero, the figures over it, the status line
/// and what is said over them — into the device's window (`present` shows it) or into `v.px`.
pub fn draw(v: FixedView, g: const game::Game, changed: boolean, now: integer) {
  keep_up(v, g, changed);
  if !live(v) { return; }
  acts = actors(v, g);
  give(v, g);
  overlay(v, g);
  e_frame(v, acts);
}

/// The check (tools/fixedshot.loft): how many pixels of this view's last frame differ from the same
/// moment drawn by a view built fresh — every tile at once — with the same camera.  The tiles kept
/// up as the hero walked, dropped, built ahead and looked at must show what a new build shows: 0.
pub fn differs_from_fresh(v: const FixedView, g: const game::Game) -> integer {
  // Not `fresh`, which reads the cells and the light once for all its tiles: each tile from its
  // own reads, as `walk` and `look` build them, so the one read is checked too.
  w = g.world;
  f = view();
  f.on = true;
  f.scene = raster3d::new_scene(SKY) ?? 0;
  f.place = g.place;
  f.z = w.hero_z;
  f.night = w.night;
  (z0, z1) = layers(g);
  f.z0 = z0;
  f.z1 = z1;
  for ty in tile_of(w.hero_y - REACH)..=tile_of(w.hero_y + REACH) {
    for tx in tile_of(w.hero_x - REACH)..=tile_of(w.hero_x + REACH) { build_tile(f, g, tx, ty); }
  }
  raster3d::build_scene(f.scene, w.hero_x as float, z1 as float, w.hero_y as float);
  if f.scene == 0 || len(v.px) != raster3d::WIDTH * raster3d::HEIGHT { return -1; }
  f.px = [0 as i32; raster3d::WIDTH * raster3d::HEIGHT];
  f.placed = true;
  f.cam_x = v.cam_x;
  f.cam_y = v.cam_y;
  acts = actors(f, g);
  f.cam_x = v.cam_x;
  f.cam_y = v.cam_y;
  give(f, g);
  raster3d::move_camera(f.scene, f.cam_x, f.cam_y);
  raster3d::set_actors(f.scene, acts, HERO);
  overlay(f, g);
  raster3d::draw_frame(f.scene, f.px);
  raster3d::free_scene(f.scene);
  d = 0;
  for i in 0..len(f.px) { if (f.px[i] ?? 0) != (v.px[i] ?? 0) { d += 1; } }
  d
}

/// The GPU's check (tools/fixedshot.loft, `gpu`; SCENE_CONTRACT.md § Checks): the moment `v` last
/// drew on the CPU, drawn on a GPU through `table` from a scene built fresh, with the same camera,
/// and read back from the device's window as RGB565.  Empty where no device opens.
pub fn gpu_frame(v: const FixedView, g: const game::Game, table: i64) -> vector<i32> {
  f = view();
  f.on = true;
  f.table = table;
  fresh(f, g);
  if !f.gs { return []; }
  f.placed = true;
  f.cam_x = v.cam_x;
  f.cam_y = v.cam_y;
  acts = actors(f, g);
  f.cam_x = v.cam_x;
  f.cam_y = v.cam_y;
  give(f, g);
  overlay(f, g);
  e_frame(f, acts);
  out: vector<i32> = [];
  for c in f.dev!.capture() {
    // 0xAARRGGBB is above 2^31: read as an i64, its top bits left behind.
    p = (c as i64 & 16777215l) as integer;
    out += [((((p >> 19) & 31) << 11) | (((p >> 10) & 63) << 5) | ((p >> 3) & 31)) as i32];
  }
  out
}
