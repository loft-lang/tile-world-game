//
// A room on its own tile grid, placed at an angle on hex ground (WORLD.md § One game, square or
// hex: tile grids at small scale, hex ground between — owner, 2026-11-16).
//
// The room is a square place as the game has them (a `rules::Level`): inside it the rules play
// as they do, four ways, whatever angle the room lies at.  Round it is open ground of hex cells,
// where a thing moves one of twelve ways: an even heading to a neighbour, an odd one between two
// hexes through to the next full hex — or, when that is not free, aside into one of the two it
// would pass between (the side the place prefers, then the other; `rules::prefers_right`).
//
// An opening of the room (a way through its outer wall) is paired with the hex outside it when
// the room is placed, both ways: a thing pushed out of the opening lands on that hex, and pushed
// back from it lands on the opening's tile.  The room is set down so its first opening's hex lies
// exactly one tile's length outside it.
//
// A move takes the time of its real length at one speed: a tile or a neighbouring hex, 1.5 m, in
// `STEP_MS`; between two hexes, 1.5 × √3 m, in that much longer.
//
// The same grid is what a drawn map shows: `tile_corners` gives a tile as a square on the map.
//
// A terrace is a room with low walls (owner): floor to its rim, a low wall on the rim's edges, a
// gate where there is none.  A garden maze is one terrace however big, its hedges edges inside it
// (owner).  `rim` gives what stands round a room, side by side; `sees` whether one point sees
// another past the room's walls and hedges, over its low walls.
//
// A room has layers: a bridge is tiles a layer up over a path, reached by stairs.  `walk_from`
// asks the room's rules where a step leads, layer and all; `reached` and `one_hand` walk a maze.
//
// What this is not yet: the game's play (the hero, the view and the clock still run on one square
// place); more than one thing on a hex; a fence at the corner a thing leaves by; a way out of a
// room on a layer over its own.
use hex_field;
use hex_form;
use hexterrain;
use tile_world;
use rules;

/// A tile's side, in metres: a hex step's.
pub const TILE = 1.5;
/// The time a thing takes over one tile or to a neighbouring hex (the game's glide, FREE_CELL_MS).
pub const STEP_MS = 140;

/// A way through the room's outer wall: its tile on the rim, the step out of the room there
/// (tiles), the heading that step has on the ground, and the hex outside it.  `exact`: that hex
/// lies straight out, one tile's length away; else the two hexes either side of the line are kept
/// (`lq`, `lr` left of the way out, `rq`, `rr` right) and a thing leaving goes aside into one.
pub struct Opening {
  pub x: integer,
  pub y: integer,
  pub dx: integer,
  pub dy: integer,
  pub heading: integer = 0,
  pub exact: boolean = false,
  pub q: integer = 0,
  pub r: integer = 0,
  pub lq: integer = 0,
  pub lr: integer = 0,
  pub rq: integer = 0,
  pub rr: integer = 0
}

/// A room: a square place, the layer played, its size in tiles, where tile (0, 0)'s centre lies
/// (metres) and its angle (steps of 30°: its tiles' x runs along that heading, y a quarter turn
/// clockwise of it, as south is of east).
pub struct Room {
  pub level: rules::Level,
  pub w: integer,
  pub h: integer,
  pub z: integer,
  pub turn: integer,
  pub ox: float = 0.0,
  pub oy: float = 0.0,
  pub openings: vector<Opening> = [],
  /// The room's first tile in its place (a house in a town's own map is a part of it: its
  /// tiles are x0 .. x0 + w - 1, y0 .. y0 + h - 1; a place of its own starts at 0, 0).  `ox`, `oy`
  /// is where that first tile's centre lies.
  pub x0: integer = 0,
  pub y0: integer = 0,
  /// A window onto a place kept elsewhere (a town's own map): `level` is not that place and is
  /// not asked; who plays the field answers what the room's rules would.
  pub window: boolean = false
}

/// The open ground round the rooms: which hexes lie under a room (its number, -1 for open), what
/// thing stands on a hex (0 for none), which hexes hold what does not move (a tree), and the
/// fences on the edges between hexes.
pub struct Ground {
  /// What the ground is, hex by hex (hexterrain's kinds: grass, path, water ...).
  pub kinds: hex_field::Labels,
  pub under: hex_field::Labels,
  pub things: hex_field::Labels,
  pub fixed: hex_field::HexSet,
  pub fences: hex_field::EdgeSet
}

pub fn ground(q0: integer, r0: integer, w: integer, h: integer) -> Ground {
  g = Ground { kinds: hex_field::labels_new(q0, r0, w, h), under: hex_field::labels_new(q0, r0, w, h), things: hex_field::labels_new(q0, r0, w, h),
               fixed: hex_field::hexset_chunk(q0, r0, w, h), fences: hex_field::edgeset_new(q0, r0, w, h) };
  for r in r0..r0 + h {
    for q in q0..q0 + w {
      hex_field::label_set(g.things, q, r, 0);
      hex_field::label_set(g.kinds, q, r, 0);
    }
  }
  g
}

// ── where things are ────────────────────────────────────────────────────────

/// The direction of heading `h` (0 east, 3 north; steps of 30°).
pub fn way(h: integer) -> (float, float) {
  a = (hex_form::head_norm(h) as float) * PI / 6.0;
  (cos(a), sin(a))
}

/// The heading of the twelve nearest the direction (x, y).
pub fn heading_of(x: float, y: float) -> integer {
  best = 0;
  most = -2.0;
  for h in 0..12 {
    (wx, wy) = way(h);
    d = wx * x + wy * y;
    if d > most {
      most = d;
      best = h;
    }
  }
  best
}

/// The heading a step (dx, dy) of the room's tiles has on the ground.
pub fn room_heading(rm: const Room, dx: integer, dy: integer) -> integer {
  hex_form::head_norm(rm.turn + (if dx > 0 { 0 } else if dy < 0 { 3 } else if dx < 0 { 6 } else { 9 }))
}

/// The step of the room's four nearest the direction (x, y).
pub fn room_step(rm: const Room, x: float, y: float) -> (integer, integer) {
  best = (1, 0);
  most = -2.0;
  for s in [(1, 0), (0, -1), (-1, 0), (0, 1)] {
    (wx, wy) = way(room_heading(rm, s.0, s.1));
    d = wx * x + wy * y;
    if d > most {
      most = d;
      best = s;
    }
  }
  best
}

/// The centre of the room's tile (x, y), in metres; a tile outside it too.
pub fn tile_centre(rm: const Room, x: float, y: float) -> (float, float) {
  (ex, ey) = way(rm.turn);
  (sx, sy) = way(rm.turn + 9);
  u = x - (rm.x0 as float);
  v = y - (rm.y0 as float);
  (rm.ox + (u * ex + v * sx) * TILE, rm.oy + (u * ey + v * sy) * TILE)
}

/// The four corners of the room's tile (x, y), in metres, anticlockwise: the tile as it is drawn
/// on a map — a square a figure stands on, at the room's angle (owner, 2026-11-16: the rooms' and
/// corridors' grid serves drawn maps too, as big tiles where people can stand; Moros's tabletop).
pub fn tile_corners(rm: const Room, x: integer, y: integer) -> vector<(float, float)> {
  [tile_centre(rm, (x as float) - 0.5, (y as float) + 0.5), tile_centre(rm, (x as float) + 0.5, (y as float) + 0.5),
   tile_centre(rm, (x as float) + 0.5, (y as float) - 0.5), tile_centre(rm, (x as float) - 0.5, (y as float) - 0.5)]
}

/// Where (x, y) metres lies on the room's own grid, in tiles from its first tile (a tile's centre a
/// whole number).
pub fn local(rm: const Room, x: float, y: float) -> (float, float) {
  (ex, ey) = way(rm.turn);
  (sx, sy) = way(rm.turn + 9);
  (((x - rm.ox) * ex + (y - rm.oy) * ey) / TILE ?? 0.0, ((x - rm.ox) * sx + (y - rm.oy) * sy) / TILE ?? 0.0)
}

/// The room's tile under (x, y) metres, as (inside, tile x, tile y).
pub fn tile_at(rm: const Room, x: float, y: float) -> (boolean, integer, integer) {
  (ex, ey) = way(rm.turn);
  (sx, sy) = way(rm.turn + 9);
  u = ((x - rm.ox) * ex + (y - rm.oy) * ey) / TILE;
  v = ((x - rm.ox) * sx + (y - rm.oy) * sy) / TILE;
  tx = round(u) as integer + rm.x0;
  ty = round(v) as integer + rm.y0;
  (u > -0.5 && v > -0.5 && u < (rm.w as float) - 0.5 && v < (rm.h as float) - 0.5, tx, ty)
}

/// The hex a step of heading `h` from (q, r) comes to: a neighbour (even), or the next full hex
/// between two neighbours (odd).
pub fn hex_step(q: integer, r: integer, h: integer) -> (integer, integer) {
  (dk, dm) = hex_form::head_step(h);
  hex_field::lattice_to_cell(hex_field::lattice_k(q, r) + dk, hex_field::lattice_m(q, r) + dm)
}

/// How far two points are apart.
fn apart(a: (float, float), b: (float, float)) -> float {
  sqrt((a.0 - b.0) * (a.0 - b.0) + (a.1 - b.1) * (a.1 - b.1)) ?? 0.0
}

/// The time a thing takes over `metres`.
pub fn ms_of(metres: float) -> integer { round((STEP_MS as float) * metres / TILE) as integer }

/// The ways through the room's rim on its layer: each side of a rim tile that looks out of the
/// room, where a thing can stand on the tile and nothing on that side stops a step (no wall, no
/// low wall, no hedge; a door's edge is a way).  A room walled by a ring of wall tiles has its
/// doorways; a terrace, floor to its rim with a low wall on the rim's edges, has its gates.
fn openings_of(rm: const Room, l: const rules::Level) -> vector<Opening> {
  out: vector<Opening> = [];
  for j in 0..rm.h {
    for i in 0..rm.w {
      x = rm.x0 + i;
      y = rm.y0 + j;
      k = tile_world::terrain(l.w, x, y, rm.z);
      // a tile a thing can stand on — or a door, shut as it may be
      door = rules::terrain_name(l.k, k).contains("door");
      if k == rules::VOID || (!rules::walkable(l, k) && !door) { continue; }
      for s in [(1, 0), (0, -1), (-1, 0), (0, 1)] {
        ni = i + s.0;
        nj = j + s.1;
        if ni >= 0 && nj >= 0 && ni < rm.w && nj < rm.h { continue; }
        if tile_world::crossable(l.w, x, y, rm.z, s.0, s.1) { out += [Opening { x: x, y: y, dx: s.0, dy: s.1 }]; }
      }
    }
  }
  out
}

// ── the rim, and what is seen ───────────────────────────────────────────────

/// What stands on a side of the room's rim.
pub const RIM_OPEN = 0;
/// Something low, seen over and not crossed by a thing: a low wall, a low hedge, a fence.
pub const RIM_LOW = 1;
/// A wall (or a hedge as high): not seen through, unless `sees` (a window).
pub const RIM_WALL = 2;

/// One side of the room's rim: a tile's side that looks out of the room, from a to b in metres
/// (the room on its left), what stands on it, and whether sight passes it.
pub struct RimSide {
  pub x: integer,
  pub y: integer,
  pub dx: integer,
  pub dy: integer,
  pub kind: integer,
  pub sees: boolean,
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float
}

/// The room's rim, side by side, anticlockwise from its south-west corner: what a map or a view
/// draws round it — a wall, a low wall, or nothing where there is a way through.
pub fn rim(rm: const Room) -> vector<RimSide> {
  out: vector<RimSide> = [];
  // south side west to east, east side south to north, north side east to west, west side down
  for leg in 0..4 {
    n = if leg % 2 == 0 { rm.w } else { rm.h };
    for i in 0..n {
      x = rm.x0 + (if leg == 0 { i } else if leg == 1 { rm.w - 1 } else if leg == 2 { rm.w - 1 - i } else { 0 });
      y = rm.y0 + (if leg == 0 { rm.h - 1 } else if leg == 1 { rm.h - 1 - i } else if leg == 2 { 0 } else { i });
      dx = if leg == 1 { 1 } else if leg == 3 { -1 } else { 0 };
      dy = if leg == 0 { 1 } else if leg == 2 { -1 } else { 0 };
      // the side's ends: half a tile out, half a tile either way along it
      fx = x as float + 0.5 * (dx as float);
      fy = y as float + 0.5 * (dy as float);
      a = tile_centre(rm, fx - 0.5 * (dy as float), fy + 0.5 * (dx as float));
      b = tile_centre(rm, fx + 0.5 * (dy as float), fy - 0.5 * (dx as float));
      k = tile_world::terrain(rm.level.w, x, y, rm.z);
      kind = RIM_WALL;
      sees = false;
      if k != rules::VOID && rules::walkable(rm.level, k) {
        sees = tile_world::see_through(rm.level.w, x, y, rm.z, dx, dy);
        kind = if tile_world::crossable(rm.level.w, x, y, rm.z, dx, dy) { RIM_OPEN }
               else if sees && rules::over_between(rm.level, x, y, rm.z, dx, dy) > 0 { RIM_LOW }
               else if rules::crosses_from(rm.level, x, y, rm.z, dx, dy, 0) { RIM_LOW }
               else { RIM_WALL };
      } else if k != rules::VOID {
        sees = !tile_world::opaque(rm.level.w, x, y, rm.z);
      }
      out += [RimSide { x: x, y: y, dx: dx, dy: dy, kind: kind, sees: sees, ax: a.0, ay: a.1, bx: b.0, by: b.1 }];
    }
  }
  out
}

/// A layer's height in steps (a hedge's and a wall's; kinds.json's `over`).
pub const LAYER = 4;
/// How high an eye is over the floor it stands on, in steps (1.6 m of a layer's 2.6), and how
/// high over its floor the spot looked at is (a figure's or a thing's middle).
pub const EYE = 2.5;
pub const AIM = 1.0;

/// Is (bx, by) seen from (ax, ay), both in metres, as far as this room goes: the straight line
/// from the eye to the spot, in the world's own space, crosses nothing of the room that stops
/// sight at the height the line has there.
///
/// `eye` and `aim` are heights in steps over the room's own floor (its layer `z`): an eye on the
/// floor is at `EYE`, one on a bridge a layer up at `LAYER + EYE`.  What stops sight: a tile that
/// does (a wall), for its layer's whole height; an edge that does (a wall, a hedge), as high as it
/// is; and a floor the line passes through (a bridge seen from below, the ground under a bridge
/// seen from on it).  A low wall and a low hedge stop a step, not sight.  The tiles the two ends
/// lie on do not count.  So a maze is overlooked from its high places and not from its paths.
pub fn sees(rm: const Room, ax: float, ay: float, bx: float, by: float, eye: float = EYE, aim: float = AIM) -> boolean {
  (ex, ey) = way(rm.turn);
  (sx, sy) = way(rm.turn + 9);
  u0 = ((ax - rm.ox) * ex + (ay - rm.oy) * ey) / TILE;
  v0 = ((ax - rm.ox) * sx + (ay - rm.oy) * sy) / TILE;
  u1 = ((bx - rm.ox) * ex + (by - rm.oy) * ey) / TILE;
  v1 = ((bx - rm.ox) * sx + (by - rm.oy) * sy) / TILE;
  du = u1 - u0;
  dv = v1 - v0;
  i = round(u0) as integer;
  j = round(v0) as integer;
  ei = round(u1) as integer;
  ej = round(v1) as integer;
  layer = LAYER as float;
  l0 = floor(eye / layer ?? 0.0) as integer;
  l1 = floor(aim / layer ?? 0.0) as integer;
  // a floor between the eye's layer and the spot's, where the line passes its height
  for lv in (if l0 < l1 { l0 } else { l1 }) + 1..(if l0 < l1 { l1 } else { l0 }) + 1 {
    t = ((lv as float) * layer - eye) / (aim - eye) ?? 0.0;
    fi = round(u0 + t * du) as integer;
    fj = round(v0 + t * dv) as integer;
    if fi >= 0 && fj >= 0 && fi < rm.w && fj < rm.h && tile_world::terrain(rm.level.w, fi + rm.x0, fj + rm.y0, rm.z + lv) != rules::VOID { return false; }
  }
  su = if du > 0.0 { 1 } else { -1 };
  sv = if dv > 0.0 { 1 } else { -1 };
  far = 1000000.0;
  tu = if du == 0.0 { far } else { ((i as float) + 0.5 * (su as float) - u0) / du };
  tv = if dv == 0.0 { far } else { ((j as float) + 0.5 * (sv as float) - v0) / dv };
  for _n in 0..4 * (rm.w + rm.h) + 2000 {
    if (i == ei && j == ej) || (tu > 1.0 && tv > 1.0) { return true; }
    t = if tu <= tv { tu } else { tv };
    sdx = if tu <= tv { su } else { 0 };
    sdy = if tu <= tv { 0 } else { sv };
    here = i >= 0 && j >= 0 && i < rm.w && j < rm.h;
    ni = i + sdx;
    nj = j + sdy;
    there = ni >= 0 && nj >= 0 && ni < rm.w && nj < rm.h;
    // the layer the line is on where it crosses, and how high over that layer's floor
    high = eye + t * (aim - eye);
    lv = floor(high / layer ?? 0.0) as integer;
    over = high - (lv as float) * layer;
    z = rm.z + lv;
    // the edge between the two tiles, asked of whichever is the room's
    if here && edge_stops(rm, i + rm.x0, j + rm.y0, z, sdx, sdy, over) { return false; }
    if !here && there && edge_stops(rm, ni + rm.x0, nj + rm.y0, z, -sdx, -sdy, over) { return false; }
    if there && !(ni == ei && nj == ej && lv == l1) && tile_world::opaque(rm.level.w, ni + rm.x0, nj + rm.y0, z) { return false; }
    if tu <= tv { tu += 1.0 / (if du < 0.0 { -du } else { du }); } else { tv += 1.0 / (if dv < 0.0 { -dv } else { dv }); }
    i = ni;
    j = nj;
  }
  true
}

// Does the edge on side (dx, dy) of tile (x, y, z) stop a line of sight `over` steps over that
// layer's floor: an edge sight does not pass, as high as it is (a wall the layer's whole height).
fn edge_stops(rm: const Room, x: integer, y: integer, z: integer, dx: integer, dy: integer, over: float) -> boolean {
  if tile_world::see_through(rm.level.w, x, y, z, dx, dy) { return false; }
  high = rules::over_between(rm.level, x, y, z, dx, dy);
  over < (if high > 0 { high } else { LAYER }) as float
}

// ── walking, by the room's rules ────────────────────────────────────────────

/// Where a walker on tile (x, y, z) of the room comes by one step (dx, dy), as the room's own
/// rules have it: (moved, x, y, z).  Stairs take it to the same tile a layer up or down, so a
/// bridge is walked over and the path under it walked under, each on its own layer.  For a place
/// with nothing in the walker's way to push.
pub fn walk_from(rm: Room, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> (boolean, integer, integer, integer) {
  rm.level.hero_x = x;
  rm.level.hero_y = y;
  rm.level.hero_z = z;
  rm.level.hero_h = 0;
  // a question, not a walk taken: a fall the step leads to costs the asker nothing
  health = rm.level.health;
  rules::walk(rm.level, dx, dy);
  rm.level.health = health;
  (rm.level.hero_x != x || rm.level.hero_y != y || rm.level.hero_z != z, rm.level.hero_x, rm.level.hero_y, rm.level.hero_z)
}

/// Can tile (gx, gy, gz) be walked to from (x, y, z), on the room's layers.
pub fn reached(rm: Room, x: integer, y: integer, z: integer, gx: integer, gy: integer, gz: integer) -> boolean {
  qx: vector<integer> = [x];
  qy: vector<integer> = [y];
  qz: vector<integer> = [z];
  at = 0;
  while at < len(qx) {
    cx = qx[at] ?? 0;
    cy = qy[at] ?? 0;
    cz = qz[at] ?? 0;
    at += 1;
    if cx == gx && cy == gy && cz == gz { return true; }
    for s in [(1, 0), (0, -1), (-1, 0), (0, 1)] {
      n = walk_from(rm, cx, cy, cz, s.0, s.1);
      if !n.0 { continue; }
      seen = false;
      for i in 0..len(qx) { if qx[i] == n.1 && qy[i] == n.2 && qz[i] == n.3 { seen = true; } }
      if !seen {
        qx += [n.1];
        qy += [n.2];
        qz += [n.3];
      }
    }
  }
  false
}

/// Does a walker who keeps one hand on the wall (`left`, else the right) come from (x, y, z),
/// setting out along (dx, dy), to (gx, gy, gz): at every tile it tries the way on its hand's side
/// first, then straight on, then the other side, then back.  A maze this answers true for is
/// walked through without a thought; bridges over other walkways, and paths that hang on no
/// wall, are what make it answer false (owner, 2026-11-16).
pub fn one_hand(rm: Room, x: integer, y: integer, z: integer, dx: integer, dy: integer,
                gx: integer, gy: integer, gz: integer, left: boolean) -> boolean {
  seen: vector<integer> = [];
  for _n in 0..16 * rm.w * rm.h * 4 {
    if x == gx && y == gy && z == gz { return true; }
    key = (((z + 8) * 64 + y) * 64 + x) * 4 + (if dx > 0 { 0 } else if dy < 0 { 1 } else if dx < 0 { 2 } else { 3 });
    if seen.contains(key) { return false; }
    seen += [key];
    // the hand's side, straight on, the other side, back (a tile's y runs south)
    hand = if left { (dy, -dx) } else { (-dy, dx) };
    moved = false;
    for s in [hand, (dx, dy), (-hand.0, -hand.1), (-dx, -dy)] {
      if moved { continue; }
      n = walk_from(rm, x, y, z, s.0, s.1);
      if !n.0 { continue; }
      moved = true;
      x = n.1;
      y = n.2;
      z = n.3;
      dx = s.0;
      dy = s.1;
    }
    if !moved { return false; }
  }
  false
}

// ── placing a room ──────────────────────────────────────────────────────────

/// Set the room down with its first tile's centre near (x, y) metres, moved by less than a hex so
/// the hex outside its first opening lies straight out, one tile's length away; mark the hexes
/// under it (number `id`); pair each opening with the ground outside it.
pub fn place_room(g: Ground, rm: Room, id: integer, x: float, y: float) {
  ops = openings_of(rm, rm.level);
  set_down(g, rm, id, x, y, ops);
}

/// Set down a window: a room that is a part of place `l`, kept elsewhere (a house in a town's own
/// map).  Its ways out are found in `l`; the room keeps no copy of it.
pub fn place_window(g: Ground, rm: Room, id: integer, x: float, y: float, l: const rules::Level) {
  ops = openings_of(rm, l);
  set_window(g, rm, id, x, y, ops);
}

/// The ways out of the room's rectangle as place `l` has them (a way may lead into another part
/// of the same building: who sets the window down chooses which lead onto the ground).
pub fn window_openings(rm: const Room, l: const rules::Level) -> vector<Opening> { openings_of(rm, l) }

/// Set a window down with the ways onto the ground given.
pub fn set_window(g: Ground, rm: Room, id: integer, x: float, y: float, ops: vector<Opening>) {
  rm.window = true;
  set_down(g, rm, id, x, y, ops);
}

/// Is the hex before the opening open ground: a figure can stand there, come in from it and go
/// out onto it — whether or not it lies straight out (`exact`, which a thing pushed needs).
pub fn before(g: Ground, o: const Opening) -> boolean {
  hex_field::label_get(g.under, o.q, o.r) < 0 && !hex_field::hexset_get(g.fixed, o.q, o.r)
}

fn set_down(g: Ground, rm: Room, id: integer, x: float, y: float, ops: vector<Opening>) {
  rm.ox = x;
  rm.oy = y;
  rm.openings = ops;
  if len(rm.openings) > 0 {
    o = rm.openings[0]!;
    d = tile_centre(rm, (o.x + o.dx) as float, (o.y + o.dy) as float);
    (hq, hr) = hexterrain::cell_near(d.0, d.1);
    c = hexterrain::centre(hq, hr);
    rm.ox += c.0 - d.0;
    rm.oy += c.1 - d.1;
  }
  q0 = hex_field::hexset_q0(g.fixed);
  r0 = hex_field::hexset_r0(g.fixed);
  for r in r0..r0 + hex_field::hexset_h(g.fixed) {
    for q in q0..q0 + hex_field::hexset_w(g.fixed) {
      c = hexterrain::centre(q, r);
      if tile_at(rm, c.0, c.1).0 { hex_field::label_set(g.under, q, r, id); }
    }
  }
  for i in 0..len(rm.openings) {
    o = rm.openings[i]!;
    o.heading = room_heading(rm, o.dx, o.dy);
    d = tile_centre(rm, (o.x + o.dx) as float, (o.y + o.dy) as float);
    (hq, hr) = hexterrain::cell_near(d.0, d.1);
    o.q = hq;
    o.r = hr;
    o.exact = apart(hexterrain::centre(hq, hr), d) < 0.001 && hex_field::label_get(g.under, hq, hr) < 0;
    // the nearest open hex either side of the way out
    (wx, wy) = way(o.heading);
    t = tile_centre(rm, o.x as float, o.y as float);
    left = -1.0;
    right = -1.0;
    for dr in -2..3 {
      for dq in -2..3 {
        cq = hq + dq;
        cr = hr + dr;
        if hex_field::label_get(g.under, cq, cr) >= 0 { continue; }
        c = hexterrain::centre(cq, cr);
        side = wx * (c.1 - t.1) - wy * (c.0 - t.0);
        ahead = wx * (c.0 - t.0) + wy * (c.1 - t.1);
        if ahead <= 0.0 { continue; }
        far = apart(c, d);
        if side > 0.001 && (left < 0.0 || far < left) {
          left = far;
          o.lq = cq;
          o.lr = cr;
        }
        if side < -0.001 && (right < 0.0 || far < right) {
          right = far;
          o.rq = cq;
          o.rr = cr;
        }
      }
    }
    rm.openings[i] = o;
  }
}

/// Stand a fence on the ground from (ax, ay) to (bx, by) metres: on every edge between two hexes
/// whose centres lie either side of that line, where the edge's middle is along the stretch.
pub fn fence(g: Ground, ax: float, ay: float, bx: float, by: float) -> integer {
  long = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay)) ?? 0.0;
  if long < 0.01 { return 0; }
  ux = (bx - ax) / long ?? 0.0;
  uy = (by - ay) / long ?? 0.0;
  q0 = hex_field::hexset_q0(g.fixed);
  r0 = hex_field::hexset_r0(g.fixed);
  n = 0;
  for r in r0..r0 + hex_field::hexset_h(g.fixed) {
    for q in q0..q0 + hex_field::hexset_w(g.fixed) {
      c = hexterrain::centre(q, r);
      side = (c.0 - ax) * uy - (c.1 - ay) * ux;
      if side < 0.0 || side > 1.6 { continue; }
      if (c.0 - ax) * ux + (c.1 - ay) * uy < -1.6 || (c.0 - ax) * ux + (c.1 - ay) * uy > long + 1.6 { continue; }
      for h in [0, 2, 4, 6, 8, 10] {
        (tq, tr) = hex_step(q, r, h);
        t = hexterrain::centre(tq, tr);
        if (t.0 - ax) * uy - (t.1 - ay) * ux >= 0.0 { continue; }
        along = ((c.0 + t.0) * 0.5 - ax) * ux + ((c.1 + t.1) * 0.5 - ay) * uy;
        if along < 0.0 || along > long { continue; }
        hex_field::edge_set_mat(g.fences, q, r, tq, tr, 1);
        n += 1;
      }
    }
  }
  n
}

// ── moving a thing ──────────────────────────────────────────────────────────

/// How a push came out.
pub const BLOCKED = 0;
/// One tile on inside the room, by the room's rules.
pub const INSIDE = 1;
/// To the hex the push aimed at.
pub const AHEAD = 2;
/// Into one of the two hexes it would have passed between.
pub const ASIDE = 3;
/// Out through an opening onto the ground.
pub const OUT = 4;
/// In through an opening onto its tile.
pub const IN = 5;

/// A push's outcome: how it came out, where the thing is now (a tile of the room when `room`,
/// else a hex), the heading it has there, how far it went and how long that takes.
pub struct Move {
  pub how: integer,
  pub room: boolean = false,
  pub x: integer = 0,
  pub y: integer = 0,
  pub q: integer = 0,
  pub r: integer = 0,
  pub heading: integer = 0,
  pub metres: float = 0.0,
  pub ms: integer = 0
}

/// May a thing come onto hex (q, r): open ground inside the window, holding nothing.
pub fn hex_free(g: Ground, q: integer, r: integer) -> boolean {
  q0 = hex_field::hexset_q0(g.fixed);
  r0 = hex_field::hexset_r0(g.fixed);
  if q < q0 || r < r0 || q >= q0 + hex_field::hexset_w(g.fixed) || r >= r0 + hex_field::hexset_h(g.fixed) { return false; }
  hex_field::label_get(g.under, q, r) < 0 && !hex_field::hexset_get(g.fixed, q, r) && hex_field::label_get(g.things, q, r) == 0
}

fn hex_move(g: Ground, q: integer, r: integer, tq: integer, tr: integer, how: integer, heading: integer) -> Move {
  thing = hex_field::label_get(g.things, q, r);
  hex_field::label_set(g.things, q, r, 0);
  hex_field::label_set(g.things, tq, tr, thing);
  far = apart(hexterrain::centre(q, r), hexterrain::centre(tq, tr));
  Move { how: how, q: tq, r: tr, heading: heading, metres: far, ms: ms_of(far) }
}

// A push on a layer over the room's own (a bridge, an upper floor): by the room's rules alone —
// what is pushed off an edge up there falls as the rules have it, inside the room.
fn push_up(rm: Room, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> Move {
  thing = tile_world::top(rm.level.w, x, y, z);
  rm.level.hero_x = x - dx;
  rm.level.hero_y = y - dy;
  rm.level.hero_z = z;
  rm.level.hero_h = 0;
  step = rules::walk(rm.level, dx, dy);
  if thing == 0 || step != rules::Step.Pushed { return Move { how: BLOCKED, room: true, x: x, y: y }; }
  Move { how: INSIDE, room: true, x: x + dx, y: y + dy, heading: room_heading(rm, dx, dy), metres: TILE, ms: ms_of(TILE) }
}

/// Push the thing on tile (x, y) of the room one step (dx, dy), `up` layers over the room's own
/// (0: on its floor).  On its floor, on through an opening, it goes out onto the ground; else the
/// room's own rules move it, the hero stepping after it.
pub fn push_in_room(g: Ground, rm: Room, x: integer, y: integer, dx: integer, dy: integer, up: integer = 0) -> Move {
  if up != 0 { return push_up(rm, x, y, rm.z + up, dx, dy); }
  thing = tile_world::top(rm.level.w, x, y, rm.z);
  if thing == 0 { return Move { how: BLOCKED, room: true, x: x, y: y }; }
  for o in rm.openings {
    if o.x != x || o.y != y || o.dx != dx || o.dy != dy { continue; }
    if !rules::movable(rm.level, thing) { return Move { how: BLOCKED, room: true, x: x, y: y }; }
    from = tile_centre(rm, x as float, y as float);
    // straight out where a hex lies there; else, or with that hex taken, aside
    tq = o.q;
    tr = o.r;
    how = OUT;
    if !o.exact || !hex_free(g, tq, tr) {
      how = BLOCKED;
      right_first = rules::prefers_right(x, y, rm.z);
      for pass in 0..2 {
        if how != BLOCKED { continue; }
        take_right = (pass == 0) == right_first;
        cq = if take_right { o.rq } else { o.lq };
        cr = if take_right { o.rr } else { o.lr };
        if (o.exact && cq == o.q && cr == o.r) || !hex_free(g, cq, cr) { continue; }
        tq = cq;
        tr = cr;
        how = ASIDE;
      }
      if how == BLOCKED { return Move { how: BLOCKED, room: true, x: x, y: y }; }
    }
    hex_field::label_set(g.things, tq, tr, tile_world::take(rm.level.w, x, y, rm.z));
    rm.level.hero_x = x;
    rm.level.hero_y = y;
    far = apart(from, hexterrain::centre(tq, tr));
    return Move { how: how, q: tq, r: tr, heading: o.heading, metres: far, ms: ms_of(far) };
  }
  rm.level.hero_x = x - dx;
  rm.level.hero_y = y - dy;
  rm.level.hero_z = rm.z;
  step = rules::walk(rm.level, dx, dy);
  if step != rules::Step.Pushed || tile_world::top(rm.level.w, x + dx, y + dy, rm.z) != thing {
    return Move { how: BLOCKED, room: true, x: x, y: y };
  }
  Move { how: INSIDE, room: true, x: x + dx, y: y + dy, heading: room_heading(rm, dx, dy), metres: TILE, ms: ms_of(TILE) }
}

/// Push the thing on hex (q, r) along heading `h` of the twelve.
///
/// An even heading: to the neighbour, when it is free and no fence stands between.  An odd one:
/// between two hexes through to the next full hex, when that is free and no fence stands on the
/// edge it runs along; else aside into one of the two, the side the place prefers first.  Into a
/// room only from the hex outside an opening, straight in, onto the opening's tile.
pub fn push_on_ground(g: Ground, rm: Room, q: integer, r: integer, h: integer) -> Move {
  h = hex_form::head_norm(h);
  if hex_field::label_get(g.things, q, r) == 0 { return Move { how: BLOCKED, q: q, r: r }; }
  // in through an opening
  for o in rm.openings {
    if !o.exact || o.q != q || o.r != r || hex_form::head_norm(o.heading + 6) != h { continue; }
    k = tile_world::terrain(rm.level.w, o.x, o.y, rm.z);
    if !rules::walkable(rm.level, k) || tile_world::top(rm.level.w, o.x, o.y, rm.z) != 0 { return Move { how: BLOCKED, q: q, r: r }; }
    tile_world::place(rm.level.w, o.x, o.y, rm.z, hex_field::label_get(g.things, q, r));
    hex_field::label_set(g.things, q, r, 0);
    far = apart(hexterrain::centre(q, r), tile_centre(rm, o.x as float, o.y as float));
    return Move { how: IN, room: true, x: o.x, y: o.y, heading: h, metres: far, ms: ms_of(far) };
  }
  if (h & 1) == 0 {
    (tq, tr) = hex_step(q, r, h);
    if !hex_free(g, tq, tr) || hex_field::edge_mat(g.fences, q, r, tq, tr) != 0 { return Move { how: BLOCKED, q: q, r: r }; }
    return hex_move(g, q, r, tq, tr, AHEAD, h);
  }
  (aq, ar) = hex_step(q, r, h);
  (lq, lr) = hex_step(q, r, h + 1);
  (rq, rr) = hex_step(q, r, h - 1);
  if hex_free(g, aq, ar) && hex_field::edge_mat(g.fences, lq, lr, rq, rr) == 0 { return hex_move(g, q, r, aq, ar, AHEAD, h); }
  right_first = rules::prefers_right(q, r, 0);
  for pass in 0..2 {
    take_right = (pass == 0) == right_first;
    cq = if take_right { rq } else { lq };
    cr = if take_right { rr } else { lr };
    if hex_free(g, cq, cr) && hex_field::edge_mat(g.fences, q, r, cq, cr) == 0 {
      return hex_move(g, q, r, cq, cr, ASIDE, if take_right { hex_form::head_norm(h - 1) } else { hex_form::head_norm(h + 1) });
    }
  }
  Move { how: BLOCKED, q: q, r: r }
}
