// The world editor's core (EDITOR.md § 4): a cursor on a layer, a palette, and the edits —
// paint, stack, erase, the start and goal markers — each kept in a log that undo walks back
// and redo forward.  It edits a level file's level and nothing else: no picture, no keys
// (game.loft draws it and maps the keys to these calls), so a test can drive every action.
//
// The palette is "void" (a pit, void set on purpose), then the terrain kinds of kinds.json
// (painted with their own look), then theme.json's materials (EDITOR.md § 1: a kind with a
// look, autotiled where it is a set), then the things.  Painting or erasing a cell retiles its
// neighbours — a path's pieces follow the cells round it — so an edit is every cell it
// changed, and undo puts all of them back.
use tile_world;
use rules;
use levels;
use materials;
use intent;

/// A palette entry: terrain kind `id` (0 is void), material `material` (when 0 or more, with
/// its name in `label`), or thing `id`.
pub struct Entry {
  pub thing: boolean,
  pub id: integer,
  pub material: integer,
  pub label: text,
  /// A painted piece (a junction): the kind with this picture (its tile number); 0 for none.
  pub tile: integer
}

// What one cell holds: whether it is set (else it reads as its layer's ground), its kind and
// tile, its stack, bottom first, and its rise (a slope's step).
struct Cell {
  set: boolean,
  kind: integer,
  tile: integer,
  stack: vector<integer>,
  rise: integer
}

// A start or a goal: the goal's kind ("layer", "cell", ...) and its cell.
struct Marker {
  kind: text,
  x: integer,
  y: integer,
  z: integer
}

// What an edit changed.
const CELL = 0;
const START = 1;
const GOAL = 2;

// One cell an edit changed: it was `was` and is `now`.
struct Change {
  x: integer,
  y: integer,
  z: integer,
  was: Cell,
  now: Cell
}

// One edit at (x, y, z): the cells it changed, or a marker that was `was_at` and is `now_at`.
struct Edit {
  what: integer,
  x: integer,
  y: integer,
  z: integer,
  cells: vector<Change>,
  was_at: Marker,
  now_at: Marker,
  /// Made by hand, not filled in from the intent: the cells it changed are adjustments.
  hand: boolean = true
}

pub struct Editor {
  /// The cursor's cell and layer.
  pub x: integer,
  pub y: integer,
  pub z: integer,
  /// The palette, and which entry paints.
  pub palette: vector<Entry>,
  pub pick: integer,
  /// The materials it paints with (theme.json's), to retile what an edit touches.
  pub mats: materials::Materials,
  log: vector<Edit>,
  /// How many of the log's edits are applied: undo steps back, redo forward, and a new edit
  /// drops the ones undone.
  done: integer,
  /// Cells whose adjustment was taken away (`unadjust`), until a hand edit touches them again.
  released: vector<integer> = [],
  /// A corner marked with R: a rectangle, a copy, runs from it to the cursor.
  pub marked: boolean,
  pub mark_x: integer,
  pub mark_y: integer,
  /// What C copied (a `tile_world` stamp) and its size, for V.
  clip: tile_world::World,
  pub has_clip: boolean,
  clip_w: integer,
  clip_h: integer
}

/// How many cells a fill paints at most: a layer's open ground has no end.
pub const FILL_LIMIT = 4096;

fn kind_entry(id: integer) -> Entry {
  Entry { thing: false, id: id, material: -1, label: "", tile: 0 }
}

/// The palette of kinds `k` and materials `mats`: void, the terrain kinds, the materials, the
/// junctions, then the things.
pub fn palette(k: const rules::Kinds, mats: const materials::Materials) -> vector<Entry> {
  out: vector<Entry> = [kind_entry(tile_world::VOID)];
  for id in rules::terrain_ids(k) { out += [kind_entry(id)]; }
  for i in 0..len(mats.list) {
    mat = mats.list[i] ?? materials::none_material();
    out += [Entry { thing: false, id: mat.kind, material: i, label: mat.name, tile: 0 }];
  }
  // The junctions, each as it is drawn set straight: "junction 1" .. in theme.json's order.
  rail = rules::terrain_id(k, "rail");
  n = 0;
  for t in mats.track {
    if t.toe != 0 && !t.set_turn {
      n += 1;
      out += [Entry { thing: false, id: rail, material: -1, label: "junction {n}", tile: t.tile }];
    }
  }
  for id in rules::thing_ids(k) { out += [Entry { thing: true, id: id, material: -1, label: "", tile: 0 }]; }
  out
}

/// An editor on `lf` with no materials.
pub fn new_editor(lf: const levels::LevelFile) -> Editor {
  new_editor_with(lf, materials::none())
}

/// An editor on `lf` painting with `mats` too, its cursor on the hero's start and its palette
/// on the first terrain kind.
pub fn new_editor_with(lf: const levels::LevelFile, mats: const materials::Materials) -> Editor {
  p = palette(lf.level.k, mats);
  pick = if len(p) > 1 { 1 } else { 0 };
  Editor {
    x: lf.start_x, y: lf.start_y, z: lf.start_z, palette: p, pick: pick, mats: mats, log: [],
    done: 0, marked: false, mark_x: 0, mark_y: 0, clip: tile_world::world(), has_clip: false,
    clip_w: 0, clip_h: 0
  }
}

/// The entry that paints.
pub fn picked(ed: const Editor) -> Entry {
  ed.palette[ed.pick] ?? kind_entry(tile_world::VOID)
}

/// An entry's name, as kinds.json or theme.json has it; "void" for void.
pub fn name(k: const rules::Kinds, e: const Entry) -> text {
  if e.thing { return rules::thing_name(k, e.id); }
  if e.material >= 0 || e.tile != 0 { return e.label; }
  if e.id == tile_world::VOID { return "void"; }
  rules::terrain_name(k, e.id)
}

/// Pick the first entry of category `n` (from 1, theme.json's order) the palette has.  False
/// when there is no such category, or the palette has none of its entries.
pub fn jump(ed: Editor, k: const rules::Kinds, n: integer) -> boolean {
  if n < 1 { return false; }
  cat = ed.mats.categories[n - 1];
  if !cat { return false; }
  for want in cat.entries {
    for i in 0..len(ed.palette) {
      if name(k, ed.palette[i] ?? kind_entry(0)) == want {
        ed.pick = i;
        return true;
      }
    }
  }
  false
}

/// Move the cursor; the world has no edge, so neither has the cursor.
pub fn move(ed: Editor, dx: integer, dy: integer) {
  ed.x += dx;
  ed.y += dy;
}

/// The cursor a layer up (`dz` 1) or down (-1).
pub fn layer(ed: Editor, dz: integer) {
  ed.z += dz;
}

/// The next palette entry (`step` 1) or the previous (-1), round the end.
pub fn choose(ed: Editor, step: integer) {
  n = len(ed.palette);
  if n == 0 { return; }
  ed.pick = ((ed.pick + step) % n + n) % n ?? 0;
}

fn cell_of(w: const tile_world::World, x: integer, y: integer, z: integer) -> Cell {
  Cell {
    set: tile_world::is_set(w, x, y, z), kind: tile_world::terrain(w, x, y, z),
    tile: tile_world::tile(w, x, y, z), stack: tile_world::things(w, x, y, z),
    rise: tile_world::rise(w, x, y, z)
  }
}

fn put_cell(w: tile_world::World, x: integer, y: integer, z: integer, c: const Cell) {
  if c.set {
    tile_world::set_terrain(w, x, y, z, c.kind, c.tile);
  } else {
    tile_world::clear(w, x, y, z);
  }
  while tile_world::top(w, x, y, z) != 0 { _ = tile_world::take(w, x, y, z); }
  for t in c.stack { tile_world::place(w, x, y, z, t); }
  if c.set { tile_world::set_rise(w, x, y, z, c.rise); }
}

fn no_marker() -> Marker {
  Marker { kind: "", x: 0, y: 0, z: 0 }
}

fn no_cell() -> Cell {
  Cell { set: false, kind: 0, tile: 0, stack: [], rise: 0 }
}

// Keep edit `e` as the newest, dropping what was undone.
fn keep(ed: Editor, e: const Edit) {
  if ed.done < len(ed.log) { ed.log = ed.log[0..ed.done]; }
  ed.log += [e];
  ed.done += 1;
  if e.hand {
    for c in e.cells {
      k = intent::key_of(c.x, c.y, c.z);
      if ed.released.contains(k) {
        kept: vector<integer> = [];
        for r in ed.released { if r != k { kept += [r]; } }
        ed.released = kept;
      }
    }
  }
}

// Did a change set the cell itself — its kind, its things, its height — rather than only retile
// its picture beside a neighbour's edit?
fn sets_cell(c: const Change) -> boolean {
  c.was.set != c.now.set || c.was.kind != c.now.kind || c.was.stack != c.now.stack || c.was.rise != c.now.rise
}

/// The cells set by hand: the level file's, and every cell an applied hand edit set since —
/// undoing the edit undoes the adjustment — but for those `unadjust` released.
pub fn adjusted(ed: const Editor, lf: const levels::LevelFile) -> vector<integer> {
  out: vector<integer> = [];
  for k in lf.adjusted { if !ed.released.contains(k) { out += [k]; } }
  for i in 0..ed.done {
    e = ed.log[i] ?? continue;
    if !e.hand || e.what != CELL { continue; }
    for c in e.cells {
      if !sets_cell(c) { continue; }
      k = intent::key_of(c.x, c.y, c.z);
      if !out.contains(k) && !ed.released.contains(k) { out += [k]; }
    }
  }
  out
}

/// Take the adjustment of cell (x, y, z) away: the next `refill` gives it what the intent
/// derives.
pub fn unadjust(ed: Editor, lf: levels::LevelFile, x: integer, y: integer, z: integer) {
  k = intent::key_of(x, y, z);
  kept: vector<integer> = [];
  for a in lf.adjusted { if a != k { kept += [a]; } }
  lf.adjusted = kept;
  if !ed.released.contains(k) { ed.released += [k]; }
}

/// Fill the place in from its intent again: each cell the intent implies is set to what it
/// derives (its kind, and the thing scattered on it or none), but for the cells set by hand,
/// which keep what they are.  A cell already so is left as it is, its picture included.  One
/// edit, undone as one; false when nothing changed.
pub fn refill(ed: Editor, lf: levels::LevelFile, words: const vector<intent::Word>) -> boolean {
  k = lf.level.k;
  w = lf.level.w;
  hand = adjusted(ed, lf);
  // The hand-set cells as they are, for the scattering to work round.
  held: vector<intent::Fill> = [];
  for h in hand {
    x = intent::x_of(h);
    y = intent::y_of(h);
    z = intent::z_of(h);
    c = cell_of(w, x, y, z);
    top = if len(c.stack) > 0 { rules::thing_name(k, c.stack[0] ?? 0) } else { "" };
    held += [intent::Fill { key: h, x: x, y: y, z: z, terrain: if c.set { rules::terrain_name(k, c.kind) } else { "" }, thing: top }];
  }
  // What to set: each derived cell whose terrain, things or rise differ.  A terrain may name a
  // material (grass, roof, …): painted as the editor paints one, its neighbours retiled.
  todo: vector<intent::Fill> = [];
  for f in intent::derive(lf.intent, words, held) {
    if hand.contains(f.key) { continue; }
    was = cell_of(w, f.x, f.y, f.z);
    mi = materials::named(ed.mats, f.terrain);
    kind = if mi >= 0 { (ed.mats.list[mi] ?? materials::none_material()).kind } else { rules::terrain_id(k, f.terrain) };
    stack: vector<integer> = [];
    if f.thing != "" { stack += [rules::thing_id(k, f.thing)]; }
    for t in f.more { stack += [rules::thing_id(k, t)]; }
    same_terrain = if mi >= 0 { materials::at(ed.mats, w, f.x, f.y, f.z) == mi } else { was.kind == kind && was.tile == 0 };
    rise = if f.rise >= 0 { f.rise } else { was.rise };
    if was.set && same_terrain && was.stack == stack && was.rise == rise { continue; }
    todo += [f];
  }
  if len(todo) == 0 { return false; }
  // Every cell the fill can change — its cells and, for a material, the ring round each — as it
  // was, so undo takes the whole fill back.
  spots: vector<integer> = [];
  for f in todo {
    for dy in -1..=1 {
      for dx in -1..=1 {
        sk = intent::key_of(f.x + dx, f.y + dy, f.z);
        if !spots.contains(sk) { spots += [sk]; }
      }
    }
  }
  before: vector<Cell> = [];
  for sk in spots { before += [cell_of(w, intent::x_of(sk), intent::y_of(sk), intent::z_of(sk))]; }
  // Kinds and things first, then the materials' pictures, which follow their neighbours.
  for f in todo {
    was = cell_of(w, f.x, f.y, f.z);
    mi = materials::named(ed.mats, f.terrain);
    kind = if mi >= 0 { (ed.mats.list[mi] ?? materials::none_material()).kind } else { rules::terrain_id(k, f.terrain) };
    stack: vector<integer> = [];
    if f.thing != "" { stack += [rules::thing_id(k, f.thing)]; }
    for t in f.more { stack += [rules::thing_id(k, t)]; }
    put_cell(w, f.x, f.y, f.z, Cell { set: true, kind: kind, tile: 0, stack: stack,
                                     rise: if f.rise >= 0 { f.rise } else { was.rise } });
  }
  for f in todo {
    mi = materials::named(ed.mats, f.terrain);
    if mi >= 0 { materials::paint(ed.mats, w, mi, f.x, f.y, f.z); } else { materials::retile(ed.mats, w, f.x, f.y, f.z); }
  }
  changes: vector<Change> = [];
  for i in 0..len(spots) {
    sk = spots[i] ?? continue;
    x = intent::x_of(sk);
    y = intent::y_of(sk);
    z = intent::z_of(sk);
    was = before[i] ?? no_cell();
    now = cell_of(w, x, y, z);
    if was != now { changes += [Change { x: x, y: y, z: z, was: was, now: now }]; }
  }
  if len(changes) == 0 { return false; }
  keep(ed, Edit {
    what: CELL, x: ed.x, y: ed.y, z: ed.z, cells: changes, was_at: no_marker(), now_at: no_marker(), hand: false
  });
  true
}

struct Spot {
  const sx: integer,
  const sy: integer
}

// The cells (x0..x1, y0..y1) of a layer and the ring round them: what painting them can change,
// their neighbours' autotile pieces included.
fn box_spots(x0: integer, y0: integer, x1: integer, y1: integer) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  for y in y0 - 1..=y1 + 1 {
    for x in x0 - 1..=x1 + 1 { out += [(x, y)]; }
  }
  out
}

// What `spots` of layer z hold now.
fn snapshot(w: const tile_world::World, z: integer, spots: const vector<(integer, integer)>) -> vector<Cell> {
  out: vector<Cell> = [];
  for p in spots { out += [cell_of(w, p.0, p.1, z)]; }
  out
}

// Log the `spots` of the cursor's layer that changed from `before` (their `snapshot`) as one
// edit at the cursor.  False when none changed.
fn logged_spots(ed: Editor, w: const tile_world::World, spots: const vector<(integer, integer)>,
                before: const vector<Cell>) -> boolean {
  changes: vector<Change> = [];
  for i in 0..len(spots) {
    p = spots[i] ?? (0, 0);
    was = before[i] ?? no_cell();
    now = cell_of(w, p.0, p.1, ed.z);
    if was != now { changes += [Change { x: p.0, y: p.1, z: ed.z, was: was, now: now }]; }
  }
  if len(changes) == 0 { return false; }
  keep(ed, Edit {
    what: CELL, x: ed.x, y: ed.y, z: ed.z, cells: changes, was_at: no_marker(), now_at: no_marker()
  });
  true
}

// Put entry `e` on (x, y) of the cursor's layer, the neighbours retiled: a thing on top of the
// stack, a material with its tile, a kind with its own look.
fn put_entry(ed: const Editor, w: tile_world::World, e: const Entry, x: integer, y: integer) {
  if e.thing {
    tile_world::place(w, x, y, ed.z, e.id);
  } else if e.material >= 0 {
    materials::paint(ed.mats, w, e.material, x, y, ed.z);
  } else {
    tile_world::set_terrain(w, x, y, ed.z, e.id);
    materials::retile(ed.mats, w, x, y, ed.z);
  }
}

// The marked box, corners sorted: from the mark to the cursor, or the cursor's cell alone.
fn marked_box(ed: const Editor) -> (integer, integer, integer, integer) {
  if !ed.marked { return (ed.x, ed.y, ed.x, ed.y); }
  (if ed.mark_x < ed.x { ed.mark_x } else { ed.x }, if ed.mark_y < ed.y { ed.mark_y } else { ed.y },
   if ed.mark_x > ed.x { ed.mark_x } else { ed.x }, if ed.mark_y > ed.y { ed.mark_y } else { ed.y })
}

/// Mark the cursor's cell as a corner (R): the next rectangle or copy runs from it.
pub fn set_mark(ed: Editor) {
  ed.marked = true;
  ed.mark_x = ed.x;
  ed.mark_y = ed.y;
}

/// Paint the picked entry over the marked box, as one edit, and drop the mark.  False when
/// nothing changed.
pub fn paint_box(ed: Editor, lf: levels::LevelFile) -> boolean {
  b = marked_box(ed);
  ed.marked = false;
  w = lf.level.w;
  spots = box_spots(b.0, b.1, b.2, b.3);
  before = snapshot(w, ed.z, spots);
  e = picked(ed);
  for y in b.1..=b.3 {
    for x in b.0..=b.2 { put_entry(ed, w, e, x, y); }
  }
  logged_spots(ed, w, spots, before)
}

/// Fill (F): paint the picked terrain or material over the region under the cursor — the
/// connected cells of the same kind and tile, at most FILL_LIMIT — as one edit.  A thing is not
/// filled.  False when nothing changed.
pub fn fill(ed: Editor, lf: levels::LevelFile) -> boolean {
  e = picked(ed);
  if e.thing { return false; }
  w = lf.level.w;
  cells = tile_world::region(w, ed.x, ed.y, ed.z, FILL_LIMIT);
  seen: hash<Spot[sx, sy]> = [];
  spots: vector<(integer, integer)> = [];
  for c in cells {
    for dy in -1..=1 {
      for dx in -1..=1 {
        if !seen[c.0 + dx, c.1 + dy] {
          seen += [Spot { sx: c.0 + dx, sy: c.1 + dy }];
          spots += [(c.0 + dx, c.1 + dy)];
        }
      }
    }
  }
  before = snapshot(w, ed.z, spots);
  for c in cells { put_entry(ed, w, e, c.0, c.1); }
  logged_spots(ed, w, spots, before)
}

/// The entry for what is under the cursor (I): the top thing, else the cell's material, else
/// its kind.  False when the palette has none for it.
pub fn pick_under(ed: Editor, lf: const levels::LevelFile) -> boolean {
  w = lf.level.w;
  t = tile_world::top(w, ed.x, ed.y, ed.z);
  mi = materials::at(ed.mats, w, ed.x, ed.y, ed.z);
  kind = tile_world::terrain(w, ed.x, ed.y, ed.z);
  for i in 0..len(ed.palette) {
    e = ed.palette[i] ?? kind_entry(0);
    hit = if t != 0 { e.thing && e.id == t } else if mi >= 0 { e.material == mi }
          else { !e.thing && e.material < 0 && e.id == kind };
    if hit {
      ed.pick = i;
      return true;
    }
  }
  false
}

/// Copy the marked box (C) — or the cursor's cell — with its stacks, rises and edges, and drop
/// the mark.
pub fn copy_box(ed: Editor, lf: const levels::LevelFile) {
  b = marked_box(ed);
  ed.marked = false;
  ed.clip = tile_world::copy(lf.level.w, b.0, b.1, b.2, b.3, ed.z, ed.z);
  ed.has_clip = true;
  ed.clip_w = b.2 - b.0 + 1;
  ed.clip_h = b.3 - b.1 + 1;
}

/// Paste what C copied with its corner at the cursor (V), as one edit.  False when nothing was
/// copied or nothing changed.
pub fn paste_box(ed: Editor, lf: levels::LevelFile) -> boolean {
  if !ed.has_clip { return false; }
  w = lf.level.w;
  spots = box_spots(ed.x, ed.y, ed.x + ed.clip_w - 1, ed.y + ed.clip_h - 1);
  before = snapshot(w, ed.z, spots);
  tile_world::paste(w, ed.clip, ed.x, ed.y, ed.z);
  for y in ed.y..ed.y + ed.clip_h {
    for x in ed.x..ed.x + ed.clip_w { materials::retile(ed.mats, w, x, y, ed.z); }
  }
  logged_spots(ed, w, spots, before)
}

// The 3x3 cells round the cursor, row by row: everything an edit there can change.
fn around(ed: const Editor, w: const tile_world::World) -> vector<Cell> {
  out: vector<Cell> = [];
  for dy in -1..=1 {
    for dx in -1..=1 { out += [cell_of(w, ed.x + dx, ed.y + dy, ed.z)]; }
  }
  out
}

// Log the cells round the cursor that changed from `before` (`around`, taken before the edit);
// the cursor's own cell first, so undo and redo put the cursor back on it.  False when none
// changed.
fn logged(ed: Editor, lf: const levels::LevelFile, before: const vector<Cell>) -> boolean {
  after = around(ed, lf.level.w);
  changes: vector<Change> = [];
  for at in [4, 0, 1, 2, 3, 5, 6, 7, 8] {
    was = before[at] ?? no_cell();
    now = after[at] ?? no_cell();
    if was != now {
      changes += [Change {
        x: ed.x + (at % 3 ?? 0) - 1, y: ed.y + (at / 3 ?? 0) - 1, z: ed.z, was: was, now: now
      }];
    }
  }
  if len(changes) == 0 { return false; }
  keep(ed, Edit {
    what: CELL, x: ed.x, y: ed.y, z: ed.z, cells: changes, was_at: no_marker(), now_at: no_marker()
  });
  true
}

/// Paint the picked entry at the cursor: a terrain kind replaces the cell's terrain (its tile
/// back to the kind's own), a material sets its kind and the tile it shows there, a thing goes
/// on top of the cell's stack.  The neighbours are retiled.  False when nothing changed.
pub fn paint(ed: Editor, lf: levels::LevelFile) -> boolean {
  w = lf.level.w;
  before = around(ed, w);
  e = picked(ed);
  if e.thing {
    tile_world::place(w, ed.x, ed.y, ed.z, e.id);
  } else if e.tile != 0 {
    tile_world::set_terrain(w, ed.x, ed.y, ed.z, e.id, e.tile);
  } else if e.material >= 0 {
    materials::paint(ed.mats, w, e.material, ed.x, ed.y, ed.z);
  } else {
    tile_world::set_terrain(w, ed.x, ed.y, ed.z, e.id);
    materials::retile(ed.mats, w, ed.x, ed.y, ed.z);
  }
  logged(ed, lf, before)
}

/// Raise the cursor's cell a step (`step` 1) or lower it (-1): a slope.  Its rise stays within the
/// layer (0 .. layer_height - 1: a step higher is the layer above).  False when nothing changed —
/// already at the top or the bottom, or the cell is not set.
pub fn raise(ed: Editor, lf: levels::LevelFile, step: integer) -> boolean {
  w = lf.level.w;
  if !tile_world::is_set(w, ed.x, ed.y, ed.z) { return false; }
  r = tile_world::rise(w, ed.x, ed.y, ed.z) + step;
  if r < 0 || r >= lf.level.k.layer_height { return false; }
  before = around(ed, w);
  tile_world::set_rise(w, ed.x, ed.y, ed.z, r);
  logged(ed, lf, before)
}

/// Take the top thing off the cursor's cell; on a cell with no things, unset its terrain, so
/// it reads as its layer's ground again (void when the layer has none), and retile the
/// neighbours.  False when nothing changed.
pub fn erase(ed: Editor, lf: levels::LevelFile) -> boolean {
  w = lf.level.w;
  before = around(ed, w);
  if tile_world::top(w, ed.x, ed.y, ed.z) != 0 {
    _ = tile_world::take(w, ed.x, ed.y, ed.z);
  } else {
    tile_world::clear(w, ed.x, ed.y, ed.z);
    materials::retile(ed.mats, w, ed.x, ed.y, ed.z);
  }
  logged(ed, lf, before)
}

fn put_start(lf: levels::LevelFile, m: const Marker) {
  lf.start_x = m.x;
  lf.start_y = m.y;
  lf.start_z = m.z;
  rules::put_hero(lf.level, m.x, m.y, m.z);
}

fn put_goal(lf: levels::LevelFile, m: const Marker) {
  lf.goal.kind = m.kind;
  lf.goal.x = m.x;
  lf.goal.y = m.y;
  lf.goal.z = m.z;
}

fn mark(ed: Editor, what: integer, was: const Marker, now: const Marker) -> boolean {
  if was == now { return false; }
  keep(ed, Edit {
    what: what, x: now.x, y: now.y, z: now.z, cells: [], was_at: was, now_at: now
  });
  true
}

/// The hero starts at the cursor.  False when it already did.
pub fn set_start(ed: Editor, lf: levels::LevelFile) -> boolean {
  was = Marker { kind: "start", x: lf.start_x, y: lf.start_y, z: lf.start_z };
  now = Marker { kind: "start", x: ed.x, y: ed.y, z: ed.z };
  put_start(lf, now);
  mark(ed, START, was, now)
}

/// The level is solved at the cursor's cell (a "cell" goal).  False when it already was.
pub fn set_goal(ed: Editor, lf: levels::LevelFile) -> boolean {
  g = lf.goal;
  was = Marker { kind: g.kind, x: g.x, y: g.y, z: g.z };
  now = Marker { kind: "cell", x: ed.x, y: ed.y, z: ed.z };
  put_goal(lf, now);
  mark(ed, GOAL, was, now)
}

// Put edit `e`'s side `after` (true: what it made, false: what it found) into `lf`, and the
// cursor on the place it changed.
fn apply(ed: Editor, lf: levels::LevelFile, e: const Edit, after: boolean) {
  if e.what == CELL {
    for c in e.cells { put_cell(lf.level.w, c.x, c.y, c.z, if after { c.now } else { c.was }); }
  } else if e.what == START {
    put_start(lf, if after { e.now_at } else { e.was_at });
  } else {
    put_goal(lf, if after { e.now_at } else { e.was_at });
  }
  m = if after { e.now_at } else { e.was_at };
  if e.what == CELL {
    ed.x = e.x;
    ed.y = e.y;
    ed.z = e.z;
  } else if m.kind == "start" || m.kind == "cell" {
    ed.x = m.x;
    ed.y = m.y;
    ed.z = m.z;
  }
}

/// Step the last applied edit back.  False when there is none.
pub fn undo(ed: Editor, lf: levels::LevelFile) -> boolean {
  if ed.done == 0 { return false; }
  e = ed.log[ed.done - 1];
  if !e { return false; }
  ed.done -= 1;
  apply(ed, lf, e, false);
  true
}

/// Apply the last undone edit again.  False when there is none.
pub fn redo(ed: Editor, lf: levels::LevelFile) -> boolean {
  if ed.done >= len(ed.log) { return false; }
  e = ed.log[ed.done];
  if !e { return false; }
  apply(ed, lf, e, true);
  ed.done += 1;
  true
}

/// How many edits undo can step back.
pub fn undoable(ed: const Editor) -> integer {
  ed.done
}

// --- The checks a level designer asks (EDITOR.md § 5) ---

/// How far the checks search: a path of at most this many steps, a chest seen from a walkable
/// cell at most this many cells away.
pub const CHECK_STEPS = 128;
pub const SIGHT = 8;

/// What the checks found.  A path search ignores what pushing could change, so these are hints,
/// never proof: a level's solution test stays the proof.
pub struct Report {
  /// A "cell" goal on the start's layer: whether it was searched, and the path (empty: the
  /// goal cannot be reached).
  pub searched: boolean,
  pub path: vector<(integer, integer)>,
  /// The closed chests on the start's layer no walk from the start reaches, and those no
  /// walkable cell within SIGHT can see (DESIGN.md: a chest is never hidden).
  pub cut_off: vector<(integer, integer, integer)>,
  pub hidden: vector<(integer, integer, integer)>
}

// Can a walkable cell within SIGHT of the chest at (x, y, z) see it?
fn seen(w: const tile_world::World, x: integer, y: integer, z: integer) -> boolean {
  for dy in -SIGHT..=SIGHT {
    for dx in -SIGHT..=SIGHT {
      if (dx != 0 || dy != 0) && tile_world::passable(w, x + dx, y + dy, z)
          && tile_world::line_of_sight(w, x + dx, y + dy, x, y, z) {
        return true;
      }
    }
  }
  false
}

/// The checks of level `lf` as it is now: the way from the start to a cell goal, and the
/// chests cut off or hidden.
pub fn check(lf: const levels::LevelFile) -> Report {
  l = lf.level;
  w = l.w;
  r = Report { searched: false, path: [], cut_off: [], hidden: [] };
  g = lf.goal;
  if g.kind == "cell" && g.z == lf.start_z {
    r.searched = true;
    r.path = tile_world::shortest_path(w, lf.start_x, lf.start_y, g.x, g.y, g.z, CHECK_STEPS);
  }
  for c in rules::closed_at(l) {
    if c.2 == lf.start_z && len(tile_world::shortest_path(w, lf.start_x, lf.start_y, c.0, c.1, c.2, CHECK_STEPS)) == 0 {
      r.cut_off += [c];
    }
    if !seen(w, c.0, c.1, c.2) { r.hidden += [c]; }
  }
  r
}
