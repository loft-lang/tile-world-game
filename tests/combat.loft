// Combat (DESIGN.md @GM-Combat; the owner: dynamic in place, as in Dark Souls; the numbers proposed,
// to tune in play).  An enemy's blow is a wind-up (a rat 300 ms, a cyclops 700) aimed at the hero's
// cell, landing there when it ends: the hero gone is missed.  Standing still trades blows; a dodge,
// a block, a parry, a lunge or a blow on its side while it winds up does better.  Every time below is
// worked by hand; the world clock steps from due time to due time, so the same moments every run.
use tile_world;
use rules;

// An open room x 0 .. 6, y 0 .. 4; the hero on (2, 2) facing east, holding `held` ("" nothing).
fn room(held: text) -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, 7, 5, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 6, 4, 0, rules::tr(w, "floor"));
  rules::put_hero(w, 2, 2, 0);
  w.face_x = 1;
  w.face_y = 0;
  if held != "" { w.hero_item = rules::th(w, held); }
  w
}

// An enemy of `kind` on (x, y) facing west (towards the hero), acting first at `due`.
fn foe(w: rules::Level, kind: text, x: integer, y: integer, due: integer) -> integer {
  _ = rules::add_enemy(w, kind, x, y, 0);
  i = len(w.enemies) - 1;
  w.enemies[i].due = due;
  w.enemies[i].face_x = -1;
  w.enemies[i].face_y = 0;
  i
}

fn hp(w: const rules::Level, i: integer) -> integer {
  e = w.enemies[i];
  if !e { return 0; }
  e.hp
}

fn until(w: rules::Level, at: integer) {
  rules::tick(w, at - w.now);
}

fn main() {
  w = room("sword");
  r = foe(w, "rat", 3, 2, 0);
  until(w, 0);
  assert((w.enemies[r]!.wind_until) == 300 && len(rules::aimed(w, r)) == 1, "a rat winds up at 0, to strike at 300");
}

// Standing still trades blows: the rat winds up at 0; the hero's sword lands at once (2 of its 3),
// but a light blow does not break the wind-up, so the bite lands at 300 as well.  A pure attacker is
// not left unscratched.
fn test_standing_still_trades_blows() {
  w = room("sword");
  r = foe(w, "rat", 3, 2, 0);
  until(w, 0);
  assert(rules::swing(w) == rules::Step.Attacked && hp(w, r) == 1, "the hero's blow: {hp(w, r)}");
  until(w, 299);
  assert(w.health == 6, "299: not yet");
  until(w, 300);
  assert(w.health == 5, "300: the rat's bite lands too: {w.health}");
}

// A dodge: the bite aimed at (2, 2) lands at 300 on an empty cell — the hero side-stepped to (2, 3)
// at 100, still facing east (the stance).  Then, at 150, a step east to (3, 3) puts the hero at the
// rat's side (it faces west, at the cell it aimed at); walking north into it at 200 is a blow on its
// side while it winds up: the sword's 2 + 1 = 3, its 3 health gone.
fn test_a_dodge_and_a_blow_on_its_side() {
  w = room("sword");
  r = foe(w, "rat", 3, 2, 0);
  until(w, 100);
  assert(rules::walk(w, 0, 1) == rules::Step.Walked && w.face_x == 1 && w.face_y == 0, "side-stepped, still facing east");
  until(w, 150);
  _ = rules::walk(w, 1, 0);
  until(w, 200);
  assert(rules::walk(w, 0, -1) == rules::Step.Attacked && len(w.enemies) == 0, "a blow on its side ends it: {hp(w, r)}");
  until(w, 400);
  assert(w.health == 6 && w.killed == 1, "unhurt: {w.health}");
}

// A missed dodge: still on the cell aimed at when the wind-up ends, the hero is bitten.
fn test_staying_on_the_aimed_cell_is_a_bite() {
  w = room("");
  _ = foe(w, "rat", 3, 2, 0);
  until(w, 300);
  assert(w.health == 5 && w.misses == 0, "bitten: {w.health}");
}

// A block halves: a cyclops's sweep of 2 costs 1; a rat's bite of 1 costs nothing the first time
// and 1 the second (half a point carried).
fn test_a_block_halves() {
  w = room("sword");
  _ = foe(w, "cyclops", 3, 2, 0);
  w.blocking = true;
  until(w, 700);
  assert(w.health == 5, "the sweep blocked: {w.health}");
  v = room("sword");
  _ = foe(v, "rat", 3, 2, 0);
  v.blocking = true;
  until(v, 300);
  assert(v.health == 6, "the first bite blocked: nothing: {v.health}");
  until(v, 1500);
  assert(v.health == 5, "the second: half carried, a point: {v.health}");
}

// A parry: pressed at 200, inside the last 150 ms of the rat's wind-up (150 .. 300), the bite is
// turned aside and the rat is open till 1200; a blow on it then is a riposte, the sword's 2 doubled.
// Pressed at 100 — too early — the bite lands.
fn test_a_parry_and_a_riposte() {
  w = room("sword");
  r = foe(w, "rat", 3, 2, 0);
  w.enemies[r].hp = 9;
  until(w, 200);
  rules::parry(w);
  until(w, 300);
  assert(w.health == 6 && w.parries == 1, "turned aside: {w.health}");
  assert(rules::swing(w) == rules::Step.Attacked && hp(w, r) == 5, "a riposte, 4: {hp(w, r)}");
  v = room("sword");
  _ = foe(v, "rat", 3, 2, 0);
  until(v, 100);
  rules::parry(v);
  until(v, 300);
  assert(v.health == 5 && v.parries == 0, "too early: bitten: {v.health}");
}

// A sweep cannot be parried, only dodged: the cyclops's axe aims at (2, 2) and the cells beside it
// across the blow, (2, 1) and (2, 3) — a side-step is still hit, a step back out of the three is not.
fn test_a_sweep_is_dodged_not_parried() {
  w = room("sword");
  _ = foe(w, "cyclops", 3, 2, 0);
  until(w, 600);
  rules::parry(w);
  until(w, 700);
  assert(w.health == 4, "parried in time, struck anyway: {w.health}");
  v = room("sword");
  _ = foe(v, "cyclops", 3, 2, 0);
  until(v, 100);
  _ = rules::walk(v, 0, 1);
  until(v, 700);
  assert(v.health == 4, "a side-step is still in the sweep: {v.health}");
  u = room("sword");
  _ = foe(u, "cyclops", 3, 2, 0);
  until(u, 100);
  _ = rules::walk(u, -1, 0);
  until(u, 700);
  assert(u.health == 6 && u.misses == 1, "a step back is out of it: {u.health}");
}

// Poise: a light blow does not break a cyclops's wind-up (its sweep lands at 700); a heavy swing does
// — +1, knocked back a cell to (4, 2) — and the hero is ready again only at 800.
fn test_poise_and_the_heavy_swing() {
  w = room("sword");
  c = foe(w, "cyclops", 3, 2, 0);
  w.enemies[c].hp = 9;
  until(w, 100);
  _ = rules::swing(w);
  until(w, 700);
  assert(hp(w, c) == 7 && w.health == 4, "a light blow: the sweep lands anyway: {w.health}");
  v = room("sword");
  d = foe(v, "cyclops", 3, 2, 0);
  v.enemies[d].hp = 9;
  until(v, 100);
  assert(rules::heavy(v) == rules::Step.Attacked && hp(v, d) == 6, "heavy: 3: {hp(v, d)}");
  e = v.enemies[d]!;
  assert(e.x == 4 && e.wind_until == 0, "knocked back, the wind-up broken: x{e.x}");
  until(v, 700);
  assert(v.health == 6, "no sweep: {v.health}");
  until(v, 899);
  assert(rules::heavy(v) == rules::Step.Readying, "899: still readying");
}

// A lunge: a step east at 0 and a swing within 150 ms is a thrust at the cell faced, +1 — the sword's
// 2 + 1 against a sleeping rat on (3, 2).
fn test_a_lunge() {
  w = room("sword");
  rules::put_hero(w, 1, 2, 0);
  r = foe(w, "rat", 3, 2, 1000000);
  w.enemies[r].hp = 9;
  _ = rules::walk(w, 1, 0);
  until(w, 100);
  assert(rules::swing(w) == rules::Step.Attacked && hp(w, r) == 6, "a lunge, 3: {hp(w, r)}");
  v = room("sword");
  s = foe(v, "rat", 3, 2, 1000000);
  v.enemies[s].hp = 9;
  until(v, 500);
  _ = rules::swing(v);
  assert(hp(v, s) == 7, "a swing standing, 2: {hp(v, s)}");
}

// The light chain: blows striking at 0 and 400 follow each other; the third, at 800, leaves the hero
// open till 1600 — a swing at 1200 waits.
fn test_the_light_chain_ends_open() {
  w = room("sword");
  c = foe(w, "cyclops", 3, 2, 1000000);
  w.enemies[c].hp = 20;
  _ = rules::swing(w);
  until(w, 400);
  _ = rules::swing(w);
  until(w, 800);
  _ = rules::swing(w);
  assert(hp(w, c) == 14, "three blows: {hp(w, c)}");
  until(w, 1200);
  assert(rules::swing(w) == rules::Step.Readying, "1200: open, still readying");
}

// Swung too early: with nothing in reach, a rat coming on two cells ahead (4, 2) backs away from the
// blade, to (5, 2).
fn test_an_early_swing_makes_it_back_away() {
  w = room("sword");
  r = foe(w, "rat", 4, 2, 1000000);
  assert(rules::swing(w) == rules::Step.Swung, "nothing in reach");
  e = w.enemies[r]!;
  assert(e.x == 5, "it backed away: x{e.x}");
}

// A riposte's reach: two rats side by side in front, (3, 2) and (3, 3); the one in front parried,
// the hero's riposte strikes it for 4 and its neighbour, not open, for 2.
fn test_a_riposte_reaches_the_neighbour() {
  w = room("sword");
  a = foe(w, "rat", 3, 2, 0);
  b = foe(w, "rat", 3, 3, 1000000);
  w.enemies[a].hp = 9;
  w.enemies[b].hp = 9;
  until(w, 250);
  rules::parry(w);
  until(w, 300);
  _ = rules::swing(w);
  assert(hp(w, a) == 5 && hp(w, b) == 7, "4 and 2: {hp(w, a)} {hp(w, b)}");
}

// Two blows landing together (@GM-Combat): the hero faces south between rats on (1, 2) — its right —
// and (3, 2) — its left; neither in front.  A parry at 200 turns to the right one first (rules::
// acts_before: in front, then right, then left) and turns its bite aside; the left one bites.  The
// rats added in either order, the same.
fn test_a_parry_between_two_turns_to_the_right() {
  for order in [0, 1] {
    w = room("sword");
    w.face_x = 0;
    w.face_y = 1;
    xs = if order == 0 { [1, 3] } else { [3, 1] };
    for x in xs { _ = foe(w, "rat", x, 2, 0); }
    until(w, 200);
    rules::parry(w);
    assert(w.face_x == -1 && w.face_y == 0, "{order}: turned west, to the right one: {w.face_x},{w.face_y}");
    until(w, 300);
    assert(w.parries == 1 && w.health == 5, "{order}: one turned aside, one bite: {w.parries} {w.health}");
  }
}

// Two rats due at one moment want the one cell beside the hero: the hero in a niche on (2, 0),
// facing south, open only to (2, 1); rats on (1, 1) — its right — and (3, 1) — its left — both acting
// at 0.  The right one acts first and takes the cell; added in either order, the same.
fn test_who_acts_first_follows_the_place_not_the_list() {
  for order in [0, 1] {
    w = rules::level(rules::kinds());
    tile_world::fill(w.w, -1, -1, 5, 3, 0, rules::tr(w, "wall"));
    tile_world::fill(w.w, 0, 1, 4, 1, 0, rules::tr(w, "floor"));
    tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "floor"));
    rules::put_hero(w, 2, 0, 0);
    w.face_x = 0;
    w.face_y = 1;
    xs = if order == 0 { [1, 3] } else { [3, 1] };
    for x in xs {
      _ = rules::add_enemy(w, "rat", x, 1, 0);
      w.enemies[len(w.enemies) - 1].due = 0;
    }
    until(w, 0);
    taken = "";
    for e in w.enemies { taken += "{e.x},{e.y} "; }
    assert(rules::enemy_at(w, 2, 1, 0) >= 0, "{order}: the cell is taken: {taken}");
    r = w.enemies[rules::enemy_at(w, 2, 1, 0)]!;
    assert(r.nest_x == 1, "{order}: by the right one, from (1, 1): {taken}");
  }
}
