//
// Light: each cell is one shade darker per step from the nearest light, down to DARKEST (7).
// The scene is a corridor x 0 .. 6 at y 0 under a ceiling, walled all round (x -1 and x 7 are
// walls), so nothing is open sky unless a cell says so.  Rows are read from x -1 to x 7.
use tile_world;
use rules;

fn corridor() -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, 7, 1, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 6, 0, 0, rules::tr(w, "floor"));
  tile_world::fill(w.w, -1, -1, 7, 1, 1, rules::tr(w, "floor"));
  rules::put_hero(w, 0, 0, 0);
  w
}

fn row(w: const rules::Level) -> text {
  t = "";
  for s in tile_world::shades(w.w, -1, 0, 7, 0, 0, rules::carried_lights(w)) { t += "{s},"; }
  t
}

fn main() {
  w = corridor();
  assert(row(w) == "7,7,7,7,7,7,7,7,7,", "no light, no open sky: all darkest, never black: {row(w)}");
}

// A torch (the staff) on the west wall: 0 there, then 1 .. 7 eastwards; the east wall is 8 steps
// away and reads the darkest, 7.
fn test_a_torch_fades_by_one_shade_a_step() {
  w = corridor();
  tile_world::place(w.w, -1, 0, 0, rules::th(w, "staff"));
  assert(row(w) == "0,1,2,3,4,5,6,7,7,", "{row(w)}");
}

// A wall in the corridor at x 3 is lit (4) and stops the light: what is past it is dark.
fn test_a_wall_takes_light_and_stops_it() {
  w = corridor();
  tile_world::place(w.w, -1, 0, 0, rules::th(w, "staff"));
  tile_world::set_terrain(w.w, 3, 0, 0, rules::tr(w, "wall"));
  assert(row(w) == "0,1,2,3,4,7,7,7,7,", "{row(w)}");
}

// The ceiling over x 6 taken away: the sky lights x 6 (0) and its neighbours by distance, and
// each cell takes the nearer of the two lights: x 3 is 4 from the torch, 3 from the sky.
fn test_open_sky_is_a_light() {
  w = corridor();
  tile_world::place(w.w, -1, 0, 0, rules::th(w, "staff"));
  tile_world::set_terrain(w.w, 6, 0, 1, tile_world::VOID);
  assert(row(w) == "0,1,2,3,3,2,1,0,1,", "{row(w)}");
}

// The hero takes the torch off the wall (walking west into it), carries the light east, and
// fixes it to the east wall.
fn test_the_staff_is_carried_and_fixed() {
  w = corridor();
  tile_world::place(w.w, -1, 0, 0, rules::th(w, "staff"));
  assert(rules::walk(w, -1, 0) == rules::Step.Took, "taken off the wall");
  assert(w.hero_item == rules::th(w, "staff") && w.hero_x == 0, "held, the hero did not move");
  assert(row(w) == "1,0,1,2,3,4,5,6,7,", "the light is the hero: {row(w)}");
  for _ in 0..6 { _ = rules::walk(w, 1, 0); }
  assert(rules::walk(w, 1, 0) == rules::Step.Placed, "fixed to the east wall");
  assert(w.hero_item == 0 && w.hero_x == 6, "the hand is empty");
  assert(row(w) == "7,7,6,5,4,3,2,1,0,", "{row(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Took, "and taken again");
  assert(rules::walk(w, 0, 1) == rules::Step.Placed, "and fixed to the south wall");
}

// A staff on the floor is picked up by walking onto it; with empty hands a bare wall is a wall.
fn test_a_staff_on_the_floor_is_picked_up() {
  w = corridor();
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "staff"));
  assert(rules::walk(w, 0, -1) == rules::Step.Blocked, "a bare wall, empty hands");
  _ = rules::walk(w, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "onto the staff");
  assert(w.hero_item == rules::th(w, "staff") && tile_world::top(w.w, 2, 0, 0) == 0, "picked up");
}
