// Level files: the two levels load from levels/, save back to the same text, and play to their
// goals; a world with negative chunks, several layers, a stack, a tile override and a name that
// needs escaping survives a save and a load.
use tile_world;
use rules;
use levels;
use materials;

fn read(name: text) -> text {
  file("../levels/{name}.json").content() ?? ""
}

fn level(name: text) -> levels::LevelFile {
  m = levels::load(read(name), rules::kinds());
  if !m { assert(false, "levels/{name}.json loads"); }
  m ?? levels::LevelFile {
    name: "", level: rules::level(rules::kinds()), start_x: 0, start_y: 0, start_z: 0,
    goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 }
  }
}

fn main() {
  lf = level("first_climb");
  assert(lf.name == "the first climb", "named: {lf.name}");
  assert(lf.goal.kind == "layer" && lf.goal.z == 1, "its goal: layer 1");
}

// Saving a loaded file writes it again, character for character.
fn test_a_file_saves_to_itself() {
  for name in ["first_climb", "the_cellar"] {
    raw = read(name);
    m = levels::load(raw, rules::kinds());
    if !m { assert(false, "{name} loads"); continue; }
    lf = m ?? level(name);
    assert(levels::save(lf) == raw, "{name} saves to the same text");
  }
}

fn test_the_first_climb_plays_to_its_goal() {
  lf = level("first_climb");
  l = lf.level;
  assert(!levels::solved(lf, l), "not at the start");
  rules::play(l, "s s s d d d d pa pa pa s d d w d d d d a a a a s s s a a a w d d d s d w w a w d d d s d w w a w d d pd a w");
  assert(levels::solved(lf, l), "on the ledge\n{rules::view(l, 0, 0, 12, 8, 0)}");
}

fn test_the_cellar_plays_to_its_goal() {
  lf = level("the_cellar");
  l = lf.level;
  assert(rules::walk(l, -1, 0) == rules::Step.Took, "the torch");
  // With the torch in hand the rock at x 5 cannot be pushed: it is put down beside the rock,
  // the rock pushed twice, and the torch picked up again on the way back past it.
  rules::play(l, "s d d d");
  assert(rules::walk(l, 1, 0) == rules::Step.Blocked, "full hands push nothing");
  rules::play(l, "x d d a a");
  assert(l.hero_item == rules::th(l, "staff") && l.hero_x == 4, "the torch again, at x {l.hero_x}");
  rules::play(l, "d d w d d d d d d");
  assert(levels::solved(lf, l), "in the yard at {l.hero_x},{l.hero_y}");
}

// The torch room: the stick, dipped in the tar, lit at the socket by the start, hung in the
// empty socket past the middle, and the chest opened at the far end.
fn test_the_torch_room_plays_to_its_goal() {
  lf = level("the_torch_room");
  l = lf.level;
  rules::tick(l, 0);
  rules::play(l, "s d d d");
  assert(l.hero_item == rules::th(l, "stick"), "the stick");
  _ = rules::walk(l, 1, 0);
  assert(rules::walk(l, 1, 0) == rules::Step.Dipped && l.hero_item == rules::th(l, "torch"), "dipped");
  rules::play(l, "w w a a a");
  assert(rules::walk(l, 0, -1) == rules::Step.Lit, "lit at the socket by the start");
  rules::play(l, "d d d d d d d");
  assert(rules::walk(l, 0, -1) == rules::Step.Placed && l.hero_item == 0, "hung at x 9");
  assert(len(rules::carried_lights(l)) == 0 && rules::burning(l), "the room burns, the hands are free");
  rules::play(l, "d d d d s d");
  assert(levels::solved(lf, l), "the chest opened: at {l.hero_x},{l.hero_y}");
}

// Chunks at -1 (x -32 .. -1) and 1, layers -1 and 2, a three-thing stack, a tile number on one
// cell, a name with a quote, and a cell goal.
fn test_a_world_survives_a_round_trip() {
  k = rules::kinds();
  l = rules::level(k);
  tile_world::fill(l.w, -3, -2, 2, 0, 0, rules::tr(l, "floor"));
  tile_world::set_terrain(l.w, -1, -1, 0, rules::tr(l, "wall"), 77);
  tile_world::fill(l.w, 40, 3, 41, 3, 2, rules::tr(l, "water"));
  tile_world::set_terrain(l.w, 0, 0, -1, rules::tr(l, "rail"));
  tile_world::place(l.w, 1, 0, 0, rules::th(l, "table"));
  tile_world::place(l.w, 1, 0, 0, rules::th(l, "chair"));
  tile_world::place(l.w, 1, 0, 0, rules::th(l, "staff"));
  tile_world::place(l.w, -3, -2, 0, rules::th(l, "rock"));
  rules::put_hero(l, -2, -1, 0);
  lf = levels::LevelFile {
    name: "a \"quoted\" name", level: l, start_x: -2, start_y: -1, start_z: 0,
    goal: levels::Goal { kind: "cell", x: 41, y: 3, z: 2 }
  };
  text = levels::save(lf);
  m = levels::load(text, k);
  if !m { assert(false, "the saved text loads:\n{text}"); return; }
  back = m ?? lf;
  b = back.level;
  assert(back.name == "a \"quoted\" name", "the name: {back.name}");
  assert(back.goal.kind == "cell" && back.goal.x == 41 && back.goal.z == 2, "the goal");
  assert(tile_world::terrain(b.w, -3, -2, 0) == rules::tr(b, "floor"), "a floor at -3,-2");
  assert(tile_world::terrain(b.w, -1, -1, 0) == rules::tr(b, "wall")
         && tile_world::tile(b.w, -1, -1, 0) == 77, "the wall with tile 77");
  assert(tile_world::terrain(b.w, 41, 3, 2) == rules::tr(b, "water"), "water on layer 2");
  assert(tile_world::terrain(b.w, 0, 0, -1) == rules::tr(b, "rail"), "a rail on layer -1");
  st = "";
  for t in tile_world::things(b.w, 1, 0, 0) { st += "{rules::thing_name(k, t)},"; }
  assert(st == "table,chair,staff,", "the stack, bottom first: {st}");
  assert(b.hero_x == -2 && b.hero_y == -1 && b.hero_z == 0, "the hero at the start");
  assert(levels::save(back) == text, "and it saves to the same text again");
}

// A "chests" goal is solved when no chest is left closed: one chest beside the hero, opened.
fn test_a_chests_goal() {
  l = rules::level(rules::kinds());
  tile_world::fill(l.w, 0, 0, 2, 0, 0, rules::tr(l, "floor"));
  tile_world::place(l.w, 1, 0, 0, rules::th(l, "chest"));
  rules::put_hero(l, 0, 0, 0);
  lf = levels::LevelFile {
    name: "chests", camera: "follow", level: l, start_x: 0, start_y: 0, start_z: 0,
    goal: levels::Goal { kind: "chests", x: 0, y: 0, z: 0 }
  };
  assert(!levels::solved(lf, lf.level), "a chest is closed");
  assert(rules::walk(lf.level, 1, 0) == rules::Step.Opened, "opened");
  assert(levels::solved(lf, lf.level), "every chest open");
}

// Materials in a level file (theme.json's grass and path): a row of grass over a 2x2 patch of
// path writes the rows `,,,` `::` `::` with a legend of the two materials and no tile
// overrides — each tile is worked out again when it loads — and loads back to the same tiles.
fn test_materials_survive_a_round_trip() {
  k = rules::kinds();
  mats = materials::load(file("../theme.json").content() ?? "", k);
  l = rules::level(k);
  for x in 0..3 { materials::paint(mats, l.w, materials::named(mats, "grass"), x, 0, 0); }
  for y in 1..3 {
    for x in 0..2 { materials::paint(mats, l.w, materials::named(mats, "path"), x, y, 0); }
  }
  lf = levels::LevelFile {
    name: "m", camera: "follow", level: l, start_x: 0, start_y: 0, start_z: 0,
    goal: levels::Goal { kind: "layer", x: 0, y: 0, z: 1 }
  };
  text = levels::save_with(lf, mats);
  assert(text.find("\",,,\"") != null && text.find("\"::\"") != null, "the rows:\n{text}");
  assert(text.find("\"legend\": {{ \",\": \"grass\", \":\": \"path\" }}") != null, "the legend:\n{text}");
  assert(text.find("\"tiles\": [ ]") != null, "no overrides:\n{text}");
  m = levels::load_with(text, k, mats);
  if !m { assert(false, "it loads"); return; }
  back = m ?? lf;
  for y in 0..3 {
    for x in 0..3 {
      assert(tile_world::tile(back.level.w, x, y, 0) == tile_world::tile(l.w, x, y, 0),
             "the tile at {x},{y}: {tile_world::tile(back.level.w, x, y, 0)}");
    }
  }
  assert(levels::save_with(back, mats) == text, "and saves to the same text");
}

// A level's enemies load at their nests and save back the same: the first climb with a rat on
// (3, 1, 0) and one on (6, 2, 0) written in; it loads two rats there, and saves to the same text.
fn test_enemies_load_and_save() {
  raw = read("first_climb");
  with = raw.replace("  \"start\":", "  \"enemies\": [ [\"rat\", 3, 1, 0], [\"rat\", 6, 2, 0] ],\n  \"start\":");
  m = levels::load(with, rules::kinds());
  if !m { assert(false, "it loads"); return; }
  lf = m ?? level("first_climb");
  e = lf.level.enemies;
  assert(len(e) == 2 && (e[0]).kind == "rat" && (e[0]).x == 3 && (e[1]).y == 2, "two rats at their nests");
  assert(levels::save(lf) == with, "saves to the same text");
}

// The old mine: the hero takes the burning torch from the plateau's socket, goes down the ramp
// into the dark hall at a walking pace — the world running: the rats see the hero but keep out of
// the torch's light, while the bat, drawn to it, flies out over the water and meets the hero on the
// rails at (10, 3): it bites once, and the next step into it is a blow that ends it — and opens
// the chest.
fn test_the_old_mine_plays_to_its_goal() {
  lf = level("the_old_mine");
  l = lf.level;
  rules::tick(l, 0);
  assert(!levels::solved(lf, l), "not at the start");
  rules::play(l, "w w");
  assert(l.hero_item == rules::th(l, "burning_torch"), "the torch from the socket: {rules::thing_name(l.k, l.hero_item)} at {l.hero_x},{l.hero_y},{l.hero_z}\n{rules::view(l, -1, -1, 16, 8, 1)}");
  rules::play(l, "~150 s ~150 d ~150 d ~150 s ~150 d ~150 d ~150 d ~150 d");
  assert(l.hero_z == 0 && l.hero_x == 8 && l.hero_y == 3, "down the ramp: {l.hero_x},{l.hero_y},{l.hero_z}\n{rules::view(l, -1, -1, 16, 8, 0)}");
  rules::play(l, "~150 d ~150 d ~150 d ~150 d ~150 d ~150 w ~150 d ~150 d ~150 w");
  assert(len(l.enemies) == 2 && l.killed == 1, "the bat ended, the rats kept off");
  assert(levels::solved(lf, l) && l.health == 5, "the chest, bitten once (the bat): {l.hero_x},{l.hero_y} health {l.health}\n{rules::view(l, -1, -1, 16, 8, 0)}");
}

// What a cyclops holds rides on its entry: a fifth word when not its kind's axe — "bomb" (its 3),
// "none" — and saves back the same; one holding the axe writes no fifth.
fn test_what_a_cyclops_holds_loads_and_saves() {
  raw = read("first_climb");
  with = raw.replace("  \"start\":",
    "  \"enemies\": [ [\"cyclops\", 3, 1, 0], [\"cyclops\", 4, 1, 0, \"bomb\"], [\"cyclops\", 5, 1, 0, \"none\"] ],\n  \"start\":");
  m = levels::load(with, rules::kinds());
  lf = m ?? level("first_climb");
  l = lf.level;
  a = l.enemies[0];
  b = l.enemies[1];
  c = l.enemies[2];
  assert(a.item == rules::th(l, "axe") && b.item == rules::th(l, "bomb") && b.bombs == 3 && c.item == 0, "held as written");
  out = levels::save(lf);
  assert(out.contains("[\"cyclops\", 3, 1, 0], [\"cyclops\", 4, 1, 0, \"bomb\"], [\"cyclops\", 5, 1, 0, \"none\"]"),
         "saved back: {out}");
}

// The cyclops hall: two cyclopes nest beside the chest, under a roof.  Walking straight there the
// hero is seen and struck.  The way: the bow from the west room, an arrow along the bottom row into
// the bomb in the far corner — the blast draws them both to it (they search it for 6 s) — and, in
// the dark, up the east room's west side to the chest, unseen.
fn test_the_cyclops_hall_plays_to_its_goal() {
  lf = level("the_cyclops_hall");
  l = lf.level;
  rules::tick(l, 0);
  rules::play(l, "~150 d ~150 d ~150 d ~150 d ~150 d ~150 d ~150 d ~150 w ~150 w ~150 w ~150 w ~150 w ~150 d ~150 d ~150 d ~150 d ~150 d ~150 d ~3000");
  assert(l.spotted > 0 && l.health < 6, "straight in: seen and struck ({l.spotted}, health {l.health})");
  lf = level("the_cyclops_hall");
  l = lf.level;
  rules::tick(l, 0);
  rules::play(l, "w w w d s s s s d d d d");
  assert(l.hero_item == rules::th(l, "bow") && l.hero_x == 7 && l.hero_y == 7, "the bow, at the bottom row's door");
  rules::play(l, "f ~4000");
  assert(l.blasted == 1 && l.spotted == 0, "the bomb set off, the hero unseen");
  rules::play(l, "w ~100 d ~100 d ~100 w ~100 w ~100 w ~100 w ~100 w ~100 d ~100 d ~100 d ~100 d ~100 d");
  assert(levels::solved(lf, l) && l.spotted == 0 && l.health == 6, "the chest, unseen: ({l.hero_x}, {l.hero_y})");
}
