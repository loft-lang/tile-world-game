// Ten marbles let fall on a hill with houses on its slopes (marbles.loft; owner, 2026-11-16):
// where they end up and when, by the rules of what is unstable — the same every time.
use hex_field;
use hexterrain;
use hexhouse;
use hexwalls;
use marbles;
use marblehill;

// The hill of marblehill.loft: five houses spaced round its slopes, seated on the ground, and the
// ten let fall one every 400 ms.
fn played() -> marbles::Hill {
  sh = marblehill::built(hexwalls::default_sizes(), hexterrain::default_measures());
  assert(len(sh.town.houses) == 5, "five houses");
  assert(marblehill::play(sh), "the hill comes to rest");
  sh.hill
}

fn test_ten_marbles_on_the_hill() {
  hl = played();
  for line in marbles::picture(hl, 21) { println(line); }
  held = 0;
  for i in 0..len(hl.marbles) {
    m = hl.marbles[i]!;
    c = hexterrain::centre(m.q, m.r);
    if marbles::caught(hl, i) { held += 1; }
    println("marble {i}: fell on ({m.from_q}, {m.from_r}), rests ({m.q}, {m.r}) at {marbles::height(hl, m.q, m.r):.2} m, {sqrt(c.0 * c.0 + c.1 * c.1) ?? 0.0:.1} m from the top, after {m.rest_at} ms, went {m.went} hexes, struck {m.struck}{if marbles::caught(hl, i) { ", held by a house" } else { "" }}");
  }
  println("at rest after {hl.now} ms, {hl.rounds} happenings; {held} held by a house");
  assert(len(hl.marbles) == 10, "ten marbles");
  rolled = 0;
  for i in 0..10 {
    m = hl.marbles[i]!;
    // each on a whole hex of its own, on open ground, where it will stay
    assert(!hex_field::hexset_get(hl.fixed, m.q, m.r), "marble {i} not in a house");
    for j in 0..i { assert(hl.marbles[j]!.q != m.q || hl.marbles[j]!.r != m.r, "marbles {j} and {i} each on their own hex"); }
    assert(marbles::settled(hl, i), "marble {i} is where it will stay");
    // none rests higher than it was let fall, none later than the end, none before it landed
    assert(marbles::height(hl, m.q, m.r) <= marbles::height(hl, m.from_q, m.from_r) + 0.000001, "marble {i} not higher than it fell");
    assert(m.rest_at <= hl.now && m.rest_at >= 400 * i + 600, "marble {i} at rest after it landed and by the end: {m.rest_at}");
    c = hexterrain::centre(m.q, m.r);
    assert((sqrt(c.0 * c.0 + c.1 * c.1) ?? 0.0) <= 21.0 + 1.5 * ((marbles::FASTEST / marbles::GROUND) as float) + 1.5, "marble {i} no further than its speed lasts past the foot");
    if m.went > 0 { rolled += 1; }
  }
  assert(rolled >= 8, "the bounce on landing sets them going: {rolled} rolled");
  assert(held >= 1, "a house holds a marble: {held}");
  // every marble's way, for a view: it begins in the air and ends where the marble rests
  ways = marblehill::ways_json(hl);
  assert(ways.starts_with("[[[0, 0, 0, 8]") && len(ways) > 2000, "the ways written: {len(ways)} characters");
}

// The same hill, the same marbles: the same end, hex for hex and millisecond for millisecond.
fn test_the_hill_plays_the_same_every_time() {
  a = played();
  b = played();
  assert(a.rounds == b.rounds && a.now == b.now, "as many happenings, as long: {a.rounds} {b.rounds}");
  for i in 0..10 {
    assert(a.marbles[i]!.q == b.marbles[i]!.q && a.marbles[i]!.r == b.marbles[i]!.r && a.marbles[i]!.went == b.marbles[i]!.went && a.marbles[i]!.struck == b.marbles[i]!.struck && a.marbles[i]!.rest_at == b.marbles[i]!.rest_at, "marble {i} the same");
  }
}

// The rules one at a time, on ground made for each.
fn test_the_rules_of_a_marble() {
  // let fall on the flat it lies still, landed after its fall's time (2 m: 639 ms)
  flat = marbles::hill(-10, -10, 21, 21);
  assert(marbles::let_fall(flat, 0, 0) && !marbles::next(flat) && marbles::settled(flat, 0), "at rest on the flat");
  assert(flat.now == 639 && flat.marbles[0]!.went == 0, "landed after 639 ms: {flat.now}");
  // set going along the flat, the ground takes 2 a hex: speed 4 makes one hex, at speed 2, in 618 ms
  flat.marbles[0].heading = 0;
  flat.marbles[0].speed = 4;
  assert(marbles::run(flat, 50) && flat.marbles[0]!.q == 1 && flat.marbles[0]!.r == 0, "one hex on, the second not made: ({flat.marbles[0]!.q}, {flat.marbles[0]!.r})");
  assert(marbles::step_ms(1.5, 2) == 618 && flat.now == 639 + 618, "a hex at speed 2 in 618 ms: {marbles::step_ms(1.5, 2)}, now {flat.now}");
  assert(marbles::step_ms(1.5, 12) < marbles::step_ms(1.5, 4) && marbles::step_ms(2.598076211353316, 4) > marbles::step_ms(1.5, 4), "faster is sooner, between hexes is longer");
  // let fall on a slope it bounces off down it
  slope = marbles::hill(-10, -10, 21, 21);
  for r in -10..11 { for q in -10..11 { hex_field::height_set(slope.ground.gr_heights, q, r, 0.2 * ((10 - q) as float)); } }
  marbles::let_fall(slope, 0, 0);
  assert(slope.marbles[0]!.speed >= marbles::GROUND && slope.marbles[0]!.at == 639, "it lands with speed to go on: {slope.marbles[0]!.speed}");
  marbles::next(slope);
  assert(slope.marbles[0]!.q > 0 && slope.now == 639, "and at its landing sets off down the slope: {slope.marbles[0]!.q}");
  // a marble struck takes the striker's motion, the striker rests where it was
  two = marbles::hill(-10, -10, 21, 21);
  marbles::let_fall(two, 0, 0);
  marbles::let_fall(two, 2, 0);
  two.marbles[0].heading = 0;
  two.marbles[0].speed = 9;
  assert(marbles::run(two, 50), "two on the flat come to rest");
  assert(two.marbles[0]!.q == 1 && two.marbles[1]!.q > 2 && two.marbles[0]!.struck == 1, "the striker stops beside where the other lay, the other goes on: {two.marbles[0]!.q} {two.marbles[1]!.q}");
  // onto a marble another rolls off to a neighbour
  pile = marbles::hill(-10, -10, 21, 21);
  marbles::let_fall(pile, 0, 0);
  marbles::let_fall(pile, 0, 0);
  assert((pile.marbles[1]!.q != 0 || pile.marbles[1]!.r != 0) && pile.marbles[1]!.speed >= marbles::GROUND, "the second rolled off the first");
  // a house ahead: aside along its wall
  wall = marbles::hill(-10, -10, 21, 21);
  assert(marbles::house(wall, 4, 0, 3, hexhouse::box_plan(2, 2)) > 3, "a small house");
  marbles::let_fall(wall, 0, 0);
  wall.marbles[0].heading = 0;
  wall.marbles[0].speed = 10;
  marbles::run(wall, 50);
  assert(wall.marbles[0]!.struck >= 1 && !hex_field::hexset_get(wall.fixed, wall.marbles[0]!.q, wall.marbles[0]!.r), "it met the house and is not in it: ({wall.marbles[0]!.q}, {wall.marbles[0]!.r}) struck {wall.marbles[0]!.struck}");
}
