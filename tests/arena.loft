//
// The arena (TEMPLATES.md § The swordsman; owner, 2026-11-15): a human swordsman who fights with the
// hero's own moves, by templates, in three phases of his health, each a style of its own — the
// striker, the patient fencer, the dodger.  Every time here is by hand from kinds.json's templates.
use tile_world;
use rules;
use levels;

// A lit room, w x h, walled round.
fn room(w: integer, h: integer) -> rules::Level {
  l = rules::level(rules::kinds());
  tile_world::fill(l.w, -1, -1, w, h, 0, rules::tr(l, "wall"));
  tile_world::fill(l.w, 0, 0, w - 1, h - 1, 0, rules::tr(l, "floor"));
  l
}

fn until(w: rules::Level, at: integer) {
  rules::tick(w, at - w.now);
}

fn at(w: const rules::Level) -> text {
  e = w.enemies[0];
  if !e { return "none"; }
  "{e.x},{e.y}"
}

// The hero on (2, 2) with a sword, facing east; the swordsman on (sx, 2) in phase `phase` (his health
// what that phase starts at: 12, 8, 4).
fn duel(sx: integer, phase: integer) -> rules::Level {
  w = room(10, 5);
  rules::put_hero(w, 2, 2, 0);
  w.hero_item = rules::th(w, "sword");
  w.face_x = 1;
  w.face_y = 0;
  _ = rules::add_enemy(w, "swordsman", sx, 2, 0);
  w.enemies[0].hp = 12 - phase * 4;
  w.enemies[0].phase = phase;
  w
}

fn read(name: text) -> text {
  file("../levels/{name}.json").content() ?? ""
}

fn main() {
  w = duel(6, 0);
  assert(w.enemies[0]!.kind == "swordsman", "a swordsman");
}

// The striker (phase 0): he closes in, a step every 300 ms from 400 — (5, 2), (4, 2), and beside
// the hero on (3, 2) at 1000 — and at his next act, 1300, draws back for 400: the blow lands at
// 1700, for 1.
fn test_the_striker_closes_and_swings() {
  w = duel(6, 0);
  until(w, 1000);
  assert(at(w) == "3,2", "1000: beside the hero: {at(w)}");
  until(w, 1300);
  assert(w.enemies[0]!.wind_until == 1700, "1300: drawn back until 1700: {w.enemies[0]!.wind_until}");
  until(w, 1699);
  assert(w.health == 6, "1699: not yet: {w.health}");
  until(w, 1700);
  assert(w.health == 5, "1700: struck for 1: {w.health}");
}

// Against the hero's guard the striker's light blow is nothing (half of 1, paid on the next), so he
// draws the heavy one: 700 from 1300, landing at 2000 for 2, the guard no help.
fn test_the_striker_breaks_a_guard_with_a_heavy_blow() {
  w = duel(6, 0);
  w.blocking = true;
  until(w, 1300);
  assert(w.enemies[0]!.wind_until == 2000, "1300: drawn back long, until 2000: {w.enemies[0]!.wind_until}");
  until(w, 1999);
  assert(w.health == 6, "1999: not yet: {w.health}");
  until(w, 2000);
  assert(w.health == 4, "2000: the heavy blow through the guard, 2: {w.health}");
}

// The patient fencer (phase 1) keeps three away from a hero who is ready: he steps in once, to
// (5, 2), and then holds — his guard up and a feint now and then — never striking.
fn test_the_patient_fencer_holds_the_distance() {
  w = duel(6, 1);
  near = 99;
  guarded = false;
  while w.now < 6000 {
    rules::tick(w, 10);
    e = w.enemies[0]!;
    d = (if e.x > 2 { e.x - 2 } else { 2 - e.x }) + (if e.y > 2 { e.y - 2 } else { 2 - e.y });
    if d < near { near = d; }
    if e.guard_until > w.now { guarded = true; }
  }
  assert(near == 3 && w.health == 6, "he held three away and struck nothing: {near}, {w.health}");
  assert(guarded && w.winds > 0, "his guard up, and feints drawn: {w.winds}");
}

// A hero who draws back its swing is out of line: the fencer two away lunges at his first act, 400 —
// a step in to (3, 2) and the blow at once, no draw, for 1 — then backs off a cell.
fn test_the_patient_fencer_lunges_into_a_drawn_swing() {
  w = duel(4, 1);
  w.drawing_since = 0;
  until(w, 399);
  assert(w.health == 6 && at(w) == "4,2", "399: not yet: {w.health}, {at(w)}");
  until(w, 400);
  assert(w.health == 5 && at(w) == "3,2", "400: lunged in and struck: {w.health}, {at(w)}");
  until(w, 500);
  assert(at(w) == "4,2", "500: backed off: {at(w)}");
}

// The dodger (phase 2) does not meet a guard: beside the hero on (3, 2) at 900, at 1150 he steps
// aside to (3, 1), at 1250 round to the hero's side (2, 1), draws 250 there and strikes at 1640 —
// from the side, where the guard does not face, for the full 1.
fn test_the_dodger_takes_the_side_of_a_guard() {
  w = duel(6, 2);
  w.blocking = true;
  until(w, 900);
  assert(at(w) == "3,2", "900: before the hero: {at(w)}");
  until(w, 1250);
  assert(at(w) == "2,1", "1250: at the hero's side: {at(w)}");
  until(w, 1639);
  assert(w.health == 6, "1639: not yet: {w.health}");
  until(w, 1640);
  assert(w.health == 5, "1640: struck from the side through no guard: {w.health}");
}

// His guard takes the hero's light blow from the front at half (the sword's 2 to 1); a heavy swing
// breaks it and costs the full 3.
fn test_his_guard_halves_a_light_blow() {
  w = duel(3, 1);
  w.enemies[0].face_x = -1;
  w.enemies[0].face_y = 0;
  w.enemies[0].guard_until = 100000;
  assert(rules::swing(w) == rules::Step.Attacked, "struck");
  assert(w.enemies[0]!.hp == 7 && w.guarded == 1, "the guard took half: {w.enemies[0]!.hp}");
  w.now = 2000;
  assert(rules::heavy(w) == rules::Step.Attacked, "struck heavy");
  assert(w.enemies[0]!.hp == 4 && w.enemies[0]!.guard_until == 0, "the heavy blow broke the guard: {w.enemies[0]!.hp}");
}

// His phase follows the health he has lost: at full health the striker; 4 lost, the patient fencer;
// 8 lost, the dodger.  Each change is heard (a cry) at his next act.
fn test_his_style_changes_with_his_health() {
  w = duel(6, 0);
  until(w, 500);
  assert(w.enemies[0]!.phase == 0 && w.phases == 0, "full health: the striker");
  w.enemies[0].hp = 8;
  until(w, 1500);
  assert(w.enemies[0]!.phase == 1 && w.phases == 1, "4 lost: the patient fencer: {w.enemies[0]!.phase}");
  w.enemies[0].hp = 4;
  until(w, 3000);
  assert(w.enemies[0]!.phase == 2 && w.phases == 2, "8 lost: the dodger: {w.enemies[0]!.phase}");
}

// The arena loads, its swordsman inside and a sword by the door, and a door joins it to the demo
// village both ways.
fn test_the_arena_is_a_house_of_the_village() {
  raw = read("the_arena");
  m = levels::load(raw, rules::kinds());
  if !m { assert(false, "levels/the_arena.json loads"); return; }
  lf = m ?? return;
  assert(len(lf.level.enemies) == 1 && lf.level.enemies[0]!.kind == "swordsman", "one swordsman");
  assert(raw.contains("\"sword\"") && raw.contains("\"to\": \"demo\""), "a sword, and the way out to the village");
  assert(read("demo").contains("\"to\": \"the_arena\""), "the village's door to it");
}
