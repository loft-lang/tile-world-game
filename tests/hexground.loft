// The ground on the hex grid (hexterrain.loft; formal/hex-houses.md § The ground): terraces made
// smooth, a round hill, a structure seated on the ground.
use hex_field;
use hexterrain;
use hexhouse;
use hexwalls;

fn abs_f(a: float) -> float { if a < 0.0 { -a } else { a } }

fn measures() -> hexterrain::Measures { hexterrain::measures_file("../hexsizes.json") }

/// Two terraces side by side on a 20 x 10 map of 1.5 m squares: level 0 west of x = 10, level 1
/// east of it.
fn two_terraces() -> hexterrain::Steps {
  level: vector<integer> = [];
  for j in 0..10 { for i in 0..20 { level += [if i < 10 { 0 } else { 1 }]; } }
  hexterrain::Steps { x0: 0.0, y0: 0.0, size: 1.5, nx: 20, ny: 10, level: level }
}

// @FR-HG-Terrace: half a hillside or more from an edge, the ground is flat at its storey
fn test_terraces_are_flat_away_from_their_edges() {
  m = measures();
  s = two_terraces();
  // the edge is at x = 15 m
  for x in [2.0, 15.0 - m.hillside * 0.5 - 0.01, 15.0 + m.hillside * 0.5 + 0.01, 28.0] {
    h = hexterrain::terrace_height(s, x, 7.5, m, 0, 1);
    want = if x < 15.0 { 0.0 } else { m.storey };
    assert(abs_f(h - want) < 0.000001, "at x = {x} m the ground is {h} m, flat at {want}");
  }
}

// @FR-HG-Terrace: across an edge the ground climbs a storey without a step, half way at the edge
fn test_a_terrace_edge_is_a_smooth_slope() {
  m = measures();
  s = two_terraces();
  mid = hexterrain::terrace_height(s, 15.0, 7.5, m, 0, 1);
  assert(abs_f(mid - m.storey * 0.5) < 0.000001, "half a storey up at the edge: {mid}");
  last = hexterrain::terrace_height(s, 15.0 - m.hillside, 7.5, m, 0, 1);
  steepest = 0.0;
  for i in 1..121 {
    x = 15.0 - m.hillside + (i as float) * m.hillside * 2.0 / 120.0;
    h = hexterrain::terrace_height(s, x, 7.5, m, 0, 1);
    assert(h >= last - 0.000001, "the ground never falls on the way up: {h} after {last} at x = {x}");
    rise = (h - last) / (m.hillside * 2.0 / 120.0);
    if rise > steepest { steepest = rise; }
    last = h;
  }
  // a smoothstep's steepest is 1.5 times its mean
  assert(steepest <= 1.5 * m.storey / m.hillside + 0.01, "no slope steeper than a smoothstep's: {steepest}");
  // and it leaves the flat with no kink: barely rising just inside the hillside
  foot = 15.0 - m.hillside * 0.5;
  d = m.hillside * 0.02;
  early = (hexterrain::terrace_height(s, foot + d, 7.5, m, 0, 1) - hexterrain::terrace_height(s, foot, 7.5, m, 0, 1)) / d;
  assert(early < 0.1 * m.storey / m.hillside, "no kink where the slope leaves the flat: {early} m/m");
}

// @FR-HG-Hill: a hill's full height at its top, nothing at its foot and beyond
fn test_a_hill_is_level_at_its_top_and_its_foot() {
  g = hexterrain::ground_new(-30, -30, 60, 60);
  hexterrain::hill(g, 0.0, 0.0, 30.0, 8.0);
  assert(abs_f(hex_field::height_get(g.heights, 0, 0) - 8.0) < 0.000001, "8 m at the top");
  for c in [(25, 0), (-25, 0), (0, 25), (0, -25)] {
    (x, y) = hexterrain::centre(c.0, c.1);
    d = sqrt(x * x + y * y);
    if d >= 30.0 { assert(hex_field::height_get(g.heights, c.0, c.1) == 0.0, "nothing beyond the foot, {d} m out"); }
  }
}

// @FR-HG-Seat: the footprint at the floor's height, the ground blending back round it
fn test_a_seated_house_is_level_and_blends_in() {
  m = measures();
  g = hexterrain::ground_new(-30, -30, 60, 60);
  hexterrain::hill(g, 0.0, 0.0, 40.0, 10.0);
  before = hexterrain::ground_new(-30, -30, 60, 60);
  hexterrain::hill(before, 0.0, 0.0, 40.0, 10.0);
  b = hexhouse::build(hexhouse::HexHouse { cq: 10, cr: 0, turn: 3, parts: hexhouse::box_plan(5, 4) });
  low = hexterrain::seat(g, b.cells, 5.0, m);
  lowest = 1000.0;
  for r in -30..30 {
    for q in -30..30 {
      inside = hex_field::hexset_get(b.cells, q, r);
      h = hex_field::height_get(g.heights, q, r);
      if inside {
        assert(h == 5.0, "the footprint level at 5 m: cell ({q}, {r}) at {h}");
        was = hex_field::height_get(before.heights, q, r);
        if was < lowest { lowest = was; }
        continue;
      }
      // how far the cell is from the footprint
      (x, y) = hexterrain::centre(q, r);
      near = 1000.0;
      for fr in -30..30 {
        for fq in -30..30 {
          if hex_field::hexset_get(b.cells, fq, fr) {
            (fx, fy) = hexterrain::centre(fq, fr);
            d = sqrt((fx - x) * (fx - x) + (fy - y) * (fy - y));
            if d < near { near = d; }
          }
        }
      }
      if near - 0.75 >= m.blend {
        assert(h == hex_field::height_get(before.heights, q, r), "beyond the blend the ground as it was: ({q}, {r})");
      } else {
        lo = if 5.0 < hex_field::height_get(before.heights, q, r) { 5.0 } else { hex_field::height_get(before.heights, q, r) };
        hi = if 5.0 > hex_field::height_get(before.heights, q, r) { 5.0 } else { hex_field::height_get(before.heights, q, r) };
        assert(h >= lo - 0.000001 && h <= hi + 0.000001, "in the blend, between the floor and the ground: ({q}, {r}) at {h}");
      }
    }
  }
  assert(abs_f(low - lowest) < 0.000001, "the walls go down to the lowest the ground was: {low} against {lowest}");
}

// @FR-HG-Dig: the bed's depth by the distance to its straight sides, full half a bank inside,
// untouched half a bank outside
fn test_a_dug_bed_follows_its_sides() {
  m = measures();
  g = hexterrain::ground_new(-30, -14, 61, 29);
  // a bed four rows deep that steps over by a row twice, and a slanted spur off it
  bed = hex_field::hexset_chunk(-30, -14, 61, 29);
  for i in 0..3 {
    for r in 0..4 {
      for q in (i * 8 - 12)..(i * 8 - 3) { hex_field::hexset_set(bed, q, r + i - 4, true); }
    }
  }
  b = hexhouse::build(hexhouse::HexHouse { cq: 0, cr: 0, turn: 2, parts: hexhouse::box_plan(10, 3) });
  for r in -14..15 { for q in -30..31 { if hex_field::hexset_get(b.cells, q, r) { hex_field::hexset_set(bed, q, r, true); } } }
  hexterrain::dig(g, bed, 2.6, m);
  sides: vector<(float, float, float, float)> = [];
  for o in hexwalls::outlines(bed, 0) {
    n = len(o.corners);
    for i in 0..n {
      (x1, y1) = o.corners[(i + n - 1) % n ?? 0] ?? (0.0, 0.0);
      (x2, y2) = o.corners[i] ?? (0.0, 0.0);
      sides += [(x1 * hexterrain::METRE, y1 * hexterrain::METRE, x2 * hexterrain::METRE, y2 * hexterrain::METRE)];
    }
  }
  full = 0;
  untouched = 0;
  for r in -14..15 {
    for q in -30..31 {
      (x, y) = hexterrain::centre(q, r);
      d = hexterrain::signed_distance(sides, x, y);
      z = hex_field::height_get(g.heights, q, r);
      // the bank's profile, as the rule states it
      t = (d + m.bank * 0.5) / m.bank ?? 0.0;
      c = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t };
      want = -2.6 * c * c * (3.0 - 2.0 * c);
      assert(abs_f(z - want) < 0.000001, "cell ({q}, {r}) at {d} m from the sides: {z}, the profile {want}");
      if d >= m.bank * 0.5 {
        assert(abs_f(z + 2.6) < 0.000001, "half a bank inside: the full depth at ({q}, {r})");
        full += 1;
      }
      if d <= -m.bank * 0.5 {
        assert(abs_f(z) < 0.000001, "half a bank outside: untouched at ({q}, {r})");
        untouched += 1;
      }
      // inside the sides deeper than half way, outside shallower
      if d > 0.0 { assert(z < -1.3 + 0.000001, "inside the sides, below half way at ({q}, {r})"); }
      if d < 0.0 { assert(z > -1.3 - 0.000001, "outside the sides, above half way at ({q}, {r})"); }
    }
  }
  assert(full > 20 && untouched > 200, "both flats there: {full} cells at depth, {untouched} untouched");
}

// @FR-HG-Cliff: cliffs only inside their area, along the level's straight sides; the ground there
// at its level's storey, untouched beyond the blend
fn test_cliffs_only_in_their_areas_and_sharp() {
  m = measures();
  g = hexterrain::ground_new(-20, -20, 41, 41);
  levels = hex_field::labels_new(-20, -20, 41, 41);
  sharp = hex_field::heights_new(-20, -20, 41, 41);
  // level 1 north of the row r = 0, a smooth rise across it
  for r in -20..21 {
    for q in -20..21 {
      lv = if r < 0 { 1 } else { 0 };
      hex_field::label_set(levels, q, r, lv);
      hex_field::height_set(sharp, q, r, (lv as float) * m.storey);
      (x, y) = hexterrain::centre(q, r);
      hex_field::height_set(g.heights, q, r, m.storey * (0.5 - 0.5 * (if y > 3.0 { -1.0 } else if y < -3.0 { 1.0 } else { y / -3.0 })));
    }
  }
  b = hexterrain::Box { x0: -6.0, x1: 6.0, y0: -10.0, y1: 10.0 };
  hexterrain::sharpen(g, sharp, [b], m);
  cs = hexterrain::cliffs(levels, -20, -20, 41, 41, 0, 1, [b]);
  assert(len(cs) > 0, "a cliff along the front in the area");
  for c in cs {
    assert(c.ax >= b.x0 - 0.000001 && c.ax <= b.x1 + 0.000001 && c.bx >= b.x0 - 0.000001 && c.bx <= b.x1 + 0.000001
           && c.ay >= b.y0 - 0.000001 && c.ay <= b.y1 + 0.000001 && c.by >= b.y0 - 0.000001 && c.by <= b.y1 + 0.000001,
           "the cliff ({c.ax}, {c.ay}) .. ({c.bx}, {c.by}) lies in its area");
    // walked with the high ground on its left: the level-1 cells are north (y < 0 is r > 0 ... north is y up)
    mx = (c.ax + c.bx) * 0.5;
    my = (c.ay + c.by) * 0.5;
    lx = mx - (c.by - c.ay) * 0.1;
    ly = my + (c.bx - c.ax) * 0.1;
    (lq, lr) = hexterrain::cell_near(lx, ly);
    assert(hex_field::label_get(levels, lq, lr) >= c.level, "the high side on the cliff's left");
  }
  for r in -20..21 {
    for q in -20..21 {
      (x, y) = hexterrain::centre(q, r);
      z = hex_field::height_get(g.heights, q, r);
      zs = hex_field::height_get(sharp, q, r);
      if hexterrain::box_distance(b, x, y) == 0.0 {
        assert(abs_f(z - zs) < 0.000001, "in the area ({q}, {r}) at its level's storey: {z}");
      }
    }
  }
  // far from the area the smooth rise is untouched: the cell at x = 15 on the front's row
  (fq, fr) = hexterrain::cell_near(15.0, 0.0);
  (fx, fy) = hexterrain::centre(fq, fr);
  assert(hexterrain::box_distance(b, fx, fy) > m.blend, "the far cell lies beyond the blend");
  zf = hex_field::height_get(g.heights, fq, fr);
  assert(zf > 0.1 && zf < m.storey - 0.1, "beyond the blend the front still slopes: {zf}");
}
