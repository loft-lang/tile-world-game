// The flotilla (BUILD.md B5, DESIGN.md @GM-Flotilla; the owner's rules, the numbers proposed):
// beams float where other things are lost; beams that touch link, as carts do; beams fastened with
// rope are stood on (3 or more carry the hero), a lone beam is not; from the raft, open water
// walked into is pushed off into — the raft drifts that way a cell every 500 ms until it touches
// something.  Rope is worn on the shoulders; fastening uses it up.
use tile_world;
use rules;

// A channel: the north shore y 0 .. 2, water y 3 .. 7, the south shore y 8 .. 9, x 0 .. 9, walled.
fn channel() -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, 10, 10, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 9, 9, 0, rules::tr(w, "floor"));
  tile_world::fill(w.w, 0, 3, 9, 7, 0, rules::tr(w, "water"));
  w
}

fn top(w: const rules::Level, x: integer, y: integer) -> text {
  rules::thing_name(w.k, tile_world::top(w.w, x, y, 0))
}

// Three beams set afloat from the shore, on (3, 3), (4, 3), (5, 3).
fn three_beams(w: rules::Level) {
  for x in [3, 4, 5] {
    rules::put_hero(w, x, 2, 0);
    w.hero_item = rules::th(w, "beam");
    assert(rules::walk(w, 0, 1) == rules::Step.Placed && top(w, x, 3) == "floating_beam", "afloat at {x}");
  }
}

fn main() {
  w = channel();
  three_beams(w);
}

// Loose beams do not carry the hero; fastened with the rope (used up) they are a raft, stood on;
// pushed off south from (4, 3) at 0 it drifts — y 4 at 500 .. y 7 at 2000 — and stops there, the
// south shore beside it; the hero steps off onto it.
fn test_a_raft_carries_the_hero_across() {
  w = channel();
  three_beams(w);
  w.hero_item = 0;
  rules::put_hero(w, 4, 2, 0);
  assert(rules::walk(w, 0, 1) == rules::Step.Blocked && w.hero_y == 2, "loose beams: not stepped on");
  w.shoulder = rules::th(w, "rope");
  assert(rules::walk(w, 0, 1) == rules::Step.Placed && w.shoulder == 0, "fastened, the rope used up");
  assert(top(w, 3, 3) == "raft_beam" && top(w, 4, 3) == "raft_beam" && top(w, 5, 3) == "raft_beam", "a raft of three");
  assert(rules::walk(w, 0, 1) == rules::Step.Walked && w.hero_y == 3, "stood on");
  assert(rules::walk(w, 0, 1) == rules::Step.Pushed, "pushed off south");
  rules::tick(w, 499);
  assert(w.hero_y == 3, "499: not yet");
  rules::tick(w, 1);
  assert(w.hero_y == 4 && top(w, 4, 4) == "raft_beam" && top(w, 4, 3) == "", "500: a cell on, the hero with it");
  rules::tick(w, 2500);
  assert(w.hero_y == 7 && top(w, 3, 7) == "raft_beam" && len(w.drifts) == 0, "stopped against the south shore: {w.hero_y}");
  assert(rules::walk(w, 0, 1) == rules::Step.Walked && w.hero_y == 8, "stepped off");
}

// A beam is not lost in water (owner): a bomb going off beside it on the shore flings it in, and
// it floats.  A raft of two is too small to carry the hero.
fn test_a_beam_floats_and_two_are_too_few() {
  w = channel();
  tile_world::place(w.w, 7, 1, 0, rules::th(w, "bomb"));
  tile_world::place(w.w, 7, 2, 0, rules::th(w, "beam"));
  rules::put_hero(w, 1, 0, 0);
  w.fuses += [rules::Fuse { x: 7, y: 1, z: 0, held: false, at: 100 }];
  rules::tick(w, 100);
  afloat = 0;
  for y in 3..=7 { if top(w, 7, y) == "floating_beam" { afloat += 1; } }
  assert(w.blasted == 1 && afloat == 1, "flung in: afloat");
  v = channel();
  for x in [3, 4] {
    rules::put_hero(v, x, 2, 0);
    v.hero_item = rules::th(v, "beam");
    _ = rules::walk(v, 0, 1);
  }
  v.shoulder = rules::th(v, "rope");
  rules::put_hero(v, 4, 2, 0);
  _ = rules::walk(v, 0, 1);
  assert(top(v, 4, 3) == "raft_beam" && rules::walk(v, 0, 1) == rules::Step.Blocked, "two are too few");
}
