// Potions and money (DESIGN.md § The principle, § Goals): a potion is taken with Q (walking over it
// no longer takes it, owner 2026-11-07; what the hand held put down in its place); held, the swing
// key (E) drinks it (owner).  It heals over time,
// never at once (owner): a point every 1500 ms — a health potion 3, up to the start's 6; a spirit
// potion 2 temporary health above it, lost first when the hero is hurt — by a bite, a blast or a
// fall — and never fading.  A chest opened gives its money (10) with its point.
use tile_world;
use rules;

fn row(n: integer) -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, n, 1, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, n - 1, 0, 0, rules::tr(w, "floor"));
  rules::put_hero(w, 0, 0, 0);
  w
}

fn put(w: rules::Level, x: integer, name: text) {
  tile_world::place(w.w, x, 0, 0, rules::th(w, name));
}

fn main() {
  w = row(3);
  assert(w.health == 6 && w.spirit == 0 && w.money == 0, "a fresh hero");
}

fn until(w: rules::Level, at: integer) {
  rules::tick(w, at - w.now);
}

// A step east onto a potion, taken (Q) and drunk (E) at once.
fn drink_next(w: rules::Level) {
  _ = rules::walk(w, 1, 0);
  _ = rules::take(w);
  _ = rules::swing(w);
}

// Hands full — a stick held — a health potion taken and drunk at 0 (the stick put down for it) heals over time
// (owner): nothing at once, a point at 1500, 3000 and 4500 — from 2 to 5 — then no more.
fn test_a_health_potion_heals_over_time() {
  w = row(4);
  w.health = 2;
  w.hero_item = rules::th(w, "stick");
  put(w, 1, "health_potion");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.drunk == 0, "walked onto: not drunk");
  assert(rules::take(w) == rules::Step.Swapped && rules::swing(w) == rules::Step.Drank, "Q, then E");
  assert(w.drunk == 1 && w.health == 2, "drunk, nothing yet: {w.health}");
  assert(tile_world::top(w.w, 1, 0, 0) == rules::th(w, "stick") && w.hero_item == 0, "the stick put down for it, the hands empty");
  until(w, 1499);
  assert(w.health == 2, "1499: still 2");
  until(w, 1500);
  assert(w.health == 3, "1500: 3: {w.health}");
  until(w, 3000);
  assert(w.health == 4, "3000: 4: {w.health}");
  until(w, 4500);
  assert(w.health == 5 && w.heal_due == 0, "4500: 5, and done: {w.health}");
  until(w, 10000);
  assert(w.health == 5, "no more: {w.health}");
}

// Never above the start's 6: from 5, 6 at 1500; the two points after are lost.
fn test_a_health_potion_stops_at_the_start() {
  w = row(3);
  w.health = 5;
  w.hero_item = rules::th(w, "stick");
  put(w, 1, "health_potion");
  drink_next(w);
  until(w, 1500);
  assert(w.health == 6, "1500: 6");
  until(w, 4500);
  assert(w.health == 6 && w.heal_left == 0, "4500: still 6, nothing left to come");
}

// A second potion does not hurry the first: from 1, drunk at 0 and at 1000, the six points come
// one every 1500 ms — 2 at 1500 .. 6 at 7500 — the sixth lost at 9000.
fn test_two_potions_take_their_time() {
  w = row(4);
  w.health = 1;
  w.hero_item = rules::th(w, "stick");
  put(w, 1, "health_potion");
  put(w, 2, "health_potion");
  drink_next(w);
  until(w, 1000);
  drink_next(w);
  until(w, 1500);
  assert(w.health == 2, "1500: 2: {w.health}");
  until(w, 6000);
  assert(w.health == 5, "6000: 5: {w.health}");
  until(w, 7500);
  assert(w.health == 6, "7500: 6: {w.health}");
  until(w, 9000);
  assert(w.health == 6 && w.heal_due == 0, "9000: the last lost, done");
}

// Empty-handed, a potion taken (Q) is held, not drunk (owner): carried, put down elsewhere, taken
// again; the swing key drinks it — the hands empty, the healing to come.
fn test_a_potion_is_picked_up_put_down_and_drunk_later() {
  w = row(4);
  w.health = 3;
  put(w, 1, "health_potion");
  _ = rules::walk(w, 1, 0);
  assert(rules::take(w) == rules::Step.Took, "Q");
  assert(w.hero_item == rules::th(w, "health_potion") && w.drunk == 0 && tile_world::top(w.w, 1, 0, 0) == 0, "picked up");
  _ = rules::walk(w, 1, 0);
  assert(rules::drop(w) == rules::Step.Placed && tile_world::top(w.w, 2, 0, 0) == rules::th(w, "health_potion"), "put down on 2");
  _ = rules::walk(w, 1, 0);
  _ = rules::walk(w, -1, 0);
  assert(rules::take(w) == rules::Step.Took, "Q");
  assert(w.hero_item == rules::th(w, "health_potion") && w.drunk == 0, "picked up again");
  assert(rules::swing(w) == rules::Step.Drank && w.hero_item == 0 && w.drunk == 1 && w.health == 3, "drunk: nothing yet");
  until(w, 1500);
  assert(w.health == 4, "1500: 4: {w.health}");
}

// Healing still to come goes through a door: drunk at 0 from 2, 3 at 1500; the hero through a
// door then into a place whose clock reads 0 — the next point comes 1500 on there.
fn test_healing_to_come_goes_through_a_door() {
  w = row(3);
  w.health = 2;
  w.hero_item = rules::th(w, "stick");
  put(w, 1, "health_potion");
  drink_next(w);
  until(w, 1500);
  c = rules::carried(w);
  v = row(3);
  rules::carry_in(v, c);
  assert(v.health == 3 && v.heal_left == 2 && v.heal_due == 1500, "carried: 3, two to come, the next at 1500: {v.heal_due}");
  until(v, 1500);
  assert(v.health == 4, "there at 1500: 4: {v.health}");
}

// A spirit potion's 2 above the 6 come over time too: 1 at 1500, 2 at 3000.  Then it never fades:
// an hour on, the same.  Hurt 1 (a bite), the spirit goes first: 1 + 6; hurt 3 (a blast beside the
// hero), the last spirit then 2 health: 0 + 4.
fn test_temporary_health_is_lost_first_and_never_fades() {
  w = row(3);
  w.hero_item = rules::th(w, "stick");
  put(w, 1, "spirit_potion");
  drink_next(w);
  assert(w.spirit == 0 && w.health == 6, "nothing at once");
  until(w, 1500);
  assert(w.spirit == 1, "1500: 1");
  until(w, 3000);
  assert(w.spirit == 2 && w.health == 6, "3000: 6 + 2");
  rules::tick(w, 3600000);
  assert(w.spirit == 2, "an hour on, still 2");
  rules::harm(w, 1);
  assert(w.spirit == 1 && w.health == 6, "a bite: spirit first: {w.spirit} + {w.health}");
  rules::harm(w, 3);
  assert(w.spirit == 0 && w.health == 4, "a blast: the last spirit, then health: {w.spirit} + {w.health}");
}

// A rat's bite takes the spirit first, too: the hero 6 + 2 beside a rat; it first acts at 600,
// beside the hero at once, so it winds up then and bites at 900 (@GM-Combat): the spirit is 1.
fn test_a_bite_takes_the_spirit_first() {
  w = row(4);
  w.spirit = 2;
  _ = rules::add_enemy(w, "rat", 1, 0, 0);
  rules::tick(w, 900);
  assert(w.spirit == 1 && w.health == 6, "bitten: {w.spirit} + {w.health}");
}

// A chest opened gives its point and its money.
fn test_a_chest_gives_its_money() {
  w = row(3);
  put(w, 1, "chest");
  assert(rules::walk(w, 1, 0) == rules::Step.Opened && w.points == 1 && w.money == 10, "a point and 10");
}
