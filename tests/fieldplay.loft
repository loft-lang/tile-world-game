// Play on a field with rooms (fieldplay.loft): at each of the twelve angles the hero walks free
// over the ground, in through a room's door onto its tiles, about in it by the room's rules, out
// again, and pushes a rock out through the door and on over the ground — one body, one clock.
use hex_field;
use hex_form;
use hexterrain;
use tile_world;
use rules;
use materials;
use levels;
use gridroom;
use fieldplay;

fn near(a: float, b: float, by: float) -> boolean { a - b < by && b - a < by }

fn far(a: (float, float), b: (float, float)) -> float { sqrt((a.0 - b.0) * (a.0 - b.0) + (a.1 - b.1) * (a.1 - b.1)) ?? 0.0 }

fn place_of(rows: text, things: text, edges: text, w: integer, h: integer, turn: integer) -> gridroom::Room {
  k = rules::kinds();
  raw = "{{\"name\": \"a place\", \"camera\": \"follow\", \"legend\": {{\".\": \"floor\", \"#\": \"wall\"}}, \"ground\": [], \"chunks\": [{{\"cx\": 0, \"cy\": 0, \"z\": 0, \"rows\": [{rows}]}}], \"things\": [{things}], \"tiles\": [], \"edges\": [{edges}], \"rises\": [], \"doors\": []}}";
  lf = levels::load_with(raw, k, materials::load(file("../theme.json").content() ?? "", k));
  if !lf { assert(false, "the place loads"); }
  gridroom::Room { level: lf!.level, w: w, h: h, z: 0, turn: turn }
}

// A room of seven tiles by five, a wall round it, a door in the middle of its south wall, a rock
// in its middle.
fn room(turn: integer) -> gridroom::Room {
  place_of("\"#######\", \"#.....#\", \"#.....#\", \"#.....#\", \"###.###\"", "{{\"at\": [3, 2, 0], \"stack\": [\"rock\"]}}", "", 7, 5, turn)
}

// A terrace of six tiles by four, a low wall round it but for a gate in its east side.
fn terrace(turn: integer) -> gridroom::Room {
  edges = "";
  for x in 0..6 { edges += (if edges == "" { "" } else { ", " }) + "[{x}, 0, 0, \"N\", \"low_wall\"], [{x}, 4, 0, \"N\", \"low_wall\"]"; }
  for y in 0..4 {
    edges += ", [0, {y}, 0, \"W\", \"low_wall\"]";
    if y != 1 { edges += ", [6, {y}, 0, \"W\", \"low_wall\"]"; }
  }
  place_of("\"......\", \"......\", \"......\", \"......\"", "", edges, 6, 4, turn)
}

// The hero comes over the ground to the room's door, in, round the rock and behind it, and walks
// it out through the door and on over the ground; then back in and out of the room.
fn test_the_hero_walks_in_and_out_and_pushes_a_rock_out() {
  for turn in 0..12 {
    p = fieldplay::play(-40, -40, 81, 81);
    id = fieldplay::add_room(p, room(turn), 2.0, -3.0);
    rm = p.rooms[id]!;
    o = rm.openings[0]!;
    (wx, wy) = gridroom::way(o.heading);
    door = gridroom::tile_centre(rm, 3.0, 4.0);
    // from 9 m straight out of the door, towards it: over the ground, onto the hex outside, in
    fieldplay::put_hero(p, door.0 + 9.0 * wx, door.1 + 9.0 * wy);
    before = p.clock;
    assert(p.room == -1 && fieldplay::walk_to(p, door.0, door.1, 5000), "at {30 * turn}: to the door's tile: ({p.x}, {p.y}), refused {p.refused}");
    assert(p.room == id && fieldplay::hero_tile(p).0 == 3 && fieldplay::hero_tile(p).1 == 4, "at {30 * turn}: in the room, on the door's tile: room {p.room} tile ({fieldplay::hero_tile(p).0}, {fieldplay::hero_tile(p).1})");
    // 9 m at 1.5 m in 140 ms: 840 ms, and no step refused
    assert(near(p.walked, 9.0, 0.06) && near((p.clock - before) as float, 840.0, 25.0) && p.refused == 0, "at {30 * turn}: 9 m in 840 ms: {p.walked} m in {p.clock - before} ms, refused {p.refused}");
    assert(rm.level.now == p.clock, "at {30 * turn}: the room is at the field's time: {rm.level.now} {p.clock}");
    // round the rock: a tile into the room, west, north twice, east behind the rock
    for t in [(3.0, 3.0), (2.0, 3.0), (2.0, 1.0), (3.0, 1.0)] {
      c = gridroom::tile_centre(rm, t.0, t.1);
      assert(fieldplay::walk_to(p, c.0, c.1, 3000), "at {30 * turn}: to tile ({t.0}, {t.1})");
    }
    assert(fieldplay::hero_tile(p).0 == 3 && fieldplay::hero_tile(p).1 == 1 && p.refused == 0, "at {30 * turn}: behind the rock");
    rock = tile_world::top(rm.level.w, 3, 2, 0);
    assert(rock != 0, "at {30 * turn}: the rock where it was");
    // straight out: the rock before it, through the door, and 6 m on over the ground
    out = (door.0 + 6.0 * wx, door.1 + 6.0 * wy);
    assert(fieldplay::walk_to(p, out.0, out.1, 8000), "at {30 * turn}: out to 6 m past the door: ({p.x}, {p.y}) refused {p.refused}");
    assert(p.room == -1 && p.refused == 0, "at {30 * turn}: on the ground again, nothing refused: room {p.room}, refused {p.refused}");
    assert(tile_world::top(rm.level.w, 3, 2, 0) == 0 && tile_world::top(rm.level.w, 3, 3, 0) == 0 && tile_world::top(rm.level.w, 3, 4, 0) == 0, "at {30 * turn}: the rock out of the room");
    // the rock: on a hex on the line out of the door, past the hero
    found = 0;
    for r in -40..41 {
      for q in -40..41 {
        if hex_field::label_get(p.ground.things, q, r) == 0 { continue; }
        found += 1;
        c = hexterrain::centre(q, r);
        along = (c.0 - door.0) * wx + (c.1 - door.1) * wy;
        across = (c.0 - door.0) * wy - (c.1 - door.1) * wx;
        assert(hex_field::label_get(p.ground.things, q, r) == rock && near(across, 0.0, 0.01) && along > 6.0 && along < 6.0 + 3.5, "at {30 * turn}: the rock on the line out of the door, before the hero (a hex on, or the next full hex): {along} m out, {across} m off");
      }
    }
    assert(found == 1, "at {30 * turn}: one rock on the ground: {found}");
    // back to the door and in: the room as it was left
    assert(fieldplay::walk_to(p, door.0, door.1, 5000) && p.room == id, "at {30 * turn}: in again");
    assert(rm.level.now == p.clock, "at {30 * turn}: the room brought to the field's time");
  }
}

// What refuses the body: a room's wall from outside and from inside, a tree, a fence; it stays
// where it was, the clock runs on.
fn test_walls_trees_and_fences_refuse_the_body() {
  for turn in 0..12 {
    p = fieldplay::play(-40, -40, 81, 81);
    id = fieldplay::add_room(p, room(turn), 2.0, -3.0);
    rm = p.rooms[id]!;
    // at the room's west wall from outside, 6 m out from the middle of it
    mid = gridroom::tile_centre(rm, 0.0, 2.0);
    (wx, wy) = gridroom::way(gridroom::room_heading(rm, -1, 0));
    fieldplay::put_hero(p, mid.0 + 6.0 * wx, mid.1 + 6.0 * wy);
    clock = p.clock;
    assert(!fieldplay::walk_to(p, mid.0, mid.1, 2000), "at {30 * turn}: not through the wall");
    assert(p.room == -1 && p.refused > 0 && p.clock == clock + 2000, "at {30 * turn}: outside still, the clock run on: {p.clock - clock}");
    (hq, hr) = fieldplay::hero_hex(p);
    assert(hex_field::label_get(p.ground.under, hq, hr) < 0 && far((p.x, p.y), mid) < 2.4, "at {30 * turn}: stopped at the wall, on open ground: {far((p.x, p.y), mid)} m from the wall's tile");
    // from inside at the same wall
    o = rm.openings[0]!;
    door = gridroom::tile_centre(rm, 3.0, 4.0);
    (ox, oy) = gridroom::way(o.heading);
    fieldplay::put_hero(p, door.0 + 3.0 * ox, door.1 + 3.0 * oy);
    for t in [(3.0, 4.0), (3.0, 3.0), (1.0, 3.0)] {
      c = gridroom::tile_centre(rm, t.0, t.1);
      assert(fieldplay::walk_to(p, c.0, c.1, 3000), "at {30 * turn}: to tile ({t.0}, {t.1})");
    }
    refused = p.refused;
    outside = gridroom::tile_centre(rm, -3.0, 3.0);
    assert(!fieldplay::walk_to(p, outside.0, outside.1, 1500) && p.room == id && p.refused > refused, "at {30 * turn}: not out through the wall");
    assert(fieldplay::hero_tile(p).0 == 1 && fieldplay::hero_tile(p).1 == 3, "at {30 * turn}: on the tile beside the wall");
    body = gridroom::tile_at(rm, p.x, p.y);
    assert(body.0 && body.1 == 1 && body.2 == 3, "at {30 * turn}: and the body on that tile too, not in the wall: ({body.1}, {body.2})");
  }
  // a tree and a fence on the open ground
  p = fieldplay::play(-20, -20, 41, 41);
  hex_field::hexset_set(p.ground.fixed, 4, 0, true);
  fieldplay::put_hero(p, 0.0, 0.0);
  tree = hexterrain::centre(4, 0);
  assert(!fieldplay::walk_to(p, tree.0, tree.1, 2000) && fieldplay::hero_hex(p).0 == 3 && fieldplay::hero_hex(p).1 == 0, "stopped on the hex before the tree: ({fieldplay::hero_hex(p).0}, {fieldplay::hero_hex(p).1})");
  hex_field::edge_set_mat(p.ground.fences, -2, 0, -3, 0, 1);
  fieldplay::put_hero(p, 0.0, 0.0);
  west = hexterrain::centre(-5, 0);
  assert(!fieldplay::walk_to(p, west.0, west.1, 2000) && fieldplay::hero_hex(p).0 == -2, "stopped at the fence: ({fieldplay::hero_hex(p).0}, {fieldplay::hero_hex(p).1})");
}

// Two rooms at their own angles on one field: out of the one's door, over the ground, in at the
// other's gate — the body never leaves the one space, and the clock is one.
fn test_from_one_room_to_another_over_the_ground() {
  for turn in 0..12 {
    p = fieldplay::play(-50, -50, 101, 101);
    a = fieldplay::add_room(p, room(turn), -10.0, 6.0);
    // the terrace 20 m out from the room's door, its gate towards it: turned a quarter on
    first = p.rooms[a]!;
    (fx, fy) = gridroom::way(first.openings[0]!.heading);
    from = gridroom::tile_centre(first, 3.0, 4.0);
    tb = hex_form::head_norm(first.openings[0]!.heading + 6);
    (ex, ey) = gridroom::way(tb);
    (sx, sy) = gridroom::way(tb + 9);
    b = fieldplay::add_room(p, terrace(tb), from.0 + 20.0 * fx - (5.0 * ex + 1.0 * sx) * 1.5, from.1 + 20.0 * fy - (5.0 * ey + 1.0 * sy) * 1.5);
    ra = p.rooms[a]!;
    rb = p.rooms[b]!;
    door = gridroom::tile_centre(ra, 3.0, 4.0);
    fieldplay::put_hero(p, hexterrain::centre(ra.openings[0]!.q, ra.openings[0]!.r).0, hexterrain::centre(ra.openings[0]!.q, ra.openings[0]!.r).1);
    assert(fieldplay::walk_to(p, door.0, door.1, 2000) && p.room == a, "at {30 * turn}: in the room");
    // out, to 4 m before the terrace's gate, then in through it
    gate = rb.openings[0]!;
    (gx, gy) = gridroom::way(gate.heading);
    gate_tile = gridroom::tile_centre(rb, gate.x as float, gate.y as float);
    step = hexterrain::centre(ra.openings[0]!.q, ra.openings[0]!.r);
    assert(fieldplay::walk_to(p, step.0, step.1, 2000) && p.room == -1, "at {30 * turn}: out of the room");
    (ax, ay) = gridroom::way(ra.openings[0]!.heading);
    for stop in [(step.0 + 5.0 * ax, step.1 + 5.0 * ay), (gate_tile.0 + 6.0 * gx, gate_tile.1 + 6.0 * gy), (gate_tile.0, gate_tile.1)] {
      fieldplay::walk_to(p, stop.0, stop.1, 12000);
    }
    assert(p.room == b && fieldplay::hero_tile(p).0 == gate.x && fieldplay::hero_tile(p).1 == gate.y, "at {30 * turn}: on the terrace, at its gate: room {p.room} at ({p.x}, {p.y}), refused {p.refused}");
    assert(rb.level.now == p.clock && ra.level.now < p.clock, "at {30 * turn}: the terrace at the field's time, the room left behind at the time it was left");
  }
}
