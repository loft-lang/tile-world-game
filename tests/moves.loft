//
// The world model and the traversal rules, each a small scene played out move by move; the
// expected positions, stacks and steps are worked out by hand in each cell.  A failing cell
// prints the layer as `view` draws it.
use tile_world;
use rules;

// A floor row from x 0 to `n - 1` on layer 0, y 0, with walls round it.
fn row(n: integer) -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, n, 1, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, n - 1, 0, 0, rules::tr(w, "floor"));
  w
}

fn at(w: const rules::Level) -> text {
  "{w.hero_x},{w.hero_y},{w.hero_z} h{w.hero_h}"
}

fn show(w: const rules::Level, n: integer) -> text {
  rules::view(w, -1, -1, n, 1, w.hero_z)
}

fn main() {
  w = rules::level(rules::kinds());
  assert(tile_world::terrain(w.w, 5, 5, 0) == tile_world::VOID, "an empty world is void");
}



// Walls and water stop the hero; so does the void.
fn test_walls_and_water_block() {
  w = row(4);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "water"));
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 0, -1) == rules::Step.Blocked, "the wall north");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "east onto floor");
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked, "the river");
  assert(at(w) == "1,0,0 h0", "stopped at 1: {at(w)}\n{show(w, 4)}");
}

// Rails at x 1..3; a cart at 1 is pushed to 2 and to 3; pushed on past the rails' end, onto free
// floor, it derails there (tests/tracks.loft has the rest).
fn test_cart_runs_on_rails() {
  w = row(6);
  tile_world::fill(w.w, 1, 0, 3, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "cart"));
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "first push");
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "second push");
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "past the end: derailed");
  assert(tile_world::top(w.w, 4, 0, 0) == rules::th(w, "derailed_cart") && at(w) == "3,0,0 h0",
         "a derailed cart at 4, the hero at 3: {at(w)}\n{show(w, 6)}");
}

// Pulling a cart: the hero at 2 walks west and the cart at 3 follows onto 2, and again onto 1
// (the cell the hero left is rail each time).  From the floor at 4 the hero pulls east: the
// cell it leaves is no rail, so the cart at 3 stays and the hero walks alone.
fn test_cart_is_pulled_along_rails() {
  w = row(6);
  tile_world::fill(w.w, 1, 0, 3, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "cart"));
  rules::put_hero(w, 2, 0, 0);
  assert(rules::pull(w, -1, 0) == rules::Step.Pulled, "pulled");
  assert(tile_world::top(w.w, 2, 0, 0) == rules::th(w, "cart") && at(w) == "1,0,0 h0",
         "cart at 2, hero at 1: {at(w)}\n{show(w, 6)}");
  assert(rules::pull(w, -1, 0) == rules::Step.Pulled, "pulled again");
  assert(tile_world::top(w.w, 1, 0, 0) == rules::th(w, "cart") && at(w) == "0,0,0 h0",
         "cart at 1, hero at 0: {at(w)}\n{show(w, 6)}");
  v = row(6);
  tile_world::fill(v.w, 1, 0, 3, 0, 0, rules::tr(v, "rail"));
  tile_world::place(v.w, 3, 0, 0, rules::th(v, "cart"));
  rules::put_hero(v, 4, 0, 0);
  assert(rules::pull(v, 1, 0) == rules::Step.Walked, "the hero walks off alone");
  assert(tile_world::top(v.w, 3, 0, 0) == rules::th(v, "cart") && tile_world::top(v.w, 4, 0, 0) == 0,
         "the cart stays on its rails\n{show(v, 6)}");
}

// A rock on the rails stops a pushed cart; the cart does not push it on.  The rock itself is
// pushed, never pulled, and is not pushed into a cart or another rock.
fn test_rock_blocks_rails_and_is_only_pushed() {
  w = row(7);
  tile_world::fill(w.w, 1, 0, 5, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "rock"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h1",
         "the cart cannot push the rock: the hero climbs onto the cart: {at(w)}");
  assert(tile_world::top(w.w, 3, 0, 0) == rules::th(w, "rock"), "the rock stays");
  // Round the other side: the hero at 4 pushes the rock west into the cart — blocked.
  rules::put_hero(w, 4, 0, 0);
  assert(rules::walk(w, -1, 0) == rules::Step.Blocked, "a rock is not pushed into a cart");
  // Pulling the rock east: the hero walks to 5 and the rock stays at 3.
  assert(rules::pull(w, 1, 0) == rules::Step.Walked, "a rock is not pulled");
  assert(tile_world::top(w.w, 3, 0, 0) == rules::th(w, "rock"), "still at 3");
  // An anvil is the same: pushed off the rails onto the floor at 6.
  tile_world::place(w.w, 5, 0, 0, rules::th(w, "anvil"));
  rules::put_hero(w, 4, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "the anvil is pushed");
  assert(tile_world::top(w.w, 6, 0, 0) == rules::th(w, "anvil"), "onto the floor at 6\n{show(w, 7)}");
  tile_world::place(w.w, 0, 0, 0, rules::th(w, "rock"));
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "rock"));
  rules::put_hero(w, 2, 0, 0);
  // A rock is a big thing (height 2, stood on like a chest): from the cart the hero climbs onto
  // it; it is not pushed into the rock behind it.
  assert(rules::walk(w, -1, 0) == rules::Step.Walked && w.hero_x == 1 && w.hero_h == 2, "climbed onto the rock");
  assert(tile_world::top(w.w, 0, 0, 0) == rules::th(w, "rock") && len(tile_world::things(w.w, 1, 0, 0)) == 1,
         "not pushed into the rock behind");
}

// A chair is pushed across the floor; against a table it cannot go on, so the hero climbs onto
// it (height 1) and from it onto the table (height 2), and steps down to the floor.
fn test_chair_climbs_tables() {
  w = row(6);
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "chair"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "table"));
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "the chair slides to 2");
  assert(tile_world::top(w.w, 2, 0, 0) == rules::th(w, "chair"), "at 2");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "against the table: onto the chair");
  assert(at(w) == "2,0,0 h1", "on the chair: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "onto the table");
  assert(at(w) == "3,0,0 h2", "on the table: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "down to the floor");
  assert(at(w) == "4,0,0 h0", "on the floor: {at(w)}");
  // From the floor a table is two steps up: blocked.
  assert(rules::walk(w, -1, 0) == rules::Step.Blocked, "a table from the floor");
}

// The way up a layer: the hero on a table pulls a chair from the floor up onto it, steps onto
// it from a second table, and climbs onto the floor of layer 1; walking back into the void over
// the stack climbs down onto it.
//
//   layer 0:  . h T T .        layer 1:        . .
//            x 0 1 2 3 4                       x 2 3 (floor over the tables' row, beside x 1)
fn test_a_chair_on_a_table_reaches_the_next_layer() {
  w = row(5);
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "chair"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "table"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "table"));
  tile_world::fill(w.w, 2, -1, 3, -1, 1, rules::tr(w, "floor"));
  rules::put_hero(w, 0, 0, 0);
  // The chair cannot slide into the table: the hero climbs it, then the table at 2.
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "onto the chair");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "onto the first table");
  // Back west the hero steps down onto the chair; east again, then pull: walking on to the
  // second table drags the chair from 1 up onto the first table.
  assert(rules::walk(w, -1, 0) == rules::Step.Walked, "down onto the chair");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "back on the table");
  assert(rules::walk(w, -1, 0) == rules::Step.Walked, "on the chair again");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "and on the table");
  // Stand on the first table (x 2) with the chair behind at x 1: pull east.
  assert(rules::pull(w, 1, 0) == rules::Step.Pulled, "the chair is lifted onto the table");
  assert(at(w) == "3,0,0 h2", "on the second table: {at(w)}");
  // Layer 1's floor is north of this table too, but a table alone (height 2) is not enough.
  assert(rules::walk(w, 0, -1) == rules::Step.Blocked, "no climb from height 2");
  assert(tile_world::height(w.w, 2, 0, 0) == 3, "table and chair stand 3 high");
  // From the second table (2) onto the stack (3) is one step up.
  assert(rules::walk(w, -1, 0) == rules::Step.Walked, "onto the chair on the table");
  assert(at(w) == "2,0,0 h3", "at height 3: {at(w)}");
  // North of the stack is layer 1's floor: the climb.
  assert(rules::walk(w, 0, -1) == rules::Step.Climbed, "up a layer");
  assert(at(w) == "2,-1,1 h0", "on layer 1: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "walk on layer 1");
  assert(rules::walk(w, -1, 0) == rules::Step.Walked, "back");
  // South, over the stack, is void on layer 1: the climb down onto it.
  assert(rules::walk(w, 0, 1) == rules::Step.Climbed, "down onto the stack");
  assert(at(w) == "2,0,0 h3", "back at height 3: {at(w)}");
}

// A chair is pushed along a row of tables at table height.
fn test_chair_slides_along_tables() {
  w = row(5);
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "table"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "table"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "chair"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "table"));
  rules::put_hero(w, 1, 0, 0);
  w.hero_h = 2;
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed along");
  assert(tile_world::height(w.w, 3, 0, 0) == 3 && tile_world::height(w.w, 2, 0, 0) == 2,
         "the chair is on the third table");
  assert(at(w) == "2,0,0 h2", "the hero on the second: {at(w)}");
}

fn test_view() {
  w = row(4);
  tile_world::set_terrain(w.w, 1, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "cart"));
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "water"));
  rules::put_hero(w, 0, 0, 0);
  got = rules::view(w, -1, -1, 4, 1, 0);
  assert(got == "######\n#@c~.#\n######\n", "got\n{got}");
}

// A train of carts: rails at x 1..8, carts at 2, 3, 4.  The hero at 1 pushes all three on to
// 3, 4, 5 (strength 3).  A fourth cart at 6 makes a train of four from 3: too heavy.
fn test_a_train_is_pushed_up_to_the_strength() {
  w = row(10);
  tile_world::fill(w.w, 1, 0, 8, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 4, 0, 0, rules::th(w, "cart"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "three carts pushed");
  assert(rules::train(w, 3, 0, 0, 1, 0) == 3 && tile_world::top(w.w, 2, 0, 0) == 0,
         "now at 3, 4, 5\n{show(w, 10)}");
  tile_world::place(w.w, 6, 0, 0, rules::th(w, "cart"));
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "3,0,0 h1"
         && rules::train(w, 3, 0, 0, 1, 0) == 4, "four are too heavy: not pushed, climbed: {at(w)}");
  assert(rules::push_strength(w) == 3 && rules::pull_strength(w) == 2, "the strengths");
}

// A train stops at a rock even when the hero is strong enough.
fn test_a_train_stops_at_a_rock() {
  w = row(8);
  tile_world::fill(w.w, 1, 0, 6, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 4, 0, 0, rules::th(w, "rock"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h1"
         && tile_world::top(w.w, 3, 0, 0) == rules::th(w, "cart"), "the rock holds the train; climbed: {at(w)}");
}

// Pulling: a train of two behind the hero follows one cell; a train of three is too heavy, and
// the hero walks off alone.
fn test_a_train_is_pulled_up_to_the_strength() {
  w = row(10);
  tile_world::fill(w.w, 1, 0, 8, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 4, 0, 0, rules::th(w, "cart"));
  rules::put_hero(w, 2, 0, 0);
  assert(rules::pull(w, -1, 0) == rules::Step.Pulled, "two pulled");
  assert(rules::train(w, 2, 0, 0, 1, 0) == 2 && tile_world::top(w.w, 4, 0, 0) == 0,
         "now at 2, 3\n{show(w, 10)}");
  v = row(10);
  tile_world::fill(v.w, 1, 0, 8, 0, 0, rules::tr(v, "rail"));
  tile_world::place(v.w, 3, 0, 0, rules::th(v, "cart"));
  tile_world::place(v.w, 4, 0, 0, rules::th(v, "cart"));
  tile_world::place(v.w, 5, 0, 0, rules::th(v, "cart"));
  rules::put_hero(v, 2, 0, 0);
  assert(rules::pull(v, -1, 0) == rules::Step.Walked, "three are too heavy to pull");
  assert(rules::train(v, 3, 0, 0, 1, 0) == 3, "the train stayed\n{show(v, 10)}");
}

// A green potion, used by walking onto it, adds 2 to both strengths for 60000 ms of the world's
// clock: four carts pushed and three pulled while it lasts, and not a millisecond after.
fn test_a_potion_strengthens_for_a_minute() {
  w = row(12);
  tile_world::fill(w.w, 2, 0, 10, 0, 0, rules::tr(w, "rail"));
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "potion"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 4, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 5, 0, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 6, 0, 0, rules::th(w, "cart"));
  rules::put_hero(w, 0, 0, 0);
  rules::tick(w, 1000);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "onto the potion");
  assert(tile_world::top(w.w, 1, 0, 0) == 0 && w.boost_until == 61000, "used up, strong until 61000");
  assert(rules::push_strength(w) == 5 && rules::pull_strength(w) == 4, "5 and 4");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "onto the rail at 2");
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "four carts pushed");
  assert(rules::train(w, 4, 0, 0, 1, 0) == 4, "now at 4..7\n{show(w, 12)}");
  rules::tick(w, 59999);
  assert(rules::boosted(w), "still strong at 60999");
  rules::tick(w, 1);
  assert(!rules::boosted(w) && rules::push_strength(w) == 3, "back to 3 at 61000");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.hero_h == 1 && rules::train(w, 4, 0, 0, 1, 0) == 4,
         "four are too heavy again: climbed, not pushed");
}


// A chest never moves.  Walked into, it opens — a point, one move, the hero staying put — and
// stays where it is; it is not pulled either.  An open chest is climbed like a table from a
// chair (1, then 2), but holds no chair.
fn test_a_chest_opens_and_is_climbed_from_a_chair() {
  w = row(7);
  chest = rules::th(w, "chest");
  open = rules::th(w, "open_chest");
  tile_world::place(w.w, 2, 0, 0, chest);
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Opened && at(w) == "1,0,0 h0", "opened: {at(w)}");
  assert(tile_world::top(w.w, 2, 0, 0) == open && w.points == 1, "open where it stood, a point");
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked && at(w) == "1,0,0 h0", "not pushed, too high: {at(w)}");
  assert(rules::pull(w, -1, 0) == rules::Step.Walked && tile_world::top(w.w, 2, 0, 0) == open, "never pulled");
  // A chair at 4, a chest at 5: onto the chair (1); the closed chest opens first, then the
  // hero steps onto it (2).
  v = row(7);
  tile_world::place(v.w, 4, 0, 0, rules::th(v, "chair"));
  tile_world::place(v.w, 5, 0, 0, chest);
  rules::put_hero(v, 3, 0, 0);
  assert(rules::walk(v, 1, 0) == rules::Step.Walked && v.hero_h == 1, "onto the chair");
  assert(rules::walk(v, 1, 0) == rules::Step.Opened && v.hero_h == 1, "the chest opens");
  assert(rules::walk(v, 1, 0) == rules::Step.Walked && at(v) == "5,0,0 h2", "onto the chest: {at(v)}");
  // On the chest, pulling the chair from the floor west of it: a chest holds no chair.
  assert(rules::pull(v, 1, 0) != rules::Step.Pulled, "the chair stays on the floor");
  assert(tile_world::top(v.w, 4, 0, 0) == rules::th(v, "chair"), "still at 4");
}

// A signpost is read, not walked through, and tells how many chests are still closed.
//
//   C . ! C
//  x 0 1 2 3
fn test_the_signpost_counts_closed_chests() {
  w = row(4);
  tile_world::place(w.w, 0, 0, 0, rules::th(w, "chest"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "signpost"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "chest"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Read && at(w) == "1,0,0 h0", "read: {at(w)}");
  assert(rules::closed(w) == 2, "two closed, got {rules::closed(w)}");
  assert(rules::walk(w, -1, 0) == rules::Step.Opened && rules::closed(w) == 1, "one left");
}

// A slope: rises 1, 2, 3 at x 1..3 climb a step at a time, and its top (3) is one step below
// layer 1's floor at x 4, a layer (4 steps) up.  Back west over the void of layer 1 steps down
// onto the slope's top.
//
//   layer 0:  . 1 2 3 . .     layer 1:          .
//            x 0 1 2 3 4 5                      x 4
fn slope() -> rules::Level {
  w = row(6);
  tile_world::set_rise(w.w, 1, 0, 0, 1);
  tile_world::set_rise(w.w, 2, 0, 0, 2);
  tile_world::set_rise(w.w, 3, 0, 0, 3);
  tile_world::set_terrain(w.w, 4, 0, 1, rules::tr(w, "floor"));
  w
}

fn test_a_slope_reaches_the_next_layer() {
  w = slope();
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "1,0,0 h1", "a step up: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h2", "another: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "3,0,0 h3", "the top: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Climbed && at(w) == "4,0,1 h0", "onto layer 1: {at(w)}");
  assert(rules::walk(w, -1, 0) == rules::Step.Climbed && at(w) == "3,0,0 h3", "back down onto the top: {at(w)}");
  assert(rules::walk(w, -1, 0) == rules::Step.Walked && at(w) == "2,0,0 h2", "down the slope: {at(w)}");
}

// Two steps up at once is too steep: x 1 flattened leaves rise 2 beside the floor.
fn test_a_steep_rise_blocks() {
  w = slope();
  tile_world::set_rise(w.w, 1, 0, 0, 0);
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked && at(w) == "1,0,0 h0", "two steps up: {at(w)}");
}

// A ledge `levels` layers up at x 4, the void east of it down to layer 0's floor at x 5.
fn ledge(levels: integer) -> rules::Level {
  w = row(6);
  tile_world::set_terrain(w.w, 4, 0, levels, rules::tr(w, "floor"));
  rules::put_hero(w, 4, 0, levels);
  w
}

// Off the ledge east into the void: a fall of 1, 2 and 3 layers costs 1, 3 and 6 of the
// hero's 6 health (kinds.json), and lands on the floor below.  A chair there (1) makes a
// one-layer drop three steps: no fall, no cost.  With no health left the hero moves no more.
fn test_falls_cost_health() {
  one = ledge(1);
  assert(one.health == 6, "full health: {one.health}");
  assert(rules::walk(one, 1, 0) == rules::Step.Fell && at(one) == "5,0,0 h0", "a layer: {at(one)}");
  assert(one.health == 5, "costs 1: {one.health}");
  chair = ledge(1);
  tile_world::place(chair.w, 5, 0, 0, rules::th(chair, "chair"));
  assert(rules::walk(chair, 1, 0) == rules::Step.Climbed && at(chair) == "5,0,0 h1", "onto the chair: {at(chair)}");
  assert(chair.health == 6, "costs nothing: {chair.health}");
  two = ledge(2);
  assert(rules::walk(two, 1, 0) == rules::Step.Fell && at(two) == "5,0,0 h0" && two.health == 3,
         "two layers cost 3: {at(two)} {two.health}");
  three = ledge(3);
  assert(rules::walk(three, 1, 0) == rules::Step.Fell && three.health == 0, "three cost 6: {three.health}");
  assert(!rules::alive(three) && rules::walk(three, -1, 0) == rules::Step.Blocked, "no health, no moves");
}

// With nothing below the void — no layer under it holds that cell — the step is not taken.
fn test_no_fall_into_nothing() {
  w = rules::level(rules::kinds());
  tile_world::set_terrain(w.w, 0, 0, 1, rules::tr(w, "floor"));
  rules::put_hero(w, 0, 0, 1);
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked && at(w) == "0,0,1 h0", "nothing below: {at(w)}");
  assert(w.health == 6, "unhurt");
}

// A ceiling over the slope's top (layer 1 set over x 3): the hero does not climb up through it,
// and walks on east, down to the floor of its own layer.
fn test_no_climb_through_a_ceiling() {
  w = slope();
  tile_world::set_terrain(w.w, 3, 0, 1, rules::tr(w, "floor"));
  rules::put_hero(w, 3, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "4,0,0 h0", "under the ceiling: {at(w)}");
}

// A tree stops the hero but not light or sight.
fn test_a_tree_blocks_and_lets_light_through() {
  w = row(4);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "tree"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked && at(w) == "1,0,0 h0", "the tree: {at(w)}");
  assert(!tile_world::opaque(w.w, 2, 0, 0), "light passes the tree");
  assert(tile_world::line_of_sight(w.w, 1, 0, 3, 0, 0), "and so does sight");
}

// A fence cell is climbed like a one-step stack, and keeps things off: a chair pushed at it
// stays, so the hero climbs the chair (1), steps onto the fence (1) and down beyond (0).
//
//   . h % .
//  x 0 1 2 3
fn test_the_hero_climbs_a_fence_and_nothing_crosses_it() {
  w = row(4);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "fence"));
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "chair"));
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "1,0,0 h1", "onto the chair, not pushed: {at(w)}");
  assert(tile_world::top(w.w, 1, 0, 0) == rules::th(w, "chair"), "the chair stays at x 1");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h1", "onto the fence: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "3,0,0 h0", "over it: {at(w)}");
  // Pulling the chair back west from x 3 would drag it onto the fence: the hero walks, alone.
  rules::put_hero(w, 0, 0, 0);
  _ = rules::walk(w, 1, 0);
  rules::put_hero(w, 2, 0, 0);
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "chair"));
  assert(rules::pull(w, -1, 0) == rules::Step.Walked, "not dragged onto the fence");
  assert(tile_world::top(w.w, 3, 0, 0) == rules::th(w, "chair"), "the chair stays at x 3");
}

// A fence edge between x 1 and x 2: the hero climbs over it; a chair pushed at it does not
// cross, so the hero climbs the chair instead.  A wall edge there stops the hero.
fn test_a_fence_edge_is_climbed_over() {
  w = row(4);
  tile_world::set_edge(w.w, 2, 0, 0, tile_world::WEST, rules::ed(w, "fence"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h0", "over the fence: {at(w)}");
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "chair"));
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "1,0,0 h1", "the chair stays: {at(w)}");
  tile_world::set_edge(w.w, 2, 0, 0, tile_world::WEST, rules::ed(w, "wall"));
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked && at(w) == "1,0,0 h1", "a wall edge: {at(w)}");
}

// Walking into a closed door opens it — one move, the hero stays — and it no longer stops
// light; the next step goes through.
fn test_a_door_opens() {
  w = row(4);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "door"));
  rules::put_hero(w, 1, 0, 0);
  assert(tile_world::opaque(w.w, 2, 0, 0), "a closed door stops light");
  assert(rules::walk(w, 1, 0) == rules::Step.Opened && at(w) == "1,0,0 h0", "opened: {at(w)}");
  assert(tile_world::terrain(w.w, 2, 0, 0) == rules::tr(w, "open_door"), "it is open");
  assert(!tile_world::opaque(w.w, 2, 0, 0), "and lets light through");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h0", "through it: {at(w)}");
}

// Stairs up at x 2 on layer 0 take the hero to x 2 on layer 1, where stairs down stand; it
// lands there without going down again.  Back onto them from x 3 takes it down, onto the
// stairs up, which do not take it up again.  With nothing to stand on above, the stairs up
// are only floor.
//
//   layer 1:    . > .        layer 0:  . . < .
//              x 1 2 3                x 0 1 2 3
fn test_stairs_change_layer() {
  w = row(4);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "stairs_up"));
  tile_world::fill(w.w, 1, 0, 3, 0, 1, rules::tr(w, "floor"));
  tile_world::set_terrain(w.w, 2, 0, 1, rules::tr(w, "stairs_down"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Climbed && at(w) == "2,0,1 h0", "up the stairs: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "3,0,1 h0", "off them: {at(w)}");
  assert(rules::walk(w, -1, 0) == rules::Step.Climbed && at(w) == "2,0,0 h0", "down the stairs: {at(w)}");
  assert(rules::walk(w, -1, 0) == rules::Step.Walked && at(w) == "1,0,0 h0", "off them: {at(w)}");
  tile_world::set_terrain(w.w, 2, 0, 1, tile_world::VOID);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h0", "nothing above: {at(w)}");
}

// Picked up on the way, an axe fells the tree at x 2 and the fence at x 3 to floor: each one
// move, the hero staying put, and the next step walks on.
fn test_an_axe_fells_trees_and_fences() {
  w = row(5);
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "axe"));
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "tree"));
  tile_world::set_terrain(w.w, 3, 0, 0, rules::tr(w, "fence"));
  rules::put_hero(w, 0, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.hero_item == rules::th(w, "axe"), "the axe taken");
  for k in 0..3 {
    assert(rules::walk(w, 1, 0) == rules::Step.Chopped && tile_world::terrain(w.w, 2, 0, 0) == rules::tr(w, "tree"),
           "blow {k + 1}: still standing");
  }
  assert(rules::walk(w, 1, 0) == rules::Step.Chopped && at(w) == "1,0,0 h0", "the tree felled: {at(w)}");
  assert(tile_world::terrain(w.w, 2, 0, 0) == rules::tr(w, "floor"), "to floor");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && at(w) == "2,0,0 h0", "where it stood: {at(w)}");
  assert(rules::walk(w, 1, 0) == rules::Step.Chopped && at(w) == "2,0,0 h0", "the fence, not climbed: {at(w)}");
  assert(tile_world::terrain(w.w, 3, 0, 0) == rules::tr(w, "floor"), "the fence to floor");
}

// A three-row room x 0 .. 5, y 0 .. 2, walled; the hero swings east from (1, 1), so the tree at
// (2, 1) drops its sticks north (y 0) or south (y 2), the side its place prefers first.
fn grove() -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, 6, 3, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 5, 2, 0, rules::tr(w, "floor"));
  tile_world::set_terrain(w.w, 2, 1, 0, rules::tr(w, "tree"));
  rules::put_hero(w, 1, 1, 0);
  w.hero_item = rules::th(w, "axe");
  w
}

fn top_name(w: const rules::Level, x: integer, y: integer) -> text {
  rules::thing_name(w.k, tile_world::top(w.w, x, y, 0))
}

// Each blow leaves a stick beside the tree, while there is room: the preferred side, then the
// other, then none.  The fourth blow fells it; the sticks stay.
fn test_a_tree_drops_sticks_and_falls_at_the_fourth_blow() {
  w = grove();
  s = if rules::prefers_right(2, 1, 0) { 2 } else { 0 };
  o = 2 - s;
  assert(rules::walk(w, 1, 0) == rules::Step.Chopped && top_name(w, 2, s) == "stick", "blow 1: a stick at y {s}");
  assert(rules::walk(w, 1, 0) == rules::Step.Chopped && top_name(w, 2, o) == "stick", "blow 2: the other side");
  assert(rules::walk(w, 1, 0) == rules::Step.Chopped, "blow 3: no room, still a blow");
  assert(tile_world::terrain(w.w, 2, 1, 0) == rules::tr(w, "tree"), "standing after three");
  assert(rules::walk(w, 1, 0) == rules::Step.Chopped && tile_world::terrain(w.w, 2, 1, 0) == rules::tr(w, "floor"),
         "felled at the fourth");
  assert(len(tile_world::things(w.w, 2, s, 0)) == 1 && len(tile_world::things(w.w, 2, o, 0)) == 1
         && len(tile_world::things(w.w, 2, 1, 0)) == 0, "two sticks, one a cell");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.hero_x == 2, "where it stood");
}

// A tree on a ledge: the drops beside it on layer 0 are void, layer -1 is floor below.  Its sticks
// fall there — the preferred side, then the other — and the deeper drop or a taken cell below
// steer them as on the level.
fn ledge_tree() -> rules::Level {
  w = grove();
  tile_world::fill(w.w, -1, -1, 6, 3, -1, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 5, 2, -1, rules::tr(w, "floor"));
  tile_world::set_terrain(w.w, 2, 0, 0, tile_world::VOID);
  tile_world::set_terrain(w.w, 2, 2, 0, tile_world::VOID);
  w
}

fn below(w: const rules::Level, x: integer, y: integer, z: integer) -> text {
  rules::thing_name(w.k, tile_world::top(w.w, x, y, z))
}

fn test_a_ledge_tree_drops_its_sticks_below() {
  w = ledge_tree();
  s = if rules::prefers_right(2, 1, 0) { 2 } else { 0 };
  o = 2 - s;
  _ = rules::walk(w, 1, 0);
  assert(below(w, 2, s, -1) == "stick", "blow 1: fallen to layer -1 at y {s}");
  // Blow 2 falls the same side, onto the first stick: it lands beside it, east or west as that
  // place below prefers for a fall going (0, dy).
  dy = if s == 2 { 1 } else { -1 };
  bx = if rules::prefers_right(2, s, -1) { 2 - dy } else { 2 + dy };
  _ = rules::walk(w, 1, 0);
  assert(below(w, bx, s, -1) == "stick", "blow 2: beside the first, at x {bx}");
  // Blow 3 falls there too and takes the other cell beside; blow 4 finds no room (both sides
  // taken, a wall straight on) and is gone.
  _ = rules::walk(w, 1, 0);
  assert(below(w, 4 - bx, s, -1) == "stick", "blow 3: the other side of the pile, x {4 - bx}");
  _ = rules::walk(w, 1, 0);
  assert(tile_world::terrain(w.w, 2, 1, 0) == rules::tr(w, "floor"), "felled at the fourth");
  assert(len(tile_world::stacks(w.w)) == 3, "three sticks; the fourth fell to nowhere: {len(tile_world::stacks(w.w))}");
  v = ledge_tree();
  tile_world::set_terrain(v.w, 2, s, -1, tile_world::VOID);
  tile_world::fill(v.w, 0, 0, 5, 2, -2, rules::tr(v, "floor"));
  _ = rules::walk(v, 1, 0);
  assert(below(v, 2, s, -2) == "stick", "two layers down");
  u = ledge_tree();
  tile_world::place(u.w, 2, s, -1, rules::th(u, "rock"));
  _ = rules::walk(u, 1, 0);
  st = tile_world::things(u.w, 2, s, -1);
  assert(len(st) == 2 && below(u, 2, s, -1) == "stick", "a stone below: the stick rests on it");
  assert(o == 2 - s, "the other side unused: {below(u, 2, o, -1)}");
}

// A stone is a big thing: height 2, stood on like a chest — not from the floor, from a chair.
fn test_a_stone_is_stood_on_like_a_chest() {
  w = row(5);
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "rock"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "rock"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked, "two steps up from the floor: no");
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "chair"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.hero_h == 2, "from the chair: onto the stone");
}

// A stone pushed along carries the item resting on it; a chest opened keeps it on top; the hero
// puts an item down on a big thing it stands on, not on a chair.
fn test_a_big_thing_keeps_its_item() {
  w = row(6);
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "rock"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "stick"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "the stone pushed");
  st = "";
  for t in tile_world::things(w.w, 3, 0, 0) { st += "{rules::thing_name(w.k, t)},"; }
  assert(st == "rock,stick," && w.hero_item == 0, "the stick rode along: {st}");
  v = row(5);
  tile_world::place(v.w, 2, 0, 0, rules::th(v, "chest"));
  tile_world::place(v.w, 2, 0, 0, rules::th(v, "stick"));
  rules::put_hero(v, 1, 0, 0);
  assert(rules::walk(v, 1, 0) == rules::Step.Opened && v.points == 1, "opened");
  st = "";
  for t in tile_world::things(v.w, 2, 0, 0) { st += "{rules::thing_name(v.k, t)},"; }
  assert(st == "open_chest,stick,", "the stick stays on top: {st}");
  u = row(5);
  tile_world::place(u.w, 2, 0, 0, rules::th(u, "rock"));
  tile_world::place(u.w, 3, 0, 0, rules::th(u, "chair"));
  rules::put_hero(u, 2, 0, 0);
  u.hero_item = rules::th(u, "axe");
  assert(rules::drop(u) == rules::Step.Placed && tile_world::top(u.w, 2, 0, 0) == rules::th(u, "axe"), "on the stone");
  rules::put_hero(u, 3, 0, 0);
  u.hero_item = rules::th(u, "sword");
  assert(rules::drop(u) == rules::Step.Blocked, "not on a chair");
}

// No room beside (a corridor): four blows fell it all the same, and nothing drops.
fn test_a_tree_without_room_drops_nothing() {
  w = row(5);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "tree"));
  rules::put_hero(w, 1, 0, 0);
  w.hero_item = rules::th(w, "axe");
  for _k in 0..4 { _ = rules::walk(w, 1, 0); }
  assert(tile_world::terrain(w.w, 2, 0, 0) == rules::tr(w, "floor") && len(tile_world::stacks(w.w)) == 0,
         "felled, nothing dropped");
}

// Each tree counts its own blows, and a saved situation keeps the count it had.
fn test_each_tree_counts_its_blows() {
  w = grove();
  tile_world::set_terrain(w.w, 0, 1, 0, rules::tr(w, "tree"));
  rules::play(w, "a a");
  saved = w;
  rules::play(w, "d d d d");
  assert(tile_world::terrain(w.w, 2, 1, 0) == rules::tr(w, "floor"), "the east tree, four blows: felled");
  assert(tile_world::terrain(w.w, 0, 1, 0) == rules::tr(w, "tree"), "the west tree, two: standing");
  rules::play(w, "a a");
  assert(tile_world::terrain(w.w, 0, 1, 0) == rules::tr(w, "floor"), "two more: felled");
  rules::play(saved, "a");
  assert(tile_world::terrain(saved.w, 0, 1, 0) == rules::tr(saved, "tree"), "saved: three blows, standing");
  rules::play(saved, "a");
  assert(tile_world::terrain(saved.w, 0, 1, 0) == rules::tr(saved, "floor"), "saved: the fourth fells it");
}

// The tree's stick is a torch's stick: the axe swapped for it, dipped in tar.
fn test_a_tree_stick_becomes_a_torch() {
  w = grove();
  tile_world::place(w.w, 4, 0, 0, rules::th(w, "tar_barrel"));
  tile_world::place(w.w, 4, 2, 0, rules::th(w, "tar_barrel"));
  _ = rules::walk(w, 1, 0);
  s = if rules::prefers_right(2, 1, 0) { 2 } else { 0 };
  rules::play(w, if s == 2 { "s d" } else { "w d" });
  assert(w.hero_item == rules::th(w, "stick") && top_name(w, 2, s) == "axe", "the stick taken, the axe left");
  // Two asserts, not one `&&`: --native ran two identical calls in one assert once (loft#2259).
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "to the barrel");
  assert(rules::walk(w, 1, 0) == rules::Step.Dipped, "dipped");
  assert(w.hero_item == rules::th(w, "torch"), "a torch");
}

// Holding an item (a sword), a rock at x 3 is not pushed and a chair behind is not pulled: the
// hero only walks.  Put down (x 1), the sword lies under the hero, and the next pull drags the
// chair.
fn test_holding_an_item_keeps_the_hands_busy() {
  w = row(5);
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "sword"));
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "rock"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.hero_item == rules::th(w, "sword"), "the sword taken");
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked, "the rock is not pushed");
  assert(tile_world::top(w.w, 3, 0, 0) == rules::th(w, "rock"), "it stays at x 3");
  _ = tile_world::take(w.w, 3, 0, 0);
  tile_world::place(w.w, 3, 0, 0, rules::th(w, "chair"));
  assert(rules::pull(w, -1, 0) == rules::Step.Walked && at(w) == "1,0,0 h0", "a walk, alone: {at(w)}");
  assert(tile_world::top(w.w, 3, 0, 0) == rules::th(w, "chair"), "the chair stays at x 3");
  assert(rules::drop(w) == rules::Step.Placed && w.hero_item == 0, "the sword put down");
  assert(tile_world::top(w.w, 1, 0, 0) == rules::th(w, "sword"), "under the hero");
  assert(rules::drop(w) == rules::Step.Blocked, "nothing left to put down");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked, "back east");
  assert(rules::pull(w, -1, 0) == rules::Step.Pulled && tile_world::top(w.w, 2, 0, 0) == rules::th(w, "chair"),
         "hands free, the chair is dragged");
}

// Walking over an item swaps it with the one held: the sword stays where the axe was.
fn test_walking_over_an_item_swaps_it() {
  w = row(4);
  tile_world::place(w.w, 1, 0, 0, rules::th(w, "sword"));
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "axe"));
  rules::put_hero(w, 0, 0, 0);
  _ = rules::walk(w, 1, 0);
  _ = rules::walk(w, 1, 0);
  assert(w.hero_item == rules::th(w, "axe"), "holds the axe");
  assert(tile_world::top(w.w, 2, 0, 0) == rules::th(w, "sword") && tile_world::top(w.w, 1, 0, 0) == 0,
         "the sword left at x 2");
}

// Walking into a well saves the situation — the game keeps it — and the hero stays put.
fn test_a_well_saves() {
  w = row(4);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "well"));
  rules::put_hero(w, 1, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Saved && at(w) == "1,0,0 h0", "saved: {at(w)}");
}
