//
// One item a cell (DESIGN.md § Moving things): nothing is ever put on an item.  A light item is
// pushed out of the way of what comes in — one cell on when there is room; a string of two sends
// the far one to the side its place prefers (`prefers_right`, fixed per place), then the other,
// if there is room — and with no room the push or the pull does not happen.  The room is x 0 .. 6,
// y 0 .. 2 under a ceiling, walled all round; pushes run east along y 1, so "right" is south
// (y 2) and "left" north (y 0).
use tile_world;
use rules;

fn room() -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, 7, 3, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 6, 2, 0, rules::tr(w, "floor"));
  tile_world::fill(w.w, -1, -1, 7, 3, 1, rules::tr(w, "floor"));
  rules::put_hero(w, 0, 1, 0);
  w
}

fn put(w: rules::Level, x: integer, y: integer, name: text) {
  tile_world::place(w.w, x, y, 0, rules::th(w, name));
}

// The things on (x, y, 0), bottom first, by name.
fn at(w: const rules::Level, x: integer, y: integer) -> text {
  t = "";
  for s in tile_world::things(w.w, x, y, 0) { t += "{rules::thing_name(w.k, s)},"; }
  t
}

fn main() {
  w = room();
  assert(at(w, 0, 1) == "", "an empty room");
}

// The row an item at (x, 1) pushed east goes aside to: y 2 when its place prefers right.
fn first_side(x: integer) -> integer {
  if rules::prefers_right(x, 1, 0) { 2 } else { 0 }
}

// Each place's preference is fixed — the same answer every time — and no simple rule of the grid
// gives it away: over 32 x 32 cells each side has 40..60 %, and no rule (all right, by column,
// by row, a checkerboard, every third column) agrees with it on more than 65 % or less than 35 %
// of them.  Another layer has its own pattern.
fn test_the_side_preference_is_fixed_and_unguessable() {
  right = 0;
  agree: vector<integer> = [0, 0, 0, 0, 0];
  differs_above = 0;
  for y in -16..16 {
    for x in -16..16 {
      r = rules::prefers_right(x, y, 0);
      assert(r == rules::prefers_right(x, y, 0), "fixed at {x},{y}");
      if r { right += 1; }
      guesses = [true, x % 2 == 0, y % 2 == 0, (x + y) % 2 == 0, x % 3 == 0];
      for g in 0..5 { if (guesses[g] ?? false) == r { agree[g] += 1; } }
      if r != rules::prefers_right(x, y, 1) { differs_above += 1; }
    }
  }
  assert(right >= 410 && right <= 614, "each side 40..60 % of 1024: right {right}");
  for g in 0..5 {
    a = agree[g] ?? 0;
    assert(a >= 358 && a <= 666, "guess {g} agrees on {a} of 1024");
  }
  assert(differs_above >= 300, "the layer above has its own: {differs_above} differ");
}

// A rock pushed onto a potion: the potion goes one cell on.
fn test_an_item_slides_out_of_the_way() {
  w = room();
  put(w, 2, 1, "rock");
  put(w, 3, 1, "potion");
  _ = rules::walk(w, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed");
  assert(at(w, 3, 1) == "rock," && at(w, 4, 1) == "potion,", "{at(w, 3, 1)} {at(w, 4, 1)}");
}

// No room for the potion (a wall behind it): the rock does not move either.
fn test_no_room_no_push() {
  w = room();
  tile_world::set_terrain(w.w, 6, 1, 0, rules::tr(w, "wall"));
  put(w, 4, 1, "rock");
  put(w, 5, 1, "potion");
  rules::put_hero(w, 3, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked, "blocked");
  assert(at(w, 4, 1) == "rock," && at(w, 5, 1) == "potion," && w.hero_x == 3, "nothing moved");
}

// A string of two: the far item goes to the side its place prefers, the near one into its cell.
fn test_a_string_of_two_sends_the_far_one_aside() {
  w = room();
  put(w, 2, 1, "rock");
  put(w, 3, 1, "potion");
  put(w, 4, 1, "axe");
  _ = rules::walk(w, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed");
  s = first_side(4);
  assert(at(w, 3, 1) == "rock," && at(w, 4, 1) == "potion," && at(w, 4, s) == "axe,",
         "{at(w, 3, 1)} {at(w, 4, 1)} {at(w, 4, s)} (y {s})");
}

// Both preferences in play: in a longer room, a push whose far item lies on a place that
// prefers the left sends it north (y 0), one that prefers the right south (y 2).
fn test_each_place_sends_aside_its_own_way() {
  seen_left = false;
  seen_right = false;
  for x in 3..20 {
    if (seen_left && seen_right) { break; }
    right = rules::prefers_right(x, 1, 0);
    if (right && seen_right) || (!right && seen_left) { continue; }
    w = rules::level(rules::kinds());
    tile_world::fill(w.w, -1, -1, 21, 3, 0, rules::tr(w, "wall"));
    tile_world::fill(w.w, 0, 0, 20, 2, 0, rules::tr(w, "floor"));
    tile_world::fill(w.w, -1, -1, 21, 3, 1, rules::tr(w, "floor"));
    put(w, x - 2, 1, "rock");
    put(w, x - 1, 1, "potion");
    put(w, x, 1, "axe");
    rules::put_hero(w, x - 3, 1, 0);
    assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed at {x}");
    side = if right { 2 } else { 0 };
    assert(at(w, x, side) == "axe," && at(w, x, 2 - side) == "", "x {x} prefers right {right}: y {side}");
    if right { seen_right = true; } else { seen_left = true; }
  }
  assert(seen_left && seen_right, "both preferences met along the row");
}

// The preferred side taken (a chair): the far item goes to the other.  Both taken: nothing moves.
fn test_aside_the_other_way_and_no_room_at_all() {
  s = first_side(4);
  o = 2 - s;
  w = room();
  put(w, 2, 1, "rock");
  put(w, 3, 1, "potion");
  put(w, 4, 1, "axe");
  put(w, 4, s, "chair");
  _ = rules::walk(w, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed");
  assert(at(w, 4, o) == "axe," && at(w, 4, 1) == "potion," && at(w, 4, s) == "chair,", "the other side");
  v = room();
  put(v, 2, 1, "rock");
  put(v, 3, 1, "potion");
  put(v, 4, 1, "axe");
  put(v, 4, s, "chair");
  tile_world::set_terrain(v.w, 4, o, 0, rules::tr(v, "wall"));
  _ = rules::walk(v, 1, 0);
  assert(rules::walk(v, 1, 0) == rules::Step.Blocked, "no room either side");
  assert(at(v, 2, 1) == "rock," && at(v, 3, 1) == "potion," && at(v, 4, 1) == "axe," && v.hero_x == 1,
         "nothing moved");
}

// Only two are looked at: a third item past the string stays where it is.
fn test_a_third_item_stays() {
  w = room();
  put(w, 2, 1, "rock");
  put(w, 3, 1, "potion");
  put(w, 4, 1, "axe");
  put(w, 5, 1, "stick");
  _ = rules::walk(w, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed");
  assert(at(w, 4, 1) == "potion," && at(w, 4, first_side(4)) == "axe," && at(w, 5, 1) == "stick,",
         "the stick stays");
}

// A burning torch pushed along keeps its time: low from 9:00, a stick at 10:00 where it went —
// straight on, and aside.
fn test_a_pushed_flame_keeps_its_time() {
  w = room();
  put(w, 2, 1, "rock");
  put(w, 3, 1, "burning_torch");
  rules::tick(w, 0);
  _ = rules::walk(w, 1, 0);
  _ = rules::walk(w, 1, 0);
  assert(at(w, 4, 1) == "burning_torch,", "{at(w, 4, 1)}");
  rules::tick(w, 540000);
  assert(rules::low(w, 4, 1, 0), "low at 9:00 where it went");
  rules::tick(w, 60000);
  assert(at(w, 4, 1) == "stick," && len(w.flames) == 0, "a stick at 10:00: {at(w, 4, 1)}");
  v = room();
  put(v, 2, 1, "rock");
  put(v, 3, 1, "potion");
  put(v, 4, 1, "burning_torch");
  rules::tick(v, 0);
  _ = rules::walk(v, 1, 0);
  _ = rules::walk(v, 1, 0);
  rules::tick(v, 600000);
  assert(at(v, 4, first_side(4)) == "stick," && at(v, 4, 1) == "potion,",
         "aside, burnt out there: {at(v, 4, first_side(4))}");
}

// A ledge at x 5 on y 1: void on layer 0, floor below on layer -1.  A light item shoved over it
// falls; a rock stops at it; with no floor anywhere below there is no room.
fn ledge_room() -> rules::Level {
  w = room();
  tile_world::fill(w.w, -1, -1, 7, 3, -1, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 6, 2, -1, rules::tr(w, "floor"));
  tile_world::set_terrain(w.w, 5, 1, 0, tile_world::VOID);
  rules::put_hero(w, 2, 1, 0);
  w
}

fn low(w: const rules::Level, x: integer, y: integer) -> text {
  t = "";
  for s in tile_world::things(w.w, x, y, -1) { t += "{rules::thing_name(w.k, s)},"; }
  t
}

fn test_an_item_shoved_over_a_ledge_falls() {
  w = ledge_room();
  put(w, 3, 1, "rock");
  put(w, 4, 1, "potion");
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed");
  assert(at(w, 4, 1) == "rock," && low(w, 5, 1) == "potion,", "the potion fell: {low(w, 5, 1)}");
  v = ledge_room();
  put(v, 3, 1, "rock");
  _ = rules::walk(v, 1, 0);
  assert(rules::walk(v, 1, 0) == rules::Step.Blocked && at(v, 4, 1) == "rock,", "a rock stops at the ledge");
  u = ledge_room();
  tile_world::set_terrain(u.w, 5, 1, -1, tile_world::VOID);
  put(u, 3, 1, "rock");
  put(u, 4, 1, "potion");
  assert(rules::walk(u, 1, 0) == rules::Step.Blocked && at(u, 4, 1) == "potion,", "no floor below: no room");
}

// A burning torch shoved over the ledge keeps its time down there: a stick at 10:00.
fn test_a_fallen_flame_keeps_its_time() {
  w = ledge_room();
  put(w, 3, 1, "rock");
  put(w, 4, 1, "burning_torch");
  rules::tick(w, 0);
  _ = rules::walk(w, 1, 0);
  assert(low(w, 5, 1) == "burning_torch,", "fallen, burning");
  rules::tick(w, 600000);
  assert(low(w, 5, 1) == "stick," && len(w.flames) == 0, "out at 10:00 below: {low(w, 5, 1)}");
}

// A chair pulled onto the axe the hero just put down: the axe goes on, under the hero.
fn test_a_pull_clears_the_cell_the_hero_leaves() {
  w = room();
  put(w, 0, 1, "chair");
  rules::put_hero(w, 1, 1, 0);
  w.hero_item = rules::th(w, "axe");
  assert(rules::drop(w) == rules::Step.Placed, "the axe down");
  assert(rules::pull(w, 1, 0) == rules::Step.Pulled, "pulled");
  assert(at(w, 1, 1) == "chair," && at(w, 2, 1) == "axe," && w.hero_x == 2 && w.hero_item == 0,
         "{at(w, 1, 1)} {at(w, 2, 1)}");
}

// Nothing is put down on an item: two burning torches never share a cell, and each burns out.
fn test_no_drop_on_an_item() {
  w = room();
  put(w, 2, 1, "burning_torch");
  w.hero_item = rules::th(w, "burning_torch");
  rules::tick(w, 0);
  rules::play(w, "d d");
  assert(rules::drop(w) == rules::Step.Blocked, "the cell holds an item");
  rules::tick(w, 600000);
  assert(w.hero_item == rules::th(w, "stick") && at(w, 2, 1) == "stick,", "both out: {at(w, 2, 1)}");
}

// A train pushed onto an item on the rails sends it on; pulled, the item where the hero stood
// goes on with the hero.
fn test_trains_clear_the_way() {
  w = room();
  tile_world::fill(w.w, 0, 1, 6, 1, 0, rules::tr(w, "rail"));
  put(w, 2, 1, "cart");
  put(w, 3, 1, "cart");
  put(w, 4, 1, "potion");
  _ = rules::walk(w, 1, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Pushed, "pushed");
  assert(at(w, 3, 1) == "cart," && at(w, 4, 1) == "cart," && at(w, 5, 1) == "potion,", "{at(w, 5, 1)}");
  v = room();
  tile_world::fill(v.w, 0, 1, 6, 1, 0, rules::tr(v, "rail"));
  put(v, 0, 1, "cart");
  put(v, 1, 1, "cart");
  rules::put_hero(v, 2, 1, 0);
  v.hero_item = rules::th(v, "axe");
  _ = rules::drop(v);
  assert(rules::pull(v, 1, 0) == rules::Step.Pulled, "pulled");
  assert(at(v, 1, 1) == "cart," && at(v, 2, 1) == "cart," && at(v, 3, 1) == "axe,", "{at(v, 3, 1)}");
}
