// The editor's core on the first climb (levels/first_climb.json): the palette, paint, stack,
// erase, the markers, undo and redo, a save of what was edited, and the camera.  The level's
// layer 0 is a 13x9 room, walls round floor, the hero starting at (1, 1); a chair stands at
// (2, 6).  kinds.json numbers the terrain floor 1, wall 2, water 3, rail 4, and the things
// cart 1, chair 2, table 3, rock 4, anvil 5, potion 6, staff 7, chest 8.
use tile_world;
use rules;
use levels;
use editor;
use camera;
use materials;

const FLOOR = 1;
const WALL = 2;
const CHAIR = 2;

fn first_climb() -> levels::LevelFile {
  m = levels::load(file("../levels/first_climb.json").content() ?? "", rules::kinds());
  if !m { assert(false, "levels/first_climb.json loads"); }
  m ?? levels::LevelFile {
    name: "", level: rules::level(rules::kinds()), start_x: 0, start_y: 0, start_z: 0,
    goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 }
  }
}

// Pick the palette entry named `name`.
fn pick(ed: editor::Editor, k: const rules::Kinds, name: text) {
  for i in 0..len(ed.palette) {
    if editor::name(k, ed.palette[i] ?? editor::picked(ed)) == name { ed.pick = i; }
  }
  assert(editor::name(k, editor::picked(ed)) == name, "the palette has {name}");
}

fn stack(lf: const levels::LevelFile, x: integer, y: integer, z: integer) -> text {
  t = "";
  for th in tile_world::things(lf.level.w, x, y, z) { t += "{th},"; }
  t
}

fn main() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  assert(ed.x == 1 && ed.y == 1 && ed.z == 0, "the cursor starts on the hero's start");
}

// void, the terrain kinds, then the things (the first is the cart), round the end both ways.
fn test_the_palette() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  k = lf.level.k;
  n = len(rules::terrain_ids(k));
  assert(len(ed.palette) == 1 + n + len(rules::thing_ids(k)), "every kind, got {len(ed.palette)}");
  assert(editor::name(k, editor::picked(ed)) == "floor", "the first terrain kind is picked");
  assert(editor::name(k, ed.palette[0] ?? editor::picked(ed)) == "void", "void first");
  assert(editor::name(k, ed.palette[1 + n] ?? editor::picked(ed)) == "cart", "then the things");
  editor::choose(ed, -1);
  editor::choose(ed, -1);
  things = rules::thing_ids(k);
  last = rules::thing_name(k, things[len(things) - 1] ?? 0);
  assert(editor::name(k, editor::picked(ed)) == last, "back past void is the last thing, {last}: {ed.pick}");
  editor::choose(ed, 1);
  assert(ed.pick == 0, "and on again is void");
}

// Wall painted at (1, 1), then two chairs stacked at (2, 1); painting the same wall again
// changes nothing and logs nothing.  Undo walks it all back, cursor following; redo replays it.
fn test_paint_stack_undo_redo() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  w = lf.level.w;
  editor::choose(ed, 1);
  assert(editor::paint(ed, lf), "a wall painted");
  assert(!editor::paint(ed, lf), "the same wall again changes nothing");
  assert(tile_world::terrain(w, 1, 1, 0) == WALL, "(1, 1) is a wall");
  editor::move(ed, 1, 0);
  pick(ed, lf.level.k, "chair");
  assert(editor::paint(ed, lf) && editor::paint(ed, lf), "two chairs stacked");
  assert(stack(lf, 2, 1, 0) == "{CHAIR},{CHAIR},", "the stack: {stack(lf, 2, 1, 0)}");
  assert(editor::undoable(ed) == 3, "three edits, got {editor::undoable(ed)}");
  editor::move(ed, 5, 5);
  assert(editor::undo(ed, lf), "undo the second chair");
  assert(stack(lf, 2, 1, 0) == "{CHAIR},", "one chair left: {stack(lf, 2, 1, 0)}");
  assert(ed.x == 2 && ed.y == 1, "the cursor back on the cell undone: {ed.x} {ed.y}");
  assert(editor::undo(ed, lf) && editor::undo(ed, lf), "the chair and the wall undone");
  assert(stack(lf, 2, 1, 0) == "" && tile_world::terrain(w, 1, 1, 0) == FLOOR, "as loaded");
  assert(ed.x == 1 && ed.y == 1, "the cursor on the wall's cell");
  assert(!editor::undo(ed, lf), "nothing left to undo");
  assert(editor::redo(ed, lf) && editor::redo(ed, lf) && editor::redo(ed, lf), "all three redone");
  assert(!editor::redo(ed, lf), "nothing left to redo");
  assert(tile_world::terrain(w, 1, 1, 0) == WALL && stack(lf, 2, 1, 0) == "{CHAIR},{CHAIR},", "as edited");
}

// An edit after an undo drops what was undone: redo has nothing, and the undone wall stays gone.
fn test_a_new_edit_drops_the_undone() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  editor::choose(ed, 1);
  _ = editor::paint(ed, lf);
  _ = editor::undo(ed, lf);
  editor::move(ed, 1, 0);
  _ = editor::paint(ed, lf);
  assert(editor::undoable(ed) == 1, "one edit, got {editor::undoable(ed)}");
  assert(!editor::redo(ed, lf), "the undone wall cannot be redone");
  assert(tile_world::terrain(lf.level.w, 1, 1, 0) == FLOOR, "(1, 1) stays floor");
  assert(tile_world::terrain(lf.level.w, 2, 1, 0) == WALL, "(2, 1) is the new wall");
}

// Erasing (2, 6) takes the chair off, then unsets the floor — with no ground on layer 0 it
// reads as void.  Painting void at (3, 3) sets it: a pit, which saves as `_`.
fn test_erase_and_void() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  w = lf.level.w;
  editor::move(ed, 1, 5);
  assert(editor::erase(ed, lf) && stack(lf, 2, 6, 0) == "", "the chair taken off");
  assert(tile_world::is_set(w, 2, 6, 0), "the floor stays");
  assert(editor::erase(ed, lf), "then the floor unset");
  assert(!tile_world::is_set(w, 2, 6, 0) && tile_world::terrain(w, 2, 6, 0) == tile_world::VOID, "void");
  assert(!editor::erase(ed, lf), "nothing left to erase");
  assert(editor::undo(ed, lf) && tile_world::terrain(w, 2, 6, 0) == FLOOR, "the floor back");
  assert(editor::undo(ed, lf) && stack(lf, 2, 6, 0) == "{CHAIR},", "the chair back");
  editor::move(ed, 1, -3);
  ed.pick = 0;
  assert(editor::paint(ed, lf), "void painted on (3, 3)");
  assert(tile_world::is_set(w, 3, 3, 0) && tile_world::terrain(w, 3, 3, 0) == tile_world::VOID, "a pit");
  assert(levels::save(lf).find("\"#.._..~.....#\"") != null, "row 3 saves with `_` at x 3");
}

// The start moved to (5, 5, 0) carries the hero; the goal set at (11, 1, 1) becomes a "cell"
// goal.  Undo puts back the "layer 1" goal and the start at (1, 1, 0).
fn test_markers() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  editor::move(ed, 4, 4);
  assert(editor::set_start(ed, lf), "the start moved");
  assert(!editor::set_start(ed, lf), "the same start again changes nothing");
  assert(lf.start_x == 5 && lf.start_y == 5 && lf.level.hero_x == 5 && lf.level.hero_y == 5, "the hero with it");
  editor::move(ed, 6, -4);
  editor::layer(ed, 1);
  assert(editor::set_goal(ed, lf), "the goal set");
  g = lf.goal;
  assert(g.kind == "cell" && g.x == 11 && g.y == 1 && g.z == 1, "a cell goal: {g.kind} {g.x} {g.y} {g.z}");
  assert(editor::undo(ed, lf), "the goal undone");
  assert(lf.goal.kind == "layer" && lf.goal.z == 1, "the layer goal back: {lf.goal.kind} {lf.goal.z}");
  assert(editor::undo(ed, lf), "the start undone");
  assert(lf.start_x == 1 && lf.start_y == 1 && lf.level.hero_x == 1, "the start back");
}

// An edited level saves, loads back to the same cells and goal, and saves to the same text.
fn test_an_edit_survives_a_save() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  editor::choose(ed, 1);
  _ = editor::paint(ed, lf);
  editor::move(ed, 1, 0);
  _ = editor::set_goal(ed, lf);
  saved = levels::save(lf);
  m = levels::load(saved, rules::kinds());
  assert(m != null, "it loads");
  back = m ?? lf;
  assert(tile_world::terrain(back.level.w, 1, 1, 0) == WALL, "the wall is in the file");
  assert(back.goal.kind == "cell" && back.goal.x == 2 && back.goal.y == 1, "and the goal");
  assert(levels::save(back) == saved, "it saves to the same text");
}

// Play-test plays a copy: the game assigns the level INTO a field (`g.world = g.file.level`),
// which copies it, stacks and all.  (A bind of the field, `play = lf.level`, would be a view
// of it, and every move would land in the edited level.)  Walking and placing on the copy
// leaves the edited level as it was.
struct Playing {
  l: rules::Level
}

fn test_a_played_copy_leaves_the_level() {
  lf = first_climb();
  p = Playing { l: rules::level(rules::kinds()) };
  p.l = lf.level;
  _ = rules::walk(p.l, 1, 0);
  tile_world::place(p.l.w, 5, 5, 0, CHAIR);
  assert(p.l.hero_x == 2 && len(tile_world::things(p.l.w, 5, 5, 0)) == 1, "the copy moved");
  assert(lf.level.hero_x == 1 && stack(lf, 5, 5, 0) == "", "the level did not: {lf.level.hero_x}");
}

// The first climb's cells span (0, 0) to (12, 8).  A 13-wide view follows within 0..39: it
// moves when the hero passes cell 10 (two from its right edge) and stops at 27; a level as
// wide as the view never moves.  Rooms of 13 count from the level's edge, both ways.
fn test_camera() {
  b = camera::bounds(first_climb().level.w);
  assert(b.0 == 0 && b.1 == 0 && b.2 == 12 && b.3 == 8, "bounds {b.0} {b.1} {b.2} {b.3}");
  assert(camera::follow(0, 10, 13, 0, 39) == 0, "inside the margin");
  assert(camera::follow(0, 11, 13, 0, 39) == 1, "one cell past it");
  assert(camera::follow(26, 39, 13, 0, 39) == 27, "held at the level's edge");
  assert(camera::follow(0, 1, 13, 0, 12) == 0, "a level as wide as the view");
  assert(camera::rooms(12, 13, 0) == 0 && camera::rooms(13, 13, 0) == 13, "room 0, room 1");
  assert(camera::rooms(-1, 13, 0) == -13 && camera::rooms(-13, 13, 0) == -13, "room -1");
  assert(camera::rooms(-14, 13, 0) == -26, "room -2");
  assert(camera::keep(0, -3, 13, 0) == -3 && camera::keep(0, 13, 13, 0) == 1, "the cursor kept in sight");
}

// With theme.json's materials: a row of three path cells at x 2..4, y 2 takes the pieces
// north-west, north and north-east (269 270 271 — tests/materials.loft has the numbers).
// Erasing the middle one leaves (4, 2) with no west neighbour: a north-west piece too (269).
// One undo puts back both: the erased cell and the neighbour's piece.
fn test_materials_paint_retile_and_undo() {
  lf = first_climb();
  mats = materials::load(file("../theme.json").content() ?? "", lf.level.k);
  ed = editor::new_editor_with(lf, mats);
  w = lf.level.w;
  pick(ed, lf.level.k, "path");
  editor::move(ed, 1, 1);
  for _ in 0..3 {
    _ = editor::paint(ed, lf);
    editor::move(ed, 1, 0);
  }
  row = "{tile_world::tile(w, 2, 2, 0)} {tile_world::tile(w, 3, 2, 0)} {tile_world::tile(w, 4, 2, 0)}";
  assert(row == "269 270 271", "the row: {row}");
  editor::move(ed, -2, 0);
  assert(editor::erase(ed, lf), "the middle erased");
  assert(tile_world::tile(w, 4, 2, 0) == 269, "its east neighbour turned: {tile_world::tile(w, 4, 2, 0)}");
  assert(editor::undo(ed, lf), "undone");
  row = "{tile_world::tile(w, 2, 2, 0)} {tile_world::tile(w, 3, 2, 0)} {tile_world::tile(w, 4, 2, 0)}";
  assert(row == "269 270 271", "all three back: {row}");
}

// Categories (theme.json): 2 is Water, whose first entry is the lake; 6 is Things, the cart
// first; there is no 9th, nor a 0th, and the pick stays.
fn test_palette_categories() {
  lf = first_climb();
  k = lf.level.k;
  ed = editor::new_editor_with(lf, materials::load(file("../theme.json").content() ?? "", k));
  assert(editor::jump(ed, k, 2) && editor::name(k, editor::picked(ed)) == "lake", "water: {editor::name(k, editor::picked(ed))}");
  assert(editor::jump(ed, k, 6) && editor::name(k, editor::picked(ed)) == "cart", "things");
  assert(!editor::jump(ed, k, 9) && !editor::jump(ed, k, 0), "no such category");
  assert(editor::name(k, editor::picked(ed)) == "cart", "the pick stays");
}

// The brushes on the first climb, with theme.json's materials.  Its left floor is x 1..5 on
// rows 1..3 and 5..7 (30 cells) and x 1..2 of row 4 before the rails (2): 32 cells, cut off
// from the right by the river at x 6 and the rails at x 3..10 of row 4.
fn brush_editor(lf: const levels::LevelFile) -> editor::Editor {
  editor::new_editor_with(lf, materials::load(file("../theme.json").content() ?? "", lf.level.k))
}

fn grass_at(lf: const levels::LevelFile, ed: const editor::Editor, x: integer, y: integer) -> boolean {
  materials::at(ed.mats, lf.level.w, x, y, 0) == materials::named(ed.mats, "grass")
}

// Fill from (1, 1) with grass paints the 32 cells and nothing past the river or onto the rails;
// one undo takes all of it back.
fn test_fill() {
  lf = first_climb();
  ed = brush_editor(lf);
  pick(ed, lf.level.k, "grass");
  assert(editor::fill(ed, lf), "filled");
  assert(grass_at(lf, ed, 1, 1) && grass_at(lf, ed, 5, 7) && grass_at(lf, ed, 2, 4), "the left floor");
  assert(!grass_at(lf, ed, 7, 1) && !grass_at(lf, ed, 3, 4), "not past the river, not the rails");
  n = 0;
  for y in 1..8 {
    for x in 1..6 { if grass_at(lf, ed, x, y) { n += 1; } }
  }
  assert(n == 32, "32 cells: {n}");
  assert(editor::undoable(ed) == 1 && editor::undo(ed, lf), "one edit, undone");
  assert(!grass_at(lf, ed, 5, 7) && tile_world::tile(lf.level.w, 5, 7, 0) == 0, "all of it");
}

// R at (1, 1), the cursor to (3, 2), R again: a wall over x 1..3, y 1..2 — and (4, 1) stays
// floor.  The mark is dropped.
fn test_rectangle() {
  lf = first_climb();
  ed = brush_editor(lf);
  pick(ed, lf.level.k, "wall");
  editor::set_mark(ed);
  editor::move(ed, 2, 1);
  assert(editor::paint_box(ed, lf) && !ed.marked, "painted, mark dropped");
  wall = rules::tr(lf.level, "wall");
  w = lf.level.w;
  assert(tile_world::terrain(w, 1, 1, 0) == wall && tile_world::terrain(w, 3, 2, 0) == wall, "the corners");
  assert(tile_world::terrain(w, 4, 1, 0) == FLOOR, "not past them");
}

// The chair at (2, 6) copied (no mark: the cursor's cell) and pasted at (4, 6); undo takes the
// pasted one away again.
fn test_copy_and_paste() {
  lf = first_climb();
  ed = brush_editor(lf);
  editor::move(ed, 1, 5);
  editor::copy_box(ed, lf);
  editor::move(ed, 2, 0);
  assert(editor::paste_box(ed, lf), "pasted");
  assert(tile_world::top(lf.level.w, 4, 6, 0) == CHAIR, "a chair at (4, 6)");
  assert(editor::undo(ed, lf) && tile_world::top(lf.level.w, 4, 6, 0) == 0, "undone");
}

// The eyedropper: the chair on (2, 6), the floor kind on (1, 1), and grass once painted there.
fn test_pick_under() {
  lf = first_climb();
  ed = brush_editor(lf);
  k = lf.level.k;
  editor::move(ed, 1, 5);
  assert(editor::pick_under(ed, lf) && editor::name(k, editor::picked(ed)) == "chair", "the chair");
  editor::move(ed, -1, -5);
  assert(editor::pick_under(ed, lf) && editor::name(k, editor::picked(ed)) == "floor", "the floor");
  pick(ed, k, "grass");
  _ = editor::paint(ed, lf);
  editor::choose(ed, 1);
  assert(editor::pick_under(ed, lf) && editor::name(k, editor::picked(ed)) == "grass", "the grass");
}

// The checks on the first climb (start (1, 1)).  The east half is cut off: the river runs down
// x 6, and the rails across it at y 4 are blocked by the cart (6, 4) and the rock (8, 4).
// A cell goal at (5, 7) has a path ending there; one at (11, 1) has none.  Chests: (3, 6) is
// fine; (10, 6) is cut off; (1, 7), walled in at (1, 6), (2, 6) and (2, 7) beside the border —
// its door at (1, 8) walled up too — is cut off and hidden: no walkable cell sees it.
fn test_the_checks() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  w = lf.level.w;
  editor::move(ed, 4, 6);
  _ = editor::set_goal(ed, lf);
  r = editor::check(lf);
  last = r.path[len(r.path) - 1] ?? (0, 0);
  assert(r.searched && last.0 == 5 && last.1 == 7, "a way to (5, 7), ending there: {len(r.path)} steps");
  editor::move(ed, 6, -6);
  _ = editor::set_goal(ed, lf);
  r = editor::check(lf);
  assert(r.searched && len(r.path) == 0, "no way to (11, 1): {len(r.path)}");
  chest = rules::th(lf.level, "chest");
  wall = rules::tr(lf.level, "wall");
  tile_world::place(w, 3, 6, 0, chest);
  tile_world::place(w, 10, 6, 0, chest);
  tile_world::place(w, 1, 7, 0, chest);
  for p in [(1, 6), (2, 6), (2, 7), (1, 8)] { tile_world::set_terrain(w, p.0, p.1, 0, wall); }
  r = editor::check(lf);
  cut = "";
  for c in r.cut_off { cut += "{c.0},{c.1} "; }
  hid = "";
  for c in r.hidden { hid += "{c.0},{c.1} "; }
  assert(cut == "1,7 10,6 " || cut == "10,6 1,7 ", "cut off: {cut}");
  assert(hid == "1,7 ", "hidden: {hid}");
}

// A slope painted: the cell under the cursor raised a step at a time, up to 3 (a step more is the
// layer above), lowered back to 0 and no further; undone it is back where it was; saved, its rise
// is in the file.
fn test_raise_and_lower_a_slope() {
  lf = first_climb();
  ed = editor::new_editor(lf);
  ed.x = 2;
  ed.y = 2;
  ed.z = 0;
  for i in 0..3 { assert(editor::raise(ed, lf, 1), "raise {i}"); }
  assert(tile_world::rise(lf.level.w, 2, 2, 0) == 3, "at 3");
  assert(!editor::raise(ed, lf, 1), "no higher than 3");
  assert(editor::undo(ed, lf) && tile_world::rise(lf.level.w, 2, 2, 0) == 2, "undone to 2");
  assert(editor::raise(ed, lf, -1) && editor::raise(ed, lf, -1) && tile_world::rise(lf.level.w, 2, 2, 0) == 0, "lowered to 0");
  assert(!editor::raise(ed, lf, -1), "no lower than 0");
  assert(editor::raise(ed, lf, 1), "up again");
  assert(levels::save(lf).contains("[2, 2, 0, 1]"), "the rise saved");
}

// A junction painted: "junction 1" puts a rail with that junction's picture, a piece the level
// knows — its joins are the junction's, not the plain rail's.
fn test_paint_a_junction() {
  lf = first_climb();
  mats = materials::load(file("../theme.json").content() ?? "", lf.level.k);
  for t in mats.track { rules::add_piece(lf.level, t.tile, t.joins, t.toe, t.straight, t.turn, t.set_turn, t.twin); }
  ed = editor::new_editor_with(lf, mats);
  pick(ed, lf.level.k, "junction 1");
  ed.x = 2;
  ed.y = 2;
  ed.z = 0;
  assert(editor::paint(ed, lf), "painted");
  e = editor::picked(ed);
  assert(tile_world::terrain(lf.level.w, 2, 2, 0) == rules::tr(lf.level, "rail") && tile_world::tile(lf.level.w, 2, 2, 0) == e.tile,
         "a rail with the junction's picture");
  assert(rules::joins(lf.level, 2, 2, 0) != 0 && editor::undo(ed, lf), "a piece; undone");
}
