//
// The worlds to start (BUILD.md D1, WORLD.md): the story's, Orbury, and the demo village beside it,
// each saved apart; and Orbury's fixed layout (LOCATIONS.md § 1) played by the rules — up the main
// road from the loading dock, over the stone bridge, to the market.
use tile_world;
use rules;
use materials;
use levels;
use intent;
use editor;
use game;

fn test_orbury_first_then_the_demo_village() {
  ws = game::worlds("..");
  assert(len(ws) == 2, "two worlds: {len(ws)}");
  assert((ws[0] ?? game::WorldChoice { name: "", start: "" }).start == "orbury", "Orbury first");
  assert((ws[1] ?? game::WorldChoice { name: "", start: "" }).start == "demo", "then the demo village");
}

fn test_each_world_saves_apart() {
  assert(game::save_dir_of("demo") == "saves", "the demo village where it always saved");
  assert(game::save_dir_of("orbury") == "saves/orbury", "Orbury apart: {game::save_dir_of("orbury")}");
}

fn orbury() -> levels::LevelFile {
  theme = file("../theme.json").content() ?? "";
  k = rules::kinds();
  mats = materials::load(theme, k);
  m = levels::load_with(file("../levels/orbury.json").content() ?? "", k, mats);
  if !m { assert(false, "orbury loads"); }
  m ?? levels::LevelFile { name: "", level: rules::level(k), start_x: 0, start_y: 0, start_z: 0,
                           goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 } }
}

// The place file is as its intent says: filling it in again changes nothing.
fn test_orbury_is_as_its_intent_says() {
  lf = orbury();
  theme = file("../theme.json").content() ?? "";
  ed = editor::new_editor_with(lf, materials::load(theme, lf.level.k));
  assert(!editor::refill(ed, lf, intent::words_from(theme)), "orbury.json is filled in");
}

// From the dock over the stone bridge, up the main road's slopes to the middle terrace and on to
// the market terrace.
fn test_the_main_road_climbs_from_the_dock_to_the_market() {
  lf = orbury();
  w = lf.level;
  rules::play(w, "w w w w w w w w w w w w w");
  assert(w.hero_x == 30 && w.hero_y == 47 && w.hero_z == 0, "at the foot of the road: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
  rules::play(w, "w d d d");
  assert(w.hero_x == 33 && w.hero_y == 46 && w.hero_z == 1, "up the first slope: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
  rules::play(w, "w w w w w w w w w w w w d d d d d");
  assert(w.hero_x == 38 && w.hero_y == 34 && w.hero_z == 2, "up the second: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
  rules::play(w, "w w w w a a a");
  assert(w.hero_z == 2 && w.hero_y == 30 && w.hero_x == 35, "in the market: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
}

// A stair road: from the foot's street, up the steps in the middle terrace's front.
fn test_a_stair_road_climbs_a_terrace() {
  lf = orbury();
  w = lf.level;
  rules::put_hero(w, 17, 46, 0);
  rules::play(w, "w");
  assert(w.hero_x == 17 && w.hero_y == 45 && w.hero_z == 1, "up the stairs: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
}

// The stream's bed is no trap (owner, 2026-11-08), and its banks slope (owner, 2026-11-09): fallen
// in from the town's side, along the bed and straight up the town's bank onto the lane.
fn test_the_bed_is_left_up_its_town_bank() {
  lf = orbury();
  w = lf.level;
  rules::put_hero(w, 21, 56, -1);
  hp = w.health;
  rules::play(w, "a a a");
  assert(w.hero_x == 18 && w.hero_y == 56 && w.hero_z == -1, "along the bed: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
  rules::play(w, "w w");
  assert(w.hero_x == 18 && w.hero_y == 54 && w.hero_z == 0 && w.health == hp,
         "up the bank onto the lane: ({w.hero_x}, {w.hero_y}, {w.hero_z}), health {w.health}");
}

// And up the far bank, onto the dock's side.
fn test_the_bed_is_left_up_its_far_bank() {
  lf = orbury();
  w = lf.level;
  rules::put_hero(w, 47, 61, -1);
  rules::play(w, "s");
  assert(w.hero_x == 47 && w.hero_y == 62 && w.hero_z == 0, "out by the dock: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
}

// Under the bridge the bed is walked through: the stone bridge's three columns stand over it.
fn test_the_bed_runs_under_the_stone_bridge() {
  lf = orbury();
  w = lf.level;
  mats = materials::load(file("../theme.json").content() ?? "", w.k);
  for x in 29..32 {
    assert(materials::at(mats, w.w, x, 57, 0) == materials::named(mats, "bridge"), "the bridge at ({x}, 57)");
  }
  rules::put_hero(w, 27, 57, -1);
  rules::play(w, "d d d d d d");
  assert(w.hero_x == 33 && w.hero_z == -1, "under the bridge and on: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
}

// From every cell of the stream's bed the hero can stand on, a way out up to the street — no pocket
// where a hero who fell in is stuck (owner, 2026-11-08: still places to get stuck): steps of a
// rise at most up or down, and from a slope's top (a layer's height less one) or across a sloping
// front onto the floor beside it on the layer above.  The pools are shallows, waded through.
fn test_no_pocket_in_the_bed() {
  lf = orbury();
  w = lf.level;
  top = w.k.layer_height - 1;
  stuck = "";
  for y in 50..68 {
    for x in 0..64 {
      if !rules::walkable(w, tile_world::terrain(w.w, x, y, -1)) { continue; }
      seen: vector<integer> = [y * 64 + x];
      at = 0;
      out = false;
      while at < len(seen) && !out {
        c = seen[at] ?? 0;
        at += 1;
        cx = c % 64 ?? 0;
        cy = c / 64 ?? 0;
        r = tile_world::rise(w.w, cx, cy, -1);
        for d in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
          nx = cx + d.0;
          ny = cy + d.1;
          if nx < 0 || nx >= 64 { continue; }
          if (r >= top || rules::slope_between(w, cx, cy, -1, d.0, d.1)) && rules::walkable(w, tile_world::terrain(w.w, nx, ny, 0)) {
            out = true;
          }
          nr = tile_world::rise(w.w, nx, ny, -1);
          if rules::walkable(w, tile_world::terrain(w.w, nx, ny, -1)) && nr - r <= 1 && r - nr <= 1
              && !seen.contains(ny * 64 + nx) {
            seen += [ny * 64 + nx];
          }
        }
      }
      if !out { stuck += "({x}, {y}) "; }
    }
  }
  assert(stuck == "", "no way out of the bed from {stuck}");
}

// The shallows are waded through; deep water is not walked into.
fn test_the_shallows_are_waded_and_deep_water_is_not() {
  lf = orbury();
  w = lf.level;
  rules::put_hero(w, 49, 59, -1);
  rules::play(w, "d d d d");
  assert(w.hero_x == 53 && w.hero_y == 59 && w.hero_z == -1, "through the pool: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
  tile_world::set_terrain(w.w, 54, 59, -1, rules::terrain_id(w.k, "water"));
  rules::play(w, "d");
  assert(w.hero_x == 53, "deep water stops the hero: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
}

// The stream winds (owner, 2026-11-08: no natural stream is straight), and the rails follow its far
// bank: from the dock's end one unbroken track, round every bend, out at the east edge — never on
// the bank's edge or in the bed.
fn test_the_rails_follow_the_winding_bank() {
  lf = orbury();
  w = lf.level;
  x = 26;
  y = 61;
  from = (-1, 0);
  rows: vector<integer> = [];
  steps = 0;
  while x < 63 && steps < 200 {
    m = rules::joins(w, x, y, 0);
    assert(m != 0, "the track goes on at ({x}, {y})");
    if m == 0 { return; }
    assert(rules::walkable(w, tile_world::terrain(w.w, x, y - 1, 0)) && rules::walkable(w, tile_world::terrain(w.w, x, y - 2, 0)),
           "two rows of the far side between the rails and the bed at ({x}, {y})");
    if !rows.contains(y) { rows += [y]; }
    next = (0, 0);
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      bit = if d == (0, -1) { 1 } else if d == (1, 0) { 2 } else if d == (0, 1) { 4 } else { 8 };
      if (m & bit) != 0 && d != from { next = d; }
    }
    from = (-next.0, -next.1);
    x += next.0;
    y += next.1;
    steps += 1;
  }
  assert(x == 63, "out at the east edge: ({x}, {y})");
  assert(len(rows) >= 3, "round the bends: rows {rows}");
}

fn cell_key(x: integer, y: integer, z: integer) -> integer { ((z + 2) * 80 + y) * 64 + x }

// The town's lines are broken up (owner, 2026-11-09: houses offset and moved up and down the hill,
// foliage to finish the job) — and none of it shuts a door: from the dock, walking by the rules'
// own steps over every layer (slopes, stairs, falls), every house's front door is reached.
fn test_every_front_door_is_reached_from_the_dock() {
  lf = orbury();
  w = lf.level;
  door = rules::terrain_id(w.k, "open_door");
  seen: vector<boolean> = [false; 8 * 80 * 64];
  queue: vector<(integer, integer, integer)> = [(lf.start_x, lf.start_y, lf.start_z)];
  seen[cell_key(lf.start_x, lf.start_y, lf.start_z)] = true;
  at = 0;
  while at < len(queue) {
    c = queue[at] ?? (0, 0, 0);
    at += 1;
    for m in ["w", "a", "s", "d"] {
      rules::put_hero(w, c.0, c.1, c.2);
      w.health = 100;
      rules::play(w, m);
      if w.hero_x < 0 || w.hero_x >= 64 || w.hero_y < 0 || w.hero_y >= 80 || w.hero_z < -2 || w.hero_z > 5 { continue; }
      k = cell_key(w.hero_x, w.hero_y, w.hero_z);
      if !(seen[k] ?? true) {
        seen[k] = true;
        queue += [(w.hero_x, w.hero_y, w.hero_z)];
      }
    }
  }
  missed = "";
  for z in 0..4 {
    for y in 0..72 {
      for x in 0..64 {
        if tile_world::terrain(w.w, x, y, z) == door && !(seen[cell_key(x, y, z)] ?? false) { missed += "({x}, {y}, {z}) "; }
      }
    }
  }
  assert(missed == "", "doors not reached: {missed}");
}

// In the stream's bed the hero sees no further than its banks; on the road between two houses it
// does — a house's wall with its roof above is no bank of earth.
fn test_the_bed_is_a_trench_and_a_road_between_houses_is_not() {
  lf = orbury();
  w = lf.level;
  mats = materials::load(file("../theme.json").content() ?? "", w.k);
  rules::put_hero(w, 27, 57, -1);
  assert(game::in_trench(w, mats), "in the bed");
  rules::put_hero(w, 33, 39, 1);
  assert(!game::in_trench(w, mats), "on the road up the middle terrace, between two houses");
}

// @FR-GM-Front: Orbury's terrace fronts slope (owner, 2026-11-09): up from the middle terrace onto
// the market's anywhere along the front, no stairs; but the big house's front over the market is
// a cliff, as is the hill behind it.
fn test_orburys_fronts_slope_but_the_big_house_stands_on_a_cliff() {
  lf = orbury();
  w = lf.level;
  rules::put_hero(w, 25, 34, 1);
  hp = w.health;
  rules::play(w, "w");
  assert(w.hero_x == 25 && w.hero_y == 33 && w.hero_z == 2, "up the market's front: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
  rules::play(w, "s");
  assert(w.hero_x == 25 && w.hero_y == 34 && w.hero_z == 1 && w.health == hp, "and down, unhurt: ({w.hero_x}, {w.hero_y}, {w.hero_z}), {w.health}");
  rules::put_hero(w, 29, 21, 2);
  rules::play(w, "w");
  assert(w.hero_x == 29 && w.hero_y == 21 && w.hero_z == 2, "the big house's front is a cliff: ({w.hero_x}, {w.hero_y}, {w.hero_z})");
}
