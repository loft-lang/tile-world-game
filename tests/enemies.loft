// Enemies (DESIGN.md § Enemies), rats: health 3; a step every 600 ms wandering, every 350 ms
// chasing or fleeing; a bite costs the hero 1, at most every 900 ms; it sees 5 cells, roams 3
// from its nest, heals a point every 4 s there.  A healthy rat that sees the hero comes at it and
// bites; a hurt one goes home by a way that avoids the hero, steps away when it has none, and fights
// only cornered.  The hero strikes by walking into it or swinging at it: a sword costs it 2, bare
// hands 1; a blast 4 - d.  Every time below is worked by hand.
use tile_world;
use rules;

// A room x 0 .. n - 1, y 0 .. rows - 1, walled; floor on layer 2 at (0, 0), out of everyone's way.
fn room(n: integer, rows: integer) -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, n, rows, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, n - 1, rows - 1, 0, rules::tr(w, "floor"));
  tile_world::set_terrain(w.w, 0, 0, 2, rules::tr(w, "floor"));
  w
}

fn until(w: rules::Level, at: integer) {
  rules::tick(w, at - w.now);
}

fn rat(w: const rules::Level) -> text {
  if len(w.enemies) == 0 { return "none"; }
  e = w.enemies[0];
  "x{e.x} y{e.y} hp{e.hp}"
}

fn main() {
  w = room(4, 1);
  _ = rules::add_enemy(w, "rat", 2, 0, 0);
  assert(rat(w) == "x2 y0 hp3", "a rat: {rat(w)}");
}

// The rat on x 6 first acts at 600: it sees the hero on x 1 (5 away) and comes, a cell every
// 350 ms: x 5 at 600, x 4 at 950, x 3 at 1300, x 2 at 1650 — beside the hero.  It bites at 2000
// and again at 2900.
fn test_a_rat_comes_at_the_hero_and_bites() {
  w = room(8, 1);
  rules::put_hero(w, 1, 0, 0);
  _ = rules::add_enemy(w, "rat", 6, 0, 0);
  until(w, 599);
  assert(rat(w) == "x6 y0 hp3", "599: {rat(w)}");
  until(w, 600);
  assert(rat(w) == "x5 y0 hp3", "600: {rat(w)}");
  until(w, 1649);
  assert(rat(w) == "x3 y0 hp3", "1649: {rat(w)}");
  until(w, 1650);
  assert(rat(w) == "x2 y0 hp3", "1650: {rat(w)}");
  until(w, 1999);
  assert(w.health == 6, "1999: not yet bitten");
  until(w, 2000);
  assert(w.health == 5, "2000: bitten: {w.health}");
  until(w, 2900);
  assert(w.health == 4, "2900: bitten again: {w.health}");
}

// Walking into a rat strikes it: bare-handed 1, with a sword 2 — and at no health it is gone.
fn test_the_hero_strikes_a_rat() {
  w = room(6, 1);
  rules::put_hero(w, 1, 0, 0);
  _ = rules::add_enemy(w, "rat", 2, 0, 0);
  assert(rules::walk(w, 1, 0) == rules::Step.Attacked && rat(w) == "x2 y0 hp2" && w.hero_x == 1, "bare hands: {rat(w)}");
  w.hero_item = rules::th(w, "sword");
  rules::tick(w, w.k.blow_ms);
  assert(rules::walk(w, 1, 0) == rules::Step.Attacked && rat(w) == "none" && w.killed == 1, "the sword, a blow later: gone");
  v = room(6, 1);
  rules::put_hero(v, 1, 0, 0);
  _ = rules::add_enemy(v, "rat", 2, 0, 0);
  v.hero_item = rules::th(v, "sword");
  v.face_x = 1;
  v.face_y = 0;
  assert(rules::swing(v) == rules::Step.Attacked && rat(v) == "x2 y0 hp1", "a swing: {rat(v)}");
}

// Hurt, a rat goes home and heals there.  Its nest on x 6, it stands on x 2 with 1 health, the hero
// on x 0; at 100 it heads home: x 3, x 4 at 450, x 5 at 800, x 6 at 1150.  It waits 4 s a point:
// 2 at 5500, 3 at 9500.
fn test_a_hurt_rat_goes_home_and_heals() {
  w = room(10, 1);
  rules::put_hero(w, 0, 0, 0);
  _ = rules::add_enemy(w, "rat", 6, 0, 0);
  w.enemies[0].x = 2;
  w.enemies[0].hp = 1;
  w.enemies[0].due = 100;
  until(w, 100);
  assert(rat(w) == "x3 y0 hp1", "100: {rat(w)}");
  until(w, 1150);
  assert(rat(w) == "x6 y0 hp1", "1150: home: {rat(w)}");
  until(w, 5499);
  assert(rat(w) == "x6 y0 hp1", "5499: {rat(w)}");
  until(w, 5500);
  assert(rat(w) == "x6 y0 hp2", "5500: {rat(w)}");
  until(w, 9500);
  assert(rat(w) == "x6 y0 hp3", "9500: whole: {rat(w)}");
  // Home first, even towards the hero: the nest on (2, 2), the rat on (4, 2), the hero on (0, 0) —
  // the way home (west) passes nowhere beside the hero, so it takes it, though east is away.
  v = room(6, 3);
  rules::put_hero(v, 0, 0, 0);
  _ = rules::add_enemy(v, "rat", 2, 2, 0);
  v.enemies[0].x = 4;
  v.enemies[0].hp = 1;
  v.enemies[0].due = 100;
  until(v, 100);
  assert(rat(v) == "x3 y2 hp1", "towards home: {rat(v)}");
}

// Cornered — no way home that avoids the hero, no step away — a hurt rat fights: in a dead end on
// x 0, its nest on x 3, the hero on x 1, it bites at 100 and 1000.  Then the hero's sword ends it.
fn test_a_cornered_rat_fights() {
  w = room(4, 1);
  rules::put_hero(w, 1, 0, 0);
  _ = rules::add_enemy(w, "rat", 3, 0, 0);
  w.enemies[0].x = 0;
  w.enemies[0].hp = 1;
  w.enemies[0].due = 100;
  until(w, 100);
  assert(w.health == 5 && rat(w) == "x0 y0 hp1", "100: it bites: {w.health}");
  until(w, 1000);
  assert(w.health == 4, "1000: again: {w.health}");
  w.hero_item = rules::th(w, "sword");
  assert(rules::walk(w, -1, 0) == rules::Step.Attacked && rat(w) == "none" && w.killed == 1, "ended");
}

// A hurt rat with no way home that avoids the hero, but a step away from it, takes the step: three
// rows, the rat on (2, 1), its nest on (4, 1), the hero on (3, 1) between — every way round passes
// beside the hero — so it steps north, away, to (2, 0).
fn test_a_hurt_rat_steps_away() {
  w = room(6, 3);
  rules::put_hero(w, 3, 1, 0);
  _ = rules::add_enemy(w, "rat", 4, 1, 0);
  w.enemies[0].x = 2;
  w.enemies[0].hp = 1;
  w.enemies[0].due = 100;
  until(w, 100);
  assert(rat(w) == "x2 y0 hp1" && w.health == 6, "stepped away: {rat(w)}");
}

// Not seeing the hero, a rat wanders, never more than 3 from its nest: a minute of it in an open
// room, the hero out of sight on another layer.
fn test_a_rat_wanders_near_its_nest() {
  w = room(12, 12);
  rules::put_hero(w, 0, 0, 2);
  _ = rules::add_enemy(w, "rat", 5, 5, 0);
  places = "";
  far = 0;
  for t in 1..601 {
    until(w, t * 100);
    e = w.enemies[0];
    d = (if e.x > 5 { e.x - 5 } else { 5 - e.x }) + (if e.y > 5 { e.y - 5 } else { 5 - e.y });
    if d > far { far = d; }
    if !places.contains("({e.x},{e.y})") { places += "({e.x},{e.y})"; }
  }
  assert(far <= 3, "it strayed {far} from its nest");
  assert(far >= 2, "it hardly moved: {places}");
}

// A blast strikes rats 4 - d: one beside it (3) is gone; one two away keeps 1 health, hurt.
fn test_a_blast_strikes_rats() {
  w = room(8, 1);
  rules::put_hero(w, 0, 0, 2);
  tile_world::place(w.w, 0, 0, 0, rules::th(w, "bomb"));
  _ = rules::add_enemy(w, "rat", 1, 0, 0);
  _ = rules::add_enemy(w, "rat", 2, 0, 0);
  w.fuses += [rules::Fuse { x: 0, y: 0, z: 0, held: false, at: 100 }];
  until(w, 100);
  assert(w.killed == 1 && len(w.enemies) == 1 && (w.enemies[0]).hp == 1, "one gone, one hurt");
}

// --- Step 2: light, bats, spiders, scares, the well, guards ---

// A dark room: as room(), with a ceiling (the layer above set), so no daylight; flames don't
// flicker.
fn dark(n: integer, rows: integer) -> rules::Level {
  w = room(n, rows);
  tile_world::fill(w.w, -1, -1, n, rows, 1, rules::tr(w, "floor"));
  w.k.flicker_odds = 0;
  w
}

// The hero on (x, y) holding a burning torch with its whole time.
fn torchbearer(w: rules::Level, x: integer, y: integer) {
  rules::put_hero(w, x, y, 0);
  w.hero_item = rules::th(w, "burning_torch");
  w.hero_until = w.k.burn_ms;
}

// A rat keeps out of a torch's light: the hero on x 1 holds one, lighting x 1 .. 3 (shade 0 .. 2);
// the rat on x 6 sees the hero but has no dark way to it, so it never comes nearer than x 4 and
// never bites, in 20 s.  Without the torch it comes and bites.
fn test_a_rat_keeps_out_of_a_torchs_light() {
  w = dark(10, 1);
  torchbearer(w, 1, 0);
  _ = rules::add_enemy(w, "rat", 6, 0, 0);
  nearest = 9;
  for t in 1..201 {
    until(w, t * 100);
    if (w.enemies[0]).x < nearest { nearest = (w.enemies[0]).x; }
  }
  assert(nearest >= 4 && w.health == 6, "it came to x {nearest}; health {w.health}");
  v = dark(10, 1);
  rules::put_hero(v, 1, 0, 0);
  _ = rules::add_enemy(v, "rat", 6, 0, 0);
  until(v, 20000);
  assert(v.health < 6, "unlit, it bites: {v.health}");
}

// Hurt, a rat crosses light when it has to: three rows, the hero with a torch on (3, 2), the rat on
// (1, 0) with its nest on (8, 0).  Every way home passes (3, 0), 2 from the torch (lit), so there
// is no dark way: it goes anyway — east, to (2, 0).
fn test_a_hurt_rat_crosses_light_to_get_home() {
  w = dark(10, 3);
  torchbearer(w, 3, 2);
  _ = rules::add_enemy(w, "rat", 8, 0, 0);
  w.enemies[0].x = 1;
  w.enemies[0].hp = 1;
  w.enemies[0].due = 100;
  until(w, 100);
  assert(rat(w) == "x2 y0 hp1", "towards home through the light: {rat(w)}");
}

// A bat drifts to the brightest step, flies over water, never onto a flame: water down x 3, a
// burning torch lying on (5, 1), the bat's nest on (2, 1).  At 300 it takes the brightest step,
// east onto the water (3, 1); at 600 east again to (4, 1); the torch's own cell it never enters.
fn test_a_bat_drifts_to_light_over_water() {
  w = dark(8, 3);
  tile_world::fill(w.w, 3, 0, 3, 2, 0, rules::tr(w, "water"));
  tile_world::place(w.w, 5, 1, 0, rules::th(w, "burning_torch"));
  rules::put_hero(w, 0, 0, 2);
  rules::tick(w, 0);
  _ = rules::add_enemy(w, "bat", 2, 1, 0);
  until(w, 300);
  assert(rat(w) == "x3 y1 hp1", "300: over the water: {rat(w)}");
  until(w, 600);
  assert(rat(w) == "x4 y1 hp1", "600: {rat(w)}");
  on_flame = false;
  for t in 7..200 {
    until(w, t * 100);
    if (w.enemies[0]).x == 5 && (w.enemies[0]).y == 1 { on_flame = true; }
  }
  assert(!on_flame, "never onto the flame");
}

// A spider climbs walls, out of the sword's reach: hurt on x 0 of a row cut by a wall on x 2, its
// nest on x 4, it goes home over the wall — x 1 at 100, onto the wall at 450, x 3 at 800.  On the
// wall beside the hero, the hero's walk into it is blocked, the spider untouched.
fn test_a_spider_climbs_over_a_wall() {
  w = room(6, 1);
  tile_world::set_terrain(w.w, 2, 0, 0, rules::tr(w, "wall"));
  rules::put_hero(w, 0, 0, 2);
  _ = rules::add_enemy(w, "spider", 4, 0, 0);
  w.enemies[0].x = 0;
  w.enemies[0].hp = 1;
  w.enemies[0].due = 100;
  until(w, 100);
  assert(rat(w) == "x1 y0 hp1", "100: {rat(w)}");
  until(w, 450);
  assert(rat(w) == "x2 y0 hp1", "450: up on the wall: {rat(w)}");
  until(w, 800);
  assert(rat(w) == "x3 y0 hp1", "800: over it: {rat(w)}");
  v = room(6, 1);
  tile_world::set_terrain(v.w, 2, 0, 0, rules::tr(v, "wall"));
  rules::put_hero(v, 1, 0, 0);
  _ = rules::add_enemy(v, "spider", 2, 0, 0);
  v.hero_item = rules::th(v, "sword");
  assert(rules::walk(v, 1, 0) == rules::Step.Blocked && rat(v) == "x2 y0 hp2", "out of reach: {rat(v)}");
}

// A blast scares a rat that hears it: its nest on x 5 of a row x 0 .. 11, a bomb on x 0 going off
// at 100 (5 away: heard, out of reach).  It flees east a cell every 350 ms from its first act at
// 600 — x 11 at 2350 — and waits there; scared until 5100, at 5150 it walks home at its wander's
// pace: x 10 at 5150, x 9 at 5750, x 8 at 6350 — back within its roam.
fn test_a_blast_scares_a_rat_away_and_it_comes_back() {
  w = room(12, 1);
  rules::put_hero(w, 0, 0, 2);
  _ = rules::add_enemy(w, "rat", 5, 0, 0);
  tile_world::place(w.w, 0, 0, 0, rules::th(w, "bomb"));
  w.fuses += [rules::Fuse { x: 0, y: 0, z: 0, held: false, at: 100 }];
  until(w, 2350);
  assert(rat(w) == "x11 y0 hp3", "2350: fled to the end: {rat(w)}");
  until(w, 5149);
  assert(rat(w) == "x11 y0 hp3", "5149: still away: {rat(w)}");
  until(w, 5150);
  assert(rat(w) == "x10 y0 hp3", "5150: heading home: {rat(w)}");
  until(w, 6350);
  assert(rat(w) == "x8 y0 hp3", "6350: within its roam: {rat(w)}");
}

// A well gives no water while an enemy is near in sight: the hero on x 1 beside the well on x 0, a
// rat on x 6 — Watched; behind a wall on x 4, out of sight — Saved.
fn test_a_well_saves_only_when_the_area_is_clear() {
  w = room(10, 1);
  tile_world::set_terrain(w.w, 0, 0, 0, rules::tr(w, "well"));
  rules::put_hero(w, 1, 0, 0);
  _ = rules::add_enemy(w, "rat", 6, 0, 0);
  assert(rules::walk(w, -1, 0) == rules::Step.Watched, "a rat in sight: no water");
  tile_world::set_terrain(w.w, 4, 0, 0, rules::tr(w, "wall"));
  assert(rules::walk(w, -1, 0) == rules::Step.Saved, "out of sight: saved");
}

// A guard blocks and steps aside only when the area is clear: on (3, 1) of three rows, the hero on
// (2, 1) walks into it — blocked.  A rat in sight on (5, 0): at 1000 the guard still stands.  The
// rat gone, at its next turn it steps to the side its place prefers, and the way is open.
fn test_a_guard_steps_aside_when_the_area_is_clear() {
  w = room(7, 3);
  rules::put_hero(w, 2, 1, 0);
  _ = rules::add_enemy(w, "guard", 3, 1, 0);
  _ = rules::add_enemy(w, "rat", 5, 0, 0);
  w.enemies[1].due = 100000;
  assert(rules::walk(w, 1, 0) == rules::Step.Blocked && w.hero_x == 2, "blocked");
  until(w, 1000);
  assert((w.enemies[0]).x == 3 && (w.enemies[0]).y == 1, "a rat in sight: it stands");
  _ = w.enemies.remove(1);
  until(w, 1500);
  side = if rules::prefers_right(3, 1, 0) { 2 } else { 0 };
  g = w.enemies[0];
  assert(g.x == 3 && g.y == side, "stepped aside to (3, {side}): ({g.x}, {g.y})");
  assert(rules::walk(w, 1, 0) == rules::Step.Walked && w.hero_x == 3, "the way is open");
}

// A bat drifts towards light: the same bat (nest (4, 1), roaming 5) in a dark 14 x 3 room, with a
// burning torch lying on (9, 1) and without one.  Over 30 s, sampled every 100 ms, the lit bat's
// mean x is more than a cell nearer the torch than the unlit one's.
fn bat_mean_x(lit: boolean) -> integer {
  w = dark(14, 3);
  if lit { tile_world::place(w.w, 9, 1, 0, rules::th(w, "burning_torch")); }
  rules::put_hero(w, 0, 0, 2);
  rules::tick(w, 0);
  _ = rules::add_enemy(w, "bat", 4, 1, 0);
  sum = 0;
  for t in 1..301 {
    until(w, t * 100);
    sum += (w.enemies[0]).x;
  }
  sum / 300 ?? 0
}

fn test_a_bat_drifts_towards_light() {
  lit = bat_mean_x(true);
  unlit = bat_mean_x(false);
  assert(lit > unlit + 1, "lit mean x {lit}, unlit {unlit}");
}

// Caught in a torch's light with dark near, a rat gets out of it: the hero with a torch on x 2, the
// rat on x 4 (shade 2, lit), its nest on x 4.  At its first act (600) it steps east into the dark,
// to x 5 (shade 3), and never bites.  In daylight (no ceiling) the same rat comes at the hero.
fn test_a_rat_caught_in_light_gets_out_of_it() {
  w = dark(10, 1);
  torchbearer(w, 2, 0);
  _ = rules::add_enemy(w, "rat", 4, 0, 0);
  until(w, 600);
  assert(rat(w) == "x5 y0 hp3", "600: out of the light: {rat(w)}");
  until(w, 10000);
  assert(w.health == 6, "never bitten: {w.health}");
  v = room(10, 1);
  rules::put_hero(v, 2, 0, 0);
  v.hero_item = rules::th(v, "burning_torch");
  v.hero_until = v.k.burn_ms;
  _ = rules::add_enemy(v, "rat", 4, 0, 0);
  until(v, 3000);
  assert(v.health < 6, "in daylight it bites: {v.health}");
}
