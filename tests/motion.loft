//
// The cut-out motion (motion.loft): a step, a stagger and a swing, read at chosen moments.  Every
// number is worked by hand from the constants — a step 140 ms, hop 2, rock 4, sway 8; a stagger
// 280 ms, knock 3, fling 35; a swing 80 + 60 + 100 ms through 70 degrees either side, lunging 2 —
// with part(top, e, n) = (2 top e + n) / 2n (rounded half up) and the arc a triangle over n.
use motion;

fn show(p: const motion::Pose) -> text {
  "x{p.x} y{p.y} t{p.tilt} w{p.weapon} r{p.reach}"
}

fn main() {
  assert(motion::facing(1, 0) == 90 && motion::facing(-1, 0) == 270, "right and left");
  assert(motion::facing(0, 1) == 180 && motion::facing(0, -1) == 0, "down and up");
}

// One step right from standing (the first step rocks to the left): it glides in from 16 px back,
// hops and rocks to the top at 70 ms, and the weapon, pointing right, sways a quarter step late.
//   35 ms: x -part(16, 105, 140) = -12, hop part(2, 35, 70) = 1, rock -part(7, 35, 70) = -4,
//          the sway not begun;
//   70 ms: x -8, hop 2, rock -part(7, 70, 70) = -7, the sway part(8, 35, 53) = 5 the other way: 95;
//   140 ms: done — standing still.
fn test_a_step_glides_hops_and_rocks() {
  m = motion::still();
  motion::walk(m, 1000, 1, 0, 0, 1, 0);
  assert(show(motion::pose(m, 1, 0, 1000)) == "x-16 y0 t0 w90 r1", "0: {show(motion::pose(m, 1, 0, 1000))}");
  assert(show(motion::pose(m, 1, 0, 1035)) == "x-12 y-1 t-4 w90 r1", "35: {show(motion::pose(m, 1, 0, 1035))}");
  assert(show(motion::pose(m, 1, 0, 1070)) == "x-8 y-2 t-7 w95 r1", "70: {show(motion::pose(m, 1, 0, 1070))}");
  assert(show(motion::pose(m, 1, 0, 1140)) == "x0 y0 t0 w90 r0", "after: {show(motion::pose(m, 1, 0, 1140))}");
  assert(!motion::busy(m, 1140) && motion::busy(m, 1139), "busy for 140 ms");
}

// The next step rocks the other way; a step taken mid-step glides on from where the body was
// drawn (x -8 at 70 ms, so 24 px back), its hop starting again from the ground; a step up a rise
// starts 4 px below its new place.
fn test_steps_alternate_and_chain() {
  m = motion::still();
  motion::walk(m, 0, 1, 0, 0, 1, 0);
  motion::walk(m, 70, 1, 0, 0, 1, 0);
  assert(m.from_x == -24 && m.from_y == 0, "from {m.from_x},{m.from_y}");
  assert(motion::pose(m, 1, 0, 140).tilt == motion::ROCK, "the second step rocks right: {motion::pose(m, 1, 0, 140).tilt}");
  u = motion::still();
  motion::walk(u, 0, 0, 1, 4, 0, 1);
  assert(u.from_x == 0 && u.from_y == -12, "down a cell and up a step: from {u.from_x},{u.from_y}");
}

// Walking right into a wall: knocked 3 px back (left) in 70 ms, and slowly back; the body wobbles
// (6, -5, 3, -1 in each quarter, away from the knock) and the weapon is flung back.
//   35 ms: x -part(3, 35, 70) = -2, tilt 6, weapon 90 - part(35, 245, 280) = 59;
//   70 ms: x -part(3, 210, 210) = -3, tilt -5, weapon 64;
//   210 ms: x -part(3, 70, 210) = -1, tilt -1, weapon 81.
fn test_a_stagger_knocks_back_and_wobbles() {
  m = motion::still();
  motion::stagger(m, 0, -1, 0, 0, 0, 1, 0);
  assert(show(motion::pose(m, 1, 0, 35)) == "x-2 y0 t6 w59 r0", "35: {show(motion::pose(m, 1, 0, 35))}");
  assert(show(motion::pose(m, 1, 0, 70)) == "x-3 y0 t-5 w64 r0", "70: {show(motion::pose(m, 1, 0, 70))}");
  assert(show(motion::pose(m, 1, 0, 210)) == "x-1 y0 t-1 w81 r0", "210: {show(motion::pose(m, 1, 0, 210))}");
  assert(show(motion::pose(m, 1, 0, 280)) == "x0 y0 t0 w90 r0", "after: {show(motion::pose(m, 1, 0, 280))}");
}

// A swing facing right, clockwise: wound up to 90 - 35 = 55 at 40 ms; at 110 ms mid-strike
// 20 + part(140, 30, 60) = 90, lunging 2; at 139 ms nearly through, 158; recovering at 190 ms,
// 90 + part(70, 50, 100) = 125, the lunge part(2, 50, 100) = 1.  Facing left it winds the other
// way: 270 + 35 = 305.
fn test_a_swing_winds_strikes_and_recovers() {
  m = motion::still();
  motion::swing(m, 0);
  assert(show(motion::pose(m, 1, 0, 40)) == "x0 y0 t-2 w55 r0", "40: {show(motion::pose(m, 1, 0, 40))}");
  assert(show(motion::pose(m, 1, 0, 110)) == "x2 y0 t3 w90 r2", "110: {show(motion::pose(m, 1, 0, 110))}");
  assert(motion::pose(m, 1, 0, 139).weapon == 158, "139: {motion::pose(m, 1, 0, 139).weapon}");
  assert(show(motion::pose(m, 1, 0, 190)) == "x1 y0 t2 w125 r1", "190: {show(motion::pose(m, 1, 0, 190))}");
  assert(motion::pose(m, -1, 0, 40).weapon == 305, "left: {motion::pose(m, -1, 0, 40).weapon}");
  assert(show(motion::pose(m, 1, 0, 240)) == "x0 y0 t0 w90 r0", "after: {show(motion::pose(m, 1, 0, 240))}");
}

// Hit and shoved a cell down (a cart): it glides in from 16 px up while knocked down 3 more:
// at 70 ms y = -part(16, 210, 280) + 3 = -12 + 3 = -9; at 140 ms -8 + part(3, 140, 210) = -6.
fn test_a_hit_that_moves_glides_while_it_staggers() {
  m = motion::still();
  motion::stagger(m, 0, 0, 1, 0, 1, 1, 0);
  assert(motion::pose(m, 1, 0, 70).y == -9 && motion::pose(m, 1, 0, 70).x == 0, "70: {show(motion::pose(m, 1, 0, 70))}");
  assert(motion::pose(m, 1, 0, 140).y == -6, "140: {show(motion::pose(m, 1, 0, 140))}");
}

// The fine pose, for drawing at a display's resolution.  A step right from a cell left
// (from_x -16), the first, so rocking to -ROCK: at 70 of 140 ms halfway in (x -8), the hop at its
// top (2 sin(pi/2) = 2, so y -2) and the rock at its peak (-7); at 35 ms the hop is
// 2 sin(pi/4) = 1.414..., the glide three quarters left (-12).
fn near(a: float, b: float) -> boolean {
  d = a - b;
  d < 0.000001 && d > -0.000001
}

fn test_the_fine_pose_of_a_step() {
  m = motion::still();
  motion::walk(m, 1000, 1, 0, 0, 1, 0);
  p = motion::fine_pose(m, 1, 0, 1070);
  assert(near(p.x, -8.0) && near(p.hop, 2.0) && near(p.y, -2.0) && near(p.tilt, -7.0), "70: {p.x} {p.y} {p.tilt}");
  q = motion::fine_pose(m, 1, 0, 1035);
  assert(near(q.x, -12.0) && near(q.hop, 2.0 * sin(PI / 4.0)) && near(q.tilt, -7.0 * sin(PI / 4.0)), "35: {q.x} {q.hop}");
  r = motion::fine_pose(m, 1, 0, 1140);
  assert(r.x == 0.0 && r.y == 0.0 && r.tilt == 0.0, "after: standing");
}

// A stagger knocked left (away -1): the wobble is 7 (1 - t) cos(4 pi (t - 1/8)) the far way:
// 0 at the start, +6.125 at an eighth (pose's first quarter reads +6), 0 at a quarter,
// -4.375 at three eighths (pose: -5).
fn test_the_fine_wobble_is_a_damped_wave() {
  m = motion::still();
  motion::stagger(m, 0, -1, 0, 0, 0, 1, 0);
  assert(near(motion::fine_pose(m, 1, 0, 0).tilt, 0.0), "starts upright: {motion::fine_pose(m, 1, 0, 0).tilt}");
  assert(near(motion::fine_pose(m, 1, 0, 35).tilt, 6.125), "an eighth: {motion::fine_pose(m, 1, 0, 35).tilt}");
  assert(near(motion::fine_pose(m, 1, 0, 70).tilt, 0.0), "a quarter: {motion::fine_pose(m, 1, 0, 70).tilt}");
  assert(near(motion::fine_pose(m, 1, 0, 105).tilt, -4.375), "three eighths: {motion::fine_pose(m, 1, 0, 105).tilt}");
}

// A parry (@GM-Combat): facing right (90, the stroke clockwise) the weapon flicks from across the
// body, 90 - 75 = 15, out past the facing to 90 + 45 in 60 ms, and back to the facing by 160 ms.
//   0 ms: 15, leaning 2 into it, reach 0;
//   30 ms: 15 + part(120, 30, 60) = 75, reach part(2, 30, 60) = 1;
//   60 ms: 90 + part(45, 100, 100) = 135, reach 2;
//   110 ms: 90 + part(45, 50, 100) = 113, tilt part(2, 50, 100) = 1, reach 1.
fn test_a_parry_flicks_out_from_across_the_body() {
  m = motion::still();
  motion::flick(m, 0);
  assert(show(motion::pose(m, 1, 0, 0)) == "x0 y0 t2 w15 r0", "0: {show(motion::pose(m, 1, 0, 0))}");
  assert(show(motion::pose(m, 1, 0, 30)) == "x0 y0 t2 w75 r1", "30: {show(motion::pose(m, 1, 0, 30))}");
  assert(show(motion::pose(m, 1, 0, 60)) == "x0 y0 t2 w135 r2", "60: {show(motion::pose(m, 1, 0, 60))}");
  assert(show(motion::pose(m, 1, 0, 110)) == "x0 y0 t1 w113 r1", "110: {show(motion::pose(m, 1, 0, 110))}");
  assert(show(motion::pose(m, 1, 0, 160)) == "x0 y0 t0 w90 r0", "after: {show(motion::pose(m, 1, 0, 160))}");
  f = motion::fine_pose(m, 1, 0, 30);
  assert(f.weapon > 74.99 && f.weapon < 75.01 && f.reach > 0.99 && f.reach < 1.01, "fine at 30: {f.weapon} {f.reach}");
}

// A blow on the guard: pushed back 2 px (left) in 45 ms, back by 180 ms; no wobble, no fling.
//   20 ms: part(2, 20, 45) = 1; 45 ms: 2; 135 ms: part(2, 45, 135) = 1.
fn test_a_blocked_blow_pushes_the_guard_back() {
  m = motion::still();
  motion::brace(m, 0, -1, 0);
  assert(show(motion::pose(m, 1, 0, 20)) == "x-1 y0 t0 w90 r0", "20: {show(motion::pose(m, 1, 0, 20))}");
  assert(show(motion::pose(m, 1, 0, 45)) == "x-2 y0 t0 w90 r0", "45: {show(motion::pose(m, 1, 0, 45))}");
  assert(show(motion::pose(m, 1, 0, 135)) == "x-1 y0 t0 w90 r0", "135: {show(motion::pose(m, 1, 0, 135))}");
  assert(!motion::busy(m, 180), "over at 180");
}

// A riposte's stagger (strength 2) doubles the knock, the wobble and the fling: at 35 ms
// x -part(6, 35, 70) = -3, tilt 2 * 6 = 12, weapon 90 - part(70, 245, 280) = 29 (a hit: -2, 6, 59).
fn test_a_riposte_staggers_twice_as_hard() {
  m = motion::still();
  motion::stagger(m, 0, -1, 0, 0, 0, 1, 0, 2);
  assert(show(motion::pose(m, 1, 0, 35)) == "x-3 y0 t12 w29 r0", "35: {show(motion::pose(m, 1, 0, 35))}");
}

// The stances, over a standing pose facing right (weapon 90): the guard turns the weapon across
// the body to 15, draws it in (reach -1), crouches a pixel and leans back 3; a wind-up all the way
// raises it back to 90 - 70 = 20, a sweep's to 90 - 150 = -60; open after a parry it hangs at
// 90 + 120 = 210, the body 2 px back, leaning 6; wounded, a pixel lower, and standing a quarter
// of the way through its sway (400 of 1600 ms) leaning the full 3.
fn test_the_stances_read_apart() {
  m = motion::still();
  g = motion::fine_pose(m, 1, 0, 0);
  motion::guard(g, 1, 0);
  assert(near(g.weapon, 15.0) && near(g.reach, -1.0) && near(g.y, 1.0) && near(g.tilt, -3.0), "guard: {g.weapon} {g.reach} {g.y} {g.tilt}");
  a = motion::fine_pose(m, 1, 0, 0);
  motion::windup(a, 1, 0, 1.0, false);
  b = motion::fine_pose(m, 1, 0, 0);
  motion::windup(b, 1, 0, 1.0, true);
  assert(near(a.weapon, 20.0) && near(b.weapon, -60.0), "a blow {a.weapon}, a sweep {b.weapon}");
  o = motion::fine_pose(m, 1, 0, 0);
  motion::open(o, 1, 0);
  assert(near(o.weapon, 210.0) && near(o.x, -2.0) && near(o.tilt, -6.0), "open: {o.weapon} {o.x} {o.tilt}");
  h = motion::fine_pose(m, 1, 0, 0);
  motion::wounded(h, 400, true);
  assert(near(h.y, 1.0) && near(h.tilt, 3.0), "wounded: {h.y} {h.tilt}");
}
