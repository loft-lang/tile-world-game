//
// What the game fills in from a developer's intent: the shapes by hand, and the promises — what
// is scattered never blocks a doorway or cuts a room in two, and the same intent gives the same
// cells (this file runs on both backends).
use intent;

fn rubble(per: integer) -> vector<intent::Word> {
  [intent::Word { name: "rubble", things: ["rock"], per_100: per, along_walls: false },
   intent::Word { name: "furnished", things: ["table", "chair"], per_100: per, along_walls: true }]
}

fn room(x: integer, y: integer, w: integer, h: integer, words: vector<text>) -> intent::Room {
  intent::Room { x: x, y: y, w: w, h: h, z: 0, words: words }
}

fn picture(fills: const vector<intent::Fill>, x0: integer, y0: integer, w: integer, h: integer) -> text {
  rows = "";
  for y in y0..y0 + h {
    for x in x0..x0 + w {
      ch = " ";
      for f in fills {
        if f.x == x && f.y == y {
          ch = if f.thing != "" { "o" } else if f.terrain == "wall" { "#" } else { "." };
        }
      }
      rows += ch;
    }
    rows += "|";
  }
  rows
}

fn test_a_room_is_its_outline_and_floor() {
  it = intent::Intent { seed: 1, rooms: [room(0, 0, 4, 3, [])], corridors: [] };
  got = picture(intent::derive(it, rubble(0)), 0, 0, 4, 3);
  assert(got == "####|#..#|####|", "a 4x3 room: {got}");
}

// Two rooms joined by a corridor from (3, 1) to (6, 1): the walls it crosses, (3, 1) and (6, 1),
// are doorways; walls are put beside the corridor where there was nothing.
fn test_a_corridor_opens_doorways_in_both_rooms() {
  it = intent::Intent { seed: 1, rooms: [room(0, 0, 4, 3, []), room(6, 0, 4, 3, [])],
                        corridors: [intent::Corridor { x0: 3, y0: 1, x1: 6, y1: 1, z: 0 }] };
  got = picture(intent::derive(it, rubble(0)), 0, 0, 10, 3);
  assert(got == "##########|#........#|##########|", "joined: {got}");
}

// (area * per + 50) / 100 things: a 7x6 room has 5 x 4 = 20 floor cells, so 25 per hundred is 5.
fn test_a_word_scatters_its_share() {
  it = intent::Intent { seed: 3, rooms: [room(0, 0, 7, 6, ["rubble"])], corridors: [] };
  n = 0;
  for f in intent::derive(it, rubble(25)) { if f.thing == "rock" { n += 1; } }
  assert(n == 5, "5 rocks: {n}");
}

// However thick the rubble, the room's free floor stays one piece, every doorway and the cell
// inside it stay free, and the corridor between them stays open.
fn free_floor_is_one_piece(fills: const vector<intent::Fill>, x0: integer, y0: integer, x1: integer, y1: integer) -> boolean {
  free: vector<(integer, integer)> = [];
  for f in fills { if f.terrain == "floor" && f.thing == "" && f.x >= x0 && f.x <= x1 && f.y >= y0 && f.y <= y1 { free += [(f.x, f.y)]; } }
  if len(free) == 0 { return true; }
  seen = [free[0]];
  todo = [free[0]];
  while len(todo) > 0 {
    p = todo[len(todo) - 1];
    todo = todo[0..len(todo) - 1];
    for q in free {
      d = (if q.0 > p.0 { q.0 - p.0 } else { p.0 - q.0 }) + (if q.1 > p.1 { q.1 - p.1 } else { p.1 - q.1 });
      if d == 1 && !seen.contains(q) {
        seen += [q];
        todo += [q];
      }
    }
  }
  len(seen) == len(free)
}

fn test_scattering_never_blocks_a_way() {
  for seed in 1..12 {
    it = intent::Intent { seed: seed, rooms: [room(0, 0, 6, 6, ["rubble", "furnished"]), room(9, 0, 5, 6, ["rubble"])],
                          corridors: [intent::Corridor { x0: 5, y0: 2, x1: 9, y1: 2, z: 0 },
                                      intent::Corridor { x0: 2, y0: 5, x1: 2, y1: 8, z: 0 }] };
    fills = intent::derive(it, rubble(100));
    things = 0;
    for f in fills {
      if f.thing != "" { things += 1; }
      // The doorways and the cells inside them.
      if (f.x == 5 && f.y == 2) || (f.x == 4 && f.y == 2) || (f.x == 9 && f.y == 2) || (f.x == 10 && f.y == 2) ||
         (f.x == 2 && f.y == 5) || (f.x == 2 && f.y == 4) {
        assert(f.terrain == "floor" && f.thing == "", "seed {seed}: ({f.x}, {f.y}) is {f.terrain} {f.thing}");
      }
    }
    assert(things > 0, "seed {seed}: something was scattered");
    assert(free_floor_is_one_piece(fills, 0, 0, 13, 8), "seed {seed}: the free floor is one piece");
  }
}

fn test_the_same_intent_gives_the_same_cells() {
  it = intent::Intent { seed: 42, rooms: [room(0, 0, 9, 7, ["rubble", "furnished"])], corridors: [] };
  a = picture(intent::derive(it, rubble(30)), 0, 0, 9, 7);
  b = picture(intent::derive(it, rubble(30)), 0, 0, 9, 7);
  assert(a == b, "twice the same: {a} / {b}");
  it.seed = 43;
  c = picture(intent::derive(it, rubble(30)), 0, 0, 9, 7);
  assert(a != c, "another seed scatters elsewhere");
  // The cells, pinned as the interpreter derived them (20 things, the 15 free cells one piece,
  // read by hand): the C backend runs this file too and must give the same picture.
  assert(a == "#########|#ooooooo#|#o..o...#|#oo...o.#|#o..oo..#|#oooo..o#|#########|", "pinned: {a}");
}

// A crag (walls move one cell in per layer up): for every floor cell of the cave, the first
// wall above it is on the layer of its distance from outside the floor — counted over the eight
// neighbours, as the walls step in — and nothing above is floor.  Computed here from the floor
// alone, apart from the kit.  The intent saves and loads back the same.
fn test_a_crag_steps_its_walls_in_a_cell_a_layer() {
  it = intent::Intent { seed: 47, rooms: [], corridors: [], domes: [intent::Dome { x: 2, y: 1, w: 13, h: 11, z: 0, shape: "crag" }] };
  fills = intent::derive(it, []);
  floor: vector<(integer, integer)> = [];
  for f in fills {
    if f.z == 0 && f.terrain == "floor" { floor += [(f.x, f.y)]; }
    assert(f.z == 0 || f.terrain == "wall", "above the floor only wall: {f.x},{f.y},{f.z} {f.terrain}");
  }
  assert(len(floor) > 60, "a cave's floor: {len(floor)}");
  for c in floor {
    // Its distance from outside: the smallest ring (in eight-neighbour steps) holding a non-floor cell.
    d = 1;
    found = false;
    while !found && d < 20 {
      for dy in -d..=d {
        for dx in -d..=d {
          inside = false;
          for q in floor { if q.0 == c.0 + dx && q.1 == c.1 + dy { inside = true; } }
          if !inside { found = true; }
        }
      }
      if !found { d += 1; }
    }
    first = -1;
    for f in fills {
      if f.x == c.0 && f.y == c.1 && f.z > 0 && f.terrain == "wall" && (first < 0 || f.z < first) { first = f.z; }
    }
    assert(first == d, "{c.0},{c.1}: the ceiling at layer {first}, its distance {d}");
  }
  back = intent::intent_from(json_parse(intent::intent_json(it)));
  assert(len(back.domes) == 1 && intent::intent_json(back) == intent::intent_json(it), "saves and loads back");
}

// Straight walls (owner: a cave can have partly straight walls, and so more height there): the
// same crag, its north side rising straight for 2 layers.  No cell's ceiling is lower for it, none
// more than 2 higher; along the north edge some cell's is the full 2 higher, along the south edge
// none is; and above the outside cell north of each such cell the wall stands on layers 1 and 2.
fn test_a_straight_wall_rises_before_it_steps_in() {
  plain = intent::Dome { x: 2, y: 1, w: 13, h: 11, z: 0, shape: "crag" };
  tall = intent::Dome { x: 2, y: 1, w: 13, h: 11, z: 0, straight: 2, sides: "N", shape: "crag" };
  a = intent::dome_heights(plain, 47);
  b = intent::dome_heights(tall, 47);
  fills = intent::derive(intent::Intent { seed: 47, rooms: [], corridors: [], domes: [tall] }, []);
  north_full = 0;
  south_more = 0;
  for y in b.y..b.y + b.h {
    for x in b.x..b.x + b.w {
      ha = a.v[(y - a.y) * a.w + (x - a.x)] ?? 0;
      hb = b.v[(y - b.y) * b.w + (x - b.x)] ?? 0;
      if ha == 0 { continue; }
      assert(hb >= ha && hb <= ha + 2, "{x},{y}: {ha} then {hb}");
      north_edge = (a.v[(y - 1 - a.y) * a.w + (x - a.x)] ?? 0) == 0;
      south_edge = (a.v[(y + 1 - a.y) * a.w + (x - a.x)] ?? 0) == 0;
      if north_edge && hb == ha + 2 {
        north_full += 1;
        for z in [1, 2] {
          wall = false;
          for f in fills { if f.x == x && f.y == y - 1 && f.z == z && f.terrain == "wall" { wall = true; } }
          assert(wall, "{x},{y - 1}: the straight wall on layer {z}");
        }
      }
      if south_edge && !north_edge && hb > ha { south_more += 1; }
    }
  }
  assert(north_full > 0 && south_more == 0, "the north side rises straight, the south does not: {north_full} {south_more}");
}

fn field(f: const intent::Heights, x: integer, y: integer) -> integer {
  if x < f.x || y < f.y || x >= f.x + f.w || y >= f.y + f.h { return 0; }
  f.v[(y - f.y) * f.w + (x - f.x)] ?? 0
}

// How far below a dome's top (owner): the middle 8 at the top, a step of 4, a step of 2, then a layer
// a step to its foot — r being the steps from the middle.
fn drop_of(r: integer) -> integer {
  if r <= 4 { 0 } else if r <= 8 { 1 } else if r <= 10 { 2 } else { 2 + r - 10 }
}

// A dome (owner: the higher layers push towards the middle, so the middle holds bigger spans): on a
// wide floor (41 by 31) each cell's ceiling is the profile of its steps from the middle — the crag's
// field being each cell's distance from the edge (checked above) — so going up the walls step in 1
// a layer, then 2, then 4, and the top closes over a middle no wider than 8 steps across (9 cells).
// A chosen height: taller, every ceiling raised by the difference (straight walls first); lower,
// flattened but still rising to the middle.
fn test_a_dome_flattens_towards_its_top() {
  crag = intent::dome_heights(intent::Dome { x: 0, y: 0, w: 41, h: 31, z: 0, shape: "crag" }, 61);
  dome = intent::dome_heights(intent::Dome { x: 0, y: 0, w: 41, h: 31, z: 0 }, 61);
  far = 0;
  for v in crag.v { if v > far { far = v; } }
  own = 1 + drop_of(far - 1);
  top_open = 0;
  for y in crag.y..crag.y + crag.h {
    for x in crag.x..crag.x + crag.w {
      d = field(crag, x, y);
      if d == 0 { continue; }
      assert(field(dome, x, y) == own - drop_of(far - d), "{x},{y}: distance {d}, ceiling {field(dome, x, y)}");
      if field(dome, x, y) == own { top_open += 1; }
    }
  }
  assert(far > 10 && own == far - 8, "a wide dome: middle {far}, height {own}");
  assert(top_open > 0, "a middle under the top");
  taller = intent::dome_heights(intent::Dome { x: 0, y: 0, w: 41, h: 31, z: 0, height: own + 3 }, 61);
  lower = intent::dome_heights(intent::Dome { x: 0, y: 0, w: 41, h: 31, z: 0, height: 3 }, 61);
  for k in 0..len(dome.v) {
    n = dome.v[k] ?? 0;
    if n == 0 { continue; }
    assert((taller.v[k] ?? 0) == n + 3, "taller: raised by 3");
    assert((lower.v[k] ?? 0) >= 1 && (lower.v[k] ?? 0) <= 3, "lower: within 3");
  }
}

// Two caves on one floor that overlap are one cave: each shaped within the whole (its distances to
// the edge of the joined floor, so the seam does not dip), every cell's ceiling the higher of the
// two — read from what the kit draws (the first wall above each floor cell) — and it holds.
fn test_caves_combine_into_one() {
  a = intent::Dome { x: 0, y: 0, w: 13, h: 11, z: 0 };
  b = intent::Dome { x: 8, y: 4, w: 15, h: 9, z: 0, shape: "crag" };
  fa = intent::dome_heights(a, 67, [a, b]);
  fb = intent::dome_heights(b, 67, [a, b]);
  fills = intent::derive(intent::Intent { seed: 67, rooms: [], corridors: [], domes: [a, b] }, []);
  checked = 0;
  for f in fills {
    if f.z != 0 || f.terrain != "floor" { continue; }
    want = field(fa, f.x, f.y);
    if field(fb, f.x, f.y) > want { want = field(fb, f.x, f.y); }
    first = -1;
    for g in fills { if g.x == f.x && g.y == f.y && g.z > 0 && g.terrain == "wall" && (first < 0 || g.z < first) { first = g.z; } }
    assert(first == want, "{f.x},{f.y}: ceiling at {first}, the higher of the two {want}");
    checked += 1;
  }
  assert(checked > 100, "one cave: {checked} floor cells");
}
