// The deal (HOUSES.md § The deal): Orbury's ordinary houses dealt from the templates by a seed —
// each one played by the rules before it is dealt, Sibil's always with a cellar, the same seed the
// same town and another seed another.
use tile_world;
use rules;
use materials;
use levels;
use intent;
use stamp;
use deal;

fn kit() -> (rules::Kinds, materials::Materials) {
  k = rules::kinds();
  (k, materials::load(file("../theme.json").content() ?? "", k))
}

fn orbury() -> levels::LevelFile {
  km = kit();
  m = levels::load_with(file("../levels/orbury.json").content() ?? "", km.0, km.1);
  if !m { assert(false, "orbury loads"); }
  m ?? levels::LevelFile { name: "", level: rules::level(km.0), start_x: 0, start_y: 0, start_z: 0,
                           goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 } }
}

fn dealt(seed: integer) -> (levels::LevelFile, deal::Deal) {
  km = kit();
  lf = orbury();
  ts = stamp::all("../levels/templates", km.0, km.1);
  town = deal::town(lf.level, lf.start_x, lf.start_y, lf.start_z);
  assert(len(town) > 500, "the town is walked: {len(town)} cells");
  d = deal::deal(lf.level, lf.intent, ts, seed, town, km.1);
  (lf, d)
}

fn test_every_ordinary_house_is_dealt_and_played() {
  r = dealt(7);
  d = r.1;
  assert(len(d.houses) == 11, "the ordinary houses: {len(d.houses)}");
  passed = 0;
  for h in d.houses { if h.draw >= 0 { passed += 1; } }
  assert(passed == 11, "every house passed a draw: {passed}; {deal::describe(d)}");
  assert(d.sibil >= 0, "one is Sibil's: {deal::describe(d)}");
  for h in d.houses {
    if h.sibil { assert(h.cellar != "cellar_none" && h.cellar != "", "Sibil's has a cellar: {h.cellar}"); }
  }
}

fn test_the_same_seed_deals_the_same_town() {
  a = deal::describe(dealt(7).1);
  b = deal::describe(dealt(7).1);
  c = deal::describe(dealt(8).1);
  assert(a == b, "seed 7 twice");
  assert(a != c, "seed 8 another");
}

// A template drawn for the upper floor of a house of two floors is never laid on a cottage of one,
// where its layer 1 would be the roof (no bats on the roofs), nor one drawn for a cottage's roof on a
// house of two; and the two-floor houses get their ways in — the upper window by a step, the upper
// door onto the street above — played as every way in is.
fn test_templates_keep_to_the_houses_they_are_drawn_for() {
  km = kit();
  ts = stamp::all("../levels/templates", km.0, km.1);
  upper = 0;
  for seed in [7, 8, 9, 10, 11, 12] {
    r = dealt(seed);
    for h in r.1.houses {
      fl = r.0.intent.houses[h.house]!.floors;
      for p in h.laid {
        t = stamp::named(ts, p.name) ?? continue;
        assert(t.template.floors == 0 || t.template.floors == fl, "seed {seed}: {p.name} (drawn for {t.template.floors}) on house {h.house} of {fl}");
        if p.name == "way_window_step" || p.name == "way_upper_door" { upper += 1; }
      }
    }
  }
  assert(upper >= 1, "two-floor ways in dealt: {upper}");
}

// Tunnels (HOUSES.md § Tunnels): over a few seeds, cellars reached only by a tunnel are dealt, each
// with its tunnel laid from its gap, and played (every house dealt passed its draw).
fn test_tunnels_are_laid_to_the_cellars_that_need_them() {
  tunnels = 0;
  for seed in [7, 8, 10, 12] {
    d = dealt(seed).1;
    for h in d.houses {
      assert(h.draw >= 0, "seed {seed}: house {h.house} dealt");
      needs = h.cellar == "cellar_tunnel_only" || h.cellar == "cellar_under_fall" || h.cellar == "cellar_outside_door";
      has = false;
      for p in h.laid { if p.name.starts_with("tunnel_") && p.name != "tunnel_neighbours" { has = true; } }
      assert(needs == has, "seed {seed}: house {h.house}'s {h.cellar} and its tunnel: {has}");
      if has { tunnels += 1; }
    }
  }
  assert(tunnels >= 3, "tunnels laid: {tunnels}");
}

// The neighbours' passage (HOUSES.md § Tunnels): a connecting cellar drawn creates the neighbour's
// cellar and the passage between, and the hero walks from the one's floor along it into the other's.
fn test_a_connecting_cellar_creates_the_neighbours() {
  joins = 0;
  for seed in [7, 8, 9, 10] {
    r = dealt(seed);
    l = r.0.level;
    for j in r.1.joined {
      joins += 1;
      b = -1;
      for i in 0..len(r.1.houses) { if r.1.houses[i]!.house == j.b { b = i; } }
      assert(b >= 0 && r.1.houses[b]!.cellar == "cellar_neighbours_end", "seed {seed}: house {j.b} has the created cellar");
      l.enemies = [];
      rules::put_hero(l, j.x0, j.y, j.z);
      step = if j.x1 > j.x0 { "d " } else { "a " };
      moves = "";
      for _ in 0..(if j.x1 > j.x0 { j.x1 - j.x0 } else { j.x0 - j.x1 }) { moves += step; }
      rules::play(l, moves);
      // Into the other's cellar — or, where the walk ends on its stairs, up them into the house.
      assert(l.hero_x == j.x1 && l.hero_y == j.y && (l.hero_z == j.z || l.hero_z == j.z + 1),
             "seed {seed}: from house {j.a}'s cellar into {j.b}'s: ({l.hero_x}, {l.hero_y}, {l.hero_z})");
    }
  }
  assert(joins >= 1, "cellars knocked through: {joins}");
}

// The finds (HOUSES.md § The finds): a find lies only on a spot one of its house's templates offers.
fn test_finds_lie_on_the_templates_spots() {
  km = kit();
  ts = stamp::all("../levels/templates", km.0, km.1);
  finds = 0;
  for seed in [7, 8, 9] {
    d = dealt(seed).1;
    for h in d.houses {
      spots: vector<(integer, integer, integer)> = [];
      for p in h.laid {
        t = stamp::named(ts, p.name) ?? continue;
        st = stamp::stretched(t, p.stretch);
        for c in st.template.finds { spots += [stamp::landing(st, p.x, p.y, p.z, p.turn, p.flip, c.0, c.1, c.2)]; }
      }
      for p in h.laid {
        if !p.name.starts_with("find_") { continue; }
        finds += 1;
        assert(spots.contains((p.x, p.y, p.z)), "seed {seed}: {p.name} on house {h.house} at a spot: ({p.x}, {p.y}, {p.z})");
      }
    }
  }
  assert(finds >= 1, "finds dealt: {finds}");
}
