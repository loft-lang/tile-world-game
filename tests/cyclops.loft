// Cyclopes (DESIGN.md § Enemies): health 5, a blow of 2; they see a hero standing in light within
// 8 cells, one in the dark only within 2; seeing the hero they shout and call the others of their
// kind within 6 cells; losing it they search the place they last saw it for 6 s; a blast they hear
// draws them to it; hurt, they fight on, and heal at their nest once nothing is left to search.
// Every cyclops here first acts at 800, chases a cell every 450, waits 1200 after a blow and looks
// round every 800.  Every time is worked by hand.
use tile_world;
use rules;

// A corridor x 0 .. n - 1, y 0 .. rows - 1, walled; with `ceiling` under a roof (dark: only flames
// light it), else in daylight.  A floor on (0, 0, 2), out of everyone's sight.
fn hall(n: integer, rows: integer, ceiling: boolean) -> rules::Level {
  w = rules::level(rules::kinds());
  tile_world::fill(w.w, -1, -1, n, rows, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, n - 1, rows - 1, 0, rules::tr(w, "floor"));
  if ceiling { tile_world::fill(w.w, -1, -1, n, rows, 1, rules::tr(w, "floor")); }
  tile_world::set_terrain(w.w, 0, 0, 2, rules::tr(w, "floor"));
  w.k.flicker_odds = 0;
  w
}

fn torch(w: rules::Level) {
  w.hero_item = rules::th(w, "burning_torch");
  w.hero_until = w.k.burn_ms;
}

fn until(w: rules::Level, at: integer) {
  rules::tick(w, at - w.now);
}

fn at(w: const rules::Level, i: integer) -> text {
  e = w.enemies[i];
  if !e { return "none"; }
  "x{e.x} y{e.y} hp{e.hp}"
}

fn main() {
  w = hall(4, 1, true);
  _ = rules::add_enemy(w, "cyclops", 2, 0, 0);
  assert(at(w, 0) == "x2 y0 hp8", "a cyclops: {at(w, 0)}");
}

// The dark hides the hero: on x 0, unlit, from a cyclops nesting on x 6 that roams x 3 .. 9 — it
// never comes within 2, so never sees it, in 20 s.  With a torch the hero is seen from x 6 at 800:
// it shouts and comes, x 5 .. 1 by 2600, winds up its blow at 3050 (700 ms, @GM-Combat), which
// lands at 3750 and costs 2.  In daylight the same.
fn test_a_cyclops_sees_the_hero_only_in_light() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 0);
  _ = rules::add_enemy(w, "cyclops", 6, 0, 0);
  until(w, 20000);
  assert(w.health == 6 && w.spotted == 0 && !rules::hero_lit(w), "unseen in the dark: {w.health} {at(w, 0)}");
  for lit in [true, false] {
    v = hall(10, 1, lit);
    rules::put_hero(v, 0, 0, 0);
    if lit { torch(v); }
    _ = rules::add_enemy(v, "cyclops", 6, 0, 0);
    assert(rules::hero_lit(v), "lit");
    until(v, 800);
    assert(at(v, 0) == "x5 y0 hp8" && v.spotted == 1, "800: seen, it shouts and comes: {at(v, 0)}");
    until(v, 3749);
    assert(at(v, 0) == "x1 y0 hp8" && v.health == 6, "3749: beside, winding up, not yet");
    until(v, 3750);
    assert(v.health == 4 && v.spotted == 1, "3750: a blow of 2, one shout: {v.health}");
  }
}

// Within 2 the dark does not hide the hero: the cyclops on x 2 sees it at 800, steps to x 1, winds
// up at 1250 and strikes at 1950.
fn test_close_by_the_dark_does_not_hide() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 0);
  _ = rules::add_enemy(w, "cyclops", 2, 0, 0);
  until(w, 1949);
  assert(at(w, 0) == "x1 y0 hp8" && w.health == 6, "1949: beside, winding up");
  until(w, 1950);
  assert(w.health == 4, "1950: struck: {w.health}");
}

// Losing the hero it searches where it saw it.  A corridor along y 0 and a passage down x 0 to
// y 4.  Seen with a torch on (0, 0) at 800, the hero snuffs it and slips down to (0, 4): out of the
// cyclops's sight (dark, more than 2 away).  It goes on to (0, 0) — x 4 at 1250 .. x 0 at 3050 —
// and stands looking there, 4 from the hero, till its search ends (6800); at 7500 it heads home.
fn test_a_cyclops_searches_where_it_last_saw_the_hero() {
  w = hall(10, 5, true);
  tile_world::fill(w.w, 1, 1, 9, 4, 0, rules::tr(w, "wall"));
  rules::put_hero(w, 0, 0, 0);
  torch(w);
  _ = rules::add_enemy(w, "cyclops", 6, 0, 0);
  until(w, 800);
  assert(at(w, 0) == "x5 y0 hp8", "800: seen");
  w.hero_item = 0;
  rules::put_hero(w, 0, 4, 0);
  until(w, 3049);
  assert(at(w, 0) == "x1 y0 hp8", "3049: x 1: {at(w, 0)}");
  until(w, 3050);
  assert(at(w, 0) == "x0 y0 hp8", "3050: where it saw the hero: {at(w, 0)}");
  until(w, 7499);
  assert(at(w, 0) == "x0 y0 hp8" && w.health == 6 && w.spotted == 1, "7499: still looking, the hero unseen: {at(w, 0)}");
  until(w, 7500);
  assert(at(w, 0) == "x1 y0 hp8", "7500: home it goes: {at(w, 0)}");
}

// Seeing the hero it calls the others within 6: a hall y 0 .. 1 and a corridor y 3, a wall
// between but for x 9.  The one on (6, 0) sees the lit hero on (0, 0) at 800; the one on (6, 3)
// cannot (the wall) but is called: it searches (0, 0) and takes the long way round, east first.
// Called from 8 away (corridors y 0 and y 8) it is not.  (In a corridor one cell wide the first
// would block the way: the called one stands and waits.)
fn test_a_cyclops_calls_the_others() {
  w = hall(10, 4, true);
  tile_world::fill(w.w, 0, 2, 8, 2, 0, rules::tr(w, "wall"));
  rules::put_hero(w, 0, 0, 0);
  torch(w);
  _ = rules::add_enemy(w, "cyclops", 6, 0, 0);
  _ = rules::add_enemy(w, "cyclops", 6, 3, 0);
  until(w, 800);
  b = w.enemies[1];
  assert(at(w, 1) == "x7 y3 hp8" && b.search_x == 0 && b.search_y == 0 && b.search_until == 6800,
         "called, round by x 9: {at(w, 1)} {b.search_until}");
  assert(w.spotted == 1, "one shout: the called one has not seen the hero");
  v = hall(10, 9, true);
  tile_world::fill(v.w, 0, 1, 8, 7, 0, rules::tr(v, "wall"));
  rules::put_hero(v, 0, 0, 0);
  torch(v);
  _ = rules::add_enemy(v, "cyclops", 6, 0, 0);
  _ = rules::add_enemy(v, "cyclops", 6, 8, 0);
  until(v, 800);
  far = v.enemies[1];
  assert(far.search_until == 0, "8 away: not called");
}

// A blast draws it: a bomb on x 2 goes off at 100, the hero out of sight on layer 2.  The cyclops
// on x 6 (out of the blast's reach of 3) goes to the place: x 5 at 800 .. x 2 at 2150.  A second
// one, on x 7, follows — waiting where the first blocks the corridor — and from 4200 stands on
// x 3: the place is taken (at 5000 it is still there, the search lasting till 6100).  A rat there flees it
// instead, east.
fn test_a_blast_draws_a_cyclops() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 2);
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "bomb"));
  w.fuses += [rules::Fuse { x: 2, y: 0, z: 0, held: false, at: 100 }];
  _ = rules::add_enemy(w, "cyclops", 6, 0, 0);
  until(w, 100);
  assert(w.blasted == 1 && at(w, 0) == "x6 y0 hp8", "the blast; untouched");
  until(w, 2149);
  assert(at(w, 0) == "x3 y0 hp8", "2149: x 3: {at(w, 0)}");
  until(w, 2150);
  assert(at(w, 0) == "x2 y0 hp8", "2150: at the blast's place: {at(w, 0)}");
  u = hall(10, 1, true);
  rules::put_hero(u, 0, 0, 2);
  tile_world::place(u.w, 2, 0, 0, rules::th(u, "bomb"));
  u.fuses += [rules::Fuse { x: 2, y: 0, z: 0, held: false, at: 100 }];
  _ = rules::add_enemy(u, "cyclops", 6, 0, 0);
  _ = rules::add_enemy(u, "cyclops", 7, 0, 0);
  until(u, 5000);
  assert(at(u, 0) == "x2 y0 hp8" && at(u, 1) == "x3 y0 hp8", "the place taken, the second beside it: {at(u, 1)}");
  v = hall(10, 1, true);
  rules::put_hero(v, 0, 0, 2);
  tile_world::place(v.w, 2, 0, 0, rules::th(v, "bomb"));
  v.fuses += [rules::Fuse { x: 2, y: 0, z: 0, held: false, at: 100 }];
  _ = rules::add_enemy(v, "rat", 6, 0, 0);
  until(v, 600);
  assert(at(v, 0) == "x7 y0 hp3", "a rat flees it: {at(v, 0)}");
}

// Hurt, it fights on: struck to 6 beside the hero, it winds up at 800 and strikes back at 1500 (a
// rat would step away).  The hero gone (up on layer 2), it searches (0, 0) — there at 2700 — till
// 6800, walks home to x 1 at 7150, settles at 7950 and heals a point at 11950 and at 15950 (traced
// to the millisecond on the build with wind-ups, @GM-Combat).
fn test_a_hurt_cyclops_fights_on_and_heals_at_home() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 0);
  _ = rules::add_enemy(w, "cyclops", 1, 0, 0);
  rules::strike_enemy(w, 0, 2);
  until(w, 1500);
  assert(w.health == 4 && at(w, 0) == "x1 y0 hp6", "1500: it strikes back: {w.health} {at(w, 0)}");
  rules::put_hero(w, 0, 0, 2);
  until(w, 2700);
  assert(at(w, 0) == "x0 y0 hp6", "2700: searching where the hero was: {at(w, 0)}");
  until(w, 7150);
  assert(at(w, 0) == "x1 y0 hp6", "7150: home: {at(w, 0)}");
  until(w, 11949);
  assert(at(w, 0) == "x1 y0 hp6", "11949: settled, not yet");
  until(w, 11950);
  assert(at(w, 0) == "x1 y0 hp7", "11950: a point back: {at(w, 0)}");
  until(w, 15950);
  assert(at(w, 0) == "x1 y0 hp8" && w.health == 4, "15950: whole: {at(w, 0)}");
}

// --- Step 2: what a cyclops holds ---

// Unarmed, it grabs and pulls the hero home.  The lit hero on x 0, the cyclops nesting on x 6
// with nothing in hand: seen at 800 it comes (x 1 at 2600) and grabs at 3050 — no blow.  Every
// 800 from 3850 it steps home, the hero pulled into the cell it leaves: x 1 at 3850 .. x 5 at
// 7050, the cyclops then on its nest, holding on.
fn test_an_unarmed_cyclops_pulls_the_hero_home() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 0);
  torch(w);
  _ = rules::add_enemy(w, "cyclops", 6, 0, 0);
  rules::arm_enemy(w, 0, "none");
  until(w, 3050);
  e = w.enemies[0];
  assert(w.held_by == e.id && w.health == 6 && w.hero_x == 0, "3050: grabbed, unhurt");
  until(w, 3849);
  assert(w.hero_x == 0, "3849: not yet pulled");
  until(w, 3850);
  assert(w.hero_x == 1 && at(w, 0) == "x2 y0 hp8", "3850: pulled a cell: {w.hero_x} {at(w, 0)}");
  until(w, 7050);
  assert(w.hero_x == 5 && at(w, 0) == "x6 y0 hp8", "7050: at its nest: {w.hero_x} {at(w, 0)}");
  until(w, 12000);
  assert(w.hero_x == 5 && w.held_by == e.id && w.health == 6, "held there, unhurt");
}

// Three presses away break free: held on x 1 (the cyclops on x 2, at 3850), the hero presses west
// twice — Struggled, still on x 1 — and the third time is free and on x 0; the cyclops acts again
// a blow's time later (5050), not at its pull's (4650).  Walking into it instead strikes it.
fn test_the_hero_breaks_free() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 0);
  torch(w);
  _ = rules::add_enemy(w, "cyclops", 6, 0, 0);
  rules::arm_enemy(w, 0, "none");
  until(w, 3850);
  assert(rules::walk(w, -1, 0) == rules::Step.Struggled && rules::walk(w, -1, 0) == rules::Step.Struggled
         && w.hero_x == 1, "two presses: still held");
  assert(rules::walk(w, -1, 0) == rules::Step.Walked && w.hero_x == 0 && w.held_by == 0, "the third: free");
  e = w.enemies[0];
  assert(e.due == 5050, "staggered: {e.due}");
  v = hall(10, 1, true);
  rules::put_hero(v, 0, 0, 0);
  torch(v);
  _ = rules::add_enemy(v, "cyclops", 6, 0, 0);
  rules::arm_enemy(v, 0, "none");
  until(v, 3850);
  assert(rules::walk(v, 1, 0) == rules::Step.Attacked && at(v, 0) == "x2 y0 hp7" && v.held_by != 0,
         "walking into it strikes it, still held: {at(v, 0)}");
}

// Holding bombs, it throws one along the line to the lit hero 8 away: at 800 a fused bomb sets out
// from x 7 at speed 4 — x 6 at 950 .. x 3 at 1400 (slowing to 3), x 2 at 1600, x 1 at 1800 — and
// at 2000 meets the hero: it goes off on x 1, a blast of 3 to the hero beside it, none to the
// cyclops 7 away.  It has 2 left.  Its last one thrown, its hands are empty.
fn test_a_cyclops_throws_a_bomb() {
  w = hall(12, 1, true);
  rules::put_hero(w, 0, 0, 0);
  torch(w);
  _ = rules::add_enemy(w, "cyclops", 8, 0, 0);
  rules::arm_enemy(w, 0, "bomb");
  until(w, 800);
  e = w.enemies[0];
  assert(w.hurled == 1 && e.bombs == 2 && e.x == 8 && tile_world::top(w.w, 7, 0, 0) == rules::th(w, "bomb"), "800: thrown");
  until(w, 1999);
  assert(tile_world::top(w.w, 1, 0, 0) == rules::th(w, "bomb") && w.health == 6, "1999: x 1, beside the hero");
  until(w, 2000);
  assert(w.blasted == 1 && w.health == 3 && at(w, 0) == "x8 y0 hp8", "2000: the blast: health {w.health}, {at(w, 0)}");
  v = hall(12, 1, true);
  rules::put_hero(v, 0, 0, 0);
  torch(v);
  _ = rules::add_enemy(v, "cyclops", 8, 0, 0);
  rules::arm_enemy(v, 0, "bomb");
  v.enemies[0].bombs = 1;
  until(v, 800);
  f = v.enemies[0];
  assert(v.hurled == 1 && f.item == 0, "the last one: hands empty");
}

// It does not throw at a hero nearer than 5 (the blast would reach it): 4 away it comes — x 3 at
// 800, x 2 at 1250, x 1 at 1700 — and, beside the hero with bombs in hand, grabs at 2150.  Nor
// with something in the way: a stick on x 4, it comes.
fn test_a_cyclops_does_not_throw_near_or_blocked() {
  w = hall(12, 1, true);
  rules::put_hero(w, 0, 0, 0);
  torch(w);
  _ = rules::add_enemy(w, "cyclops", 4, 0, 0);
  rules::arm_enemy(w, 0, "bomb");
  until(w, 800);
  assert(w.hurled == 0 && at(w, 0) == "x3 y0 hp8", "4 away: it comes: {at(w, 0)}");
  until(w, 2150);
  e = w.enemies[0];
  assert(w.held_by == e.id && w.hurled == 0 && w.health == 6, "beside, bombs in hand: it grabs");
  v = hall(12, 1, true);
  rules::put_hero(v, 0, 0, 0);
  torch(v);
  tile_world::place(v.w, 4, 0, 0, rules::th(v, "stick"));
  _ = rules::add_enemy(v, "cyclops", 8, 0, 0);
  rules::arm_enemy(v, 0, "bomb");
  until(v, 800);
  assert(v.hurled == 0 && at(v, 0) == "x7 y0 hp8", "a stick in the way: it comes: {at(v, 0)}");
}

// --- What a bested enemy leaves: what it held in sight (owner) ---

fn top_is(w: const rules::Level, x: integer, y: integer, name: text) -> boolean {
  tile_world::top(w.w, x, y, 0) == (if name == "" { 0 } else { rules::th(w, name) })
}

// Bested on (1, 0): a cyclops leaves its axe, a bomber one bomb (lying, not lit), an unarmed one
// nothing, a hunter its bow, a rat nothing.
fn test_a_bested_enemy_leaves_what_it_held() {
  for c in [("cyclops", "", "axe"), ("cyclops", "bomb", "bomb"), ("cyclops", "none", ""), ("hunter", "", "bow"), ("rat", "", "")] {
    w = hall(6, 1, true);
    rules::put_hero(w, 0, 0, 2);
    _ = rules::add_enemy(w, c.0, 1, 0, 0);
    if c.1 != "" { rules::arm_enemy(w, 0, c.1); }
    rules::strike_enemy(w, 0, 10);
    assert(len(w.enemies) == 0 && top_is(w, 1, 0, c.2), "{c.0} {c.1}: leaves '{c.2}'");
    until(w, 2000);
    assert(w.blasted == 0 && top_is(w, 1, 0, c.2), "{c.0}: it lies there");
  }
}

// Bested standing on a stick, its axe goes beside it: the side its place prefers across the way it
// faces (south), then the other.
fn test_what_it_held_goes_aside_from_an_item() {
  w = hall(6, 3, true);
  rules::put_hero(w, 0, 0, 2);
  tile_world::place(w.w, 2, 1, 0, rules::th(w, "stick"));
  _ = rules::add_enemy(w, "cyclops", 2, 1, 0);
  rules::strike_enemy(w, 0, 10);
  side = if rules::prefers_right(2, 1, 0) { 1 } else { 3 };
  assert(top_is(w, 2, 1, "stick") && top_is(w, side, 1, "axe"), "the axe aside, on x {side}");
}

// A blast that bests a bomber sets off the bomb it drops: the bomber (hurt to 2) on x 3, a bomb on
// x 2 going off at 100 — 3 to it, bested; its bomb falls 1 from the blast and goes off a ripple
// later, at 250.
fn test_a_blast_besting_a_bomber_sets_its_bomb_off() {
  w = hall(10, 1, true);
  rules::put_hero(w, 0, 0, 2);
  tile_world::place(w.w, 2, 0, 0, rules::th(w, "bomb"));
  w.fuses += [rules::Fuse { x: 2, y: 0, z: 0, held: false, at: 100 }];
  _ = rules::add_enemy(w, "cyclops", 3, 0, 0);
  rules::arm_enemy(w, 0, "bomb");
  rules::strike_enemy(w, 0, 6);
  until(w, 249);
  assert(w.blasted == 1 && len(w.enemies) == 0 && top_is(w, 3, 0, "bomb"), "249: bested, its bomb lying, lit");
  until(w, 250);
  assert(w.blasted == 2, "250: its bomb goes off: {w.blasted}");
}

// Among others, the bested one's own: an unarmed cyclops (x 1) bested beside a hunter (x 3) leaves
// nothing — not the hunter's bow; the hunter bested then leaves its bow on x 3.
fn test_each_leaves_its_own() {
  w = hall(6, 1, true);
  rules::put_hero(w, 0, 0, 2);
  _ = rules::add_enemy(w, "cyclops", 1, 0, 0);
  rules::arm_enemy(w, 0, "none");
  _ = rules::add_enemy(w, "hunter", 3, 0, 0);
  rules::strike_enemy(w, 0, 10);
  assert(top_is(w, 1, 0, "") && len(w.enemies) == 1, "the cyclops leaves nothing");
  rules::strike_enemy(w, 0, 10);
  assert(top_is(w, 3, 0, "bow") && top_is(w, 1, 0, ""), "the hunter its bow, where it stood");
}
