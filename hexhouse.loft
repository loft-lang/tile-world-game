//
// The editor's side of a house on the hex grid: a floor plan of rectangles (an L, a T, a box)
// placed at any of the twelve 30° angles, mirrored or not, as cells (WORLD.md § One game, square or
// hex).  Turning is an editor step and stays one (owner, 2026-11-09): what it hands the world is
// cells, and the world draws its walls from the cells alone (hexwalls.loft).  Built here first;
// the routines move to the hex libraries once they are right.
//
// The owner's rulings (2026-11-09):
//   - every 30° angle is drawn and a house can always be turned or mirrored, never refused; half
//     the angles cannot be exact (a 30° turn is no symmetry of the grid), so they get the closest
//     approximation, and the turn is not an exact routine;
//   - the walls are always straight; only the distances between them differ a little after a turn;
//   - a house is its cells, the hexes inside against those outside, and the walls follow from them;
//   - the house at 0° stays as the plan gives it; only the turning changes.
//
// The plan gives the 0° house (`fill`'s test: a cell is the house's when its centre lies in one
// of the plan's rectangles, exactly, no float, as `hex_shape::box_fill` does for one box).  The
// other angles are that house's cells turned about its origin cell (hexturn.loft), which reads
// nothing but the cells.
//
// The plan's own frame: u along the turn's heading, v along the heading three steps on, both in
// half hex steps; the mirror flips u.
use hex_field;
use hex_form;
use hexwalls;
use hexturn;

/// A rectangle of the plan, in half hex steps of its own frame: u from `u0` to `u1`, v from `v0`
/// to `v1`.  A house `w` steps wide and `d` deep centred on its cell is `Part { u0: -w, v0: -d,
/// u1: w, v1: d }`, the rectangle `hex_shape::box_new(.., w, d, ..)` fills.
pub struct Part {
  pub u0: integer,
  pub v0: integer,
  pub u1: integer,
  pub v1: integer
}

/// A house as the author places it: its plan's origin on cell (cq, cr), turned `turn` × 30°
/// (0..11), mirrored or not.
pub struct HexHouse {
  pub cq: integer,
  pub cr: integer,
  pub turn: integer,
  pub mirror: boolean = false,
  pub parts: vector<Part>
}

/// A plain rectangular house, `w` hex steps wide and `d` deep.
pub fn box_plan(w: integer, d: integer) -> vector<Part> { [Part { u0: -w, v0: -d, u1: w, v1: d }] }

/// An L: a body `w` hex steps wide and `d` deep, and a wing `wing_w` wide and `wing_d` deep on the
/// west end of its +v side.
pub fn l_plan(w: integer, d: integer, wing_w: integer, wing_d: integer) -> vector<Part> {
  [Part { u0: -w, v0: -d, u1: w, v1: d },
   Part { u0: -w, v0: d, u1: -w + 2 * wing_w, v1: d + 2 * wing_d }]
}

// ── 1. the cells, exactly ───────────────────────────────────────────────────
//
// A local coordinate along a heading, scaled by 8L (L that heading's step length: √3 on an even
// heading, 3 on an odd one), is an integer for a lattice point, and a plan line `n` half steps out
// is 12n on an even heading and 12n·√3 on an odd one.  The house's two axes are never of one
// kind: the heading three steps on has the other parity.  A value a + b·√3 is the pair (a, b);
// its sign is exact.

/// The sign of a + b·√3: -1, 0 or 1.  √3 is irrational, so it is 0 only when both are.
pub fn sign3(a: integer, b: integer) -> integer {
  sa = if a > 0 { 1 } else if a < 0 { -1 } else { 0 };
  sb = if b > 0 { 1 } else if b < 0 { -1 } else { 0 };
  if sa == sb { return sa; }
  if sa == 0 { return sb; }
  if sb == 0 { return sa; }
  if a * a > 3 * b * b { sa } else { sb }
}

/// Is coordinate `p`, along heading `head` and scaled, between plan lines `lo` and `hi`
/// (inclusive)?
fn within(head: integer, p: integer, lo: integer, hi: integer) -> boolean {
  if head % 2 == 0 { return p >= 12 * lo && p <= 12 * hi; }
  sign3(p, -12 * lo) >= 0 && sign3(p, -12 * hi) <= 0
}

/// Mark the house's cells in `cells`: those whose centre lies in a part of the plan.
// @FR-HP-Fill
pub fn fill(h: const HexHouse, cells: hex_field::HexSet) -> integer {
  (uk, um) = hex_form::head_step(h.turn);
  (vk, vm) = hex_form::head_step(h.turn + 3);
  ck = hex_field::lattice_k(h.cq, h.cr);
  cm = hex_field::lattice_m(h.cq, h.cr);
  n = 0;
  for fr in hex_field::hexset_r0(cells)..hex_field::hexset_r0(cells) + hex_field::hexset_h(cells) {
    for fq in hex_field::hexset_q0(cells)..hex_field::hexset_q0(cells) + hex_field::hexset_w(cells) {
      pk = 2 * (hex_field::lattice_k(fq, fr) - ck);
      pm = 2 * (hex_field::lattice_m(fq, fr) - cm);
      u = hexwalls::dot4(pk, pm, uk, um);
      if h.mirror { u = -u; }
      v = hexwalls::dot4(pk, pm, vk, vm);
      inside = false;
      for p in h.parts {
        if within(h.turn, u, p.u0, p.u1) && within(h.turn + 3, v, p.v0, p.v1) { inside = true; }
      }
      if inside {
        hex_field::hexset_set(cells, fq, fr, true);
        n += 1;
      }
    }
  }
  n
}

/// The cells' window round the plan's origin, wide enough for any turn of the plan.
pub fn reach(h: const HexHouse) -> integer {
  r = 0;
  for p in h.parts {
    for c in [p.u0, p.u1, p.v0, p.v1] {
      a = if c < 0 { -c } else { c };
      if a > r { r = a; }
    }
  }
  r + 3
}

// ── the house ───────────────────────────────────────────────────────────────

/// Build the house: its cells at 0° from the plan, turned to its angle by the editor's turn
/// (hexturn.loft, `way` one of its BY_WALLS and BY_OUTLINE), then the world's walls from the
/// cells.
// @FR-HP-Zero, @FR-HX-Editor: the plan's cells at 0°, then the editor's turn, then the world's walls
pub fn build(h: const HexHouse, way: integer = hexturn::BY_WALLS) -> hexwalls::Built {
  r = reach(h) + 2;
  cells = hex_field::hexset_chunk(h.cq - r, h.cr - r, 2 * r + 1, 2 * r + 1);
  fill(HexHouse { cq: h.cq, cr: h.cr, turn: 0, mirror: h.mirror, parts: h.parts }, cells);
  hexwalls::from_cells(hexturn::turn(cells, h.cq, h.cr, h.turn, way), h.turn)
}
