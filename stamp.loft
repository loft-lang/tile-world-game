//
// Templates applied (HOUSES.md § Templates as files).  A template is a place file under
// levels/templates/ with a `template` block: its name, its kind, whether it may be turned and
// mirrored, and as its map a PART of a house — a few cells, not a whole floor — on as many layers
// as it needs (0 the layer it is applied to, -1 the cellar below).  The owner edits it as any
// place: in the editor (F2, open `templates/<name>`) or as JSON.
//
// Applying it writes its part into a level at (x, y, z), mirrored east to west first when asked,
// then turned clockwise a quarter at a time.  Only what the template holds is written:
//   - a cell it SET (to anything, void included) replaces the cell there: terrain, rise, slant
//     (turned with it), ceiling, and the stack (none when the template's cell has none);
//   - a cell it left UNSET (a space in a row) leaves the level's cell as it is, so a template
//     takes the house's shape it is laid on;
//   - an edge it holds is written on the turned side; an edge it does not hold is left alone, so
//     a template adds and changes edges, never removes one;
//   - a stack on a cell it left unset still replaces the stack there;
//   - a door held shut (`bars`) keeps its beam's side turned with it, and its figures (`enemies`)
//     come along to their turned cells.
// The part's box — the cells it set or put things on, over every layer — is what turns: its
// north-west corner stays at (x, y) whatever the turn.
use tile_world;
use rules;
use materials;
use levels;

/// The box of a template's part: the cells it set or put things on, over every layer.
pub struct Box {
  pub x0: integer,
  pub y0: integer,
  pub x1: integer,
  pub y1: integer
}

const CHUNK = 32;

/// The box of `t`'s part; an empty template's is the single cell (0, 0).
pub fn box_of(t: const levels::LevelFile) -> Box {
  w = t.level.w;
  b = Box { x0: 0, y0: 0, x1: -1, y1: -1 };
  for z in tile_world::layers(w) {
    for c in tile_world::chunks(w, z) {
      for j in 0..CHUNK {
        for i in 0..CHUNK {
          cx = c.0 * CHUNK + i;
          cy = c.1 * CHUNK + j;
          if tile_world::is_set(w, cx, cy, z) { grow(b, cx, cy); }
        }
      }
    }
  }
  for s in tile_world::stacks(w) { grow(b, s.0, s.1); }
  if b.x1 < b.x0 { return Box { x0: 0, y0: 0, x1: 0, y1: 0 }; }
  b
}

fn grow(b: Box, x: integer, y: integer) {
  if b.x1 < b.x0 {
    b.x0 = x; b.x1 = x; b.y0 = y; b.y1 = y;
    return;
  }
  if x < b.x0 { b.x0 = x; }
  if x > b.x1 { b.x1 = x; }
  if y < b.y0 { b.y0 = y; }
  if y > b.y1 { b.y1 = y; }
}

/// The size of `t`'s part, (width, height), once turned `turn` quarters.
pub fn size(t: const levels::LevelFile, turn: integer) -> (integer, integer) {
  b = box_of(t);
  w = b.x1 - b.x0 + 1;
  h = b.y1 - b.y0 + 1;
  if quarter(turn) % 2 == 1 { (h, w) } else { (w, h) }
}

fn quarter(turn: integer) -> integer { ((turn % 4) + 4) % 4 }

/// Where cell (x, y) of the template lands, relative to the turned box's north-west corner:
/// mirrored east to west first (`flip`), then turned clockwise `turn` quarters.
pub fn spot(b: const Box, turn: integer, flip: boolean, x: integer, y: integer) -> (integer, integer) {
  u = x - b.x0;
  v = y - b.y0;
  w = b.x1 - b.x0 + 1;
  h = b.y1 - b.y0 + 1;
  if flip { u = w - 1 - u; }
  for _ in 0..quarter(turn) {
    nu = h - 1 - v;
    v = u;
    u = nu;
    hw = w;
    w = h;
    h = hw;
  }
  (u, v)
}

/// The side (tile_world's NORTH, EAST, SOUTH, WEST) `side` becomes: mirrored, then turned.
pub fn side_to(side: integer, turn: integer, flip: boolean) -> integer {
  s = side;
  if flip && (s == tile_world::EAST || s == tile_world::WEST) { s = 4 - s; }
  (s + quarter(turn)) % 4
}

/// The way a slant looks (tile_world's NORTH_EAST .. NORTH_WEST, 0 none) once mirrored and turned.
pub fn slant_to(way: integer, turn: integer, flip: boolean) -> integer {
  if way == 0 { return 0; }
  s = if flip { 5 - way } else { way };
  for _ in 0..quarter(turn) { s = s % 4 + 1; }
  s
}

fn side_of(name: text) -> integer {
  if name == "E" { tile_world::EAST } else if name == "S" { tile_world::SOUTH }
  else if name == "W" { tile_world::WEST } else { tile_world::NORTH }
}

fn side_name(side: integer) -> text {
  if side == tile_world::EAST { "E" } else if side == tile_world::SOUTH { "S" }
  else if side == tile_world::WEST { "W" } else { "N" }
}

/// Apply template `t` to level `l` with its turned box's north-west corner at (x, y) and its
/// layer 0 on layer z, mirrored (`flip`) and turned clockwise `turn` quarters — a template that
/// says it does not turn or mirror is laid as it is drawn.  The cells it writes are tiled again by
/// `mats` (theme.json's materials), as a paste in the editor is.
pub fn apply(l: rules::Level, t: const levels::LevelFile, x: integer, y: integer, z: integer,
             turn: integer, flip: boolean, mats: const materials::Materials) {
  apply_shape(l, t, shape_of(t), x, y, z, turn, flip, mats);
}

/// `apply`, with `t`'s shape worked out before (`shape_of`) — or stretched (`stretched_shape`):
/// the rows it repeats read from `t` as drawn.
pub fn apply_shape(l: rules::Level, t: const levels::LevelFile, sh: const Shape, x: integer, y: integer,
                   z: integer, turn: integer, flip: boolean, mats: const materials::Materials) {
  tf = turned(sh, turn, flip);
  tq = tf.0;
  fl = tf.1;
  tw = t.level.w;
  b = sh.box;
  touched: vector<(integer, integer, integer)> = [];
  for p in sh.parts {
    at = spot(b, tq, fl, p.x, p.y);
    ax = x + at.0;
    ay = y + at.1;
    az = z + p.z;
    // The edges this cell holds (its north and west), on their turned sides.
    if p.north != 0 { tile_world::set_edge(l.w, ax, ay, az, side_to(tile_world::NORTH, tq, fl), p.north); }
    if p.west != 0 { tile_world::set_edge(l.w, ax, ay, az, side_to(tile_world::WEST, tq, fl), p.west); }
    if !p.set { continue; }
    fy = p.from_y;
    tile_world::set_terrain(l.w, ax, ay, az, tile_world::terrain(tw, p.x, fy, p.z), tile_world::tile(tw, p.x, fy, p.z));
    tile_world::set_rise(l.w, ax, ay, az, tile_world::rise(tw, p.x, fy, p.z));
    tile_world::set_slant(l.w, ax, ay, az, slant_to(tile_world::slant(tw, p.x, fy, p.z), tq, fl));
    tile_world::set_ceiling(l.w, ax, ay, az, tile_world::ceiling(tw, p.x, fy, p.z));
    restack(l, t, p.x, fy, p.z, ax, ay, az);
    touched += [(ax, ay, az)];
  }
  // Things on cells the template left unset replace the stack there too.
  for s in sh.piles {
    if s.on_set { continue; }
    at = spot(b, tq, fl, s.x, s.y);
    restack(l, t, s.x, s.from_y, s.z, x + at.0, y + at.1, z + s.z);
  }
  for bar in t.level.bars {
    at = spot(b, tq, fl, bar.x, moved_y(sh, bar.y));
    bx = x + at.0;
    by = y + at.1;
    bz = z + bar.z;
    kept: vector<rules::Bar> = [];
    for old in l.bars { if old.x != bx || old.y != by || old.z != bz { kept += [old]; } }
    kept += [rules::Bar { x: bx, y: by, z: bz, side: side_name(side_to(side_of(bar.side), tq, fl)) }];
    l.bars = kept;
  }
  for e in t.level.enemies {
    at = spot(b, tq, fl, e.x, moved_y(sh, e.y));
    _ = rules::add_enemy(l, e.kind, x + at.0, y + at.1, z + e.z);
    l.enemies[len(l.enemies) - 1].item = e.item;
    l.enemies[len(l.enemies) - 1].bombs = e.bombs;
  }
  rules::order_enemies(l);
  for p in touched { materials::retile(mats, l.w, p.0, p.1, p.2); }
}

// The stack of (ax, ay, az) in `l` made the template's stack of (sx, sy, sz).
fn restack(l: rules::Level, t: const levels::LevelFile, sx: integer, sy: integer, sz: integer,
           ax: integer, ay: integer, az: integer) {
  while tile_world::take(l.w, ax, ay, az) != 0 {}
  for th in tile_world::things(t.level.w, sx, sy, sz) { tile_world::place(l.w, ax, ay, az, th); }
}

/// The turn and mirror `t` is laid with when asked for `turn` and `flip`: none where it says it
/// does not turn or mirror.
pub fn way_of(t: const levels::LevelFile, turn: integer, flip: boolean) -> (integer, boolean) {
  (if t.template.turns { quarter(turn) } else { 0 }, flip && t.template.flips)
}

/// Where cell (cx, cy) on layer cz of `t` lands when `t` is laid at (x, y, z), turned and mirrored.
pub fn landing(t: const levels::LevelFile, x: integer, y: integer, z: integer, turn: integer, flip: boolean,
               cx: integer, cy: integer, cz: integer) -> (integer, integer, integer) {
  tf = way_of(t, turn, flip);
  at = spot(box_of(t), tf.0, tf.1, cx, cy);
  (x + at.0, y + at.1, z + cz)
}

/// The cells `t` writes when laid at (x, y, z), turned and mirrored: those it set and those it puts
/// things or figures on, over every layer.
pub fn cells(t: const levels::LevelFile, x: integer, y: integer, z: integer, turn: integer,
             flip: boolean) -> vector<(integer, integer, integer)> {
  cells_of(shape_of(t), x, y, z, turn, flip)
}

// --- A template's shape ---
//
// What a template lays, listed once (`shape_of`): the deal tries a template in many places and
// turns, and finding its cells in its map again each time — every cell of its chunks, on every
// layer — was most of the deal's time.

/// A cell of a template's part that holds something: it is set, or holds an edge (its north or
/// west).  `y` is where it lies in the part as laid, `from_y` its row in the map as drawn — the
/// same, but for a stretched tunnel (`stretched_shape`).
pub struct Part {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub from_y: integer,
  pub set: boolean,
  pub walk: boolean,
  pub north: integer,
  pub west: integer
}

/// A cell of a template's part with things on it; `on_set` when the cell is set too.
pub struct Pile {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub from_y: integer,
  pub on_set: boolean
}

/// A template's part as it lays: its box, its cells by its map's order, its things, its figures;
/// whether it turns and mirrors; and its stretch row repeated `k` more times.
pub struct Shape {
  pub turns: boolean,
  pub flips: boolean,
  pub stretch: integer,
  pub k: integer,
  pub box: Box,
  pub parts: vector<Part>,
  pub piles: vector<Pile>,
  pub figures: vector<(integer, integer, integer)>
}

/// The shape of `t` as drawn.
pub fn shape_of(t: const levels::LevelFile) -> Shape {
  tw = t.level.w;
  out = Shape { turns: t.template.turns, flips: t.template.flips, stretch: t.template.stretch, k: 0,
                box: Box { x0: 0, y0: 0, x1: 0, y1: 0 }, parts: [], piles: [], figures: [] };
  for lz in tile_world::layers(tw) {
    for c in tile_world::chunks(tw, lz) {
      for j in 0..CHUNK {
        for i in 0..CHUNK {
          sx = c.0 * CHUNK + i;
          sy = c.1 * CHUNK + j;
          set = tile_world::is_set(tw, sx, sy, lz);
          en = tile_world::edge(tw, sx, sy, lz, tile_world::NORTH);
          ew = tile_world::edge(tw, sx, sy, lz, tile_world::WEST);
          if !set && en == 0 && ew == 0 { continue; }
          walk = set && tile_world::walkable_kind(tw, tile_world::terrain(tw, sx, sy, lz));
          out.parts += [Part { x: sx, y: sy, z: lz, from_y: sy, set: set, walk: walk, north: en, west: ew }];
        }
      }
    }
  }
  for st in tile_world::stacks(tw) {
    out.piles += [Pile { x: st.0, y: st.1, z: st.2, from_y: st.1, on_set: tile_world::is_set(tw, st.0, st.1, st.2) }];
  }
  for e in t.level.enemies { out.figures += [(e.x, e.y, e.z)]; }
  out.box = box_from(out);
  out
}

// The box of a shape's set cells and its things (as `box_of`).
fn box_from(sh: const Shape) -> Box {
  b = Box { x0: 0, y0: 0, x1: -1, y1: -1 };
  for p in sh.parts { if p.set { grow(b, p.x, p.y); } }
  for s in sh.piles { grow(b, s.x, s.y); }
  if b.x1 < b.x0 { return Box { x0: 0, y0: 0, x1: 0, y1: 0 }; }
  b
}

/// Shape `sh` (as drawn) with its stretch row repeated `k` more times, as `stretched` makes the
/// template: the rows below it moved down by `k`, with their things and figures.
pub fn stretched_shape(sh: const Shape, k: integer) -> Shape {
  sr = sh.stretch;
  if sr < 0 || k <= 0 { return sh; }
  out = Shape { turns: sh.turns, flips: sh.flips, stretch: sr, k: k, box: sh.box, parts: [], piles: [], figures: [] };
  for p in sh.parts {
    copies = if p.y == sr { k + 1 } else { 1 };
    for n in 0..copies {
      out.parts += [Part { x: p.x, y: if p.y < sr { p.y } else if p.y == sr { p.y + n } else { p.y + k }, z: p.z,
                           from_y: p.from_y, set: p.set, walk: p.walk, north: p.north, west: p.west }];
    }
  }
  for s in sh.piles {
    copies = if s.y == sr { k + 1 } else { 1 };
    for n in 0..copies {
      out.piles += [Pile { x: s.x, y: if s.y < sr { s.y } else if s.y == sr { s.y + n } else { s.y + k }, z: s.z,
                           from_y: s.from_y, on_set: s.on_set }];
    }
  }
  for f in sh.figures { out.figures += [(f.0, if f.1 > sr { f.1 + k } else { f.1 }, f.2)]; }
  out.box = box_from(out);
  out
}

/// Row `y` of the template as drawn, where it lies in shape `sh` (moved down when it is below the
/// stretch row): its start, its finds, its figures.
pub fn moved_y(sh: const Shape, y: integer) -> integer {
  if sh.stretch >= 0 && y > sh.stretch { y + sh.k } else { y }
}

/// The turn and mirror a shape is laid with when asked for `turn` and `flip` (as `way_of`).
pub fn turned(sh: const Shape, turn: integer, flip: boolean) -> (integer, boolean) {
  (if sh.turns { quarter(turn) } else { 0 }, flip && sh.flips)
}

/// The size of a shape, (width, height), once turned `turn` quarters (as `size`).
pub fn size_of(sh: const Shape, turn: integer) -> (integer, integer) {
  w = sh.box.x1 - sh.box.x0 + 1;
  h = sh.box.y1 - sh.box.y0 + 1;
  if quarter(turn) % 2 == 1 { (h, w) } else { (w, h) }
}

/// Where cell (cx, cy) on layer cz of the shape lands when laid at (x, y, z) (as `landing`).
pub fn landing_of(sh: const Shape, x: integer, y: integer, z: integer, turn: integer, flip: boolean,
                  cx: integer, cy: integer, cz: integer) -> (integer, integer, integer) {
  tf = turned(sh, turn, flip);
  at = spot(sh.box, tf.0, tf.1, cx, cy);
  (x + at.0, y + at.1, z + cz)
}

/// The cells the shape writes when laid at (x, y, z) (as `cells`): those it sets, then those it
/// puts things on, then its figures'.  With `upto` (0 or more) only those on its rows up to it.
pub fn cells_of(sh: const Shape, x: integer, y: integer, z: integer, turn: integer, flip: boolean,
                upto: integer = -1) -> vector<(integer, integer, integer)> {
  out: vector<(integer, integer, integer)> = [];
  tf = turned(sh, turn, flip);
  for p in sh.parts {
    if !p.set || (upto >= 0 && p.y > upto) { continue; }
    at = spot(sh.box, tf.0, tf.1, p.x, p.y);
    out += [(x + at.0, y + at.1, z + p.z)];
  }
  for s in sh.piles {
    if s.on_set || (upto >= 0 && s.y > upto) { continue; }
    at = spot(sh.box, tf.0, tf.1, s.x, s.y);
    out += [(x + at.0, y + at.1, z + s.z)];
  }
  for f in sh.figures {
    if upto >= 0 && f.1 > upto { continue; }
    at = spot(sh.box, tf.0, tf.1, f.0, f.1);
    out += [(x + at.0, y + at.1, z + f.2)];
  }
  out
}

/// The cells the shape sets to ground a walker stands on (as `walkable_cells`).
pub fn walkable_of(sh: const Shape, x: integer, y: integer, z: integer, turn: integer,
                   flip: boolean) -> vector<(integer, integer, integer)> {
  out: vector<(integer, integer, integer)> = [];
  tf = turned(sh, turn, flip);
  for p in sh.parts {
    if !p.walk { continue; }
    at = spot(sh.box, tf.0, tf.1, p.x, p.y);
    out += [(x + at.0, y + at.1, z + p.z)];
  }
  out
}

/// Moves (rules::play's words) as a template's turn and mirror make them: a step or a pull's way
/// mirrored east to west, then turned clockwise by quarters; other words (`~700`, `x`, `q`, `f`)
/// as they are.
pub fn turned_moves(moves: text, turn: integer, flip: boolean) -> text {
  out = "";
  for word in moves.split(' ') {
    if word == "" { continue; }
    pull = word.starts_with("p") && len(word) == 2;
    key = if pull { word[1..] } else { word };
    if key != "w" && key != "a" && key != "s" && key != "d" {
      out += if out == "" { word } else { " {word}" };
      continue;
    }
    d = if key == "w" { (0, -1) } else if key == "s" { (0, 1) } else if key == "a" { (-1, 0) } else { (1, 0) };
    dx = if flip { -d.0 } else { d.0 };
    dy = d.1;
    for _ in 0..quarter(turn) {
      ndx = -dy;
      dy = dx;
      dx = ndx;
    }
    nk = if dy < 0 { "w" } else if dy > 0 { "s" } else if dx < 0 { "a" } else { "d" };
    mv = if pull { "p{nk}" } else { nk };
    out += if out == "" { mv } else { " {mv}" };
  }
  out
}

/// Template `t` with its `stretch` row repeated `k` more times (HOUSES.md § Tunnels): the rows
/// below it moved down by `k`, with everything on them — cells, edges, things, figures, a door's
/// beam, the start cell.  A template that does not stretch comes back as it is.
pub fn stretched(t: const levels::LevelFile, k: integer) -> levels::LevelFile {
  sr = t.template.stretch;
  if sr < 0 || k <= 0 { return t; }
  out = t;
  tw = t.level.w;
  nw = tile_world::copy(tw, 0, 0, -1, -1, 0, -1);
  for lz in tile_world::layers(tw) {
    for c in tile_world::chunks(tw, lz) {
      for j in 0..CHUNK {
        for i in 0..CHUNK {
          sx = c.0 * CHUNK + i;
          sy = c.1 * CHUNK + j;
          copies = if sy == sr { k + 1 } else { 1 };
          for n in 0..copies {
            ty = if sy < sr { sy } else if sy == sr { sy + n } else { sy + k };
            for side in [tile_world::NORTH, tile_world::WEST] {
              e = tile_world::edge(tw, sx, sy, lz, side);
              if e != 0 { tile_world::set_edge(nw, sx, ty, lz, side, e); }
            }
            if tile_world::is_set(tw, sx, sy, lz) {
              tile_world::set_terrain(nw, sx, ty, lz, tile_world::terrain(tw, sx, sy, lz), tile_world::tile(tw, sx, sy, lz));
              tile_world::set_rise(nw, sx, ty, lz, tile_world::rise(tw, sx, sy, lz));
              tile_world::set_slant(nw, sx, ty, lz, tile_world::slant(tw, sx, sy, lz));
              tile_world::set_ceiling(nw, sx, ty, lz, tile_world::ceiling(tw, sx, sy, lz));
            }
          }
        }
      }
    }
  }
  for st in tile_world::stacks(tw) {
    copies = if st.1 == sr { k + 1 } else { 1 };
    for n in 0..copies {
      ty = if st.1 < sr { st.1 } else if st.1 == sr { st.1 + n } else { st.1 + k };
      for th in tile_world::things(tw, st.0, st.1, st.2) { tile_world::place(nw, st.0, ty, st.2, th); }
    }
  }
  out.level.w = nw;
  for i in 0..len(out.level.enemies) {
    if (out.level.enemies[i]!.y) > sr {
      out.level.enemies[i].y += k;
      out.level.enemies[i].nest_y += k;
    }
  }
  for i in 0..len(out.level.bars) { if (out.level.bars[i]!.y) > sr { out.level.bars[i].y += k; } }
  for i in 0..len(out.template.finds) {
    c = out.template.finds[i]!;
    if c.1 > sr { out.template.finds[i] = (c.0, c.1 + k, c.2); }
  }
  if out.start_y > sr { out.start_y += k; }
  out
}

/// The cells of `t` laid at (x, y, z), turned and mirrored, that it sets to ground a walker stands
/// on (a tunnel's passage, its stairs).
pub fn walkable_cells(t: const levels::LevelFile, x: integer, y: integer, z: integer, turn: integer,
                      flip: boolean) -> vector<(integer, integer, integer)> {
  walkable_of(shape_of(t), x, y, z, turn, flip)
}

/// Every template under `dir` (levels/templates/): each `.json` that loads and has a `template`
/// block, by its file's order.
pub fn all(dir: text, k: const rules::Kinds, mats: const materials::Materials) -> vector<levels::LevelFile> {
  out: vector<levels::LevelFile> = [];
  names: vector<text> = [];
  for f in file(dir).files() {
    n = f.path;
    if len(n) > 5 && n.ends_with(".json") { names += [n]; }
  }
  names.sort();
  for n in names {
    m = levels::load_with(file(n).content() ?? "", k, mats);
    if !m { continue; }
    if m.template.kind != "" { out += [m]; }
  }
  out
}

/// The template named `name` among `ts`, null when there is none.
pub fn named(ts: const vector<levels::LevelFile>, name: text) -> levels::LevelFile? {
  for t in ts { if t.name == name { return t; } }
  null
}
