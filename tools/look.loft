// A scene to look at how slopes draw: rails up a slope running east-west (y 2, rising west) and
// north-south (x 9, rising north), a cart on each, the hero riding the east-west one; a mound
// and a block two steps high (its bank).  Or, given a level's number, that level as it starts.
//
//   loft --lib libs tools/look.loft OUT.png      writes the slope scene, 4x
//   loft --lib libs tools/look.loft OUT.png 2    writes level 2 (order.json) as it starts
//   loft --lib libs tools/look.loft OUT.png hill writes a plateau a layer up, a ramp down from it
//                                                with a track over its edge, a cart on the slope
use tile_world;
use rules;
use game;

fn main() {
  args = arguments();
  level = -1;
  out = "look.png";
  hill = false;
  for a in args {
    if a == "hill" { hill = true; }
    if a.ends_with(".png") { out = a; } else if len(a) > 0 && a.char_slice(0, 1) >= "0" && a.char_slice(0, 1) <= "9" { level = a as integer ?? -1; }
  }
  m = game::new_game("..");
  if !m { println("the game does not load"); exit(1); }
  g = m;
  if level >= 0 {
    game::start_level(g, level);
    game::draw(g);
    if !game::snapshot(g, out, 4) { println("could not write {out}"); exit(1); }
    println("{out}: level {level}");
    return;
  }
  game::start_level(g, 0);
  w = g.world;
  if hill {
    for c in tile_world::stacks(w.w) {
      while tile_world::top(w.w, c.0, c.1, c.2) != 0 { _ = tile_world::take(w.w, c.0, c.1, c.2); }
    }
    for z in 0..3 { tile_world::fill(w.w, -2, -2, 16, 12, z, tile_world::VOID); }
    tile_world::fill(w.w, -1, -1, 13, 9, 0, rules::tr(w, "wall"));
    tile_world::fill(w.w, 0, 0, 12, 8, 0, rules::tr(w, "floor"));
    // The plateau: layer 1 over x 0 .. 3; the layer 0 under it is wall.
    tile_world::fill(w.w, 0, 0, 3, 8, 0, rules::tr(w, "wall"));
    tile_world::fill(w.w, 0, 0, 3, 8, 1, rules::tr(w, "floor"));
    // The ramp: x 4 .. 6 at rise 3, 2, 1, rows 2 .. 4; a track along row 3 over the edge.
    for y in 2..5 {
      tile_world::set_rise(w.w, 4, y, 0, 3);
      tile_world::set_rise(w.w, 5, y, 0, 2);
      tile_world::set_rise(w.w, 6, y, 0, 1);
    }
    tile_world::fill(w.w, 4, 3, 10, 3, 0, rules::tr(w, "rail"));
    tile_world::fill(w.w, 1, 3, 3, 3, 1, rules::tr(w, "rail"));
    tile_world::place(w.w, 5, 3, 0, rules::th(w, "cart"));
    rules::put_hero(w, 9, 6, 0);
    g.cam_x = -1;
    g.cam_y = -1;
    game::draw(g);
    if !game::snapshot(g, out, 4) { println("could not write {out}"); exit(1); }
    println("{out}: hill");
    return;
  }
  floor = rules::tr(w, "floor");
  rail = rules::tr(w, "rail");
  for c in tile_world::stacks(w.w) {
    while tile_world::top(w.w, c.0, c.1, c.2) != 0 { _ = tile_world::take(w.w, c.0, c.1, c.2); }
  }
  for z in 0..3 { tile_world::fill(w.w, -2, -2, 16, 12, z, tile_world::VOID); }
  tile_world::fill(w.w, -1, -1, 13, 9, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 12, 8, 0, floor);
  tile_world::fill(w.w, 1, 2, 7, 2, 0, rail);
  tile_world::set_rise(w.w, 1, 2, 0, 3);
  tile_world::set_rise(w.w, 2, 2, 0, 2);
  tile_world::set_rise(w.w, 3, 2, 0, 1);
  tile_world::fill(w.w, 9, 1, 9, 7, 0, rail);
  tile_world::set_rise(w.w, 9, 1, 0, 3);
  tile_world::set_rise(w.w, 9, 2, 0, 2);
  tile_world::set_rise(w.w, 9, 3, 0, 1);
  tile_world::set_rise(w.w, 5, 5, 0, 1);
  tile_world::set_rise(w.w, 6, 5, 0, 1);
  tile_world::set_rise(w.w, 5, 6, 0, 1);
  for x in 1..4 {
    for y in 5..7 { tile_world::set_rise(w.w, x, y, 0, 2); }
  }
  tile_world::place(w.w, 2, 5, 0, rules::th(w, "chest"));
  tile_world::place(w.w, 2, 2, 0, rules::th(w, "cart"));
  tile_world::place(w.w, 9, 2, 0, rules::th(w, "cart"));
  rules::put_hero(w, 2, 2, 0);
  g.cam_x = 0;
  g.cam_y = 0;
  game::draw(g);
  if !game::snapshot(g, out, 4) { println("could not write {out}"); exit(1); }
  println("{out}: hero h {w.hero_h}");
}
