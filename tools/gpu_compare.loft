// The GPU against the C rasteriser, in a page: one scene with every primitive drawn on a display
// surface (WebGL) and on an ordinary surface, compared pixel by pixel; a camera moved 1/256 of a
// unit is the control that the comparison can fail.  It needs a page, so it is not one of the
// tests: from this directory, `loft --native-c --html /tmp/cmp.html --lib ../libs
// gpu_compare.loft`, open the page, and read the `@cmp` console line (0 differ is the pass).

use screen;
use tiles;

// The same scene, every primitive in it, under a camera at zoom 4 starting at (cx, cy).
fn scene(s: integer, sheet: integer, cx: float, cy: float) {
  tiles::camera(s, 4.0, cx, cy);
  tiles::clear(s, tiles::rgb(20, 30, 40));
  for y in 0..10 {
    for x in 0..13 {
      tiles::draw_ground(s, sheet, (x * 3 + y) % 40, x * 16, y * 16,
                         ((x % 3) * 2, ((x + 1) % 3) * 2, 0, (y % 2) * 3),
                         ((x * 7) % 60, (y * 11) % 60, 20, 90));
    }
  }
  for k in 0..48 {
    t = 84 + k % 48;
    x = (k * 37) % 190;
    y = (k * 53) % 140;
    if k % 4 == 0 {
      tiles::draw(s, sheet, t, x, y, k % 2 == 1, (k / 2) % 2 == 1, (k / 4) % 2 == 1, shade: k % 8, ghost: k % 5 == 0);
    } else if k % 4 == 1 {
      tiles::draw_turned(s, sheet, t, x, y, (k * 13) % 360 - 180, (8, 15), (k / 4) % 2 == 1, false, false, k % 8);
    } else if k % 4 == 2 {
      tiles::sprite(s, sheet, t, (x as float) + 0.37, (y as float) - 0.61, ((k * 7) % 50) as float - 25.25,
                    8.0, 12.5, 1.0 + ((k % 3) as float) * 0.5, 1.0 + ((k % 2) as float) * 0.25,
                    flip_d: k % 3 == 0, shade: k % 4, ghost: k % 7 == 0);
    } else {
      tiles::draw_turned(s, sheet, t, x, y, 90 * (k % 4), (3, 9), false, true, false, 2);
    }
  }
  tiles::fill(s, 10.3, 150.6, 40.2, 5.5, tiles::rgb(250, 10, 120));
  tiles::rect(s, 150, 4, 30, 7, tiles::rgb(10, 250, 120));
}

fn differ(a: const vector<i32>, b: const vector<i32>) -> integer {
  n = 0;
  for i in 0..len(a) { if a[i] != b[i] { n += 1; } }
  n
}

fn main() {
  if !screen::open(208, 160, 4, "compare", fill: true) { println("@cmp no screen"); return; }
  w = screen::width();
  h = screen::height();
  sheet = tiles::sheet_from_png("../assets/sheets/tiny-dungeon.png", 16, 16) ?? return;
  gpu = tiles::display_surface(w, h) ?? return;
  cpu = tiles::surface(w, h) ?? return;
  scene(gpu, sheet, -3.25, -1.5);
  g = tiles::pixels(gpu, w, h);
  scene(cpu, sheet, -3.25, -1.5);
  c = tiles::pixels(cpu, w, h);
  scene(cpu, sheet, -3.25 + 1.0 / 256.0, -1.5);
  moved = tiles::pixels(cpu, w, h);
  lit = 0;
  for p in c { if p != tiles::rgb(20, 30, 40) { lit += 1; } }
  println("@cmp {w}x{h} on_display {tiles::on_display(gpu)}: gpu vs cpu {differ(g, c)} of {len(c)} differ ({lit} drawn); vs cpu moved 1/256 {differ(g, moved)}");
}
