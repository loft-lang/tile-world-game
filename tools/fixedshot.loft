// A picture of the fixed camera's view (fixedview.loft) at a moment of play, and its frame times:
// the place's start, then the moves walked one frame of 16 ms at a time, each frame drawn as the
// game draws it.  What the CPU's 3D view shows, checked by eye without a window; and checked
// against the same moment built fresh (`fixedview::differs_from_fresh`), which must not differ.
//
//   loft --lib libs tools/fixedshot.loft PLACE OUT.png [MOVES [change]]
//
// PLACE is a file in levels/ (without `.json`); OUT a path from this directory (tools/) or a full
// one; MOVES letters as TW_MOVES takes them (`w` `a` `s` `d`), one step every eight frames.
use imaging;
use tile_world;
use rules;
use game;
use fixedview;
use raster3d;

// The world changed by hand, as the rules would change it in play: a thing moved, a wall raised.
fn change_world(g: game::Game) {
  w = g.world;
  hx = w.hero_x;
  hy = w.hero_y;
  z = w.hero_z;
  best = (0, 0, 0);
  far = 1000000;
  for c in tile_world::stacks(w.w) {
    d = (c.0 - hx) * (c.0 - hx) + (c.1 - hy) * (c.1 - hy);
    if c.2 == z && d < far && d > 0 {
      far = d;
      best = c;
    }
  }
  if far < 1000000 {
    t = tile_world::take(g.world.w, best.0, best.1, best.2);
    tile_world::place(g.world.w, hx - 2, hy, z, t);
    println("moved thing {t} from ({best.0}, {best.1}) to ({hx - 2}, {hy})");
  }
  tile_world::set_terrain(g.world.w, hx + 2, hy, z, rules::tr(g.world, "wall"));
  println("a wall at ({hx + 2}, {hy}, {z})");
  // A burning torch in the hero's hand: a light that walks with it.
  g.world.hero_item = rules::th(g.world, "burning_torch");
  g.world.hero_until = g.world.now + 600000;
  println("the hero holds a burning torch ({g.world.hero_item})");
}

fn main() {
  args = arguments();
  place = args[0] ?? "";
  out = args[1] ?? "";
  moves = args[2] ?? "";
  change = (args[3] ?? "") == "change";
  if place == "" || out == "" {
    println("usage: loft --lib libs tools/fixedshot.loft PLACE OUT.png [MOVES]");
    exit(1);
  }
  m = game::new_game("..");
  if !m { println("the game does not load"); exit(1); }
  g = m;
  if !game::start_world(g, place) { println("no place {place} in levels/"); exit(1); }
  v = fixedview::view();
  v.on = true;
  now = 0;
  frames = 0;
  spent = 0;
  worst = 0;
  steps: vector<text> = [];
  for c in moves { steps += ["{c}"]; }
  for f in 0..len(steps) * 8 + 30 {
    if f % 8 == 0 && f / 8 < len(steps) {
      d = steps[f / 8] ?? "";
      if d == "w" { game::move(g, 0, -1, false); }
      if d == "s" { game::move(g, 0, 1, false); }
      if d == "a" { game::move(g, -1, 0, false); }
      if d == "d" { game::move(g, 1, 0, false); }
    }
    if change && f == len(steps) * 4 { change_world(g); }
    now += 16;
    changed = game::update(g, 16, now);
    at = ticks();
    fixedview::draw(v, g, changed || f == 0, now);
    took = ticks() - at;
    spent += took;
    if took > worst { worst = took; }
    frames += 1;
  }
  w = raster3d::WIDTH;
  h = raster3d::HEIGHT;
  if len(v.px) != w * h { println("no frame was drawn ({len(v.px)} pixels)"); exit(1); }
  img = imaging::Image { name: place, width: w, height: h, data: [] };
  for c in v.px {
    p = c as integer;
    img.data += [imaging::Pixel {
      r: ((((p >> 11) & 31) * 255 / 31) ?? 0) & 255,
      g: ((((p >> 5) & 63) * 255 / 63) ?? 0) & 255,
      b: (((p & 31) * 255 / 31) ?? 0) & 255,
      a: 255
    }];
  }
  if !img.save_png(out) { println("could not write {out}"); exit(1); }
  println("{out}: {place}, hero at ({g.world.hero_x}, {g.world.hero_y}, {g.world.hero_z}); {frames} frames, "
          + "{spent / frames} us a frame, the slowest {worst} us");
  sp = v.spent;
  println("  new scenes {sp.fresh}, {sp.fresh_us / sp.fresh ?? 0} us each; tiles built walking {sp.built}, "
          + "{sp.built_us / sp.built ?? 0} us each; looked at {sp.looked}, {sp.looked_us / sp.looked ?? 0} us each, "
          + "{sp.changed} changed; {sp.flames} flames drawn as actors; {sp.shone} lights changed; "
          + "the light of {sp.lights} cells kept");
  // The tiles kept up through the walk show what a fresh build shows.
  d = fixedview::differs_from_fresh(v, g);
  println("against a fresh build: {d} pixels differ");
  if d != 0 { exit(1); }
}
