// A scene played by the game itself, every frame saved: to watch how figures move (motion.loft)
// — the hobble, the weapon leading in four directions, a bump into a wall, a swing, and the hero
// passing behind a chest raised on a table.
//
//   loft --lib libs tools/anim.loft OUT_DIR [bomb|rat]   writes OUT_DIR/frame_000.png ... (40 ms
//                                                    apart, 3x); `bomb`: a bomb thrown at a pillar
//                                                    beside a rock, a chair and a stick; `rat`: a rat
//                                                    comes at the hero, is struck and flees home;
//                                                    `bow`: aim, shoot a bat over water and a spider
//                                                    on a wall; `guard`: K held through a rat's
//                                                    bite (a block), tapped in its next wind-up (a
//                                                    parry), a riposte — the hero wounded, a
//                                                    cyclops winding up a sweep below
use tile_world;
use rules;
use game;

const FRAME = 40;

fn main() {
  dir = ".";
  bomb = false;
  rat = false;
  bow = false;
  guard = false;
  for a in arguments() {
    if a == "bomb" { bomb = true; } else if a == "rat" { rat = true; } else if a == "bow" { bow = true; }
    else if a == "guard" { guard = true; } else { dir = a; }
  }
  m = game::new_game("..");
  if !m { println("the game does not load"); exit(1); }
  g = m;
  game::start_level(g, 0);
  w = g.world;
  for c in tile_world::stacks(w.w) {
    while tile_world::top(w.w, c.0, c.1, c.2) != 0 { _ = tile_world::take(w.w, c.0, c.1, c.2); }
  }
  for z in 0..3 { tile_world::fill(w.w, -2, -2, 16, 12, z, tile_world::VOID); }
  tile_world::fill(w.w, -1, -1, 8, 6, 0, rules::tr(w, "wall"));
  tile_world::fill(w.w, 0, 0, 7, 5, 0, rules::tr(w, "floor"));
  tile_world::place(w.w, 3, 3, 0, rules::th(w, "table"));
  tile_world::place(w.w, 3, 3, 0, rules::th(w, "chest"));
  rules::put_hero(w, 1, 2, 0);
  w.hero_item = rules::th(w, "sword");
  w.face_x = 1;
  w.face_y = 0;
  g.cam_x = -1;
  g.cam_y = -1;
  // (frame, act): r l u d a step that way, s a swing (or a throw).
  script = [(4, "r"), (8, "r"), (12, "r"), (18, "u"), (22, "u"), (26, "u"), (36, "d"), (40, "d"), (48, "s"), (60, "l")];
  if bomb {
    tile_world::fill(w.w, 0, 0, 7, 5, 0, rules::tr(w, "floor"));
    _ = tile_world::take(w.w, 3, 3, 0);
    _ = tile_world::take(w.w, 3, 3, 0);
    tile_world::set_terrain(w.w, 7, 2, 0, rules::tr(w, "wall"));
    tile_world::place(w.w, 6, 1, 0, rules::th(w, "rock"));
    tile_world::place(w.w, 6, 3, 0, rules::th(w, "chair"));
    tile_world::place(w.w, 5, 3, 0, rules::th(w, "stick"));
    rules::put_hero(w, 0, 2, 0);
    w.hero_item = rules::th(w, "bomb");
    script = [(3, "s")];
  }
  if rat {
    tile_world::fill(w.w, 0, 0, 7, 5, 0, rules::tr(w, "floor"));
    _ = tile_world::take(w.w, 3, 3, 0);
    _ = tile_world::take(w.w, 3, 3, 0);
    rules::put_hero(w, 1, 2, 0);
    w.face_x = 1;
    w.face_y = 0;
    _ = rules::add_enemy(w, "rat", 5, 2, 0);
    script = [(36, "s")];
  }
  if bow {
    tile_world::fill(w.w, 0, 0, 7, 5, 0, rules::tr(w, "floor"));
    _ = tile_world::take(w.w, 3, 3, 0);
    _ = tile_world::take(w.w, 3, 3, 0);
    tile_world::fill(w.w, 4, 0, 5, 5, 0, rules::tr(w, "water"));
    tile_world::set_terrain(w.w, 1, 5, 0, rules::tr(w, "wall"));
    rules::put_hero(w, 1, 2, 0);
    w.hero_item = rules::th(w, "bow");
    _ = rules::add_enemy(w, "bat", 5, 2, 0);
    _ = rules::add_enemy(w, "spider", 1, 5, 0);
    w.enemies[0].due = 100000;
    w.enemies[1].due = 100000;
    script = [(3, "t"), (6, "s"), (24, "t"), (28, "s"), (40, "s")];
  }
  if guard {
    tile_world::fill(w.w, 0, 0, 7, 5, 0, rules::tr(w, "floor"));
    _ = tile_world::take(w.w, 3, 3, 0);
    _ = tile_world::take(w.w, 3, 3, 0);
    rules::put_hero(w, 1, 1, 0);
    w.face_x = 1;
    w.face_y = 0;
    w.health = 2;
    _ = rules::add_enemy(w, "rat", 2, 1, 0);
    // Tough enough to outlive the riposte, so its open pose and its reel are seen.
    w.enemies[0].hp = 20;
    _ = rules::add_enemy(w, "cyclops", 2, 4, 0);
    w.enemies[1].face_x = 1;
    w.enemies[1].face_y = 0;
    film_guard(g, dir);
    return;
  }
  n = 0;
  for f in 0..72 {
    for a in script {
      if a.0 == f {
        if a.1 == "r" { game::move(g, 1, 0, false); }
        else if a.1 == "l" { game::move(g, -1, 0, false); }
        else if a.1 == "u" { game::move(g, 0, -1, false); }
        else if a.1 == "d" { game::move(g, 0, 1, false); }
        else if a.1 == "s" { game::swing(g); }
        else if a.1 == "t" { _ = rules::aim_next(g.world); }
      }
    }
    game::draw(g);
    name = "{dir}/frame_{if f < 10 { "00" } else if f < 100 { "0" } else { "" }}{f}.png";
    if !game::snapshot(g, name, 3) { println("could not write {name}"); exit(1); }
    rules::tick(g.world, FRAME);
    n += 1;
  }
  println("{n} frames in {dir}");
}

// The guard scene, played through the game's own keys and update (the reactions live there): K
// pressed and held until the rat's bite has landed on it and a little longer; let go; K tapped
// in the rat's next wind-up, 100 ms before it lands; a swing at the open rat — a riposte.  The
// cyclops below, nothing beside it, winds up its sweep at the empty cell it faces.
fn film_guard(g: game::Game, dir: text) {
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  down = up;
  down[107] = true;
  t = 0;
  held = true;
  after_block = -1;
  parried = -1;
  for f in 0..90 {
    w = g.world;
    if held { g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0); }
    else { g.keys.input_tick_from_state(up, 0.0, 0.0, 0, 0); }
    if w.blocks > 0 && after_block < 0 { after_block = f; }
    if after_block >= 0 && f == after_block + 8 { held = false; }
    if !held && parried < 0 && w.blocks > 0 {
      e = w.enemies[0];
      if e && e.wind_until > 0 && e.wind_until - w.now <= 100 {
        g.keys.input_tick_from_state(down, 0.0, 0.0, 0, 0);
        parried = f;
      }
    }
    if parried >= 0 && f == parried + 6 { game::swing(g); }
    t += FRAME;
    _ = game::update(g, FRAME, t);
    game::draw(g);
    name = "{dir}/frame_{if f < 10 { "00" } else if f < 100 { "0" } else { "" }}{f}.png";
    if !game::snapshot(g, name, 3) { println("could not write {name}"); exit(1); }
  }
  println("blocked at frame {after_block}, parried at {parried}; {g.world.blocks} blocks, {g.world.parries} parries, {g.world.ripostes} ripostes");
}
