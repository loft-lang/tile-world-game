// The first hex test (owner, 2026-11-09): one L-shaped house drawn at all twelve 30° angles
// across a larger empty terrain, the hex grid showing; then a gallery of other shapes (boxes, an
// L, a T, a U) at 0°, 30°, 60° and 90°, each with its walls drawn from its cells alone.  As JSON for tools/hexhouses.py to draw into hexhouses.html.
//
//   loft --lib libs tools/hexhouses.loft > build/hexhouses.json && python3 tools/hexhouses.py
//   loft --lib libs tools/hexhouses.loft outline > build/hexhouses2.json &&
//     python3 tools/hexhouses.py build/hexhouses2.json hexhouses2.html outline
//
// With `outline` the editor turns a house to 30° by its drawn outline moved as a whole instead of
// wall by wall (hexturn::BY_OUTLINE), for the second page.
//
// Each house: its cells, its boundary edges (the thin walls the rules use), its straight walls
// as hexwalls.loft solves them, the heading each wall runs along, and the axes read off its cells
// (-1: the cells show no direction, so the placed angle decided).
use hex_field;
use hex_draw;
use hexwalls;
use hexturn;
use hexhouse;

const COLS = 4;
const ROWS = 3;
const GAP = 16;

/// One house as a JSON object.
fn house_json(b: hexwalls::Built, name: text, turn: integer, cq: integer, cr: integer) -> text {
  cells = "";
  for r in hex_field::hexset_r0(b.cells)..hex_field::hexset_r0(b.cells) + hex_field::hexset_h(b.cells) {
    for q in hex_field::hexset_q0(b.cells)..hex_field::hexset_q0(b.cells) + hex_field::hexset_w(b.cells) {
      if hex_field::hexset_get(b.cells, q, r) {
        if len(cells) > 0 { cells += ", "; }
        cells += "[{q}, {r}]";
      }
    }
  }
  edges = "";
  for e in b.boundary {
    if len(edges) > 0 { edges += ", "; }
    edges += "[{e.ak}, {e.am}, {e.bk}, {e.bm}]";
  }
  corners = "";
  for c in b.corners {
    if len(corners) > 0 { corners += ", "; }
    corners += "[{c.0}, {c.1}]";
  }
  exact = "";
  for wl in b.walls {
    if len(exact) > 0 { exact += ", "; }
    exact += "{hex_draw::surface_heading(wl)}";
  }
  axes = hexwalls::axes_of(b.boundary);
  ops = "";
  for o in b.openings {
    if len(ops) > 0 { ops += ", "; }
    oe = "";
    for i in o.edges {
      e = b.boundary[i];
      if len(oe) > 0 { oe += ", "; }
      oe += "[{e.ak}, {e.am}, {e.bk}, {e.bm}]";
    }
    ops += "{{\"kind\": {o.kind}, \"wall\": {o.wall}, \"a\": [{o.ax}, {o.ay}], \"b\": [{o.bx}, {o.by}], \"edges\": [{oe}]}}";
  }
  "{{\"name\": \"{name}\", \"turn\": {turn}, \"axes\": {axes}, \"cq\": {cq}, \"cr\": {cr}, \"cells\": [{cells}], \"edges\": [{edges}], \"corners\": [{corners}], \"exact\": [{exact}], \"openings\": [{ops}]}}"
}

fn part(u0: integer, v0: integer, u1: integer, v1: integer) -> hexhouse::Part {
  hexhouse::Part { u0: u0, v0: v0, u1: u1, v1: v1 }
}

fn door(u: integer, v: integer) -> hexhouse::Spec { hexhouse::Spec { kind: hexwalls::DOOR, u: u, v: v } }
fn window(u: integer, v: integer) -> hexhouse::Spec { hexhouse::Spec { kind: hexwalls::WINDOW, u: u, v: v } }

fn main() {
  way = if (arguments()[0] ?? "") == "outline" { hexturn::BY_OUTLINE } else { hexturn::BY_WALLS };
  sz = hexwalls::sizes_file("../hexsizes.json");
  plan = hexhouse::l_plan(6, 3, 3, 4);
  // A front door and a window beside it, a window at the east end, one in the wing's west side.
  l_open = [door(2, -3), window(-3, -3), window(6, 0), window(-6, 7)];
  t_open = [door(0, -3), window(-3, 7), window(3, 7)];
  w = COLS * GAP + 4;
  h = ROWS * GAP + 6;
  println("{{\"terrain\": [0, 0, {w}, {h}], \"houses\": [");
  for i in 0..12 {
    cq = 2 + GAP / 2 + (i % COLS ?? 0) * GAP;
    // Rows from the top down (y grows up), so the angles read left to right, top to bottom.
    cr = 2 + GAP / 2 + (ROWS - 1 - (i / COLS ?? 0)) * GAP;
    b = hexhouse::build(hexhouse::HexHouse { cq: cq, cr: cr, turn: i, parts: plan, openings: l_open }, way, sz);
    sep = if i < 11 { "," } else { "" };
    println("{house_json(b, "L", i, cq, cr)}{sep}");
  }
  // The gallery: a row per shape, a column per angle (0°, 30°, 60°, 90°).
  names = ["box 5×4", "box 3×2", "box 2×2", "L 4×2 + 2×3", "T", "U", "T drawn at 30°"];
  plans = [hexhouse::box_plan(5, 4), hexhouse::box_plan(3, 2), hexhouse::box_plan(2, 2),
           hexhouse::l_plan(4, 2, 2, 3), [part(-8, -3, 8, 3), part(-3, 3, 3, 11)],
           [part(-8, -3, 8, 3), part(-8, 3, -3, 11), part(3, 3, 8, 11)],
           [part(-8, -3, 8, 3), part(-3, 3, 3, 11)]];
  rows = len(names);
  gh = rows * GAP + 6;
  println("], \"gterrain\": [0, 0, {w}, {gh}], \"gallery\": [");
  for s in 0..rows {
    for t in 0..4 {
      cq = 2 + GAP / 2 + t * GAP;
      cr = 2 + GAP / 2 + (rows - 1 - s) * GAP;
      ops: vector<hexhouse::Spec> = if s >= 4 && s != 5 { t_open } else { [] };
      b = hexhouse::build(hexhouse::HexHouse { cq: cq, cr: cr, turn: t, parts: plans[s], openings: ops }, way, sz);
      shown = t;
      if s == rows - 1 {
        // Drawn at 30° and turned from there, by 0°, 30°, 60° and 90°: the turn reads only the
        // cells, whatever direction they were drawn in.
        // the 30° house's data (cells and marks) is the hexhouse build's, turned on from there
        d0 = hexhouse::HexHouse { cq: cq, cr: cr, turn: 1, parts: plans[s], openings: t_open };
        drawn = hexhouse::build(d0, way);
        shown = 1 + t;
        data = hexturn::Data { cells: drawn.cells, marks: drawn.edges };
        moved = hexturn::turn_data(data, cq, cr, t, way, 1, sz);
        b = hexwalls::from_data(moved.cells, moved.marks, shown, sz);
      }
      sep = if s < rows - 1 || t < 3 { "," } else { "" };
      println("{house_json(b, names[s], shown, cq, cr)}{sep}");
    }
  }
  println("]}}");
}
