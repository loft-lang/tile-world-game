// The play server: one port for a game played in a browser.  Over HTTP it serves the page
// `loft --html` built (build/web/index.html) and the guide beside it, read from disk at every
// request with caching off, so a rebuilt page is what a reload gets.  Over a WebSocket on the same
// port (any path; the game uses /ws) it takes the game's play log (playlog.loft) and writes each line
// to a file as it comes, so the log of a game played in the browser is read on this machine.
// Several pages at once: each is a client of the server's event loop (`run`), its lines in order.
//   TW_LOG=<file> loft --lib libs tools/playserver.loft     (./play-web.sh builds and starts it)
// A line arrives as `1:<line>` (the server's `<id>:<payload>` frames); a page connecting is noted.
use server;

/// The port, on this machine only (127.0.0.1): the game's LOG_URL names it.  TW_PORT sets another
/// (checks/playlog.sh runs one beside a game's).
const PORT = 8080;
/// Paths from tools/, the directory loft runs this script in.
const WEB = "../build/web";

/// The worlds the server opens, each at /<its start place> (levels/order.json's `worlds`): the
/// page is the same, told which world to start before the game starts: `world <start place>` as
/// the host's first input (`globalThis.loftInput`, read by the game's `host_input`).
const ORDER = "../levels/order.json";

struct World {
  name: text,
  start: text
}

fn worlds() -> vector<World> {
  out: vector<World> = [];
  v = json_parse(file(ORDER).content() ?? "").field("worlds");
  for i in 0..v.len() {
    e = v.item(i);
    out += [World { name: e.field("name").as_text() ?? "", start: e.field("start").as_text() ?? "" }];
  }
  out
}

// The neutral front page: a link to each world, the guide and the hex houses.
fn front(ws: const vector<World>) -> text {
  links = "";
  for w in ws { links += "<li><a href=\"/{w.start}\">{w.name}</a></li>"; }
  "<!doctype html><html><head><meta charset=\"utf-8\"><title>tile_world</title>" +
  "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
  "<style>body{{background:#111;color:#eee;font:18px/1.5 monospace;padding:2em}}a{{color:#fc6}}</style></head>" +
  "<body><h1>tile_world</h1><ul>{links}</ul><p><a href=\"/guide.html\">how to play and edit</a></p>" +
  "<p>the hex grid, houses at twelve angles: <a href=\"/hexhouses.html\">each wall to the nearest grid line</a>, " +
  "<a href=\"/hexhouses2.html\">the outline moved as a whole</a></p>" +
  "<p><a href=\"/hextown.html\">the town on the hex grid, in 3D</a></p></body></html>"
}

// The game's page for world `start`: told its world before the game reads its query.
fn world_page(body: text, start: text) -> text {
  set = "<script>globalThis.loftInput=\"world {start}\";</script>";
  at = body.find("<head>") ?? -1;
  if at < 0 { return set + body; }
  body[0..at + 6] + set + body[at + 6..]
}

// A file of the built page, its text ("" when missing).
fn page(name: text) -> text {
  f = file("{WEB}/{name}");
  if f.format == Format.NotExists { return ""; }
  body = f.content();
  body
}

// Answer the HTTP request the event loop parked: `body` as `kind`, never cached (a reload gets a
// rebuilt page).  The Server's own responders send no headers, so the parked request is answered
// through a Request, as `respond_with_headers` acts on the connection the loop holds.
fn answer(status: integer, body: text, kind: text) {
  req = server::Request { method: "GET", path: "", body: "", headers: [] };
  req.respond_with_headers(status, body, ["Content-Type: {kind}", "Cache-Control: no-store"]);
}

fn main() {
  path = env_variable("TW_LOG") ?? "";
  if path == "" { path = "../logs/browser.log"; }
  out = file(path);
  if !out.write("# tile_world play log from a browser: wall ms since the page started, the world's clock (ms), what happened\n").ok() {
    println("could not write {path}");
    return;
  }
  port = (env_variable("TW_PORT") ?? "") as integer ?? PORT;
  srv = server::try_listen_on("127.0.0.1", port);
  if !srv.bound() {
    println("port {port} is taken: stop what holds it (another play server, python -m http.server)");
    return;
  }
  ws = worlds();
  println("the worlds: http://localhost:{port}/   (the guide: /guide.html)");
  for w in ws { println("  {w.name}: http://localhost:{port}/{w.start}"); }
  println("its log:    {path}");
  srv.run(fn(ev: server::WsEvent) {
    if ev.http {
      // The path without its query, and without a closing slash.
      p = ev.path;
      q = p.find("?") ?? -1;
      if q >= 0 { p = p[0..q]; }
      if len(p) > 1 && p.ends_with("/") { p = p[0..len(p) - 1]; }
      opened = "";
      for w in ws { if p == "/{w.start}" { opened = w.start; } }
      if p == "/" {
        answer(200, front(ws), "text/html; charset=utf-8");
      } else if opened != "" {
        body = page("index.html");
        if body == "" {
          answer(500, "build/web/index.html is missing: build it with ./play-web.sh", "text/plain; charset=utf-8");
        } else {
          answer(200, world_page(body, opened), "text/html; charset=utf-8");
        }
      } else if p == "/index.html" {
        body = page("index.html");
        if body == "" {
          answer(500, "build/web/index.html is missing: build it with ./play-web.sh", "text/plain; charset=utf-8");
        } else {
          answer(200, body, "text/html; charset=utf-8");
        }
      } else if ev.path == "/guide.html" {
        answer(200, page("guide.html"), "text/html; charset=utf-8");
      } else if ev.path == "/hexhouses.html" || ev.path == "/hexhouses2.html" || ev.path == "/hextown.html" {
        answer(200, page(ev.path[1..]), "text/html; charset=utf-8");
      } else {
        srv.respond_404();
      }
    } else if ev.connected {
      _ = out.write("# a game connected (client {ev.cid})\n");
      println("a game connected (client {ev.cid})");
    } else if ev.message {
      _ = out.write("{ev.payload}\n");
    }
  });
}
