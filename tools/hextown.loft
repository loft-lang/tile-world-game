// The town ported to the hex grid, and a hill with a house at every angle (hextown.loft), as JSON
// for tools/hextown.py to draw in 3D into hextown.html:
//
//   loft --lib libs tools/hextown.loft > build/hextown.json && python3 tools/hextown.py
//   loft --lib libs tools/hextown.loft level > levels/orbury.hex.json     (the game's 3D view reads it)
//
// Per scene: the ground (its window, and per cell its height in metres and its surface kind), each
// house (its angle, the heights of its walls' foot, its floor and its eaves, its outline as the
// straight walls' corners in metres, its doors and windows), and the things on the surface.
use hex_field;
use hexwalls;
use hexterrain;
use hextown;

const M = 0.8660254037844386;

fn scene(name: text, town: hextown::Town) -> text {
  g = town.ground;
  hs = "";
  ks = "";
  ls = "";
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w {
      if len(hs) > 0 { hs += ","; ks += ","; ls += ","; }
      hs += "{round(hex_field::height_get(g.heights, q, r) * 1000.0) / 1000.0}";
      ks += "{hex_field::label_get(g.kinds, q, r)}";
      ls += "{hex_field::label_get(town.levels, q, r)}";
    }
  }
  out = "{{\"name\": \"{name}\", \"ground\": {{\"q0\": {g.q0}, \"r0\": {g.r0}, \"w\": {g.w}, \"h\": {g.h}, \"heights\": [{hs}], \"kinds\": [{ks}], \"levels\": [{ls}]}}, \"cliffs\": [";
  for i in 0..len(town.cliffs) {
    c = town.cliffs[i];
    if i > 0 { out += ", "; }
    out += "{{\"level\": {c.level}, \"a\": [{c.ax}, {c.ay}], \"b\": [{c.bx}, {c.by}]}}";
  }
  out += "], \"houses\": [";
  for i in 0..len(town.houses) {
    p = town.houses[i];
    cs = "";
    for c in p.built.corners {
      if len(cs) > 0 { cs += ", "; }
      cs += "[{c.0 * M}, {c.1 * M}]";
    }
    ops = "";
 for oi in 0..len(p.built.openings) {
      o = p.built.openings[oi];
      if len(ops) > 0 { ops += ", "; }
      // a bay window: kind 3
      ops += "{{\"kind\": {if p.bays.contains(oi) { 3 } else { o.kind }}, \"wall\": {o.wall}, \"a\": [{o.ax * M}, {o.ay * M}], \"b\": [{o.bx * M}, {o.by * M}]}}";
    }
    if i > 0 { out += ", "; }
    ct = "";
    for c in p.court {
      if len(ct) > 0 { ct += ", "; }
      ct += "[{c.0}, {c.1}]";
    }
    parts = "";
    for b in p.parts {
      if len(parts) > 0 { parts += ", "; }
      bc = "";
      for j in 0..4 {
        if j > 0 { bc += ", "; }
        bc += "[{b.xs[j] ?? 0.0}, {b.ys[j] ?? 0.0}]";
      }
      ds = "";
      for dv in b.dormers { ds += if ds == "" { "{dv}" } else { ", {dv}" }; }
      parts += "{{\"corners\": [{bc}], \"top\": {b.top}, \"roof\": {b.roof}, \"dormers\": [{ds}]}}";
    }
    tops = "";
    rims = "";
    for j in 0..len(p.tops) {
      if j > 0 { tops += ", "; rims += ", "; }
      tops += "{p.tops[j] ?? p.top}";
      rims += "{p.rims[j] ?? 0.0}";
    }
    rises = "";
    for rs in p.rises {
      if len(rises) > 0 { rises += ", "; }
      rises += "{{\"a\": [{rs.ax}, {rs.ay}], \"b\": [{rs.bx}, {rs.by}], \"z0\": {rs.z0}, \"z1\": {rs.z1}}}";
    }
    out += "{{\"turn\": {p.turn}, \"base\": {p.base}, \"floor\": {p.floor}, \"top\": {p.top}, \"roof\": {p.roof}, \"corners\": [{cs}], \"court\": [{ct}], \"openings\": [{ops}], \"parts\": [{parts}], \"tops\": [{tops}], \"rims\": [{rims}], \"rises\": [{rises}]}}";
  }
  out += "], \"things\": [";
  for i in 0..len(town.things) {
    t = town.things[i];
    if i > 0 { out += ", "; }
    out += "{{\"kind\": \"{t.kind}\", \"x\": {t.x}, \"y\": {t.y}, \"z\": {t.z}, \"size\": {t.size}}}";
  }
  out += "], \"fences\": [";
  for i in 0..len(town.fences) {
    f = town.fences[i];
    if i > 0 { out += ", "; }
    out += "{{\"kind\": {f.kind}, \"a\": [{f.ax}, {f.ay}], \"b\": [{f.bx}, {f.by}], \"height\": {f.height}, \"thick\": {f.thick}}}";
  }
  out + "]}}"
}

fn main() {
  sz = hexwalls::sizes_file("../hexsizes.json");
  m = hexterrain::measures_file("../hexsizes.json");
  town = hextown::port(file("../levels/orbury.json").content() ?? "", sz, m, hextown::yards_file("../hexsizes.json"));
  if (arguments()[0] ?? "") == "level" {
    // the place's hex version, for the game's 3D view: levels/orbury.hex.json
    println("{{\"storey\": {m.storey}, \"wall\": {sz.wall / hexwalls::PER_METRE}, \"scene\": {scene("Orbury", town)}}}");
    return;
  }
  hill = hextown::showcase(sz, m);
  println("{{\"storey\": {m.storey}, \"wall\": {sz.wall / hexwalls::PER_METRE}, \"scenes\": [");
  println("{scene("Orbury, ported", town)},");
  println("{scene("A hill, a house at every angle", hill)}");
  println("]}}");
}
