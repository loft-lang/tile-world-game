//
// The world's walls, drawn from the hex cells alone (owner, 2026-11-09: the world is drawn only from
// the hex cell data; turning a house is the editor's step, hexhouse.loft).  Nothing here knows a
// plan or the angle a house was placed at.  Built here first; the routines move to the hex
// libraries once they are right.
//
// From a set of cells, in order:
//   1. the thin walls the rules use: the edges between the cells and the outside
//      (`hex_draw::draw_walls`).  A wall edge lies between two hex centres, one inside and one
//      outside, so a wall costs no floor and every cell is clearly in or out;
//   2. the boundary walked (`boundary`), the axes its walls run along read off it (`axes_of`: each
//      edge votes for the heading nearest the way the boundary travels; a tie, from cells that
//      show no direction, falls back to a hint), and the boundary cut into runs, one per straight
//      wall (`runs`);
//   3. each run's straight wall, by one routine for each kind (owner): `solve_tops` for the wobble
//      across the tops of a row of hexes, `solve_sides` for the line along the sides of hexes
//      under each other; mitred where two walls meet as `hex_draw::surface_miter` does.
//
// Lattice units, as `hex_field` keeps them: a cell centre is (2q + (r & 1), 3r) in doubled
// coordinates (k, m), a point is at x = k·√3/2, y = m/2 world units, a hex step is √3 units
// (1.5 m), one unit is 0.866 m.
use hex_grid;
use hex_field;
use hex_form;
use hex_draw;

/// The edge material of a wall.
pub const WALL = 9;

/// One stored edge of the boundary: the house's cell (qa, ra) and the outside one (qb, rb), and
/// its corners from (ak, am) to (bk, bm) in doubled coordinates, the house on the left.
pub struct Edge {
  pub qa: integer,
  pub ra: integer,
  pub qb: integer,
  pub rb: integer,
  pub ak: integer,
  pub am: integer,
  pub bk: integer,
  pub bm: integer
}

/// A door or a window: its kind, the wall it is in (an index into `walls`), its edges (indices
/// into `boundary`, in order along the wall), its centre on the wall's line and the span it is
/// drawn over, from a to b, in world units.
pub struct Opening {
  pub kind: integer,
  pub wall: integer,
  pub edges: vector<integer>,
  pub cx: float,
  pub cy: float,
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float
}

/// The house as built: its cells, its thin walls, the boundary in walking order, the runs (each a
/// list of indices into `boundary`, in order round the house), a surface per run, and the
/// corners (corner i is where wall i meets wall i + 1, in world units).
pub struct Built {
  pub cells: hex_field::HexSet,
  pub edges: hex_field::EdgeSet,
  pub boundary: vector<Edge>,
  pub runs: vector<vector<integer>>,
  pub walls: vector<hex_draw::WallSurface>,
  pub corners: vector<(float, float)>,
  pub openings: vector<Opening> = []
}

// ── openings: doors and windows ─────────────────────────────────────────────
//
// In the data a door or a window is a material on wall edges (`hex_draw`'s opening kinds), never a
// gap: the edges stay wall, the run stays one run, and the straight wall is solved as if the
// opening were not there (owner, 2026-11-09).  To the walls it is a point on the wall's line, its
// centre: the mean of its edges' midpoints, taken onto the line.  The drawing leaves room in the
// wall there and puts a mesh in it, of one width for its kind on every wall at every angle, so one
// mesh fits (owner).

/// The kinds of opening, as `hex_draw` names them.
pub const DOOR = hex_draw::OPEN_DOOR;
pub const WINDOW = hex_draw::OPEN_WINDOW;

// ── the measurements ────────────────────────────────────────────────────────

/// The measurements the walls and openings are drawn with, in world units (one unit is 0.866 m),
/// read from hexsizes.json in metres so they can change without the routines (owner,
/// 2026-11-09): each kind of wall's drawn thickness (an outer wall, an inner wall between rooms,
/// a fence: each its own, owner), a door's and a window's width (the same on every wall at every
/// angle, so one mesh fits), and how far an opening's edge keeps from its wall's corner.
pub struct Sizes {
  pub wall: float,
  pub inner: float,
  pub fence: float,
  pub door: float,
  pub window: float,
  pub corner: float
}

/// World units per metre.
pub const PER_METRE = 1.1547005383792515;

/// The measurements hexsizes.json gives today, for a caller that has not read the file: a wall
/// √3/2 unit (0.75 m) thick, a door and a window one unit (0.87 m) wide, an opening's edge a
/// wall's thickness from the corner.
pub fn default_sizes() -> Sizes {
  Sizes { wall: 0.8660254037844386, inner: 0.45 * PER_METRE, fence: 0.15 * PER_METRE, door: 1.0,
          window: 1.0, corner: 0.8660254037844386 }
}

/// The measurements in a hexsizes.json text (metres); a measurement it lacks keeps its default.
pub fn sizes_from(text: text) -> Sizes {
  d = default_sizes();
  if text == "" { return d; }
  v = json_parse(text);
  w = v.field("walls");
  o = v.field("openings");
  Sizes { wall: metres(w.field("outer"), d.wall), inner: metres(w.field("inner"), d.inner),
          fence: metres(w.field("fence"), d.fence), door: metres(o.field("door"), d.door),
          window: metres(o.field("window"), d.window), corner: metres(v.field("corner_clearance"), d.corner) }
}

/// The measurements in the file at `path`.
pub fn sizes_file(path: text) -> Sizes { sizes_from(file(path).content() ?? "") }

fn metres(v: const JsonValue, default: float) -> float {
  if v.kind() == "JInteger" || v.kind() == "JNumber" { v.as_number() * PER_METRE } else { default }
}

/// The width an opening of `kind` is drawn at, in world units, the same on every wall and at
/// every angle.
pub fn opening_width(kind: integer, sz: Sizes = default_sizes()) -> float {
  if kind == DOOR { sz.door } else { sz.window }
}



/// The wall's direction as a unit vector in world units.
pub fn wall_dir(w: hex_draw::WallSurface) -> (float, float) {
  x = (w.ws_dk as float) * 0.8660254037844386;
  y = (w.ws_dm as float) * 0.5;
  l = sqrt(x * x + y * y);
  ((x / l) ?? 0.0, (y / l) ?? 0.0)
}

/// The opening on wall `wi` over the edges `group`: its centre where its edges' midpoints fall on
/// the wall's line, and its span, its kind's width about that centre.
fn opening(b: const vector<Edge>, w: hex_draw::WallSurface, wi: integer, kind: integer,
           group: const vector<integer>, sz: Sizes) -> Opening {
  px = 0.0;
  py = 0.0;
  for i in group {
    e = b[i];
    px += ((e.ak + e.bk) as float) * 0.5 * 0.8660254037844386;
    py += ((e.am + e.bm) as float) * 0.25;
  }
  n = len(group) as float;
  px = (px / n) ?? 0.0;
  py = (py / n) ?? 0.0;
  mx = hex_draw::surface_mean_x(w);
  my = hex_draw::surface_mean_y(w);
  (dx, dy) = wall_dir(w);
  t = (px - mx) * dx + (py - my) * dy;
  cx = mx + t * dx;
  cy = my + t * dy;
  half = opening_width(kind, sz) * 0.5;
  Opening { kind: kind, wall: wi, edges: group, cx: cx, cy: cy,
            ax: cx - half * dx, ay: cy - half * dy, bx: cx + half * dx, by: cy + half * dy }
}

/// The openings `marks` holds on the walls: along each wall's run, each stretch of edges marked
/// with one kind is one opening.
fn openings_of(b: const vector<Edge>, rs: const vector<vector<integer>>,
               walls: vector<hex_draw::WallSurface>, marks: hex_field::EdgeSet, sz: Sizes) -> vector<Opening> {
  out: vector<Opening> = [];
  for wi in 0..len(rs) {
    run = rs[wi];
    i = 0;
    while i < len(run) {
      e = b[run[i] ?? 0];
      kind = hex_field::edge_mat(marks, e.qa, e.ra, e.qb, e.rb);
      if kind != DOOR && kind != WINDOW {
        i += 1;
        continue;
      }
      group: vector<integer> = [];
      while i < len(run) {
        f = b[run[i] ?? 0];
        if hex_field::edge_mat(marks, f.qa, f.ra, f.qb, f.rb) != kind { break; }
        group += [run[i] ?? 0];
        i += 1;
      }
      out += [opening(b, walls[wi], wi, kind, group, sz)];
    }
  }
  out
}

/// 4 × the world dot product of two doubled-coordinate vectors (x = k·√3/2, y = m/2).
pub fn dot4(ak: integer, am: integer, bk: integer, bm: integer) -> integer { 3 * ak * bk + am * bm }

// ── 2. the boundary, walked and cut into runs ───────────────────────────────

/// The boundary of `cells` in walking order, the house on the left: one loop (a house is one
/// piece without a courtyard).
// @FR-HX-Edge: the boundary is the edges between a cell inside and one outside
pub fn boundary(cells: hex_field::HexSet) -> vector<Edge> {
  all: vector<Edge> = [];
  for br in hex_field::hexset_r0(cells)..hex_field::hexset_r0(cells) + hex_field::hexset_h(cells) {
    for bq in hex_field::hexset_q0(cells)..hex_field::hexset_q0(cells) + hex_field::hexset_w(cells) {
      if !hex_field::hexset_get(cells, bq, br) { continue; }
      for d in 0..6 {
        nq = hex_field::nb_q(bq, br, d);
        nr = hex_field::nb_r(bq, br, d);
        if hex_field::hexset_get(cells, nq, nr) { continue; }
        // The corners as `hex_draw::surface_of` reads them.
        (c1, c2) = hex_grid::hex_edge_corners(hex_grid::hex_neighbor_dir(bq, br, nq, nr));
        k = hex_field::lattice_k(bq, br);
        m = hex_field::lattice_m(bq, br);
        all += [Edge { qa: bq, ra: br, qb: nq, rb: nr,
                       ak: k + hex_field::corner_k(c1), am: m + hex_field::corner_m(c1),
                       bk: k + hex_field::corner_k(c2), bm: m + hex_field::corner_m(c2) }];
      }
    }
  }
  walk: vector<Edge> = [];
  if len(all) == 0 { return walk; }
  used: vector<boolean> = [for _ in 0..len(all) { false }];
  at = 0;
  for _ in 0..len(all) {
    e = all[at];
    walk += [e];
    used[at] = true;
    nxt = -1;
    for j in 0..len(all) {
      if !used[j] && all[j].ak == e.bk && all[j].am == e.bm { nxt = j; }
    }
    if nxt < 0 { break; }
    at = nxt;
  }
  walk
}

/// How many edges either side the travelling direction is read over: enough to span a period of
/// the zigzag (2 edges) and of the staircase (3).
pub const AROUND = 2;

/// Which way the boundary travels at edge i, over AROUND edges either side: 0 along +u, 1 along
/// +v, 2 along -u, 3 along -v (u the house's heading, v the heading three steps on); -1 when it
/// is exactly between.  Exact: the two heading steps are √3 and 3 long, one each way round, so
/// the projections compare as squares, one of them times 3.
fn travel(turn: integer, b: const vector<Edge>, i: integer) -> integer {
  n = len(b);
  a = b[((i - AROUND) % n + n) % n ?? 0];
  z = b[(i + AROUND) % n ?? 0];
  wk = z.bk - a.ak;
  wm = z.bm - a.am;
  (uk, um) = hex_form::head_step(turn);
  (vk, vm) = hex_form::head_step(turn + 3);
  u = dot4(wk, wm, uk, um);
  v = dot4(wk, wm, vk, vm);
  // |u| / L_u against |v| / L_v: with L_u = √3, L_v = 3 that is 3u² against v²; the other way
  // round, u² against 3v².
  au = if turn % 2 == 0 { 3 * u * u } else { u * u };
  av = if turn % 2 == 0 { v * v } else { 3 * v * v };
  if au > av { if u > 0 { 0 } else { 2 } } else if av > au { if v > 0 { 1 } else { 3 } } else { -1 }
}

/// The boundary cut into runs, one per straight wall, in order round the house.  A run shorter
/// than 2 edges is the turn of a corner, not a wall: it joins the run before it.
// @FR-HW-Runs: one run per straight wall; a run under two edges joins the one before
pub fn runs(turn: integer, b: const vector<Edge>) -> vector<vector<integer>> {
  n = len(b);
  label: vector<integer> = [for i in 0..n { travel(turn, b, i) }];
  for i in 0..n {
    if label[i] < 0 { label[i] = label[(i + n - 1) % n ?? 0]; }
  }
  out: vector<vector<integer>> = [];
  for _ in 0..n {
    out = groups(label);
    short = -1;
    for g in 0..len(out) {
      if short < 0 && len(out[g]) < 2 && len(out) > 1 { short = g; }
    }
    if short < 0 { break; }
    prev = label[out[(short + len(out) - 1) % len(out) ?? 0][0] ?? 0] ?? 0;
    for i in out[short] ?? [] { label[i] = prev; }
  }
  out
}

/// The runs of equal labels round the loop, starting where a label changes.
fn groups(label: const vector<integer>) -> vector<vector<integer>> {
  n = len(label);
  start = 0;
  for i in 0..n {
    if start == 0 && label[i] != label[(i + n - 1) % n ?? 0] { start = i; }
  }
  out: vector<vector<integer>> = [];
  cur: vector<integer> = [];
  for j in 0..n {
    i = (start + j) % n ?? 0;
    if len(cur) > 0 && label[i] != label[cur[0] ?? 0] {
      out += [cur];
      cur = [];
    }
    cur += [i];
  }
  if len(cur) > 0 { out += [cur]; }
  out
}

// ── the average and the miter: `hex_draw`'s, over a run ────────────────

/// `hex_draw::surface_of` over a run of edges rather than a `Plan`'s side: the sum of the edge
/// vectors and of the doubled midpoints, exact integers.
pub fn surface_of(b: const vector<Edge>, run: const vector<integer>) -> hex_draw::WallSurface {
  sdk = 0;
  sdm = 0;
  smk = 0;
  smm = 0;
  for i in run {
    e = b[i];
    (c1, c2) = hex_grid::hex_edge_corners(hex_grid::hex_neighbor_dir(e.qa, e.ra, e.qb, e.rb));
    sdk = sdk + hex_field::corner_k(c2) - hex_field::corner_k(c1);
    sdm = sdm + hex_field::corner_m(c2) - hex_field::corner_m(c1);
    smk = smk + 2 * hex_field::lattice_k(e.qa, e.ra) + hex_field::corner_k(c1) + hex_field::corner_k(c2);
    smm = smm + 2 * hex_field::lattice_m(e.qa, e.ra) + hex_field::corner_m(c1) + hex_field::corner_m(c2);
  }
  n = len(run);
  hex_draw::WallSurface { ws_dk: sdk, ws_dm: sdm, ws_num_k: smk, ws_num_m: smm, ws_den: 2 * n, ws_n: n }
}

/// `hex_draw::surface_miter` over two surfaces: where their lines meet, in world units, and
/// false when they are parallel (adjacent walls never are).
pub fn surface_miter(wa: hex_draw::WallSurface, wb: hex_draw::WallSurface) -> (float, float, boolean) {
  ax = hex_draw::surface_mean_x(wa);
  ay = hex_draw::surface_mean_y(wa);
  bx = hex_draw::surface_mean_x(wb);
  by = hex_draw::surface_mean_y(wb);
  aux = (wa.ws_dk as float) * 0.8660254037844386;
  auy = (wa.ws_dm as float) * 0.5;
  bux = (wb.ws_dk as float) * 0.8660254037844386;
  buy = (wb.ws_dm as float) * 0.5;
  den = aux * buy - auy * bux;
  if den < 0.000000001 && den > 0.0 - 0.000000001 { return (0.0, 0.0, false); }
  tt = (((bx - ax) * buy - (by - ay) * bux) / den) ?? 0.0;
  (ax + tt * aux, ay + tt * auy, true)
}

// ── 3. the two kinds of straight wall, solved from the wall data ────────────
//
// A straight wall on the hex grid is one of two kinds (owner, 2026-11-09: one routine for each):
//
//   TOPS   (an even heading, the grid's own edge directions): the wobble across the tops of a row
//          of hexes, edges zigzagging between the row's apexes and shoulders.  Turned to run due
//          east, every edge's midpoint lies on one line, half way up the band (ROUNDTRIP §6.2,
//          band 1/2 unit) — so the line is exact from any of its edges, a whole run or a cut one.
//   SIDES  (an odd heading, the grid's corner directions): the line along the sides of hexes
//          under each other, upright sides alternating with short slanted connectors where the
//          rows shift by half a cell.  Turned to run due north, every connector's midpoint lies on
//          the line, in the middle of the band (√3/2 unit); the upright sides lie on its two
//          edges.
//
// So each routine turns its run into its own frame (a 60° turn is exact on the lattice, X1),
// reads the line off the edges that make its pattern — the most common midpoint: an edge of the
// next wall, caught in the run at a corner, has a midpoint of its own and is outvoted — and turns
// the line back.  The direction is the heading itself, exactly.  The answer is a
// `hex_draw::WallSurface`, so `hex_draw`'s readers and the miter above take it unchanged.  On a
// whole run (every side of a box) it is the line `hex_draw::surface_of` gives.

/// A doubled-coordinate point or vector turned 60° anticlockwise: exact, since a lattice point's
/// k and m have the same parity.
pub fn turn60(k: integer, m: integer) -> (integer, integer) { ((k - m) / 2 ?? 0, (3 * k + m) / 2 ?? 0) }

/// Turned `steps` × 60° anticlockwise.
pub fn turned(k: integer, m: integer, steps: integer) -> (integer, integer) {
  tk = k;
  tm = m;
  for _ in 0..((steps % 6) + 6) % 6 ?? 0 { (tk, tm) = turn60(tk, tm); }
  (tk, tm)
}

/// A rational point (`nk / d`, `nm / d`) turned `steps` × 60°: the numerators doubled first, so
/// the halving stays exact.
fn turned_q(nk: integer, nm: integer, d: integer, steps: integer) -> (integer, integer, integer) {
  tk = nk;
  tm = nm;
  td = d;
  for _ in 0..((steps % 6) + 6) % 6 ?? 0 {
    (tk, tm) = (tk - tm, 3 * tk + tm);
    td = 2 * td;
  }
  (tk, tm, td)
}

/// The most common value of `vals`, ties going to the one nearest the mean (`sum / n`).
fn common(vals: const vector<integer>, sum: integer, n: integer) -> integer {
  best = 0;
  best_n = 0;
  for v in vals {
    c = 0;
    for w in vals { if w == v { c += 1; } }
    far = v * n - sum;
    if far < 0 { far = -far; }
    best_far = best * n - sum;
    if best_far < 0 { best_far = -best_far; }
    if c > best_n || c == best_n && far < best_far {
      best = v;
      best_n = c;
    }
  }
  best
}

/// A TOPS wall (heading `h` even) through the run's edges.
// @FR-HW-Tops
pub fn solve_tops(b: const vector<Edge>, run: const vector<integer>, h: integer) -> hex_draw::WallSurface {
  s = (6 - h / 2 ?? 0) % 6 ?? 0;        // turns heading h to 0, due east
  mids: vector<integer> = [];
  sk = 0;
  sm = 0;
  for i in run {
    e = b[i];
    (ak, am) = turned(e.ak, e.am, s);
    (bk, bm) = turned(e.bk, e.bm, s);
    mids += [am + bm];
    sk += ak + bk;
    sm += am + bm;
  }
  n = len(run);
  // Due east, the line is m = common / 2: the point (sk / 2n, common / 2).
  line_m = common(mids, sm, n);
  (nk, nm, d) = turned_q(sk, n * line_m, 2 * n, 6 - s);
  (dk, dm) = hex_form::head_step(h);
  hex_draw::WallSurface { ws_dk: dk, ws_dm: dm, ws_num_k: nk, ws_num_m: nm, ws_den: d, ws_n: n }
}

/// A SIDES wall (heading `h` odd) through the run's edges.
// @FR-HW-Sides
pub fn solve_sides(b: const vector<Edge>, run: const vector<integer>, h: integer) -> hex_draw::WallSurface {
  s = ((3 - h) / 2 ?? 0) % 6 ?? 0;      // turns heading h to 3, due north
  links: vector<integer> = [];
  sk = 0;
  sm = 0;
  lk = 0;
  for i in run {
    e = b[i];
    (ak, am) = turned(e.ak, e.am, s);
    (bk, bm) = turned(e.bk, e.bm, s);
    if ak != bk {
      links += [ak + bk];
      lk += ak + bk;
    }
    sk += ak + bk;
    sm += am + bm;
  }
  n = len(run);
  // Due north, the line is k = common / 2 of the connectors (of every edge, when the run has
  // none: one cell's upright side): the point (common / 2, sm / 2n).
  line_k = if len(links) > 0 { common(links, lk, len(links)) } else { common(links, sk, n) };
  if len(links) == 0 { line_k = sk / n ?? 0; }
  (nk, nm, d) = turned_q(n * line_k, sm, 2 * n, 6 - s);
  (dk, dm) = hex_form::head_step(h);
  hex_draw::WallSurface { ws_dk: dk, ws_dm: dm, ws_num_k: nk, ws_num_m: nm, ws_den: d, ws_n: n }
}

/// The straight wall through a run of wall edges running along heading `h`: a tops wall on an
/// even heading, a sides wall on an odd one.
// @FR-HW-Straight: a wall's direction is its heading's step, exactly
pub fn solve_wall(b: const vector<Edge>, run: const vector<integer>, h: integer) -> hex_draw::WallSurface {
  if hex_form::head_norm(h) % 2 == 0 { solve_tops(b, run, hex_form::head_norm(h)) }
  else { solve_sides(b, run, hex_form::head_norm(h)) }
}

/// The heading a run of the boundary travels along: the way most of its edges travel (`travel`),
/// as a heading of the house (`turn` for +u, three steps on for +v, and so on).
pub fn run_heading(turn: integer, b: const vector<Edge>, run: const vector<integer>) -> integer {
  count = [0, 0, 0, 0];
  for i in run {
    t = travel(turn, b, i);
    if t >= 0 { count[t] += 1; }
  }
  best = 0;
  for t in 1..4 { if count[t] > count[best] { best = t; } }
  hex_form::head_norm(turn + 3 * best)
}

/// The axes a boundary's walls run along, read off the boundary itself: 0 for the headings 0, 3,
/// 6 and 9 (0°, 90°, …), 1 for 1, 4, 7 and 10, 2 for 2, 5, 8 and 11.  Each edge votes for the
/// heading nearest the way the boundary travels round it (`AROUND` edges either side); the axes
/// with the most votes win, and -1 answers a tie: cells that show no direction (the smallest
/// house, one hex and its six neighbours, is the same seven cells at every angle).  Exact: a
/// heading step is √3 or 3 long, so the projections compare as squares, scaled by 9 or 3.
// @FR-HW-Axes, @FR-HX-Size: the axes read off the cells; a tie is cells that show no direction
pub fn axes_of(b: const vector<Edge>) -> integer {
  votes = [0, 0, 0];
  n = len(b);
  for i in 0..n {
    a = b[((i - AROUND) % n + n) % n ?? 0];
    z = b[(i + AROUND) % n ?? 0];
    wk = z.bk - a.ak;
    wm = z.bm - a.am;
    best = -1;
    best_d = 0;
    best_l = 1;
    for h in 0..12 {
      (sk, sm) = hex_form::head_step(h);
      d = dot4(wk, wm, sk, sm);
      if d <= 0 { continue; }
      l = if h % 2 == 0 { 3 } else { 9 };   // the step's length squared, in these units
      // d / √l against best_d / √best_l: d² · best_l against best_d² · l
      if best < 0 || d * d * best_l > best_d * best_d * l {
        best = h;
        best_d = d;
        best_l = l;
      }
    }
    if best >= 0 { votes[best % 3] += 1; }
  }
  if votes[0] > votes[1] && votes[0] > votes[2] { 0 }
  else if votes[1] > votes[0] && votes[1] > votes[2] { 1 }
  else if votes[2] > votes[0] && votes[2] > votes[1] { 2 }
  else { -1 }
}

/// A house from its cells alone: the thin walls, the boundary, the axes it runs along, a run per
/// straight wall and the wall solved for each.  The axes are read off the cells; `hint` (a
/// heading, -1 for none) is asked only when the cells show no direction.
// @FR-HX-Cells, @FR-HX-Editor: the walls from the cells alone, no plan and no angle
pub fn from_cells(cells: hex_field::HexSet, hint: integer = -1) -> Built {
  from_data(cells, no_marks(cells), hint)
}

/// An edge set over the cells' window with nothing marked.
pub fn no_marks(cells: hex_field::HexSet) -> hex_field::EdgeSet {
  hex_field::edgeset_new(hex_field::hexset_q0(cells) - 1, hex_field::hexset_r0(cells) - 1,
                         hex_field::hexset_w(cells) + 2, hex_field::hexset_h(cells) + 2)
}

/// A structure from its data: its cells and the doors and windows marked on its wall edges.  The
/// walls come from the cells alone; the openings are read off the marks, wall by wall.
pub fn from_data(cells: hex_field::HexSet, marks: hex_field::EdgeSet, hint: integer = -1,
                 sz: Sizes = default_sizes()) -> Built {
  edges = no_marks(cells);
  // @FR-HX-Edge: the thin walls the rules use
  hex_draw::draw_walls(cells, edges, WALL);
  b = boundary(cells);
  turn = axes_of(b);
  if turn < 0 { turn = if hint >= 0 { hint % 3 ?? 0 } else { 0 }; }
  rs = runs(turn, b);
  walls: vector<hex_draw::WallSurface> = [for run in rs { solve_wall(b, run, run_heading(turn, b, run)) }];
  corners: vector<(float, float)> = [];
  nw = len(walls);
  for i in 0..nw {
    // @FR-HW-Miter: each wall mitred into the next
    (x, y, _ok) = surface_miter(walls[i], walls[(i + 1) % nw ?? 0]);
    corners += [(x, y)];
  }
  // @FR-HO-Point: the walls are solved first, the openings are points on them
  ops = openings_of(b, rs, walls, marks, sz);
  for o in ops {
    for i in o.edges {
      e = b[i];
      hex_field::edge_set_mat(edges, e.qa, e.ra, e.qb, e.rb, o.kind);
    }
  }
  Built { cells: cells, edges: edges, boundary: b, runs: rs, walls: walls, corners: corners, openings: ops }
}
