// The first climb, as a game: the rules (tile_world), the picture (tiles, Kenney's Tiny packs),
// the sounds (audio, Kenney's sound packs) and the controls (input).  Nothing here knows the
// machine: main.loft hands the picture to `screen` and the keys to `input`.
use tile_world;
use rules;
use tiles;
use audio;
use input;
use imaging;
use theme;
use levels;
use editor;
use camera;
use materials;
use talk;
use motion;
use ui;
use intent;

/// The frame: 13 x 9 cells of 16 pixels for the level, and one row for the status line.  The
/// editor gives a row of the level to its palette.
pub const COLS = 13;
pub const ROWS = 10;
pub const W = 208;
pub const H = 160;

/// Milliseconds a held direction waits before it repeats, and between repeats.
const REPEAT_FIRST = 220;
const REPEAT_NEXT = 140;

// The editor's colours: the cursor, the goal cell, the outline of the layer above, and the
// frame round the palette's picked entry.
const CURSOR = 65535;
const GOAL = 2016;
const ABOVE = 16904;
const PICKED = 65504;
// The intent's outlines over the editor's map.
const INTENT = 64543;
// The checks: a chest cut off from the start, a hidden one.
const CUT_OFF = 63488;
const HIDDEN = 63519;
// A speech bubble: at most this many characters a row; its fill, and its edge for the hero and for
// anyone else (RGB565).
const BUBBLE = 22;
const BUBBLE_FILL = 4228;
const HERO_SAYS = 65120;
const THEY_SAY = 52857;

// Key codes beside the bindings: Ctrl and Shift held.
const KEY_SHIFT = 132;
const KEY_CTRL = 133;

pub struct Game {
  pub world: rules::Level,
  /// The level being played, as its file holds it (name, start, goal).
  pub file: levels::LevelFile,
  /// The level files to play, in order (levels/order.json).
  pub order: vector<text>,
  /// Playing the world (WORLD.md): places joined by doors, from order.json's `start` place.  The
  /// place the hero is in (its file name), the door it came in by, each place left as the hero
  /// left it, the places whose goal the hero has met, and the place as it was when the hero
  /// came in (R goes back to it).
  pub in_world: boolean,
  pub place: text,
  pub entered_by: text,
  places: vector<Visited>,
  solved_places: vector<text>,
  arrived: rules::Level,
  has_arrived: boolean,
  /// The places the save at the last well and the one before it were made in.
  saved_place: text,
  previous_place: text,
  pub surface: integer,
  pub kinds: rules::Kinds,
  /// What the editor paints with, and what level files' legends may name (theme.json's).
  pub mats: materials::Materials,
  pub look: theme::Theme,
  sounds: hash<Sound[sd_name]>,
  pub keys: input::InputState,
  pub level: integer,
  pub moves: integer,
  pub won: boolean,
  held_since: integer,
  next_repeat: integer,
  was_boosted: boolean,
  /// Editing (E) rather than playing; the editor; whether the edit view shows the level's
  /// light (L); a word the status line shows until the next key ("SAVED").
  pub editing: boolean,
  pub ed: editor::Editor,
  /// The editor panel's name field (the level's file name), and whether a field has the
  /// keyboard, so the keys are text and not commands.
  pub name_field: text,
  pub typing: boolean,
  /// Building with the pointer (BROWSER_EDITOR.md § Pass 1): the tool ("", "room", "corridor"),
  /// a drag on the map from one cell to another, the room picked (-1 none), and the words a room
  /// can take (theme.json's).
  pub tool: text,
  pub dragging: boolean,
  drag_from: (integer, integer),
  drag_to: (integer, integer),
  pub room_pick: integer,
  pub words: vector<intent::Word>,
  lit: boolean,
  /// The editor shows the checks (K): the way to a cell goal, chests cut off or hidden.
  pub checking: boolean,
  pub note: text,
  /// The view's top-left cell, and the cells the level sets (for a view that follows).
  pub cam_x: integer,
  pub cam_y: integer,
  area: (integer, integer, integer, integer),
  /// The game's directory: theme.json, assets/ and levels/ are read from it.
  pub dir: text,
  /// The situation saved at the last well, whether there is one, and whether the player has
  /// asked once to go back to it (a second B confirms).
  pub saved: rules::Level,
  pub has_save: boolean,
  asking_back: boolean,
  /// The save before it — a doomed save need not brick a game: just sent back, B twice goes one
  /// well further back, and no further (DESIGN.md § Guards, doors and wells).
  pub previous: rules::Level,
  pub has_previous: boolean,
  just_back: boolean,
  /// How the hero moves on screen (motion.loft), and whether it was moving at the last frame —
  /// one more picture shows it standing still.
  pub motion: motion::Motion,
  was_moving: boolean,
  /// How each enemy moves on screen, by its id, and where and how healthy it was last drawn.
  movers: vector<Mover>,
  /// How far up the layer being drawn is drawn, in pixels: a tile for each layer above layer 0 —
  /// the height of a wall in the pictures (a raised block is a row of wall tops over one row of
  /// wall face).  Fixed per layer, so the world stays still when the hero changes layer.
  lift: integer
}

/// A place the hero has left, as it left it.
struct Visited {
  place: text,
  level: rules::Level
}

/// An enemy as last drawn: its id, its motion, its cell and its health.
struct Mover {
  id: integer,
  motion: motion::Motion,
  x: integer,
  y: integer,
  hp: integer
}

struct Sound {
  const sd_name: text,
  sd_clips: vector<integer>,
  sd_next: integer
}

/// The sound events and how many variants each has in assets/sounds (`<event>_<n>.ogg`).
fn sound_events() -> vector<text> {
  ["step:5", "step_wood:5", "bump:1", "push_rock:3", "push_anvil:2", "cart:3", "wood:3",
   "climb_up:1", "climb_down:1", "potion:1", "strong:1", "weak:1", "win:1", "begin:1",
   "pickup:1", "drop:1", "door_open:1", "chop:1", "chest_open:1", "signpost:1", "fall:2", "game_over:1", "save:1", "restore:1", "point:1", "hit_hero:2", "sword:2", "explosion:3", "bomb_roll:2", "coins:2", "spotted:1", "grab:1"]
}

fn bindings() -> input::Bindings {
  b = input::Bindings {
    bnd_actions: [
      input::ActionBinding { ab_name: "up", ab_keys: [119, 128] },
      input::ActionBinding { ab_name: "down", ab_keys: [115, 129] },
      input::ActionBinding { ab_name: "left", ab_keys: [97, 130] },
      input::ActionBinding { ab_name: "right", ab_keys: [100, 131] },
      input::ActionBinding { ab_name: "pull", ab_keys: [132, 112] },
      input::ActionBinding { ab_name: "drop", ab_keys: [120] },
      input::ActionBinding { ab_name: "swing", ab_keys: [32] },
      input::ActionBinding { ab_name: "aim", ab_keys: [116] },
      input::ActionBinding { ab_name: "back", ab_keys: [98] },
      input::ActionBinding { ab_name: "restart", ab_keys: [114] },
      input::ActionBinding { ab_name: "next", ab_keys: [110, 13] },
      input::ActionBinding { ab_name: "quit", ab_keys: [27, 113] },
      input::ActionBinding { ab_name: "zoom", ab_keys: [109] },
      input::ActionBinding { ab_name: "edit", ab_keys: [101] },
      input::ActionBinding { ab_name: "layer_up", ab_keys: [151] },
      input::ActionBinding { ab_name: "layer_down", ab_keys: [152] },
      input::ActionBinding { ab_name: "palette", ab_keys: [9] },
      input::ActionBinding { ab_name: "paint", ab_keys: [32] },
      input::ActionBinding { ab_name: "erase", ab_keys: [8, 147] },
      input::ActionBinding { ab_name: "start", ab_keys: [104] },
      input::ActionBinding { ab_name: "goal", ab_keys: [103] },
      input::ActionBinding { ab_name: "light", ab_keys: [108] },
      input::ActionBinding { ab_name: "test", ab_keys: [112] },
      input::ActionBinding { ab_name: "undo", ab_keys: [122] },
      input::ActionBinding { ab_name: "redo", ab_keys: [121] },
      input::ActionBinding { ab_name: "save", ab_keys: [115] },
      input::ActionBinding { ab_name: "open", ab_keys: [111] },
      input::ActionBinding { ab_name: "fill", ab_keys: [102] },
      input::ActionBinding { ab_name: "rect", ab_keys: [114] },
      input::ActionBinding { ab_name: "pick", ab_keys: [105] },
      input::ActionBinding { ab_name: "copy", ab_keys: [99] },
      input::ActionBinding { ab_name: "paste", ab_keys: [118] },
      input::ActionBinding { ab_name: "check", ab_keys: [107] },
      input::ActionBinding { ab_name: "raise", ab_keys: [93] },
      input::ActionBinding { ab_name: "lower", ab_keys: [91] }
    ],
    bnd_axes: []
  };
  // `1`..`9`: the editor's palette categories.
  for n in 1..=9 { b.bnd_actions += [input::ActionBinding { ab_name: "category{n}", ab_keys: [48 + n] }]; }
  b
}

/// A new game in directory `dir` (the game's own, "." for main.loft, ".." for a test): its kinds
/// from kinds.json, its look from theme.json (sheets relative to `dir`), its sounds from
/// `dir`/assets/sounds, its levels from `dir`/levels.  Null when the theme or a sheet will not
/// load.
pub fn new_game(dir: text) -> Game? {
  s = tiles::surface(W, H);
  k = rules::kinds();
  theme_text = file("{dir}/theme.json").content() ?? "";
  th = theme::load(theme_text, dir, k);
  mats = materials::load(theme_text, k);
  if !s || !th { return null; }
  blank = levels::LevelFile {
    name: "", camera: "follow", level: rules::level(k), start_x: 0, start_y: 0, start_z: 0,
    goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 }
  };
  ed = editor::new_editor_with(blank, mats);
  empty = rules::level(k);
  g = Game {
    world: rules::level(k),
    file: blank,
    order: level_order(dir),
    in_world: false, place: "", entered_by: "", places: [], solved_places: [], arrived: rules::level(k),
    has_arrived: false, saved_place: "", previous_place: "",
    surface: s ?? 0, kinds: k, mats: mats, look: th ?? return null,
    sounds: [],
    keys: input::input_new(bindings()),
    level: 0, moves: 0, won: false, held_since: 0, next_repeat: 0, was_boosted: false,
    editing: false, ed: ed, name_field: "", typing: false, tool: "", dragging: false, drag_from: (0, 0),
    drag_to: (0, 0), room_pick: -1, words: intent::words_from(theme_text), lit: false, checking: false, note: "",
    cam_x: 0, cam_y: 0, area: (0, 0, 0, 0),
    dir: dir, saved: empty, has_save: false, asking_back: false, previous: empty, has_previous: false,
    just_back: false, motion: motion::still(), was_moving: false, movers: [], lift: 0
  };
  for e in sound_events() {
    parts = e.split(':');
    name = parts[0];
    n = parts[1] as integer ?? 1;
    clips: vector<integer> = [];
    for i in 0..n {
      c = audio::load("{dir}/assets/sounds/{name}_{i}.ogg");
      if c { clips += [c ?? 0]; }
    }
    g.sounds += [Sound { sd_name: name, sd_clips: clips, sd_next: 0 }];
  }
  g
}

/// Play one variant of a sound event, taking the variants in turn.
pub fn sound(g: Game, name: text, volume: float = 0.8) {
  sd = g.sounds[name];
  if !sd { return; }
  n = len(sd.sd_clips);
  if n == 0 { return; }
  i = sd.sd_next % n ?? 0;
  _ = audio::play(sd.sd_clips[i] ?? 0, volume);
  sd.sd_next = i + 1;
}


// The level names levels/order.json lists.
fn level_order(dir: text) -> vector<text> {
  out: vector<text> = [];
  o = json_parse(file("{dir}/levels/order.json").content() ?? "").field("order");
  for i in 0..o.len() { out += [o.item(i).as_text()]; }
  out
}

// The file of level number `level` of the order.
fn level_path(g: const Game, level: integer) -> text {
  "{g.dir}/levels/{g.order[level] ?? ""}.json"
}

// Load level number `level` of the order into `g`, with a fresh editor on it; false when its
// file does not load.
fn load_level(g: Game, level: integer) -> boolean {
  open_place(g, g.order[level] ?? "")
}

// Load the file of place `name` (levels/<name>.json) into `g`, with a fresh editor on it — the
// file only: what is played, `g.world`, is left as it is.  False when it does not load.
fn open_place(g: Game, name: text) -> boolean {
  m = levels::load_with(file("{g.dir}/levels/{name}.json").content() ?? "", g.kinds, g.mats);
  if !m { return false; }
  g.file = m;
  g.place = name;
  g.level = -1;
  for i in 0..len(g.order) { if g.order[i] == name { g.level = i; } }
  g.ed = editor::new_editor_with(g.file, g.mats);
  g.name_field = name;
  true
}

/// The place the game starts in: order.json's `start`, "demo" when it names none.  A world is
/// the places reached from its start place through doors, so another start is another world:
/// the demo village, with a house for each mechanic's room, stays one beside the game's own.
pub fn start_place(dir: text) -> text {
  v = json_parse(file("{dir}/levels/order.json").content() ?? "").field("start");
  if v.kind() == "JString" { v.as_text() } else { "demo" }
}

// Where place `name` is in the places the hero has left, -1 when it has not been there.
fn visited(g: const Game, name: text) -> integer {
  for i in 0..len(g.places) { if g.places[i].place == name { return i; } }
  -1
}

// Keep the place being played as it is now, for when the hero comes back.
fn stash(g: Game) {
  i = visited(g, g.place);
  if i >= 0 {
    g.places[i].level = g.world;
  } else {
    g.places += [Visited { place: g.place, level: g.world }];
  }
}

/// Play the world that starts at place `place` (a file in levels/), from that place's start
/// cell.  False when the place does not load.
pub fn start_world(g: Game, place: text) -> boolean {
  if !open_place(g, place) { return false; }
  g.in_world = true;
  g.places = [];
  g.solved_places = [];
  g.entered_by = "";
  g.has_arrived = false;
  restart(g);
  g.arrived = g.world;
  g.has_arrived = true;
  true
}

/// The hero steps through door `i` of the place it is in: into the place the door leads to, as
/// the hero left it when it was there before, standing just outside the door there and facing
/// away from it, with what it holds, its health and its money.  False (and nothing changed)
/// when that place does not load; a door there that does not exist puts the hero at the
/// place's start.
pub fn go_through(g: Game, i: integer) -> boolean {
  if i < 0 || i >= len(g.file.doors) { return false; }
  to = g.file.doors[i]!.to;
  there = g.file.doors[i]!.door;
  m = levels::load_with(file("{g.dir}/levels/{to}.json").content() ?? "", g.kinds, g.mats);
  if !m { return false; }
  // Leaving the place is walking away from whoever is talking.
  for t in g.file.talks {
    o = talk::owner(t, g.world);
    if o >= 0 && talk::current(g.world, o) >= 0 { talk::walked_away(t, g.world, o); }
  }
  c = rules::carried(g.world);
  stash(g);
  _ = open_place(g, to);
  j = visited(g, to);
  if j >= 0 {
    for v in g.places { if v.place == to { g.world = v.level; } }
  } else {
    g.world = g.file.level;
  }
  rules::carry_in(g.world, c);
  k = levels::door_named(g.file, there);
  if k >= 0 {
    dx = g.file.doors[k]!.x;
    dy = g.file.doors[k]!.y;
    dz = g.file.doors[k]!.z;
    side = levels::out_of(g.file, g.world, k);
    rules::put_hero(g.world, dx + side.0, dy + side.1, dz);
    if side.0 != 0 || side.1 != 0 {
      g.world.face_x = side.0;
      g.world.face_y = side.1;
    }
  } else {
    rules::put_hero(g.world, g.file.start_x, g.file.start_y, g.file.start_z);
  }
  g.entered_by = there;
  g.arrived = g.world;
  g.has_arrived = true;
  g.motion = motion::still();
  g.movers = [];
  g.asking_back = false;
  g.just_back = false;
  g.note = "";
  g.area = camera::bounds(g.world.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
  aim(g);
  sound(g, "door_open");
  true
}

// A level's file name from what was typed: lower-case letters, digits, `_` and `-`; spaces as
// `_`; anything else left out.
fn file_name(typed: text) -> text {
  out = "";
  for c in typed {
    n = c as integer;
    if n >= 65 && n <= 90 { out += "{(n + 32) as character}"; }
    else if (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45 { out += "{c}"; }
    else if n == 32 { out += "_"; }
  }
  out
}

/// Write the level being edited as `levels/<name>.json`, and add the name to `order.json` when it
/// is new; the level is then that one.  False for a name with nothing left in it, or a file that
/// could not be written.
pub fn save_as(g: Game, typed: text) -> boolean {
  name = file_name(typed);
  if name == "" { return false; }
  at = -1;
  for i in 0..len(g.order) { if g.order[i] == name { at = i; } }
  if at < 0 {
    g.order += [name];
    at = len(g.order) - 1;
    names = "";
    for n in g.order { names += if names == "" { "\"{n}\"" } else { ", \"{n}\"" }; }
    if !file("{g.dir}/levels/order.json").write("{{ \"order\": [{names}] }}\n").ok() { return false; }
  }
  g.level = at;
  g.name_field = name;
  save(g)
}

/// Start an empty place to build in, named "new_place" until it is saved under a name.
pub fn new_place(g: Game) {
  k = g.kinds;
  g.file = levels::LevelFile {
    name: "a new place", camera: "follow", level: rules::level(k), start_x: 1, start_y: 1, start_z: 0,
    goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 }
  };
  for t in g.mats.track { rules::add_piece(g.file.level, t.tile, t.joins, t.toe, t.straight, t.turn, t.set_turn, t.twin); }
  g.ed = editor::new_editor_with(g.file, g.mats);
  g.name_field = "new_place";
  g.room_pick = -1;
  g.note = "";
  aim_editor(g);
}

/// Fill the place in from its intent, as the editor shows it: the cells set by hand kept.
pub fn fill_in(g: Game) -> boolean {
  editor::refill(g.ed, g.file, g.words)
}

// The map cell under (ux, uy), the view's units, as the editor draws its cells.
fn cell_under(g: const Game, ux: float, uy: float) -> (integer, integer) {
  ts = g.look.tile_size as float;
  (g.cam_x + (floor((ux / ts)!) as integer), g.cam_y + (floor((uy / ts)!) as integer))
}

/// The pointer on the editor's map, where the widgets did not take it, at (ux, uy) in the view's
/// units with the button `down` now and `was_down` the frame before.  With the ROOM tool a drag
/// from one cell to another draws a room there (its outline the two corners), and a click inside
/// a room picks it; with CORRIDOR a drag runs a corridor.  What is drawn is filled in at once.
/// Answers whether the picture changed.
pub fn editor_map_pointer(g: Game, ux: float, uy: float, down: boolean, was_down: boolean) -> boolean {
  if g.tool == "" { return false; }
  at = cell_under(g, ux, uy);
  if down && !was_down {
    g.dragging = true;
    g.drag_from = at;
    g.drag_to = at;
    return true;
  }
  if down && g.dragging {
    moved = at.0 != g.drag_to.0 || at.1 != g.drag_to.1;
    g.drag_to = at;
    return moved;
  }
  if !g.dragging { return false; }
  g.dragging = false;
  a = g.drag_from;
  b = at;
  x0 = if a.0 < b.0 { a.0 } else { b.0 };
  y0 = if a.1 < b.1 { a.1 } else { b.1 };
  w = (if a.0 > b.0 { a.0 - b.0 } else { b.0 - a.0 }) + 1;
  h = (if a.1 > b.1 { a.1 - b.1 } else { b.1 - a.1 }) + 1;
  z = g.ed.z;
  if g.tool == "room" {
    if w == 1 && h == 1 {
      g.room_pick = -1;
      for i in 0..len(g.file.intent.rooms) {
        r = g.file.intent.rooms[i];
        if r.z == z && a.0 >= r.x && a.1 >= r.y && a.0 < r.x + r.w && a.1 < r.y + r.h { g.room_pick = i; }
      }
      return true;
    }
    if w < 3 || h < 3 {
      g.note = "A ROOM IS 3 BY 3 OR MORE";
      return true;
    }
    g.file.intent.rooms += [intent::Room { x: x0, y: y0, w: w, h: h, z: z, words: [] }];
    g.room_pick = len(g.file.intent.rooms) - 1;
  } else if g.tool == "corridor" {
    if w == 1 && h == 1 { return true; }
    g.file.intent.corridors += [intent::Corridor { x0: a.0, y0: a.1, x1: b.0, y1: b.1, z: z }];
  }
  _ = fill_in(g);
  true
}

// The intent over the editor's map: each room's outline on this layer (the picked one in the
// picked colour), each corridor's way, and a drag in progress.
fn draw_intent(g: Game) {
  ts = g.look.tile_size;
  z = g.ed.z;
  for i in 0..len(g.file.intent.rooms) {
    r = g.file.intent.rooms[i];
    if r.z != z { continue; }
    tiles::frame(g.surface, (r.x - g.cam_x) * ts, (r.y - g.cam_y) * ts, r.w * ts, r.h * ts,
                 if i == g.room_pick { PICKED } else { INTENT });
  }
  for c in g.file.intent.corridors {
    if c.z != z { continue; }
    mid = ts / 2 - 1;
    xa = if c.x0 < c.x1 { c.x0 } else { c.x1 };
    xb = if c.x0 < c.x1 { c.x1 } else { c.x0 };
    ya = if c.y0 < c.y1 { c.y0 } else { c.y1 };
    yb = if c.y0 < c.y1 { c.y1 } else { c.y0 };
    tiles::rect(g.surface, (xa - g.cam_x) * ts + mid, (c.y0 - g.cam_y) * ts + mid, (xb - xa) * ts + 2, 2, INTENT);
    tiles::rect(g.surface, (c.x1 - g.cam_x) * ts + mid, (ya - g.cam_y) * ts + mid, 2, (yb - ya) * ts + 2, INTENT);
  }
  if g.dragging && g.tool != "" {
    a = g.drag_from;
    b = g.drag_to;
    x0 = if a.0 < b.0 { a.0 } else { b.0 };
    y0 = if a.1 < b.1 { a.1 } else { b.1 };
    w = (if a.0 > b.0 { a.0 - b.0 } else { b.0 - a.0 }) + 1;
    h = (if a.1 > b.1 { a.1 - b.1 } else { b.1 - a.1 }) + 1;
    tiles::frame(g.surface, (x0 - g.cam_x) * ts, (y0 - g.cam_y) * ts, w * ts, h * ts, CURSOR);
  }
}

/// The editor's panel, for a screen with a pointer, at the right of a UI `width` units wide: the
/// level's name, saved under it (SAVE or Enter), the levels to open, and PLAY.  Answers whether
/// the level or the view changed.
pub fn editor_panel(g: Game, u: ui::Ui, width: float) -> boolean {
  x = width - 124.0;
  y = 4.0;
  changed = false;
  ui::panel(u, x, y, 120.0, 176.0 + 14.0 * (len(g.words) as float) + 30.0);
  ui::label(u, x + 4.0, y + 4.0, "LEVEL");
  if ui::button(u, "new", x + 76.0, y + 2.0, 40.0, 11.0, "NEW") {
    new_place(g);
    return true;
  }
  entered = ui::field(u, "name", x + 4.0, y + 14.0, 112.0, 12.0, g.name_field);
  if ui::button(u, "save", x + 4.0, y + 30.0, 54.0, 12.0, "SAVE") || entered {
    g.note = if save_as(g, g.name_field) { "SAVED" } else { "NOT SAVED!" };
    changed = true;
  }
  if ui::button(u, "play", x + 62.0, y + 30.0, 54.0, 12.0, "PLAY") {
    toggle_editor(g);
    return true;
  }
  ui::label(u, x + 4.0, y + 48.0, "LEVELS");
  pick = g.level;
  if ui::list(u, "levels", x + 4.0, y + 58.0, 112.0, 94.0, g.order, pick) {
    if load_level(g, pick) {
      g.note = g.order[pick] ?? "";
      aim_editor(g);
    }
    changed = true;
  }
  // Building: the tools, the picked room's words, filling in, and taking a room away.
  by = y + 158.0;
  ui::label(u, x + 4.0, by, "BUILD");
  if ui::button(u, "tool_room", x + 4.0, by + 10.0, 54.0, 12.0, if g.tool == "room" { "*ROOM" } else { "ROOM" }) {
    g.tool = if g.tool == "room" { "" } else { "room" };
    changed = true;
  }
  if ui::button(u, "tool_corridor", x + 62.0, by + 10.0, 54.0, 12.0, if g.tool == "corridor" { "*HALL" } else { "HALL" }) {
    g.tool = if g.tool == "corridor" { "" } else { "corridor" };
    changed = true;
  }
  wy = by + 26.0;
  picked = g.room_pick >= 0 && g.room_pick < len(g.file.intent.rooms);
  for wd in g.words {
    has = picked && g.file.intent.rooms[g.room_pick]!.words.contains(wd.name);
    if ui::button(u, "word_{wd.name}", x + 4.0, wy, 112.0, 12.0, if has { "*{wd.name}" } else { wd.name }) && picked {
      r = g.file.intent.rooms[g.room_pick]!;
      if has {
        kept: vector<text> = [];
        for w in r.words { if w != wd.name { kept += [w]; } }
        r.words = kept;
      } else {
        r.words += [wd.name];
      }
      _ = fill_in(g);
      changed = true;
    }
    wy += 14.0;
  }
  if ui::button(u, "fill", x + 4.0, wy, 54.0, 12.0, "FILL") {
    g.note = if fill_in(g) { "FILLED IN" } else { "NOTHING TO FILL" };
    changed = true;
  }
  if ui::button(u, "drop_room", x + 62.0, wy, 54.0, 12.0, "DROP") && picked {
    rooms: vector<intent::Room> = [];
    for i in 0..len(g.file.intent.rooms) { if i != g.room_pick { rooms += [g.file.intent.rooms[i]]; } }
    g.file.intent.rooms = rooms;
    g.room_pick = -1;
    changed = true;
  }
  g.typing = ui::typing(u);
  changed
}

/// The theme's font for the widgets.
pub fn ui_font(g: const Game) -> ui::Font {
  theme::ui_font(g.look)
}

fn solved(g: const Game) -> boolean {
  levels::solved(g.file, g.world)
}

/// Play level number `level` of the order from its start, as its file holds it.
pub fn start_level(g: Game, level: integer) {
  g.in_world = false;
  g.has_arrived = false;
  _ = load_level(g, level);
  restart(g);
}

/// Start the level again, as the file in memory holds it: the editor's edits included, and
/// the played copy dropped.  (`g.world = g.file.level` copies: an assignment into a field.)
/// In the world, the place as it was when the hero came in, the hero as it came.
pub fn restart(g: Game) {
  g.note = "";
  g.has_save = false;
  g.asking_back = false;
  g.has_previous = false;
  g.just_back = false;
  g.motion = motion::still();
  g.movers = [];
  if g.in_world && g.has_arrived {
    g.world = g.arrived;
  } else {
    g.world = g.file.level;
    rules::put_hero(g.world, g.file.start_x, g.file.start_y, g.file.start_z);
  }
  g.area = camera::bounds(g.world.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
  aim(g);
  g.moves = 0;
  g.won = false;
  g.was_boosted = false;
  sound(g, "begin");
}

// The sound a move makes, from what stood where the hero went before it moved.
fn move_sound(g: Game, step: rules::Step, thing: integer, z_before: integer) {
  w = g.world;
  if step == rules::Step.Blocked || step == rules::Step.Watched || step == rules::Step.Struggled {
    sound(g, "bump", 0.5);
  } else if step == rules::Step.Took {
    sound(g, "pickup");
  } else if step == rules::Step.Chopped {
    sound(g, "chop");
  } else if step == rules::Step.Dipped {
    sound(g, "potion");
  } else if step == rules::Step.Lit {
    sound(g, "point");
  } else if step == rules::Step.Leaned {
    sound(g, "step_wood", 0.3);
  } else if step == rules::Step.Opened {
    sound(g, if thing == 0 { "door_open" } else { "chest_open" });
  } else if step == rules::Step.Fell {
    sound(g, if rules::alive(w) { "fall" } else { "game_over" }, 1.0);
  } else if step == rules::Step.Saved {
    sound(g, "save");
  } else if step == rules::Step.Read {
    sound(g, "signpost");
  } else if step == rules::Step.Placed {
    sound(g, "drop");
  } else if step == rules::Step.Climbed {
    sound(g, if w.hero_z > z_before { "climb_up" } else { "climb_down" });
  } else if step == rules::Step.Pushed || step == rules::Step.Pulled {
    snd = theme::thing_sound(g.look, thing);
    sound(g, if snd == "" { "wood" } else { snd });
  } else {
    sound(g, if w.hero_h > 0 { "step_wood" } else { "step" }, 0.6);
  }
}

/// One move: walk (or pull, with `pull`) one cell.  Plays its sound and counts it.
pub fn move(g: Game, dx: integer, dy: integer, pull: boolean) {
  if g.won { return; }
  g.note = "";
  g.asking_back = false;
  g.just_back = false;
  w = g.world;
  z = w.hero_z;
  // What the move will act on: the thing ahead for a push, the thing behind for a pull.
  thing = if pull {
    tile_world::top(w.w, w.hero_x - dx, w.hero_y - dy, z)
  } else {
    tile_world::top(w.w, w.hero_x + dx, w.hero_y + dy, z)
  };
  ox = w.hero_x;
  oy = w.hero_y;
  oz = w.hero_z;
  oh = w.hero_h;
  health = w.health + w.spirit;
  money = w.money;
  step = if pull { rules::pull(w, dx, dy) } else { rules::walk(w, dx, dy) };
  if w.health + w.spirit > health { sound(g, "potion"); }
  if w.money > money { sound(g, "coins"); }
  animate(g, step, ox, oy, oz, oh, dx, dy);
  if step == rules::Step.Read { g.note = chests_left(rules::closed(w)); }
  if step == rules::Step.Talked { talk_to(g, g.world.talk_to); }
  if step == rules::Step.Saved {
    if g.has_save {
      g.previous = g.saved;
      g.previous_place = g.saved_place;
      g.has_previous = true;
    }
    g.saved = g.world;
    g.saved_place = g.place;
    g.has_save = true;
    g.note = "SAVED";
  }
  if step != rules::Step.Blocked { g.moves += 1; }
  move_sound(g, step, thing, z);
  if !g.was_boosted && rules::boosted(w) {
    sound(g, "potion");
    sound(g, "strong");
  }
  if solved(g) {
    // In the world a place's goal is met once and play goes on; a level on its own is done.
    if !g.in_world {
      g.won = true;
      sound(g, "win", 1.0);
    } else if !g.solved_places.contains(g.place) {
      g.solved_places += [g.place];
      g.note = "SOLVED!";
      sound(g, "win", 1.0);
    }
  }
  // With no health left, the hero is back at the last well — when it drank from one.
  if !rules::alive(g.world) && g.has_save { return_to_save(g); }
  _ = step_talks(g);
  // A step onto a door takes the hero through it, to the place it leads to.
  moved = g.world.hero_x != ox || g.world.hero_y != oy || g.world.hero_z != oz;
  door = levels::door_at(g.file, g.world.hero_x, g.world.hero_y, g.world.hero_z);
  if moved && door >= 0 && rules::alive(g.world) && go_through(g, door) { return; }
  aim(g);
}

/// The hero swings what it holds at the cell it faces (rules::swing): a blow or a swing through
/// the air is seen and heard, and counts as a move; without a weapon nothing happens.
pub fn swing(g: Game) {
  if g.won { return; }
  // A bow shoots: at its locked target, else the way the hero faces.
  if rules::armed_with_bow(g.world) {
    hp = 0;
    for e in g.world.enemies { hp += e.hp; }
    n = len(g.world.enemies);
    if rules::shoot(g.world) == rules::Step.Shot {
      g.moves += 1;
      motion::swing(g.motion, g.world.now);
      sound(g, "sword", 0.4);
      after = 0;
      for e in g.world.enemies { after += e.hp; }
      if after < hp || len(g.world.enemies) < n { sound(g, "hit_enemy", 0.8); }
    }
    return;
  }
  // A bomb in hand is thrown: it rolls off the way the hero faces.
  if rules::throw(g.world) == rules::Step.Thrown {
    g.moves += 1;
    motion::swing(g.motion, g.world.now);
    sound(g, "bomb_roll", 0.6);
    return;
  }
  step = rules::swing(g.world);
  if step == rules::Step.Chopped || step == rules::Step.Swung || step == rules::Step.Attacked {
    g.moves += 1;
    motion::swing(g.motion, g.world.now);
    sound(g, if step == rules::Step.Chopped { "chop" } else if step == rules::Step.Attacked { "hit_enemy" } else { "sword" }, 0.6);
  }
}

// How the hero moves on screen after `step`, taken from (ox, oy, oz) at height oh, trying
// (dx, dy): a step glides there hopping (a fall or a change of layer shows at once); a bump
// staggers it back; a blow (an axe into a tree) is a swing.
fn animate(g: Game, step: rules::Step, ox: integer, oy: integer, oz: integer, oh: integer, dx: integer,
           dy: integer) {
  w = g.world;
  now = w.now;
  if step == rules::Step.Blocked {
    motion::stagger(g.motion, now, -dx, -dy, 0, 0, w.face_x, w.face_y);
  } else if step == rules::Step.Chopped || step == rules::Step.Swung || step == rules::Step.Attacked {
    motion::swing(g.motion, now);
    if step == rules::Step.Attacked { sound(g, "hit_enemy", 0.8); }
  } else if step == rules::Step.Fell {
    g.motion = motion::still();
  } else if w.hero_x != ox || w.hero_y != oy || w.hero_z != oz {
    // A step glides — up or down a slope, and onto another layer, a tile a layer.
    motion::walk(g.motion, now, w.hero_x - ox, w.hero_y - oy,
                 (w.hero_h - oh) * 4 + (w.hero_z - oz) * g.look.tile_size, w.face_x, w.face_y);
  }
}

// The situation saved at the last well, back: the world, the hero, its health.
fn return_to_save(g: Game) {
  back_to_place(g, g.saved_place);
  g.world = g.saved;
  g.motion = motion::still();
  g.movers = [];
  g.asking_back = false;
  g.just_back = true;
  g.note = "BACK AT WELL";
  sound(g, "restore");
  aim(g);
}

// Back to a save made in place `name`: when the hero is elsewhere in the world, the place it is
// in is kept as it is now and that place's file is opened.
fn back_to_place(g: Game, name: text) {
  if !g.in_world || name == g.place || name == "" { return; }
  stash(g);
  _ = open_place(g, name);
  g.area = camera::bounds(g.saved.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
}

// Just sent back to a save that may be doomed: one well further back, which becomes the save —
// there is none before it.
fn return_to_previous(g: Game) {
  g.saved = g.previous;
  g.saved_place = g.previous_place;
  g.has_previous = false;
  back_to_place(g, g.saved_place);
  g.world = g.saved;
  g.motion = motion::still();
  g.movers = [];
  g.asking_back = false;
  g.just_back = true;
  g.note = "BACK AT EARLIER WELL";
  sound(g, "restore");
  aim(g);
}

/// The player asks to go back to the last well: the first ask only asks ("BACK? B AGAIN"), the
/// second goes.  Answers whether anything changed; false when there is no save.
pub fn back(g: Game) -> boolean {
  if !g.has_save { return false; }
  if !g.asking_back {
    g.asking_back = true;
    g.note = if g.just_back && g.has_previous { "EARLIER? B AGAIN" } else { "BACK? B AGAIN" };
    return true;
  }
  if g.just_back && g.has_previous { return_to_previous(g); } else { return_to_save(g); }
  true
}

// Point the view at the hero, the way the level's file says: "rooms" a screen at a time,
// "follow" a cell at a time near the edge, within the level.
fn aim(g: Game) {
  w = g.world;
  rows = ROWS - 1;
  if g.file.camera == "rooms" {
    g.cam_x = camera::rooms(w.hero_x, COLS, g.area.0);
    g.cam_y = camera::rooms(w.hero_y - w.hero_z, rows, g.area.1 - w.hero_z);
  } else {
    g.cam_x = camera::follow(g.cam_x, w.hero_x, COLS, g.area.0, g.area.2);
    // A raised layer is drawn a row up per layer: the view may go that much higher.
    g.cam_y = camera::follow(g.cam_y, w.hero_y - w.hero_z, rows, g.area.1 - w.hero_z, g.area.3);
  }
}

// The direction held this tick, (0, 0) when none or when a held one is waiting to repeat:
// the first press steps at once, a held one after REPEAT_FIRST and then every REPEAT_NEXT.
fn direction(g: Game, now: integer) -> (integer, integer) {
  dx = 0;
  dy = 0;
  if g.keys.is_action_pressed("left") { dx = -1; }
  if g.keys.is_action_pressed("right") { dx = 1; }
  if g.keys.is_action_pressed("up") { dy = -1; }
  if g.keys.is_action_pressed("down") { dy = 1; }
  if dx != 0 && dy != 0 { dy = 0; }
  if dx == 0 && dy == 0 {
    g.held_since = 0;
    return (0, 0);
  }
  first = g.keys.is_action_just_pressed("left") || g.keys.is_action_just_pressed("right")
          || g.keys.is_action_just_pressed("up") || g.keys.is_action_just_pressed("down");
  if first {
    g.held_since = now;
    g.next_repeat = now + REPEAT_FIRST;
  } else if now < g.next_repeat {
    return (0, 0);
  } else {
    g.next_repeat = now + REPEAT_NEXT;
  }
  (dx, dy)
}

/// Switch between playing and editing.  Leaving the editor play-tests: the level as edited,
/// from the hero's start, on a copy.
pub fn toggle_editor(g: Game) {
  if g.editing {
    g.editing = false;
    // In the world the place as edited, from its start; the other places stay as they were.
    if g.in_world {
      kept: vector<Visited> = [];
      for v in g.places { if v.place != g.place { kept += [v]; } }
      g.places = kept;
      g.has_arrived = false;
      restart(g);
      g.arrived = g.world;
      g.has_arrived = true;
      return;
    }
    restart(g);
    return;
  }
  g.editing = true;
  g.lit = false;
  g.note = "";
  aim_editor(g);
}

// Keep the cursor in sight, one cell from the view's edge.
fn aim_editor(g: Game) {
  g.cam_x = camera::keep(g.cam_x, g.ed.x, COLS, 1);
  // A layer is drawn a row higher: the view keeps the cursor's row on screen.
  g.cam_y = camera::keep(g.cam_y, g.ed.y - g.ed.z, ROWS - 2, 1);
}

/// One editor action by word, as a key would do it: `w` `a` `s` `d` move the cursor, `up` and
/// `down` change layer, `tab` and `back` walk the palette, `paint`, `erase`, `start`, `goal`,
/// `light`, `undo` and `redo`.  For scripts and pictures (main.loft's TW_EDIT); an unknown word
/// does nothing.
pub fn edit(g: Game, word: text) {
  if word == "w" { editor::move(g.ed, 0, -1); }
  else if word == "a" { editor::move(g.ed, -1, 0); }
  else if word == "s" { editor::move(g.ed, 0, 1); }
  else if word == "d" { editor::move(g.ed, 1, 0); }
  else if word == "up" { editor::layer(g.ed, 1); }
  else if word == "down" { editor::layer(g.ed, -1); }
  else if word == "tab" { editor::choose(g.ed, 1); }
  else if word == "back" { editor::choose(g.ed, -1); }
  else if word == "fill" { _ = editor::fill(g.ed, g.file); }
  else if word == "mark" { editor::set_mark(g.ed); }
  else if word == "box" { _ = editor::paint_box(g.ed, g.file); }
  else if word == "pick" { _ = editor::pick_under(g.ed, g.file); }
  else if word == "copy" { editor::copy_box(g.ed, g.file); }
  else if word == "paste" { _ = editor::paste_box(g.ed, g.file); }
  else if word == "check" { g.checking = !g.checking; }
  else if word.starts_with("cat") { _ = editor::jump(g.ed, g.kinds, word[3..] as integer ?? 0); }
  else if word == "paint" { _ = editor::paint(g.ed, g.file); }
  else if word == "erase" { _ = editor::erase(g.ed, g.file); }
  else if word == "raise" { _ = editor::raise(g.ed, g.file, 1); }
  else if word == "lower" { _ = editor::raise(g.ed, g.file, -1); }
  else if word == "start" { _ = editor::set_start(g.ed, g.file); }
  else if word == "goal" { _ = editor::set_goal(g.ed, g.file); }
  else if word == "light" { g.lit = !g.lit; }
  else if word == "undo" { _ = editor::undo(g.ed, g.file); }
  else if word == "redo" { _ = editor::redo(g.ed, g.file); }
  aim_editor(g);
}

/// Write the level being edited to its file.  False when it could not be written.
pub fn save(g: Game) -> boolean {
  g.file.adjusted = editor::adjusted(g.ed, g.file);
  file(level_path(g, g.level)).write(levels::save_with(g.file, g.mats)).ok()
}

// The palette category key pressed this tick (`1`..`9`), 0 for none.
fn category_pressed(k: const input::InputState) -> integer {
  for n in 1..=9 {
    if k.is_action_just_pressed("category{n}") { return n; }
  }
  0
}

// The editor's keys this tick (EDITOR.md § 4).  Answers whether the picture changed.
fn update_editor(g: Game, now: integer) -> boolean {
  k = g.keys;
  if k.is_key_down(KEY_CTRL) {
    if k.is_action_just_pressed("undo") {
      g.note = if editor::undo(g.ed, g.file) { "" } else { "NOTHING TO UNDO" };
    } else if k.is_action_just_pressed("redo") {
      g.note = if editor::redo(g.ed, g.file) { "" } else { "NOTHING TO REDO" };
    } else if k.is_action_just_pressed("save") {
      g.note = if save(g) { "SAVED" } else { "NOT SAVED!" };
    } else if k.is_action_just_pressed("open") {
      if load_level(g, (g.level + 1) % len(g.order) ?? 0) { g.note = g.file.name; }
    } else {
      return false;
    }
    aim_editor(g);
    return true;
  }
  if k.is_action_just_pressed("test") {
    toggle_editor(g);
    return true;
  }
  changed = true;
  if k.is_action_just_pressed("layer_up") { editor::layer(g.ed, 1); }
  else if k.is_action_just_pressed("layer_down") { editor::layer(g.ed, -1); }
  else if k.is_action_just_pressed("palette") { editor::choose(g.ed, if k.is_key_down(KEY_SHIFT) { -1 } else { 1 }); }
  else if k.is_action_just_pressed("paint") { _ = editor::paint(g.ed, g.file); }
  else if k.is_action_just_pressed("erase") { _ = editor::erase(g.ed, g.file); }
  else if k.is_action_just_pressed("raise") { _ = editor::raise(g.ed, g.file, 1); }
  else if k.is_action_just_pressed("lower") { _ = editor::raise(g.ed, g.file, -1); }
  else if k.is_action_just_pressed("start") { _ = editor::set_start(g.ed, g.file); }
  else if k.is_action_just_pressed("goal") { _ = editor::set_goal(g.ed, g.file); }
  else if k.is_action_just_pressed("light") { g.lit = !g.lit; }
  else if k.is_action_just_pressed("fill") { _ = editor::fill(g.ed, g.file); }
  else if k.is_action_just_pressed("rect") {
    if g.ed.marked { _ = editor::paint_box(g.ed, g.file); } else { editor::set_mark(g.ed); }
  }
  else if k.is_action_just_pressed("pick") { _ = editor::pick_under(g.ed, g.file); }
  else if k.is_action_just_pressed("copy") { editor::copy_box(g.ed, g.file); }
  else if k.is_action_just_pressed("paste") { _ = editor::paste_box(g.ed, g.file); }
  else if k.is_action_just_pressed("check") { g.checking = !g.checking; }
  else if category_pressed(k) > 0 { _ = editor::jump(g.ed, g.kinds, category_pressed(k)); }
  else {
    d = direction(g, now);
    if d.0 == 0 && d.1 == 0 { return false; }
    editor::move(g.ed, d.0, d.1);
  }
  g.note = "";
  aim_editor(g);
  changed
}

// What a signpost says: how many chests are still closed.
fn chests_left(n: integer) -> text {
  if n == 0 { return "ALL OPEN!"; }
  if n == 1 { return "1 CHEST LEFT"; }
  "{n} CHESTS LEFT"
}

/// Advance the world's clock by `ms` and read the keys of this tick (already fed into
/// `g.keys`); `now` is the time in milliseconds.  Answers whether the picture changed, and
/// false for "quit" through `g.won`... see `quit`.
pub fn update(g: Game, ms: integer, now: integer) -> boolean {
  // A field has the keyboard: the keys are text, not commands.
  if g.typing { return false; }
  if g.keys.is_action_just_pressed("edit") {
    toggle_editor(g);
    return true;
  }
  if g.editing { return update_editor(g, now); }
  changed = false;
  frame = g.world.now / theme::FRAME_MS;
  held = g.world.hero_item;
  flames = len(g.world.flames);
  rolled = g.world.rolled;
  blasted = g.world.blasted;
  spotted = g.world.spotted;
  hurled = g.world.hurled;
  struck = g.world.struck;
  held_by = g.world.held_by;
  health = g.world.health + g.world.spirit;
  hx = g.world.hero_x;
  hy = g.world.hero_y;
  rules::tick(g.world, ms);
  if step_talks(g) { changed = true; }
  // A rolling cart is heard before it is seen: every cell it rolls rumbles; a hit hurts.
  if g.world.rolled != rolled {
    sound(g, "cart", 0.5);
    changed = true;
  }
  // A cyclops that spots the hero shouts.
  if g.world.spotted != spotted { sound(g, "spotted", 1.0); }
  // A cyclops's bomb is heard rolling; its hands grabbing the hero are heard too.
  if g.world.hurled != hurled { sound(g, "bomb_roll", 0.6); }
  // A blow remembered while the hero recovered lands now: it swings.
  if g.world.struck != struck {
    motion::swing(g.motion, g.world.now);
    sound(g, "sword", 0.6);
    changed = true;
  }
  if g.world.held_by != 0 && held_by == 0 { sound(g, "grab", 1.0); }
  // A blast is heard, however far; while bombs roll and blasts flash the picture moves.
  if g.world.blasted != blasted {
    sound(g, "explosion", 1.0);
    changed = true;
  }
  if rules::blasting(g.world) || len(g.world.enemies) > 0 || g.world.aiming { changed = true; }
  if g.world.health + g.world.spirit < health {
    sound(g, "hit_hero", 1.0);
    changed = true;
    // A bite: the enemies beside the hero, facing it, lunge.
    for e in g.world.enemies {
      if e.z == g.world.hero_z && e.x + e.face_x == g.world.hero_x && e.y + e.face_y == g.world.hero_y {
        for i in 0..len(g.movers) {
          if (g.movers[i].id ?? 0) == e.id { motion::swing(g.movers[i].motion, g.world.now); }
        }
      }
    }
    // Hit: the hero staggers — shoved aside, it glides there staggering the way it was shoved.
    mx = g.world.hero_x - hx;
    my = g.world.hero_y - hy;
    kx = if mx != 0 || my != 0 { mx } else { -g.world.face_x };
    ky = if mx != 0 || my != 0 { my } else { -g.world.face_y };
    motion::stagger(g.motion, g.world.now, kx, ky, mx, my, g.world.face_x, g.world.face_y);
    // Run down by a cart with no health left: back at the last well, as after a fall.
    if !rules::alive(g.world) && g.has_save { return_to_save(g); }
  }
  // A flame flickers (its next frame), burns low or burns out: the picture moves.
  if rules::burning(g.world) && g.world.now / theme::FRAME_MS != frame { changed = true; }
  if len(g.world.flames) != flames { changed = true; }
  if held != g.world.hero_item {
    sound(g, "weak");
    changed = true;
  }
  boosted = rules::boosted(g.world);
  if g.was_boosted && !boosted { sound(g, "weak"); changed = true; }
  if g.was_boosted != boosted { changed = true; }
  g.was_boosted = boosted;
  if g.keys.is_action_just_pressed("restart") {
    restart(g);
    return true;
  }
  // On screen the hero moves until its act is over, and is drawn once more standing still.
  moving = motion::busy(g.motion, g.world.now);
  if moving || g.was_moving { changed = true; }
  g.was_moving = moving;
  if !g.won && g.keys.is_action_just_pressed("back") { return back(g); }
  if !g.won && g.keys.is_action_just_pressed("aim") {
    if rules::aim_next(g.world) { sound(g, "point", 0.3); }
    return true;
  }
  if !g.won && g.keys.is_action_just_pressed("swing") {
    swing(g);
    return true;
  }
  if !g.won && g.keys.is_action_just_pressed("drop") {
    if rules::drop(g.world) == rules::Step.Placed {
      g.moves += 1;
      sound(g, "drop");
    }
    return true;
  }
  if g.won && g.keys.is_action_just_pressed("next") {
    start_level(g, (g.level + 1) % len(g.order) ?? 0);
    return true;
  }
  d = direction(g, now);
  if d.0 == 0 && d.1 == 0 { return changed; }
  move(g, d.0, d.1, g.keys.is_action_pressed("pull"));
  true
}

// The hero spoke to (walked into) the one with id `id`: its talk goes on (talk.loft).
fn talk_to(g: Game, id: integer) {
  for e in 0..len(g.world.enemies) {
    if (g.world.enemies[e]!.id) != id { continue; }
    ti = talk::of(g.file.talks, g.world, e);
    if ti < 0 { continue; }
    for t in g.file.talks[ti..ti + 1] {
      o = talk::owner(t, g.world);
      if o >= 0 { talk::bump(t, g.world, o, e); }
    }
  }
}

// Every talk of the place at its clock and the hero's place: answers whether what is said changed.
fn step_talks(g: Game) -> boolean {
  changed = false;
  for t in g.file.talks {
    o = talk::owner(t, g.world);
    if o >= 0 && talk::step(t, g.world, o) { changed = true; }
  }
  changed
}

/// Has the player asked to stop?
pub fn quit(g: const Game) -> boolean {
  g.keys.is_action_just_pressed("quit")
}

/// Was the zoom key (`m`) just pressed?
pub fn zoom_pressed(g: const Game) -> boolean {
  g.keys.is_action_just_pressed("zoom")
}

/// Where the hero is drawn, in the view's units: the middle of its body, gliding and hopping as
/// it is drawn — the point a camera closes in on.
pub fn hero_point(g: const Game) -> (float, float) {
  w = g.world;
  ts = g.look.tile_size;
  p = motion::fine_pose(g.motion, w.face_x, w.face_y, w.now);
  half = (ts as float) / 2.0;
  (((w.hero_x - g.cam_x) * ts) as float + p.x + half,
   ((w.hero_y - g.cam_y) * ts - w.hero_z * ts - w.hero_h * 4) as float + p.y + half)
}

// --- The picture ---

// Cell (x, y, z) of `w`, at its place in the view.
/// The ground around the view: for each cell one beyond it on every side, its height in steps
/// over this layer's floor — its rise, or over the void a cell of the layer above (a layer's
/// steps up) or below (down) — whether it has one, its light (a shade, 0 .. 7), whether it is set
/// (not the void) and whether it is this layer's ground (set, not standing up): what a cell's
/// corners are made of, so ground meets ground across a layer's edge too.
struct Ground {
  x0: integer,
  y0: integer,
  w: integer,
  h: integer,
  rise: vector<integer>,
  has: vector<boolean>,
  shade: vector<integer>,
  set: vector<boolean>,
  ground: vector<boolean>
}

fn ground_of(g: const Game, w: const rules::Level, z: integer, rows: integer, lit: boolean) -> Ground {
  out = Ground { x0: g.cam_x - 1, y0: g.cam_y + z - 1, w: COLS + 2, h: rows + 2, rise: [], has: [], shade: [], set: [], ground: [] };
  steps = w.k.layer_height;
  if lit {
    out.shade = tile_world::shades(w.w, out.x0, out.y0, out.x0 + out.w - 1, out.y0 + out.h - 1, z,
                                   rules::lights(w, z), rules::light_starts(w, z));
  }
  for j in 0..out.h {
    for i in 0..out.w {
      x = out.x0 + i;
      y = out.y0 + j;
      k = tile_world::terrain(w.w, x, y, z);
      own = k != tile_world::VOID && !theme::upright(g.look, k);
      up = tile_world::terrain(w.w, x, y, z + 1);
      down = tile_world::terrain(w.w, x, y, z - 1);
      h = 0;
      has = own;
      if own {
        h = tile_world::rise(w.w, x, y, z);
      } else if k == tile_world::VOID && up != tile_world::VOID && !theme::upright(g.look, up) {
        h = steps + tile_world::rise(w.w, x, y, z + 1);
        has = true;
      } else if k == tile_world::VOID && down != tile_world::VOID && !theme::upright(g.look, down) {
        h = tile_world::rise(w.w, x, y, z - 1) - steps;
        has = true;
      }
      out.rise += [h];
      out.has += [has];
      out.set += [k != tile_world::VOID];
      out.ground += [own];
    }
  }
  out
}

// Cell (x, y)'s corner (cx, cy) — 0 or 1 each, (0, 0) top-left — lifted and darkened: the
// lift, in pixels, the mean rise of the ground cells sharing the corner that are within a step
// of this one (a slope bends; a drop of more leaves a bank); the darkness, in sixteenths of a
// shade, the mean light of the ground cells sharing it, never lighter than `dim` — light fades
// across the ground, not through a wall.  A top corner of a cell within a step of the ground
// north of it is that cell's bottom corner, so the two meet without a seam: a bank shows only
// at a drop of two steps or more.
fn corner(gr: const Ground, x: integer, y: integer, cx: integer, cy: integer, dim: integer) -> (integer, integer) {
  me = (y - gr.y0) * gr.w + (x - gr.x0);
  r0 = gr.rise[me] ?? 0;
  north = me - gr.w;
  if cy == 0 && y - 1 > gr.y0 && (gr.has[north] ?? false) {
    rn = gr.rise[north] ?? 0;
    if rn - r0 <= 1 && r0 - rn <= 1 { return corner_of(gr, x, y - 1, cx, 1, dim); }
  }
  corner_of(gr, x, y, cx, cy, dim)
}

// Corner (cx, cy) of cell (x, y), lifted and darkened as `corner` describes, measured where it
// is: `corner` has already moved a top corner onto the bottom corner of the cell north of it.
fn corner_of(gr: const Ground, x: integer, y: integer, cx: integer, cy: integer, dim: integer) -> (integer, integer) {
  me = (y - gr.y0) * gr.w + (x - gr.x0);
  r0 = gr.rise[me] ?? 0;
  rs = 0;
  rn = 0;
  ss = 0;
  sn = 0;
  for d in [(cx - 1, cy - 1), (cx, cy - 1), (cx - 1, cy), (cx, cy)] {
    i = me + d.1 * gr.w + d.0;
    if !(gr.has[i] ?? false) { continue; }
    r = gr.rise[i] ?? 0;
    if r - r0 <= 1 && r0 - r <= 1 {
      rs += r;
      rn += 1;
    }
    if !(gr.ground[i] ?? false) { continue; }
    sh = gr.shade[i] ?? 0;
    ss += if sh < dim { dim } else { sh };
    sn += 1;
  }
  lift = if rn == 0 { r0 * 4 } else { ((rs * 8 + rn) / (2 * rn))! };
  dark = if sn == 0 { dim * 16 } else { ((ss * 32 + sn) / (2 * sn))! };
  (lift, dark)
}

// The ground of cell (x, y, z): what lies under its kind (a rail's floor, a tree's) and the kind
// itself when it is flat, bent to its corners' lifts and lit by their light; and, where it
// stands higher than the ground south of it, the bank between, its ground darkened two shades;
// ground falling away from the light (the top left) a little darker.
fn draw_ground(g: Game, w: const rules::Level, gr: const Ground, x: integer, y: integer, z: integer,
               upper: boolean, dim: integer) {
  ts = g.look.tile_size;
  px = (x - g.cam_x) * ts;
  py = (y - g.cam_y) * ts - g.lift;
  k = tile_world::terrain(w.w, x, y, z);
  tl = corner(gr, x, y, 0, 0, dim);
  tr = corner(gr, x, y, 1, 0, dim);
  bl = corner(gr, x, y, 0, 1, dim);
  br = corner(gr, x, y, 1, 1, dim);
  lift = (tl.0, tr.0, bl.0, br.0);
  // The light comes from the top left, as in the pictures: ground falling away from it (its
  // top-left corner higher than its bottom-right) is darker, a shade for a step of slope, two at
  // most — so a mound and a ramp read as such.
  away = (tl.0 - br.0) * 4;
  away = if away < 0 { 0 } else if away > 32 { 32 } else { away };
  dark = (tl.1 + away, tr.1 + away, bl.1 + away, br.1 + away);
  // What it stands on: its material's `under` (a tree on grass), else its kind's (on floor).
  mu = materials::under_tile(g.mats, w.w, x, y, z);
  under = theme::under(g.look, k);
  base = if mu != 0 { theme::tile_sprite(g.look, mu) } else if under != 0 { theme::terrain_sprite(g.look, under, x, y, false) } else { -1 };
  if base >= 0 { theme::put_ground(g.surface, base, px, py, lift, dark); }
  if !theme::upright(g.look, k) {
    own = kind_sprite(g, w, x, y, z, upper);
    theme::put_ground(g.surface, own, px, py, lift, dark);
    if base < 0 { base = own; }
  }
  // The bank: from this cell's bottom edge down to the top edge of the ground south of it — or,
  // with no ground there (a wall, the void), down to its own base.
  south = (y + 1 - gr.y0) * gr.w + (x - gr.x0);
  if base >= 0 && (gr.has[south] ?? false) {
    sl = corner(gr, x, y + 1, 0, 0, dim);
    sr = corner(gr, x, y + 1, 1, 0, dim);
    if bl.0 > sl.0 || br.0 > sr.0 {
      theme::put_ground(g.surface, base, px, py + ts, (bl.0, br.0, ts + sl.0, ts + sr.0),
                        (bl.1 + 32, br.1 + 32, sl.1 + 32, sr.1 + 32));
    }
  } else if base >= 0 && (bl.0 > 0 || br.0 > 0) {
    theme::put_ground(g.surface, base, px, py + ts, (bl.0, br.0, ts, ts), (bl.1 + 32, br.1 + 32, bl.1 + 32, br.1 + 32));
  }
}

// The light at corner (cx, cy) of a standing cell (a wall): the mean of every set cell sharing
// it, walls and ground alike, never lighter than `dim`, in sixteenths of a shade.
fn standing_light(gr: const Ground, x: integer, y: integer, cx: integer, cy: integer, dim: integer) -> integer {
  me = (y - gr.y0) * gr.w + (x - gr.x0);
  ss = 0;
  sn = 0;
  for d in [(cx - 1, cy - 1), (cx, cy - 1), (cx - 1, cy), (cx, cy)] {
    i = me + d.1 * gr.w + d.0;
    if !(gr.set[i] ?? false) { continue; }
    sh = gr.shade[i] ?? 0;
    ss += if sh < dim { dim } else { sh };
    sn += 1;
  }
  if sn == 0 { dim * 16 } else { ((ss * 32 + sn) / (2 * sn))! }
}

// What stands on cell (x, y, z): its kind when it stands up (a wall, a tree), and its stack.
fn draw_standing(g: Game, w: const rules::Level, gr: const Ground, x: integer, y: integer, z: integer,
                 upper: boolean, dim: integer, shade: integer, things: boolean = true) {
  if theme::upright(g.look, tile_world::terrain(w.w, x, y, z)) {
    // Standing at its rise, lit gradually like the ground beside it.
    ts = g.look.tile_size;
    up = tile_world::rise(w.w, x, y, z) * 4;
    theme::put_ground(g.surface, kind_sprite(g, w, x, y, z, upper), (x - g.cam_x) * ts, (y - g.cam_y) * ts - g.lift,
                      (up, up, up, up),
                      (standing_light(gr, x, y, 0, 0, dim), standing_light(gr, x, y, 1, 0, dim),
                       standing_light(gr, x, y, 0, 1, dim), standing_light(gr, x, y, 1, 1, dim)));
  }
  if things { draw_stack(g, w, x, y, z, shade); }
}

// The picture of cell (x, y, z)'s terrain kind: a rail cell the piece of track its joins name
// (what a cart follows is what is seen); a line (a fence) across or along its neighbours of
// the same kind; a material's cell its own picture (its tile number); any other the kind's look.
fn kind_sprite(g: const Game, w: const rules::Level, x: integer, y: integer, z: integer, upper: boolean) -> integer {
  k = tile_world::terrain(w.w, x, y, z);
  own = theme::tile_sprite(g.look, tile_world::tile(w.w, x, y, z));
  track = if rules::is_rail(w, k) && own < 0 { theme::track_sprite(g.look, rules::joins(w, x, y, z)) } else { -1 };
  if track >= 0 { return track; }
  if theme::is_line(g.look, k) {
    across = tile_world::terrain(w.w, x - 1, y, z) == k || tile_world::terrain(w.w, x + 1, y, z) == k;
    return theme::line_sprite(g.look, k, across);
  }
  if own >= 0 { own } else { theme::terrain_sprite(g.look, k, x, y, upper) }
}

// The stack on cell (x, y, z).
fn draw_stack(g: Game, w: const rules::Level, x: integer, y: integer, z: integer, shade: integer) {
  ts = g.look.tile_size;
  px = (x - g.cam_x) * ts;
  py = (y - g.cam_y) * ts - g.lift;
  // The stack, bottom first, each thing lifted by the height under it (4 pixels a step), the
  // rise included.  A thing that holds another (a socket and its torch) is one picture when
  // the theme has it; a flame shows its frame at the level's clock, and its low picture in its
  // last minute.
  base = tile_world::rise(w.w, x, y, z);
  st = tile_world::things(w.w, x, y, z);
  low = rules::low(w, x, y, z);
  i = 0;
  while i < len(st) {
    t = st[i] ?? 0;
    both = theme::holding_sprite(g.look, t, st[i + 1] ?? 0, w.now, low);
    if both >= 0 {
      theme::put(g.surface, both, px, py - base * 4, shade);
      base += rules::thing_height(w, t) + rules::thing_height(w, st[i + 1] ?? 0);
      i += 2;
      continue;
    }
    // A lit bomb shows its fuse's sparks.
    lit = if rules::fused_at(w, x, y, z) { theme::fused_sprite(g.look, t, w.now) } else { -1 };
    theme::put(g.surface, if lit >= 0 { lit } else { theme::thing_sprite_at(g.look, t, w.now, low) }, px,
               py - base * 4, shade);
    base += rules::thing_height(w, t);
    i += 1;
  }
}

// The hero's hand, in its picture's pixels, facing (fx, fy): the right hand facing right, down or
// up (the weapon arm), the left facing left.
fn hand(fx: integer, fy: integer) -> (integer, integer) {
  if fx > 0 { (13, 11) } else if fx < 0 { (2, 11) } else if fy > 0 { (12, 12) } else { (11, 10) }
}

/// Someone drawn as a cut-out (motion.loft): the hero, and every enemy to come.  Its cell and
/// height, its picture, what it holds (and whether that burns low), the way it faces and its
/// pose now.
struct Figure {
  x: integer,
  y: integer,
  h: integer,
  sprite: integer,
  item: integer,
  low: boolean,
  face_x: integer,
  face_y: integer,
  pose: motion::Pose,
  fine: motion::FinePose
}

// The figures on layer z: the hero and the enemies.
fn figures(g: const Game, w: const rules::Level, z: integer) -> vector<Figure> {
  out: vector<Figure> = [];
  for e in w.enemies {
    if e.z != z { continue; }
    m = motion::still();
    for mv in g.movers { if mv.id == e.id { m = mv.motion; } }
    out += [Figure { x: e.x, y: e.y, h: tile_world::rise(w.w, e.x, e.y, z), sprite: theme::enemy_sprite(g.look, e.kind),
                     item: e.item, low: false, face_x: e.face_x, face_y: e.face_y,
                     pose: motion::pose(m, e.face_x, e.face_y, w.now),
                     fine: motion::fine_pose(m, e.face_x, e.face_y, w.now) }];
  }
  if w.hero_z == z {
    out += [Figure { x: w.hero_x, y: w.hero_y, h: w.hero_h, sprite: g.look.hero, item: w.hero_item,
                     low: rules::hero_low(w), face_x: w.face_x, face_y: w.face_y,
                     pose: motion::pose(g.motion, w.face_x, w.face_y, w.now),
                     fine: motion::fine_pose(g.motion, w.face_x, w.face_y, w.now) }];
  }
  out
}

// The view row a figure's feet stand at, which sets what hides it: drawn after that row's things,
// before the next row's.  A figure stepping into the row above stays behind this row's things
// until its feet pass their base; its hop does not count.
fn depth_row(g: const Game, f: const Figure) -> integer {
  ts = g.look.tile_size;
  feet = (f.y - g.cam_y + 1) * ts + f.pose.y + f.pose.hop;
  (feet / ts ?? 0) - 1
}

// Figure f: the body glides, hops and rocks about its feet; what it carries is at its hand,
// pointing the way it faces — behind the body facing up (owner: everything carried is held the
// way the figure moves).
// Drawn from the fine pose, in fractions of a pixel and a degree: on a display surface the figure
// moves smoothly at the display's resolution; on a 1x surface it lands on whole pixels.
fn draw_figure(g: Game, f: const Figure, now: integer, shade: integer) {
  ts = g.look.tile_size;
  p = f.fine;
  bx = (((f.x - g.cam_x) * ts) as float) + p.x;
  by = (((f.y - g.cam_y) * ts - g.lift - f.h * 4) as float) + p.y;
  hd = hand(f.face_x, f.face_y);
  hx = bx + (hd.0 as float);
  hy = by + (hd.1 as float);
  behind = f.face_y < 0 && f.face_x == 0;
  if f.item != 0 && behind {
    theme::put_held_fine(g.surface, g.look, f.item, hx, hy, p.weapon, p.reach, shade, now, f.low);
  }
  theme::put_fine(g.surface, f.sprite, bx, by, p.tilt, ((ts as float) / 2.0 + 0.5, (ts as float) - 0.5), shade);
  if f.item != 0 && !behind {
    theme::put_held_fine(g.surface, g.look, f.item, hx, hy, p.weapon, p.reach, shade, now, f.low);
  }
}


fn write(g: Game, s: text, x: integer, y: integer) {
  theme::write(g.surface, g.look, s, x, y);
}

// The rows of the level the view shows: one fewer while editing, for the palette.
fn view_rows(g: const Game) -> integer {
  if g.editing { ROWS - 2 } else { ROWS - 1 }
}

// Every cell of layer z of `w` the view holds, at its light (or in full light when not `lit`),
// but never lighter than `dim`; `only_set` skips the void, `cut` is a cell left out (a wall in
// front of the hero), and with `sight` the things and figures the hero does not see — past a
// wall — are left out (owner).
fn draw_layer(g: Game, w: const rules::Level, z: integer, upper: boolean, only_set: boolean, lit: boolean,
              dim: integer, cut: (integer, integer) = (-1000000, -1000000), sight: boolean = false) {
  rows = view_rows(g);
  cx = g.cam_x;
  // Layer z is drawn z tiles up, so the view shows its cells z rows further south: view row y
  // is the layer's row cy + y.
  cy = g.cam_y + z;
  g.lift = z * g.look.tile_size;
  gr = ground_of(g, w, z, rows, lit);
  // A view cell's shade, from the ground grid (one cell wider each side).
  sh: vector<integer> = [];
  for y in 0..rows {
    for x in 0..COLS { sh += [gr.shade[(y + 1) * gr.w + x + 1] ?? 0]; }
  }
  // The ground first, all of it; then, row by row from the back, what stands — the upright
  // terrain, the stacks, and the figures whose feet stand at that row — so what is in front
  // hides what is behind it.
  for y in 0..rows {
    for x in 0..COLS {
      if (!only_set || tile_world::terrain(w.w, cx + x, cy + y, z) != tile_world::VOID)
          && (cx + x != cut.0 || cy + y != cut.1) {
        draw_ground(g, w, gr, cx + x, cy + y, z, upper, dim);
      }
    }
  }
  draw_labels(g, w, z, sh, sight);
  figs = figures(g, w, z);
  for y in -1..rows {
    if y >= 0 {
      for x in 0..COLS {
        if (!only_set || tile_world::terrain(w.w, cx + x, cy + y, z) != tile_world::VOID)
            && (cx + x != cut.0 || cy + y != cut.1) {
          shade = sh[y * COLS + x] ?? 0;
          seen = !sight || rules::in_view(w, cx + x, cy + y);
          draw_standing(g, w, gr, cx + x, cy + y, z, upper, dim, if shade < dim { dim } else { shade }, seen);
        }
      }
      // A blast is drawn over the row it went off in.
      for b in w.blasts {
        s = theme::blast_sprite(g.look, w.now - b.at, w.k.flash_ms);
        if b.z == z && b.y == cy + y && s >= 0 {
          theme::put(g.surface, s, (b.x - cx) * g.look.tile_size,
                     y * g.look.tile_size - tile_world::rise(w.w, b.x, b.y, z) * 4, 0);
        }
      }
    }
    for f in figs {
      d = depth_row(g, f) - z;
      if (d == y || (y == -1 && d < -1) || (y == rows - 1 && d >= rows)) && (!sight || rules::in_view(w, f.x, f.y)) {
        fx = f.x - cx;
        fy = f.y - cy;
        shade = sh[fy * COLS + fx] ?? 0;
        if fx >= 0 && fx < COLS && fy >= 0 && fy < rows { draw_figure(g, f, w.now, if shade < dim { dim } else { shade }); }
      }
    }
  }
}

// The place's text on layer z, written on the ground: drawn over the floor and under what
// stands on it, so the hero walks over it.  Half the font's size, centred on its cell, in the
// light of that cell; with `sight`, only where the hero sees.
fn draw_labels(g: Game, w: const rules::Level, z: integer, sh: const vector<integer>, sight: boolean) {
  ts = g.look.tile_size;
  for b in g.file.labels {
    if b.z != z { continue; }
    vx = b.x - g.cam_x;
    vy = b.y - g.cam_y - z;
    if vx < -COLS || vx >= 2 * COLS || vy < 0 || vy >= view_rows(g) { continue; }
    if sight && !rules::in_view(w, b.x, b.y) { continue; }
    shade = if vx >= 0 && vx < COLS { sh[vy * COLS + vx] ?? 0 } else { 0 };
    half = ts / 2;
    x = vx * ts + half - len(b.says) * half / 2;
    y = (b.y - g.cam_y) * ts - g.lift + half / 2;
    theme::write_small(g.surface, g.look, b.says, x as float, y as float, shade);
  }
}

// The pixels covered in `e` ms by something moving `d` cells (-1, 0 or 1) every `ms` ms, at
// `ts` pixels a cell.  A cell time of 0 or less (a mistake in the data) counts as one ms.
fn covered(d: integer, e: integer, ts: integer, ms: integer) -> integer {
  per = if ms > 0 { ms } else { 1 };
  (d * e * ts / per)!
}

// The bow, over the picture: the mark on its locked target, and each arrow in flight — from where
// it was shot, a cell every arrow_ms, turned the way it flies.
fn draw_bow(g: Game) {
  w = g.world;
  ts = g.look.tile_size;
  a = rules::aimed(g.world);
  if a.0 != 0 || a.1 != 0 {
    z = w.hero_z;
    theme::put(g.surface, g.look.aim, (w.aim_x - g.cam_x) * ts,
               (w.aim_y - g.cam_y) * ts - z * ts - tile_world::rise(w.w, w.aim_x, w.aim_y, z) * 4, 0);
  }
  for s in w.shots {
    e = w.now - s.at;
    if s.done || e < 0 { continue; }
    px = (s.x - g.cam_x) * ts + covered(s.dx, e, ts, w.k.arrow_ms);
    py = (s.y - g.cam_y) * ts - s.z * ts - 6 + covered(s.dy, e, ts, w.k.arrow_ms);
    theme::put_turned(g.surface, g.look.arrow, px, py, motion::facing(s.dx, s.dy), (7, 8), 0);
  }
}

// Each enemy's motion, from how it changed since it was last drawn: a step glides, a blow
// staggers it away from the hero, a bite (beside the hero, facing it, the hero hurt) lunges.
fn follow_enemies(g: Game) {
  w = g.world;
  now = w.now;
  kept: vector<Mover> = [];
  for e in w.enemies {
    mv = Mover { id: e.id, motion: motion::still(), x: e.x, y: e.y, hp: e.hp };
    for o in g.movers {
      if o.id == e.id {
        mv.motion = o.motion;
        if o.x != e.x || o.y != e.y {
          motion::walk(mv.motion, now, e.x - o.x, e.y - o.y, 0, e.face_x, e.face_y);
        }
        if e.hp < o.hp {
          kx = if e.x > w.hero_x { 1 } else if e.x < w.hero_x { -1 } else { 0 };
          ky = if kx != 0 { 0 } else if e.y > w.hero_y { 1 } else { -1 };
          motion::stagger(mv.motion, now, kx, ky, 0, 0, e.face_x, e.face_y);
        }
      }
    }
    kept += [mv];
  }
  g.movers = kept;
}

/// Draw the frame on `g.surface`, each cell at its light.  What the hero sees depends on where
/// it stands: on a layer above another, the one below and its own over it; under the open sky,
/// its own and the layer above (a ledge, drawn lighter); under a ceiling, only its own.
pub fn draw(g: Game) {
  if g.editing {
    draw_editor(g);
    return;
  }
  follow_enemies(g);
  tiles::clear(g.surface, 0);
  w = g.world;
  z = w.hero_z;
  // On the hero's layer only what it sees past the walls (owner).
  if z > 0 {
    draw_layer(g, w, z - 1, false, false, true, 0);
    draw_layer(g, w, z, false, true, true, 0, (-1000000, -1000000), true);
  } else {
    draw_layer(g, w, z, false, false, true, 0, (-1000000, -1000000), true);
    // The layer above: a wall in front of the hero — the ledge's top on a wall, drawn a row up
    // over it — is left out (owner: only walls; doors, pillars, trees and smaller things may
    // hide the hero in part, and a level keeps the hero in view).
    if tile_world::open_sky(w.w, w.hero_x, w.hero_y, z) {
      front = if tile_world::terrain(w.w, w.hero_x, w.hero_y + 1, z) == rules::tr(w, "wall") {
        (w.hero_x, w.hero_y + 1)
      } else { (-1000000, -1000000) };
      draw_layer(g, w, z + 1, true, true, true, 0, front);
    }
  }
  draw_bow(g);
  draw_talk(g);
  if g.won {
    write(g, "DONE! N NEXT", 0, (ROWS - 1) * 16);
  } else if !rules::alive(w) {
    write(g, "NO HEARTS - R", 0, (ROWS - 1) * 16);
  } else {
    // A note (a signpost's count, SAVED, BACK? B AGAIN) has the whole line until the next
    // move; the move count shares it with the boost and the hearts.
    if g.note != "" { write(g, g.note, 0, (ROWS - 1) * 16); }
    else if w.money > 0 { status(g, "GOLD {w.money}"); }
    else { status(g, "MOVES {g.moves}"); }
  }
}

// What is being said, in a bubble over whoever says it: half-size letters, whole words, at most
// BUBBLE characters a row; the hero's in its own colour.  Kept inside the view.
fn draw_talk(g: Game) {
  w = g.world;
  ts = g.look.tile_size;
  for t in g.file.talks {
    e = talk::owner(t, w);
    if e < 0 { continue; }
    n = talk::current(w, e);
    b = talk::barking(w, e);
    if n < 0 && b < 0 { continue; }
    line = if n >= 0 { t.lines[n]! } else { t.barks[b]! };
    p = talk::speaker_of(t, w, e, line.by);
    if p.2 != w.hero_z { continue; }
    rows = talk::wrap(line.says, BUBBLE);
    wide = 0;
    for r in rows { if len(r) > wide { wide = len(r); } }
    half = ts / 2;
    bw = wide * half + 6;
    bh = len(rows) * (half + 1) + 5;
    x = (p.0 - g.cam_x) * ts + half - bw / 2;
    y = (p.1 - g.cam_y - p.2) * ts - bh - 1;
    if x < 0 { x = 0; }
    if x + bw > W { x = W - bw; }
    if y < 0 { y = 0; }
    edge = if line.by == "hero" { HERO_SAYS } else { THEY_SAY };
    tiles::rect(g.surface, x, y, bw, bh, edge);
    tiles::rect(g.surface, x + 1, y + 1, bw - 2, bh - 2, BUBBLE_FILL);
    for r in 0..len(rows) {
      row = rows[r] ?? "";
      theme::write_small(g.surface, g.look, row, (x + 3 + (wide - len(row)) * half / 2) as float,
                         (y + 3 + r * (half + 1)) as float, 0);
    }
  }
}

// The play status line: `left` from the left, and at the right the seconds a boost has left
// and the hero's health, a heart and a number.  `left` is cut short to leave them room.
fn status(g: Game, left: text) {
  w = g.world;
  ts = g.look.tile_size;
  y = (ROWS - 1) * ts;
  right = if rules::boosted(w) { "+{(w.boost_until - w.now) / 1000} " } else { "" };
  // Health, and the temporary health above it ("6+2").
  hearts = if w.spirit > 0 { "{w.health}+{w.spirit}" } else { "{w.health}" };
  cells = len(right) + 1 + len(hearts);
  write(g, right, (COLS - cells) * ts, y);
  theme::put(g.surface, g.look.heart, (COLS - len(hearts) - 1) * ts, y, 0);
  write(g, hearts, (COLS - len(hearts)) * ts, y);
  room = COLS - cells - 1;
  // Bound first: a text `if` as a call argument does not compile on --native before loft#2225.
  shown = if len(left) > room { left.char_slice(0, room) } else { left };
  write(g, shown, 0, y);
}

// The checks (EDITOR.md § 5) over layer z of the view: the way to a cell goal as dots, a chest
// cut off from the start framed red, a hidden one magenta.  Hints only: a path search ignores
// what pushing could change.
fn draw_checks(g: Game, z: integer) {
  r = editor::check(g.file);
  ts = g.look.tile_size;
  if r.searched && z == g.file.start_z {
    for p in r.path {
      tiles::rect(g.surface, (p.0 - g.cam_x) * ts + ts / 2 - 2, (p.1 - g.cam_y) * ts + ts / 2 - 2, 4, 4, GOAL);
    }
  }
  for c in r.cut_off { if c.2 == z { box(g, c.0, c.1, 2, CUT_OFF); } }
  for c in r.hidden { if c.2 == z { box(g, c.0, c.1, 4, HIDDEN); } }
}

// The status line while the checks show: the way to the goal, when it is a cell.
fn check_note(g: Game) -> text {
  r = editor::check(g.file);
  if !r.searched { return "CHECKS ON"; }
  if len(r.path) == 0 { return "NO PATH!"; }
  "PATH {len(r.path)}"
}

// A one-cell frame round cell (x, y) of the view, `inset` pixels inside it.
fn box(g: Game, x: integer, y: integer, inset: integer, colour: integer) {
  ts = g.look.tile_size;
  tiles::frame(g.surface, (x - g.cam_x) * ts + inset, (y - g.cam_y) * ts + inset, ts - 2 * inset,
               ts - 2 * inset, colour);
}

// The sprite of palette entry `e`; -1 for void, which draws as nothing.
fn entry_sprite(g: const Game, e: const editor::Entry) -> integer {
  if e.thing { return theme::thing_sprite(g.look, e.id); }
  if e.material >= 0 { return theme::tile_sprite(g.look, (g.mats.list[e.material] ?? materials::none_material()).tile); }
  theme::terrain_sprite(g.look, e.id, 0, 0, false)
}

/// The editor's frame (EDITOR.md § 4): the cursor's layer over the one below (darker), an
/// outline round each cell the layer above sets, the start (the hero) and a "cell" goal; the
/// palette along the bottom, its picked entry framed; and a status line: the cursor's cell
/// and layer and what paints, or a word after a save.
pub fn draw_editor(g: Game) {
  tiles::clear(g.surface, 0);
  l = g.file.level;
  ed = g.ed;
  z = ed.z;
  ts = g.look.tile_size;
  rows = ROWS - 2;
  draw_layer(g, l, z - 1, false, false, g.lit, 5);
  draw_layer(g, l, z, false, true, g.lit, 0);
  for y in 0..rows {
    for x in 0..COLS {
      if tile_world::terrain(l.w, g.cam_x + x, g.cam_y + y, z + 1) != tile_world::VOID {
        box(g, g.cam_x + x, g.cam_y + y, 1, ABOVE);
      }
    }
  }
  goal = g.file.goal;
  if goal.kind == "cell" && goal.z == z {
    box(g, goal.x, goal.y, 2, GOAL);
    box(g, goal.x, goal.y, 3, GOAL);
  }
  if ed.marked {
    // The box R marked, from its corner to the cursor.
    x0 = if ed.mark_x < ed.x { ed.mark_x } else { ed.x };
    y0 = if ed.mark_y < ed.y { ed.mark_y } else { ed.y };
    bw = (if ed.mark_x > ed.x { ed.mark_x } else { ed.x }) - x0 + 1;
    bh = (if ed.mark_y > ed.y { ed.mark_y } else { ed.y }) - y0 + 1;
    tiles::frame(g.surface, (x0 - g.cam_x) * ts, (y0 - g.cam_y) * ts, bw * ts, bh * ts, PICKED);
  }
  if g.checking { draw_checks(g, z); }
  draw_intent(g);
  box(g, ed.x, ed.y, 0, CURSOR);
  box(g, ed.x, ed.y, 1, 0);
  n = len(ed.palette);
  first = ed.pick - COLS / 2;
  if first > n - COLS { first = n - COLS; }
  if first < 0 { first = 0; }
  py = rows * ts;
  for i in first..n {
    if i - first >= COLS { break; }
    px = (i - first) * ts;
    theme::put(g.surface, entry_sprite(g, ed.palette[i] ?? editor::picked(ed)), px, py, 0);
    if i == ed.pick { tiles::frame(g.surface, px, py, ts, ts, PICKED); }
  }
  status = if g.note != "" { g.note } else if g.checking { check_note(g) } else {
    "{ed.x} {ed.y} {z} {editor::name(l.k, editor::picked(ed))}"
  };
  if len(status) > COLS { status = status.char_slice(0, COLS); }
  write(g, status, 0, (rows + 1) * ts);
}

/// Write the frame as it is now to a PNG at `path`, scaled by `scale` — a picture of the game
/// for a machine with no screen.
pub fn snapshot(g: Game, path: text, scale: integer) -> boolean {
  px = tiles::pixels(g.surface, W, H);
  img = imaging::Image { name: "frame", width: W * scale, height: H * scale, data: [] };
  for y in 0..H * scale {
    for x in 0..W * scale {
      at = ((y / scale) ?? 0) * W + ((x / scale) ?? 0);
      c = px[at] ?? 0;
      img.data += [imaging::Pixel {
        r: ((((c >> 11) & 31) * 255 / 31) ?? 0) & 255,
        g: ((((c >> 5) & 63) * 255 / 63) ?? 0) & 255,
        b: (((c & 31) * 255 / 31) ?? 0) & 255,
        a: 255
      }];
    }
  }
  img.save_png(path)
}

/// The credits, shown before the first level: the pictures and sounds are Kenney's (kenney.nl,
/// CC0), with thanks.  Each line centred, in the theme's font.
pub const CREDITS = "Pictures and sounds by Kenney (kenney.nl), CC0 - with kind regards to Kenney.";

pub fn draw_credits(g: Game) {
  tiles::clear(g.surface, 0);
  ts = g.look.tile_size;
  lines = ["TILE WORLD", "", "PICTURES AND", "SOUNDS BY", "KENNEY", "KENNEY.NL", "", "THANK YOU", "KENNEY!"];
  y = (H - len(lines) * ts) / 2 ?? 0;
  for l in lines {
    write(g, l, (W - len(l) * ts) / 2 ?? 0, y);
    y += ts;
  }
}

/// Is any key down this tick (to leave the credits)?
pub fn any_key(g: const Game) -> boolean {
  for k in 1..256 {
    if g.keys.is_key_down(k) { return true; }
  }
  false
}

