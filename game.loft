// The first climb, as a game: the rules (tile_world), the picture (tiles, Kenney's Tiny packs),
// the sounds (audio, Kenney's sound packs) and the controls (input).  Nothing here knows the
// machine: main.loft hands the picture to `screen` and the keys to `input`.
use tile_world;
use rules;
use tiles;
use audio;
use input;
use imaging;
use theme;
use levels;
use editor;
use camera;
use materials;
use talk;
use motion;
use ui;
use intent;

/// The frame: 13 x 9 cells of 16 pixels for the level, and one row for the status line.  The
/// editor gives a row of the level to its palette.
pub const COLS = 13;
pub const ROWS = 10;
pub const W = 208;
pub const H = 160;

/// Milliseconds a held direction waits before it repeats, and between repeats.
const REPEAT_FIRST = 220;
const REPEAT_NEXT = 140;

// The editor's colours: the cursor, the goal cell, the outline of the layer above, and the
// frame round the palette's picked entry.
const CURSOR = 65535;
const GOAL = 2016;
const ABOVE = 16904;
const PICKED = 65504;
// The intent's outlines over the editor's map.
const INTENT = 64543;
// The checks: a chest cut off from the start, a hidden one.
const CUT_OFF = 63488;
const HIDDEN = 63519;
// A speech bubble: at most this many characters a row; its fill, and its edge for the hero and for
// anyone else (RGB565).
const BUBBLE = 22;
const BUBBLE_FILL = 4228;
const HERO_SAYS = 65120;
const THEY_SAY = 52857;

// Key codes beside the bindings: Ctrl and Shift held.
const KEY_SHIFT = 132;
const KEY_CTRL = 133;

/// How long the swing key is held for a heavy swing (@GM-Combat; proposed, to tune in play).
pub const HEAVY_HOLD_MS = 500;

// The structs a `Game` holds in vectors are declared above it: one declared below its holder
// turns an `x[i]!` discharge into an owner that frees the game's store (loft#2404, fixed on a
// branch, not yet in a release).
/// A place the hero has left, as it left it.
struct Visited {
  place: text,
  level: rules::Level
}

/// An enemy as last drawn: its id, its motion, its cell and its health.
struct Mover {
  id: integer,
  motion: motion::Motion,
  x: integer,
  y: integer,
  hp: integer,
  /// Whether it followed the hero when last drawn: a change is shown as a nod (a hop in place).
  led: boolean = false
}

/// Where two weapons met (@GM-Combat): a spark between the hero's cell (x, y, z) and the one it
/// faces (fx, fy), from `start`; `big` for a parry, small for a block.
pub struct Spark {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub fx: integer,
  pub fy: integer,
  pub start: integer,
  pub big: boolean
}

/// A still of the epilogue (C7; `levels/epilogue.json`): shown when every condition in `when`
/// holds as the hero walks away — a place, the cell it is centred on, and what it says.
pub struct Still {
  pub when: vector<text>,
  pub says: text,
  pub place: text,
  pub x: integer,
  pub y: integer,
  pub z: integer
}

/// One of the world's people (C3; `levels/people.json`): its kind, the points it keeps to over its
/// cycle — each a place, a cell and from when in the cycle — and its talk (none or one), which
/// goes where it goes.  Entering a place, the people whose point is there are there, at it; during
/// a visit, one whose point moves elsewhere walks to the door that leads there and goes, and one
/// whose point moves here comes in by the door from its last place and walks to it (proposed:
/// the door straight to that place; a person with none goes and comes at its point).
pub struct PersonPoint {
  pub place: text,
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub from: integer
}

pub struct Person {
  pub name: text,
  pub kind: text,
  pub cycle: integer,
  pub points: vector<PersonPoint>,
  pub talks: vector<talk::Talk>
}

/// A talk that went with its person to another place (C3: a person brought somewhere): written in
/// place `from`'s file at (fx, fy, fz), now in place `place`, anchored at the person's new home.
pub struct MovedTalk {
  pub from: text,
  pub fx: integer,
  pub fy: integer,
  pub fz: integer,
  pub place: text,
  pub talk: talk::Talk
}

pub struct Game {
  pub world: rules::Level,
  /// The level being played, as its file holds it (name, start, goal).
  pub file: levels::LevelFile,
  /// The level files to play, in order (levels/order.json).
  pub order: vector<text>,
  /// Playing the world (WORLD.md): places joined by doors, from order.json's `start` place.  The
  /// place the hero is in (its file name), the door it came in by, each place left as the hero
  /// left it, the places whose goal the hero has met, and the place as it was when the hero
  /// came in (R goes back to it).
  pub in_world: boolean,
  pub place: text,
  pub entered_by: text,
  places: vector<Visited>,
  solved_places: vector<text>,
  arrived: rules::Level,
  has_arrived: boolean,
  /// The places the save at the last well and the one before it were made in.
  saved_place: text,
  /// What the save was made at, for the note on coming back: "WELL", or "FOUNTAIN" (the mines'
  /// save points, a look of the well kind: STORY.md @ST-Fountains).
  pub saved_at: text = "WELL",
  /// The clock (C1): the world's time in ms since day 0 began — one for every place — starting at
  /// 07:00 of day 0.
  pub clock: integer = 350000,
  previous_at: text = "WELL",
  previous_place: text,
  pub surface: integer,
  pub kinds: rules::Kinds,
  /// What the editor paints with, and what level files' legends may name (theme.json's).
  pub mats: materials::Materials,
  pub look: theme::Theme,
  sounds: hash<Sound[sd_name]>,
  pub keys: input::InputState,
  pub level: integer,
  pub moves: integer,
  pub won: boolean,
  held_since: integer,
  next_repeat: integer,
  was_boosted: boolean,
  /// Editing (E) rather than playing; the editor; whether the edit view shows the level's
  /// light (L); a word the status line shows until the next key ("SAVED").
  pub editing: boolean,
  pub ed: editor::Editor,
  /// The editor panel's name field (the level's file name), and whether a field has the
  /// keyboard, so the keys are text and not commands.
  pub name_field: text,
  pub typing: boolean,
  /// Building with the pointer (BROWSER_EDITOR.md § Pass 1): the tool ("", "room", "corridor"),
  /// a drag on the map from one cell to another, the room picked (-1 none), and the words a room
  /// can take (theme.json's).
  pub tool: text,
  pub dragging: boolean,
  drag_from: (integer, integer),
  drag_to: (integer, integer),
  pub room_pick: integer,
  pub words: vector<intent::Word>,
  lit: boolean,
  /// The editor shows the checks (K): the way to a cell goal, chests cut off or hidden.
  pub checking: boolean,
  pub note: text,
  /// The view's top-left cell, and the cells the level sets (for a view that follows).
  pub cam_x: integer,
  pub cam_y: integer,
  area: (integer, integer, integer, integer),
  /// The game's directory: theme.json, assets/ and levels/ are read from it.
  pub dir: text,
  /// The situation saved at the last well, whether there is one, and whether the player has
  /// asked once to go back to it (a second B confirms).
  pub saved: rules::Level,
  pub has_save: boolean,
  asking_back: boolean,
  /// The save before it — a doomed save need not brick a game: just sent back, B twice goes one
  /// well further back, and no further (DESIGN.md § Guards, doors and wells).
  pub previous: rules::Level,
  pub has_previous: boolean,
  just_back: boolean,
  /// How the hero moves on screen (motion.loft), and whether it was moving at the last frame —
  /// one more picture shows it standing still.
  pub motion: motion::Motion,
  was_moving: boolean,
  /// How each enemy moves on screen, by its id, and where and how healthy it was last drawn.
  movers: vector<Mover>,
  /// How far up the layer being drawn is drawn, in pixels: a tile for each layer above layer 0 —
  /// the height of a wall in the pictures (a raised block is a row of wall tops over one row of
  /// wall face).  Fixed per layer, so the world stays still when the hero changes layer.
  lift: integer,
  /// When the swing key went down (-1: it is up): let go after HEAVY_HOLD_MS it is a heavy swing,
  /// sooner a light one (@GM-Combat).
  swing_down_at: integer = -1,
  /// Q held (DESIGN.md @GM-Combat, *The keys*): let go with no step taken it takes or puts down;
  /// a step taken while it is held is a pull.
  take_down: boolean = false,
  take_stepped: boolean = false,
  /// Free roaming (F3, owner 2026-11-07, an experiment): the hero moves continuously with the keys
  /// held, diagonals too, and stands between tiles; its body's offset from its cell, in 1/256 of a
  /// cell.  The rules still see it on its cell: crossing half a cell takes the step there.  The
  /// way (1 or -1) a step was refused, not tried again while that key stays held.
  pub free: boolean = false,
  pub free_x: integer = 0,
  pub free_y: integer = 0,
  free_stop_x: integer = 0,
  free_stop_y: integer = 0,
  /// The play log (TW_LOG, main.loft): on, the lines of what happened — the world's (every act of
  /// every enemy and person) and the hero's — gathered here for main.loft to write out.
  pub logging: boolean = false,
  pub log: vector<text> = [],
  /// The marks set (F4): each a numbered line in the play log, where the player felt something off.
  pub marks: integer = 0,
  /// The talks that went with their people to other places (C3).
  pub moved_talks: vector<MovedTalk> = [],
  /// The world's people and their points (C3).
  pub people: vector<Person> = [],
  /// Where the game is saved at a well or fountain (C6); "" — the checks, a picture — none.
  pub save_dir: text = "",
  /// The epilogue (C7): its stills, the one shown (its number; past the last, THE END) and for
  /// how long it has been.
  pub ending: boolean = false,
  pub stills: vector<Still> = [],
  pub still: integer = 0,
  pub still_ms: integer = 0,
  /// The editor panel's fields (A2, A3): the place a door leads to, the text to write, a tag.
  pub door_field: text = "",
  pub text_field: text = "",
  pub tag_field: text = "",
  /// Where weapons met lately, and when the hero last struck a riposte (its stagger is doubled).
  pub sparks: vector<Spark> = [],
  riposted_at: integer = -1000000
}

/// How long a spark shows, small (a block) and big (a parry), and its size against a tile
/// (proposed, to tune in play).
const SPARK_MS = 120;
const BIG_SPARK_MS = 200;



struct Sound {
  const sd_name: text,
  sd_clips: vector<integer>,
  sd_next: integer
}

/// The sound events and how many variants each has in assets/sounds (`<event>_<n>.ogg`).
fn sound_events() -> vector<text> {
  ["step:5", "step_wood:5", "bump:1", "push_rock:3", "push_anvil:2", "cart:3", "wood:3",
   "climb_up:1", "climb_down:1", "potion:1", "strong:1", "weak:1", "win:1", "begin:1",
   "pickup:1", "drop:1", "door_open:1", "chop:1", "chest_open:1", "signpost:1", "fall:2", "game_over:1", "save:1", "restore:1", "point:1", "hit_hero:2", "sword:2", "block:1", "parry:1", "riposte:1", "explosion:3", "bomb_roll:2", "coins:2", "spotted:1", "grab:1"]
}

// The play keys (owner, 2026-11-07; DESIGN.md @GM-Combat, *The keys*): WASD walk (the arrows too);
// Q takes a small item or puts the held one down, and held while stepping pulls; E uses (swings,
// shoots, throws, drinks); Tab aims; Esc quits; F1 the first-person view (render3d.loft), F2 the
// editor, F3 free roaming, F4 a mark in the play log.  Shift is the built guard (held: block, pressed: parry) until the clash
// replaces it (BUILD.md B1c step 4).  The editor's keys are read only while editing.
fn bindings() -> input::Bindings {
  b = input::Bindings {
    bnd_actions: [
      input::ActionBinding { ab_name: "up", ab_keys: [119, 128] },
      input::ActionBinding { ab_name: "down", ab_keys: [115, 129] },
      input::ActionBinding { ab_name: "left", ab_keys: [97, 130] },
      input::ActionBinding { ab_name: "right", ab_keys: [100, 131] },
      input::ActionBinding { ab_name: "take", ab_keys: [113] },
      input::ActionBinding { ab_name: "guard", ab_keys: [132] },
      input::ActionBinding { ab_name: "swing", ab_keys: [101] },
      input::ActionBinding { ab_name: "aim", ab_keys: [9] },
      input::ActionBinding { ab_name: "back", ab_keys: [98] },
      input::ActionBinding { ab_name: "restart", ab_keys: [114] },
      input::ActionBinding { ab_name: "next", ab_keys: [110, 13] },
      input::ActionBinding { ab_name: "quit", ab_keys: [27] },
      input::ActionBinding { ab_name: "zoom", ab_keys: [109] },
      input::ActionBinding { ab_name: "edit", ab_keys: [136] },
      input::ActionBinding { ab_name: "free", ab_keys: [137] },
      input::ActionBinding { ab_name: "mark", ab_keys: [138] },
      input::ActionBinding { ab_name: "layer_up", ab_keys: [151] },
      input::ActionBinding { ab_name: "layer_down", ab_keys: [152] },
      input::ActionBinding { ab_name: "palette", ab_keys: [9] },
      input::ActionBinding { ab_name: "paint", ab_keys: [32] },
      input::ActionBinding { ab_name: "erase", ab_keys: [8, 147] },
      input::ActionBinding { ab_name: "start", ab_keys: [104] },
      input::ActionBinding { ab_name: "goal", ab_keys: [103] },
      input::ActionBinding { ab_name: "light", ab_keys: [108] },
      input::ActionBinding { ab_name: "test", ab_keys: [112] },
      input::ActionBinding { ab_name: "undo", ab_keys: [122] },
      input::ActionBinding { ab_name: "redo", ab_keys: [121] },
      input::ActionBinding { ab_name: "save", ab_keys: [115] },
      input::ActionBinding { ab_name: "open", ab_keys: [111] },
      input::ActionBinding { ab_name: "fill", ab_keys: [102] },
      input::ActionBinding { ab_name: "rect", ab_keys: [114] },
      input::ActionBinding { ab_name: "pick", ab_keys: [105] },
      input::ActionBinding { ab_name: "copy", ab_keys: [99] },
      input::ActionBinding { ab_name: "paste", ab_keys: [118] },
      input::ActionBinding { ab_name: "check", ab_keys: [107] },
      input::ActionBinding { ab_name: "raise", ab_keys: [93] },
      input::ActionBinding { ab_name: "lower", ab_keys: [91] },
      input::ActionBinding { ab_name: "slant", ab_keys: [47] }
    ],
    bnd_axes: []
  };
  // `1`..`9`: the editor's palette categories.
  for n in 1..=9 { b.bnd_actions += [input::ActionBinding { ab_name: "category{n}", ab_keys: [48 + n] }]; }
  b
}

/// A new game in directory `dir` (the game's own, "." for main.loft, ".." for a test): its kinds
/// from kinds.json, its look from theme.json (sheets relative to `dir`), its sounds from
/// `dir`/assets/sounds, its levels from `dir`/levels.  Null when the theme or a sheet will not
/// load.
pub fn new_game(dir: text) -> Game? {
  s = tiles::surface(W, H);
  k = rules::kinds();
  theme_text = file("{dir}/theme.json").content() ?? "";
  th = theme::load(theme_text, dir, k);
  mats = materials::load(theme_text, k);
  if !s || !th { return null; }
  blank = levels::LevelFile {
    name: "", camera: "follow", level: rules::level(k), start_x: 0, start_y: 0, start_z: 0,
    goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 }
  };
  ed = editor::new_editor_with(blank, mats);
  empty = rules::level(k);
  g = Game {
    world: rules::level(k),
    file: blank,
    order: level_order(dir),
    in_world: false, place: "", entered_by: "", places: [], solved_places: [], arrived: rules::level(k),
    has_arrived: false, saved_place: "", previous_place: "",
    surface: s ?? 0, kinds: k, mats: mats, look: th ?? return null,
    sounds: [],
    keys: input::input_new(bindings()),
    level: 0, moves: 0, won: false, held_since: 0, next_repeat: 0, was_boosted: false,
    editing: false, ed: ed, name_field: "", typing: false, tool: "", dragging: false, drag_from: (0, 0),
    drag_to: (0, 0), room_pick: -1, words: intent::words_from(theme_text), lit: false, checking: false, note: "",
    cam_x: 0, cam_y: 0, area: (0, 0, 0, 0),
    dir: dir, saved: empty, has_save: false, asking_back: false, previous: empty, has_previous: false,
    just_back: false, motion: motion::still(), was_moving: false, movers: [], lift: 0
  };
  g.people = load_people(dir);
  for e in sound_events() {
    parts = e.split(':');
    name = parts[0];
    n = parts[1] as integer ?? 1;
    clips: vector<integer> = [];
    for i in 0..n {
      c = audio::load("{dir}/assets/sounds/{name}_{i}.ogg");
      if c { clips += [c ?? 0]; }
    }
    g.sounds += [Sound { sd_name: name, sd_clips: clips, sd_next: 0 }];
  }
  g
}

/// Play one variant of a sound event, taking the variants in turn.
pub fn sound(g: Game, name: text, volume: float = 0.8) {
  sd = g.sounds[name];
  if !sd { return; }
  n = len(sd.sd_clips);
  if n == 0 { return; }
  i = sd.sd_next % n ?? 0;
  _ = audio::play(sd.sd_clips[i] ?? 0, volume);
  sd.sd_next = i + 1;
}


// The level names levels/order.json lists.
fn level_order(dir: text) -> vector<text> {
  out: vector<text> = [];
  o = json_parse(file("{dir}/levels/order.json").content() ?? "").field("order");
  for i in 0..o.len() { out += [o.item(i).as_text()]; }
  out
}

// The file of level number `level` of the order.
fn level_path(g: const Game, level: integer) -> text {
  "{g.dir}/levels/{g.order[level] ?? ""}.json"
}

// Load level number `level` of the order into `g`, with a fresh editor on it; false when its
// file does not load.
fn load_level(g: Game, level: integer) -> boolean {
  open_place(g, g.order[level] ?? "")
}

// Load the file of place `name` (levels/<name>.json) into `g`, with a fresh editor on it — the
// file only: what is played, `g.world`, is left as it is.  False when it does not load.
fn open_place(g: Game, name: text) -> boolean {
  m = levels::load_with(file("{g.dir}/levels/{name}.json").content() ?? "", g.kinds, g.mats);
  if !m { return false; }
  g.file = m;
  g.place = name;
  // The talks whose people left for elsewhere are not here; those whose people came here are.
  here: vector<talk::Talk> = [];
  for t in g.file.talks {
    gone = false;
    for mt in g.moved_talks { if mt.from == name && mt.fx == t.x && mt.fy == t.y && mt.fz == t.z { gone = true; } }
    if !gone { here += [t]; }
  }
  for mt in g.moved_talks { if mt.place == name { here += [mt.talk]; } }
  g.file.talks = here;
  g.level = -1;
  for i in 0..len(g.order) { if g.order[i] == name { g.level = i; } }
  g.ed = editor::new_editor_with(g.file, g.mats);
  g.name_field = name;
  true
}

// order.json again with `order` as given, its `start` and its `worlds` kept.
fn order_json(dir: text, order: const vector<text>) -> text {
  names = "";
  for n in order { names += if names == "" { "\"{n}\"" } else { ", \"{n}\"" }; }
  ws = "";
  for c in worlds(dir) {
    ws += if ws == "" { "" } else { ",\n    " };
    ws += "{{ \"name\": \"{c.name}\", \"start\": \"{c.start}\" }}";
  }
  "{{ \"start\": \"{start_place(dir)}\",\n  \"worlds\": [\n    {ws} ],\n  \"order\": [{names}] }}\n"
}

/// A world to start (WORLD.md: the places reached through doors from its start place): its name,
/// as the choice after the credits shows it, and its start place.
pub struct WorldChoice {
  pub name: text,
  pub start: text
}

/// The worlds order.json lists (`"worlds": [{ "name": .., "start": .. }]`), first the one played
/// most: the story's world, then the demo village.  Without a list, the one world of `start`.
pub fn worlds(dir: text) -> vector<WorldChoice> {
  out: vector<WorldChoice> = [];
  v = json_parse(file("{dir}/levels/order.json").content() ?? "").field("worlds");
  for i in 0..v.len() {
    e = v.item(i);
    out += [WorldChoice { name: levels::str(e.field("name"), ""), start: levels::str(e.field("start"), "") }];
  }
  if len(out) == 0 { out += [WorldChoice { name: "THE DEMO VILLAGE", start: start_place(dir) }]; }
  out
}

/// Where a world's game is saved: the demo village in `saves`, as always; another world in
/// `saves/<its start place>`, so the two never write over each other.
pub fn save_dir_of(start: text) -> text {
  if start == "demo" { "saves" } else { "saves/{start}" }
}

/// The choice of world, after the credits: each on its line with its number, the one picked
/// marked.  Up and down move the mark, a number or Enter starts one (`choice`).
pub fn draw_worlds(g: Game, list: const vector<WorldChoice>, pick: integer) {
  tiles::clear(g.surface, 0);
  ts = g.look.tile_size;
  y = (H - (len(list) + 2) * ts) / 2 ?? 0;
  write(g, "WHICH WORLD?", (W - 12 * ts) / 2 ?? 0, y);
  y += 2 * ts;
  for i in 0..len(list) {
    c = list[i] ?? continue;
    line = "{if i == pick { ">" } else { " " }}{i + 1} {c.name}";
    write(g, line, ts, y);
    y += ts;
  }
}

/// What the keys did to the choice of world this tick: the pick moved (up, down), or a world
/// chosen (its number, or Enter on the pick) — (pick, chosen), chosen -1 while none is.
pub fn choice(g: const Game, count: integer, pick: integer) -> (integer, integer) {
  p = pick;
  if g.keys.is_action_just_pressed("up") && p > 0 { p -= 1; }
  if g.keys.is_action_just_pressed("down") && p < count - 1 { p += 1; }
  for n in 1..=count {
    if n <= 9 && g.keys.is_action_just_pressed("category{n}") { return (n - 1, n - 1); }
  }
  if g.keys.is_action_just_pressed("next") { return (p, p); }
  (p, -1)
}

/// The place the game starts in: order.json's `start`, "demo" when it names none.  A world is
/// the places reached from its start place through doors, so another start is another world:
/// the demo village, with a house for each mechanic's room, stays one beside the game's own.
pub fn start_place(dir: text) -> text {
  v = json_parse(file("{dir}/levels/order.json").content() ?? "").field("start");
  if v.kind() == "JString" { v.as_text() } else { "demo" }
}

// Where place `name` is in the places the hero has left, -1 when it has not been there.
fn visited(g: const Game, name: text) -> integer {
  for i in 0..len(g.places) { if g.places[i].place == name { return i; } }
  -1
}

// Keep the place being played as it is now, for when the hero comes back.
fn stash(g: Game) {
  i = visited(g, g.place);
  if i >= 0 {
    g.places[i].level = g.world;
  } else {
    g.places += [Visited { place: g.place, level: g.world }];
  }
}

/// Play the world that starts at place `place` (a file in levels/), from that place's start
/// cell.  False when the place does not load.
pub fn start_world(g: Game, place: text) -> boolean {
  if !open_place(g, place) { return false; }
  g.in_world = true;
  g.places = [];
  g.moved_talks = [];
  g.solved_places = [];
  g.entered_by = "";
  g.has_arrived = false;
  restart(g);
  move_people(g, true);
  g.arrived = g.world;
  g.has_arrived = true;
  true
}

/// The hero steps through door `i` of the place it is in: into the place the door leads to, as
/// the hero left it when it was there before, standing just outside the door there and facing
/// away from it, with what it holds, its health and its money.  False (and nothing changed)
/// when that place does not load; a door there that does not exist puts the hero at the
/// place's start.
pub fn go_through(g: Game, i: integer) -> boolean {
  if i < 0 || i >= len(g.file.doors) { return false; }
  to = g.file.doors[i]!.to;
  there = g.file.doors[i]!.door;
  // Into someone's home while seen (BUILD.md C2b): snooping, and it is known.
  if g.file.doors[i]!.home && rules::seen_by_people(g.world) { rules::snoop(g.world); }
  m = levels::load_with(file("{g.dir}/levels/{to}.json").content() ?? "", g.kinds, g.mats);
  if !m { return false; }
  // Leaving the place is walking away from whoever is talking.
  for t in g.file.talks {
    o = talk::owner(t, g.world);
    if o >= 0 && talk::current(g.world, o) >= 0 { talk::walked_away(t, g.world, o); }
  }
  c = rules::carried(g.world);
  // What goes through with the hero (C3c), and the talks of the people it leads.
  leaving: vector<talk::Talk> = [];
  for t in g.file.talks {
    o = talk::owner(t, g.world);
    if o >= 0 && (g.world.enemies[o]!.led) && (g.world.enemies[o]!.person) == "" { leaving += [t]; }
  }
  f = rules::take_followers(g.world);
  from = g.place;
  stash(g);
  _ = open_place(g, to);
  j = visited(g, to);
  if j >= 0 {
    for v in g.places { if v.place == to { g.world = v.level; } }
  } else {
    g.world = g.file.level;
  }
  rules::carry_in(g.world, c);
  keep_time(g);
  k = levels::door_named(g.file, there);
  if k >= 0 {
    dx = g.file.doors[k]!.x;
    dy = g.file.doors[k]!.y;
    dz = g.file.doors[k]!.z;
    side = levels::out_of(g.file, g.world, k);
    rules::put_hero(g.world, dx + side.0, dy + side.1, dz);
    if side.0 != 0 || side.1 != 0 {
      g.world.face_x = side.0;
      g.world.face_y = side.1;
    }
  } else {
    rules::put_hero(g.world, g.file.start_x, g.file.start_y, g.file.start_z);
  }
  dc = if k >= 0 { (g.file.doors[k]!.x, g.file.doors[k]!.y, g.file.doors[k]!.z) } else { (g.world.hero_x, g.world.hero_y, g.world.hero_z) };
  moved = rules::set_followers(g.world, f, dc.0, dc.1, dc.2);
  for mv in moved {
    for t in leaving {
      if t.x != mv.0 || t.y != mv.1 || t.z != mv.2 { continue; }
      bring_talk(g, from, t, mv.3, mv.4, mv.5);
    }
  }
  move_people(g, true);
  g.entered_by = there;
  g.arrived = g.world;
  g.has_arrived = true;
  g.motion = motion::still();
  g.movers = [];
  g.asking_back = false;
  g.just_back = false;
  g.note = "";
  g.area = camera::bounds(g.world.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
  aim(g);
  sound(g, "door_open");
  true
}

// --- The epilogue (BUILD.md C7) ---

/// How long a still of the epilogue is shown before the next (a key goes on sooner).
pub const STILL_MS = 6000;

/// The stills of the epilogue that hold for the world as the hero leaves it: in the order
/// `levels/epilogue.json` lists them, each whose every condition holds (`rules::holds`).
pub fn epilogue(g: const Game) -> vector<Still> {
  out: vector<Still> = [];
  v = json_parse(file("{g.dir}/levels/epilogue.json").content() ?? "");
  for i in 0..v.len() {
    e = v.item(i);
    when: vector<text> = [];
    wv = e.field("when");
    for j in 0..wv.len() { when += [wv.item(j).as_text()]; }
    holds = true;
    for c in when { if !rules::holds(g.world, c) { holds = false; } }
    if !holds { continue; }
    at = e.field("at");
    out += [Still { when: when, says: levels::str(e.field("says"), ""), place: levels::str(e.field("place"), ""),
                    x: levels::num(at.item(0), 0), y: levels::num(at.item(1), 0), z: levels::num(at.item(2), 0) }];
  }
  out
}

/// The hero walks away (a door that `ends`): the epilogue's stills for the world as it is now.
pub fn begin_ending(g: Game) {
  g.stills = epilogue(g);
  g.ending = true;
  show_still(g, 0);
  sound(g, "win", 1.0);
}

// Still `n` shown: its place drawn as it is in the files, the view centred on its cell, nobody in
// it (the hero out of sight); past the last, THE END.
fn show_still(g: Game, n: integer) {
  g.still = n;
  g.still_ms = 0;
  if n >= len(g.stills) { return; }
  s = g.stills[n]!;
  if s.place == "" { return; }
  m = levels::load_with(file("{g.dir}/levels/{s.place}.json").content() ?? "", g.kinds, g.mats);
  if !m { return; }
  g.file = m;
  g.world = g.file.level;
  rules::put_hero(g.world, -100000, -100000, s.z);
  g.cam_x = s.x - COLS / 2;
  g.cam_y = s.y - s.z - (ROWS - 1) / 2;
}

fn draw_still(g: Game) {
  tiles::clear(g.surface, 0);
  ts = g.look.tile_size;
  half = ts / 2;
  if g.still >= len(g.stills) {
    write(g, "THE END", (W - 7 * ts) / 2, (ROWS / 2 - 1) * ts);
    return;
  }
  s = g.stills[g.still]!;
  if s.place != "" { draw_layer(g, g.world, s.z, false, false, true, 0); }
  rows = talk::wrap(s.says, (W - 8) / half ?? 20);
  bh = len(rows) * (half + 1) + 6;
  y = ROWS * ts - bh;
  tiles::rect(g.surface, 0, y, W, bh, BUBBLE_FILL);
  for r in 0..len(rows) {
    row = rows[r] ?? "";
    theme::write_small(g.surface, g.look, row, ((W - len(row) * half) / 2 ?? 0) as float, (y + 3 + r * (half + 1)) as float, 0);
  }
}

// --- Saves (BUILD.md C6, WORLD.md step 5) ---

/// The game saved, as files: `save.json` — the clock, the place and the hero's cell, what it
/// carries (its things, health, money, the facts, the goodwill), the places solved and the talks
/// moved — and every place as it was left, `<place>.json` in the place files' own form (its
/// enemies at their homes).  The world's people are not written: read back, they are where their
/// points say.
pub fn save_files(g: Game) -> vector<(text, text)> {
  stash(g);
  out: vector<(text, text)> = [];
  names = "";
  for v in g.places {
    m = levels::load_with(file("{g.dir}/levels/{v.place}.json").content() ?? "", g.kinds, g.mats);
    if !m { continue; }
    lf = m;
    lf.level = v.level;
    kept: vector<rules::Enemy> = [];
    for e in v.level.enemies { if e.person == "" { kept += [e]; } }
    lf.level.enemies = kept;
    out += [("{v.place}.json", levels::save_with(lf, g.mats))];
    names += if names == "" { levels::quoted(v.place) } else { ", {levels::quoted(v.place)}" };
  }
  c = rules::carried(g.world);
  solved = "";
  for s in g.solved_places { solved += if solved == "" { levels::quoted(s) } else { ", {levels::quoted(s)}" }; }
  moved = "";
  for mt in g.moved_talks {
    one = "{{ \"from\": {levels::quoted(mt.from)}, \"was\": [{mt.fx}, {mt.fy}, {mt.fz}], \"place\": {levels::quoted(mt.place)}, \"at\": [{mt.talk.x}, {mt.talk.y}, {mt.talk.z}] }}";
    moved += if moved == "" { one } else { ", {one}" };
  }
  w = g.world;
  out += [("save.json", "{{\n  \"clock\": {g.clock},\n  \"place\": {levels::quoted(g.place)},\n  \"hero\": [{w.hero_x}, {w.hero_y}, {w.hero_z}],\n  \"carried\": {c:j},\n  \"solved\": [{solved}],\n  \"moved\": [{moved}],\n  \"places\": [{names}]\n}}\n")];
  out
}

/// Read a game saved as `save_files` wrote it back: the same place, hero, clock, places as they
/// were left, and the people where their points say.  False (nothing changed) when it does not
/// read.
pub fn load_files(g: Game, files: const vector<(text, text)>) -> boolean {
  raw = "";
  for f in files { if f.0 == "save.json" { raw = f.1; } }
  v = json_parse(raw);
  place = levels::str(v.field("place"), "");
  if place == "" { return false; }
  places: vector<Visited> = [];
  pv = v.field("places");
  for i in 0..pv.len() {
    name = pv.item(i).as_text();
    for f in files {
      if f.0 != "{name}.json" { continue; }
      m = levels::load_with(f.1, g.kinds, g.mats);
      if m { places += [Visited { place: name, level: m.level }]; }
    }
  }
  moved: vector<MovedTalk> = [];
  mv = v.field("moved");
  for i in 0..mv.len() {
    e = mv.item(i);
    from = levels::str(e.field("from"), "");
    was = e.field("was");
    at = e.field("at");
    fx = levels::num(was.item(0), 0);
    fy = levels::num(was.item(1), 0);
    fz = levels::num(was.item(2), 0);
    m = levels::load_with(file("{g.dir}/levels/{from}.json").content() ?? "", g.kinds, g.mats);
    if !m { continue; }
    for t in m.talks {
      if t.x != fx || t.y != fy || t.z != fz { continue; }
      n = t;
      n.x = levels::num(at.item(0), 0);
      n.y = levels::num(at.item(1), 0);
      n.z = levels::num(at.item(2), 0);
      moved += [MovedTalk { from: from, fx: fx, fy: fy, fz: fz, place: levels::str(e.field("place"), ""), talk: n }];
    }
  }
  g.moved_talks = moved;
  if !open_place(g, place) { return false; }
  g.in_world = true;
  g.places = places;
  g.solved_places = [];
  sv = v.field("solved");
  for i in 0..sv.len() { g.solved_places += [sv.item(i).as_text()]; }
  j = visited(g, place);
  g.world = if j >= 0 { g.places[j]!.level } else { g.file.level };
  g.clock = levels::num(v.field("clock"), 0);
  hero = v.field("hero");
  rules::put_hero(g.world, levels::num(hero.item(0), 0), levels::num(hero.item(1), 0), levels::num(hero.item(2), 0));
  c = rules::Carried.parse(v.field("carried"));
  rules::carry_in(g.world, c);
  keep_time(g);
  move_people(g, true);
  g.entered_by = "";
  g.arrived = g.world;
  g.has_arrived = true;
  g.motion = motion::still();
  g.movers = [];
  g.note = "";
  g.area = camera::bounds(g.world.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
  aim(g);
  true
}

/// Save the game into directory `dir` (made when missing).
pub fn write_save(g: Game, dir: text) -> boolean {
  _ = mkdir_all(dir);
  for f in save_files(g) { if !file("{dir}/{f.0}").write(f.1).ok() { return false; } }
  true
}

/// Read back the game saved in directory `dir`; false when there is none.
pub fn read_save(g: Game, dir: text) -> boolean {
  raw = file("{dir}/save.json").content() ?? "";
  if raw == "" { return false; }
  files: vector<(text, text)> = [("save.json", raw)];
  v = json_parse(raw).field("places");
  for i in 0..v.len() {
    name = v.item(i).as_text();
    files += [("{name}.json", file("{dir}/{name}.json").content() ?? "")];
  }
  load_files(g, files)
}

// The world's people, from `levels/people.json` (none when there is no such file).
fn load_people(dir: text) -> vector<Person> {
  out: vector<Person> = [];
  v = json_parse(file("{dir}/levels/people.json").content() ?? "");
  for i in 0..v.len() {
    p = v.item(i);
    pts: vector<PersonPoint> = [];
    pv = p.field("points");
    for j in 0..pv.len() {
      q = pv.item(j);
      at = q.field("at");
      pts += [PersonPoint { place: levels::str(q.field("place"), ""), x: levels::num(at.item(0), 0),
                            y: levels::num(at.item(1), 0), z: levels::num(at.item(2), 0),
                            from: levels::num(q.field("from"), 0) }];
    }
    out += [Person { name: levels::str(p.field("name"), ""), kind: levels::str(p.field("kind"), "villager"),
                     cycle: levels::num(p.field("cycle"), 0), points: pts, talks: talk::from_json(p.field("talks")) }];
  }
  out
}

// The point person `p` keeps to now and the one before it: the last whose `from` the time in its
// cycle has reached (before the first, the last of the cycle before).
fn person_points(g: const Game, p: const Person) -> (integer, integer) {
  n = len(p.points);
  cyc = if p.cycle > 0 { p.cycle } else { DAY_MS };
  phase = g.clock % cyc ?? 0;
  k = n - 1;
  for j in 0..n { if p.points[j]!.from <= phase { k = j; } }
  (k, (k + n - 1) % n ?? 0)
}

// The door of the place open that leads to `place`, -1 for none.
fn door_to(g: const Game, place: text) -> integer {
  for i in 0..len(g.file.doors) { if g.file.doors[i]!.to == place { return i; } }
  -1
}

// Keep the world's people where their points say (C3).  `entering`: the place has just opened —
// the people whose point is here are put at it, the others are not here; otherwise those leaving
// walk to their door and go from beside it, those coming arrive by theirs.  One the hero leads
// goes with the hero instead.  Each one's talk is here while it is, at its home.
fn move_people(g: Game, entering: boolean) {
  if entering {
    kept: vector<rules::Enemy> = [];
    for each_e in g.world.enemies { if each_e.person == "" || each_e.led { kept += [each_e]; } }
    g.world.enemies = kept;
  }
  for p in g.people {
    if len(p.points) == 0 { continue; }
    pts = person_points(g, p);
    now = p.points[pts.0]!;
    before = p.points[pts.1]!;
    i = rules::person_index(g.world, p.name);
    if i >= 0 && (g.world.enemies[i]!.led) { continue; }
    if i >= 0 {
      e = g.world.enemies[i]!;
      if now.place == g.place {
        if !e.goal_set && (e.nest_x != now.x || e.nest_y != now.y || e.nest_z != now.z) {
          rules::send_to(g.world, i, now.x, now.y, now.z);
        }
      } else {
        d = door_to(g, now.place);
        dx = if d >= 0 { g.file.doors[d]!.x } else { e.x };
        dy = if d >= 0 { g.file.doors[d]!.y } else { e.y };
        far = (if e.x > dx { e.x - dx } else { dx - e.x }) + (if e.y > dy { e.y - dy } else { dy - e.y });
        if d < 0 || far <= 1 {
          _ = g.world.enemies.remove(i);
        } else if !e.goal_set || e.goal_x != dx || e.goal_y != dy {
          rules::send_to(g.world, i, dx, dy, g.file.doors[d]!.z);
        }
      }
    } else if now.place == g.place {
      d = if entering || before.place == g.place { -1 } else { door_to(g, before.place) };
      sx = if d >= 0 { g.file.doors[d]!.x } else { now.x };
      sy = if d >= 0 { g.file.doors[d]!.y } else { now.y };
      sz = if d >= 0 { g.file.doors[d]!.z } else { now.z };
      if rules::enemy_at(g.world, sx, sy, sz) >= 0 || (g.world.hero_x == sx && g.world.hero_y == sy && g.world.hero_z == sz) {
        continue;
      }
      _ = rules::add_enemy(g.world, p.kind, sx, sy, sz);
      j = len(g.world.enemies) - 1;
      g.world.enemies[j].person = p.name;
      if sx != now.x || sy != now.y || sz != now.z { rules::send_to(g.world, j, now.x, now.y, now.z); }
    }
  }
  // Each one's talk here while it is, at its home.
  talks: vector<talk::Talk> = [];
  for t in g.file.talks { if !is_person(g, t.name) { talks += [t]; } }
  for p in g.people {
    i = rules::person_index(g.world, p.name);
    if i < 0 { continue; }
    e = g.world.enemies[i]!;
    for t in p.talks {
      n = t;
      n.name = p.name;
      n.x = e.nest_x;
      n.y = e.nest_y;
      n.z = e.nest_z;
      talks += [n];
    }
  }
  g.file.talks = talks;
}

fn is_person(g: const Game, name: text) -> boolean {
  if name == "" { return false; }
  for p in g.people { if p.name == name { return true; } }
  false
}

// Talk `t` of place `from` goes with its person to the place now open, anchored at (x, y, z):
// one that had moved before moves on; one from its own file is taken out of it.
fn bring_talk(g: Game, from: text, t: const talk::Talk, x: integer, y: integer, z: integer) {
  n = t;
  n.x = x;
  n.y = y;
  n.z = z;
  for i in 0..len(g.moved_talks) {
    m = g.moved_talks[i]!;
    if m.place == from && m.talk.x == t.x && m.talk.y == t.y && m.talk.z == t.z {
      g.moved_talks[i].place = g.place;
      g.moved_talks[i].talk = n;
      g.file.talks += [n];
      return;
    }
  }
  g.moved_talks += [MovedTalk { from: from, fx: t.x, fy: t.y, fz: t.z, place: g.place, talk: n }];
  g.file.talks += [n];
}

// A level's file name from what was typed: lower-case letters, digits, `_` and `-`; spaces as
// `_`; anything else left out.
fn file_name(typed: text) -> text {
  out = "";
  for c in typed {
    n = c as integer;
    if n >= 65 && n <= 90 { out += "{(n + 32) as character}"; }
    else if (n >= 97 && n <= 122) || (n >= 48 && n <= 57) || n == 95 || n == 45 { out += "{c}"; }
    else if n == 32 { out += "_"; }
  }
  out
}

/// Write the level being edited as `levels/<name>.json`, and add the name to `order.json` when it
/// is new; the level is then that one.  False for a name with nothing left in it, or a file that
/// could not be written.
pub fn save_as(g: Game, typed: text) -> boolean {
  name = file_name(typed);
  if name == "" { return false; }
  at = -1;
  for i in 0..len(g.order) { if g.order[i] == name { at = i; } }
  if at < 0 {
    g.order += [name];
    at = len(g.order) - 1;
    if !file("{g.dir}/levels/order.json").write(order_json(g.dir, g.order)).ok() { return false; }
  }
  g.level = at;
  g.name_field = name;
  save(g)
}

/// Start an empty place to build in, named "new_place" until it is saved under a name.
pub fn new_place(g: Game) {
  k = g.kinds;
  g.file = levels::LevelFile {
    name: "a new place", camera: "follow", level: rules::level(k), start_x: 1, start_y: 1, start_z: 0,
    goal: levels::Goal { kind: "", x: 0, y: 0, z: 0 }
  };
  for t in g.mats.track { rules::add_piece(g.file.level, t.tile, t.joins, t.toe, t.straight, t.turn, t.set_turn, t.twin); }
  g.ed = editor::new_editor_with(g.file, g.mats);
  g.name_field = "new_place";
  g.room_pick = -1;
  g.note = "";
  aim_editor(g);
}

/// Fill the place in from its intent, as the editor shows it: the cells set by hand kept.
pub fn fill_in(g: Game) -> boolean {
  editor::refill(g.ed, g.file, g.words)
}

// The map cell under (ux, uy), the view's units, as the editor draws its cells.
fn cell_under(g: const Game, ux: float, uy: float) -> (integer, integer) {
  ts = g.look.tile_size as float;
  (g.cam_x + (floor((ux / ts)!) as integer), g.cam_y + (floor((uy / ts)!) as integer))
}

/// The pointer on the editor's map, where the widgets did not take it, at (ux, uy) in the view's
/// units with the button `down` now and `was_down` the frame before.  With the ROOM tool a drag
/// from one cell to another draws a room there (its outline the two corners), and a click inside
/// a room picks it; with CORRIDOR a drag runs a corridor.  What is drawn is filled in at once.
/// Answers whether the picture changed.
pub fn editor_map_pointer(g: Game, ux: float, uy: float, down: boolean, was_down: boolean) -> boolean {
  if g.tool == "" { return false; }
  at = cell_under(g, ux, uy);
  if down && !was_down {
    g.dragging = true;
    g.drag_from = at;
    g.drag_to = at;
    return true;
  }
  if down && g.dragging {
    moved = at.0 != g.drag_to.0 || at.1 != g.drag_to.1;
    g.drag_to = at;
    return moved;
  }
  if !g.dragging { return false; }
  g.dragging = false;
  a = g.drag_from;
  b = at;
  x0 = if a.0 < b.0 { a.0 } else { b.0 };
  y0 = if a.1 < b.1 { a.1 } else { b.1 };
  w = (if a.0 > b.0 { a.0 - b.0 } else { b.0 - a.0 }) + 1;
  h = (if a.1 > b.1 { a.1 - b.1 } else { b.1 - a.1 }) + 1;
  z = g.ed.z;
  if g.tool == "room" {
    if w == 1 && h == 1 {
      g.room_pick = -1;
      for i in 0..len(g.file.intent.rooms) {
        r = g.file.intent.rooms[i];
        if r.z == z && a.0 >= r.x && a.1 >= r.y && a.0 < r.x + r.w && a.1 < r.y + r.h { g.room_pick = i; }
      }
      return true;
    }
    if w < 3 || h < 3 {
      g.note = "A ROOM IS 3 BY 3 OR MORE";
      return true;
    }
    g.file.intent.rooms += [intent::Room { x: x0, y: y0, w: w, h: h, z: z, words: [] }];
    g.room_pick = len(g.file.intent.rooms) - 1;
  } else if g.tool == "corridor" {
    if w == 1 && h == 1 { return true; }
    g.file.intent.corridors += [intent::Corridor { x0: a.0, y0: a.1, x1: b.0, y1: b.1, z: z }];
  }
  _ = fill_in(g);
  true
}

// The intent over the editor's map: each room's outline on this layer (the picked one in the
// picked colour), each corridor's way, and a drag in progress.
fn draw_intent(g: Game) {
  ts = g.look.tile_size;
  z = g.ed.z;
  for i in 0..len(g.file.intent.rooms) {
    r = g.file.intent.rooms[i];
    if r.z != z { continue; }
    tiles::frame(g.surface, (r.x - g.cam_x) * ts, (r.y - g.cam_y) * ts, r.w * ts, r.h * ts,
                 if i == g.room_pick { PICKED } else { INTENT });
  }
  for c in g.file.intent.corridors {
    if c.z != z { continue; }
    mid = ts / 2 - 1;
    xa = if c.x0 < c.x1 { c.x0 } else { c.x1 };
    xb = if c.x0 < c.x1 { c.x1 } else { c.x0 };
    ya = if c.y0 < c.y1 { c.y0 } else { c.y1 };
    yb = if c.y0 < c.y1 { c.y1 } else { c.y0 };
    tiles::rect(g.surface, (xa - g.cam_x) * ts + mid, (c.y0 - g.cam_y) * ts + mid, (xb - xa) * ts + 2, 2, INTENT);
    tiles::rect(g.surface, (c.x1 - g.cam_x) * ts + mid, (ya - g.cam_y) * ts + mid, 2, (yb - ya) * ts + 2, INTENT);
  }
  if g.dragging && g.tool != "" {
    a = g.drag_from;
    b = g.drag_to;
    x0 = if a.0 < b.0 { a.0 } else { b.0 };
    y0 = if a.1 < b.1 { a.1 } else { b.1 };
    w = (if a.0 > b.0 { a.0 - b.0 } else { b.0 - a.0 }) + 1;
    h = (if a.1 > b.1 { a.1 - b.1 } else { b.1 - a.1 }) + 1;
    tiles::frame(g.surface, (x0 - g.cam_x) * ts, (y0 - g.cam_y) * ts, w * ts, h * ts, CURSOR);
  }
}

/// The editor's panel, for a screen with a pointer, at the right of a UI `width` units wide: the
/// level's name, saved under it (SAVE or Enter), the levels to open, and PLAY.  Answers whether
/// the level or the view changed.
pub fn editor_panel(g: Game, u: ui::Ui, width: float) -> boolean {
  x = width - 124.0;
  y = 4.0;
  changed = false;
  ui::panel(u, x, y, 120.0, 176.0 + 14.0 * (len(g.words) as float) + 30.0 + 94.0 + 14.0 * (len(g.file.serves) as float));
  ui::label(u, x + 4.0, y + 4.0, "LEVEL");
  if ui::button(u, "new", x + 76.0, y + 2.0, 40.0, 11.0, "NEW") {
    new_place(g);
    return true;
  }
  entered = ui::field(u, "name", x + 4.0, y + 14.0, 112.0, 12.0, g.name_field);
  if ui::button(u, "save", x + 4.0, y + 30.0, 54.0, 12.0, "SAVE") || entered {
    g.note = if save_as(g, g.name_field) { "SAVED" } else { "NOT SAVED!" };
    changed = true;
  }
  if ui::button(u, "play", x + 62.0, y + 30.0, 54.0, 12.0, "PLAY") {
    toggle_editor(g);
    return true;
  }
  ui::label(u, x + 4.0, y + 48.0, "LEVELS");
  pick = g.level;
  if ui::list(u, "levels", x + 4.0, y + 58.0, 112.0, 94.0, g.order, pick) {
    if load_level(g, pick) {
      g.note = g.order[pick] ?? "";
      aim_editor(g);
    }
    changed = true;
  }
  // Building: the tools, the picked room's words, filling in, and taking a room away.
  by = y + 158.0;
  ui::label(u, x + 4.0, by, "BUILD");
  if ui::button(u, "tool_room", x + 4.0, by + 10.0, 54.0, 12.0, if g.tool == "room" { "*ROOM" } else { "ROOM" }) {
    g.tool = if g.tool == "room" { "" } else { "room" };
    changed = true;
  }
  if ui::button(u, "tool_corridor", x + 62.0, by + 10.0, 54.0, 12.0, if g.tool == "corridor" { "*HALL" } else { "HALL" }) {
    g.tool = if g.tool == "corridor" { "" } else { "corridor" };
    changed = true;
  }
  wy = by + 26.0;
  picked = g.room_pick >= 0 && g.room_pick < len(g.file.intent.rooms);
  for wd in g.words {
    has = picked && g.file.intent.rooms[g.room_pick]!.words.contains(wd.name);
    if ui::button(u, "word_{wd.name}", x + 4.0, wy, 112.0, 12.0, if has { "*{wd.name}" } else { wd.name }) && picked {
      r = g.file.intent.rooms[g.room_pick]!;
      if has {
        kept: vector<text> = [];
        for w in r.words { if w != wd.name { kept += [w]; } }
        r.words = kept;
      } else {
        r.words += [wd.name];
      }
      _ = fill_in(g);
      changed = true;
    }
    wy += 14.0;
  }
  if ui::button(u, "fill", x + 4.0, wy, 54.0, 12.0, "FILL") {
    g.note = if fill_in(g) { "FILLED IN" } else { "NOTHING TO FILL" };
    changed = true;
  }
  if ui::button(u, "drop_room", x + 62.0, wy, 54.0, 12.0, "DROP") && picked {
    rooms: vector<intent::Room> = [];
    for i in 0..len(g.file.intent.rooms) { if i != g.room_pick { rooms += [g.file.intent.rooms[i]]; } }
    g.file.intent.rooms = rooms;
    g.room_pick = -1;
    changed = true;
  }
  // The cursor's cell a door to a place, text on it (A2): typed, then SET; empty takes it away.
  fy = wy + 18.0;
  ui::label(u, x + 4.0, fy, "DOOR TO");
  door_entered = ui::field(u, "door_to", x + 4.0, fy + 10.0, 76.0, 12.0, g.door_field);
  if ui::button(u, "door", x + 84.0, fy + 10.0, 32.0, 12.0, "SET") || door_entered {
    g.note = if editor::set_door(g.ed, g.file, g.door_field, here(g)) { if g.door_field == "" { "NO DOOR" } else { "DOOR" } } else { "NOTHING THERE" };
    changed = true;
  }
  ui::label(u, x + 4.0, fy + 26.0, "TEXT");
  text_entered = ui::field(u, "text", x + 4.0, fy + 36.0, 76.0, 12.0, g.text_field);
  if ui::button(u, "label", x + 84.0, fy + 36.0, 32.0, 12.0, "SET") || text_entered {
    g.note = if editor::set_label(g.ed, g.file, g.text_field) { "TEXT" } else { "NOTHING THERE" };
    changed = true;
  }
  // What the place serves (A3): a tag clicked is taken away; one typed is added.
  ui::label(u, x + 4.0, fy + 52.0, "SERVES");
  ty = fy + 62.0;
  for t in g.file.serves {
    if ui::button(u, "serves_{t}", x + 4.0, ty, 112.0, 12.0, t) {
      _ = editor::serve(g.file, t);
      changed = true;
    }
    ty += 14.0;
  }
  tag_entered = ui::field(u, "tag", x + 4.0, ty, 76.0, 12.0, g.tag_field);
  if ui::button(u, "serve", x + 84.0, ty, 32.0, 12.0, "ADD") || tag_entered {
    g.note = if editor::serve(g.file, g.tag_field) { "SERVES {g.tag_field}" } else { "NOT A TAG" };
    changed = true;
  }
  g.typing = ui::typing(u);
  changed
}

/// The theme's font for the widgets.
pub fn ui_font(g: const Game) -> ui::Font {
  theme::ui_font(g.look)
}

fn solved(g: const Game) -> boolean {
  levels::solved(g.file, g.world)
}

/// Play level number `level` of the order from its start, as its file holds it.
pub fn start_level(g: Game, level: integer) {
  g.in_world = false;
  g.has_arrived = false;
  _ = load_level(g, level);
  restart(g);
}

/// Start the level again, as the file in memory holds it: the editor's edits included, and
/// the played copy dropped.  (`g.world = g.file.level` copies: an assignment into a field.)
/// In the world, the place as it was when the hero came in, the hero as it came.
pub fn restart(g: Game) {
  g.note = "";
  g.has_save = false;
  g.asking_back = false;
  g.has_previous = false;
  g.just_back = false;
  g.motion = motion::still();
  g.movers = [];
  if g.in_world && g.has_arrived {
    g.world = g.arrived;
  } else {
    g.world = g.file.level;
    rules::put_hero(g.world, g.file.start_x, g.file.start_y, g.file.start_z);
  }
  g.area = camera::bounds(g.world.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
  aim(g);
  g.moves = 0;
  g.won = false;
  g.was_boosted = false;
  sound(g, "begin");
}

/// A game day, in ms of play (C1; proposed, to tune in play): 20 minutes.  Night is from 20:00 to
/// 06:00.
pub const DAY_MS = 1200000;

// The minute of the day the clock reads (0 .. 1439).
fn minute_of_day(g: const Game) -> integer {
  ((g.clock % DAY_MS ?? 0) * 1440 / DAY_MS) ?? 0
}

/// Is it night by the clock?
pub fn is_night(g: const Game) -> boolean {
  m = minute_of_day(g);
  m >= 20 * 60 || m < 6 * 60
}

// The clock as the status line shows it: "07:30".
fn clock_text(g: const Game) -> text {
  m = minute_of_day(g);
  h = m / 60 ?? 0;
  mm = m % 60 ?? 0;
  "{if h < 10 { "0" } else { "" }}{h}:{if mm < 10 { "0" } else { "" }}{mm}"
}

// The place keeps the world's time (C1): night or not, and the days it has seen since its last —
// what refills by the day refills for them.
fn keep_time(g: Game) {
  move_people(g, false);
  g.world.night = is_night(g);
  day = g.clock / DAY_MS ?? 0;
  if day > g.world.day {
    rules::refill(g.world, day - g.world.day);
    g.world.day = day;
  }
}

/// The hero sleeps (C1): the clock moves on to the next change of light — by day to 20:00, by night
/// to 07:00 — and the world runs on through it.
pub fn sleep(g: Game) {
  m = minute_of_day(g);
  to = if is_night(g) { 7 * 60 } else { 20 * 60 };
  gap = if to > m { to - m } else { to + 1440 - m };
  ms = gap * DAY_MS / 1440 ?? 0;
  rules::tick(g.world, ms);
  g.clock += ms;
  keep_time(g);
  g.note = "SLEPT TILL {clock_text(g)}";
}

// The sound a move makes, from what stood where the hero went before it moved.
fn move_sound(g: Game, step: rules::Step, thing: integer, z_before: integer) {
  w = g.world;
  if step == rules::Step.Blocked || step == rules::Step.Watched || step == rules::Step.Struggled {
    sound(g, "bump", 0.5);
  } else if step == rules::Step.Took || step == rules::Step.Lifted {
    sound(g, "pickup");
  } else if step == rules::Step.Chopped || step == rules::Step.Picked {
    sound(g, "chop");
  } else if step == rules::Step.Unloaded {
    sound(g, "push_rock");
  } else if step == rules::Step.Dipped {
    sound(g, "potion");
  } else if step == rules::Step.Lit {
    sound(g, "point");
  } else if step == rules::Step.Leaned {
    sound(g, "step_wood", 0.3);
  } else if step == rules::Step.Opened {
    sound(g, if thing == 0 { "door_open" } else { "chest_open" });
  } else if step == rules::Step.Fell {
    sound(g, if rules::alive(w) { "fall" } else { "game_over" }, 1.0);
  } else if step == rules::Step.Saved {
    sound(g, "save");
  } else if step == rules::Step.Read {
    sound(g, "signpost");
  } else if step == rules::Step.Placed {
    sound(g, "drop");
  } else if step == rules::Step.Climbed {
    sound(g, if w.hero_z > z_before { "climb_up" } else { "climb_down" });
  } else if step == rules::Step.Pushed || step == rules::Step.Pulled {
    snd = theme::thing_sound(g.look, thing);
    sound(g, if snd == "" { "wood" } else { snd });
  } else {
    sound(g, if w.hero_h > 0 { "step_wood" } else { "step" }, 0.6);
  }
}

/// One move: walk (or pull, with `pull`) one cell.  Plays its sound and counts it.
pub fn move(g: Game, dx: integer, dy: integer, pull: boolean) {
  if g.won { return; }
  g.note = "";
  g.asking_back = false;
  g.just_back = false;
  w = g.world;
  z = w.hero_z;
  // What the move will act on: the thing ahead for a push, the thing behind for a pull.
  thing = if pull {
    tile_world::top(w.w, w.hero_x - dx, w.hero_y - dy, z)
  } else {
    tile_world::top(w.w, w.hero_x + dx, w.hero_y + dy, z)
  };
  ox = w.hero_x;
  oy = w.hero_y;
  oz = w.hero_z;
  oh = w.hero_h;
  money = w.money;
  drunk = w.drunk;
  // A door shut until something holds (C9: the barn, once the bargain is struck).
  sd = levels::door_at(g.file, w.hero_x + dx, w.hero_y + dy, z);
  if !pull && sd >= 0 && g.file.doors[sd]!.needs != "" && !rules::holds(w, g.file.doors[sd]!.needs) {
    g.note = "SHUT";
    return;
  }
  step = if pull { rules::pull(w, dx, dy) } else { rules::walk(w, dx, dy) };
  if w.drunk > drunk { sound(g, "potion"); }
  if w.money > money { sound(g, "coins"); }
  animate(g, step, ox, oy, oz, oh, dx, dy);
  if step == rules::Step.Read { g.note = chests_left(rules::closed(w)); }
  if step == rules::Step.Talked { talk_to(g, g.world.talk_to); }
  if step == rules::Step.Slept { sleep(g); }
  if step == rules::Step.Saved {
    if g.has_save {
      g.previous = g.saved;
      g.previous_place = g.saved_place;
      g.previous_at = g.saved_at;
      g.has_previous = true;
    }
    g.saved = g.world;
    g.saved_place = g.place;
    g.has_save = true;
    mi = materials::at(g.mats, w.w, w.hero_x + dx, w.hero_y + dy, w.hero_z);
    g.saved_at = if (g.mats.list[mi] ?? materials::none_material()).name == "fountain" { "FOUNTAIN" } else { "WELL" };
    g.note = "SAVED";
    if g.save_dir != "" && !write_save(g, g.save_dir) { g.note = "NOT SAVED"; }
  }
  if step != rules::Step.Blocked { g.moves += 1; }
  move_sound(g, step, thing, z);
  if !g.was_boosted && rules::boosted(w) {
    sound(g, "potion");
    sound(g, "strong");
  }
  if solved(g) {
    // In the world a place's goal is met once and play goes on; a level on its own is done.
    if !g.in_world {
      g.won = true;
      sound(g, "win", 1.0);
    } else if !g.solved_places.contains(g.place) {
      g.solved_places += [g.place];
      g.note = "SOLVED!";
      sound(g, "win", 1.0);
    }
  }
  // With no health left, the hero is back at the last well — when it drank from one.
  if !rules::alive(g.world) && g.has_save { return_to_save(g); }
  _ = step_talks(g);
  // A step onto a door takes the hero through it, to the place it leads to.
  moved = g.world.hero_x != ox || g.world.hero_y != oy || g.world.hero_z != oz;
  door = levels::door_at(g.file, g.world.hero_x, g.world.hero_y, g.world.hero_z);
  if moved && door >= 0 && rules::alive(g.world) && g.file.doors[door]!.ends {
    begin_ending(g);
    return;
  }
  if moved && door >= 0 && rules::alive(g.world) && go_through(g, door) { return; }
  aim(g);
}

/// A heavy swing (rules::heavy, @GM-Combat): seen and heard as a swing, counted as a move.
pub fn heavy_swing(g: Game) {
  if g.won { return; }
  step = rules::heavy(g.world);
  if step == rules::Step.Attacked || step == rules::Step.Swung || step == rules::Step.Chopped {
    g.moves += 1;
    motion::swing(g.motion, g.world.now);
    sound(g, if step == rules::Step.Attacked { "hit_enemy" } else { "sword" }, 0.9);
  }
}

/// The hero swings what it holds at the cell it faces (rules::swing): a blow or a swing through
/// the air is seen and heard, and counts as a move; without a weapon nothing happens.
pub fn swing(g: Game) {
  if g.won { return; }
  // A bow shoots: at its locked target, else the way the hero faces.
  if rules::armed_with_bow(g.world) {
    hp = 0;
    for e in g.world.enemies { hp += e.hp; }
    n = len(g.world.enemies);
    if rules::shoot(g.world) == rules::Step.Shot {
      g.moves += 1;
      motion::swing(g.motion, g.world.now);
      sound(g, "sword", 0.4);
      after = 0;
      for e in g.world.enemies { after += e.hp; }
      if after < hp || len(g.world.enemies) < n { sound(g, "hit_enemy", 0.8); }
    }
    return;
  }
  // A bomb in hand is thrown: it rolls off the way the hero faces.
  if rules::throw(g.world) == rules::Step.Thrown {
    g.moves += 1;
    motion::swing(g.motion, g.world.now);
    sound(g, "bomb_roll", 0.6);
    return;
  }
  step = rules::swing(g.world);
  if step == rules::Step.Crafted {
    g.moves += 1;
    motion::swing(g.motion, g.world.now);
    sound(g, "chop", 0.9);
    return;
  }
  if step == rules::Step.Drank {
    g.moves += 1;
    sound(g, "potion");
    return;
  }
  if step == rules::Step.Chopped || step == rules::Step.Swung || step == rules::Step.Attacked {
    g.moves += 1;
    motion::swing(g.motion, g.world.now);
    sound(g, if step == rules::Step.Chopped { "chop" } else if step == rules::Step.Attacked { "hit_enemy" } else { "sword" }, 0.6);
  }
}

// How the hero moves on screen after `step`, taken from (ox, oy, oz) at height oh, trying
// (dx, dy): a step glides there hopping (a fall or a change of layer shows at once); a bump
// staggers it back; a blow (an axe into a tree) is a swing.
fn animate(g: Game, step: rules::Step, ox: integer, oy: integer, oz: integer, oh: integer, dx: integer,
           dy: integer) {
  w = g.world;
  now = w.now;
  if step == rules::Step.Blocked {
    motion::stagger(g.motion, now, -dx, -dy, 0, 0, w.face_x, w.face_y);
  } else if step == rules::Step.Chopped || step == rules::Step.Swung || step == rules::Step.Attacked {
    motion::swing(g.motion, now);
    if step == rules::Step.Attacked { sound(g, "hit_enemy", 0.8); }
  } else if step == rules::Step.Fell {
    g.motion = motion::still();
  } else if w.hero_x != ox || w.hero_y != oy || w.hero_z != oz {
    // A step glides — up or down a slope, and onto another layer, a tile a layer.
    motion::walk(g.motion, now, w.hero_x - ox, w.hero_y - oy,
                 (w.hero_h - oh) * 4 + (w.hero_z - oz) * g.look.tile_size, w.face_x, w.face_y);
  }
}

// The situation saved at the last well, back: the world, the hero, its health.
fn return_to_save(g: Game) {
  back_to_place(g, g.saved_place);
  g.world = g.saved;
  g.motion = motion::still();
  g.movers = [];
  g.asking_back = false;
  g.just_back = true;
  g.note = "BACK AT {g.saved_at}";
  sound(g, "restore");
  aim(g);
}

// Back to a save made in place `name`: when the hero is elsewhere in the world, the place it is
// in is kept as it is now and that place's file is opened.
fn back_to_place(g: Game, name: text) {
  if !g.in_world || name == g.place || name == "" { return; }
  stash(g);
  _ = open_place(g, name);
  g.area = camera::bounds(g.saved.w);
  g.cam_x = g.area.0;
  g.cam_y = g.area.1;
}

// Just sent back to a save that may be doomed: one well further back, which becomes the save —
// there is none before it.
fn return_to_previous(g: Game) {
  g.saved = g.previous;
  g.saved_place = g.previous_place;
  g.saved_at = g.previous_at;
  g.has_previous = false;
  back_to_place(g, g.saved_place);
  g.world = g.saved;
  g.motion = motion::still();
  g.movers = [];
  g.asking_back = false;
  g.just_back = true;
  g.note = "BACK AT EARLIER WELL";
  sound(g, "restore");
  aim(g);
}

/// The player asks to go back to the last well: the first ask only asks ("BACK? B AGAIN"), the
/// second goes.  Answers whether anything changed; false when there is no save.
pub fn back(g: Game) -> boolean {
  if !g.has_save { return false; }
  if !g.asking_back {
    g.asking_back = true;
    g.note = if g.just_back && g.has_previous { "EARLIER? B AGAIN" } else { "BACK? B AGAIN" };
    return true;
  }
  if g.just_back && g.has_previous { return_to_previous(g); } else { return_to_save(g); }
  true
}

// Point the view at the hero, the way the level's file says: "rooms" a screen at a time,
// "follow" a cell at a time near the edge, within the level.
/// Point the view at the hero as play does (for the checks).
pub fn aim_view(g: Game) {
  aim(g);
}

fn aim(g: Game) {
  w = g.world;
  rows = ROWS - 1;
  if g.file.camera == "rooms" {
    g.cam_x = camera::rooms(w.hero_x, COLS, g.area.0);
    g.cam_y = camera::rooms(w.hero_y - w.hero_z, rows, g.area.1 - w.hero_z);
  } else {
    g.cam_x = camera::follow(g.cam_x, w.hero_x, COLS, g.area.0, g.area.2);
    // A raised layer is drawn a row up per layer: the view may go that much higher.
    g.cam_y = camera::follow(g.cam_y, w.hero_y - w.hero_z, rows, g.area.1 - w.hero_z, g.area.3);
  }
}

// The direction held this tick, (0, 0) when none or when a held one is waiting to repeat:
// the first press steps at once, a held one after REPEAT_FIRST and then every REPEAT_NEXT.
fn direction(g: Game, now: integer) -> (integer, integer) {
  dx = 0;
  dy = 0;
  if g.keys.is_action_pressed("left") { dx = -1; }
  if g.keys.is_action_pressed("right") { dx = 1; }
  if g.keys.is_action_pressed("up") { dy = -1; }
  if g.keys.is_action_pressed("down") { dy = 1; }
  if dx != 0 && dy != 0 { dy = 0; }
  if dx == 0 && dy == 0 {
    g.held_since = 0;
    return (0, 0);
  }
  first = g.keys.is_action_just_pressed("left") || g.keys.is_action_just_pressed("right")
          || g.keys.is_action_just_pressed("up") || g.keys.is_action_just_pressed("down");
  if first {
    g.held_since = now;
    g.next_repeat = now + REPEAT_FIRST;
  } else if now < g.next_repeat {
    return (0, 0);
  } else {
    g.next_repeat = now + REPEAT_NEXT;
  }
  (dx, dy)
}

/// Switch between playing and editing.  Leaving the editor play-tests: the level as edited,
/// from the hero's start, on a copy.
pub fn toggle_editor(g: Game) {
  if g.editing {
    g.editing = false;
    // In the world the place as edited, from its start; the other places stay as they were.
    if g.in_world {
      kept: vector<Visited> = [];
      for v in g.places { if v.place != g.place { kept += [v]; } }
      g.places = kept;
      g.has_arrived = false;
      restart(g);
      g.arrived = g.world;
      g.has_arrived = true;
      return;
    }
    restart(g);
    return;
  }
  g.editing = true;
  g.lit = false;
  g.note = "";
  aim_editor(g);
}

// Keep the cursor in sight, one cell from the view's edge.
fn aim_editor(g: Game) {
  g.cam_x = camera::keep(g.cam_x, g.ed.x, COLS, 1);
  // A layer is drawn a row higher: the view keeps the cursor's row on screen.
  g.cam_y = camera::keep(g.cam_y, g.ed.y - g.ed.z, ROWS - 2, 1);
}

/// One editor action by word, as a key would do it: `w` `a` `s` `d` move the cursor, `up` and
/// `down` change layer, `tab` and `back` walk the palette, `paint`, `erase`, `start`, `goal`,
/// `light`, `undo` and `redo`.  For scripts and pictures (main.loft's TW_EDIT); an unknown word
/// does nothing.
pub fn edit(g: Game, word: text) {
  if word == "w" { editor::move(g.ed, 0, -1); }
  else if word == "a" { editor::move(g.ed, -1, 0); }
  else if word == "s" { editor::move(g.ed, 0, 1); }
  else if word == "d" { editor::move(g.ed, 1, 0); }
  else if word == "up" { editor::layer(g.ed, 1); }
  else if word == "down" { editor::layer(g.ed, -1); }
  else if word == "tab" { editor::choose(g.ed, 1); }
  else if word == "back" { editor::choose(g.ed, -1); }
  else if word == "fill" { _ = editor::fill(g.ed, g.file); }
  else if word == "mark" { editor::set_mark(g.ed); }
  else if word == "box" { _ = editor::paint_box(g.ed, g.file); }
  else if word == "pick" { _ = editor::pick_under(g.ed, g.file); }
  else if word == "copy" { editor::copy_box(g.ed, g.file); }
  else if word == "paste" { _ = editor::paste_box(g.ed, g.file); }
  else if word == "check" { g.checking = !g.checking; }
  else if word.starts_with("cat") { _ = editor::jump(g.ed, g.kinds, word[3..] as integer ?? 0); }
  else if word == "paint" { _ = editor::paint(g.ed, g.file); }
  else if word == "erase" { _ = editor::erase(g.ed, g.file); }
  else if word == "raise" { _ = editor::raise(g.ed, g.file, 1); }
  else if word == "lower" { _ = editor::raise(g.ed, g.file, -1); }
  else if word == "start" { _ = editor::set_start(g.ed, g.file); }
  else if word == "goal" { _ = editor::set_goal(g.ed, g.file); }
  else if word == "light" { g.lit = !g.lit; }
  else if word == "undo" { _ = editor::undo(g.ed, g.file); }
  else if word == "redo" { _ = editor::redo(g.ed, g.file); }
  // A figure picked (A1), a door or text set on the cursor's cell (A2; `_` a space), a tag
  // served (A3): `figure=rat`, `door=the_farm`, `text=TO_THE_FARM`, `serve=@ST-Hints`.
  else if word.starts_with("figure=") { pick_figure(g, word[7..]); }
  else if word.starts_with("door=") { _ = editor::set_door(g.ed, g.file, word[5..], here(g)); }
  else if word.starts_with("text=") { _ = editor::set_label(g.ed, g.file, word[5..].replace("_", " ")); }
  else if word.starts_with("serve=") { _ = editor::serve(g.file, word[6..]); }
  aim_editor(g);
}

// The name of the place being edited: in the world, the place; a level alone, its file's name.
fn here(g: const Game) -> text {
  if g.place != "" { return g.place; }
  g.order[g.level] ?? ""
}

// Pick the palette's figure of `kind` (A1).
fn pick_figure(g: Game, kind: text) {
  for i in 0..len(g.ed.palette) { if g.ed.palette[i]!.figure == kind { g.ed.pick = i; } }
}

/// Write the level being edited to its file.  False when it could not be written.
pub fn save(g: Game) -> boolean {
  g.file.adjusted = editor::adjusted(g.ed, g.file);
  file(level_path(g, g.level)).write(levels::save_with(g.file, g.mats)).ok()
}

// The palette category key pressed this tick (`1`..`9`), 0 for none.
fn category_pressed(k: const input::InputState) -> integer {
  for n in 1..=9 {
    if k.is_action_just_pressed("category{n}") { return n; }
  }
  0
}

// The editor's keys this tick (EDITOR.md § 4).  Answers whether the picture changed.
fn update_editor(g: Game, now: integer) -> boolean {
  k = g.keys;
  if k.is_key_down(KEY_CTRL) {
    if k.is_action_just_pressed("undo") {
      g.note = if editor::undo(g.ed, g.file) { "" } else { "NOTHING TO UNDO" };
    } else if k.is_action_just_pressed("redo") {
      g.note = if editor::redo(g.ed, g.file) { "" } else { "NOTHING TO REDO" };
    } else if k.is_action_just_pressed("save") {
      g.note = if save(g) { "SAVED" } else { "NOT SAVED!" };
    } else if k.is_action_just_pressed("open") {
      if load_level(g, (g.level + 1) % len(g.order) ?? 0) { g.note = g.file.name; }
    } else {
      return false;
    }
    aim_editor(g);
    return true;
  }
  if k.is_action_just_pressed("test") {
    toggle_editor(g);
    return true;
  }
  changed = true;
  if k.is_action_just_pressed("layer_up") { editor::layer(g.ed, 1); }
  else if k.is_action_just_pressed("layer_down") { editor::layer(g.ed, -1); }
  else if k.is_action_just_pressed("palette") { editor::choose(g.ed, if k.is_key_down(KEY_SHIFT) { -1 } else { 1 }); }
  else if k.is_action_just_pressed("paint") { _ = editor::paint(g.ed, g.file); }
  else if k.is_action_just_pressed("erase") { _ = editor::erase(g.ed, g.file); }
  else if k.is_key_down(KEY_SHIFT) && (k.is_action_just_pressed("raise") || k.is_action_just_pressed("lower")) {
    // Shift+] raises the ceiling over the cursor, Shift+[ lowers it; the 2D does not draw it, so
    // the note says where it is.
    _ = editor::lower_ceiling(g.ed, g.file, if k.is_action_just_pressed("raise") { -1 } else { 1 });
    g.note = ceiling_note(g);
    aim_editor(g);
    return true;
  }
  else if k.is_action_just_pressed("raise") { _ = editor::raise(g.ed, g.file, 1); }
  else if k.is_action_just_pressed("lower") { _ = editor::raise(g.ed, g.file, -1); }
  else if k.is_action_just_pressed("slant") { _ = editor::turn_slant(g.ed, g.file, if k.is_key_down(KEY_SHIFT) { -1 } else { 1 }); }
  else if k.is_action_just_pressed("start") { _ = editor::set_start(g.ed, g.file); }
  else if k.is_action_just_pressed("goal") { _ = editor::set_goal(g.ed, g.file); }
  else if k.is_action_just_pressed("light") { g.lit = !g.lit; }
  else if k.is_action_just_pressed("fill") { _ = editor::fill(g.ed, g.file); }
  else if k.is_action_just_pressed("rect") {
    if g.ed.marked { _ = editor::paint_box(g.ed, g.file); } else { editor::set_mark(g.ed); }
  }
  else if k.is_action_just_pressed("pick") { _ = editor::pick_under(g.ed, g.file); }
  else if k.is_action_just_pressed("copy") { editor::copy_box(g.ed, g.file); }
  else if k.is_action_just_pressed("paste") { _ = editor::paste_box(g.ed, g.file); }
  else if k.is_action_just_pressed("check") { g.checking = !g.checking; }
  else if category_pressed(k) > 0 { _ = editor::jump(g.ed, g.kinds, category_pressed(k)); }
  else {
    d = direction(g, now);
    if d.0 == 0 && d.1 == 0 { return false; }
    editor::move(g.ed, d.0, d.1);
  }
  g.note = "";
  aim_editor(g);
  changed
}

// What the editor says of the ceiling over its cursor, which the 2D does not draw.
fn ceiling_note(g: const Game) -> text {
  c = tile_world::ceiling(g.file.level.w, g.ed.x, g.ed.y, g.ed.z);
  if c == 0 { "CEILING AT THE LAYER ABOVE" } else { "CEILING {c} DOWN" }
}

// What a signpost says: how many chests are still closed.
fn chests_left(n: integer) -> text {
  if n == 0 { return "ALL OPEN!"; }
  if n == 1 { return "1 CHEST LEFT"; }
  "{n} CHESTS LEFT"
}

/// Advance the world's clock by `ms` and read the keys of this tick (already fed into
/// `g.keys`); `now` is the time in milliseconds.  Answers whether the picture changed, and
/// false for "quit" through `g.won`... see `quit`.
pub fn update(g: Game, ms: integer, now: integer) -> boolean {
  if !g.logging {
    g.world.log_on = false;
    g.world.log = [];
    return update_play(g, ms, now);
  }
  g.world.log_on = true;
  w = g.world;
  was = "{hero_state(g)}";
  struck = w.struck;
  parries = w.parries;
  blocks = w.blocks;
  misses = w.misses;
  changed = update_play(g, ms, now);
  // The place may have changed: its world is another, logging too.
  g.world.log_on = true;
  w = g.world;
  for line in w.log { g.log += [line]; }
  w.log = [];
  state = hero_state(g);
  if state != was { g.log += ["clock {w.now}  hero {state}"]; }
  if w.struck != struck { g.log += ["clock {w.now}  hero swings (blow {w.struck}), ready at {w.blow_until}"]; }
  if w.parries != parries { g.log += ["clock {w.now}  hero parries a blow"]; }
  if w.blocks != blocks { g.log += ["clock {w.now}  hero blocks a blow"]; }
  if w.misses != misses { g.log += ["clock {w.now}  an enemy's blow misses"]; }
  changed
}

// The hero as the play log tells it: its place and cell (and its body's offset roaming free), the
// way it faces, what it holds and wears, its health, guarding, editing.
fn hero_state(g: const Game) -> text {
  w = g.world;
  held = if w.hero_item == 0 { "nothing" } else { rules::thing_name(w.k, w.hero_item) };
  s = "{g.place} ({w.hero_x},{w.hero_y},{w.hero_z}) faces ({w.face_x},{w.face_y}) holds {held}";
  if w.shoulder != 0 { s += " wears {rules::thing_name(w.k, w.shoulder)}"; }
  s += " health {w.health}";
  if w.spirit > 0 { s += "+{w.spirit}"; }
  if w.blocking { s += " guarding"; }
  if g.free { s += " free ({g.free_x},{g.free_y})/256"; }
  if g.editing { s += " editing"; }
  s
}

fn update_play(g: Game, ms: integer, now: integer) -> boolean {
  // A field has the keyboard: the keys are text, not commands.
  if g.typing { return false; }
  // F4: a mark in the play log where something felt off, numbered, so the player can say "the
  // second" and the log shows where and when; the status line answers with its number.
  if g.keys.is_action_just_pressed("mark") {
    g.marks += 1;
    g.log += ["clock {g.world.now}  MARK {g.marks}  {hero_state(g)} height {g.world.hero_h}"];
    g.note = "MARK {g.marks}";
    return true;
  }
  if g.keys.is_action_just_pressed("edit") {
    toggle_editor(g);
    return true;
  }
  if g.editing { return update_editor(g, now); }
  // The epilogue: a still for STILL_MS, or until a key; the last stays.
  if g.ending {
    g.still_ms += ms;
    if g.still < len(g.stills) && (g.still_ms >= STILL_MS || (ms > 0 && any_key(g))) { show_still(g, g.still + 1); }
    return true;
  }
  changed = false;
  frame = g.world.now / theme::FRAME_MS;
  held = g.world.hero_item;
  flames = len(g.world.flames);
  rolled = g.world.rolled;
  blasted = g.world.blasted;
  spotted = g.world.spotted;
  hurled = g.world.hurled;
  struck = g.world.struck;
  held_by = g.world.held_by;
  health = g.world.health + g.world.spirit;
  hx = g.world.hero_x;
  hy = g.world.hero_y;
  winds = g.world.winds;
  cries = g.world.cries;
  parries = g.world.parries;
  misses = g.world.misses;
  blocks = g.world.blocks;
  ripostes = g.world.ripostes;
  rules::tick(g.world, ms);
  g.clock += ms;
  keep_time(g);
  if step_talks(g) { changed = true; }
  // Combat's tells (@GM-Combat): a wind-up is heard as it starts; a parry rings; a blow that misses
  // is a swish.  While any enemy winds up, the picture moves.
  if g.world.winds != winds { sound(g, "grab", 0.35); }
  // A template's cry (TEMPLATES.md): a bat's chirp as it begins its swoop.
  if g.world.cries != cries { sound(g, "point", 0.5); }
  if g.world.misses != misses { sound(g, "bump", 0.4); }
  // A parry (@GM-Combat): a bright ring and a big spark where the weapons meet; the enemy's blow
  // turned aside flings it back twice as hard as a hit, and it is left open (drawn so).
  if g.world.parries != parries {
    sound(g, "parry", 1.0);
    spark(g, true);
    foe = rules::enemy_at(g.world, g.world.hero_x + g.world.face_x, g.world.hero_y + g.world.face_y, g.world.hero_z);
    fe = if foe >= 0 { g.world.enemies[foe] } else { null };
    if fe {
      for i in 0..len(g.movers) {
        if (g.movers[i].id ?? 0) == fe.id {
          motion::stagger(g.movers[i].motion, g.world.now, g.world.face_x, g.world.face_y, 0, 0, fe.face_x, fe.face_y, 2);
        }
      }
    }
    changed = true;
  }
  // A block: a dull knock and a small spark; the enemy's strike is seen, and the hero, guard
  // held, is pushed back — not staggered, even when the blow cost half its damage.
  blocked = g.world.blocks != blocks;
  if blocked {
    sound(g, "block", 1.0);
    spark(g, false);
    foe = rules::enemy_at(g.world, g.world.hero_x + g.world.face_x, g.world.hero_y + g.world.face_y, g.world.hero_z);
    fe = if foe >= 0 { g.world.enemies[foe] } else { null };
    if fe {
      for i in 0..len(g.movers) {
        if (g.movers[i].id ?? 0) == fe.id { motion::swing(g.movers[i].motion, g.world.now); }
      }
    }
    motion::brace(g.motion, g.world.now, -g.world.face_x, -g.world.face_y);
    changed = true;
  }
  // A riposte: a heavy crack, and the enemy reels twice as far (follow_enemies).
  if g.world.ripostes != ripostes {
    sound(g, "riposte", 1.0);
    g.riposted_at = g.world.now;
  }
  for e in g.world.enemies { if e.wind_until > g.world.now { changed = true; } }
  // A rolling cart is heard before it is seen: every cell it rolls rumbles; a hit hurts.
  if g.world.rolled != rolled {
    sound(g, "cart", 0.5);
    changed = true;
  }
  // A cyclops that spots the hero shouts.
  if g.world.spotted != spotted { sound(g, "spotted", 1.0); }
  // A cyclops's bomb is heard rolling; its hands grabbing the hero are heard too.
  if g.world.hurled != hurled { sound(g, "bomb_roll", 0.6); }
  // A blow remembered while the hero recovered lands now: it swings.
  if g.world.struck != struck {
    motion::swing(g.motion, g.world.now);
    sound(g, "sword", 0.6);
    changed = true;
  }
  if g.world.held_by != 0 && held_by == 0 { sound(g, "grab", 1.0); }
  // A blast is heard, however far; while bombs roll and blasts flash the picture moves.
  if g.world.blasted != blasted {
    sound(g, "explosion", 1.0);
    changed = true;
  }
  if rules::blasting(g.world) || len(g.world.enemies) > 0 || g.world.aiming || len(g.sparks) > 0 { changed = true; }
  // Wounded, the hero sways: the picture moves.
  if hurt(g.world.health, g.world.k.health) { changed = true; }
  if g.world.health + g.world.spirit < health && blocked {
    // Half a blow came through the guard: heard, not staggered.
    sound(g, "hit_hero", 0.5);
  } else if g.world.health + g.world.spirit < health {
    sound(g, "hit_hero", 1.0);
    changed = true;
    // A bite: the enemies beside the hero, facing it, lunge.
    for e in g.world.enemies {
      if e.z == g.world.hero_z && e.x + e.face_x == g.world.hero_x && e.y + e.face_y == g.world.hero_y {
        for i in 0..len(g.movers) {
          if (g.movers[i].id ?? 0) == e.id { motion::swing(g.movers[i].motion, g.world.now); }
        }
      }
    }
    // Hit: the hero staggers — shoved aside, it glides there staggering the way it was shoved.
    mx = g.world.hero_x - hx;
    my = g.world.hero_y - hy;
    kx = if mx != 0 || my != 0 { mx } else { -g.world.face_x };
    ky = if mx != 0 || my != 0 { my } else { -g.world.face_y };
    motion::stagger(g.motion, g.world.now, kx, ky, mx, my, g.world.face_x, g.world.face_y);
    // Run down by a cart with no health left: back at the last well, as after a fall.
    if !rules::alive(g.world) && g.has_save { return_to_save(g); }
  }
  // A flame flickers (its next frame), burns low or burns out: the picture moves.
  if rules::burning(g.world) && g.world.now / theme::FRAME_MS != frame { changed = true; }
  if len(g.world.flames) != flames { changed = true; }
  if held != g.world.hero_item {
    sound(g, "weak");
    changed = true;
  }
  boosted = rules::boosted(g.world);
  if g.was_boosted && !boosted { sound(g, "weak"); changed = true; }
  if g.was_boosted != boosted { changed = true; }
  g.was_boosted = boosted;
  if g.keys.is_action_just_pressed("restart") {
    restart(g);
    return true;
  }
  // On screen the hero moves until its act is over, and is drawn once more standing still.
  moving = motion::busy(g.motion, g.world.now);
  if moving || g.was_moving { changed = true; }
  g.was_moving = moving;
  if !g.won && g.keys.is_action_just_pressed("back") { return back(g); }
  if !g.won && g.keys.is_action_just_pressed("aim") {
    if rules::aim_next(g.world) { sound(g, "point", 0.3); }
    return true;
  }
  // The swing (@GM-Combat): a bow shoots and a bomb is thrown on the press; a weapon swings when the
  // key is let go — held HEAVY_HOLD_MS or more, a heavy swing.
  if !g.won && g.keys.is_action_just_pressed("swing") {
    if rules::armed_with_bow(g.world) || rules::is_bomb_held(g.world) || rules::is_potion_held(g.world) {
      swing(g);
      return true;
    }
    g.swing_down_at = now;
    return true;
  }
  if !g.won && g.swing_down_at >= 0 && !g.keys.is_action_pressed("swing") {
    held = now - g.swing_down_at;
    g.swing_down_at = -1;
    if held >= HEAVY_HOLD_MS { heavy_swing(g); } else { swing(g); }
    return true;
  }
  if g.swing_down_at >= 0 { changed = true; }
  // Block and parry (@GM-Combat, as built): the guard key (Shift) with no way pressed — held, a
  // block; the moment it goes down, a parry.  The clash replaces both (BUILD.md B1c step 4).
  still = !g.keys.is_action_pressed("left") && !g.keys.is_action_pressed("right")
          && !g.keys.is_action_pressed("up") && !g.keys.is_action_pressed("down");
  guarding = g.world.blocking;
  g.world.blocking = still && g.keys.is_action_pressed("guard");
  if g.world.blocking != guarding { changed = true; }
  if !g.won && still && g.keys.is_action_just_pressed("guard") {
    rules::parry(g.world);
    motion::flick(g.motion, g.world.now);
    changed = true;
  }
  // Q (owner, 2026-11-07): down, it waits; let go with no step taken while it was held, it takes a
  // small item or puts the held one down; a step taken while it is held is a pull.
  if g.keys.is_action_just_pressed("take") {
    g.take_down = true;
    g.take_stepped = false;
  }
  if g.take_down && !g.keys.is_action_pressed("take") {
    g.take_down = false;
    if !g.won && !g.take_stepped { take(g); }
    return true;
  }
  if g.won && g.keys.is_action_just_pressed("next") {
    start_level(g, (g.level + 1) % len(g.order) ?? 0);
    return true;
  }
  if g.keys.is_action_just_pressed("free") {
    g.free = !g.free;
    g.free_x = 0;
    g.free_y = 0;
    g.note = if g.free { "FREE ROAMING" } else { "ON THE TILES" };
    return true;
  }
  if g.free { return roam(g, ms) || changed; }
  d = direction(g, now);
  if d.0 == 0 && d.1 == 0 { return changed; }
  pulling = g.take_down && g.keys.is_action_pressed("take");
  if pulling { g.take_stepped = true; }
  move(g, d.0, d.1, pulling);
  true
}

/// A cell per FREE_CELL_MS while roaming free (F3): the walking pace.
const FREE_CELL_MS = 140;

// Free roaming (F3): the keys held move the hero's body `ms` worth — diagonals at the same pace —
// and crossing half a cell takes the step there through the rules (a walk, a push, a pull with Q
// held, a climb, a door), its glide left out: the body is already there.  A refused step stops
// the body short of the cell's edge and is not tried again while that key is held.  Answers
// whether the picture moved.
fn roam(g: Game, ms: integer) -> boolean {
  dx = 0;
  dy = 0;
  if g.keys.is_action_pressed("left") { dx -= 1; }
  if g.keys.is_action_pressed("right") { dx += 1; }
  if g.keys.is_action_pressed("up") { dy -= 1; }
  if g.keys.is_action_pressed("down") { dy += 1; }
  if dx != g.free_stop_x { g.free_stop_x = 0; }
  if dy != g.free_stop_y { g.free_stop_y = 0; }
  if dx == 0 && dy == 0 { return false; }
  // Facing the way it goes: across first, as the keys read.
  g.world.face_x = if dx != 0 { dx } else { 0 };
  g.world.face_y = if dx != 0 { 0 } else { dy };
  pace = 256 * ms / FREE_CELL_MS ?? 0;
  if dx != 0 && dy != 0 { pace = pace * 181 / 256 ?? 0; }
  if g.free_stop_x == 0 { g.free_x += dx * pace; }
  if g.free_stop_y == 0 { g.free_y += dy * pace; }
  pulling = g.take_down && g.keys.is_action_pressed("take");
  if pulling { g.take_stepped = true; }
  cross_x(g, pulling);
  cross_y(g, pulling);
  true
}

// The body past half a cell east or west: the step there; refused, the body stays short of it.
fn cross_x(g: Game, pulling: boolean) {
  while g.free_x >= 128 || g.free_x < -128 {
    s = if g.free_x > 0 { 1 } else { -1 };
    place = g.place;
    ox = g.world.hero_x;
    move(g, s, 0, pulling);
    g.world.face_x = s;
    g.world.face_y = 0;
    if g.place != place {
      g.free_x = 0;
      g.free_y = 0;
      return;
    }
    if g.world.hero_x == ox {
      g.free_x = s * 120;
      g.free_stop_x = s;
      return;
    }
    g.free_x -= s * 256;
    g.motion = motion::still();
  }
}

// The same north and south.
fn cross_y(g: Game, pulling: boolean) {
  while g.free_y >= 128 || g.free_y < -128 {
    s = if g.free_y > 0 { 1 } else { -1 };
    place = g.place;
    oy = g.world.hero_y;
    move(g, 0, s, pulling);
    if g.place != place {
      g.free_x = 0;
      g.free_y = 0;
      return;
    }
    if g.world.hero_y == oy {
      g.free_y = s * 120;
      g.free_stop_y = s;
      return;
    }
    g.free_y -= s * 256;
    g.motion = motion::still();
  }
}

// Q let go with no step: the small item taken (heard picked up), or the held one put down.
fn take(g: Game) {
  w = g.world;
  drunk = w.drunk;
  step = rules::take(w);
  if step == rules::Step.Took || step == rules::Step.Swapped {
    g.moves += 1;
    sound(g, "pickup");
  } else if step == rules::Step.Placed {
    g.moves += 1;
    sound(g, "drop");
  }
  if w.drunk > drunk { sound(g, "potion"); }
}

// The hero spoke to (walked into) the one with id `id`: its talk goes on (talk.loft).
fn talk_to(g: Game, id: integer) {
  for e in 0..len(g.world.enemies) {
    if (g.world.enemies[e]!.id) != id { continue; }
    ti = talk::of(g.file.talks, g.world, e);
    if ti < 0 { continue; }
    for t in g.file.talks[ti..ti + 1] {
      o = talk::owner(t, g.world);
      if o >= 0 { talk::bump(t, g.world, o, e); }
    }
  }
}

// Every talk of the place at its clock and the hero's place: answers whether what is said changed.
fn step_talks(g: Game) -> boolean {
  changed = false;
  for t in g.file.talks {
    o = talk::owner(t, g.world);
    if o >= 0 && talk::step(t, g.world, o) { changed = true; }
  }
  changed
}

/// Has the player asked to stop?
pub fn quit(g: const Game) -> boolean {
  g.keys.is_action_just_pressed("quit")
}

/// Was the zoom key (`m`) just pressed?
pub fn zoom_pressed(g: const Game) -> boolean {
  g.keys.is_action_just_pressed("zoom")
}

/// Where the hero is drawn, in the view's units: the middle of its body, gliding and hopping as
/// it is drawn — the point a camera closes in on.
pub fn hero_point(g: const Game) -> (float, float) {
  w = g.world;
  ts = g.look.tile_size;
  p = motion::fine_pose(g.motion, w.face_x, w.face_y, w.now);
  off = free_offset(g);
  half = (ts as float) / 2.0;
  (((w.hero_x - g.cam_x) * ts) as float + p.x + off.0 + half,
   ((w.hero_y - g.cam_y) * ts - w.hero_z * ts - w.hero_h * 4) as float + p.y + off.1 + half)
}

/// The hero's body off its cell while roaming free (F3), in pixels; (0, 0) on the tiles.
pub fn free_offset(g: const Game) -> (float, float) {
  if !g.free { return (0.0, 0.0); }
  ts = (g.look.tile_size as float);
  ((g.free_x as float) * ts / 256.0, (g.free_y as float) * ts / 256.0)
}

// --- The picture ---

// Cell (x, y, z) of `w`, at its place in the view.
/// The ground around the view: for each cell one beyond it on every side, its height in steps
/// over this layer's floor — its rise, or over the void a cell of the layer above (a layer's
/// steps up) or below (down) — whether it has one, its light (a shade, 0 .. 7), whether it is set
/// (not the void) and whether it is this layer's ground (set, not standing up): what a cell's
/// corners are made of, so ground meets ground across a layer's edge too.
struct Ground {
  x0: integer,
  y0: integer,
  w: integer,
  h: integer,
  rise: vector<integer>,
  has: vector<boolean>,
  shade: vector<integer>,
  set: vector<boolean>,
  ground: vector<boolean>
}

fn ground_of(g: const Game, w: const rules::Level, z: integer, rows: integer, lit: boolean) -> Ground {
  out = Ground { x0: g.cam_x - 1, y0: g.cam_y + z - 1, w: COLS + 2, h: rows + 2, rise: [], has: [], shade: [], set: [], ground: [] };
  steps = w.k.layer_height;
  if lit {
    out.shade = tile_world::shades(w.w, out.x0, out.y0, out.x0 + out.w - 1, out.y0 + out.h - 1, z,
                                   rules::lights(w, z), rules::light_starts(w, z), !w.night);
  }
  for j in 0..out.h {
    for i in 0..out.w {
      x = out.x0 + i;
      y = out.y0 + j;
      k = tile_world::terrain(w.w, x, y, z);
      own = k != tile_world::VOID && !theme::upright(g.look, k);
      up = tile_world::terrain(w.w, x, y, z + 1);
      down = tile_world::terrain(w.w, x, y, z - 1);
      h = 0;
      has = own;
      if own {
        h = tile_world::rise(w.w, x, y, z);
      } else if k == tile_world::VOID && up != tile_world::VOID && !theme::upright(g.look, up) {
        h = steps + tile_world::rise(w.w, x, y, z + 1);
        has = true;
      } else if k == tile_world::VOID && down != tile_world::VOID && !theme::upright(g.look, down) {
        h = tile_world::rise(w.w, x, y, z - 1) - steps;
        has = true;
      }
      out.rise += [h];
      out.has += [has];
      out.set += [k != tile_world::VOID];
      out.ground += [own];
    }
  }
  out
}

// Cell (x, y)'s corner (cx, cy) — 0 or 1 each, (0, 0) top-left — lifted and darkened: the
// lift, in pixels, the mean rise of the ground cells sharing the corner that are within a step
// of this one (a slope bends; a drop of more leaves a bank); the darkness, in sixteenths of a
// shade, the mean light of the ground cells sharing it, never lighter than `dim` — light fades
// across the ground, not through a wall.  A top corner of a cell within a step of the ground
// north of it is that cell's bottom corner, so the two meet without a seam: a bank shows only
// at a drop of two steps or more.
fn corner(gr: const Ground, x: integer, y: integer, cx: integer, cy: integer, dim: integer) -> (integer, integer) {
  me = (y - gr.y0) * gr.w + (x - gr.x0);
  r0 = gr.rise[me] ?? 0;
  north = me - gr.w;
  if cy == 0 && y - 1 > gr.y0 && (gr.has[north] ?? false) {
    rn = gr.rise[north] ?? 0;
    if rn - r0 <= 1 && r0 - rn <= 1 { return corner_of(gr, x, y - 1, cx, 1, dim); }
  }
  corner_of(gr, x, y, cx, cy, dim)
}

// Corner (cx, cy) of cell (x, y), lifted and darkened as `corner` describes, measured where it
// is: `corner` has already moved a top corner onto the bottom corner of the cell north of it.
fn corner_of(gr: const Ground, x: integer, y: integer, cx: integer, cy: integer, dim: integer) -> (integer, integer) {
  me = (y - gr.y0) * gr.w + (x - gr.x0);
  r0 = gr.rise[me] ?? 0;
  rs = 0;
  rn = 0;
  ss = 0;
  sn = 0;
  for d in [(cx - 1, cy - 1), (cx, cy - 1), (cx - 1, cy), (cx, cy)] {
    i = me + d.1 * gr.w + d.0;
    if !(gr.has[i] ?? false) { continue; }
    r = gr.rise[i] ?? 0;
    if r - r0 <= 1 && r0 - r <= 1 {
      rs += r;
      rn += 1;
    }
    if !(gr.ground[i] ?? false) { continue; }
    sh = gr.shade[i] ?? 0;
    ss += if sh < dim { dim } else { sh };
    sn += 1;
  }
  lift = if rn == 0 { r0 * 4 } else { ((rs * 8 + rn) / (2 * rn))! };
  dark = if sn == 0 { dim * 16 } else { ((ss * 32 + sn) / (2 * sn))! };
  (lift, dark)
}

// The ground of cell (x, y, z): what lies under its kind (a rail's floor, a tree's) and the kind
// itself when it is flat, bent to its corners' lifts and lit by their light; and, where it
// stands higher than the ground south of it, the bank between, its ground darkened two shades;
// ground falling away from the light (the top left) a little darker.
fn draw_ground(g: Game, w: const rules::Level, gr: const Ground, x: integer, y: integer, z: integer,
               upper: boolean, dim: integer) {
  ts = g.look.tile_size;
  px = (x - g.cam_x) * ts;
  py = (y - g.cam_y) * ts - g.lift;
  k = tile_world::terrain(w.w, x, y, z);
  tl = corner(gr, x, y, 0, 0, dim);
  tr = corner(gr, x, y, 1, 0, dim);
  bl = corner(gr, x, y, 0, 1, dim);
  br = corner(gr, x, y, 1, 1, dim);
  lift = (tl.0, tr.0, bl.0, br.0);
  // The light comes from the top left, as in the pictures: ground falling away from it (its
  // top-left corner higher than its bottom-right) is darker, a shade for a step of slope, two at
  // most — so a mound and a ramp read as such.
  away = (tl.0 - br.0) * 4;
  away = if away < 0 { 0 } else if away > 32 { 32 } else { away };
  dark = (tl.1 + away, tr.1 + away, bl.1 + away, br.1 + away);
  // What it stands on: its material's `under` (a tree on grass), else its kind's (on floor).
  mu = materials::under_tile(g.mats, w.w, x, y, z);
  under = theme::under(g.look, k);
  base = if mu != 0 { theme::tile_sprite(g.look, mu) } else if under != 0 { theme::terrain_sprite(g.look, under, x, y, false) } else { -1 };
  // A slanted upright cell (DESIGN.md § Slanted rock) shows the ground beside its open half under
  // it: the ground of a neighbour on that side, on this layer.  None there (a cave's upper layer)
  // leaves the half open onto what lies below.
  way = tile_world::slant(w.w, x, y, z);
  if base < 0 && way != 0 && theme::upright(g.look, k) {
    beside = open_beside(g, w, x, y, z, way);
    if beside >= 0 { theme::put_ground(g.surface, beside, px, py, lift, dark); }
  }
  if base >= 0 { theme::put_ground(g.surface, base, px, py, lift, dark); }
  if !theme::upright(g.look, k) {
    own = kind_sprite(g, w, x, y, z, upper);
    theme::put_ground(g.surface, own, px, py, lift, dark);
    if base < 0 { base = own; }
  }
  // The bank: from this cell's bottom edge down to the top edge of the ground south of it — or,
  // with no ground there (a wall, the void), down to its own base.  None where a wall stands
  // under this cell on the layer below: that wall's face is this cell's side (a roof over a
  // house's front wall shows the wall and its door, not a bank).
  south = (y + 1 - gr.y0) * gr.w + (x - gr.x0);
  if theme::upright(g.look, tile_world::terrain(w.w, x, y, z - 1)) {
    // the wall below shows
  } else if base >= 0 && (gr.has[south] ?? false) {
    sl = corner(gr, x, y + 1, 0, 0, dim);
    sr = corner(gr, x, y + 1, 1, 0, dim);
    if bl.0 > sl.0 || br.0 > sr.0 {
      theme::put_ground(g.surface, base, px, py + ts, (bl.0, br.0, ts + sl.0, ts + sr.0),
                        (bl.1 + 32, br.1 + 32, sl.1 + 32, sr.1 + 32));
    }
  } else if base >= 0 && (bl.0 > 0 || br.0 > 0) {
    theme::put_ground(g.surface, base, px, py + ts, (bl.0, br.0, ts, ts), (bl.1 + 32, br.1 + 32, bl.1 + 32, br.1 + 32));
  }
}

// The light at corner (cx, cy) of a standing cell (a wall): the mean of every set cell sharing
// it, walls and ground alike, never lighter than `dim`, in sixteenths of a shade.
fn standing_light(gr: const Ground, x: integer, y: integer, cx: integer, cy: integer, dim: integer) -> integer {
  me = (y - gr.y0) * gr.w + (x - gr.x0);
  ss = 0;
  sn = 0;
  for d in [(cx - 1, cy - 1), (cx, cy - 1), (cx - 1, cy), (cx, cy)] {
    i = me + d.1 * gr.w + d.0;
    if !(gr.set[i] ?? false) { continue; }
    sh = gr.shade[i] ?? 0;
    ss += if sh < dim { dim } else { sh };
    sn += 1;
  }
  if sn == 0 { dim * 16 } else { ((ss * 32 + sn) / (2 * sn))! }
}

// The ground picture beside the open half of a cell slanted `toward`: of its neighbour on that
// corner's north or south side, else its east or west one — the first set and flat; -1 for none.
fn open_beside(g: const Game, w: const rules::Level, x: integer, y: integer, z: integer, toward: integer) -> integer {
  dy = if toward == tile_world::NORTH_EAST || toward == tile_world::NORTH_WEST { -1 } else { 1 };
  dx = if toward == tile_world::NORTH_EAST || toward == tile_world::SOUTH_EAST { 1 } else { -1 };
  for n in [(x, y + dy), (x + dx, y)] {
    nk = tile_world::terrain(w.w, n.0, n.1, z);
    if nk == tile_world::VOID || theme::upright(g.look, nk) { continue; }
    return kind_sprite(g, w, n.0, n.1, z, false);
  }
  -1
}

// What stands on cell (x, y, z): its kind when it stands up (a wall, a tree), and its stack.
fn draw_standing(g: Game, w: const rules::Level, gr: const Ground, x: integer, y: integer, z: integer,
                 upper: boolean, dim: integer, shade: integer, things: boolean = true) {
  if theme::upright(g.look, tile_world::terrain(w.w, x, y, z)) {
    // Standing at its rise, lit gradually like the ground beside it.
    ts = g.look.tile_size;
    up = tile_world::rise(w.w, x, y, z) * 4;
    look = theme::slant_sprite(g.look, kind_sprite(g, w, x, y, z, upper), tile_world::slant(w.w, x, y, z));
    theme::put_ground(g.surface, look, (x - g.cam_x) * ts, (y - g.cam_y) * ts - g.lift,
                      (up, up, up, up),
                      (standing_light(gr, x, y, 0, 0, dim), standing_light(gr, x, y, 1, 0, dim),
                       standing_light(gr, x, y, 0, 1, dim), standing_light(gr, x, y, 1, 1, dim)));
  }
  if things { draw_stack(g, w, x, y, z, shade); }
}

// The picture of cell (x, y, z)'s terrain kind: a rail cell the piece of track its joins name
// (what a cart follows is what is seen); a line (a fence) across or along its neighbours of
// the same kind; a material's cell its own picture (its tile number); any other the kind's look.
pub fn kind_sprite(g: const Game, w: const rules::Level, x: integer, y: integer, z: integer, upper: boolean) -> integer {
  k = tile_world::terrain(w.w, x, y, z);
  own = theme::tile_sprite(g.look, tile_world::tile(w.w, x, y, z));
  track = if rules::is_rail(w, k) && own < 0 { theme::track_sprite(g.look, rules::joins(w, x, y, z)) } else { -1 };
  if track >= 0 { return track; }
  if theme::is_line(g.look, k) {
    across = tile_world::terrain(w.w, x - 1, y, z) == k || tile_world::terrain(w.w, x + 1, y, z) == k;
    return theme::line_sprite(g.look, k, across);
  }
  // A door to a place that is shut until something holds (C9, the barn) is drawn closed.
  if k == rules::tr(w, "open_door") {
    for d in g.file.doors {
      if d.x == x && d.y == y && d.z == z && d.needs != "" && !rules::holds(w, d.needs) {
        return theme::terrain_sprite(g.look, rules::tr(w, "door"), x, y, upper);
      }
    }
  }
  if own >= 0 { own } else { theme::terrain_sprite(g.look, k, x, y, upper) }
}

// The stack on cell (x, y, z).
fn draw_stack(g: Game, w: const rules::Level, x: integer, y: integer, z: integer, shade: integer) {
  ts = g.look.tile_size;
  px = (x - g.cam_x) * ts;
  py = (y - g.cam_y) * ts - g.lift;
  // The stack, bottom first, each thing lifted by the height under it (4 pixels a step), the
  // rise included.  A thing that holds another (a socket and its torch) is one picture when
  // the theme has it; a flame shows its frame at the level's clock, and its low picture in its
  // last minute.
  base = tile_world::rise(w.w, x, y, z);
  st = tile_world::things(w.w, x, y, z);
  low = rules::low(w, x, y, z);
  i = 0;
  while i < len(st) {
    t = st[i] ?? 0;
    both = theme::holding_sprite(g.look, t, st[i + 1] ?? 0, w.now, low);
    if both >= 0 {
      theme::put(g.surface, both, px, py - base * 4, shade);
      base += rules::thing_height(w, t) + rules::thing_height(w, st[i + 1] ?? 0);
      i += 2;
      continue;
    }
    // A lit bomb shows its fuse's sparks.
    lit = if rules::fused_at(w, x, y, z) { theme::fused_sprite(g.look, t, w.now) } else { -1 };
    theme::put(g.surface, if lit >= 0 { lit } else { theme::thing_sprite_at(g.look, t, w.now, low) }, px,
               py - base * 4, shade);
    base += rules::thing_height(w, t);
    i += 1;
  }
}

// The hero's hand, in its picture's pixels, facing (fx, fy): the right hand facing right, down or
// up (the weapon arm), the left facing left.
fn hand(fx: integer, fy: integer) -> (integer, integer) {
  if fx > 0 { (13, 11) } else if fx < 0 { (2, 11) } else if fy > 0 { (12, 12) } else { (11, 10) }
}

/// Someone drawn as a cut-out (motion.loft): the hero, and every enemy to come.  Its cell and
/// height, its picture, what it holds (and whether that burns low), the way it faces and its
/// pose now.
struct Figure {
  x: integer,
  y: integer,
  h: integer,
  sprite: integer,
  item: integer,
  low: boolean,
  face_x: integer,
  face_y: integer,
  pose: motion::Pose,
  fine: motion::FinePose,
  /// What is worn on the shoulders (the hero's rope or sack; 0: none), drawn behind the body.
  shoulder: integer = 0,
  /// The hero: its facing shown — a lean that way, and its picture mirrored facing west.
  facing_shown: boolean = false
}

// The figures on layer z: the hero and the enemies.
fn figures(g: const Game, w: const rules::Level, z: integer) -> vector<Figure> {
  out: vector<Figure> = [];
  for e in w.enemies {
    if e.z != z || e.away { continue; }
    m = motion::still();
    for mv in g.movers { if mv.id == e.id { m = mv.motion; } }
    pose = motion::pose(m, e.face_x, e.face_y, w.now);
    fine = motion::fine_pose(m, e.face_x, e.face_y, w.now);
    // Winding up a blow (@GM-Combat), it draws back, further as the moment nears: the tell.  Its
    // weapon goes back as a swing's wind-up does — or, a sweep that cannot be parried, far back
    // level: the two read apart.
    if e.wind_until > w.now {
      span = enemy_windup(w, e.kind);
      left = e.wind_until - w.now;
      back = 1 + ((span - left) * 3 / (if span > 0 { span } else { 1 }) ?? 0);
      pose.x -= e.face_x * back;
      pose.y -= e.face_y * back;
      fine.x -= (e.face_x * back) as float;
      fine.y -= (e.face_y * back) as float;
      frac = if span > 0 { ((span - left) as float) / (span as float) } else { 1.0 };
      motion::windup(fine, e.face_x, e.face_y, frac, rules::sweeps(w, e.kind));
    }
    // Left open by a parry: off balance, its weapon hanging — the moment for a riposte.
    if e.open_until > w.now && !motion::busy(m, w.now) { motion::open(fine, e.face_x, e.face_y); }
    if hurt(e.hp, rules::hp_of(w, e.kind)) { motion::wounded(fine, w.now, !motion::busy(m, w.now)); }
    out += [Figure { x: e.x, y: e.y, h: tile_world::rise(w.w, e.x, e.y, z), sprite: theme::enemy_sprite(g.look, e.kind),
                     item: e.item, low: false, face_x: e.face_x, face_y: e.face_y, pose: pose, fine: fine }];
  }
  if w.hero_z == z {
    fine = motion::fine_pose(g.motion, w.face_x, w.face_y, w.now);
    // Roaming free (F3), the body stands off its cell by its offset.
    off = free_offset(g);
    fine.x += off.0;
    fine.y += off.1;
    hpose = motion::pose(g.motion, w.face_x, w.face_y, w.now);
    hpose.x += off.0 as integer;
    hpose.y += off.1 as integer;
    // Guarding (@GM-Combat): the weapon across the body, held through a blow's push (a brace).
    braced = g.motion.act == motion::Act.Brace || !motion::busy(g.motion, w.now);
    if w.blocking && braced { motion::guard(fine, w.face_x, w.face_y); }
    if hurt(w.health, w.k.health) { motion::wounded(fine, w.now, !motion::busy(g.motion, w.now)); }
    // Facing north the hero shows its back (owner, 2026-11-07; the game's own sheet, world:96).
    look = if w.face_y < 0 && w.face_x == 0 && g.look.hero_back >= 0 { g.look.hero_back } else { g.look.hero };
    out += [Figure { x: w.hero_x, y: w.hero_y, h: w.hero_h, sprite: look, item: w.hero_item,
                     low: rules::hero_low(w), face_x: w.face_x, face_y: w.face_y,
                     pose: hpose, fine: fine, shoulder: w.shoulder, facing_shown: true }];
  }
  out
}

// An enemy kind's wind-up, for drawing it.
fn enemy_windup(w: const rules::Level, kind: text) -> integer {
  rules::windup_of(w, kind)
}

// The view row a figure's feet stand at, which sets what hides it: drawn after that row's things,
// before the next row's.  A figure stepping into the row above stays behind this row's things
// until its feet pass their base; its hop does not count.
fn depth_row(g: const Game, f: const Figure) -> integer {
  ts = g.look.tile_size;
  feet = (f.y - g.cam_y + 1) * ts + f.pose.y + f.pose.hop;
  (feet / ts ?? 0) - 1
}

// Figure f: the body glides, hops and rocks about its feet; what it carries is at its hand,
// pointing the way it faces — behind the body facing up (owner: everything carried is held the
// way the figure moves).
// Drawn from the fine pose, in fractions of a pixel and a degree: on a display surface the figure
// moves smoothly at the display's resolution; on a 1x surface it lands on whole pixels.
fn draw_figure(g: Game, f: const Figure, now: integer, shade: integer) {
  ts = g.look.tile_size;
  p = f.fine;
  // The hero's facing shown (owner, 2026-11-07): it leans the way it faces, and facing west its
  // picture is mirrored.
  lean = if f.facing_shown { (f.face_x as float) * motion::FACE_TILT } else { 0.0 };
  mirror = f.facing_shown && f.face_x < 0;
  bx = (((f.x - g.cam_x) * ts) as float) + p.x;
  by = (((f.y - g.cam_y) * ts - g.lift - f.h * 4) as float) + p.y;
  hd = hand(f.face_x, f.face_y);
  hx = bx + (hd.0 as float);
  hy = by + (hd.1 as float);
  behind = f.face_y < 0 && f.face_x == 0;
  // What is on the shoulders hangs at the back, away from the way the figure faces.
  if f.shoulder != 0 {
    sx = bx - ((f.face_x * 4) as float);
    sy = by - ((f.face_y * 3 + 2) as float);
    theme::put_fine(g.surface, theme::thing_sprite(g.look, f.shoulder), sx, sy, p.tilt, ((ts as float) / 2.0 + 0.5, (ts as float) - 0.5), shade);
  }
  if f.item != 0 && behind {
    theme::put_held_fine(g.surface, g.look, f.item, hx, hy, p.weapon, p.reach, shade, now, f.low);
  }
  theme::put_fine(g.surface, f.sprite, bx, by, p.tilt + lean, ((ts as float) / 2.0 + 0.5, (ts as float) - 0.5), shade, mirror);
  if f.item != 0 && !behind {
    theme::put_held_fine(g.surface, g.look, f.item, hx, hy, p.weapon, p.reach, shade, now, f.low);
  }
}


fn write(g: Game, s: text, x: integer, y: integer) {
  theme::write(g.surface, g.look, s, x, y);
}

// The rows of the level the view shows: one fewer while editing, for the palette.
fn view_rows(g: const Game) -> integer {
  if g.editing { ROWS - 2 } else { ROWS - 1 }
}

/// Looking down through an opening (owner, 2026-11-07): from an opening in its floor the hero sees
/// a bit of the layer below, DOWN_LOOK cells past the opening (as far as a sight line from it goes
/// there); the rock of its own layer over what it sees there is cut away.  Only standing in the
/// opening does it see the whole area there (`cut_above`).
const DOWN_LOOK = 1;

// Is the way from (x0, y0) to (x1, y1) on layer z clear of anything opaque (the ends left out)?
fn line_clear(w: const rules::Level, x0: integer, y0: integer, x1: integer, y1: integer, z: integer) -> boolean {
  dx = if x1 > x0 { x1 - x0 } else { x0 - x1 };
  dy = if y1 > y0 { y0 - y1 } else { y1 - y0 };
  sx = if x0 < x1 { 1 } else { -1 };
  sy = if y0 < y1 { 1 } else { -1 };
  err = dx + dy;
  x = x0;
  y = y0;
  guard = 0;
  while (x != x1 || y != y1) && guard < 64 {
    guard += 1;
    e2 = 2 * err;
    if e2 >= dy {
      err += dy;
      x += sx;
    }
    if e2 <= dx {
      err += dx;
      y += sy;
    }
    if (x != x1 || y != y1) && tile_world::opaque(w.w, x, y, z) { return false; }
  }
  true
}

// What the hero on layer z sees of layer z - 1 through the openings in its floor: a flag per view
// cell of layer z - 1 (row by row, as that layer is drawn) — under an opening it sees, and the
// ground of the layer below within DOWN_LOOK of one that a line from it reaches.  The same index
// is the cell of layer z drawn over it (a layer is drawn a row up).  Empty with no opening seen.
pub fn look_down(g: const Game, w: const rules::Level, z: integer) -> vector<boolean> {
  rows = view_rows(g);
  cx = g.cam_x;
  cy = g.cam_y + z - 1;
  m = DOWN_LOOK;
  opens: vector<(integer, integer)> = [];
  for y in -m..rows + m {
    for x in -m..COLS + m {
      wx = cx + x;
      wy = cy + y;
      if tile_world::terrain(w.w, wx, wy, z) == tile_world::VOID && tile_world::terrain(w.w, wx, wy, z - 1) != tile_world::VOID
          && rules::in_view(w, wx, wy) {
        opens += [(wx, wy)];
      }
    }
  }
  out: vector<boolean> = [];
  if len(opens) == 0 { return out; }
  for y in 0..rows {
    for x in 0..COLS {
      wx = cx + x;
      wy = cy + y;
      s = false;
      if tile_world::terrain(w.w, wx, wy, z - 1) != tile_world::VOID {
        for o in opens {
          if s { break; }
          ax = if wx > o.0 { wx - o.0 } else { o.0 - wx };
          ay = if wy > o.1 { wy - o.1 } else { o.1 - wy };
          if ax <= m && ay <= m && line_clear(w, o.0, o.1, wx, wy, z - 1) { s = true; }
        }
      }
      out += [s];
    }
  }
  out
}

// The cells of layer z to leave out over what the hero sees below (`look_down`): its rock (opaque)
// there, never its floors.
fn cut_over(g: const Game, w: const rules::Level, z: integer, below: const vector<boolean>) -> vector<boolean> {
  out: vector<boolean> = [];
  if len(below) == 0 { return out; }
  rows = view_rows(g);
  for y in 0..rows {
    for x in 0..COLS {
      out += [(below[y * COLS + x] ?? false) && tile_world::opaque(w.w, g.cam_x + x, g.cam_y + z + y, z)];
    }
  }
  out
}

// Standing in an opening, under the layer above (z + 1): the whole area the hero stands in shows
// (owner, 2026-11-07) — every open cell of its layer joined to where it stands, within the view —
// the rock of the layer above over it left out; that layer's floors stay.
fn cut_above(g: const Game, w: const rules::Level, z: integer) -> vector<boolean> {
  rows = view_rows(g);
  // The hero's layer from row cy, the view's cells and a row more (the rock above covers a row
  // north of its own).
  cx = g.cam_x;
  cy = g.cam_y + z;
  h = rows + 1;
  area: vector<boolean> = [];
  for _ in 0..COLS * h { area += [false]; }
  todo: vector<(integer, integer)> = [(w.hero_x, w.hero_y)];
  i = 0;
  while i < len(todo) && i < 4000 {
    c = todo[i] ?? (0, 0);
    i += 1;
    vx = c.0 - cx;
    vy = c.1 - cy;
    if vx < 0 || vx >= COLS || vy < 0 || vy >= h { continue; }
    if area[vy * COLS + vx] ?? true { continue; }
    if tile_world::terrain(w.w, c.0, c.1, z) == tile_world::VOID || tile_world::opaque(w.w, c.0, c.1, z) { continue; }
    area[vy * COLS + vx] = true;
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if tile_world::see_through(w.w, c.0, c.1, z, d.0, d.1) { todo += [(c.0 + d.0, c.1 + d.1)]; }
    }
  }
  out: vector<boolean> = [];
  for y in 0..rows {
    for x in 0..COLS {
      ux = cx + x;
      uy = g.cam_y + z + 1 + y;
      // Drawn a row up, it covers the hero's layer's cell a row north of it: view row y + 0 of
      // the hero's layer is world row uy - 1.
      out += [tile_world::opaque(w.w, ux, uy, z + 1) && (area[y * COLS + x] ?? false)];
    }
  }
  out
}

// Every cell of layer z of `w` the view holds, at its light (or in full light when not `lit`),
// but never lighter than `dim`; `only_set` skips the void, `cut` is a cell left out (a wall in
// front of the hero), and with `sight` the things and figures the hero does not see — past a
// wall — are left out (owner).  With `only` (a flag per view cell, row by row) only the cells
// flagged are drawn, their things and figures too: the layer below seen through an opening; the
// cells flagged in `skip` are left out (the rock over what is seen below).
fn draw_layer(g: Game, w: const rules::Level, z: integer, upper: boolean, only_set: boolean, lit: boolean,
              dim: integer, cut: (integer, integer) = (-1000000, -1000000), sight: boolean = false,
              only: vector<boolean> = [], skip: vector<boolean> = []) {
  masked = len(only) > 0;
  rows = view_rows(g);
  cx = g.cam_x;
  // Layer z is drawn z tiles up, so the view shows its cells z rows further south: view row y
  // is the layer's row cy + y.
  cy = g.cam_y + z;
  g.lift = z * g.look.tile_size;
  gr = ground_of(g, w, z, rows, lit);
  // A view cell's shade, from the ground grid (one cell wider each side).
  sh: vector<integer> = [];
  for y in 0..rows {
    for x in 0..COLS { sh += [gr.shade[(y + 1) * gr.w + x + 1] ?? 0]; }
  }
  // The ground first, all of it; then, row by row from the back, what stands — the upright
  // terrain, the stacks, and the figures whose feet stand at that row — so what is in front
  // hides what is behind it.
  for y in 0..rows {
    for x in 0..COLS {
      if (!only_set || tile_world::terrain(w.w, cx + x, cy + y, z) != tile_world::VOID)
          && (cx + x != cut.0 || cy + y != cut.1) && (!masked || (only[y * COLS + x] ?? false))
          && !(skip[y * COLS + x] ?? false) {
        draw_ground(g, w, gr, cx + x, cy + y, z, upper, dim);
      }
    }
  }
  if !masked { draw_labels(g, w, z, sh, sight); }
  figs = figures(g, w, z);
  for y in -1..rows {
    if y >= 0 {
      if !masked { draw_edges(g, w, cx, cy, y, z, skip); }
      for x in 0..COLS {
        if (!only_set || tile_world::terrain(w.w, cx + x, cy + y, z) != tile_world::VOID)
            && (cx + x != cut.0 || cy + y != cut.1) && (!masked || (only[y * COLS + x] ?? false))
            && !(skip[y * COLS + x] ?? false) {
          shade = sh[y * COLS + x] ?? 0;
          seen = !sight || rules::in_view(w, cx + x, cy + y);
          draw_standing(g, w, gr, cx + x, cy + y, z, upper, dim, if shade < dim { dim } else { shade }, seen);
        }
      }
      // A blast is drawn over the row it went off in.
      for b in w.blasts {
        s = theme::blast_sprite(g.look, w.now - b.at, w.k.flash_ms);
        if b.z == z && b.y == cy + y && s >= 0 {
          theme::put(g.surface, s, (b.x - cx) * g.look.tile_size,
                     y * g.look.tile_size - tile_world::rise(w.w, b.x, b.y, z) * 4, 0);
        }
      }
    }
    for f in figs {
      d = depth_row(g, f) - z;
      if (d == y || (y == -1 && d < -1) || (y == rows - 1 && d >= rows)) && (!sight || rules::in_view(w, f.x, f.y))
          && (!masked || (f.x >= cx && f.x < cx + COLS && f.y >= cy && f.y < cy + rows
                          && (only[(f.y - cy) * COLS + f.x - cx] ?? false))) {
        fx = f.x - cx;
        fy = f.y - cy;
        shade = sh[fy * COLS + fx] ?? 0;
        if fx >= 0 && fx < COLS && fy >= 0 && fy < rows { draw_figure(g, f, w.now, if shade < dim { dim } else { shade }); }
      }
    }
  }
}

// The thin walls of view row y on layer z (kinds.json's edges: a house's inner walls, PUZZLES.md
// § Houses): on each cell's north and west side, standing a little over the floor — a wall a strip
// with a lit top, a door the same with its middle open, a window a pale pane, a fence a low rail.
fn draw_edges(g: Game, w: const rules::Level, cx: integer, cy: integer, y: integer, z: integer,
              skip: const vector<boolean>) {
  ts = g.look.tile_size;
  wall = rules::edge_id(w.k, "wall");
  door = rules::edge_id(w.k, "door");
  window = rules::edge_id(w.k, "window");
  fence = rules::edge_id(w.k, "fence");
  body = tiles::rgb(92, 60, 40);
  top = tiles::rgb(176, 128, 88);
  pane = tiles::rgb(150, 200, 230);
  rail = tiles::rgb(140, 100, 60);
  rise = ts / 2;
  py = y * ts;
  iron = tiles::rgb(60, 60, 70);
  for x in 0..COLS {
    if skip[y * COLS + x] ?? false { continue; }
    px = x * ts;
    n = tile_world::edge(w.w, cx + x, cy + y, z, tile_world::NORTH);
    // A window beside open space is a grate's frame: an iron rail, not a wall.
    open_n = tile_world::terrain(w.w, cx + x, cy + y, z) == tile_world::VOID
             || tile_world::terrain(w.w, cx + x, cy + y - 1, z) == tile_world::VOID;
    open_w = tile_world::terrain(w.w, cx + x, cy + y, z) == tile_world::VOID
             || tile_world::terrain(w.w, cx + x - 1, cy + y, z) == tile_world::VOID;
    if n == window && open_n {
      tiles::rect(g.surface, px, py - 3, ts, 2, iron);
    } else if n == wall {
      tiles::rect(g.surface, px, py - rise, ts, rise, body);
      tiles::rect(g.surface, px, py - rise - 2, ts, 2, top);
    } else if n == door {
      for part in [(0, 3), (ts - 3, 3)] {
        tiles::rect(g.surface, px + part.0, py - rise, part.1, rise, body);
        tiles::rect(g.surface, px + part.0, py - rise - 2, part.1, 2, top);
      }
    } else if n == window {
      tiles::rect(g.surface, px, py - rise, ts, rise, body);
      tiles::rect(g.surface, px + 3, py - rise + 1, ts - 6, rise - 3, pane);
      tiles::rect(g.surface, px, py - rise - 2, ts, 2, top);
    } else if n == fence {
      tiles::rect(g.surface, px, py - 5, ts, 2, rail);
    }
    v = tile_world::edge(w.w, cx + x, cy + y, z, tile_world::WEST);
    if v == window && open_w {
      tiles::rect(g.surface, px - 1, py - 3, 2, ts, iron);
    } else if v == wall || v == window {
      tiles::rect(g.surface, px - 1, py - rise, 3, ts + rise, body);
      tiles::rect(g.surface, px - 1, py - rise - 2, 3, 2, top);
      if v == window { tiles::rect(g.surface, px, py, 1, ts - 2, pane); }
    } else if v == door {
      tiles::rect(g.surface, px - 1, py - rise, 3, rise + 3, body);
      tiles::rect(g.surface, px - 1, py - rise - 2, 3, 2, top);
      tiles::rect(g.surface, px - 1, py + ts - 3, 3, 3, body);
    } else if v == fence {
      tiles::rect(g.surface, px - 1, py - 3, 2, ts, rail);
    }
  }
}

// The place's text on layer z, written on the ground: drawn over the floor and under what
// stands on it, so the hero walks over it.  Half the font's size, centred on its cell, in the
// light of that cell; with `sight`, only where the hero sees.
fn draw_labels(g: Game, w: const rules::Level, z: integer, sh: const vector<integer>, sight: boolean) {
  ts = g.look.tile_size;
  for b in g.file.labels {
    if b.z != z { continue; }
    vx = b.x - g.cam_x;
    vy = b.y - g.cam_y - z;
    if vx < -COLS || vx >= 2 * COLS || vy < 0 || vy >= view_rows(g) { continue; }
    if sight && !rules::in_view(w, b.x, b.y) { continue; }
    shade = if vx >= 0 && vx < COLS { sh[vy * COLS + vx] ?? 0 } else { 0 };
    half = ts / 2;
    x = vx * ts + half - len(b.says) * half / 2;
    y = (b.y - g.cam_y) * ts - g.lift + half / 2;
    theme::write_small(g.surface, g.look, b.says, x as float, y as float, shade);
  }
}

// The pixels covered in `e` ms by something moving `d` cells (-1, 0 or 1) every `ms` ms, at
// `ts` pixels a cell.  A cell time of 0 or less (a mistake in the data) counts as one ms.
fn covered(d: integer, e: integer, ts: integer, ms: integer) -> integer {
  per = if ms > 0 { ms } else { 1 };
  (d * e * ts / per)!
}

// The bow, over the picture: the mark on its locked target, and each arrow in flight — from where
// it was shot, a cell every arrow_ms, turned the way it flies.
fn draw_bow(g: Game) {
  w = g.world;
  ts = g.look.tile_size;
  a = rules::aimed(g.world);
  if a.0 != 0 || a.1 != 0 {
    z = w.hero_z;
    theme::put(g.surface, g.look.aim, (w.aim_x - g.cam_x) * ts,
               (w.aim_y - g.cam_y) * ts - z * ts - tile_world::rise(w.w, w.aim_x, w.aim_y, z) * 4, 0);
  }
  for s in w.shots {
    e = w.now - s.at;
    if s.done || e < 0 { continue; }
    px = (s.x - g.cam_x) * ts + covered(s.dx, e, ts, w.k.arrow_ms);
    py = (s.y - g.cam_y) * ts - s.z * ts - 6 + covered(s.dy, e, ts, w.k.arrow_ms);
    theme::put_turned(g.surface, g.look.arrow, px, py, motion::facing(s.dx, s.dy), (7, 8), 0);
  }
}

// Each enemy's motion, from how it changed since it was last drawn: a step glides, a blow
// staggers it away from the hero, a bite (beside the hero, facing it, the hero hurt) lunges.
// Weapons met (@GM-Combat): a spark between the hero and the cell it faces, from now.
fn spark(g: Game, big: boolean) {
  w = g.world;
  g.sparks += [Spark { x: w.hero_x, y: w.hero_y, z: w.hero_z, fx: w.face_x, fy: w.face_y, start: w.now, big: big }];
}

// Wounded: a third of the full health or less (proposed), and still alive.
fn hurt(health: integer, full: integer) -> boolean {
  health > 0 && health * 3 <= full
}

// The sparks on layer z still showing — the blast's flash, small for a block, larger for a
// parry, shrinking as it fades — and the ones over dropped.
fn draw_sparks(g: Game, z: integer) {
  w = g.world;
  ts = g.look.tile_size;
  kept: vector<Spark> = [];
  for sp in g.sparks {
    n = if sp.big { BIG_SPARK_MS } else { SPARK_MS };
    e = w.now - sp.start;
    if e < 0 || e >= n { continue; }
    kept += [sp];
    if sp.z != z { continue; }
    top = if sp.big { 0.8 } else { 0.5 };
    scale = top * (1.0 - 0.5 * (e as float) / (n as float));
    cx = ((sp.x - g.cam_x) * ts + ts / 2 + sp.fx * ts / 2) as float;
    // At the hands' height, the middle of the cell, on its own layer's lift (a tile a layer up) —
    // not the last layer drawn's.
    cy = ((sp.y - g.cam_y) * ts - sp.z * ts + ts / 2 + sp.fy * ts / 2) as float;
    theme::put_scaled(g.surface, g.look, theme::blast_sprite(g.look, 0, 1), cx, cy, scale, 0);
  }
  g.sparks = kept;
}

/// How enemy `id` moves on screen (still when it has not been drawn yet).
pub fn motion_of(g: const Game, id: integer) -> motion::Motion {
  for mv in g.movers { if mv.id == id { return mv.motion; } }
  motion::still()
}

pub fn follow_enemies(g: Game) {
  w = g.world;
  now = w.now;
  kept: vector<Mover> = [];
  for e in w.enemies {
    mv = Mover { id: e.id, motion: motion::still(), x: e.x, y: e.y, hp: e.hp, led: e.led };
    for o in g.movers {
      if o.id == e.id {
        mv.motion = o.motion;
        if o.x != e.x || o.y != e.y {
          motion::walk(mv.motion, now, e.x - o.x, e.y - o.y, 0, e.face_x, e.face_y);
        } else if o.led != e.led {
          // Starting to follow the hero, or staying: a nod — a hop in place.
          motion::walk(mv.motion, now, 0, 0, 0, e.face_x, e.face_y);
        }
        if e.hp < o.hp {
          kx = if e.x > w.hero_x { 1 } else if e.x < w.hero_x { -1 } else { 0 };
          ky = if kx != 0 { 0 } else if e.y > w.hero_y { 1 } else { -1 };
          // A riposte just struck reels it twice as far (@GM-Combat).
          force = if now - g.riposted_at <= motion::STAGGER_MS { 2 } else { 1 };
          motion::stagger(mv.motion, now, kx, ky, 0, 0, e.face_x, e.face_y, force);
        }
      }
    }
    kept += [mv];
  }
  g.movers = kept;
}

/// How many layers over the hero the view draws under the open sky.
const SKY_LAYERS = 4;

/// How far a bank may stand from the hero for its view to stay in the trench.
const BANK_REACH = 4;

// Whether, looking (dx, dy) from the hero along its layer, a bank of earth stands within
// BANK_REACH: a wall with ground on the layer above it.
fn banked(w: const rules::Level, dx: integer, dy: integer) -> boolean {
  wall = rules::tr(w, "wall");
  for i in 1..=BANK_REACH {
    x = w.hero_x + i * dx;
    y = w.hero_y + i * dy;
    if tile_world::terrain(w.w, x, y, w.hero_z) == wall {
      return tile_world::terrain(w.w, x, y, w.hero_z + 1) != tile_world::VOID;
    }
  }
  false
}

/// Whether the hero stands down in a trench — the stream's bed, between banks on both sides — and
/// sees no further than its sides, as under a bridge (owner, 2026-11-08: in the river you cannot
/// see far outside it; the ground above, which the hero cannot see, would hide it).  Standing high
/// — a ramp's top step, a chair — it looks out again.
fn in_trench(w: const rules::Level) -> boolean {
  w.hero_h < w.k.layer_height - 1
    && ((banked(w, 0, -1) && banked(w, 0, 1)) || (banked(w, -1, 0) && banked(w, 1, 0)))
}

/// Draw the frame on `g.surface`, each cell at its light.  What the hero sees depends on where
/// it stands: on a layer above another, the one below and its own over it; under the open sky,
/// its own and the layer above (a ledge, drawn lighter); under a ceiling, only its own.
pub fn draw(g: Game) {
  if g.editing {
    draw_editor(g);
    return;
  }
  if g.ending {
    draw_still(g);
    return;
  }
  follow_enemies(g);
  tiles::clear(g.surface, 0);
  w = g.world;
  z = w.hero_z;
  // On the hero's layer only what it sees past the walls (owner).
  // Through an opening in its floor the hero sees down into the layer below, and the rock of its own
  // layer over what it sees there is cut away (owner, 2026-11-07: `look_down`).
  below = look_down(g, w, z);
  over = cut_over(g, w, z, below);
  sky = tile_world::open_sky(w.w, w.hero_x, w.hero_y, z) && !in_trench(w);
  if z > 0 {
    draw_layer(g, w, z - 1, false, false, true, 0);
    draw_layer(g, w, z, false, true, true, 0, (-1000000, -1000000), true, [], over);
  } else {
    if len(below) > 0 { draw_layer(g, w, z - 1, false, true, true, 0, (-1000000, -1000000), false, below); }
    draw_layer(g, w, z, false, false, true, 0, (-1000000, -1000000), true, [], over);
    // The layer above: a wall in front of the hero — the ledge's top on a wall, drawn a row up
    // over it — is left out (owner: only walls; doors, pillars, trees and smaller things may
    // hide the hero in part, and a level keeps the hero in view).
    if sky {
      front = if tile_world::terrain(w.w, w.hero_x, w.hero_y + 1, z) == rules::tr(w, "wall") {
        (w.hero_x, w.hero_y + 1)
      } else { (-1000000, -1000000) };
      // Standing in an opening, the rock above over ground it sees is left out (owner, 2026-11-07).
      draw_layer(g, w, z + 1, true, true, true, 0, front, false, [], cut_above(g, w, z));
    }
  }
  // Higher still under the open sky: every layer up to SKY_LAYERS over the hero, each over the last —
  // a house's roof over its upper floor, the terraces of a hill (PUZZLES.md § Houses).
  if sky {
    for up in (if z > 0 { 1 } else { 2 })..=SKY_LAYERS { draw_layer(g, w, z + up, true, true, true, 0); }
  }
  draw_sparks(g, z);
  draw_bow(g);
  draw_talk(g);
  if g.won {
    write(g, "DONE! N NEXT", 0, (ROWS - 1) * 16);
  } else if !rules::alive(w) {
    write(g, "NO HEARTS - R", 0, (ROWS - 1) * 16);
  } else {
    // A note (a signpost's count, SAVED, BACK? B AGAIN) takes the line's left until the next
    // move, beside the hearts; otherwise the move count or the gold, with the readouts.
    if g.note != "" { status(g, g.note, true); }
    else if w.money > 0 { status(g, "GOLD {w.money}"); }
    else { status(g, "MOVES {g.moves}"); }
  }
}

// What is being said, in a bubble over whoever says it: half-size letters, whole words, at most
// BUBBLE characters a row; the hero's in its own colour.  Kept inside the view.
fn draw_talk(g: Game) {
  w = g.world;
  ts = g.look.tile_size;
  for t in g.file.talks {
    e = talk::owner(t, w);
    if e < 0 { continue; }
    n = talk::current(w, e);
    b = talk::barking(w, e);
    if n < 0 && b < 0 { continue; }
    line = if n >= 0 { t.lines[n]! } else { t.barks[b]! };
    p = talk::speaker_of(t, w, e, line.by);
    if p.2 != w.hero_z { continue; }
    rows = talk::wrap(talk::heard(w, line), BUBBLE);
    wide = 0;
    for r in rows { if len(r) > wide { wide = len(r); } }
    half = ts / 2;
    bw = wide * half + 6;
    bh = len(rows) * (half + 1) + 5;
    x = (p.0 - g.cam_x) * ts + half - bw / 2;
    y = (p.1 - g.cam_y - p.2) * ts - bh - 1;
    if x < 0 { x = 0; }
    if x + bw > W { x = W - bw; }
    if y < 0 { y = 0; }
    edge = if line.by == "hero" { HERO_SAYS } else { THEY_SAY };
    tiles::rect(g.surface, x, y, bw, bh, edge);
    tiles::rect(g.surface, x + 1, y + 1, bw - 2, bh - 2, BUBBLE_FILL);
    for r in 0..len(rows) {
      row = rows[r] ?? "";
      theme::write_small(g.surface, g.look, row, (x + 3 + (wide - len(row)) * half / 2) as float,
                         (y + 3 + r * (half + 1)) as float, 0);
    }
  }
}

// The play status line, in half-size letters (a full-size line held only 13): `left` from the
// left, and at the right the seconds a boost has left and the hero's health, a heart and a
// number.  With `note` the readouts give way to it, the hearts stay.  `left` is cut short to
// leave them room.
fn status(g: Game, left: text, note: boolean = false) {
  w = g.world;
  ts = g.look.tile_size;
  half = ts / 2;
  y = (ROWS - 1) * ts;
  right = if rules::boosted(w) { "+{(w.boost_until - w.now) / 1000} " } else { "" };
  // The time of day (C1), hours and minutes.
  right = "{clock_text(g)} " + right;
  // The artefact's pieces found (B6).
  if w.relic_pieces > 0 { right = "PIECES {w.relic_pieces} " + right; }
  // The sack worn: what it holds of what it carries.
  held = rules::sack_room(w);
  if held.1 > 0 { right = "SACK {held.0}/{held.1} " + right; }
  // Health, and the temporary health above it ("6+2").
  hearts = if w.spirit > 0 { "{w.health}+{w.spirit}" } else { "{w.health}" };
  if note { right = ""; }
  // In half cells: the line holds twice COLS; the heart is a full tile, two of them.
  line = COLS * 2;
  cells = len(right) + 2 + len(hearts);
  text_y = (y + half / 2) as float;
  theme::write_small(g.surface, g.look, right, ((line - cells) * half) as float, text_y, 0);
  theme::put(g.surface, g.look.heart, (line - len(hearts) - 2) * half, y, 0);
  theme::write_small(g.surface, g.look, hearts, ((line - len(hearts)) * half) as float, text_y, 0);
  room = line - cells - 1;
  // Bound first: a text `if` as a call argument does not compile on --native before loft#2225.
  shown = if len(left) > room { left.char_slice(0, room) } else { left };
  theme::write_small(g.surface, g.look, shown, 0.0, text_y, 0);
}

// The checks (EDITOR.md § 5) over layer z of the view: the way to a cell goal as dots, a chest
// cut off from the start framed red, a hidden one magenta.  Hints only: a path search ignores
// what pushing could change.
fn draw_checks(g: Game, z: integer) {
  r = editor::check(g.file);
  ts = g.look.tile_size;
  if r.searched && z == g.file.start_z {
    for p in r.path {
      tiles::rect(g.surface, (p.0 - g.cam_x) * ts + ts / 2 - 2, (p.1 - g.cam_y) * ts + ts / 2 - 2, 4, 4, GOAL);
    }
  }
  for c in r.cut_off { if c.2 == z { box(g, c.0, c.1, 2, CUT_OFF); } }
  for c in r.hidden { if c.2 == z { box(g, c.0, c.1, 4, HIDDEN); } }
}

// The status line while the checks show: the way to the goal, when it is a cell.
fn check_note(g: Game) -> text {
  r = editor::check(g.file);
  if !r.searched { return "CHECKS ON"; }
  if len(r.path) == 0 { return "NO PATH!"; }
  "PATH {len(r.path)}"
}

// A one-cell frame round cell (x, y) of the view, `inset` pixels inside it.
fn box(g: Game, x: integer, y: integer, inset: integer, colour: integer) {
  ts = g.look.tile_size;
  tiles::frame(g.surface, (x - g.cam_x) * ts + inset, (y - g.cam_y) * ts + inset, ts - 2 * inset,
               ts - 2 * inset, colour);
}

// The sprite of palette entry `e`; -1 for void, which draws as nothing.
fn entry_sprite(g: const Game, e: const editor::Entry) -> integer {
  if e.thing { return theme::thing_sprite(g.look, e.id); }
  if e.material >= 0 { return theme::tile_sprite(g.look, (g.mats.list[e.material] ?? materials::none_material()).tile); }
  theme::terrain_sprite(g.look, e.id, 0, 0, false)
}

/// The editor's frame (EDITOR.md § 4): the cursor's layer over the one below (darker), an
/// outline round each cell the layer above sets, the start (the hero) and a "cell" goal; the
/// palette along the bottom, its picked entry framed; and a status line: the cursor's cell
/// and layer and what paints, or a word after a save.
pub fn draw_editor(g: Game) {
  tiles::clear(g.surface, 0);
  l = g.file.level;
  ed = g.ed;
  z = ed.z;
  ts = g.look.tile_size;
  rows = ROWS - 2;
  draw_layer(g, l, z - 1, false, false, g.lit, 5);
  draw_layer(g, l, z, false, true, g.lit, 0);
  for y in 0..rows {
    for x in 0..COLS {
      if tile_world::terrain(l.w, g.cam_x + x, g.cam_y + y, z + 1) != tile_world::VOID {
        box(g, g.cam_x + x, g.cam_y + y, 1, ABOVE);
      }
    }
  }
  goal = g.file.goal;
  if goal.kind == "cell" && goal.z == z {
    box(g, goal.x, goal.y, 2, GOAL);
    box(g, goal.x, goal.y, 3, GOAL);
  }
  if ed.marked {
    // The box R marked, from its corner to the cursor.
    x0 = if ed.mark_x < ed.x { ed.mark_x } else { ed.x };
    y0 = if ed.mark_y < ed.y { ed.mark_y } else { ed.y };
    bw = (if ed.mark_x > ed.x { ed.mark_x } else { ed.x }) - x0 + 1;
    bh = (if ed.mark_y > ed.y { ed.mark_y } else { ed.y }) - y0 + 1;
    tiles::frame(g.surface, (x0 - g.cam_x) * ts, (y0 - g.cam_y) * ts, bw * ts, bh * ts, PICKED);
  }
  if g.checking { draw_checks(g, z); }
  draw_intent(g);
  box(g, ed.x, ed.y, 0, CURSOR);
  box(g, ed.x, ed.y, 1, 0);
  n = len(ed.palette);
  first = ed.pick - COLS / 2;
  if first > n - COLS { first = n - COLS; }
  if first < 0 { first = 0; }
  py = rows * ts;
  for i in first..n {
    if i - first >= COLS { break; }
    px = (i - first) * ts;
    theme::put(g.surface, entry_sprite(g, ed.palette[i] ?? editor::picked(ed)), px, py, 0);
    if i == ed.pick { tiles::frame(g.surface, px, py, ts, ts, PICKED); }
  }
  status = if g.note != "" { g.note } else if g.checking { check_note(g) } else {
    "{ed.x} {ed.y} {z} {editor::name(l.k, editor::picked(ed))}"
  };
  if len(status) > COLS { status = status.char_slice(0, COLS); }
  write(g, status, 0, (rows + 1) * ts);
}

/// Draw the place being played as a map with its view's top-left at cell (cam_x, cam_y): every
/// layer from the lowest up, in full light, the upper ones only where they are set — what the
/// map tool (tools/map.loft) stitches into a picture of a whole place.
pub fn draw_map(g: Game, cam_x: integer, cam_y: integer) {
  g.cam_x = cam_x;
  g.cam_y = cam_y;
  tiles::clear(g.surface, 0);
  zs = tile_world::layers(g.world.w);
  zs.sort();
  first = true;
  for z in zs {
    draw_layer(g, g.world, z, false, !first, false, 0);
    first = false;
  }
}

/// Write the frame as it is now to a PNG at `path`, scaled by `scale` — a picture of the game
/// for a machine with no screen.
pub fn snapshot(g: Game, path: text, scale: integer) -> boolean {
  px = tiles::pixels(g.surface, W, H);
  img = imaging::Image { name: "frame", width: W * scale, height: H * scale, data: [] };
  for y in 0..H * scale {
    for x in 0..W * scale {
      at = ((y / scale) ?? 0) * W + ((x / scale) ?? 0);
      c = px[at] ?? 0;
      img.data += [imaging::Pixel {
        r: ((((c >> 11) & 31) * 255 / 31) ?? 0) & 255,
        g: ((((c >> 5) & 63) * 255 / 63) ?? 0) & 255,
        b: (((c & 31) * 255 / 31) ?? 0) & 255,
        a: 255
      }];
    }
  }
  img.save_png(path)
}

/// The credits, shown before the first level: the pictures and sounds are Kenney's (kenney.nl,
/// CC0), with thanks.  Each line centred, in the theme's font.
pub const CREDITS = "Pictures and sounds by Kenney (kenney.nl), CC0 - with kind regards to Kenney.";

pub fn draw_credits(g: Game) {
  tiles::clear(g.surface, 0);
  ts = g.look.tile_size;
  lines = ["TILE WORLD", "", "PICTURES AND", "SOUNDS BY", "KENNEY", "KENNEY.NL", "", "THANK YOU", "KENNEY!"];
  y = (H - len(lines) * ts) / 2 ?? 0;
  for l in lines {
    write(g, l, (W - len(l) * ts) / 2 ?? 0, y);
    y += ts;
  }
}

/// Is any key down this tick (to leave the credits)?
pub fn any_key(g: const Game) -> boolean {
  for k in 1..256 {
    if g.keys.is_key_down(k) { return true; }
  }
  false
}

