//
// A square place ported to the hex grid (owner, 2026-11-09: start porting the town): its intent's
// shapes, not its cells (WORLD.md § One game, square or hex), one square tile to one hex step
// (1.5 m), the square map's north up.
//
//   - The ground: the terraces of the square place, layer over layer, become smooth hills
//     (hexterrain::terraces): each step up a slope a hillside wide across where its front stood,
//     the tops flat at their storeys; the stream's bed dug a storey down, its banks along its
//     straight sides (hexterrain::dig).  The surface keeps its
//     kind: grass, path, rail, the bed, shallow water.
//   - The houses: each a hex house (hexhouse.loft) on the cell nearest its middle, at its floor's
//     height, its door where the square house has it.  Its angle: facing down the hill, the ground's
//     fall at its middle taken to the nearest 30° (a proposal; the square town has no angles to
//     keep); square to the grid where that would not fit beside the houses already placed.  The
//     ground under it is levelled and blended in (hexterrain::seat); its walls go down to the
//     lowest the ground was.
//   - Trees, fences, the well and the bridges: things standing on the surface.
use hex_field;
use hexwalls;
use hexturn;
use hexhouse;
use hexterrain;
use intent;

/// A square tile's side, in metres: one hex step.
pub const TILE = 1.5;

/// A part of a house: its four corners (metres, anticlockwise from its south-west as drawn), the
/// height of its eaves, its roof, and where along its length (metres from its middle) its roof
/// has a dormer on each slope.
pub struct Block {
  pub xs: vector<float>,
  pub ys: vector<float>,
  pub top: float,
  pub roof: integer,
  pub dormers: vector<float> = []
}

/// A stretch of wall from a to b (metres), from height z0 up to z1.
pub struct Rise {
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float,
  pub z0: float,
  pub z1: float
}

/// A house as placed: its walls and openings, its angle, the height of its floor, of the lowest
/// ground under it (where its walls start) and of its eaves, in metres.
pub struct Placed {
  pub built: hexwalls::Built,
  pub turn: integer,
  pub floor: float,
  pub base: float,
  pub top: float,
  /// The cell its plan is placed on.
  pub cq: integer = 0,
  pub cr: integer = 0,
  /// Its roof: ROOF_PITCHED, or ROOF_GARDEN, flat behind a low wall, grass on it.
  pub roof: integer = 0,
  /// Its inner court's corners (metres), when it has one: open to the sky, pillars round it.
  pub court: vector<(float, float)> = [],
  /// Which of its openings (indices into `built.openings`) are bay windows.
  pub bays: vector<integer> = [],
  /// Its parts, the house itself first and then its wings: each a rectangle with its own eaves
  /// and its own roof (owner, 2026-11-14: more kinds of houses).
  pub parts: vector<Block> = [],
  /// Per wall of its outline (wall i runs from corner i - 1 to corner i): the eaves of the part it
  /// belongs to, and how far it is carried up past them as a low wall (a roof garden's, a
  /// terrace's).
  pub tops: vector<float> = [],
  pub rims: vector<float> = [],
  /// The house's wall where it rises over a lower wing's roof.
  pub rises: vector<Rise> = []
}

/// The kinds of roof: pitched and hipped; a roof garden, flat behind a low wall, grass on it; a
/// flat roof; an attic's, steeper, with a gable at each end and dormers; a lower roof terrace.
pub const ROOF_PITCHED = 0;
pub const ROOF_GARDEN = 1;
pub const ROOF_FLAT = 2;
pub const ROOF_ATTIC = 3;
pub const ROOF_TERRACE = 4;

/// What stands along a yard's side (owner, 2026-11-14): a low wall, a low hedge, a hedge a storey
/// high, a fence.
pub const LOW_WALL = 1;
pub const LOW_HEDGE = 2;
pub const HEDGE = 3;
pub const FENCE = 4;

/// A stretch of a yard's side, from a to b (metres), `height` high and `thick` thick, standing on
/// the ground along it.
pub struct Fence {
  pub kind: integer,
  pub ax: float,
  pub ay: float,
  pub bx: float,
  pub by: float,
  pub height: float,
  pub thick: float
}

/// The measurements of what stands along a yard, by kind (hexsizes.json's "yards"), in metres.
pub struct Yards {
  pub heights: vector<float>,
  pub thicks: vector<float>
}

/// A low wall and a low hedge stand two steps of a storey's four, a hedge the whole storey.
pub fn default_yards() -> Yards {
  Yards { heights: [0.0, 1.3, 1.3, 2.6, 1.0], thicks: [0.0, 0.4, 0.7, 0.9, 0.15] }
}

pub fn yards_file(path: text) -> Yards {
  d = default_yards();
  text = file(path).content() ?? "";
  if text == "" { return d; }
  doc = json_parse(text);
  v = doc.field("yards");
  names = ["", "low_wall", "low_hedge", "hedge", "fence"];
  hs: vector<float> = [0.0];
  ts: vector<float> = [0.0];
  for i in 1..5 {
    e = v.field(names[i] ?? "");
    hv = e.field("height");
    tv = e.field("thick");
    hs += [if hv.kind() == "JInteger" || hv.kind() == "JNumber" { hv.as_number() } else { d.heights[i] ?? 1.0 }];
    ts += [if tv.kind() == "JInteger" || tv.kind() == "JNumber" { tv.as_number() } else { d.thicks[i] ?? 0.3 }];
  }
  Yards { heights: hs, thicks: ts }
}

fn fence_kind(what: text) -> integer {
  if what == "low_wall" { LOW_WALL } else if what == "low_hedge" { LOW_HEDGE } else if what == "hedge" { HEDGE } else { FENCE }
}

/// A thing on the surface: a tree, a fence, the well, a bridge; at (x, y) metres, its foot at
/// height z.
pub struct Thing {
  pub kind: text,
  pub x: float,
  pub y: float,
  pub z: float,
  /// A pillar's height, a gazebo roof's width; 0 for a thing of its kind's own size.
  pub size: float = 0.0
}

pub struct Town {
  pub ground: hexterrain::Ground,
  pub houses: vector<Placed>,
  pub things: vector<Thing>,
  /// Each cell's terrace level (the square place's layer under its centre), and the cliffs: the
  /// fronts that do not slope (the intent's cliff areas).
  pub levels: hex_field::Labels,
  pub cliffs: vector<hexterrain::Cliff> = [],
  /// What stands along the yards' sides: hedges, low walls, fences.
  pub fences: vector<Fence> = []
}

/// A surface kind beside hexterrain's: paving (a terrace, a court).
pub const PAVING = 7;
/// Tilled soil: a field, a kitchen plot.
pub const FIELD = 8;

/// The lowest and highest layer, and the square map's size.
const LO = -1;
const HI = 4;
const NX = 88;
const NY = 68;

fn layer_index(x: integer, y: integer, z: integer) -> integer { ((z - LO) * NY + y) * NX + x }

/// Tile (x, y)'s centre, in metres (north up: the square map's y grows south).
pub fn tile_xy(x: float, y: float) -> (float, float) { (x * TILE, -y * TILE) }

fn is_tree(k: text) -> boolean {
  k == "pine" || k == "oak" || k == "poplar" || k == "bush" || k == "autumn_oak" || k == "autumn_poplar"
}

/// The square place's ground, layer by layer: what each ground shape left at each tile and layer
/// (a later shape over an earlier; "void" empties it).
fn layers(it: const intent::Intent) -> vector<text> {
  cells: vector<text> = [for _ in 0..NX * NY * (HI - LO + 1) { "" }];
  for g in it.grounds {
    if g.z < LO || g.z > HI { continue; }
    // a roof on pillars (a gazebo's, a bay window's) is no ground
    if g.what == "house_roof" || g.what == "house_slate" { continue; }
    for y in g.y..g.y + g.h {
      for x in g.x..g.x + g.w {
        if x < 0 || x >= NX || y < 0 || y >= NY { continue; }
        cells[layer_index(x, y, g.z)] = if g.what == "void" { "" } else { g.what };
      }
    }
  }
  cells
}

/// The surface of each tile: its layer (the highest holding ground, a bridge over the bed not
/// counted) and what is on it there.
struct Surface {
  level: vector<integer>,
  what: vector<text>
}

fn surface(cells: const vector<text>) -> Surface {
  level: vector<integer> = [];
  what: vector<text> = [];
  for y in 0..NY {
    for x in 0..NX {
      top = LO;
      k = "";
      for z in LO..HI + 1 {
        c = cells[layer_index(x, y, z)] ?? "";
        if c != "" && c != "bridge" {
          top = z;
          k = c;
        }
      }
      level += [top];
      what += [k];
    }
  }
  Surface { level: level, what: what }
}

/// The tiles a trail runs over: each leg along x first, then along y, `width` tiles wide.
fn trail_tiles(t: const intent::Trail) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  for i in 1..len(t.points) {
    a = t.points[i - 1];
    b = t.points[i];
    corner = (b.x, a.y);
    for leg in [(a.x, a.y, corner.0, corner.1), (corner.0, corner.1, b.x, b.y)] {
      steps = if leg.0 != leg.2 { leg.2 - leg.0 } else { leg.3 - leg.1 };
      n = if steps < 0 { -steps } else { steps };
      sx = if leg.2 > leg.0 { 1 } else if leg.2 < leg.0 { -1 } else { 0 };
      sy = if leg.3 > leg.1 { 1 } else if leg.3 < leg.1 { -1 } else { 0 };
      for s in 0..n + 1 {
        for wd in 0..t.width {
          out += [(leg.0 + sx * s + (if sx == 0 { wd } else { 0 }), leg.1 + sy * s + (if sy == 0 { wd } else { 0 }))];
        }
      }
    }
  }
  out
}

/// Port a square place, from its level file's text.
pub fn port(raw: text, sz: hexwalls::Sizes, m: hexterrain::Measures, ys: Yards = default_yards()) -> Town {
  doc = json_parse(raw);
  it = intent::intent_from(doc.field("intent"));
  cells = layers(it);
  sf = surface(cells);
  // The terraces, smooth.
  // the steps' rows run north, the square map's south
  north: vector<integer> = [];
  for j in 0..NY { for i in 0..NX { north += [sf.level[(NY - 1 - j) * NX + i] ?? 0]; } }
  steps = hexterrain::Steps { x0: -0.5 * TILE, y0: -(NY as float - 0.5) * TILE, size: TILE, nx: NX, ny: NY,
                              level: north };
  // The window: the map's width and height in cells, and a margin.
  g = hexterrain::ground_new(-2, -82, NX + 6, 86);
  // the dry ground first (the bed's squares at level 0); the bed is dug in below, along its sides
  hexterrain::terraces(g, steps, m, 0, HI);
  bed = hex_field::hexset_chunk(g.q0, g.r0, g.w, g.h);
  levels = hex_field::labels_new(g.q0, g.r0, g.w, g.h);
  // The surface's kinds, tile by tile under each cell's centre.
  paths = hash_tiles(it);
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w {
      (x, y) = hexterrain::centre(q, r);
      tx = round(x / TILE) as integer;
      ty = round(-y / TILE) as integer;
      // the bed runs on past the map's edge, as the nearest square there has it (the terraces do too)
      ex = if tx < 0 { 0 } else if tx >= NX { NX - 1 } else { tx };
      ey = if ty < 0 { 0 } else if ty >= NY { NY - 1 } else { ty };
      if (sf.level[ey * NX + ex] ?? 0) < 0 { hex_field::hexset_set(bed, q, r, true); }
      hex_field::label_set(levels, q, r, sf.level[ey * NX + ex] ?? 0);
      if tx < 0 || tx >= NX || ty < 0 || ty >= NY { continue; }
      i = ty * NX + tx;
      k = sf.what[i] ?? "";
      lv = sf.level[i] ?? 0;
      kind = hexterrain::GRASS;
      if lv < 0 { kind = hexterrain::BED; }
      if k == "path" || k == "stairs_up" || k == "stairs_down" || k == "village_well" {
        kind = if lv < 0 { hexterrain::BED } else { hexterrain::PATH };
      }
      if k == "shallows" { kind = hexterrain::WATER; }
      if k == "paving" { kind = PAVING; }
      // a pillar stands on what lies round it: a gazebo's on the market's path
      if k == "pillar" {
        for nb in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
          nx = tx + nb.0;
          ny = ty + nb.1;
          if nx >= 0 && nx < NX && ny >= 0 && ny < NY && (sf.what[ny * NX + nx] ?? "") == "path" { kind = hexterrain::PATH; }
        }
      }
      if k == "field" { kind = FIELD; }
      p = paths[i] ?? -1;
      if p >= 0 { kind = p; }
      hex_field::label_set(g.kinds, q, r, kind);
    }
  }
  // the stream's bed a storey down, its banks along its straight sides (a path running down
  // into it, a ford, is dug with it)
  hexterrain::dig(g, bed, (-LO as float) * m.storey, m);
  // The fronts slope (owner, 2026-11-09), but not in the intent's cliff areas: there the ground
  // stands at its level's storey and drops a storey at a cliff along the level's straight sides.
  areas: vector<hexterrain::Box> = [];
  for a in it.cliffs {
    areas += [hexterrain::Box { x0: (a.x as float) * TILE - 0.5 * TILE, x1: ((a.x + a.w) as float) * TILE - 0.5 * TILE,
                                y0: -((a.y + a.h) as float) * TILE + 0.5 * TILE, y1: -(a.y as float) * TILE + 0.5 * TILE }];
  }
  sharp = hex_field::heights_new(g.q0, g.r0, g.w, g.h);
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w { hex_field::height_set(sharp, q, r, (hex_field::label_get(levels, q, r) as float) * m.storey); }
  }
  hexterrain::sharpen(g, sharp, areas, m);
  cliffs = hexterrain::cliffs(levels, g.q0, g.r0, g.w, g.h, LO, HI, areas);
  houses = place_houses(it, g, sz, m);
  // a house's seat blends the ground round it, but never across a cliff: in the cliff areas the
  // ground off its footprint stays at its level
  for r in g.r0..g.r0 + g.h {
    for q in g.q0..g.q0 + g.w {
      if hex_field::label_get(g.kinds, q, r) == hexterrain::FLOOR { continue; }
      (x, y) = hexterrain::centre(q, r);
      for a in areas {
        if hexterrain::box_distance(a, x, y) == 0.0 { hex_field::height_set(g.heights, q, r, hex_field::height_get(sharp, q, r)); }
      }
    }
  }
  things = things_of(cells, sf, m, g);
  for gr in it.grounds {
    // a gazebo's roof: a roof of two cells or more a side, on its pillars
    if (gr.what == "house_roof" || gr.what == "house_slate") && gr.w >= 2 && gr.h >= 2 {
      (rx, ry) = tile_xy((gr.x as float) + ((gr.w - 1) as float) * 0.5, (gr.y as float) + ((gr.h - 1) as float) * 0.5);
      (rq, rr) = hexterrain::cell_near(rx, ry);
      things += [Thing { kind: "gazebo_roof", x: rx, y: ry, z: hex_field::height_get(g.heights, rq, rr) + m.storey,
                         size: (gr.w as float) * TILE }];
    }
  }
  fences = dress(it, g, houses, things, sz, ys, m.storey);
  Town { ground: g, houses: houses, things: things, levels: levels, cliffs: cliffs, fences: fences }
}

/// The surface kind the trails and the shallow pools give a tile (-1: none), by tile index.
fn hash_tiles(it: const intent::Intent) -> vector<integer> {
  out: vector<integer> = [for _ in 0..NX * NY { -1 }];
  for t in it.trails {
    kind = if t.what == "rail" { hexterrain::RAIL } else { hexterrain::PATH };
    for c in trail_tiles(t) {
      if c.0 >= 0 && c.0 < NX && c.1 >= 0 && c.1 < NY { out[c.1 * NX + c.0] = kind; }
    }
  }
  for b in it.blobs {
    if b.what != "shallows" { continue; }
    for y in b.y..b.y + b.h {
      for x in b.x..b.x + b.w {
        dx = ((x - b.x) as float + 0.5) / (b.w as float) - 0.5;
        dy = ((y - b.y) as float + 0.5) / (b.h as float) - 0.5;
        if dx * dx + dy * dy <= 0.25 && x >= 0 && x < NX && y >= 0 && y < NY { out[y * NX + x] = hexterrain::WATER; }
      }
    }
  }
  out
}

/// The things on the surface: a tree, a fence, the well where the square place has one; a bridge
/// where it has a bridge, at its layer.
fn things_of(cells: const vector<text>, sf: const Surface, m: const hexterrain::Measures, g: hexterrain::Ground) -> vector<Thing> {
  out: vector<Thing> = [];
  for y in 0..NY {
    for x in 0..NX {
      i = y * NX + x;
      k = sf.what[i] ?? "";
      (tx, ty) = tile_xy(x as float, y as float);
      (q, r) = hexterrain::cell_near(tx, ty);
      foot = hex_field::height_get(g.heights, q, r);
      if is_tree(k) || k == "garden_fence" || k == "village_well" {
        out += [Thing { kind: k, x: tx, y: ty, z: foot }];
      }
      if k == "pillar" { out += [Thing { kind: k, x: tx, y: ty, z: foot, size: m.storey }]; }
      for z in LO..HI + 1 {
        if (cells[layer_index(x, y, z)] ?? "") == "bridge" {
          out += [Thing { kind: "bridge", x: tx, y: ty, z: (z as float) * m.storey }];
        }
      }
    }
  }
  out
}

/// The square house's doors and windows, as points on its plan's outline (half hex steps, the
/// plan's frame: u east, v north, its middle at 0): the front door `door_at` tiles from its west
/// side (the middle when -1) and a window either side of it, and each opening the square house
/// names, a door unless it is barred.
fn openings_of(h: const intent::House) -> vector<hexhouse::Spec> {
  out: vector<hexhouse::Spec> = [];
  if h.front {
    at = if h.door_at >= 0 { h.door_at } else { h.w / 2 ?? 0 };
    u = -h.w + 2 * at + 1;
    out += [hexhouse::Spec { kind: hexwalls::DOOR, u: u, v: -h.h }];
    if h.w >= 5 {
      out += [hexhouse::Spec { kind: hexwalls::WINDOW, u: (u - h.w) / 2 ?? 0, v: -h.h }];
      out += [hexhouse::Spec { kind: hexwalls::WINDOW, u: (u + h.w) / 2 ?? 0, v: -h.h }];
    }
  }
  seen: vector<(integer, integer)> = [];
  for o in h.openings {
    // a cell beyond the walls is a bay window's own: its wall's opening stands for it
    if !in_house(h, o.x, o.y) || seen.contains((o.x, o.y)) { continue; }
    seen += [(o.x, o.y)];
    door = o.cell != "" && o.cell != "barred" && o.edge != "window";
    kind = if door { hexwalls::DOOR } else { hexwalls::WINDOW };
    u = 2 * (o.x - h.x) - h.w + 1;
    v = -(2 * (o.y - h.y) - h.h + 1);
    out += [hexhouse::Spec { kind: kind, u: u, v: v }];
  }
  out
}

fn in_house(h: const intent::House, x: integer, y: integer) -> boolean {
  x >= h.x && x < h.x + h.w && y >= h.y && y < h.y + h.h
}

/// The wall cells of a house a bay window stands out from: an opening of its wall with an opening
/// just beyond the wall.
fn bay_cells(h: const intent::House) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  for o in h.openings {
    if !in_house(h, o.x, o.y) || out.contains((o.x, o.y)) { continue; }
    for p in h.openings {
      beside = (p.x - o.x) * (p.x - o.x) + (p.y - o.y) * (p.y - o.y) == 1;
      if beside && !in_house(h, p.x, p.y) && !out.contains((o.x, o.y)) { out += [(o.x, o.y)]; }
    }
  }
  out
}

/// The angle facing down the hill at (x, y) metres: the ground's fall there to the nearest 30°,
/// 0 where it is near flat (the square house's own angle, its front south).
fn facing(g: hexterrain::Ground, x: float, y: float) -> integer {
  (q, r) = hexterrain::cell_near(x, y);
  (qe, re) = hexterrain::cell_near(x + 3.0, y);
  (qw, rw) = hexterrain::cell_near(x - 3.0, y);
  (qn, rn) = hexterrain::cell_near(x, y + 3.0);
  (qs, rs) = hexterrain::cell_near(x, y - 3.0);
  gx = (hex_field::height_get(g.heights, qe, re) - hex_field::height_get(g.heights, qw, rw)) / 6.0;
  gy = (hex_field::height_get(g.heights, qn, rn) - hex_field::height_get(g.heights, qs, rs)) / 6.0;
  if sqrt(gx * gx + gy * gy) < 0.05 { return 0; }
  // the front faces south (270°) at turn 0, and 30° further each turn
  down = atan2(-gy, -gx) * 180.0 / PI;
  t = round((down - 270.0) / 30.0) as integer;
  ((t % 12) + 12) % 12 ?? 0
}

/// Every cell of `a` also in `b`?
fn overlaps(a: hex_field::HexSet, b: hex_field::HexSet) -> boolean {
  for r in hex_field::hexset_r0(a)..hex_field::hexset_r0(a) + hex_field::hexset_h(a) {
    for q in hex_field::hexset_q0(a)..hex_field::hexset_q0(a) + hex_field::hexset_w(a) {
      if hex_field::hexset_get(a, q, r) && hex_field::hexset_get(b, q, r) { return true; }
    }
  }
  false
}

/// Does `a` lie across a road or a rail: on more of its cells than the start of the way to its own
/// door (three)?
fn on_a_way(g: hexterrain::Ground, a: hex_field::HexSet) -> boolean {
  n = 0;
  for r in hex_field::hexset_r0(a)..hex_field::hexset_r0(a) + hex_field::hexset_h(a) {
    for q in hex_field::hexset_q0(a)..hex_field::hexset_q0(a) + hex_field::hexset_w(a) {
      if !hex_field::hexset_get(a, q, r) { continue; }
      k = hex_field::label_get(g.kinds, q, r);
      if k == hexterrain::PATH || k == hexterrain::RAIL { n += 1; }
    }
  }
  n > 3
}

/// A house's plan: its own rectangle, and one for each wing, in the plan's half hex steps from
/// the house's middle (u east, v north).
fn plan_of(h: const intent::House) -> vector<hexhouse::Part> {
  out = hexhouse::box_plan(h.w, h.h);
  for wg in h.wings {
    out += [hexhouse::Part { u0: 2 * (wg.x - h.x) - h.w, v0: h.h - 2 * (wg.y + wg.h - h.y),
                             u1: 2 * (wg.x + wg.w - h.x) - h.w, v1: h.h - 2 * (wg.y - h.y) }];
  }
  out
}

/// Every house of the intent, placed (see the top of the file).
fn place_houses(it: const intent::Intent, g: hexterrain::Ground, sz: hexwalls::Sizes, m: const hexterrain::Measures) -> vector<Placed> {
  taken = hex_field::hexset_chunk(g.q0, g.r0, g.w, g.h);
  out: vector<Placed> = [];
  for h in it.houses {
    // the middle of its tiles (tile i's centre is at 1.5 i)
    (x, y) = tile_xy((h.x as float) + ((h.w - 1) as float) * 0.5, (h.y as float) + ((h.h - 1) as float) * 0.5);
    (cq, cr) = hexterrain::cell_near(x, y);
    // its angle: the place's own where it gives one, else facing down the hill
    turn = if h.turn >= 0 { h.turn % 12 ?? 0 } else { facing(g, x, y) };
    // an out-house stands in its house's yard, and turns with it
    if h.out {
      for yd in it.yards {
        if yd.z != h.z || h.x < yd.x || h.x + h.w > yd.x + yd.w || h.y < yd.y || h.y + h.h > yd.y + yd.h { continue; }
        hi = yard_house(it, yd, false);
        if hi < 0 || hi >= len(out) { continue; }
        main = it.houses[hi]!;
        mp = out[hi]!;
        turn = mp.turn;
        (ox, oy) = with_house(main, mp, drawn_cells(main, mp), (h.x as float) + ((h.w - 1) as float) * 0.5,
                              (h.y as float) + ((h.h - 1) as float) * 0.5);
        (oq, orr) = hexterrain::cell_near(ox, oy);
        cq = oq;
        cr = orr;
      }
    }
    plan = hexhouse::HexHouse { cq: cq, cr: cr, turn: turn, parts: plan_of(h), openings: openings_of(h) };
    b = hexhouse::build(plan, hexturn::BY_WALLS, sz);
    // @FR-HY-Angle
    // square to the grid where its turn would not fit: on a house already placed, or across a way
    if plan.turn != 0 && (overlaps(b.cells, taken) || on_a_way(g, b.cells)) {
      plan.turn = 0;
      b = hexhouse::build(plan, hexturn::BY_WALLS, sz);
    }
    for r in hex_field::hexset_r0(b.cells)..hex_field::hexset_r0(b.cells) + hex_field::hexset_h(b.cells) {
      for q in hex_field::hexset_q0(b.cells)..hex_field::hexset_q0(b.cells) + hex_field::hexset_w(b.cells) {
        if hex_field::hexset_get(b.cells, q, r) { hex_field::hexset_set(taken, q, r, true); }
      }
    }
    floor = (h.z as float) * m.storey;
    base = hexterrain::seat(g, b.cells, floor, m);
    for r in hex_field::hexset_r0(b.cells)..hex_field::hexset_r0(b.cells) + hex_field::hexset_h(b.cells) {
      for q in hex_field::hexset_q0(b.cells)..hex_field::hexset_q0(b.cells) + hex_field::hexset_w(b.cells) {
        if hex_field::hexset_get(b.cells, q, r) { hex_field::label_set(g.kinds, q, r, hexterrain::FLOOR); }
      }
    }
    out += [Placed { built: b, turn: plan.turn, floor: floor, base: (if base < floor { base } else { floor }) - 0.3,
                     top: floor + ((if h.floors > 0 { h.floors } else { 1 }) as float) * m.storey, cq: cq, cr: cr }];
  }
  out
}

// ── what the basic tiles could not show (owner, 2026-11-14) ────────────────────────────────────

/// A house's cells as its plan gives them at 0°: what its turn was made from.
fn drawn_cells(h: const intent::House, p: const Placed) -> hex_field::HexSet {
  plan = hexhouse::HexHouse { cq: p.cq, cr: p.cr, turn: 0, parts: plan_of(h) };
  r = hexhouse::reach(plan) + 2;
  cells = hex_field::hexset_chunk(p.cq - r, p.cr - r, 2 * r + 1, 2 * r + 1);
  hexhouse::fill(plan, cells);
  cells
}

/// Where the point (tx, ty) of the square map (tiles, a cell's centre at whole numbers) lies in the
/// hex town, in metres: turned with house `h` as it was placed (its plan's middle on its cell, an
/// odd turn's offset with it).
fn with_house(h: const intent::House, p: const Placed, drawn: hex_field::HexSet, tx: float, ty: float) -> (float, float) {
  mx = (h.x as float) + ((h.w - 1) as float) * 0.5;
  my = (h.y as float) + ((h.h - 1) as float) * 0.5;
  // a tile is two half hex steps, each √3/2 units
  x = (hex_field::lattice_k(p.cq, p.cr) as float) * 0.8660254037844386 + 2.0 * (tx - mx) * 0.8660254037844386;
  y = (hex_field::lattice_m(p.cq, p.cr) as float) * 0.5 - 2.0 * (ty - my) * 0.8660254037844386;
  if p.turn == 0 { return (x * hexterrain::METRE, y * hexterrain::METRE); }
  (wx, wy) = hexturn::turned_point(drawn, p.cq, p.cr, p.turn, hexturn::BY_WALLS, x, y);
  (wx * hexterrain::METRE, wy * hexterrain::METRE)
}

fn inside(poly: const vector<(float, float)>, x: float, y: float) -> boolean {
  n = len(poly);
  hit = false;
  for j in 0..n {
    a = poly[(j + n - 1) % n ?? 0] ?? (0.0, 0.0);
    b = poly[j] ?? (0.0, 0.0);
    if (a.1 > y) != (b.1 > y) {
      cx = a.0 + (y - a.1) * (b.0 - a.0) / (b.1 - a.1) ?? a.0;
      if x < cx { hit = !hit; }
    }
  }
  hit
}

/// The cells with their centre in `poly` (metres) get surface `kind`.
fn pave(g: hexterrain::Ground, poly: const vector<(float, float)>, kind: integer) {
  lo_x = 1000000.0;
  hi_x = -1000000.0;
  lo_y = 1000000.0;
  hi_y = -1000000.0;
  for c in poly {
    if c.0 < lo_x { lo_x = c.0; }
    if c.0 > hi_x { hi_x = c.0; }
    if c.1 < lo_y { lo_y = c.1; }
    if c.1 > hi_y { hi_y = c.1; }
  }
  (qa, ra) = hexterrain::cell_near(lo_x, lo_y);
  (qb, rb) = hexterrain::cell_near(hi_x, hi_y);
  for r in ra - 1..rb + 2 {
    for q in qa - 1..qb + 2 {
      (x, y) = hexterrain::centre(q, r);
      if inside(poly, x, y) { hex_field::label_set(g.kinds, q, r, kind); }
    }
  }
}

/// The house yard `yd` belongs to: the one whose roof it lies on (`roof`), or the one it stands
/// against on a side it leaves open; -1 for a yard of its own.
fn yard_house(it: const intent::Intent, yd: const intent::Yard, roof: boolean) -> integer {
  for i in 0..len(it.houses) {
    h = it.houses[i];
    fl = if h.floors > 0 { h.floors } else { 1 };
    if roof {
      if yd.z == h.z + fl && yd.x >= h.x && yd.x + yd.w <= h.x + h.w && yd.y >= h.y && yd.y + yd.h <= h.y + h.h { return i; }
      continue;
    }
    if yd.z != h.z { continue; }
    // a cell of the house, or of a wing of it, just beyond a side the yard leaves open
    for j in 0..len(yd.open) {
      sd = yd.open[j..j + 1];
      for y in yd.y..yd.y + yd.h {
        if sd == "W" && intent::house_covers(h, yd.x - 1, y) { return i; }
        if sd == "E" && intent::house_covers(h, yd.x + yd.w, y) { return i; }
      }
      for x in yd.x..yd.x + yd.w {
        if sd == "N" && intent::house_covers(h, x, yd.y - 1) { return i; }
        if sd == "S" && intent::house_covers(h, x, yd.y + yd.h) { return i; }
      }
    }
  }
  -1
}

/// The yards, the courts, the bay windows and the roof gardens of the place, on the hex town: what
/// stands along each yard's sides (its gates left open), turned with the house it belongs to; a
/// paved yard's and a court's cells paved; a court's pillars; a roof garden's bushes on its roof.
// @FR-HY-Side, @FR-HY-Turn, @FR-HY-Court, @FR-HY-Roof, @FR-HY-Bay: the yards and the houses' new parts, from the square map
fn dress(it: const intent::Intent, g: hexterrain::Ground, houses: vector<Placed>, things: vector<Thing>,
         sz: hexwalls::Sizes, ys: const Yards, storey: float) -> vector<Fence> {
  out: vector<Fence> = [];
  _ = sz;
  for i in 0..len(it.houses) {
    h = it.houses[i]!;
    p = houses[i]!;
    bays = bay_cells(h);
    ct = intent::court_of(h);
    if len(bays) == 0 && ct.w <= 0 { continue; }
    drawn = drawn_cells(h, p);
    for bc in bays {
      (bx, by) = with_house(h, p, drawn, bc.0 as float, bc.1 as float);
      best = -1;
      best_d = 0.0;
      for oi in 0..len(p.built.openings) {
        o = p.built.openings[oi];
        d = (o.cx * hexterrain::METRE - bx) * (o.cx * hexterrain::METRE - bx) + (o.cy * hexterrain::METRE - by) * (o.cy * hexterrain::METRE - by);
        if best < 0 || d < best_d {
          best = oi;
          best_d = d;
        }
      }
      if best >= 0 && !p.bays.contains(best) { p.bays += [best]; }
    }
    if ct.w > 0 {
      x0 = (ct.x as float) - 0.5;
      y0 = (ct.y as float) - 0.5;
      x1 = x0 + (ct.w as float);
      y1 = y0 + (ct.h as float);
      // anticlockwise from its south-west corner, as the house's own outline goes
      for c in [(x0, y1), (x1, y1), (x1, y0), (x0, y0)] { p.court += [with_house(h, p, drawn, c.0, c.1)]; }
      pave(g, p.court, PAVING);
      for y in ct.y..ct.y + ct.h {
        for x in ct.x..ct.x + ct.w {
          if !intent::court_pillar(h, x, y) { continue; }
          (px, py) = with_house(h, p, drawn, x as float, y as float);
          things += [Thing { kind: "pillar", x: px, y: py, z: p.floor, size: p.top - p.floor }];
        }
      }
    }
  }
  for yd in it.yards {
    on_roof = yard_house(it, yd, true);
    if on_roof >= 0 {
      // a roof garden: the low wall is the house's own, and so are the bushes
      houses[on_roof]!.roof = ROOF_GARDEN;
      rh = it.houses[on_roof]!;
      rp = houses[on_roof]!;
      rdrawn = drawn_cells(rh, rp);
      for og in it.over {
        if og.z != yd.z || !is_tree(og.what) || !in_house(rh, og.x, og.y) { continue; }
        (bx, by) = with_house(rh, rp, rdrawn, og.x as float, og.y as float);
        things += [Thing { kind: og.what, x: bx, y: by, z: rp.top + 0.3 }];
      }
      continue;
    }
    hi = yard_house(it, yd, false);
    kind = fence_kind(yd.what);
    x0 = (yd.x as float) - 0.5;
    y0 = (yd.y as float) - 0.5;
    x1 = x0 + (yd.w as float);
    y1 = y0 + (yd.h as float);
    // each side as (its name, from, to, the sides at its two ends)
    sides = [("N", x0, y0, x1, y0, "W", "E"), ("S", x0, y1, x1, y1, "W", "E"),
             ("W", x0, y0, x0, y1, "N", "S"), ("E", x1, y0, x1, y1, "N", "S")];
    drawn = if hi >= 0 { drawn_cells(it.houses[hi]!, houses[hi]!) } else { hex_field::hexset_chunk(0, 0, 1, 1) };
    hull: vector<(float, float)> = [];
    if hi >= 0 { for c in houses[hi]!.built.corners { hull += [(c.0 * hexterrain::METRE, c.1 * hexterrain::METRE)]; } }
    if yd.floor != "" {
      poly: vector<(float, float)> = [];
      for c in [(x0, y1), (x1, y1), (x1, y0), (x0, y0)] {
        poly += [if hi >= 0 { with_house(it.houses[hi]!, houses[hi]!, drawn, c.0, c.1) } else { tile_xy(c.0, c.1) }];
      }
      pave(g, poly, PAVING);
    }
    // what lies in a yard turns with its house too: its plots and paving, its trees
    if hi >= 0 && houses[hi]!.turn != 0 {
      lo = tile_xy(x0, y1);
      up = tile_xy(x1, y0);
      for r in g.r0..g.r0 + g.h {
        for q in g.q0..g.q0 + g.w {
          (cx, cy) = hexterrain::centre(q, r);
          k = hex_field::label_get(g.kinds, q, r);
          if cx > lo.0 && cx < up.0 && cy > lo.1 && cy < up.1 && (k == PAVING || k == FIELD) {
            hex_field::label_set(g.kinds, q, r, hexterrain::GRASS);
          }
        }
      }
      for gr in it.grounds {
        if gr.z != yd.z || (gr.what != "paving" && gr.what != "field") { continue; }
        for ty in gr.y..gr.y + gr.h {
          for tx in gr.x..gr.x + gr.w {
            if tx < yd.x || tx >= yd.x + yd.w || ty < yd.y || ty >= yd.y + yd.h { continue; }
            tile: vector<(float, float)> = [];
            for c in [(-0.5, 0.5), (0.5, 0.5), (0.5, -0.5), (-0.5, -0.5)] {
              tile += [with_house(it.houses[hi]!, houses[hi]!, drawn, (tx as float) + c.0, (ty as float) + c.1)];
            }
            pave(g, tile, if gr.what == "field" { FIELD } else { PAVING });
          }
        }
      }
      for th in things {
        tx = round(th.x / TILE) as integer;
        ty = round(-th.y / TILE) as integer;
        (sx, sy) = tile_xy(tx as float, ty as float);
        here = (th.x - sx) * (th.x - sx) + (th.y - sy) * (th.y - sy) < 0.01;
        if !here || tx < yd.x || tx >= yd.x + yd.w || ty < yd.y || ty >= yd.y + yd.h || th.kind == "bridge" { continue; }
        (nx, ny) = with_house(it.houses[hi]!, houses[hi]!, drawn, tx as float, ty as float);
        th.x = nx;
        th.y = ny;
      }
    }
    for sd in sides {
      if open_side(yd.open, sd.0) { continue; }
      across = sd.0 == "N" || sd.0 == "S";
      n = if across { yd.w } else { yd.h };
      // the stretches between its gates, in cells along it
      from = 0;
      for c in 0..n + 1 {
        gate = c < n && gated(yd, sd.0, if across { yd.x + c } else { yd.x + (if sd.0 == "E" { yd.w - 1 } else { 0 }) },
                              if across { yd.y + (if sd.0 == "S" { yd.h - 1 } else { 0 }) } else { yd.y + c });
        if c < n && !gate { continue; }
        if c > from {
          // run on a little where the side ends at the house, and stop at its wall
          a = (from as float) - (if from == 0 && open_side(yd.open, sd.5) { 0.8 } else { 0.0 });
          b = (c as float) + (if c == n && open_side(yd.open, sd.6) { 0.8 } else { 0.0 });
          ta = (if across { sd.1 + a } else { sd.1 }, if across { sd.2 } else { sd.2 + a });
          tb = (if across { sd.1 + b } else { sd.1 }, if across { sd.2 } else { sd.2 + b });
          pa = if hi >= 0 { with_house(it.houses[hi]!, houses[hi]!, drawn, ta.0, ta.1) } else { tile_xy(ta.0, ta.1) };
          pb = if hi >= 0 { with_house(it.houses[hi]!, houses[hi]!, drawn, tb.0, tb.1) } else { tile_xy(tb.0, tb.1) };
          (ca, cb) = outside(hull, pa, pb);
          // and what an out-house in the yard stands on: its own wall is the yard's side there
          for oi in 0..len(it.houses) {
            oh = it.houses[oi]!;
            if !oh.out || oh.z != yd.z || oh.x < yd.x || oh.x + oh.w > yd.x + yd.w || oh.y < yd.y || oh.y + oh.h > yd.y + yd.h { continue; }
            shed: vector<(float, float)> = [];
            // a little wider than it stands, so a side along its wall goes with it
            mid = (0.0, 0.0);
            for sc in houses[oi]!.built.corners { mid = (mid.0 + sc.0 * hexterrain::METRE, mid.1 + sc.1 * hexterrain::METRE); }
            nsc = len(houses[oi]!.built.corners) as float;
            mid = (mid.0 / nsc ?? 0.0, mid.1 / nsc ?? 0.0);
            for sc in houses[oi]!.built.corners {
              shed += [(mid.0 + (sc.0 * hexterrain::METRE - mid.0) * 1.15, mid.1 + (sc.1 * hexterrain::METRE - mid.1) * 1.15)];
            }
            (ca, cb) = outside(shed, ca, cb);
          }
          if (cb.0 - ca.0) * (cb.0 - ca.0) + (cb.1 - ca.1) * (cb.1 - ca.1) < 0.09 { from = c + 1; continue; }
          out += [Fence { kind: kind, ax: ca.0, ay: ca.1, bx: cb.0, by: cb.1, height: ys.heights[kind] ?? 1.0,
                          thick: ys.thicks[kind] ?? 0.3 }];
        }
        from = c + 1;
      }
    }
  }
  // @FR-HY-Parts: every house in parts, the house itself and its wings, each with its roof
  for i in 0..len(it.houses) {
    h = it.houses[i]!;
    p = houses[i]!;
    drawn = drawn_cells(h, p);
    roof = if p.roof != ROOF_PITCHED { p.roof } else if h.top == "attic" { ROOF_ATTIC } else if h.top == "flat" { ROOF_FLAT } else { ROOF_PITCHED };
    main = block_of(h, p, drawn, h.x, h.y, h.w, h.h, p.top, roof);
    if roof == ROOF_ATTIC {
      // a dormer where the square attic has one, along the longer side
      n = (if h.w >= h.h { h.w } else { h.h }) - 2;
      for c in 0..n {
        if intent::dormer(c) { main.dormers += [((c as float) + 0.5 - (n as float) * 0.5) * TILE]; }
      }
    }
    p.parts += [main];
    for wg in h.wings {
      sd = intent::wing_side(h, wg);
      if sd == "" { continue; }
      wtop = p.floor + (wg.floors as float) * storey;
      wroof = if wg.top == "terrace" { ROOF_TERRACE } else if wg.top == "flat" { ROOF_FLAT } else { ROOF_PITCHED };
      p.parts += [block_of(h, p, drawn, wg.x, wg.y, wg.w, wg.h, wtop, wroof)];
      if wtop >= p.top - 0.01 { continue; }
      // the house's wall over the wing's roof, along where they touch
      a0 = (if wg.y > h.y { wg.y } else { h.y }) as float - 0.5;
      a1 = (if wg.y + wg.h < h.y + h.h { wg.y + wg.h } else { h.y + h.h }) as float - 0.5;
      b0 = (if wg.x > h.x { wg.x } else { h.x }) as float - 0.5;
      b1 = (if wg.x + wg.w < h.x + h.w { wg.x + wg.w } else { h.x + h.w }) as float - 0.5;
      line = if sd == "W" { ((wg.x as float) - 0.5, a0, (wg.x as float) - 0.5, a1) }
             else if sd == "E" { ((h.x as float) - 0.5, a0, (h.x as float) - 0.5, a1) }
             else if sd == "N" { (b0, (wg.y as float) - 0.5, b1, (wg.y as float) - 0.5) }
             else { (b0, (h.y as float) - 0.5, b1, (h.y as float) - 0.5) };
      (rax, ray) = onto(main, with_house(h, p, drawn, line.0, line.1));
      (rbx, rby) = onto(main, with_house(h, p, drawn, line.2, line.3));
      p.rises += [Rise { ax: rax, ay: ray, bx: rbx, by: rby, z0: wtop, z1: p.top }];
    }
    // each wall of the outline with the part it belongs to: a point just inside its middle
    nc = len(p.built.corners);
    for wi in 0..nc {
      ca = p.built.corners[(wi + nc - 1) % nc ?? 0] ?? (0.0, 0.0);
      cb = p.built.corners[wi] ?? (0.0, 0.0);
      wl = sqrt((cb.0 - ca.0) * (cb.0 - ca.0) + (cb.1 - ca.1) * (cb.1 - ca.1));
      mx = (ca.0 + cb.0) * 0.5 * hexterrain::METRE - ((cb.1 - ca.1) / wl ?? 0.0);
      my = (ca.1 + cb.1) * 0.5 * hexterrain::METRE + ((cb.0 - ca.0) / wl ?? 0.0);
      top = p.top;
      rim = 0.0;
      // a wing before the house: where both hold the point, the wall is the wing's
      for bi in 0..len(p.parts) {
        b = p.parts[len(p.parts) - 1 - bi]!;
        poly: vector<(float, float)> = [for j in 0..4 { (b.xs[j] ?? 0.0, b.ys[j] ?? 0.0) }];
        if !inside(poly, mx, my) { continue; }
        top = b.top;
        rim = if b.roof == ROOF_GARDEN || b.roof == ROOF_TERRACE { 1.3 } else if b.roof == ROOF_FLAT { 0.4 } else { 0.0 };
        break;
      }
      p.tops += [top];
      p.rims += [rim];
    }
  }
  out
}

/// A part of house `h` as placed: the square map's rectangle w by h from (x, y), turned with it.
fn block_of(h: const intent::House, p: const Placed, drawn: hex_field::HexSet, x: integer, y: integer, w: integer, d: integer,
            top: float, roof: integer) -> Block {
  x0 = (x as float) - 0.5;
  y0 = (y as float) - 0.5;
  x1 = x0 + (w as float);
  y1 = y0 + (d as float);
  xs: vector<float> = [];
  ys: vector<float> = [];
  for c in [(x0, y1), (x1, y1), (x1, y0), (x0, y0)] {
    (cx, cy) = with_house(h, p, drawn, c.0, c.1);
    xs += [cx];
    ys += [cy];
  }
  fitted(Block { xs: xs, ys: ys, top: top, roof: roof }, p)
}

/// The point `at` taken onto the nearest side of part `b`.
fn onto(b: const Block, at: (float, float)) -> (float, float) {
  best = at;
  best_d = -1.0;
  for i in 0..4 {
    ax = b.xs[i] ?? 0.0;
    ay = b.ys[i] ?? 0.0;
    bx = b.xs[(i + 1) % 4 ?? 0] ?? 0.0;
    by = b.ys[(i + 1) % 4 ?? 0] ?? 0.0;
    l2 = (bx - ax) * (bx - ax) + (by - ay) * (by - ay);
    t = ((at.0 - ax) * (bx - ax) + (at.1 - ay) * (by - ay)) / l2 ?? 0.0;
    fx = ax + (bx - ax) * t;
    fy = ay + (by - ay) * t;
    d = (at.0 - fx) * (at.0 - fx) + (at.1 - fy) * (at.1 - fy);
    if best_d < 0.0 || d < best_d {
      best = (fx, fy);
      best_d = d;
    }
  }
  best
}

/// The part with each of its sides moved onto the house's drawn wall along it: the walls stand on
/// the lines between two rows of hex centres, up to half a row from the square map's (HT-Near), and
/// a roof belongs on its walls.  A side with no wall along it (where a wing meets the house) stays.
fn fitted(b: const Block, p: const Placed) -> Block {
  nc = len(p.built.corners);
  // each side as a point and a unit direction, moved along its normal
  px: vector<float> = [];
  py: vector<float> = [];
  dx: vector<float> = [];
  dy: vector<float> = [];
  for i in 0..4 {
    ax = b.xs[i] ?? 0.0;
    ay = b.ys[i] ?? 0.0;
    bx = b.xs[(i + 1) % 4 ?? 0] ?? 0.0;
    by = b.ys[(i + 1) % 4 ?? 0] ?? 0.0;
    l = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay));
    ux = (bx - ax) / l ?? 1.0;
    uy = (by - ay) / l ?? 0.0;
    best = 1.2;
    shift = 0.0;
    for wi in 0..nc {
      ca = p.built.corners[(wi + nc - 1) % nc ?? 0] ?? (0.0, 0.0);
      cb = p.built.corners[wi] ?? (0.0, 0.0);
      wx = (cb.0 - ca.0) * hexterrain::METRE;
      wy = (cb.1 - ca.1) * hexterrain::METRE;
      wl = sqrt(wx * wx + wy * wy);
      cross = (ux * wy - uy * wx) / wl ?? 1.0;
      if cross > 0.05 || cross < -0.05 { continue; }
      mx = ca.0 * hexterrain::METRE - ax;
      my = ca.1 * hexterrain::METRE - ay;
      // the wall runs along the side for half a metre or more of it
      t0 = mx * ux + my * uy;
      t1 = t0 + wx * ux + wy * uy;
      lo = if t0 < t1 { t0 } else { t1 };
      hi = if t0 < t1 { t1 } else { t0 };
      shared = (if hi < l { hi } else { l }) - (if lo > 0.0 { lo } else { 0.0 });
      off = -mx * uy + my * ux;
      d = if off < 0.0 { -off } else { off };
      if shared < 0.5 || d >= best { continue; }
      best = d;
      shift = off;
    }
    px += [ax - uy * shift];
    py += [ay + ux * shift];
    dx += [ux];
    dy += [uy];
  }
  // corner i is where side i - 1 meets side i
  xs: vector<float> = [];
  ys: vector<float> = [];
  for i in 0..4 {
    j = (i + 3) % 4 ?? 0;
    det = (dx[j] ?? 1.0) * (dy[i] ?? 0.0) - (dy[j] ?? 0.0) * (dx[i] ?? 1.0);
    t = (((px[i] ?? 0.0) - (px[j] ?? 0.0)) * (dy[i] ?? 0.0) - ((py[i] ?? 0.0) - (py[j] ?? 0.0)) * (dx[i] ?? 1.0)) / det ?? 0.0;
    xs += [(px[j] ?? 0.0) + (dx[j] ?? 1.0) * t];
    ys += [(py[j] ?? 0.0) + (dy[j] ?? 0.0) * t];
  }
  Block { xs: xs, ys: ys, top: b.top, roof: b.roof }
}

fn open_side(sides: text, side: text) -> boolean {
  for i in 0..len(sides) { if sides[i..i + 1] == side { return true; } }
  false
}

fn gated(yd: const intent::Yard, side: text, x: integer, y: integer) -> boolean {
  for gt in yd.gates { if gt.x == x && gt.y == y && gt.side == side { return true; } }
  false
}

// @FR-HY-Outside, @FR-HY-Turn: a side that ends at the house is cut at its outline
/// The stretch from a to b with what lies inside `hull` (a house's outline) taken off its ends.
fn outside(hull: const vector<(float, float)>, a: (float, float), b: (float, float)) -> ((float, float), (float, float)) {
  if len(hull) < 3 { return (a, b); }
  lo = 0;
  hi = 40;
  while lo < hi && inside(hull, a.0 + (b.0 - a.0) * (lo as float) / 40.0, a.1 + (b.1 - a.1) * (lo as float) / 40.0) { lo += 1; }
  while hi > lo && inside(hull, a.0 + (b.0 - a.0) * (hi as float) / 40.0, a.1 + (b.1 - a.1) * (hi as float) / 40.0) { hi -= 1; }
  ((a.0 + (b.0 - a.0) * (lo as float) / 40.0, a.1 + (b.1 - a.1) * (lo as float) / 40.0),
   (a.0 + (b.0 - a.0) * (hi as float) / 40.0, a.1 + (b.1 - a.1) * (hi as float) / 40.0))
}

// ── a hill with a house at every angle ──────────────────────────────────────

/// A round hill with twelve houses round it, each facing down the hill: at every 30° angle, and
/// each at the height of the ground where it stands, at four distances from the top in turn (owner, 2026-11-09: houses at different
/// heights and angles).  Boxes and L's in turn, each with a door and windows.
pub fn showcase(sz: hexwalls::Sizes, m: hexterrain::Measures) -> Town {
  g = hexterrain::ground_new(-30, -34, 60, 68);
  hexterrain::hill(g, 0.0, 0.0, 40.0, 10.0);
  taken = hex_field::hexset_chunk(g.q0, g.r0, g.w, g.h);
  houses: vector<Placed> = [];
  for k in 0..12 {
    a = (k as float) * PI / 6.0;
    // at 15, 20, 25 and 30 m from the top in turn: four heights up the slope
    d = 15.0 + 5.0 * ((k % 4) as float);
    x = d * cos(a);
    y = d * sin(a);
    (cq, cr) = hexterrain::cell_near(x, y);
    // facing down the hill: outward, the front south at turn 0
    t = ((k - 9) % 12 + 12) % 12 ?? 0;
    // an L whose walls are all long enough to keep (a wall under three hex steps may be lost)
    parts = if k % 2 == 0 { hexhouse::box_plan(5, 4) } else { hexhouse::l_plan(5, 3, 2, 2) };
    ops = [hexhouse::Spec { kind: hexwalls::DOOR, u: 0, v: if k % 2 == 0 { -4 } else { -3 } },
           hexhouse::Spec { kind: hexwalls::WINDOW, u: -3, v: if k % 2 == 0 { -4 } else { -3 } },
           hexhouse::Spec { kind: hexwalls::WINDOW, u: 5, v: 0 }];
    b = hexhouse::build(hexhouse::HexHouse { cq: cq, cr: cr, turn: t, parts: parts, openings: ops }, hexturn::BY_WALLS, sz);
    floor = round(hex_field::height_get(g.heights, cq, cr) * 10.0) / 10.0;
    base = hexterrain::seat(g, b.cells, floor, m);
    houses += [Placed { built: b, turn: t, floor: floor, base: (if base < floor { base } else { floor }) - 0.3,
                        top: floor + ((1 + k % 2) as float) * m.storey }];
  }
  things: vector<Thing> = [];
  for k in 0..24 {
    a = (k as float + 0.5) * PI / 12.0;
    x = 40.0 * cos(a);
    y = 40.0 * sin(a);
    (q, r) = hexterrain::cell_near(x, y);
    things += [Thing { kind: if k % 3 == 0 { "pine" } else if k % 3 == 1 { "oak" } else { "poplar" }, x: x, y: y,
                       z: hex_field::height_get(g.heights, q, r) }];
  }
  Town { ground: g, houses: houses, things: things, levels: hex_field::labels_new(g.q0, g.r0, g.w, g.h) }
}
