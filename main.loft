// The first climb on whatever this machine has: a desktop window (screen, X11), or a device
// display.  The keys come from the screen's window where it has them, and from the machine's
// own keyboard (input) where it does not — a question asked of the machine, not a platform
// branch.  Run: loft --lib libs main.loft
use game;
use screen;
use tiles;
use audio;
use input;

// Moves by letter (`w` `a` `s` `d`, `p` before one to pull), as TW_MOVES lists them.
fn play_moves(game: game::Game, moves: text) {
  for m in moves.split(' ') {
    pull = m.starts_with("p");
    d = if pull { m[1..] } else { m };
    if d == "w" { game::move(game, 0, -1, pull); }
    if d == "s" { game::move(game, 0, 1, pull); }
    if d == "a" { game::move(game, -1, 0, pull); }
    if d == "d" { game::move(game, 1, 0, pull); }
  }
}

// Keys by code, a tick down and a tick up each, `+` joining keys held together — read by the
// game exactly as a keyboard's are.
fn press(game: game::Game, keys: text) {
  now = 0;
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  for chord in keys.split(' ') {
    if chord == "" { continue; }
    down = up;
    for c in chord.split('+') {
      code = c as integer ?? 0;
      if code > 0 && code < 256 { down[code] = true; }
    }
    for pressed in [true, false] {
      game.keys.input_tick_from_state(if pressed { down } else { up }, 0.0, 0.0, 0, 0);
      now += 1000;
      _ = game::update(game, 0, now);
    }
  }
}

// TW_SHOT=<file.png> [TW_LEVEL=1] [TW_MOVES="s d d"] [TW_EDIT="d d tab paint"]
// [TW_KEYS="101 9 32 133+122"]: play those moves, then open the editor and make those edits
// (game::edit's words), then press those keys (codes, `+` for keys held together) a tick
// each as the game would read them, and write the frame as a picture — with no screen.
// TW_CREDITS=1 writes the credits instead.
fn picture(game: game::Game, shot: text) {
  if (env_variable("TW_CREDITS") ?? "") != "" {
    game::draw_credits(game);
  } else {
    game::start_level(game, (env_variable("TW_LEVEL") ?? "0") as integer ?? 0);
    play_moves(game, env_variable("TW_MOVES") ?? "");
    edits = env_variable("TW_EDIT") ?? "";
    if edits != "" {
      game::toggle_editor(game);
      for e in edits.split(' ') { game::edit(game, e); }
    }
    press(game, env_variable("TW_KEYS") ?? "");
    game::draw(game);
  }
  println(if game::snapshot(game, shot, 3) { "wrote {shot}" } else { "could not write {shot}" });
}

// Draw at the screen's own resolution: the game's surface is the screen's size, and its camera
// shows the game's W x H view at the largest whole zoom that fits, centred.  Answers the size it
// was made for, so the loop can tell when the window changed.
fn fit_display(game: game::Game) -> (integer, integer) {
  w = screen::width();
  h = screen::height();
  s = tiles::display_surface(w, h) ?? return (0, 0);
  tiles::free_surface(game.surface);
  game.surface = s;
  zoom = w / game::W;
  if h / game::H < zoom { zoom = h / game::H; }
  if zoom < 1 { zoom = 1; }
  z = zoom as float;
  tiles::camera(s, z, -((w as float) / z - (game::W as float)) / 2.0,
                -((h as float) / z - (game::H as float)) / 2.0);
  (w, h)
}

// The whole-number zoom that fits the view on a screen of `size`.
fn fit_of(size: (integer, integer)) -> float {
  zoom = size.0 / game::W;
  if size.1 / game::H < zoom { zoom = size.1 / game::H; }
  (if zoom < 1 { 1 } else { zoom }) as float
}

// Where a frame's time goes, in microseconds, reported on the console every ten seconds: the
// device has no other channel back (TANMATSU.md § Reading an app's log).
struct Timing { frames: integer, draw: integer, copy: integer, show: integer, since: integer }

fn report(t: Timing, size: (integer, integer)) {
  if t.frames == 0 || ticks() - t.since < 10000000 { return; }
  n = t.frames;
  println("@t frame {size.0}x{size.1}: draw {t.draw / n} us, copy {t.copy / n} us, show {t.show / n} us ({n} frames)");
  t.frames = 0;
  t.draw = 0;
  t.copy = 0;
  t.show = 0;
  t.since = ticks();
}

// The camera: `zoom` times the fit, easing towards `target`.  At 1 it shows the whole view; closer
// in it centres on the hero, never past the view's edge.  A conversation or a long walk will set
// the target; for now the zoom key toggles it.
struct View { zoom: float, target: float, fit: float }

const CLOSE = 2.0;
const EASE_MS = 180.0;

// Ease the zoom `ms` milliseconds on; true while it is still moving, so the frame must be drawn.
fn ease(v: View, ms: integer) -> boolean {
  d = v.target - v.zoom;
  if d < 0.001 && d > -0.001 {
    v.zoom = v.target;
    return false;
  }
  k = ((ms as float) / EASE_MS)!;
  v.zoom += d * (if k > 1.0 { 1.0 } else { k });
  true
}

// Point the surface's camera for this frame.
fn aim(game: game::Game, v: const View, size: (integer, integer)) {
  z = v.fit * v.zoom;
  vw = ((size.0 as float) / z)!;
  vh = ((size.1 as float) / z)!;
  view_w = game::W as float;
  view_h = game::H as float;
  // From the view's centre at 1 towards the hero at CLOSE.
  s = ((v.zoom - 1.0) / (CLOSE - 1.0))!;
  s = if s < 0.0 { 0.0 } else if s > 1.0 { 1.0 } else { s };
  hero = game::hero_point(game);
  cx = view_w * 0.5 + (hero.0 - view_w * 0.5) * s;
  cy = view_h * 0.5 + (hero.1 - view_h * 0.5) * s;
  // Closer in, the picture stays inside the view.
  if vw < view_w { cx = clamp_f(cx, vw * 0.5, view_w - vw * 0.5); }
  if vh < view_h { cy = clamp_f(cy, vh * 0.5, view_h - vh * 0.5); }
  tiles::camera(game.surface, z, cx - vw * 0.5, cy - vh * 0.5);
}

fn clamp_f(v: float, lo: float, hi: float) -> float {
  if v < lo { lo } else if v > hi { hi } else { v }
}

// The frame on the screen: black round the view, then shown at the screen's size.
fn present(game: game::Game, size: (integer, integer), t: Timing) {
  s = game.surface;
  far = 100000.0;
  tiles::fill(s, -far, -far, far, 2.0 * far, 0);
  tiles::fill(s, game::W as float, -far, far, 2.0 * far, 0);
  tiles::fill(s, 0.0, -far, game::W as float, far, 0);
  tiles::fill(s, 0.0, game::H as float, game::W as float, far, 0);
  t.frames += 1;
  // Drawn straight onto the display (a page's GPU), the frame is already on the screen.
  if tiles::on_display(s) { return; }
  at = ticks();
  px = tiles::pixels(s, size.0, size.1);
  copied = ticks();
  screen::show(px, size.0, size.1);
  t.copy += copied - at;
  t.show += ticks() - copied;
}

fn main() {
  g = game::new_game(".");
  if !g {
    println("the pictures in assets/sheets did not load");
    return;
  }
  game = g ?? game::new_game(".") ?? return;
  shot = env_variable("TW_SHOT") ?? "";
  if shot != "" {
    picture(game, shot);
    return;
  }
  if !screen::open(game::W, game::H, 4, "tile_world - the first climb", fill: true) {
    println("this machine has no screen loft can open (no display?)");
    return;
  }
  audio::init(44100);
  _ = audio::start();
  window_keys = screen::has_keys();
  if !window_keys { _ = input::device_open(); }
  // Kenney's pictures and sounds, credited first: until a key is pressed, or five seconds.
  println(game::CREDITS);
  size = fit_display(game);
  timing = Timing { frames: 0, draw: 0, copy: 0, show: 0, since: ticks() };
  game::draw_credits(game);
  present(game, size, timing);
  shown = ticks() / 1000;
  while screen::poll(15) && ticks() / 1000 - shown < 5000 {
    if window_keys {
      game.keys.input_tick_from_state(screen::keys(), 0.0, 0.0, 0, 0);
    } else {
      game.keys.input_tick_device();
    }
    if game::any_key(game) { break; }
  }
  game::start_level(game, 0);
  view = View { zoom: 1.0, target: 1.0, fit: fit_of(size) };
  aim(game, view, size);
  game::draw(game);
  present(game, size, timing);
  last = ticks() / 1000;
  while screen::poll(15) {
    if window_keys {
      game.keys.input_tick_from_state(screen::keys(), 0.0, 0.0, 0, 0);
    } else {
      game.keys.input_tick_device();
    }
    if game::quit(game) { break; }
    now = ticks() / 1000;
    resized = screen::width() != size.0 || screen::height() != size.1;
    if resized {
      size = fit_display(game);
      view.fit = fit_of(size);
    }
    if game::zoom_pressed(game) { view.target = if view.target > 1.0 { 1.0 } else { CLOSE }; }
    zooming = ease(view, now - last);
    if game::update(game, now - last, now) || resized || zooming {
      aim(game, view, size);
      at = ticks();
      game::draw(game);
      timing.draw += ticks() - at;
      present(game, size, timing);
      report(timing, size);
    }
    last = now;
  }
  screen::close();
  audio::stop_output();
  if !window_keys { input::device_close(); }
}
