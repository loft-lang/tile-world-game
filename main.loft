// The first climb on whatever this machine has: a desktop window (screen, X11), or a device
// display.  The keys come from the screen's window where it has them, and from the machine's
// own keyboard (input) where it does not — a question asked of the machine, not a platform
// branch.  Run: loft --lib libs main.loft
use game;
use screen;
use tiles;
use audio;
use input;
use ui;
use render3d;
use playlog;

// Moves by letter (`w` `a` `s` `d`, `p` before one to pull), as TW_MOVES lists them; `~N` lets
// N ms of the game pass (a step's glide ends, the world runs on), as a play script's `~N` does.
fn play_moves(game: game::Game, moves: text) {
  t = 0;
  for m in moves.split(' ') {
    if m.starts_with("~") {
      ms = m[1..] as integer ?? 0;
      t += ms;
      _ = game::update(game, ms, t);
      continue;
    }
    pull = m.starts_with("p");
    d = if pull { m[1..] } else { m };
    if d == "w" { game::move(game, 0, -1, pull); }
    if d == "s" { game::move(game, 0, 1, pull); }
    if d == "a" { game::move(game, -1, 0, pull); }
    if d == "d" { game::move(game, 1, 0, pull); }
  }
}

// Keys by code, a tick down and a tick up each, `+` joining keys held together — read by the
// game exactly as a keyboard's are.
fn press(game: game::Game, keys: text) {
  now = 0;
  up: vector<boolean> = [];
  for _ in 0..256 { up += [false]; }
  for chord in keys.split(' ') {
    if chord == "" { continue; }
    down = up;
    for c in chord.split('+') {
      code = c as integer ?? 0;
      if code > 0 && code < 256 { down[code] = true; }
    }
    for pressed in [true, false] {
      game.keys.input_tick_from_state(if pressed { down } else { up }, 0.0, 0.0, 0, 0);
      now += 1000;
      _ = game::update(game, 0, now);
    }
  }
}

// The play log (playlog.loft): to TW_LOG's file, and over a WebSocket to the play server that
// served the page (tools/playserver.loft) — on from the start; F9 echoes it to the console too.
const SLOW_MS = 50;
// F9: the play log echoed to the console, on and off.
const K_LOG = 143;

// The lines the game gathered since the last frame, written; then handed to the socket.
fn log_flush(lg: playlog::PlayLog, game: game::Game) {
  if lg.on || lg.console {
    for line in game.log { playlog::write(lg, line); }
  }
  game.log = [];
  playlog::send(lg);
}

// The world to start: TW_WORLD names its start place (TW_WORLD=demo, the demo village), else
// order.json's `start`.
fn start_of(game: const game::Game) -> text {
  w = env_variable("TW_WORLD") ?? "";
  if w != "" { w } else { game::start_place(game.dir) }
}

// TW_SHOT=<file.png> [TW_LEVEL=1 (one level alone; else the world)] [TW_MOVES="s d d"] [TW_EDIT="d d tab paint"]
// [TW_KEYS="101 9 32 133+122"]: play those moves, then open the editor and make those edits
// (game::edit's words), then press those keys (codes, `+` for keys held together) a tick
// each as the game would read them, and write the frame as a picture — with no screen.
// TW_CREDITS=1 writes the credits instead.
fn picture(game: game::Game, shot: text) {
  if (env_variable("TW_CREDITS") ?? "") != "" {
    game::draw_credits(game);
  } else {
    // TW_LEVEL plays one level of order.json on its own; without it the world, from its start.
    lv = env_variable("TW_LEVEL") ?? "";
    if lv != "" { game::start_level(game, lv as integer ?? 0); } else if !game::start_world(game, start_of(game)) { game::start_level(game, 0); }
    play_moves(game, env_variable("TW_MOVES") ?? "");
    edits = env_variable("TW_EDIT") ?? "";
    if edits != "" {
      game::toggle_editor(game);
      for e in edits.split(' ') { game::edit(game, e); }
    }
    press(game, env_variable("TW_KEYS") ?? "");
    game::draw(game);
  }
  println(if game::snapshot(game, shot, 3) { "wrote {shot}" } else { "could not write {shot}" });
}

// Draw at the screen's own resolution: the game's surface is the screen's size, and its camera
// shows the game's W x H view at the largest whole zoom that fits, centred.  Answers the size it
// was made for, so the loop can tell when the window changed.
fn fit_display(game: game::Game) -> (integer, integer) {
  w = screen::width();
  h = screen::height();
  s = tiles::display_surface(w, h) ?? return (0, 0);
  tiles::free_surface(game.surface);
  game.surface = s;
  zoom = w / game::W;
  if h / game::H < zoom { zoom = h / game::H; }
  if zoom < 1 { zoom = 1; }
  z = zoom as float;
  tiles::camera(s, z, -((w as float) / z - (game::W as float)) / 2.0,
                -((h as float) / z - (game::H as float)) / 2.0);
  (w, h)
}

// The whole-number zoom that fits the view on a screen of `size`.
fn fit_of(size: (integer, integer)) -> float {
  zoom = size.0 / game::W;
  if size.1 / game::H < zoom { zoom = size.1 / game::H; }
  (if zoom < 1 { 1 } else { zoom }) as float
}

// Where a frame's time goes, in microseconds, reported on the console every ten seconds: the
// device has no other channel back (TANMATSU.md § Reading an app's log).
struct Timing { frames: integer, draw: integer, copy: integer, show: integer, since: integer }

fn report(t: Timing, size: (integer, integer)) {
  if t.frames == 0 || ticks() - t.since < 10000000 { return; }
  n = t.frames;
  println("@t frame {size.0}x{size.1}: draw {t.draw / n} us, copy {t.copy / n} us, show {t.show / n} us ({n} frames)");
  t.frames = 0;
  t.draw = 0;
  t.copy = 0;
  t.show = 0;
  t.since = ticks();
}

// The camera: `zoom` times the fit, easing towards `target`.  At 1 it shows the whole view; closer
// in it centres on the hero, never past the view's edge.  A conversation or a long walk will set
// the target; for now the zoom key toggles it.
struct View { zoom: float, target: float, fit: float, cam_zoom: float = 1.0, cam_x: float = 0.0, cam_y: float = 0.0 }

const CLOSE = 2.0;
const EASE_MS = 180.0;

// Ease the zoom `ms` milliseconds on; true while it is still moving, so the frame must be drawn.
fn ease(v: View, ms: integer) -> boolean {
  d = v.target - v.zoom;
  if d < 0.001 && d > -0.001 {
    v.zoom = v.target;
    return false;
  }
  k = ((ms as float) / EASE_MS)!;
  v.zoom += d * (if k > 1.0 { 1.0 } else { k });
  true
}

// Point the surface's camera for this frame.
fn aim(game: game::Game, v: View, size: (integer, integer)) {
  z = v.fit * v.zoom;
  vw = ((size.0 as float) / z)!;
  vh = ((size.1 as float) / z)!;
  view_w = game::W as float;
  view_h = game::H as float;
  // From the view's centre at 1 towards the hero at CLOSE.
  s = ((v.zoom - 1.0) / (CLOSE - 1.0))!;
  s = if s < 0.0 { 0.0 } else if s > 1.0 { 1.0 } else { s };
  hero = game::hero_point(game);
  cx = view_w * 0.5 + (hero.0 - view_w * 0.5) * s;
  cy = view_h * 0.5 + (hero.1 - view_h * 0.5) * s;
  // Closer in, the picture stays inside the view.
  if vw < view_w { cx = clamp_f(cx, vw * 0.5, view_w - vw * 0.5); }
  if vh < view_h { cy = clamp_f(cy, vh * 0.5, view_h - vh * 0.5); }
  tiles::camera(game.surface, z, cx - vw * 0.5, cy - vh * 0.5);
  v.cam_zoom = z;
  v.cam_x = cx - vw * 0.5;
  v.cam_y = cy - vh * 0.5;
}

fn clamp_f(v: float, lo: float, hi: float) -> float {
  if v < lo { lo } else if v > hi { hi } else { v }
}

// Black round the view, under the game's camera: drawn after the game and before anything drawn
// over it (the editor's widgets, in their own units).
fn mask(game: game::Game) {
  s = game.surface;
  far = 100000.0;
  tiles::fill(s, -far, -far, far, 2.0 * far, 0);
  tiles::fill(s, game::W as float, -far, far, 2.0 * far, 0);
  tiles::fill(s, 0.0, -far, game::W as float, far, 0);
  tiles::fill(s, 0.0, game::H as float, game::W as float, far, 0);
}

// The frame on the screen, at the screen's size.
fn present(game: game::Game, size: (integer, integer), t: Timing) {
  s = game.surface;
  t.frames += 1;
  // Drawn straight onto the display (a page's GPU), the frame is already on the screen.
  if tiles::on_display(s) { return; }
  at = ticks();
  px = tiles::pixels(s, size.0, size.1);
  copied = ticks();
  screen::show(px, size.0, size.1);
  t.copy += copied - at;
  t.show += ticks() - copied;
}

fn main() {
  g = game::new_game(".");
  if !g {
    println("the pictures in assets/sheets did not load");
    return;
  }
  game = g ?? game::new_game(".") ?? return;
  shot = env_variable("TW_SHOT") ?? "";
  if shot != "" {
    picture(game, shot);
    return;
  }
  if !screen::open(game::W, game::H, 4, "tile_world - the first climb", fill: true) {
    println("this machine has no screen loft can open (no display?)");
    return;
  }
  audio::init(44100);
  _ = audio::start();
  window_keys = screen::has_keys();
  if !window_keys { _ = input::device_open(); }
  // Kenney's pictures and sounds, credited first: until a key is pressed, or five seconds.
  println(game::CREDITS);
  size = fit_display(game);
  timing = Timing { frames: 0, draw: 0, copy: 0, show: 0, since: ticks() };
  game::draw_credits(game);
  mask(game);
  present(game, size, timing);
  shown = ticks() / 1000;
  while screen::poll(15) && ticks() / 1000 - shown < 5000 {
    if window_keys {
      game.keys.input_tick_from_state(screen::keys(), 0.0, 0.0, 0, 0);
    } else {
      game.keys.input_tick_device();
    }
    if game::any_key(game) { break; }
  }
  // Which world (WORLD.md): TW_WORLD names one — in a browser LOFT_WORLD, which a page's query
  // passes on (the play server's /orbury and /demo set it); else the player chooses among
  // order.json's `worlds` — the story's, Orbury, and the demo village beside it.
  start = env_variable("TW_WORLD") ?? "";
  if start == "" { start = env_variable("LOFT_WORLD") ?? ""; }
  if start == "" {
    list = game::worlds(game.dir);
    pick = 0;
    chosen = if len(list) == 1 { 0 } else { -1 };
    if chosen < 0 {
      game::draw_worlds(game, list, pick);
      mask(game);
      present(game, size, timing);
    }
    while chosen < 0 && screen::poll(15) {
      if window_keys {
        game.keys.input_tick_from_state(screen::keys(), 0.0, 0.0, 0, 0);
      } else {
        game.keys.input_tick_device();
      }
      if game::quit(game) { return; }
      c = game::choice(game, len(list), pick);
      chosen = c.1;
      if c.0 != pick {
        pick = c.0;
        game::draw_worlds(game, list, pick);
        mask(game);
        present(game, size, timing);
      }
    }
    if chosen < 0 { return; }
    start = (list[chosen] ?? game::WorldChoice { name: "", start: game::start_place(game.dir) }).start;
  }
  if !game::start_world(game, start) { game::start_level(game, 0); }
  // The game saved at a well or fountain (C6) is where play goes on, each world's apart; TW_NEW=1
  // starts afresh.
  game.save_dir = game::save_dir_of(start);
  if (env_variable("TW_NEW") ?? "") == "" { _ = game::read_save(game, game.save_dir); }
  view = View { zoom: 1.0, target: 1.0, fit: fit_of(size) };
  plog = playlog::open(env_variable("TW_LOG") ?? "", playlog::LOG_URL);
  game.logging = plog.on;
  playlog::write(plog, "clock {game.world.now}  start: {game.place}, hero at ({game.world.hero_x},{game.world.hero_y},{game.world.hero_z})");
  // The editor's widgets, where the screen has a pointer: drawn over the frame at half the game's
  // zoom, so their 8-unit letters are as large on any screen as the game's own.
  widgets = ui::new_ui(game::ui_font(game), ui::plain_style());
  // The first-person view (render3d.loft): V in a browser page; what the GPU holds for it.
  v3 = render3d::view();
  gpu = render3d::gpu();
  pointing = screen::has_pointer();
  aim(game, view, size);
  game::draw(game);
  mask(game);
  present(game, size, timing);
  last = ticks() / 1000;
  was_at = (-1, -1);
  was_buttons = 0;
  panel_changed = false;
  while screen::poll(15) {
    at_ptr = screen::pointer();
    btn = screen::buttons();
    typed_now = screen::typed();
    if window_keys {
      raw = screen::keys();
      if playlog::keys(plog, game.world.now, raw, K_LOG) {
        plog.console = !plog.console;
        playlog::write(plog, "clock {game.world.now}  console log {if plog.console { "on" } else { "off" }}");
      }
      game.keys.input_tick_from_state(render3d::keys(v3, gpu, game, raw), at_ptr.0 as float, at_ptr.1 as float, btn, screen::wheel());
    } else {
      game.keys.input_tick_device();
    }
    if !game.typing && game::quit(game) {
      playlog::write(plog, "clock {game.world.now}  quit");
      playlog::send(plog);
      break;
    }
    now = ticks() / 1000;
    if plog.on && now - last > SLOW_MS { playlog::write(plog, "clock {game.world.now}  slow frame: {now - last} ms"); }
    resized = screen::width() != size.0 || screen::height() != size.1;
    if resized {
      size = fit_display(game);
      view.fit = fit_of(size);
    }
    if !game.typing && game::zoom_pressed(game) { view.target = if view.target > 1.0 { 1.0 } else { CLOSE }; }
    zooming = ease(view, now - last);
    // While editing, what the pointer or the keyboard does to the widgets redraws the frame.
    panel = pointing && game.editing;
    touched = panel && (at_ptr.0 != was_at.0 || at_ptr.1 != was_at.1 || btn != was_buttons || typed_now != "");
    was_at = at_ptr;
    was_buttons = btn;
    changed = game::update(game, now - last, now);
    log_flush(plog, game);
    render3d::after(v3, game);
    if v3.on && !game.editing {
      aim(game, view, size);
      render3d::draw(v3, gpu, game, changed || resized, now);
      present(game, size, timing);
    } else if changed || resized || zooming || touched || panel_changed || render3d::went_off(v3) {
      panel_changed = false;
      aim(game, view, size);
      at = ticks();
      game::draw(game);
      mask(game);
      if panel {
        scale = view.fit / 2.0;
        ui::begin(widgets, game.surface, scale, at_ptr.0, at_ptr.1, btn, typed_now);
        panel_changed = game::editor_panel(game, widgets, ((size.0 as float) / scale)!);
        // The pointer on the map, unless a widget holds the press; a drag that crosses the panel
        // still ends where it is let go.
        if widgets.pressed == "" && (!widgets.over_any || game.dragging) {
          ux = view.cam_x + ((at_ptr.0 as float) / view.cam_zoom)!;
          uy = view.cam_y + ((at_ptr.1 as float) / view.cam_zoom)!;
          if game::editor_map_pointer(game, ux, uy, widgets.down, widgets.was_down) { panel_changed = true; }
        }
      } else {
        game.typing = false;
      }
      timing.draw += ticks() - at;
      present(game, size, timing);
      report(timing, size);
    }
    last = now;
  }
  screen::close();
  audio::stop_output();
  if !window_keys { input::device_close(); }
}
