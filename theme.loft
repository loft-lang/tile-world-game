// The look of the game, as theme.json declares it: the tile sheets, the tile size, the font,
// and a sprite for every kind of terrain and thing BY NAME (the names of kinds.json).  Swapping
// tile sets is editing theme.json; nothing here names a sheet or a tile number.
//
// A sprite is written "sheet:tile" ("dungeon:48") and held as one integer, the sheet's handle
// times 4096 plus the tile, -1 for none.
use tiles;
use ui;
use rules;

struct Sheet {
  const name: text,
  handle: integer
}

struct TerrainLook {
  const id: integer,
  tile: integer,
  variants: vector<integer>,
  upper: integer,
  under: integer,
  along: integer,
  /// It stands up (a wall, a tree, a fence): drawn in depth order with the things and the
  /// figures, so it hides what is behind it; a flat kind is ground, under everything.
  upright: boolean
}

/// How a thing looks when it moves: its frames (one picture each, `FRAME_MS` apart — a flame's
/// flicker) and, for a flame in its last part, its low picture (-1 for none).
struct Frames {
  frames: vector<integer>,
  low: integer
}

/// What a thing that holds another (a socket) looks like holding `thing`: one picture for both.
struct HeldLook {
  thing: integer,
  look: Frames
}

struct ThingLook {
  const id: integer,
  tile: integer,
  look: Frames,
  holding: vector<HeldLook>,
  sound: text,
  /// A bomb's frames while it is lit (its fuse spitting sparks), SPARK_MS apart; empty for none.
  fused: vector<integer>
}

/// How long one frame of a lit fuse's sparks shows: faster than a flame's flicker.
pub const SPARK_MS = 100;

struct CarriedLook {
  const id: integer,
  tile: integer,
  look: Frames,
  /// The grip: the pixel of its picture held in the hand, about which it turns as the holder
  /// points it the way it moves (theme.json's `grip_x`, `grip_y`; the bottom middle when not
  /// given).
  grip_x: integer,
  grip_y: integer
}

/// How long one frame of a moving thing shows, in milliseconds of the level's clock.
pub const FRAME_MS = 250;

/// A track piece: the picture of a rail cell joining sides `mask` (north 1, east 2, south 4,
/// west 8).
struct TrackLook {
  const mask: integer,
  tile: integer
}

/// An enemy kind's picture.
struct EnemyLook {
  const name: text,
  tile: integer
}

struct Glyph {
  const ch: text,
  tile: integer
}

pub struct Theme {
  pub tile_size: integer,
  sheets: hash<Sheet[name]>,
  /// The sheets' handles in theme.json's order: a cell's tile number names a picture by that
  /// order (materials.loft).
  slots: vector<integer>,
  terrain: hash<TerrainLook[id]>,
  things: hash<ThingLook[id]>,
  carried: hash<CarriedLook[id]>,
  tracks: hash<TrackLook[mask]>,
  chars: hash<Glyph[ch]>,
  /// A blast's frames — the flash, the fireball, the smoke — spread over its flash.
  blast: vector<integer>,
  enemies: hash<EnemyLook[name]>,
  /// An arrow in flight (drawn pointing up), and the mark on the bow's target.
  pub arrow: integer,
  pub aim: integer,
  pub hero: integer,
  /// The sprite of one point of the hero's health, -1 for none.
  pub heart: integer,
  font: integer,
  digits: integer,
  letters: integer
}

fn num(v: const JsonValue, name: text, default: integer) -> integer {
  f = v.field(name);
  if f.kind() == "JInteger" || f.kind() == "JNumber" { (f.as_number() as integer) ?? default } else { default }
}

fn word(v: const JsonValue, name: text) -> text {
  f = v.field(name);
  if f.kind() == "JString" { f.as_text() } else { "" }
}

// The look a theme.json entry gives: a "sheet:tile" text, or an object with a "tile", or with
// "frames" (and a "low") — `tile` is the first frame when there are no frames.
fn frames_of(th: const Theme, e: const JsonValue) -> Frames {
  if e.kind() == "JString" { return Frames { frames: [sprite(th, e.as_text())], low: -1 }; }
  fs: vector<integer> = [];
  f = e.field("frames");
  for i in 0..f.len() { fs += [sprite(th, f.item(i).as_text())]; }
  if len(fs) == 0 { fs += [sprite(th, word(e, "tile"))]; }
  low = word(e, "low");
  Frames { frames: fs, low: if low == "" { -1 } else { sprite(th, low) } }
}

// The picture of a look at the level's clock `now`, its low one when it burns low.
fn pick(f: const Frames, now: integer, low: boolean) -> integer {
  if low && f.low >= 0 { return f.low; }
  n = len(f.frames);
  if n == 0 { return -1; }
  f.frames[(now / FRAME_MS) % n ?? 0] ?? -1
}

// "sheet:tile" as a sprite, -1 when the sheet is unknown or the text is not one.
fn sprite(th: const Theme, s: text) -> integer {
  parts = s.split(':');
  if len(parts) != 2 { return -1; }
  sh = th.sheets[parts[0]];
  if !sh { return -1; }
  t = parts[1] as integer ?? -1;
  if t < 0 { return -1; }
  sh.handle * 4096 + t
}

/// The theme theme.json declares (`raw`), its sheets read from paths relative to `dir`, its
/// kind names resolved through `k`.  Null when it does not parse or a sheet does not load.
pub fn load(raw: text, dir: text, k: const rules::Kinds) -> Theme? {
  v = json_parse(raw);
  if v.kind() != "JObject" { return null; }
  ts = num(v, "tile_size", 16);
  th = Theme {
    tile_size: ts, sheets: [], slots: [], terrain: [], things: [], carried: [], tracks: [], chars: [], blast: [], enemies: [],
    hero: -1, heart: -1, font: 0, digits: 0, letters: 0
  };
  sheets = v.field("sheets");
  for name in sheets.keys() {
    h = tiles::sheet_from_png("{dir}/{sheets.field(name).as_text()}", ts, ts);
    if !h { return null; }
    th.sheets += [Sheet { name: name, handle: h }];
    th.slots += [h];
  }
  th.hero = sprite(th, word(v, "hero"));
  th.arrow = sprite(th, word(v, "arrow"));
  th.aim = sprite(th, word(v, "aim"));
  en = v.field("enemies");
  for name in en.keys() { th.enemies += [EnemyLook { name: name, tile: sprite(th, en.field(name).as_text()) }]; }
  bl = v.field("blast");
  for i in 0..bl.len() { th.blast += [sprite(th, bl.item(i).as_text())]; }
  th.heart = sprite(th, word(v, "heart"));
  f = v.field("font");
  fs = th.sheets[word(f, "sheet")];
  th.font = if fs { fs.handle } else { 0 };
  th.digits = num(f, "digits", -1);
  th.letters = num(f, "letters", -1);
  cs = f.field("chars");
  for c in cs.keys() {
    th.chars += [Glyph { ch: c, tile: (cs.field(c).as_number() as integer) ?? -1 }];
  }
  t = v.field("terrain");
  for name in t.keys() {
    e = t.field(name);
    vs: vector<integer> = [];
    vars = e.field("variants");
    for i in 0..vars.len() { vs += [sprite(th, vars.item(i).as_text())]; }
    under = word(e, "under");
    th.terrain += [TerrainLook {
      id: rules::terrain_id(k, name), tile: sprite(th, word(e, "tile")), variants: vs,
      upper: sprite(th, word(e, "upper")),
      under: if under == "" { 0 } else { rules::terrain_id(k, under) },
      along: sprite(th, word(e, "along")),
      upright: e.field("upright").as_bool() ?? false
    }];
  }
  things = v.field("things");
  for name in things.keys() {
    e = things.field(name);
    tile = if e.kind() == "JString" { sprite(th, e.as_text()) } else { sprite(th, word(e, "tile")) };
    sound = if e.kind() == "JString" { "" } else { word(e, "sound") };
    held: vector<HeldLook> = [];
    hs = e.field("holding");
    for held_name in hs.keys() {
      held += [HeldLook { thing: rules::thing_id(k, held_name), look: frames_of(th, hs.field(held_name)) }];
    }
    fused: vector<integer> = [];
    fu = e.field("fused");
    for i in 0..fu.len() { fused += [sprite(th, fu.item(i).as_text())]; }
    th.things += [ThingLook { id: rules::thing_id(k, name), tile: tile, look: frames_of(th, e),
                              holding: held, sound: sound, fused: fused }];
  }
  tr = v.field("tracks");
  for sides in tr.keys() {
    m = 0;
    for c in sides {
      if c == 'n' { m += 1; } else if c == 'e' { m += 2; } else if c == 's' { m += 4; } else if c == 'w' { m += 8; }
    }
    th.tracks += [TrackLook { mask: m, tile: sprite(th, tr.field(sides).as_text()) }];
  }
  carried = v.field("carried");
  for name in carried.keys() {
    e = carried.field(name);
    th.carried += [CarriedLook {
      id: rules::thing_id(k, name), tile: sprite(th, word(e, "tile")), look: frames_of(th, e),
      grip_x: num(e, "grip_x", ts / 2 - 1), grip_y: num(e, "grip_y", ts - 3)
    }];
  }
  th
}

/// Draw sprite `s` on `surface` at (px, py), at a shade; nothing for -1.
pub fn put(surface: integer, s: integer, px: integer, py: integer, shade: integer) {
  if s < 0 { return; }
  tiles::draw(surface, s / 4096 ?? 0, s % 4096 ?? 0, px, py, false, false, false, shade);
}

/// The sprite a cell's tile number names (materials.loft: 1 + slot * 256 + tile), -1 for 0 or a
/// slot theme.json does not have.
pub fn tile_sprite(th: const Theme, n: integer) -> integer {
  if n <= 0 { return -1; }
  slot = (n - 1) / 256 ?? 0;
  if slot >= len(th.slots) { return -1; }
  (th.slots[slot] ?? 0) * 4096 + ((n - 1) % 256 ?? 0)
}

/// The sprite of terrain kind `kind` at cell (x, y): its tile, or one of its variants chosen by
/// the cell's position so a room is not one stamp; `upper` asks for its look from above.
pub fn terrain_sprite(th: const Theme, kind: integer, x: integer, y: integer, upper: boolean) -> integer {
  look = th.terrain[kind];
  if !look { return -1; }
  if upper && look.upper >= 0 { return look.upper; }
  h = (x * 7 + y * 13) % 11 ?? 0;
  if h < len(look.variants) { return look.variants[h] ?? look.tile; }
  look.tile
}

/// What terrain kind `kind` is drawn over (a rail over the floor), 0 for nothing.
pub fn upright(th: const Theme, kind: integer) -> boolean {
  look = th.terrain[kind];
  if !look { return false; }
  look.upright
}

pub fn under(th: const Theme, kind: integer) -> integer {
  look = th.terrain[kind];
  if !look { return 0; }
  look.under
}

/// The sprite of a line terrain (a rail) running across, or along when it does not.
pub fn line_sprite(th: const Theme, kind: integer, across: boolean) -> integer {
  look = th.terrain[kind];
  if !look { return -1; }
  if across || look.along < 0 { look.tile } else { look.along }
}

/// The picture of a rail cell joining sides `mask` (rules::joins): its piece, or — an end, a
/// junction, a lone cell, which have none yet — the straight along its north-south joins, else the
/// east-west one; -1 when the theme has no tracks.
pub fn track_sprite(th: const Theme, mask: integer) -> integer {
  t = th.tracks[mask];
  if t { return t.tile; }
  ns = th.tracks[5];
  ew = th.tracks[10];
  if (mask & 5) != 0 {
    if ns { return ns.tile; }
  }
  if ew { return ew.tile; }
  -1
}

/// Does terrain kind `kind` draw as a line (it has an `along` sprite)?
pub fn is_line(th: const Theme, kind: integer) -> boolean {
  look = th.terrain[kind];
  if !look { return false; }
  look.along >= 0
}

/// The sprite of thing `thing`, -1 when the theme has none.
pub fn thing_sprite(th: const Theme, thing: integer) -> integer {
  look = th.things[thing];
  if !look { return -1; }
  look.tile
}

/// The picture of thing `thing` at the level's clock `now` (its frame), its low one when it
/// burns `low`; -1 when the theme has none.
pub fn thing_sprite_at(th: const Theme, thing: integer, now: integer, low: boolean) -> integer {
  look = th.things[thing];
  if !look { return -1; }
  pick(look.look, now, low)
}

/// The picture of a lit bomb (`thing`) at `now`: its sparks' frame; -1 when the theme has none.
pub fn fused_sprite(th: const Theme, thing: integer, now: integer) -> integer {
  look = th.things[thing];
  if !look || len(look.fused) == 0 { return -1; }
  look.fused[(now / SPARK_MS) % len(look.fused) ?? 0] ?? -1
}

/// The picture of an enemy of `kind`, -1 when the theme has none.
pub fn enemy_sprite(th: const Theme, kind: text) -> integer {
  look = th.enemies[kind];
  if !look { return -1; }
  look.tile
}

/// A blast's picture `elapsed` ms into its flash of `length` ms; -1 after it, or with none.
pub fn blast_sprite(th: const Theme, elapsed: integer, length: integer) -> integer {
  n = len(th.blast);
  if n == 0 || elapsed < 0 || elapsed >= length { return -1; }
  th.blast[elapsed * n / length ?? 0] ?? -1
}

/// The one picture of thing `holder` holding thing `held` (a socket with a torch in it) at
/// `now`, its low one when what it holds burns `low`; -1 when the theme draws them apart.
pub fn holding_sprite(th: const Theme, holder: integer, held: integer, now: integer, low: boolean) -> integer {
  look = th.things[holder];
  if !look || held == 0 { return -1; }
  for h in look.holding {
    if h.thing == held { return pick(h.look, now, low); }
  }
  -1
}

/// The sound event moving thing `thing` makes, "" when the theme names none.
pub fn thing_sound(th: const Theme, thing: integer) -> text {
  look = th.things[thing];
  if !look { return ""; }
  look.sound
}

/// Draw sprite `s` turned `degrees` clockwise about its pixel `pivot`, its top-left at (px, py).
pub fn put_turned(surface: integer, s: integer, px: integer, py: integer, degrees: integer,
                  pivot: (integer, integer), shade: integer) {
  if s < 0 { return; }
  tiles::draw_turned(surface, s / 4096 ?? 0, s % 4096 ?? 0, px, py, degrees, pivot, false, false, false, shade);
}

/// Draw sprite `s` as ground at (px, py): its corners (top-left, top-right, bottom-left,
/// bottom-right) lifted `lift` pixels and darkened `dark` sixteenths of a shade (tiles 0.4.0).
pub fn put_ground(surface: integer, s: integer, px: integer, py: integer, lift: (integer, integer, integer, integer),
                  dark: (integer, integer, integer, integer)) {
  if s < 0 { return; }
  tiles::draw_ground(surface, s / 4096 ?? 0, s % 4096 ?? 0, px, py, lift, dark);
}

/// Draw `thing` held at the hand (hand_x, hand_y): its grip there, pointing `angle` degrees
/// clockwise from up — the way its holder moves — pushed `reach` pixels the way it points (to
/// the nearest of the four ways).  A flame shows its frame at `now`, and its low picture when
/// `low`.  Nothing for a thing the theme does not carry.
pub fn put_held(surface: integer, th: const Theme, thing: integer, hand_x: integer, hand_y: integer,
                angle: integer, reach: integer, shade: integer, now: integer, low: boolean) {
  look = th.carried[thing];
  if !look { return; }
  quarter = (((angle % 360) + 360 + 45) % 360) / 90;
  ox = if quarter == 1 { reach } else if quarter == 3 { -reach } else { 0 };
  oy = if quarter == 0 { -reach } else if quarter == 2 { reach } else { 0 };
  put_turned(surface, pick(look.look, now, low), hand_x + ox - look.grip_x, hand_y + oy - look.grip_y, angle,
             (look.grip_x, look.grip_y), shade);
}

/// Draw sprite `s` with its top-left at (x, y) and turned `degrees` clockwise about its point
/// `pivot` (in its own pixels; (8.5, 15.5) is the middle of a 16 px tile's bottom row): `put_turned`
/// in fractions, for a figure that glides, hops and rocks smoothly at a display's resolution.
pub fn put_fine(surface: integer, s: integer, x: float, y: float, degrees: float, pivot: (float, float),
                shade: integer) {
  if s < 0 { return; }
  tiles::sprite(surface, s / 4096 ?? 0, s % 4096 ?? 0, x, y, degrees, pivot.0, pivot.1, shade: shade);
}

/// Draw sprite `s` scaled by `scale`, centred on (cx, cy); nothing for -1.
pub fn put_scaled(surface: integer, th: const Theme, s: integer, cx: float, cy: float, scale: float, shade: integer) {
  if s < 0 { return; }
  half = (th.tile_size as float) * scale / 2.0;
  tiles::sprite(surface, s / 4096 ?? 0, s % 4096 ?? 0, cx - half, cy - half, scale_x: scale, scale_y: scale, shade: shade);
}

/// `put_held` in fractions: the thing at the hand (hand_x, hand_y), turned `angle` and pushed
/// `reach` the way it points.
pub fn put_held_fine(surface: integer, th: const Theme, thing: integer, hand_x: float, hand_y: float,
                     angle: float, reach: float, shade: integer, now: integer, low: boolean) {
  look = th.carried[thing];
  if !look { return; }
  quarter = ((((round(angle) as integer) % 360) + 360 + 45) % 360) / 90;
  ox = if quarter == 1 { reach } else if quarter == 3 { -reach } else { 0.0 };
  oy = if quarter == 0 { -reach } else if quarter == 2 { reach } else { 0.0 };
  gx = look.grip_x as float;
  gy = look.grip_y as float;
  put_fine(surface, pick(look.look, now, low), hand_x + ox - gx, hand_y + oy - gy, angle,
           (gx + 0.5, gy + 0.5), shade);
}

/// The theme's font for the widgets: its digits and letters, and the characters it names.
pub fn ui_font(th: const Theme) -> ui::Font {
  glyphs: vector<integer> = [];
  for n in 0..128 {
    t = -1;
    if n >= 48 && n <= 57 && th.digits >= 0 { t = th.digits + n - 48; }
    else if n >= 65 && n <= 90 && th.letters >= 0 { t = th.letters + n - 65; }
    else if n > 32 && n != 92 && n != 34 {
      c = th.chars["{n as character}"];
      if c { t = c.tile; }
    }
    glyphs += [t];
  }
  ui::Font { sheet: th.font, size: th.tile_size, glyphs: glyphs }
}

/// Write `s` in the theme's font at half its size, its top-left at (x, y): half a tile a
/// character, in shade `shade`; a character the font lacks leaves a space.
pub fn write_small(surface: integer, th: const Theme, s: text, x: float, y: float, shade: integer) {
  cx = x;
  step = (th.tile_size as float) / 2.0;
  for c in s {
    n = c as integer;
    t = -1;
    if n >= 48 && n <= 57 && th.digits >= 0 { t = th.digits + n - 48; }
    else if n >= 65 && n <= 90 && th.letters >= 0 { t = th.letters + n - 65; }
    else if n >= 97 && n <= 122 && th.letters >= 0 { t = th.letters + n - 97; }
    else {
      g = th.chars["{c}"];
      if g { t = g.tile; }
    }
    if t >= 0 { tiles::sprite(surface, th.font, t, cx, y, scale_x: 0.5, scale_y: 0.5, shade: shade); }
    cx += step;
  }
}

/// Write `s` in the theme's font at (x, y), one tile a character; a character the font lacks
/// leaves a space.
pub fn write(surface: integer, th: const Theme, s: text, x: integer, y: integer) {
  cx = x;
  for c in s {
    n = c as integer;
    t = -1;
    if n >= 48 && n <= 57 && th.digits >= 0 { t = th.digits + n - 48; }
    else if n >= 65 && n <= 90 && th.letters >= 0 { t = th.letters + n - 65; }
    else if n >= 97 && n <= 122 && th.letters >= 0 { t = th.letters + n - 97; }
    else {
      g = th.chars["{c}"];
      if g { t = g.tile; }
    }
    if t >= 0 { tiles::draw(surface, th.font, t, cx, y); }
    cx += th.tile_size;
  }
}
