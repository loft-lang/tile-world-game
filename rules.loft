// The rules of the game: what the hero and the things on the board do.  The world itself —
// layers, terrain, stacks, paths, sight and light — is the tile_world library's; the KINDS are
// data (kinds.json), and every rule here reads a kind's properties, never its name:
//
//   terrain: walk (can be stood on), opaque (stops sight and light), rail (carts run on it),
//            mount (a mountable thing can be fixed to it: a wall), height (the steps it stands
//            itself: a fence is climbed like a one-step stack), blocks_things (nothing is pushed
//            or pulled onto it, so a train stops at it), opens_to (walking into it turns it
//            into that kind: a door opens), stairs (1 or -1: walking onto it takes the hero to
//            the same cell a layer up or down), chopped_to (walking into it holding a thing
//            that chops turns it into that kind: a tree or a fence, felled to floor — after
//            `hits` such blows, 1 when not given; each blow leaves a `drops` thing beside it,
//            when there is room: a tree, a stick), saves
//            (walking into it saves the whole situation: a well — DESIGN.md's clear-area
//            condition joins it with the enemies, until then the area is always clear).
//   edges:   walk (crossed freely), opaque, climb (the hero climbs over it, nothing else
//            crosses: a fence between two cells).
//   things:  height (steps it adds to its stack), stand (the hero can stand on it), surface
//            (a lifting thing can rest on it), move ("none", "push", "push_pull"), rails (moves
//            only along rail terrain), train (a line of them moves as one), lift (pulled up or
//            down onto a surface), walk_on ("boost" or "take": walked over rather than into),
//            mount (can be fixed to mount terrain), light (gives light, carried or set down),
//            chops (held, it fells what can be chopped: an axe), opens_to (walking into it
//            turns it into that thing and scores its `points`: a chest opens), switches_to (a lever:
//            walked into, it sets the junctions beside it the other way and becomes that thing,
//            its handle over), tells ("chests":
//            walking into it says how many things are still to open: a signpost), rest (a light
//            item falling onto it comes to rest on top: a chest, a table, a stone — big things;
//            the hero takes it standing there, and a stone pushed along carries it), holds (a
//            mountable thing hangs in it: a wall socket — mounting needs one), dips (walking into
//            it turns what the hero holds into that thing's `dipped_to`: a tar barrel, a stick
//            into a torch), lit_to (lit from a flame it becomes that: a torch), flame (it burns:
//            it lights what has a `lit_to`, and after `burn_ms` of the level's clock it becomes
//            its `burns_to`, wherever it is — held, on the floor or in a socket; over that time
//            its light fades by `fade` shades, the warning that it burns down, and flickers: one
//            shade dimmer now and then, a step of `flicker_ms` in `flicker_odds`).
//
// A train runs along its TRACK: a rail cell joins the rail cells beside it, and a cart leaves a
// cell only through a side it joins (see Tracks); past a track's end, with free floor after it,
// the front cart becomes its `derails_to` (a derailed cart: fixed, stood on).
//
// The hero holds at most one item, and while it holds one it pushes, pulls and lifts nothing.
//
// Height counts in steps — a cell's rise and the things stacked on it — and a layer is
// `layer_height` steps, so the floor of the layer above stands `layer_height` high.  The hero
// steps up at most 1 and down any amount short of a full layer.  So one step below a layer's
// height — a chair on a table, a slope's top — climbs onto the floor of the layer above beside
// it, unless a ceiling is over the hero (the layer above set over its own cell); and walking
// into the void steps down onto what stands below.  A drop of a full layer or more is a FALL:
// it costs `fall_damage[n - 1]` of the hero's `health` for n layers fallen (the last entry for
// deeper falls), and a hero with no health left moves no more.  Walking into a thing pushes
// it one cell when it can go there, and climbs onto it when it cannot and can be stood on.  A
// train is pushed up to `push_strength` long and pulled up to `pull_strength`; a walk_on
// "boost" thing adds `boost` to both for `boost_ms` of the level's clock.
use tile_world;

/// Void: a cell nobody set.
pub const VOID = 0;

struct TerrainProps {
  const id: integer,
  name: text,
  walk: boolean,
  opaque: boolean,
  rail: boolean,
  mount: boolean,
  height: integer,
  blocks_things: boolean,
  opens_to: text,
  stairs: integer,
  chopped_to: text,
  hits: integer,
  drops: text,
  saves: boolean,
  /// Water: a bomb rolling into it goes off there, and its blast douses flames.
  water: boolean,
  /// Rough: a climbing enemy (a spider) goes over it.
  rough: boolean,
  glyph: text
}

/// An enemy kind (kinds.json `enemies`): its health, what a bite costs the hero, how often it
/// steps wandering and chasing or fleeing, how often it bites, how far it sees, how far from its
/// nest it roams, how often it heals a point there.
struct EnemyProps {
  const name: text,
  hp: integer,
  bite: integer,
  move_ms: integer,
  chase_ms: integer,
  bite_ms: integer,
  sight: integer,
  roam: integer,
  heal_ms: integer,
  /// It flies over water (a bat); it climbs rough walls (a spider); it keeps out of the light
  /// (a rat); it drifts towards it (a bat); it is a guard: it stands, blocks, steps aside.
  flies: boolean,
  climbs: boolean,
  shuns_light: boolean,
  likes_light: boolean,
  guard: boolean,
  /// How far it sees a hero standing in the dark (a cyclops: 2); at `sight` only a lit one.  The
  /// same as `sight` for an enemy that sees as well in the dark.
  dark_sight: integer,
  /// It searches (a cyclops): having seen the hero it goes to where it last saw it, a blast it
  /// hears draws it to the place instead of scaring it, and seeing the hero it calls the others of
  /// its kind within `calls` cells there.  Brave: hurt, it fights on (and heals at its nest once
  /// nothing is left to search).
  searches: boolean,
  calls: integer,
  brave: boolean,
  /// What one holds unless its level says otherwise (a thing's name, "" for nothing), and how many
  /// bombs one holding bombs carries.  Pulls: holding no weapon (nothing, or bombs, beside the
  /// hero) it grabs the hero and pulls it towards its nest instead of striking (a cyclops).
  holds: text,
  bombs: integer,
  pulls: boolean,
  /// It shoots arrows (a hunter), every bite_ms: at the hero it sees in line, else at another
  /// enemy it sees, which it hunts.
  shoots: boolean,
  /// It talks (a villager): walked into, it is spoken to, not struck (talk.loft).
  talks: boolean = false
}

struct EdgeProps {
  const id: integer,
  name: text,
  walk: boolean,
  opaque: boolean,
  climb: boolean,
  glyph: text
}

struct ThingProps {
  const id: integer,
  name: text,
  height: integer,
  stand: boolean,
  surface: boolean,
  move: text,
  rails: boolean,
  train: boolean,
  lift: boolean,
  walk_on: text,
  mount: boolean,
  light: boolean,
  chops: boolean,
  /// A weapon: the hero swings it (`swing`).
  swings: boolean,
  opens_to: text,
  points: integer,
  tells: text,
  rest: boolean,
  holds: boolean,
  dips: boolean,
  dipped_to: text,
  lit_to: text,
  flame: boolean,
  burns_to: text,
  derails_to: text,
  switches_to: text,
  /// A bomb: it rolls (downhill by itself), goes off on impact, and in a blast's reach.
  bomb: boolean,
  /// It breaks in a blast's reach (a chair).
  fragile: boolean,
  /// A flame a blast in water puts out becomes this.
  doused_to: text,
  /// A derailed cart a blast beside it pushes onto a rail becomes this (a cart again).
  rerails_to: text,
  /// What a blow with it costs an enemy (a weapon); 0: a blow with it costs 1, as with bare hands.
  damage: integer,
  /// What a blow with it costs an enemy that flies (a torch against bats); 0: its `damage`.
  flier_damage: integer = 0,
  /// How long the hero takes to ready it again after a blow (an axe, heavy); 0: the rules' blow_ms.
  recover_ms: integer = 0,
  /// It shoots arrows (a bow).
  shoots: boolean,
  /// What a potion gives walked over: `heal` health up to the start's, `spirit` temporary health.
  heals: integer,
  /// The money opening it gives (a chest).
  money: integer,
  glyph: text
}

/// The game's kinds, as kinds.json declares them, and the numbers its rules use.
pub struct Kinds {
  terrain: hash<TerrainProps[id]>,
  things: hash<ThingProps[id]>,
  edges: hash<EdgeProps[id]>,
  enemies: hash<EnemyProps[name]>,
  pub push_strength: integer,
  pub pull_strength: integer,
  pub boost: integer,
  pub boost_ms: integer,
  pub layer_height: integer,
  /// The hero's health at the start, and what a fall of 1, 2, 3, ... layers costs.
  pub health: integer,
  pub fall_damage: vector<integer>,
  /// How long a flame burns, in the level's clock, and the last part of it it burns low.
  pub burn_ms: integer,
  pub low_ms: integer,
  /// How many shades a flame's light fades over its burn_ms: it reaches that many cells less far
  /// at the end.
  pub fade: integer,
  /// A flame's light flickers: every `flicker_ms` it may be one shade dimmer, one step in
  /// `flicker_odds` (0: never).
  pub flicker_ms: integer,
  pub flicker_odds: integer,
  /// A rolling train moves a cell every roll_ms / speed; its speed is 1 .. max_speed, and on the
  /// flat it loses one every `coast` cells.
  pub roll_ms: integer,
  pub max_speed: integer,
  pub coast: integer,
  /// Bombs: a rolling bomb slows one every `bomb_coast` cells on the flat; a blast reaches
  /// `blast_radius` cells; a bomb a blast sets off goes off `ripple_ms` later; a throw starts it
  /// at `throw_speed`.
  pub bomb_coast: integer,
  pub blast_radius: integer,
  pub ripple_ms: integer,
  pub throw_speed: integer,
  /// A bomb that falls this many layers or more goes off where it lands, fused or not.
  pub bomb_fall: integer,
  /// A blast lights its surroundings for this long, fading.
  pub flash_ms: integer,
  /// An ordinary enemy within hear_blast cells of a blast flees it for scare_ms; a well saves only
  /// with no enemy within clear_area cells in sight of the hero.
  pub hear_blast: integer,
  pub scare_ms: integer,
  pub clear_area: integer,
  /// A searching enemy (a cyclops) searches a place this long after it last saw the hero there, or
  /// heard a blast there.
  pub search_ms: integer,
  /// Presses away from a cyclops that holds the hero to break free.
  pub struggle_presses: integer,
  /// A blow of the hero's takes this long to recover from (owner): presses within it are ignored,
  /// but the last one is remembered and struck at its end, unless another action comes first.
  pub blow_ms: integer,
  /// How far an arrow flies, in cells, and how long it takes over one.
  pub arrow_range: integer,
  pub arrow_ms: integer
}

fn num(v: const JsonValue, name: text, default: integer) -> integer {
  f = v.field(name);
  if f.kind() == "JInteger" || f.kind() == "JNumber" { (f.as_number() as integer) ?? default } else { default }
}

fn flag(v: const JsonValue, name: text) -> boolean {
  v.field(name).as_bool() ?? false
}

fn word(v: const JsonValue, name: text, default: text) -> text {
  f = v.field(name);
  if f.kind() == "JString" { f.as_text() } else { default }
}

/// The kinds a JSON text declares (kinds.json's shape); null when it does not parse.
pub fn kinds_from_json(raw: text) -> Kinds? {
  v = json_parse(raw);
  if v.kind() != "JObject" { return null; }
  r = v.field("rules");
  k = Kinds {
    terrain: [], things: [], edges: [], enemies: [],
    push_strength: num(r, "push_strength", 3),
    pull_strength: num(r, "pull_strength", 2),
    boost: num(r, "boost", 2),
    boost_ms: num(r, "boost_ms", 60000),
    layer_height: num(r, "layer_height", 4),
    health: num(r, "health", 6),
    fall_damage: [],
    burn_ms: num(r, "burn_ms", 600000),
    low_ms: num(r, "low_ms", 60000),
    fade: num(r, "fade", 4),
    flicker_ms: num(r, "flicker_ms", 500),
    flicker_odds: num(r, "flicker_odds", 4),
    roll_ms: num(r, "roll_ms", 600),
    max_speed: num(r, "max_speed", 4),
    coast: num(r, "coast", 2),
    bomb_coast: num(r, "bomb_coast", 4),
    blast_radius: num(r, "blast_radius", 3),
    ripple_ms: num(r, "ripple_ms", 150),
    throw_speed: num(r, "throw_speed", 4),
    bomb_fall: num(r, "bomb_fall", 2),
    flash_ms: num(r, "flash_ms", 300),
    hear_blast: num(r, "hear_blast", 8),
    scare_ms: num(r, "scare_ms", 5000),
    clear_area: num(r, "clear_area", 10),
    search_ms: num(r, "search_ms", 6000),
    struggle_presses: num(r, "struggle_presses", 3),
    blow_ms: num(r, "blow_ms", 400),
    arrow_range: num(r, "arrow_range", 8),
    arrow_ms: num(r, "arrow_ms", 30)
  };
  fd = r.field("fall_damage");
  for i in 0..fd.len() { k.fall_damage += [(fd.item(i).as_number() as integer) ?? 0]; }
  t = v.field("terrain");
  for name in t.keys() {
    e = t.field(name);
    k.terrain += [TerrainProps {
      id: num(e, "id", 0), name: name, walk: flag(e, "walk"), opaque: flag(e, "opaque"),
      rail: flag(e, "rail"), mount: flag(e, "mount"), height: num(e, "height", 0),
      blocks_things: flag(e, "blocks_things"), opens_to: word(e, "opens_to", ""),
      stairs: num(e, "stairs", 0), chopped_to: word(e, "chopped_to", ""),
      hits: num(e, "hits", 1), drops: word(e, "drops", ""),
      saves: flag(e, "saves"), water: flag(e, "water"), rough: flag(e, "rough"), glyph: word(e, "glyph", "?")
    }];
  }
  ed = v.field("edges");
  for name in ed.keys() {
    e = ed.field(name);
    k.edges += [EdgeProps {
      id: num(e, "id", 0), name: name, walk: flag(e, "walk"), opaque: flag(e, "opaque"),
      climb: flag(e, "climb"), glyph: word(e, "glyph", "|")
    }];
  }
  en = v.field("enemies");
  for name in en.keys() {
    e = en.field(name);
    sight = num(e, "sight", 5);
    k.enemies += [EnemyProps {
      name: name, hp: num(e, "hp", 3), bite: num(e, "bite", 1), move_ms: num(e, "move_ms", 600),
      chase_ms: num(e, "chase_ms", 350), bite_ms: num(e, "bite_ms", 900), sight: sight,
      roam: num(e, "roam", 3), heal_ms: num(e, "heal_ms", 4000), flies: flag(e, "flies"),
      climbs: flag(e, "climbs"), shuns_light: flag(e, "shuns_light"), likes_light: flag(e, "likes_light"),
      guard: flag(e, "guard"), dark_sight: num(e, "dark_sight", sight), searches: flag(e, "searches"),
      calls: num(e, "calls", 0), brave: flag(e, "brave"), holds: word(e, "holds", ""),
      bombs: num(e, "bombs", 3), pulls: flag(e, "pulls"), shoots: flag(e, "shoots"), talks: flag(e, "talks")
    }];
  }
  th = v.field("things");
  for name in th.keys() {
    e = th.field(name);
    k.things += [ThingProps {
      id: num(e, "id", 0), name: name, height: num(e, "height", 1), stand: flag(e, "stand"),
      surface: flag(e, "surface"), move: word(e, "move", "none"), rails: flag(e, "rails"),
      train: flag(e, "train"), lift: flag(e, "lift"), walk_on: word(e, "walk_on", ""),
      mount: flag(e, "mount"), light: flag(e, "light"), chops: flag(e, "chops"),
      swings: flag(e, "swings"), opens_to: word(e, "opens_to", ""), points: num(e, "points", 0), tells: word(e, "tells", ""),
      rest: flag(e, "rest"), holds: flag(e, "holds"), dips: flag(e, "dips"), dipped_to: word(e, "dipped_to", ""),
      lit_to: word(e, "lit_to", ""), flame: flag(e, "flame"), burns_to: word(e, "burns_to", ""),
      derails_to: word(e, "derails_to", ""), switches_to: word(e, "switches_to", ""),
      bomb: flag(e, "bomb"), fragile: flag(e, "fragile"), doused_to: word(e, "doused_to", ""),
      rerails_to: word(e, "rerails_to", ""), damage: num(e, "damage", 0), flier_damage: num(e, "flier_damage", 0),
      recover_ms: num(e, "recover_ms", 0), shoots: flag(e, "shoots"),
      heals: num(e, "heals", 0), money: num(e, "money", 0),
      glyph: word(e, "glyph", "?")
    }];
  }
  k
}

/// The kinds in kinds.json — beside the program, or one directory up (where tests run).
pub fn kinds() -> Kinds {
  for path in ["kinds.json", "../kinds.json"] {
    raw = file(path).content() ?? "";
    if raw != "" {
      k = kinds_from_json(raw);
      if k { return k ?? Kinds { terrain: [], things: [], edges: [], enemies: [], push_strength: 3, pull_strength: 2,
                                 boost: 2, boost_ms: 60000, layer_height: 4, health: 6, fall_damage: [],
                                 burn_ms: 600000, low_ms: 60000, fade: 4, flicker_ms: 500,
                                 flicker_odds: 4, roll_ms: 600, max_speed: 4, coast: 2, bomb_coast: 4,
                                 blast_radius: 3, ripple_ms: 150, throw_speed: 4, bomb_fall: 2, flash_ms: 300,
                                 hear_blast: 8, scare_ms: 5000, clear_area: 10, search_ms: 6000, struggle_presses: 3, blow_ms: 400, arrow_range: 8, arrow_ms: 30 }; }
    }
  }
  Kinds { terrain: [], things: [], edges: [], enemies: [], push_strength: 3, pull_strength: 2, boost: 2, boost_ms: 60000,
          layer_height: 4, health: 6, fall_damage: [], burn_ms: 600000, low_ms: 60000, fade: 4,
          flicker_ms: 500, flicker_odds: 4, roll_ms: 600, max_speed: 4, coast: 2, bomb_coast: 4,
          blast_radius: 3, ripple_ms: 150, throw_speed: 4, bomb_fall: 2, flash_ms: 300, hear_blast: 8,
          scare_ms: 5000, clear_area: 10, search_ms: 6000, struggle_presses: 3, blow_ms: 400, arrow_range: 8, arrow_ms: 30 }
}

/// A terrain kind's number by its name in kinds.json; 0 (void) for a name it does not declare.
pub fn terrain_id(k: const Kinds, name: text) -> integer {
  for t in k.terrain {
    if t.name == name { return t.id; }
  }
  0
}

/// A thing's number by its name in kinds.json; 0 for a name it does not declare.
pub fn thing_id(k: const Kinds, name: text) -> integer {
  for t in k.things {
    if t.name == name { return t.id; }
  }
  0
}

/// An edge kind's number by its name in kinds.json; 0 for a name it does not declare.
pub fn edge_id(k: const Kinds, name: text) -> integer {
  for e in k.edges {
    if e.name == name { return e.id; }
  }
  0
}

/// An edge kind's name, "" for 0 or an undeclared number.
pub fn edge_name(k: const Kinds, kind: integer) -> text {
  p = k.edges[kind];
  if !p { return ""; }
  p.name
}

/// A thing's name, "" for 0 or an undeclared number.
pub fn thing_name(k: const Kinds, thing: integer) -> text {
  p = k.things[thing];
  if !p { return ""; }
  p.name
}

/// The terrain kinds kinds.json declares, by number, lowest first.
pub fn terrain_ids(k: const Kinds) -> vector<integer> {
  out: vector<integer> = [];
  for t in k.terrain {
    at = 0;
    while at < len(out) && (out[at] ?? 0) < t.id { at += 1; }
    out.insert(at, t.id);
  }
  out
}

/// The things kinds.json declares, by number, lowest first.
pub fn thing_ids(k: const Kinds) -> vector<integer> {
  out: vector<integer> = [];
  for t in k.things {
    at = 0;
    while at < len(out) && (out[at] ?? 0) < t.id { at += 1; }
    out.insert(at, t.id);
  }
  out
}

/// A terrain kind's glyph (its character in a level file), "" for void or an undeclared number.
pub fn terrain_glyph(k: const Kinds, kind: integer) -> text {
  p = k.terrain[kind];
  if !p { return ""; }
  p.glyph
}

/// A terrain kind's name, "" for void or an undeclared number.
pub fn terrain_name(k: const Kinds, kind: integer) -> text {
  p = k.terrain[kind];
  if !p { return ""; }
  p.name
}

/// A flame set down in the world — on the floor or in a socket — and when it burns out, in the
/// level's clock.  One a cell: a flame is an item, and a cell holds one item.
pub struct Flame {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub until: integer
}

/// A painted piece of track: the picture (a tile number) and the sides it joins (north 1, east 2,
/// south 4, west 8).  A junction is a straight and a bend sharing one side, its toe: a cart in by
/// the toe goes the way it is set — on to the straight's other side, or round to the bend's —
/// and one in by either of those goes on to the toe.  Its twin is the same junction set the other
/// way; a lever flips one into the other.
pub struct Piece {
  pub const tile: integer,
  pub joins: integer,
  pub toe: integer,
  pub straight: integer,
  pub turn: integer,
  pub set_turn: boolean,
  pub twin: integer
}

/// A train rolling by itself: its carts' cells front first (with their layers: a train runs over a
/// slope's top onto the next layer), the way its front last moved, its speed (1 .. max_speed), when
/// it moves next (the level's clock), and the cells it has run on the flat since it last slowed.
pub struct Roll {
  pub cells: vector<(integer, integer, integer)>,
  pub dx: integer,
  pub dy: integer,
  pub speed: integer,
  pub due: integer,
  pub flat: integer
}

/// A cell being felled, and the blows it has taken.
pub struct Blows {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub n: integer
}

/// A level being played: the world, its kinds and the hero on it.
pub struct Level {
  pub w: tile_world::World,
  pub k: Kinds,
  pub hero_x: integer,
  pub hero_y: integer,
  pub hero_z: integer,
  pub hero_h: integer,
  /// The level's clock in milliseconds (`tick`), and until when a boost lasts.
  pub now: integer,
  pub boost_until: integer,
  /// What the hero holds: 0 for nothing, or a thing it took.
  pub hero_item: integer,
  /// The points scored: a chest opened is one.
  pub points: integer,
  /// The money the hero has found (chests), and its temporary health: above `health`, lost first
  /// when hurt, never fading (owner).
  pub money: integer,
  pub spirit: integer,
  /// The hero's health: a fall costs some; at 0 the hero moves no more.
  pub health: integer,
  /// The flames set down in the world, and when the one the hero holds burns out.
  pub flames: vector<Flame>,
  pub hero_until: integer,
  /// Has the clock met the flames the level started with (`tick` kindles them once)?
  pub kindled: boolean,
  /// The trees (and anything else taking more than one blow) part felled.
  pub blows: vector<Blows>,
  /// The painted track pieces, by their picture (`add_piece`; theme.json's tracks and junctions).
  pub pieces: hash<Piece[tile]>,
  /// The trains rolling by themselves; the way the hero riding one leans (kept until the next
  /// junction); how many cells all of them have rolled (the game hears it).
  pub rolls: vector<Roll>,
  pub lean_x: integer,
  pub lean_y: integer,
  pub rolled: integer,
  /// The way the hero faces: the way it last tried to walk (towards the thing it pulls), one
  /// of (1, 0), (-1, 0), (0, 1), (0, -1).  What it swings at is the cell there.
  pub face_x: integer,
  pub face_y: integer,
  /// Bombs rolling; bombs set off, going off at their time; the blasts so far (the game shows and
  /// hears them) and how many.
  pub bombs: vector<BombRoll>,
  pub fuses: vector<Fuse>,
  pub blasts: vector<Blast>,
  pub blasted: integer,
  /// The enemies, the next one's id, how many the hero has bested (killed).
  pub enemies: vector<Enemy>,
  pub next_enemy: integer,
  pub killed: integer,
  /// How often a cyclops has spotted the hero (it shouts: the game plays it), and thrown a bomb at
  /// it (it rolls: heard).
  pub spotted: integer,
  pub hurled: integer,
  /// The enemy (its id, 0 for none) that holds the hero, pulling it; the hero's presses away from
  /// it so far (breaking free at struggle_presses).
  pub held_by: integer,
  pub struggles: integer,
  /// The hero's blows: recovering until blow_until; a blow pressed meanwhile waits (queued, the way
  /// (queued_x, queued_y), a swing or a walk into something); blows struck so far.
  pub blow_until: integer,
  pub queued: boolean,
  pub queued_x: integer,
  pub queued_y: integer,
  pub queued_swing: boolean,
  pub struck: integer,
  /// The bow's aim: whether it is locked on a target, and that target's cell; the arrows shot (the
  /// game draws them flying).
  pub aiming: boolean,
  pub aim_x: integer,
  pub aim_y: integer,
  pub shots: vector<Shot>,
  /// The one the hero last walked into that talks (its id), and how often it has (the game says
  /// what is said).
  pub talk_to: integer = 0,
  pub talked: integer = 0
}

/// An arrow: shot from (x, y, z) the way (dx, dy) `at`; it has flown `cells` cells, flies the next
/// at `due`, and is `done` once it has struck or fallen.
pub struct Shot {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub dx: integer,
  pub dy: integer,
  pub cells: integer,
  pub at: integer,
  pub due: integer,
  pub done: boolean,
  /// Who shot it: 0 the hero, else the id of the enemy (a hunter).
  pub by: integer
}

/// An enemy: its id (it keeps it while it lives), kind, place and nest, its health, when it acts
/// next and when it heals next, the steps it has taken (its wander's seed) and the way it faces.
pub struct Enemy {
  pub id: integer,
  pub kind: text,
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub nest_x: integer,
  pub nest_y: integer,
  pub nest_z: integer,
  pub hp: integer,
  pub due: integer,
  pub heal_due: integer,
  pub steps: integer,
  pub face_x: integer,
  pub face_y: integer,
  /// Scared by a blast until this time, fleeing the place it went off.
  pub scared_until: integer,
  pub scare_x: integer,
  pub scare_y: integer,
  /// Searching (a cyclops) the place (search_x, search_y) until this time; whether it saw the hero
  /// when it last acted (seeing it anew, it shouts).
  pub search_until: integer,
  pub search_x: integer,
  pub search_y: integer,
  pub saw: boolean,
  /// What it holds (a thing, 0 for nothing) and, holding bombs, how many are left.
  pub item: integer,
  pub bombs: integer,
  /// Talking (talk.loft): the line being said (-1 none), the one the next talk starts with, until
  /// when this line is said, whether the hero walked away from it, and whether a talk that starts
  /// near has begun since the hero came within reach.
  pub talk_line: integer = -1,
  pub talk_start: integer = 0,
  pub talk_until: integer = 0,
  pub talk_away: boolean = false,
  pub talk_heard: boolean = false,
  /// Barking at one walking on by: the bark said (-1 none), until when, whether this time by has
  /// had one, and how many it has said (the next is the one after).
  pub bark_line: integer = -1,
  pub bark_until: integer = 0,
  pub barked: boolean = false,
  pub barks_said: integer = 0
}

// No enemy: what a missing index reads as.
fn no_enemy() -> Enemy {
  Enemy { id: 0, kind: "", x: 0, y: 0, z: 0, nest_x: 0, nest_y: 0, nest_z: 0, hp: 0, due: 0, heal_due: 0, steps: 0,
          face_x: 0, face_y: 1, scared_until: 0, scare_x: 0, scare_y: 0, search_until: 0, search_x: 0, search_y: 0, saw: false,
          item: 0, bombs: 0 }
}

/// A bomb rolling: on (x, y, z), moving (dx, dy) at `speed` (1 .. max_speed: a cell every
/// roll_ms / speed), its next move at `due`, the cells it has rolled on the flat since it last
/// slowed, and whether it was fused (thrown: it goes off on impact).
pub struct BombRoll {
  pub fused: boolean,
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub dx: integer,
  pub dy: integer,
  pub speed: integer,
  pub due: integer,
  pub flat: integer
}

/// A bomb a blast set off: the one lying on (x, y, z), or the one the hero holds (`held`); it goes
/// off `at`.
pub struct Fuse {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub held: boolean,
  pub at: integer
}

/// A blast: centred on (x, y, z) `at`, in water or not.
pub struct Blast {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub at: integer,
  pub water: boolean
}

/// What a step did.
pub enum Step {
  Blocked,
  Walked,
  Pushed,
  Pulled,
  Climbed,
  /// The hero took a mounted thing off a wall, or fixed the one it held to a wall.
  Took,
  Placed,
  /// The hero opened a door or a chest.
  Opened,
  /// The hero read a signpost: `closed` says what it told.
  Read,
  /// The hero fell a layer or more, and lost health.
  Fell,
  /// The hero drank from a well: the game saves the whole situation here.
  Saved,
  /// The hero felled a tree or a fence with what it holds.
  Chopped,
  /// The hero threw a lever: the junctions beside it are set the other way.
  Switched,
  /// The hero riding a rolling cart leaned (it keeps the lean until the next junction).
  Leaned,
  /// The hero dipped what it holds (a stick, in a tar barrel).
  Dipped,
  /// A flame lit a torch: the one the hero holds, or the one in a socket.
  Lit,
  /// The hero swung its weapon at the cell it faces, and hit nothing there.
  Swung,
  /// The hero threw the bomb it held.
  Thrown,
  /// The hero struck an enemy (walking into it, or swinging at it).
  Attacked,
  /// The hero walked into one that talks (`talk_to`, its id): the game says what it says.
  Talked,
  /// The well gave no water: an enemy is near, in sight.
  Watched,
  /// The hero shot an arrow.
  Shot,
  /// The hero, held by a cyclops, pulled away from it, not yet free.
  Struggled,
  /// A blow pressed while the hero recovers from the last: it lands when that is over, unless
  /// the hero does something else first.
  Readying
}

/// An empty level whose world knows the kinds: what is walked on, what stops sight and light,
/// what gives light, how high each thing stands.
pub fn level(k: const Kinds) -> Level {
  w = tile_world::world();
  for t in k.terrain {
    tile_world::terrain_kind(w, t.id, t.walk, t.opaque, false, t.glyph);
  }
  for e in k.edges {
    tile_world::edge_kind(w, e.id, e.walk, e.opaque, e.glyph);
  }
  for t in k.things {
    blocks = t.walk_on == "";
    // A flame's light fades as it burns, so the game passes it in (`lights`); the world lights
    // only what always shines (the staff).
    tile_world::thing_kind(w, t.id, t.height, blocks, false, t.light && !t.flame, t.glyph);
  }
  Level { w: w, k: k, hero_x: 0, hero_y: 0, hero_z: 0, hero_h: 0, now: 0, boost_until: 0, hero_item: 0,
          points: 0, health: k.health, flames: [], hero_until: 0, kindled: false, blows: [], pieces: [],
          rolls: [], lean_x: 0, lean_y: 0, rolled: 0, face_x: 0, face_y: 1,
          bombs: [], fuses: [], blasts: [], blasted: 0, enemies: [], next_enemy: 1, killed: 0, spotted: 0, hurled: 0, held_by: 0, struggles: 0, blow_until: 0, queued: false, queued_x: 0,
          queued_y: 0, queued_swing: false, struck: 0,
          aiming: false, aim_x: 0, aim_y: 0, shots: [], money: 0, spirit: 0 }
}

/// Terrain kind and thing numbers by name, for building a level.
pub fn tr(l: const Level, name: text) -> integer {
  terrain_id(l.k, name)
}

pub fn th(l: const Level, name: text) -> integer {
  thing_id(l.k, name)
}

pub fn ed(l: const Level, name: text) -> integer {
  edge_id(l.k, name)
}

// --- Properties ---

/// Can a cell of terrain kind `kind` be stood on or moved over.
pub fn walkable(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.walk
}

/// How high cell (x, y, z) stands, in steps: its terrain's own height (a fence), its rise, and
/// the things stacked on it.
pub fn height(l: const Level, x: integer, y: integer, z: integer) -> integer {
  p = l.k.terrain[tile_world::terrain(l.w, x, y, z)];
  (if p { p.height } else { 0 }) + tile_world::height(l.w, x, y, z)
}

// The kind terrain `kind` turns into when walked into (a door, open), 0 for none.
fn opens_to(l: const Level, kind: integer) -> integer {
  p = l.k.terrain[kind];
  if !p { return 0; }
  if p.opens_to == "" { return 0; }
  terrain_id(l.k, p.opens_to)
}

// Where terrain `kind` takes the hero who walks onto it: 1 a layer up, -1 down, 0 nowhere.
fn stairs(l: const Level, kind: integer) -> integer {
  p = l.k.terrain[kind];
  if !p { return 0; }
  p.stairs
}

// Does terrain `kind` keep things off: nothing pushed or pulled onto it?
fn blocks_things(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.blocks_things
}

/// Can the hero cross from (x, y, z) to the cell (dx, dy) beside it: no edge between, an edge
/// that is walked through (a door), or one it climbs over (a fence)?
pub fn hero_crosses(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  if tile_world::crossable(l.w, x, y, z, dx, dy) { return true; }
  side = if dx > 0 { tile_world::EAST } else if dx < 0 { tile_world::WEST }
         else if dy > 0 { tile_world::SOUTH } else { tile_world::NORTH };
  p = l.k.edges[tile_world::edge(l.w, x, y, z, side)];
  if !p { return false; }
  p.climb
}

fn rail(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.rail
}

fn mount_terrain(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.mount
}

/// How many height steps a thing adds to its stack.
pub fn thing_height(l: const Level, thing: integer) -> integer {
  if thing == 0 { return 0; }
  p = l.k.things[thing];
  if !p { return 1; }
  p.height
}

/// Is this a thing the hero walks onto rather than into.
pub fn item(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.walk_on != ""
}

/// Can the hero stand on this thing.
pub fn standable(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.stand
}

/// Can a push move this thing.
pub fn movable(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.move == "push" || p.move == "push_pull"
}

fn pullable(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.move == "push_pull"
}

fn surface_kind(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.surface
}

fn trainlike(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.train
}

fn on_rails(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.rails
}

fn lifts(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.lift
}

// The thing `thing` turns into when walked into (a chest, open), 0 for none.
fn thing_opens_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p { return 0; }
  if p.opens_to == "" { return 0; }
  thing_id(l.k, p.opens_to)
}

/// Where the things still to open (closed chests) are, stack by stack.
pub fn closed_at(l: const Level) -> vector<(integer, integer, integer)> {
  out: vector<(integer, integer, integer)> = [];
  for s in tile_world::stacks(l.w) {
    for t in tile_world::things(l.w, s.0, s.1, s.2) {
      if thing_opens_to(l, t) != 0 { out += [s]; }
    }
  }
  out
}

/// How many things in the level are still to open (closed chests).
pub fn closed(l: const Level) -> integer {
  n = 0;
  for s in tile_world::stacks(l.w) {
    for t in tile_world::things(l.w, s.0, s.1, s.2) {
      if thing_opens_to(l, t) != 0 { n += 1; }
    }
  }
  n
}

// Does what the hero holds fell what can be chopped (an axe)?
fn holds_chopper(l: const Level) -> boolean {
  p = l.k.things[l.hero_item];
  if !p { return false; }
  p.chops
}

// Throw the lever on (x, y, z), if one stands there: every junction beside it is set the other way
// (its twin picture), and the handle goes over.  Answers whether there was one.
fn throw_lever(l: Level, x: integer, y: integer, z: integer) -> boolean {
  lever = l.k.things[base(l, x, y, z)];
  if !lever || lever.switches_to == "" { return false; }
  for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
    p = l.pieces[painted(l, x + d.0, y + d.1, z)]?;
    if p.twin != 0 {
      tile_world::set_terrain(l.w, x + d.0, y + d.1, z, tile_world::terrain(l.w, x + d.0, y + d.1, z), p.twin);
    }
  }
  replace_base(l, x, y, z, thing_id(l.k, lever.switches_to));
  true
}

/// Does the hero hold a weapon (a thing that swings)?
pub fn armed(l: const Level) -> boolean {
  p = l.k.things[l.hero_item];
  if !p { return false; }
  p.swings
}

/// The hero swings the weapon it holds at the cell it faces: an axe strikes a tree or a fence
/// there as walking into it does (Chopped); anything else is a swing through the air (Swung).
/// Without a weapon, or with no health, nothing happens (Blocked).  The hero does not move.
pub fn swing(l: Level) -> Step {
  l.queued = false;
  if !alive(l) || !armed(l) { return Step.Blocked; }
  hero_blow(l, l.face_x, l.face_y, true)
}

// A blow of the hero's the way (dx, dy) — a swing, or a walk into an enemy or a tree: struck now,
// or, while it recovers from the last, remembered to land when that is over (Readying).
fn hero_blow(l: Level, dx: integer, dy: integer, swinging: boolean) -> Step {
  if l.now < l.blow_until {
    l.queued = true;
    l.queued_x = dx;
    l.queued_y = dy;
    l.queued_swing = swinging;
    return Step.Readying;
  }
  land_blow(l, dx, dy)
}

// The blow lands: on an enemy there (Attacked), else — the axe held — a tree or fence there
// (Chopped), else on nothing (Swung).  The hero recovers for blow_ms.
fn land_blow(l: Level, dx: integer, dy: integer) -> Step {
  l.face_x = dx;
  l.face_y = dy;
  l.blow_until = l.now + recovery(l);
  l.struck += 1;
  z = l.hero_z;
  tx = l.hero_x + dx;
  ty = l.hero_y + dy;
  // Reach (owner): bare hands strike the cell faced; anything held strikes it and the two cells
  // beside it across the swing — through the cell faced, so not past a wall there.
  cells: vector<(integer, integer)> = [(tx, ty)];
  faced = tile_world::terrain(l.w, tx, ty, z);
  if l.hero_item != 0 && hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) && !opaque_terrain(l, faced) {
    cells += [(tx - dy, ty + dx), (tx + dy, ty - dx)];
  }
  hit = false;
  for c in cells {
    foe = enemy_at(l, c.0, c.1, z);
    if foe < 0 || !reachable_foe(l, foe, dx, dy) { continue; }
    strike_enemy(l, foe, blow_on(l, foe));
    hit = true;
  }
  if hit { return Step.Attacked; }
  kind = tile_world::terrain(l.w, tx, ty, z);
  felled = chopped_to(l, kind);
  if felled != 0 && holds_chopper(l) && hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) {
    strike(l, kind, felled, tx, ty, z, dx, dy);
    return Step.Chopped;
  }
  Step.Swung
}

// A thing left on (x, y, z) by one facing (dx, dy) that is gone: there, or — an item lying there
// already — beside it, the side the place prefers, then the other (as a tree's stick); no room,
// it is lost.
fn leave(l: Level, t: integer, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  if tile_world::top(l.w, x, y, z) == 0 {
    tile_world::place(l.w, x, y, z, t);
    return;
  }
  s = aside(l, x, y, z, dx, dy);
  if s.0 == 0 && s.1 == 0 { return; }
  r = landing(l, x, y, z, s.0, s.1, false);
  if r.0 == LANDS { tile_world::place(l.w, r.1, r.2, r.3, t); }
}

// A remembered blow whose time has come lands.
fn queued_blow(l: Level) {
  if !l.queued || l.now < l.blow_until { return; }
  l.queued = false;
  if alive(l) { _ = land_blow(l, l.queued_x, l.queued_y); }
}

/// Are the hero's hands too busy to push, pull or lift?  They are while it holds an item.
pub fn hands_busy(l: const Level) -> boolean {
  l.hero_item != 0
}

// One blow of the axe at (x, y, z), a cell of terrain `kind` the hero strikes moving (dx, dy):
// what it drops lands beside it (the side its place prefers, then the other) when there is room,
// and at its last blow it is felled to `to`.
fn strike(l: Level, kind: integer, to: integer, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  p = l.k.terrain[kind];
  if !p { return; }
  dropped = thing_id(l.k, p.drops);
  if dropped != 0 {
    s = aside(l, x, y, z, dx, dy);
    if s.0 != 0 || s.1 != 0 {
      r = landing(l, x, y, z, s.0, s.1, false);
      if r.0 == LANDS { tile_world::place(l.w, r.1, r.2, r.3, dropped); }
    }
  }
  n = 1;
  i = 0;
  while i < len(l.blows) {
    b = l.blows[i]!;
    if b.x == x && b.y == y && b.z == z {
      n = b.n + 1;
      _ = l.blows.remove(i);
    } else {
      i += 1;
    }
  }
  if n >= p.hits {
    tile_world::set_terrain(l.w, x, y, z, to);
  } else {
    l.blows += [Blows { x: x, y: y, z: z, n: n }];
  }
}

// The kind terrain `kind` becomes when chopped (a tree, to floor), 0 when it cannot be.
fn chopped_to(l: const Level, kind: integer) -> integer {
  p = l.k.terrain[kind];
  if !p { return 0; }
  if p.chopped_to == "" { return 0; }
  terrain_id(l.k, p.chopped_to)
}

fn mounts(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.mount
}

fn walk_on(l: const Level, thing: integer) -> text {
  p = l.k.things[thing];
  if !p { return ""; }
  p.walk_on
}

fn gives_light(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.light
}

fn rests(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.rest
}

// What the hero meets at (x, y, z): the top thing, or — when that is an item resting on a big
// thing (a rest thing) — the big thing under it.
fn base(l: const Level, x: integer, y: integer, z: integer) -> integer {
  st = tile_world::things(l.w, x, y, z);
  n = len(st);
  if n == 0 { return 0; }
  t = st[n - 1] ?? 0;
  if n >= 2 && item(l, t) && rests(l, st[n - 2] ?? 0) { return st[n - 2] ?? 0; }
  t
}

// Move the thing at the top of (x, y, z) to (nx, ny, z) — a big thing with the item resting on
// it, which rides along (a flame with its time).
fn move_base(l: Level, x: integer, y: integer, z: integer, nx: integer, ny: integer) {
  move_base_to(l, x, y, z, nx, ny, z);
}

// The same, onto layer nz (a cart over a slope's top).
fn move_base_to(l: Level, x: integer, y: integer, z: integer, nx: integer, ny: integer, nz: integer) {
  on = 0;
  if base(l, x, y, z) != tile_world::top(l.w, x, y, z) { on = tile_world::take(l.w, x, y, z); }
  t = tile_world::take(l.w, x, y, z);
  tile_world::place(l.w, nx, ny, nz, t);
  if on == 0 { return; }
  tile_world::place(l.w, nx, ny, nz, on);
  i = flame_at(l, x, y, z);
  if i >= 0 {
    l.flames[i].x = nx;
    l.flames[i].y = ny;
    l.flames[i].z = nz;
  }
}

// Turn the thing at (x, y, z) — under an item resting on it, if any — into `to` (a chest opens);
// the item stays on top.
fn replace_base(l: Level, x: integer, y: integer, z: integer, to: integer) {
  on = 0;
  if base(l, x, y, z) != tile_world::top(l.w, x, y, z) { on = tile_world::take(l.w, x, y, z); }
  _ = tile_world::take(l.w, x, y, z);
  tile_world::place(l.w, x, y, z, to);
  if on != 0 { tile_world::place(l.w, x, y, z, on); }
}

fn holds(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.holds
}

fn dips(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.dips
}

/// Does `thing` burn (a burning torch)?
pub fn is_flame(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.flame
}

// What `thing` becomes dipped (a stick: a torch), lit (a torch: a burning one) or burnt out (a
// burning torch: a stick); 0 when it does not.
fn dipped_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.dipped_to == "" { return 0; }
  thing_id(l.k, p.dipped_to)
}

fn lit_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.lit_to == "" { return 0; }
  thing_id(l.k, p.lit_to)
}

fn burns_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.burns_to == "" { return 0; }
  thing_id(l.k, p.burns_to)
}

// --- Flames ---

// The entry of the flame set down on (x, y, z), -1 for none.
fn flame_at(l: const Level, x: integer, y: integer, z: integer) -> integer {
  for i in 0..len(l.flames) {
    f = l.flames[i];
    if f.x == x && f.y == y && f.z == z { return i; }
  }
  -1
}

// The flame on (x, y, z) burns until `until`.
fn set_flame(l: Level, x: integer, y: integer, z: integer, until: integer) {
  i = flame_at(l, x, y, z);
  if i >= 0 {
    l.flames[i].until = until;
  } else {
    l.flames += [Flame { x: x, y: y, z: z, until: until }];
  }
}

// The hero took `thing` from (x, y, z): a flame keeps the time it had left there (a flame the
// clock never met — just placed by the editor — has all of it).
fn took(l: Level, thing: integer, x: integer, y: integer, z: integer) {
  l.hero_until = 0;
  if !is_flame(l, thing) { return; }
  i = flame_at(l, x, y, z);
  if i < 0 {
    l.hero_until = l.now + l.k.burn_ms;
    return;
  }
  l.hero_until = l.flames[i]!.until;
  _ = l.flames.remove(i);
}

// The hero set `thing` down on (x, y, z), a flame that burns until `until`.
fn set_down(l: Level, thing: integer, x: integer, y: integer, z: integer, until: integer) {
  if is_flame(l, thing) { set_flame(l, x, y, z, until); }
}

// Every flame the level started with (from its file, or the editor) starts burning now.
fn kindle(l: Level) {
  l.kindled = true;
  for c in tile_world::stacks(l.w) {
    for t in tile_world::things(l.w, c.0, c.1, c.2) {
      if is_flame(l, t) && flame_at(l, c.0, c.1, c.2) < 0 {
        l.flames += [Flame { x: c.0, y: c.1, z: c.2, until: l.now + l.k.burn_ms }];
      }
    }
  }
  if is_flame(l, l.hero_item) && l.hero_until == 0 { l.hero_until = l.now + l.k.burn_ms; }
}

// The flame on (x, y, z) burnt out: it becomes what it burns to, where it stands in the stack.
fn burnt(l: Level, x: integer, y: integer, z: integer) {
  above: vector<integer> = [];
  t = tile_world::take(l.w, x, y, z);
  while t != 0 && !is_flame(l, t) {
    above += [t];
    t = tile_world::take(l.w, x, y, z);
  }
  if t != 0 { tile_world::place(l.w, x, y, z, burns_to(l, t)); }
  i = len(above) - 1;
  while i >= 0 {
    tile_world::place(l.w, x, y, z, above[i] ?? 0);
    i -= 1;
  }
}

// Every flame whose time is up burns out, the one the hero holds too.
fn burn_out(l: Level) {
  i = 0;
  while i < len(l.flames) {
    f = l.flames[i]!;
    if f.until > l.now {
      i += 1;
      continue;
    }
    burnt(l, f.x, f.y, f.z);
    _ = l.flames.remove(i);
  }
  if is_flame(l, l.hero_item) && l.hero_until <= l.now {
    l.hero_item = burns_to(l, l.hero_item);
    l.hero_until = 0;
  }
}

/// Is the flame on (x, y, z) in its last `low_ms` (drawn low)?
pub fn low(l: const Level, x: integer, y: integer, z: integer) -> boolean {
  i = flame_at(l, x, y, z);
  if i < 0 { return false; }
  l.flames[i].until - l.now <= l.k.low_ms
}

/// Is the flame the hero holds in its last `low_ms`?
pub fn hero_low(l: const Level) -> boolean {
  is_flame(l, l.hero_item) && l.hero_until - l.now <= l.k.low_ms
}

// How far a flame burning until `until` has faded, in shades: 0 when lit, `fade` at its end.
fn faded(l: const Level, until: integer) -> integer {
  left = until - l.now;
  if left >= l.k.burn_ms || l.k.burn_ms <= 0 { return 0; }
  if left < 0 { left = 0; }
  (l.k.burn_ms - left) * l.k.fade / l.k.burn_ms ?? 0
}

/// Does the flame burning until `until` at (x, y, z) flicker one shade dimmer now?  Once a
/// `flicker_ms` step, one step in `flicker_odds`, chosen by a hash of the step and the flame (its
/// end and its place), so two flames lit together do not flicker together.
pub fn flicker(l: const Level, until: integer, x: integer, y: integer, z: integer) -> integer {
  if l.k.flicker_ms <= 0 || l.k.flicker_odds <= 0 { return 0; }
  h = mix((l.now / l.k.flicker_ms ?? 0) * 40503 + until * 7919 + place_key(x, y, z));
  if (h >> 4) % l.k.flicker_odds == 0 { 1 } else { 0 }
}

// --- The world's fixed choices ---
//
// Where the rules must choose (which way an item goes aside, when a flame flickers) they choose
// by a hash: the same situation always gives the same answer, so the game is deterministic, but
// the pattern follows no row, column or checkerboard a player could read off the grid.

// An integer mixed into 31 well-spread bits (two rounds of a known 32-bit integer hash), every
// product kept inside the integer range.
fn mix(v: integer) -> integer {
  h = v & 0x7FFFFFFF;
  h = (((h >> 16) ^ h) * 0x45d9f3b) & 0x7FFFFFFF;
  h = (((h >> 16) ^ h) * 0x45d9f3b) & 0x7FFFFFFF;
  (h >> 16) ^ h
}

// A cell as one integer to mix (large primes, so near cells land far apart).
fn place_key(x: integer, y: integer, z: integer) -> integer {
  (x * 73856093) ^ (y * 19349663) ^ (z * 83492791)
}

/// Does an item pushed aside on (x, y, z) try the right of its way first (else the left)?  Each
/// place on the ground has its own, fixed, preference.
pub fn prefers_right(x: integer, y: integer, z: integer) -> boolean {
  ((mix(place_key(x, y, z)) >> 7) & 1) == 1
}

/// The lights the game gives `tile_world::shades` on layer z, and the shade each starts at
/// (`light_starts`, the same order): what the hero carries, then every flame set down there.  A
/// flame fades as it burns; the staff does not.  Before the clock has met the level's flames
/// they are as bright as when lit.
pub fn lights(l: const Level, z: integer) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  if l.hero_item != 0 && gives_light(l, l.hero_item) { out += [(l.hero_x, l.hero_y)]; }
  if l.kindled {
    for f in l.flames { if f.z == z { out += [(f.x, f.y)]; } }
    for b in l.blasts { if b.z == z && flashing(l, b) { out += [(b.x, b.y)]; } }
    return out;
  }
  for c in tile_world::stacks(l.w) {
    if c.2 != z { continue; }
    for t in tile_world::things(l.w, c.0, c.1, c.2) {
      if is_flame(l, t) { out += [(c.0, c.1)]; }
    }
  }
  out
}

pub fn light_starts(l: const Level, z: integer) -> vector<integer> {
  out: vector<integer> = [];
  if l.hero_item != 0 && gives_light(l, l.hero_item) {
    out += [if is_flame(l, l.hero_item) {
      faded(l, l.hero_until) + flicker(l, l.hero_until, l.hero_x, l.hero_y, l.hero_z)
    } else { 0 }];
  }
  if l.kindled {
    for f in l.flames { if f.z == z { out += [faded(l, f.until) + flicker(l, f.until, f.x, f.y, f.z)]; } }
    // A blast's flash: full at once, fading three shades over flash_ms.
    for b in l.blasts {
      if b.z == z && flashing(l, b) { out += [(l.now - b.at) * 4 / l.k.flash_ms ?? 0]; }
    }
  }
  out
}

// Is blast b still lighting its surroundings?
fn flashing(l: const Level, b: const Blast) -> boolean {
  l.now >= b.at && l.now - b.at < l.k.flash_ms
}

/// Is anything flashing, rolling or flying — a blast's light, a bomb or an arrow on its way?  (The
/// picture moves then.)
pub fn blasting(l: const Level) -> boolean {
  if len(l.bombs) > 0 || len(l.fuses) > 0 { return true; }
  for s in l.shots { if !s.done { return true; } }
  for b in l.blasts { if flashing(l, b) { return true; } }
  false
}

/// Is the bomb on (x, y, z) lit: thrown and on its way, or set off by a blast and about to go?
pub fn fused_at(l: const Level, x: integer, y: integer, z: integer) -> boolean {
  i = bomb_rolling_at(l, x, y, z);
  if i >= 0 && (l.bombs[i].fused ?? false) { return true; }
  fused(l, x, y, z, false)
}

/// Does anything burn — a flame set down, or the one the hero holds?  (The picture moves then.)
pub fn burning(l: const Level) -> boolean {
  len(l.flames) > 0 || is_flame(l, l.hero_item)
}

// --- The hero ---

/// Put the hero on (x, y, z), standing on the stack there.
pub fn put_hero(l: Level, x: integer, y: integer, z: integer) {
  l.hero_x = x;
  l.hero_y = y;
  l.hero_z = z;
  l.hero_h = height(l, x, y, z);
}

/// What passes through a door with the hero (WORLD.md § The world): what it holds, its health,
/// money and points, the way it faces, and what is timed as the time it has left — each place
/// keeps its own clock, so a held torch burning down, a boost and a blow's recovery go on from
/// there.
pub struct Carried {
  pub item: integer,
  pub health: integer,
  pub spirit: integer,
  pub money: integer,
  pub points: integer,
  pub face_x: integer,
  pub face_y: integer,
  /// The held flame's time left (-1: none held), a boost's and a blow's recovery's (0: none).
  pub flame_left: integer,
  pub boost_left: integer,
  pub blow_left: integer
}

/// What the hero of `l` takes through a door.
pub fn carried(l: const Level) -> Carried {
  Carried {
    item: l.hero_item, health: l.health, spirit: l.spirit, money: l.money, points: l.points,
    face_x: l.face_x, face_y: l.face_y,
    flame_left: if l.hero_until == 0 { -1 } else { l.hero_until - l.now },
    boost_left: if l.boost_until > l.now { l.boost_until - l.now } else { 0 },
    blow_left: if l.blow_until > l.now { l.blow_until - l.now } else { 0 }
  }
}

/// The hero comes into `l` through a door with `c`.  Anything that held it or was pending
/// (a cyclops's grip, a remembered blow, the bow's aim) stays behind.
pub fn carry_in(l: Level, c: const Carried) {
  l.hero_item = c.item;
  l.health = c.health;
  l.spirit = c.spirit;
  l.money = c.money;
  l.points = c.points;
  l.face_x = c.face_x;
  l.face_y = c.face_y;
  // A held flame's moment stays above 0, which would read as "not yet met by the clock".
  l.hero_until = if c.flame_left < 0 { 0 } else if l.now + c.flame_left > 0 { l.now + c.flame_left } else { 1 };
  l.boost_until = if c.boost_left > 0 { l.now + c.boost_left } else { 0 };
  l.blow_until = if c.blow_left > 0 { l.now + c.blow_left } else { 0 };
  l.queued = false;
  l.held_by = 0;
  l.struggles = 0;
  l.aiming = false;
}

/// The light the hero carries, for `tile_world::shades`: its cell when it holds a light.
pub fn carried_lights(l: const Level) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  if l.hero_item != 0 && gives_light(l, l.hero_item) { out += [(l.hero_x, l.hero_y)]; }
  out
}

/// The level as text, the hero `@`.
pub fn view(l: const Level, x0: integer, y0: integer, x1: integer, y1: integer, z: integer) -> text {
  marks: vector<(integer, integer, text)> = [];
  if l.hero_z == z { marks += [(l.hero_x, l.hero_y, "@")]; }
  tile_world::view(l.w, x0, y0, x1, y1, z, marks)
}

// Can `thing`, sitting with its base at height `base`, go onto cell (x, y, z)?  The cell's
// surface must be that same height: a push or a pull moves a thing level, never up.  A rail
// thing goes only onto rail terrain's floor; a lifting thing also onto a surface's top.
fn fits(l: const Level, thing: integer, x: integer, y: integer, z: integer, base: integer) -> boolean {
  k = tile_world::terrain(l.w, x, y, z);
  if !walkable(l, k) || blocks_things(l, k) { return false; }
  surface = height(l, x, y, z);
  if surface != base { return false; }
  if on_rails(l, thing) { return rail(l, k) && surface == 0; }
  if surface == 0 { return true; }
  lifts(l, thing) && surface_kind(l, tile_world::top(l.w, x, y, z))
}

// --- Items in the way ---
//
// A floor cell holds at most one item (a walk_on thing), and nothing is ever put on one: a light
// item is pushed out of the way of what comes in.  It slides one cell on when there is room; when
// another item lies there — a string of two — that one goes to the side (the side its place
// prefers first, then the other), if there is room, and the first slides into its cell.  With no room the push or the
// pull does not happen.

/// What `landing` answers first: no room (the move does not happen), lands (at the position it
/// answers), or gone (the item fell to nowhere and is destroyed).
pub const NO_ROOM = 0;
pub const LANDS = 1;
pub const GONE = 2;

// Where an item on (x, y, z) goes moving one cell (dx, dy), across an edge things cross.  On its
// own layer: that cell, when it is floor at the item's height holding nothing (with `leaving`,
// what lies there is about to go aside) and not kept off things — else NO_ROOM.  Over a drop
// (void) it falls (`fall`): a fall always happens, and lands somewhere or is GONE.
fn landing(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
           leaving: boolean) -> (integer, integer, integer, integer) {
  nx = x + dx;
  ny = y + dy;
  if !tile_world::crossable(l.w, x, y, z, dx, dy) { return (NO_ROOM, x, y, z); }
  k = tile_world::terrain(l.w, nx, ny, z);
  if k == VOID { return fall(l, nx, ny, z - 1, dx, dy, 0); }
  if !walkable(l, k) || blocks_things(l, k) { return (NO_ROOM, x, y, z); }
  if !leaving && tile_world::top(l.w, nx, ny, z) != 0 { return (NO_ROOM, x, y, z); }
  if height(l, nx, ny, z) != height(l, x, y, z) { return (NO_ROOM, x, y, z); }
  (LANDS, nx, ny, z)
}

// Where a light item falling down column (x, y) from layer z comes to rest: the first floor below
// holding nothing, or a big thing (a rest thing) with nothing on it.  Onto anything else — another
// item, a chair — it rolls off beside it: the side the place prefers, then the other, then
// straight on (dx, dy), falling on over a drop there.  With nowhere to go (water, no floor at all,
// no room around) it is GONE.
fn fall(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
        depth: integer) -> (integer, integer, integer, integer) {
  bottom = lowest_layer(l);
  zb = z;
  while zb >= bottom && tile_world::terrain(l.w, x, y, zb) == VOID { zb -= 1; }
  if zb < bottom { return (GONE, x, y, zb); }
  kb = tile_world::terrain(l.w, x, y, zb);
  if !walkable(l, kb) || blocks_things(l, kb) { return (GONE, x, y, zb); }
  t = tile_world::top(l.w, x, y, zb);
  if t == 0 || rests(l, t) { return (LANDS, x, y, zb); }
  if depth >= 3 { return (GONE, x, y, zb); }
  first = if prefers_right(x, y, zb) { (-dy, dx) } else { (dy, -dx) };
  for d in [first, (-first.0, -first.1), (dx, dy)] {
    if !tile_world::crossable(l.w, x, y, zb, d.0, d.1) { continue; }
    cx = x + d.0;
    cy = y + d.1;
    ck = tile_world::terrain(l.w, cx, cy, zb);
    if ck == VOID {
      r = fall(l, cx, cy, zb - 1, d.0, d.1, depth + 1);
      if r.0 == LANDS { return r; }
      continue;
    }
    if !walkable(l, ck) || blocks_things(l, ck) { continue; }
    ct = tile_world::top(l.w, cx, cy, zb);
    if ct == 0 || rests(l, ct) { return (LANDS, cx, cy, zb); }
  }
  (GONE, x, y, zb)
}

// Is there room for the item on (x, y, z) one cell (dx, dy) on (`landing`)?
fn slides(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
          leaving: boolean) -> boolean {
  landing(l, x, y, z, dx, dy, leaving).0 != NO_ROOM
}

// The side the item on (x, y, z) goes to, out of the way (dx, dy): the side that place prefers
// (`prefers_right`), then the other; (0, 0) when neither has room.
fn aside(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> (integer, integer) {
  first = if prefers_right(x, y, z) { (-dy, dx) } else { (dy, -dx) };
  if slides(l, x, y, z, first.0, first.1, false) { return first; }
  if slides(l, x, y, z, -first.0, -first.1, false) { return (-first.0, -first.1); }
  (0, 0)
}

// Can something come onto (x, y, z) moving (dx, dy), as far as an item lying there goes?
fn way_clear(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  t = tile_world::top(l.w, x, y, z);
  if t == 0 || !item(l, t) { return true; }
  if slides(l, x, y, z, dx, dy, false) { return true; }
  if !item(l, tile_world::top(l.w, x + dx, y + dy, z)) || !slides(l, x, y, z, dx, dy, true) { return false; }
  a = aside(l, x + dx, y + dy, z, dx, dy);
  a.0 != 0 || a.1 != 0
}

// Move the item on top of (x, y, z) one cell (dx, dy), to where it lands (falling, over a drop);
// a flame takes its time along.  An item that falls to nowhere is gone, its flame with it.
fn shift(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  r = landing(l, x, y, z, dx, dy, false);
  if r.0 == NO_ROOM { return; }
  t = tile_world::take(l.w, x, y, z);
  i = flame_at(l, x, y, z);
  if r.0 == GONE {
    if i >= 0 { _ = l.flames.remove(i); }
    return;
  }
  tile_world::place(l.w, r.1, r.2, r.3, t);
  if i >= 0 {
    l.flames[i].x = r.1;
    l.flames[i].y = r.2;
    l.flames[i].z = r.3;
  }
  // A bomb that falls far is set off by the fall.
  if is_bomb(l, t) && z - r.3 >= l.k.bomb_fall { impact(l, r.1, r.2, r.3, l.now); }
}

// Push the item on (x, y, z) out of the way (dx, dy), as way_clear said it can be.
fn clear_way(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  t = tile_world::top(l.w, x, y, z);
  if t == 0 || !item(l, t) { return; }
  if !slides(l, x, y, z, dx, dy, false) {
    a = aside(l, x + dx, y + dy, z, dx, dy);
    shift(l, x + dx, y + dy, z, a.0, a.1);
  }
  shift(l, x, y, z, dx, dy);
}

// Move the hero to (x, y, z), standing on the stack there.  A walk_on thing on that floor acts:
// "boost" is used up, "take" is picked up (and what the hero held is put down in its place).
fn arrive(l: Level, x: integer, y: integer, z: integer) {
  l.hero_x = x;
  l.hero_y = y;
  l.hero_z = z;
  l.hero_h = height(l, x, y, z);
  // An item on the floor, or resting on the big thing the hero stands on, is met.
  t = tile_world::top(l.w, x, y, z);
  effect = walk_on(l, t);
  if effect == "boost" {
    _ = tile_world::take(l.w, x, y, z);
    l.boost_until = l.now + l.k.boost_ms;
  } else if effect == "heal" {
    // A health potion: back up to the start's health, `heals` at most.
    _ = tile_world::take(l.w, x, y, z);
    p = l.k.things[t];
    l.health += if p { p.heals } else { 0 };
    if l.health > l.k.health { l.health = l.k.health; }
  } else if effect == "spirit" {
    // A spirit potion: temporary health, above the start's.
    _ = tile_world::take(l.w, x, y, z);
    p = l.k.things[t];
    l.spirit += if p { p.heals } else { 0 };
  } else if effect == "take" {
    held = l.hero_item;
    held_until = l.hero_until;
    _ = tile_world::take(l.w, x, y, z);
    l.hero_item = t;
    took(l, t, x, y, z);
    if held != 0 {
      tile_world::place(l.w, x, y, z, held);
      set_down(l, held, x, y, z, held_until);
    }
  }
}

// --- Strength and time ---

/// Put down what the hero holds where it stands — on the floor, or on the big thing (a rest thing:
/// a table, a chest, a stone) it stands on: the hero then stands on it, and picks it up again only
/// by walking off and back on.  Step.Placed, or Blocked when it holds nothing or stands on
/// anything else (an item already: one a cell; a chair).
pub fn drop(l: Level) -> Step {
  l.queued = false;
  if l.hero_item == 0 { return Step.Blocked; }
  under = tile_world::top(l.w, l.hero_x, l.hero_y, l.hero_z);
  if under != 0 && !rests(l, under) { return Step.Blocked; }
  if under == 0 && l.hero_h != tile_world::rise(l.w, l.hero_x, l.hero_y, l.hero_z) { return Step.Blocked; }
  tile_world::place(l.w, l.hero_x, l.hero_y, l.hero_z, l.hero_item);
  set_down(l, l.hero_item, l.hero_x, l.hero_y, l.hero_z, l.hero_until);
  l.hero_item = 0;
  l.hero_until = 0;
  Step.Placed
}

/// Advance the level's clock by `ms` milliseconds.  The first tick kindles the flames the level
/// started with; a flame whose time is up burns out.
pub fn tick(l: Level, ms: integer) {
  if !l.kindled { kindle(l); }
  end = l.now + (if ms > 0 { ms } else { 0 });
  // The world steps from one due time to the next, so what one thing sets off within the tick —
  // an enemy's arrow, a thrown bomb, a cart started — runs in it too, at its own time: the outcome
  // does not depend on how the time is cut into ticks.
  step_world(l);
  guard = 0;
  while guard < 100000 {
    guard += 1;
    t = next_due(l);
    if t < 0 || t > end { break; }
    l.now = t;
    step_world(l);
  }
  l.now = end;
  step_world(l);
}

// Everything due by now: rolling carts, bombs and fuses, arrows, enemies, flames burning out.
fn step_world(l: Level) {
  start_rolls(l);
  roll_due(l);
  start_bomb_rolls(l);
  bombs_due(l);
  arrows_due(l);
  queued_blow(l);
  enemies_due(l);
  burn_out(l);
}

// The earliest time after now that anything is due: -1 when nothing is.
fn next_due(l: const Level) -> integer {
  t = -1;
  for r in l.rolls { if r.due > l.now && (t < 0 || r.due < t) { t = r.due; } }
  for b in l.bombs { if b.due > l.now && (t < 0 || b.due < t) { t = b.due; } }
  for f in l.fuses { if f.at > l.now && (t < 0 || f.at < t) { t = f.at; } }
  for s in l.shots { if !s.done && s.due > l.now && (t < 0 || s.due < t) { t = s.due; } }
  for e in l.enemies { if e.due > l.now && (t < 0 || e.due < t) { t = e.due; } }
  for f in l.flames { if f.until > l.now && (t < 0 || f.until < t) { t = f.until; } }
  if l.hero_until > l.now && (t < 0 || l.hero_until < t) { t = l.hero_until; }
  if l.queued && l.blow_until > l.now && (t < 0 || l.blow_until < t) { t = l.blow_until; }
  t
}

/// Is a boost still on?
pub fn boosted(l: const Level) -> boolean {
  l.now < l.boost_until
}

/// How long a train the hero pushes now, and pulls.
pub fn push_strength(l: const Level) -> integer {
  l.k.push_strength + (if boosted(l) { l.k.boost } else { 0 })
}

pub fn pull_strength(l: const Level) -> integer {
  l.k.pull_strength + (if boosted(l) { l.k.boost } else { 0 })
}

// --- Tracks ---
//
// A rail cell joins each rail cell beside it across an edge things cross: its sides, as bits —
// north 1, east 2, south 4, west 8.  One side is an end, two a straight or a bend, three or four
// a junction.  The theme draws the piece its sides name, so what is seen is what a cart follows.
// A cart leaves a cell through the joined side opposite the one it came in by: the other side of a
// straight or a bend, straight on through a junction (choosing a branch comes with the switches).
// Past a track's end it runs straight on, off the rails: it derails onto free floor there, and
// anything else there — a wall, a thing — stops it.

/// What `train_way` answers: the train cannot move, it moves on along the track, or its front
/// cart derails.
pub const STUCK = 0;
pub const ALONG = 1;
pub const DERAILS = 2;

fn side_bit(dx: integer, dy: integer) -> integer {
  if dy < 0 { return 1; }
  if dx > 0 { return 2; }
  if dy > 0 { return 4; }
  if dx < 0 { return 8; }
  0
}

fn bit_way(b: integer) -> (integer, integer) {
  if b == 1 { return (0, -1); }
  if b == 2 { return (1, 0); }
  if b == 4 { return (0, 1); }
  if b == 8 { return (-1, 0); }
  (0, 0)
}

/// Is terrain kind `kind` rail?
pub fn is_rail(l: const Level, kind: integer) -> boolean {
  rail(l, kind)
}

/// Teach the level a painted piece of track (see `Piece`): picture `tile` joins sides `joins`; for
/// a junction, its toe, the straight's and the bend's other side, which it is set to, and its twin
/// (0, 0, 0, false, 0 for a plain straight or bend).
pub fn add_piece(l: Level, tile: integer, joins: integer, toe: integer, straight: integer, turn: integer,
                 set_turn: boolean, twin: integer) {
  if tile == 0 || l.pieces[tile] { return; }
  l.pieces += [Piece { tile: tile, joins: joins, toe: toe, straight: straight, turn: turn, set_turn: set_turn,
                       twin: twin }];
}

// The piece painted on (x, y, z), its picture's; 0 for none (the rail's own look).
fn painted(l: const Level, x: integer, y: integer, z: integer) -> integer {
  t = tile_world::tile(l.w, x, y, z);
  if t == 0 || !l.pieces[t] { return 0; }
  t
}

/// The sides rail cell (x, y, z) joins: north 1, east 2, south 4, west 8; 0 for no rail.  A painted
/// piece joins what its picture shows; a plain rail cell each rail beside it that joins it back.
pub fn joins(l: const Level, x: integer, y: integer, z: integer) -> integer {
  if !rail(l, tile_world::terrain(l.w, x, y, z)) { return 0; }
  t = painted(l, x, y, z);
  if t != 0 {
    p = l.pieces[t];
    return if p { p.joins } else { 0 };
  }
  m = 0;
  for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
    nz = rail_next(l, x, y, z, d.0, d.1);
    if nz == NOWHERE { continue; }
    n = painted(l, x + d.0, y + d.1, nz);
    np = l.pieces[n];
    if n == 0 || (np && (np.joins & side_bit(-d.0, -d.1)) != 0) { m += side_bit(d.0, d.1); }
  }
  m
}

/// The layer `rail_next` answers when a side leads to no rail.
pub const NOWHERE = -1000000;

// The layer of the rail cell beside (x, y, z) on side (dx, dy), across an edge things cross: the
// rail on its own layer; or — a track running over a slope — up from a slope's top (rise 3, nothing
// overhead) onto the rail of the layer above at its floor (rise 0), or down from a floor (rise 0)
// over the drop beside it onto the slope's top below (rise 3).  NOWHERE for none.
fn rail_next(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> integer {
  nx = x + dx;
  ny = y + dy;
  if !tile_world::crossable(l.w, x, y, z, dx, dy) { return NOWHERE; }
  if rail(l, tile_world::terrain(l.w, nx, ny, z)) { return z; }
  top = l.k.layer_height - 1;
  here = tile_world::rise(l.w, x, y, z);
  if here == top && tile_world::terrain(l.w, x, y, z + 1) == VOID
      && rail(l, tile_world::terrain(l.w, nx, ny, z + 1)) && tile_world::rise(l.w, nx, ny, z + 1) == 0 {
    return z + 1;
  }
  if here == 0 && tile_world::terrain(l.w, nx, ny, z) == VOID
      && rail(l, tile_world::terrain(l.w, nx, ny, z - 1)) && tile_world::rise(l.w, nx, ny, z - 1) == top {
    return z - 1;
  }
  NOWHERE
}

// A cell's height over the bottom of everything: its layer's floor plus its rise.
fn level_h(l: const Level, x: integer, y: integer, z: integer) -> integer {
  z * l.k.layer_height + tile_world::rise(l.w, x, y, z)
}

// The way a cart moving (dx, dy) in rail cell (x, y, z) goes on: the side it leaves by and what
// that is — ALONG (out to the joined cell there), DERAILS (an end: straight on, off the rails) or
// STUCK (it came in by a side the cell does not join, or a junction with no way straight on).
// `pushed`: the cart the hero pushes, which sits in the cell already — it also goes when the cell
// joins only the side it is pushed to (an end, pushed back onto the track).
fn way_on(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
          pushed: boolean, lean: (integer, integer) = (0, 0)) -> (integer, integer, integer) {
  w = way_through(l, x, y, z, dx, dy, pushed, lean);
  if w.2 != ALONG { return w; }
  // The way out leads on only into rail that joins back; past rail that does not, it stops.
  nz = rail_next(l, x, y, z, w.0, w.1);
  if nz != NOWHERE && (joins(l, x + w.0, y + w.1, nz) & side_bit(-w.0, -w.1)) != 0 { return w; }
  if rail(l, tile_world::terrain(l.w, x + w.0, y + w.1, z)) { return (0, 0, STUCK); }
  (w.0, w.1, DERAILS)
}

/// The way a cart moving (dx, dy) leaves junction (x, y, z) by — in by its toe, the way it is set
/// unless the hero riding it leans (`lean`) towards the other branch; in by a branch, to the toe —
/// and (0, 0) for a cell that is no junction or a way in it has none.
pub fn junction_way(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
                    lean: (integer, integer) = (0, 0)) -> (integer, integer) {
  p = l.pieces[painted(l, x, y, z)];
  if !p || p.toe == 0 { return (0, 0); }
  entry = side_bit(-dx, -dy);
  if entry == p.straight || entry == p.turn { return bit_way(p.toe); }
  if entry != p.toe { return (0, 0); }
  leaned = side_bit(lean.0, lean.1);
  if leaned == p.straight || leaned == p.turn { return bit_way(leaned); }
  bit_way(if p.set_turn { p.turn } else { p.straight })
}

fn way_through(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
               pushed: boolean, lean: (integer, integer)) -> (integer, integer, integer) {
  jw = junction_way(l, x, y, z, dx, dy, lean);
  if jw.0 != 0 || jw.1 != 0 { return (jw.0, jw.1, ALONG); }
  m = joins(l, x, y, z);
  entry = side_bit(-dx, -dy);
  ahead = side_bit(dx, dy);
  if (m & entry) == 0 {
    if pushed && m == ahead { return (dx, dy, ALONG); }
    return (0, 0, STUCK);
  }
  rest = m - entry;
  if rest == 0 { return (dx, dy, DERAILS); }
  if (rest & ahead) != 0 { return (dx, dy, ALONG); }
  if rest == 1 || rest == 2 || rest == 4 || rest == 8 {
    w = bit_way(rest);
    return (w.0, w.1, ALONG);
  }
  (0, 0, STUCK)
}

/// The train a push (dx, dy) moves from (x, y, z) on — its carts along the track, front last —
/// and how its front goes on: STUCK, ALONG (one cell on along the rails) or DERAILS (off the end,
/// onto the floor), with the way it goes (`way`).
pub struct TrainWay {
  pub cells: vector<(integer, integer, integer)>,
  pub how: integer,
  pub way: (integer, integer)
}

fn train_way(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> TrainWay {
  out = TrainWay { cells: [], how: STUCK, way: (0, 0) };
  if !car(l, x, y, z) { return out; }
  cx = x;
  cy = y;
  cz = z;
  d = (dx, dy);
  first = true;
  while true {
    out.cells += [(cx, cy, cz)];
    w = way_on(l, cx, cy, cz, d.0, d.1, first);
    first = false;
    out.way = (w.0, w.1);
    out.how = w.2;
    if w.2 != ALONG { return out; }
    nz = rail_next(l, cx, cy, cz, w.0, w.1);
    if nz == NOWHERE || !car(l, cx + w.0, cy + w.1, nz) { return out; }
    cx += w.0;
    cy += w.1;
    cz = nz;
    d = (w.0, w.1);
    if len(out.cells) > 64 { out.how = STUCK; return out; }
  }
  out
}

/// How many carts a push (dx, dy) at (x, y, z) moves: the train, counted along the track.
pub fn train(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> integer {
  len(train_way(l, x, y, z, dx, dy).cells)
}

// Push the train (dx, dy) from (x, y, z), when the hero is strong enough and its front can go on:
// along the rails onto a free cell (a light item there pushed out of the way), or off a track's
// end onto free floor, where it derails.  Answers whether it moved.
fn push_train(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  if rolling_at(l, x, y, z) >= 0 { return false; }
  tw = train_way(l, x, y, z, dx, dy);
  n = len(tw.cells);
  if n == 0 || tw.how == STUCK { return false; }
  last = tw.cells[n - 1] ?? (x, y, z);
  lz = last.2;
  fx = last.0 + tw.way.0;
  fy = last.1 + tw.way.1;
  fz = if tw.how == ALONG { rail_next(l, last.0, last.1, lz, tw.way.0, tw.way.1) } else { lz };
  if fz == NOWHERE { return false; }
  // Up a step every cart counts twice against the strength.
  up = level_h(l, fx, fy, fz) > level_h(l, last.0, last.1, lz);
  if (if up { 2 * n } else { n }) > push_strength(l) { return false; }
  front = base(l, last.0, last.1, lz);
  if tw.how == ALONG {
    if !rail_room(l, last.0, last.1, lz, fx, fy, fz) || !way_clear(l, fx, fy, fz, tw.way.0, tw.way.1) { return false; }
  } else {
    k = tile_world::terrain(l.w, fx, fy, lz);
    if !walkable(l, k) || blocks_things(l, k) || !tile_world::crossable(l.w, last.0, last.1, lz, tw.way.0, tw.way.1)
        || height(l, fx, fy, lz) != tile_world::rise(l.w, last.0, last.1, lz)
        || !way_clear(l, fx, fy, lz, tw.way.0, tw.way.1) {
      return false;
    }
    t = tile_world::top(l.w, fx, fy, lz);
    if t != 0 && !item(l, t) { return false; }
  }
  clear_way(l, fx, fy, fz, tw.way.0, tw.way.1);
  move_base_to(l, last.0, last.1, lz, fx, fy, fz);
  if tw.how == DERAILS {
    p = l.k.things[front];
    to = if p { thing_id(l.k, p.derails_to) } else { 0 };
    if to != 0 { replace_base(l, fx, fy, fz, to); }
  }
  k = n - 2;
  while k >= 0 {
    c = tw.cells[k] ?? (x, y, z);
    t = tw.cells[k + 1] ?? (x, y, z);
    move_base_to(l, c.0, c.1, c.2, t.0, t.1, t.2);
    k -= 1;
  }
  true
}

// Is (x, y, z) one car of a train: a train thing on its floor (an item resting on it or not).
fn car(l: const Level, x: integer, y: integer, z: integer) -> boolean {
  t = base(l, x, y, z);
  trainlike(l, t) && height(l, x, y, z) == tile_world::rise(l.w, x, y, z) + thing_height(l, t)
}

// Room for a cart on rail cell (tx, ty, tz) coming from (fx, fy, fz): rail, nothing but an item on
// it, and at most a step up or down — a slope, over a layer's edge too.
fn rail_room(l: const Level, fx: integer, fy: integer, fz: integer, tx: integer, ty: integer, tz: integer) -> boolean {
  if !rail(l, tile_world::terrain(l.w, tx, ty, tz)) { return false; }
  t = tile_world::top(l.w, tx, ty, tz);
  if t != 0 && !item(l, t) { return false; }
  d = level_h(l, tx, ty, tz) - level_h(l, fx, fy, fz);
  d >= -1 && d <= 1
}

// Can a line of n things from (x, y), each moving one step (dx, dy), cross every edge on the way.
fn crosses(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer, n: integer) -> boolean {
  for k in 0..n {
    if !tile_world::crossable(l.w, x + k * dx, y + k * dy, z, dx, dy) { return false; }
  }
  true
}



// The climb between layers, or null when this step is not one.
/// Can the hero go from height `from` to height `to`, both counted from the same floor: up at
/// most one step, down less than a full layer?
pub fn reach(l: const Level, from: integer, to: integer) -> boolean {
  to <= from + 1 && from - to < l.k.layer_height
}

fn climb(l: Level, dx: integer, dy: integer) -> Step? {
  tx = l.hero_x + dx;
  ty = l.hero_y + dy;
  z = l.hero_z;
  up = l.k.layer_height;
  // Up: onto the floor of the layer above, beside the hero, a layer's height plus that cell's
  // rise — never up through a ceiling.
  if walkable(l, tile_world::terrain(l.w, tx, ty, z + 1)) && tile_world::top(l.w, tx, ty, z + 1) == 0
      && tile_world::terrain(l.w, l.hero_x, l.hero_y, z + 1) == VOID
      && hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) && hero_crosses(l, l.hero_x, l.hero_y, z + 1, dx, dy)
      && reach(l, l.hero_h, up + tile_world::rise(l.w, tx, ty, z + 1)) {
    arrive(l, tx, ty, z + 1);
    return Step.Climbed;
  }
  // Down: into the void beside, onto the first cell below that is not void — a floor, a rise, a
  // thing the hero can stand on, some layers down.  Less than a layer is a step down; a layer or
  // more is a fall.
  if tile_world::terrain(l.w, tx, ty, z) == VOID && hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) {
    bottom = lowest_layer(l);
    zb = z - 1;
    while zb >= bottom && tile_world::terrain(l.w, tx, ty, zb) == VOID { zb -= 1; }
    if zb < bottom || !walkable(l, tile_world::terrain(l.w, tx, ty, zb)) { return null; }
    if zb == z - 1 && !hero_crosses(l, l.hero_x, l.hero_y, zb, dx, dy) { return null; }
    t = tile_world::top(l.w, tx, ty, zb);
    if t != 0 && !standable(l, t) && !item(l, t) { return null; }
    from = (z - zb) * up + l.hero_h;
    to = height(l, tx, ty, zb);
    if to > from + 1 { return null; }
    arrive(l, tx, ty, zb);
    fallen = (from - to) / up ?? 0;
    if fallen == 0 { return Step.Climbed; }
    hurt(l, fallen);
    return Step.Fell;
  }
  null
}

// The lowest layer the level has.
fn lowest_layer(l: const Level) -> integer {
  low = 0;
  first = true;
  for z in tile_world::layers(l.w) {
    if first || z < low { low = z; }
    first = false;
  }
  low
}

// The cost of falling `layers` layers: the kinds' fall_damage for that many, the last entry for
// more.
fn fall_cost(l: const Level, layers: integer) -> integer {
  n = len(l.k.fall_damage);
  if n == 0 { return 0; }
  l.k.fall_damage[if layers < n { layers - 1 } else { n - 1 }] ?? 0
}

// The hero falls `layers` layers and loses that fall's cost, down to no health.
fn hurt(l: Level, layers: integer) {
  harm(l, fall_cost(l, layers));
}

/// The hero is hurt `n`: its temporary health goes first, then its health, down to none.
pub fn harm(l: Level, n: integer) {
  from_spirit = if n < l.spirit { n } else { l.spirit };
  l.spirit -= from_spirit;
  l.health -= n - from_spirit;
  if l.health < 0 { l.health = 0; }
}

/// Has the hero health left to move?
pub fn alive(l: const Level) -> boolean {
  l.health > 0
}

/// Move the hero one cell (dx, dy one of the four directions): walk, push, climb onto a thing,
/// or climb a layer.  The hero stays where it is when the step is Blocked.
pub fn walk(l: Level, dx: integer, dy: integer) -> Step {
  l.queued = false;
  if !alive(l) { return Step.Blocked; }
  l.face_x = dx;
  l.face_y = dy;
  // Riding a rolling cart the hero does not walk: it leans, and the next junction takes it.
  if riding(l) >= 0 {
    l.lean_x = dx;
    l.lean_y = dy;
    return Step.Leaned;
  }
  // Held by a cyclops: walking into it strikes it (below); any other press is a struggle — the
  // struggle_presses-th breaks free, and the step is taken, the cyclops staggered for a blow's time.
  if l.held_by != 0 {
    h = enemy_index(l, l.held_by);
    holder = l.enemies[h] ?? no_enemy();
    if h < 0 || !beside_hero(l, holder) {
      l.held_by = 0;
    } else if l.hero_x + dx != holder.x || l.hero_y + dy != holder.y {
      l.struggles += 1;
      if l.struggles < l.k.struggle_presses { return Step.Struggled; }
      l.held_by = 0;
      l.enemies[h].due = l.now + enemy_props(l, holder.kind).bite_ms;
    }
  }
  // Walking into an enemy strikes it, the hero staying where it is — not a guard (it blocks),
  // nor one up on a wall (out of the sword's reach); one that talks is spoken to.
  foe = enemy_at(l, l.hero_x + dx, l.hero_y + dy, l.hero_z);
  if foe >= 0 && enemy_props(l, (l.enemies[foe] ?? no_enemy()).kind).talks {
    l.face_x = dx;
    l.face_y = dy;
    l.talk_to = (l.enemies[foe] ?? no_enemy()).id;
    l.talked += 1;
    return Step.Talked;
  }
  if foe >= 0 {
    if !reachable_foe(l, foe, dx, dy) { return Step.Blocked; }
    return hero_blow(l, dx, dy, false);
  }
  c = climb(l, dx, dy);
  if c != null { return c ?? Step.Blocked; }
  tx = l.hero_x + dx;
  ty = l.hero_y + dy;
  z = l.hero_z;
  // Mount terrain (a wall), the hero staying where it is: what hangs there is taken with an
  // empty hand; a flame hanging there lights the torch the hero holds, and the flame the hero
  // holds lights the torch hanging there; a mountable thing the hero holds hangs in an empty
  // socket — only in a socket (a thing on a bare wall, from an older level, is still taken).
  if mount_terrain(l, tile_world::terrain(l.w, tx, ty, z)) {
    on = tile_world::top(l.w, tx, ty, z);
    hung = if holds(l, on) { 0 } else { on };
    if hung != 0 && mounts(l, hung) && l.hero_item == 0 {
      l.hero_item = tile_world::take(l.w, tx, ty, z);
      took(l, l.hero_item, tx, ty, z);
      return Step.Took;
    }
    if hung != 0 && is_flame(l, hung) && lit_to(l, l.hero_item) != 0 {
      l.hero_item = lit_to(l, l.hero_item);
      l.hero_until = l.now + l.k.burn_ms;
      return Step.Lit;
    }
    if hung != 0 && is_flame(l, l.hero_item) && lit_to(l, hung) != 0 {
      _ = tile_world::take(l.w, tx, ty, z);
      tile_world::place(l.w, tx, ty, z, lit_to(l, hung));
      set_flame(l, tx, ty, z, l.now + l.k.burn_ms);
      return Step.Lit;
    }
    if hung == 0 && holds(l, on) && l.hero_item != 0 && mounts(l, l.hero_item) {
      tile_world::place(l.w, tx, ty, z, l.hero_item);
      set_down(l, l.hero_item, tx, ty, z, l.hero_until);
      l.hero_item = 0;
      l.hero_until = 0;
      return Step.Placed;
    }
  }
  // An edge between the hero and the cell it steps to: a wall or a window stops it; a fence is
  // climbed over.
  if !hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) { return Step.Blocked; }
  kind = tile_world::terrain(l.w, tx, ty, z);
  // Holding an axe, a tree or a fence takes a blow, and falls at its last; the hero stays where
  // it is.
  felled = chopped_to(l, kind);
  if felled != 0 && holds_chopper(l) { return hero_blow(l, dx, dy, false); }
  // A well saves the situation (the game keeps it); the hero stays where it is.
  here = l.k.terrain[kind];
  if here && here.saves { return if clear_area(l) { Step.Saved } else { Step.Watched }; }
  // A closed door opens; the hero stays where it is.
  open = opens_to(l, kind);
  if open != 0 {
    tile_world::set_terrain(l.w, tx, ty, z, open);
    return Step.Opened;
  }
  if !walkable(l, kind) { return Step.Blocked; }
  // What stands there: an item resting on a big thing is met through the big thing.
  thing = base(l, tx, ty, z);
  // A lever is thrown: every junction beside it is set the other way (its twin picture), and the
  // handle goes over; the hero stays where it is.
  if throw_lever(l, tx, ty, z) { return Step.Switched; }
  // A thing that dips (a tar barrel) turns what the hero holds into what it dips to (a stick,
  // into a torch); the hero stays where it is.
  if dips(l, thing) && dipped_to(l, l.hero_item) != 0 {
    l.hero_item = dipped_to(l, l.hero_item);
    return Step.Dipped;
  }
  // A closed thing (a chest) opens and scores its points; the hero stays where it is.
  opened = thing_opens_to(l, thing);
  if opened != 0 {
    replace_base(l, tx, ty, z, opened);
    p = l.k.things[thing];
    l.points += if p { p.points } else { 0 };
    l.money += if p { p.money } else { 0 };
    return Step.Opened;
  }
  // A thing that tells (a signpost) is read: `closed` answers what it says.
  sign = l.k.things[thing];
  if sign && sign.tells != "" { return Step.Read; }
  if thing == 0 || item(l, thing) {
    // A rise is stepped like a stack: up one at most.
    if !reach(l, l.hero_h, height(l, tx, ty, z)) { return Step.Blocked; }
    // Stairs take the hero to the same cell a layer up or down, when it can stand there; the
    // stairs it lands on do not take it on.
    to = z + stairs(l, kind);
    if to != z && walkable(l, tile_world::terrain(l.w, tx, ty, to)) && tile_world::top(l.w, tx, ty, to) == 0 {
      arrive(l, tx, ty, to);
      return Step.Climbed;
    }
    arrive(l, tx, ty, z);
    return Step.Walked;
  }
  surface = height(l, tx, ty, z);
  base = surface - thing_height(l, thing);
  // A train moves as one, when the hero is strong enough and the cell after it takes it.
  // A train moves along its track (round a bend, off an open end), when the hero is strong
  // enough; one that cannot move is climbed, like a chair (below).
  // The hero pushes standing on the ground (not on a thing), within a step of the cart's base:
  // from below or above on a slope too.
  ground = l.hero_h == tile_world::rise(l.w, l.hero_x, l.hero_y, z);
  if trainlike(l, thing) && ground && reach(l, l.hero_h, base) && reach(l, base, l.hero_h) && !hands_busy(l)
      && push_train(l, tx, ty, z, dx, dy) {
    arrive(l, tx, ty, z);
    return Step.Pushed;
  }
  // Any other movable thing at the hero's own level is pushed, when it can go one cell on.
  if !trainlike(l, thing) && movable(l, thing) && !hands_busy(l) && base == l.hero_h
      && fits(l, thing, tx + dx, ty + dy, z, base)
      && tile_world::crossable(l.w, tx, ty, z, dx, dy) && way_clear(l, tx + dx, ty + dy, z, dx, dy) {
    clear_way(l, tx + dx, ty + dy, z, dx, dy);
    move_base(l, tx, ty, z, tx + dx, ty + dy);
    arrive(l, tx, ty, z);
    return Step.Pushed;
  }
  // Otherwise a thing that can be stood on, no more than one step up, is climbed onto.
  if standable(l, thing) && surface <= l.hero_h + 1 {
    arrive(l, tx, ty, z);
    return Step.Walked;
  }
  Step.Blocked
}

/// Walk one cell and drag the thing behind the hero into the cell it left: a train along the
/// rails, a "push_pull" thing anywhere it fits there — a lifting one up onto a surface the hero
/// stands on, too.  A "push" thing stays.  Pulled when something came along, Walked when
/// nothing did, Blocked when the hero cannot take the step (a plain one, onto a cell no higher
/// than the hero stands).
pub fn pull(l: Level, dx: integer, dy: integer) -> Step {
  l.queued = false;
  if !alive(l) { return Step.Blocked; }
  // Pulling, the hero faces the thing it pulls, behind it.
  l.face_x = -dx;
  l.face_y = -dy;
  fx = l.hero_x;
  fy = l.hero_y;
  z = l.hero_z;
  tx = fx + dx;
  ty = fy + dy;
  bx = fx - dx;
  by = fy - dy;
  bz = z;
  if !hero_crosses(l, fx, fy, z, dx, dy) { return Step.Blocked; }
  // Where the hero goes: on its layer — never up — or down over a layer's edge, into the void
  // beside onto the ground just below it (a slope's top), less than a layer down.
  tz = z;
  if !walkable(l, tile_world::terrain(l.w, tx, ty, z)) {
    if tile_world::terrain(l.w, tx, ty, z) != VOID || !walkable(l, tile_world::terrain(l.w, tx, ty, z - 1)) {
      return Step.Blocked;
    }
    drop_by = z * l.k.layer_height + l.hero_h - ((z - 1) * l.k.layer_height + height(l, tx, ty, z - 1));
    if drop_by < 0 || drop_by >= l.k.layer_height { return Step.Blocked; }
    tz = z - 1;
  } else if height(l, tx, ty, z) > l.hero_h {
    return Step.Blocked;
  }
  target = tile_world::top(l.w, tx, ty, tz);
  if target != 0 && !item(l, target) && !standable(l, target) { return Step.Blocked; }
  // Behind the hero on a track is the rail cell its own joins, other than the way it goes — round
  // a bend too, over a layer's edge too; elsewhere the cell behind it.
  m = joins(l, fx, fy, z) - (joins(l, fx, fy, z) & side_bit(dx, dy));
  if m == 1 || m == 2 || m == 4 || m == 8 {
    bw = bit_way(m);
    nz = rail_next(l, fx, fy, z, bw.0, bw.1);
    if nz != NOWHERE && car(l, fx + bw.0, fy + bw.1, nz) {
      bx = fx + bw.0;
      by = fy + bw.1;
      bz = nz;
    }
  }
  thing = if hands_busy(l) { 0 } else { base(l, bx, by, bz) };
  // The cell the hero leaves: the dragged thing lands on its surface, where the hero stood.
  left = height(l, fx, fy, z);
  base = height(l, bx, by, bz) - thing_height(l, thing);
  if trainlike(l, thing) {
    // The whole train behind follows along its track, one cell each, when the hero can pull it
    // and the cell it leaves is rail the train's track joins.
    // Each car on its own layer: a train can span a layer's edge.
    cars: vector<(integer, integer, integer)> = [];
    cx = bx;
    cy = by;
    cz = bz;
    d = (bx - fx, by - fy);
    while car(l, cx, cy, cz) && len(cars) < 64 {
      cars += [(cx, cy, cz)];
      w = way_on(l, cx, cy, cz, d.0, d.1, false);
      if w.2 != ALONG { break; }
      nz = rail_next(l, cx, cy, cz, w.0, w.1);
      if nz == NOWHERE { break; }
      cx += w.0;
      cy += w.1;
      cz = nz;
      d = (w.0, w.1);
    }
    n = len(cars);
    under = tile_world::top(l.w, fx, fy, z);
    pulled_way = (fx - bx, fy - by);
    rf = tile_world::rise(l.w, fx, fy, z);
    hf = level_h(l, fx, fy, z);
    hb = level_h(l, bx, by, bz);
    can = left == rf && hb - hf <= 1 && hf - hb <= 1 && rolling_at(l, bx, by, bz) < 0
          && (joins(l, fx, fy, z) & side_bit(bx - fx, by - fy)) != 0 && (under == 0 || item(l, under));
    // Up a step (onto the hero's cell, over a layer's edge too) every cart counts twice.
    strong = (if hf > hb { 2 * n } else { n }) <= pull_strength(l);
    arrive(l, tx, ty, tz);
    // An item where the hero stood goes out of the way, once the hero has moved on.
    if !can || !strong || !way_clear(l, fx, fy, z, pulled_way.0, pulled_way.1) { return Step.Walked; }
    clear_way(l, fx, fy, z, pulled_way.0, pulled_way.1);
    move_base_to(l, bx, by, bz, fx, fy, z);
    for k in 1..n {
      c = cars[k] ?? (bx, by, bz);
      t = cars[k - 1] ?? (bx, by, bz);
      move_base_to(l, c.0, c.1, c.2, t.0, t.1, t.2);
    }
    return Step.Pulled;
  }
  ok = false;
  if thing != 0 && pullable(l, thing) {
    // Level, or — for a lifting thing — up or down at most two steps, onto the floor or a
    // surface's top.
    lift = left - base;
    reach = if lifts(l, thing) { 2 } else { 0 };
    ok = lift >= -reach && lift <= reach
         && (left == 0 || surface_kind(l, tile_world::top(l.w, fx, fy, z)))
         && !blocks_things(l, tile_world::terrain(l.w, fx, fy, z))
         && tile_world::crossable(l.w, bx, by, z, dx, dy) && bz == z;
  }
  arrive(l, tx, ty, tz);
  if !ok || !way_clear(l, fx, fy, z, dx, dy) { return Step.Walked; }
  clear_way(l, fx, fy, z, dx, dy);
  move_base(l, bx, by, z, fx, fy);
  Step.Pulled
}

// --- Playing ---

/// Play a line of moves: `w` `a` `s` `d` walk north, west, south and east; `pw` `pa` `ps` `pd`
/// pull; `x` puts down what the hero holds; `f` uses it (shoots a bow, throws a bomb, swings a
/// weapon); `~N` lets N ms of the world clock pass.  Moves are separated by spaces; anything else
/// is skipped.  Answers how many moves were not Blocked.
pub fn play(l: Level, moves: text) -> integer {
  done = 0;
  for m in moves.split(' ') {
    t = m.trim();
    if t == "x" {
      if drop(l) != Step.Blocked { done += 1; }
      continue;
    }
    // `~N`: N ms of the world clock pass (rolling, burning, enemies acting).
    if t.starts_with("~") {
      tick(l, t[1..] as integer ?? 0);
      continue;
    }
    // `f`: use what the hero holds — shoot a bow, throw a bomb, swing a weapon.
    if t == "f" {
      st = if armed_with_bow(l) { shoot(l) } else if is_bomb(l, l.hero_item) { throw(l) } else { swing(l) };
      if st != Step.Blocked { done += 1; }
      continue;
    }
    pulling = t.starts_with("p");
    d = if pulling { t[1..] } else { t };
    dx = if d == "a" { -1 } else if d == "d" { 1 } else { 0 };
    dy = if d == "w" { -1 } else if d == "s" { 1 } else { 0 };
    if dx == 0 && dy == 0 { continue; }
    step = if pulling { pull(l, dx, dy) } else { walk(l, dx, dy) };
    if step != Step.Blocked { done += 1; }
  }
  done
}

// --- Goals ---

/// Is the hero out in the open, under the sky?
pub fn in_daylight(l: const Level) -> boolean {
  tile_world::open_sky(l.w, l.hero_x, l.hero_y, l.hero_z)
    && tile_world::terrain(l.w, l.hero_x, l.hero_y, l.hero_z) != VOID
}

// --- Rolling carts ---
//
// A cart stands still on the flat; where its track leads one step down, it starts to roll by itself
// (on the level's clock: at speed n a cell every roll_ms / n).  Each step down adds one to its speed,
// up to max_speed; each step up takes two; on the flat it loses one every `coast` cells; at none it
// stops (and on a slope rolls back down).  A rolling train goes along its track like a pushed one —
// round bends, the junction's setting or the riding hero's lean, off an open end (derailing) — and
// what it meets decides the rest: a cart links on, sharing the speed by weight; light items are
// shoved out of the way; the hero is hurt by the speed and pushed aside (the side its place prefers,
// then the other), or with no room taken on board; anything else stops it.

// The rolling train with a cart on (x, y, z), -1 for none.
fn rolling_at(l: const Level, x: integer, y: integer, z: integer) -> integer {
  for i in 0..len(l.rolls) {
    for c in l.rolls[i].cells ?? [] { if c.0 == x && c.1 == y && c.2 == z { return i; } }
  }
  -1
}

/// The rolling train the hero rides (standing on one of its carts), -1 for none.
pub fn riding(l: const Level) -> integer {
  i = rolling_at(l, l.hero_x, l.hero_y, l.hero_z);
  if i < 0 { return -1; }
  if l.hero_h != height(l, l.hero_x, l.hero_y, l.hero_z) { return -1; }
  i
}

// The carts behind the cart on (x, y, z) along its track, away from the way (dx, dy): the train it
// leads, front first.
fn train_behind(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer)
    -> vector<(integer, integer, integer)> {
  out: vector<(integer, integer, integer)> = [(x, y, z)];
  cx = x;
  cy = y;
  cz = z;
  ax = dx;
  ay = dy;
  while len(out) < 64 {
    m = joins(l, cx, cy, cz) - (joins(l, cx, cy, cz) & side_bit(ax, ay));
    found = false;
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if found || (m & side_bit(d.0, d.1)) == 0 { continue; }
      nz = rail_next(l, cx, cy, cz, d.0, d.1);
      if nz == NOWHERE { continue; }
      if car(l, cx + d.0, cy + d.1, nz) && rolling_at(l, cx + d.0, cy + d.1, nz) < 0 {
        cx += d.0;
        cy += d.1;
        cz = nz;
        out += [(cx, cy, cz)];
        ax = -d.0;
        ay = -d.1;
        found = true;
      }
    }
    if !found { return out; }
  }
  out
}

// Every standing cart whose track leads a step down starts its train rolling that way.
fn start_rolls(l: Level) {
  for c in tile_world::stacks(l.w) {
    if !car(l, c.0, c.1, c.2) || rolling_at(l, c.0, c.1, c.2) >= 0 { continue; }
    here = level_h(l, c.0, c.1, c.2);
    m = joins(l, c.0, c.1, c.2);
    started = false;
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if started || (m & side_bit(d.0, d.1)) == 0 { continue; }
      nz = rail_next(l, c.0, c.1, c.2, d.0, d.1);
      if nz == NOWHERE { continue; }
      nx = c.0 + d.0;
      ny = c.1 + d.1;
      if level_h(l, nx, ny, nz) != here - 1 || !rail_room(l, c.0, c.1, c.2, nx, ny, nz) { continue; }
      l.rolls += [Roll { cells: train_behind(l, c.0, c.1, c.2, d.0, d.1), dx: d.0, dy: d.1, speed: 1,
                         due: l.now + l.k.roll_ms, flat: 0 }];
      started = true;
    }
  }
}

// Move every train whose time has come, the earliest first, as often as its speed allows.
fn roll_due(l: Level) {
  guard = 0;
  while guard < 1000 {
    guard += 1;
    first = -1;
    for i in 0..len(l.rolls) {
      d = l.rolls[i].due ?? 0;
      if d <= l.now && (first < 0 || d < (l.rolls[first].due ?? 0)) { first = i; }
    }
    if first < 0 { return; }
    roll_step(l, first);
  }
}

// Train ri stops: it is a standing train again.
fn stop_roll(l: Level, ri: integer) {
  _ = l.rolls.remove(ri);
  if riding(l) < 0 {
    l.lean_x = 0;
    l.lean_y = 0;
  }
}

// The way the hero is pushed aside from (x, y, z) by a train coming (dx, dy): the side the place
// prefers, then the other; (0, 0) with no room either side.
fn shove_aside(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> (integer, integer) {
  first = if prefers_right(x, y, z) { (-dy, dx) } else { (dy, -dx) };
  for d in [first, (-first.0, -first.1)] {
    nx = x + d.0;
    ny = y + d.1;
    k = tile_world::terrain(l.w, nx, ny, z);
    t = tile_world::top(l.w, nx, ny, z);
    if walkable(l, k) && tile_world::crossable(l.w, x, y, z, d.0, d.1) && (t == 0 || item(l, t))
        && height(l, nx, ny, z) == tile_world::rise(l.w, x, y, z) {
      return d;
    }
  }
  (0, 0)
}

// One cell on for rolling train ri.
fn roll_step(l: Level, ri: integer) {
  // The train's facts as plain values first: link and stop change l.rolls.
  cells: vector<(integer, integer, integer)> = [];
  for c in l.rolls[ri].cells ?? [] { cc = c; cells += [cc]; }
  dx = l.rolls[ri].dx ?? 0;
  dy = l.rolls[ri].dy ?? 0;
  speed = l.rolls[ri].speed ?? 0;
  due = l.rolls[ri].due ?? l.now;
  n = len(cells);
  front = cells[0] ?? (0, 0, 0);
  fz = front.2;
  rider = -1;
  if riding(l) == ri {
    for i in 0..n {
      c = cells[i] ?? (0, 0, 0);
      if c.0 == l.hero_x && c.1 == l.hero_y && c.2 == l.hero_z { rider = i; }
    }
  }
  lean = if rider >= 0 { (l.lean_x, l.lean_y) } else { (0, 0) };
  jw = junction_way(l, front.0, front.1, fz, dx, dy);
  // As for a pushed cart: a train starting from a track's end leaves by its one side.
  w = way_on(l, front.0, front.1, fz, dx, dy, true, lean);
  if (jw.0 != 0 || jw.1 != 0) && rider >= 0 {
    l.lean_x = 0;
    l.lean_y = 0;
  }
  if w.2 == STUCK {
    stop_roll(l, ri);
    return;
  }
  nx = front.0 + w.0;
  ny = front.1 + w.1;
  if w.2 == DERAILS {
    k = tile_world::terrain(l.w, nx, ny, fz);
    t = tile_world::top(l.w, nx, ny, fz);
    if walkable(l, k) && !blocks_things(l, k) && tile_world::crossable(l.w, front.0, front.1, fz, w.0, w.1)
        && (t == 0 || item(l, t)) && height(l, nx, ny, fz) == tile_world::rise(l.w, front.0, front.1, fz)
        && way_clear(l, nx, ny, fz, w.0, w.1) {
      clear_way(l, nx, ny, fz, w.0, w.1);
      fb = base(l, front.0, front.1, fz);
      move_cars(l, ri, cells, nx, ny, fz, rider);
      p = l.k.things[fb];
      to = if p { thing_id(l.k, p.derails_to) } else { 0 };
      if to != 0 { replace_base(l, nx, ny, fz, to); }
      if rider == 0 { l.hero_h = height(l, nx, ny, fz); }
    }
    stop_roll(l, ri);
    return;
  }
  nz = rail_next(l, front.0, front.1, fz, w.0, w.1);
  if nz == NOWHERE {
    stop_roll(l, ri);
    return;
  }
  // A cart there: the trains link and share the speed by weight.
  if car(l, nx, ny, nz) {
    link(l, ri, nx, ny, nz, w.0, w.1);
    return;
  }
  // The hero in the way: hurt by the speed, pushed aside — or with no room, taken on board.
  if l.hero_x == nx && l.hero_y == ny && l.hero_z == nz && rider < 0 {
    harm(l, speed);
    a = shove_aside(l, nx, ny, nz, w.0, w.1);
    if a.0 != 0 || a.1 != 0 { arrive(l, nx + a.0, ny + a.1, nz); }
  }
  if !rail_room(l, front.0, front.1, fz, nx, ny, nz) || !way_clear(l, nx, ny, nz, w.0, w.1) {
    stop_roll(l, ri);
    return;
  }
  clear_way(l, nx, ny, nz, w.0, w.1);
  passenger = l.hero_x == nx && l.hero_y == ny && l.hero_z == nz;
  drop = level_h(l, front.0, front.1, fz) - level_h(l, nx, ny, nz);
  move_cars(l, ri, cells, nx, ny, nz, rider);
  if passenger { l.hero_h = height(l, nx, ny, nz); }
  l.rolled += 1;
  sp = speed;
  fl = l.rolls[ri].flat ?? 0;
  if drop > 0 {
    sp = if sp + 1 > l.k.max_speed { l.k.max_speed } else { sp + 1 };
    fl = 0;
  } else if drop < 0 {
    sp -= 2;
    fl = 0;
  } else {
    fl += 1;
    if fl >= l.k.coast {
      sp -= 1;
      fl = 0;
    }
  }
  if sp <= 0 {
    stop_roll(l, ri);
    return;
  }
  l.rolls[ri].dx = w.0;
  l.rolls[ri].dy = w.1;
  l.rolls[ri].speed = sp;
  l.rolls[ri].flat = fl;
  // From when this move was due, not from now: a tick that covers several moves (a slow frame)
  // must give the same path as many small ones — the game is deterministic.
  l.rolls[ri].due = due + cell_ms(l, sp);
}

// Move the carts of rolling train ri (its cells `old`, front first) one cell on: its front to
// (nx, ny, nz), each other cart into the cell of the one before it; the hero riding cart `rider`
// moves with it, from layer to layer too.
fn move_cars(l: Level, ri: integer, old: const vector<(integer, integer, integer)>, nx: integer, ny: integer,
             nz: integer, rider: integer) {
  n = len(old);
  front = old[0] ?? (0, 0, 0);
  move_base_to(l, front.0, front.1, front.2, nx, ny, nz);
  for i in 1..n {
    c = old[i] ?? (0, 0, 0);
    t = old[i - 1] ?? (0, 0, 0);
    move_base_to(l, c.0, c.1, c.2, t.0, t.1, t.2);
  }
  cells: vector<(integer, integer, integer)> = [(nx, ny, nz)];
  for i in 0..n - 1 { cc = old[i] ?? (0, 0, 0); cells += [cc]; }
  l.rolls[ri].cells = cells;
  if rider >= 0 {
    to = cells[rider] ?? (nx, ny, nz);
    l.hero_x = to.0;
    l.hero_y = to.1;
    l.hero_z = to.2;
    l.hero_h = height(l, to.0, to.1, to.2);
  }
}

// Rolling train ri, moving (dx, dy), meets a cart on (x, y, z): the two link into one train.  A
// standing train is pushed on at the speed shared by weight (n moving at v, m standing:
// v * n / (n + m), rounded down); a train rolling away is caught up (the two speeds shared by
// weight); one rolling at it meets head on (the difference of the two, the heavier way).
fn link(l: Level, ri: integer, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  // The trains' facts as plain values first: every write below changes l.rolls.
  mine: vector<(integer, integer, integer)> = [];
  for c in l.rolls[ri].cells ?? [] { cc = c; mine += [cc]; }
  speed = l.rolls[ri].speed ?? 0;
  due = l.rolls[ri].due ?? l.now;
  n = len(mine);
  oi = rolling_at(l, x, y, z);
  if oi < 0 {
    tw = train_way(l, x, y, z, dx, dy);
    ahead = tw.cells;
    m = len(ahead);
    sp = speed * n / (n + m) ?? 0;
    cells: vector<(integer, integer, integer)> = [];
    k = m - 1;
    while k >= 0 {
      cc = ahead[k] ?? (x, y, z);
      cells += [cc];
      k -= 1;
    }
    for c in mine { cc = c; cells += [cc]; }
    a = ahead[m - 1] ?? (x, y, z);
    b = ahead[m - 2] ?? (x - dx, y - dy, z);
    d = if m >= 2 { (a.0 - b.0, a.1 - b.1) } else { (dx, dy) };
    l.rolls[ri].cells = cells;
    l.rolls[ri].dx = d.0;
    l.rolls[ri].dy = d.1;
    l.rolls[ri].speed = sp;
    l.rolls[ri].flat = 0;
    l.rolls[ri].due = due + cell_ms(l, sp);
    if sp <= 0 { stop_roll(l, ri); }
    return;
  }
  theirs: vector<(integer, integer, integer)> = [];
  for c in l.rolls[oi].cells ?? [] { cc = c; theirs += [cc]; }
  ospeed = l.rolls[oi].speed ?? 0;
  m = len(theirs);
  rear = theirs[m - 1] ?? (0, 0, 0);
  if rear.0 == x && rear.1 == y && rear.2 == z {
    // Caught up: one train, the other's way, the speeds shared by weight.
    sp = (speed * n + ospeed * m) / (n + m) ?? 0;
    cells: vector<(integer, integer, integer)> = [];
    for c in theirs { cc = c; cells += [cc]; }
    for c in mine { cc = c; cells += [cc]; }
    l.rolls[oi].cells = cells;
    l.rolls[oi].speed = sp;
    l.rolls[oi].flat = 0;
    _ = l.rolls.remove(ri);
    return;
  }
  // Head on: the difference, the heavier train's way; even, both stop.
  p = speed * n - ospeed * m;
  if p == 0 {
    j = if ri > oi { ri } else { oi };
    i = if ri > oi { oi } else { ri };
    _ = l.rolls.remove(j);
    _ = l.rolls.remove(i);
    return;
  }
  sp = (if p > 0 { p } else { -p }) / (n + m) ?? 0;
  cells: vector<(integer, integer, integer)> = [];
  if p > 0 {
    k = m - 1;
    while k >= 0 {
      cc = theirs[k] ?? (0, 0, 0);
      cells += [cc];
      k -= 1;
    }
    for c in mine { cc = c; cells += [cc]; }
    l.rolls[ri].cells = cells;
    l.rolls[ri].speed = sp;
    _ = l.rolls.remove(oi);
  } else {
    for c in theirs { cc = c; cells += [cc]; }
    k = n - 1;
    while k >= 0 {
      cc = mine[k] ?? (0, 0, 0);
      cells += [cc];
      k -= 1;
    }
    l.rolls[oi].cells = cells;
    l.rolls[oi].speed = sp;
    _ = l.rolls.remove(ri);
  }
}

// --- Bombs ---
//
// A bomb is the one thing that rolls (owner): thrown, it rolls straight on; on a slope it starts
// rolling downhill by itself, faster down and slower up as a cart does, and slows on the flat.
// The thrower fuses it (owner): a thrown bomb goes off on impact — hitting something while it
// moves (a wall, a thing, the hero, the ground after a fall), or rolling into water; one that
// comes to rest by itself lies there, not lit.  A bomb nobody fused (rolling down a slope by
// itself) only stops where it hits and sinks in water — but damage sets any bomb off (owner): a
// blast, and a fall of bomb_fall layers or more (proposed 2), wherever it lands.  A blast reaches the cells within blast_radius by the way light spreads (a wall takes it
// and passes none on), d steps from its centre: the hero loses 4 - d health and is pushed away
// 5 - d cells, fragile things within 2 break, bombs within 2 go off ripple_ms later — the hero's
// own in its hands too — and unlit torches in sockets catch fire; in water it puts flames out.

fn is_bomb(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.bomb
}

fn is_water(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.water
}

fn fragile(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.fragile
}

fn doused_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.doused_to == "" { return 0; }
  thing_id(l.k, p.doused_to)
}

fn opaque_kind(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.opaque
}

// The rolling bomb on (x, y, z), -1 for none.
fn bomb_rolling_at(l: const Level, x: integer, y: integer, z: integer) -> integer {
  for i in 0..len(l.bombs) {
    if (l.bombs[i].x ?? 0) == x && (l.bombs[i].y ?? 0) == y && (l.bombs[i].z ?? 0) == z { return i; }
  }
  -1
}

// Is a bomb on (x, y, z) set off already?
fn fused(l: const Level, x: integer, y: integer, z: integer, held: boolean) -> boolean {
  for f in l.fuses {
    if f.held == held && (held || (f.x == x && f.y == y && f.z == z)) { return true; }
  }
  false
}

/// The hero throws the bomb it holds the way it faces: it rolls off from the cell there at
/// throw_speed.  Into water there it goes off at once; over a drop it falls and goes off where it
/// lands.  Blocked when the hero holds no bomb, or the cell there takes nothing (a wall, a thing,
/// a step up of more than one) — a bomb is not thrown into a wall at the hero's feet (proposed).
pub fn throw(l: Level) -> Step {
  l.queued = false;
  if !alive(l) || !is_bomb(l, l.hero_item) { return Step.Blocked; }
  x = l.hero_x;
  y = l.hero_y;
  z = l.hero_z;
  dx = l.face_x;
  dy = l.face_y;
  if !hero_crosses(l, x, y, z, dx, dy) { return Step.Blocked; }
  tx = x + dx;
  ty = y + dy;
  k = tile_world::terrain(l.w, tx, ty, z);
  bomb = l.hero_item;
  if is_water(l, k) {
    l.hero_item = 0;
    explode(l, tx, ty, z, true, l.now);
    return Step.Thrown;
  }
  if k == VOID {
    l.hero_item = 0;
    r = fall(l, tx, ty, z - 1, dx, dy, 0);
    if r.0 == LANDS {
      tile_world::place(l.w, r.1, r.2, r.3, bomb);
      impact(l, r.1, r.2, r.3, l.now);
    }
    return Step.Thrown;
  }
  ground = tile_world::rise(l.w, x, y, z);
  if !walkable(l, k) || blocks_things(l, k) || tile_world::top(l.w, tx, ty, z) != 0
      || height(l, tx, ty, z) > ground + 1 {
    return Step.Blocked;
  }
  l.hero_item = 0;
  roll_out(l, tx, ty, z, dx, dy, bomb);
  Step.Thrown
}

// How long something rolling at `sp` takes per cell: roll_ms / sp.  A speed of 0 or less does
// not roll (its callers stop it); here it counts as the slowest, so a speed from the data that
// is 0 cannot give a roll a missing time.
fn cell_ms(l: const Level, sp: integer) -> integer {
  if sp <= 0 { return l.k.roll_ms; }
  (l.k.roll_ms / sp)!
}

// A thrown bomb set down on (x, y, z), fused, rolling (dx, dy) at the throwing speed.
fn roll_out(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer, bomb: integer) {
  tile_world::place(l.w, x, y, z, bomb);
  sp = l.k.throw_speed;
  l.bombs += [BombRoll { fused: true, x: x, y: y, z: z, dx: dx, dy: dy, speed: sp, due: l.now + cell_ms(l, sp), flat: 0 }];
}

// A bomb lying at rest on a slope starts rolling down it: to the first side (north, east, south,
// west) a step lower that takes it.
fn start_bomb_rolls(l: Level) {
  for c in tile_world::stacks(l.w) {
    if !is_bomb(l, tile_world::top(l.w, c.0, c.1, c.2)) || bomb_rolling_at(l, c.0, c.1, c.2) >= 0 { continue; }
    if fused(l, c.0, c.1, c.2, false) { continue; }
    here = height(l, c.0, c.1, c.2);
    started = false;
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if started || !hero_crosses(l, c.0, c.1, c.2, d.0, d.1) { continue; }
      nx = c.0 + d.0;
      ny = c.1 + d.1;
      k = tile_world::terrain(l.w, nx, ny, c.2);
      if !walkable(l, k) || blocks_things(l, k) || tile_world::top(l.w, nx, ny, c.2) != 0 { continue; }
      if height(l, nx, ny, c.2) != here - 1 { continue; }
      l.bombs += [BombRoll { fused: false, x: c.0, y: c.1, z: c.2, dx: d.0, dy: d.1, speed: 1, due: l.now + l.k.roll_ms, flat: 0 }];
      started = true;
    }
  }
}

// Every rolling bomb and every fuse whose time has come, the earliest first.
fn bombs_due(l: Level) {
  guard = 0;
  while guard < 1000 {
    guard += 1;
    first = -1;
    at = 0;
    for i in 0..len(l.bombs) {
      d = l.bombs[i].due ?? 0;
      if d <= l.now && (first < 0 || d < at) {
        first = i;
        at = d;
      }
    }
    fuse = -1;
    for i in 0..len(l.fuses) {
      d = l.fuses[i].at ?? 0;
      if d <= l.now && (first < 0 && fuse < 0 || d < at) {
        fuse = i;
        first = -1;
        at = d;
      }
    }
    if fuse >= 0 {
      f = l.fuses[fuse] ?? Fuse { x: 0, y: 0, z: 0, held: false, at: 0 };
      fx = f.x;
      fy = f.y;
      fz = f.z;
      held = f.held;
      _ = l.fuses.remove(fuse);
      if held {
        // In the hero's hands: it goes off where the hero stands.
        if is_bomb(l, l.hero_item) {
          l.hero_item = 0;
          explode(l, l.hero_x, l.hero_y, l.hero_z, false, at);
        }
      } else if is_bomb(l, tile_world::top(l.w, fx, fy, fz)) {
        _ = tile_world::take(l.w, fx, fy, fz);
        explode(l, fx, fy, fz, false, at);
      }
    } else if first >= 0 {
      bomb_step(l, first);
    } else {
      return;
    }
  }
}

// The bomb on (x, y, z) hits something `at`: it goes off there.
fn impact(l: Level, x: integer, y: integer, z: integer, at: integer) {
  if is_bomb(l, tile_world::top(l.w, x, y, z)) { _ = tile_world::take(l.w, x, y, z); }
  explode(l, x, y, z, false, at);
}

// Rolling bomb ri one cell on.
fn bomb_step(l: Level, ri: integer) {
  x = l.bombs[ri].x ?? 0;
  y = l.bombs[ri].y ?? 0;
  z = l.bombs[ri].z ?? 0;
  dx = l.bombs[ri].dx ?? 0;
  dy = l.bombs[ri].dy ?? 0;
  speed = l.bombs[ri].speed ?? 1;
  due = l.bombs[ri].due ?? l.now;
  flat = l.bombs[ri].flat ?? 0;
  fused = l.bombs[ri].fused ?? false;
  _ = l.bombs.remove(ri);
  if !is_bomb(l, tile_world::top(l.w, x, y, z)) { return; }
  if !hero_crosses(l, x, y, z, dx, dy) {
    if fused { impact(l, x, y, z, due); }
    return;
  }
  nx = x + dx;
  ny = y + dy;
  k = tile_world::terrain(l.w, nx, ny, z);
  if is_water(l, k) {
    // Into water: fused, it goes off there, throwing the water around; else it sinks.
    _ = tile_world::take(l.w, x, y, z);
    if fused { explode(l, nx, ny, z, true, due); }
    return;
  }
  if k == VOID {
    // Over a drop: it falls, and — fused — goes off where it lands.
    bomb = tile_world::take(l.w, x, y, z);
    r = fall(l, nx, ny, z - 1, dx, dy, 0);
    if r.0 == LANDS {
      tile_world::place(l.w, r.1, r.2, r.3, bomb);
      if fused || z - r.3 >= l.k.bomb_fall { impact(l, r.1, r.2, r.3, due); }
    }
    return;
  }
  here = height(l, x, y, z);
  there = height(l, nx, ny, z);
  hero_there = (l.hero_x == nx && l.hero_y == ny && l.hero_z == z) || enemy_at(l, nx, ny, z) >= 0;
  if hero_there || !walkable(l, k) || blocks_things(l, k) || tile_world::top(l.w, nx, ny, z) != 0 || there > here + 1 {
    // It hits something: fused, it goes off; else it stops there.
    if fused { impact(l, x, y, z, due); }
    return;
  }
  tile_world::place(l.w, nx, ny, z, tile_world::take(l.w, x, y, z));
  sp = speed;
  fl = flat;
  if there < here {
    sp = if sp + 1 > l.k.max_speed { l.k.max_speed } else { sp + 1 };
    fl = 0;
  } else if there > here {
    sp -= 2;
    fl = 0;
  } else {
    fl += 1;
    if fl >= l.k.bomb_coast {
      sp -= 1;
      fl = 0;
    }
  }
  // Slowed to a stop by itself: it lies there, not lit (and rolls back down, on a slope).
  if sp <= 0 { return; }
  l.bombs += [BombRoll { fused: fused, x: nx, y: ny, z: z, dx: dx, dy: dy, speed: sp, due: due + cell_ms(l, sp), flat: fl }];
}

/// The cells a blast centred on (x, y, z) reaches, each with its distance d (0 at the centre):
/// within blast_radius, by the way light spreads — across the edges the hero crosses, a wall (an
/// opaque kind) taking it and passing none on.  Nearest first.
pub fn blast_reach(l: const Level, x: integer, y: integer, z: integer) -> vector<(integer, integer, integer)> {
  out: vector<(integer, integer, integer)> = [(x, y, 0)];
  i = 0;
  while i < len(out) {
    c = out[i] ?? (x, y, 0);
    i += 1;
    if c.2 >= l.k.blast_radius { continue; }
    if c.2 > 0 && opaque_kind(l, tile_world::terrain(l.w, c.0, c.1, z)) { continue; }
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if !hero_crosses(l, c.0, c.1, z, d.0, d.1) && !opaque_kind(l, tile_world::terrain(l.w, c.0 + d.0, c.1 + d.1, z)) {
        continue;
      }
      nx = c.0 + d.0;
      ny = c.1 + d.1;
      seen = false;
      for o in out { if o.0 == nx && o.1 == ny { seen = true; } }
      if !seen { out += [(nx, ny, c.2 + 1)]; }
    }
  }
  out
}

// The way something on (x, y) is pushed from a blast centred on (bx, by): along the axis it lies
// further from the centre on; on an even diagonal the side the place prefers; at the centre
// itself, back from the way it faces (the hero) or as the place prefers.
fn away(l: const Level, bx: integer, by: integer, x: integer, y: integer, z: integer) -> (integer, integer) {
  ax = x - bx;
  ay = y - by;
  mx = if ax < 0 { -ax } else { ax };
  my = if ay < 0 { -ay } else { ay };
  if mx > my { return (if ax > 0 { 1 } else { -1 }, 0); }
  if my > mx { return (0, if ay > 0 { 1 } else { -1 }); }
  if mx == 0 { return (-l.face_x, -l.face_y); }
  if prefers_right(x, y, z) { (if ax > 0 { 1 } else { -1 }, 0) } else { (0, if ay > 0 { 1 } else { -1 }) }
}

// The hero pushed (dx, dy) up to n cells: on, across edges it crosses, onto ground no higher than
// where it stands with nothing on it; over a drop it falls to the floor below and the fall costs
// what a fall costs (a blast pushes the hero over a ledge — owner).
fn blown(l: Level, dx: integer, dy: integer, n: integer) {
  for _ in 0..n {
    x = l.hero_x;
    y = l.hero_y;
    z = l.hero_z;
    if !hero_crosses(l, x, y, z, dx, dy) { return; }
    tx = x + dx;
    ty = y + dy;
    k = tile_world::terrain(l.w, tx, ty, z);
    if k == VOID {
      zb = z - 1;
      bottom = lowest_layer(l);
      while zb >= bottom && tile_world::terrain(l.w, tx, ty, zb) == VOID { zb -= 1; }
      if zb < bottom || !walkable(l, tile_world::terrain(l.w, tx, ty, zb)) { return; }
      arrive(l, tx, ty, zb);
      hurt(l, z - zb);
      return;
    }
    if !walkable(l, k) || tile_world::top(l.w, tx, ty, z) != 0 || height(l, tx, ty, z) > l.hero_h { return; }
    arrive(l, tx, ty, z);
  }
}

// A blast centred on (x, y, z) `at` (in water or not): everything in its reach, farthest first.
// Ordinary enemies that hear it — within hear_blast cells, on its layer — flee it for scare_ms; a
// searching one (a cyclops) goes to search the place for search_ms.
fn explode(l: Level, x: integer, y: integer, z: integer, water: boolean, at: integer) {
  l.blasts += [Blast { x: x, y: y, z: z, at: at, water: water }];
  l.blasted += 1;
  for i in 0..len(l.enemies) {
    e = l.enemies[i];
    p = enemy_props(l, e.kind);
    if e.z != z || p.guard || steps_apart(e.x, e.y, x, y) > l.k.hear_blast { continue; }
    if p.searches {
      search(l, i, x, y, at + l.k.search_ms);
    } else {
      l.enemies[i].scared_until = at + l.k.scare_ms;
      l.enemies[i].scare_x = x;
      l.enemies[i].scare_y = y;
    }
  }
  reach = blast_reach(l, x, y, z);
  n = len(reach);
  hero_d = -1;
  k = n - 1;
  while k >= 0 {
    c = reach[k] ?? (x, y, 0);
    k -= 1;
    cx = c.0;
    cy = c.1;
    d = c.2;
    if l.hero_x == cx && l.hero_y == cy && l.hero_z == z { hero_d = d; }
    foe = enemy_at(l, cx, cy, z);
    if foe >= 0 && !enemy_props(l, (l.enemies[foe] ?? no_enemy()).kind).guard {
      strike_enemy(l, foe, 4 - d);
    }
    t = tile_world::top(l.w, cx, cy, z);
    // Bombs within two go off a ripple later — lying, or rolling.
    if d <= 2 && is_bomb(l, t) && !fused(l, cx, cy, z, false) {
      r = bomb_rolling_at(l, cx, cy, z);
      if r >= 0 { _ = l.bombs.remove(r); }
      l.fuses += [Fuse { x: cx, y: cy, z: z, held: false, at: at + l.k.ripple_ms }];
    }
    // Fragile things within two break, what lay on them staying on the floor.
    if d <= 2 {
      st = tile_world::things(l.w, cx, cy, z);
      if len(st) > 0 && fragile(l, st[0] ?? 0) {
        above: vector<integer> = [];
        while len(tile_world::things(l.w, cx, cy, z)) > 1 { above += [tile_world::take(l.w, cx, cy, z)]; }
        _ = tile_world::take(l.w, cx, cy, z);
        j = len(above) - 1;
        while j >= 0 {
          tile_world::place(l.w, cx, cy, z, above[j] ?? 0);
          j -= 1;
        }
      }
    }
    // Torches: lit in their sockets by a blast; put out by one in water.
    st = tile_world::things(l.w, cx, cy, z);
    for i in 0..len(st) {
      th = st[i] ?? 0;
      if water {
        to = doused_to(l, th);
        if to != 0 && i == len(st) - 1 {
          _ = tile_world::take(l.w, cx, cy, z);
          tile_world::place(l.w, cx, cy, z, to);
          f = flame_at(l, cx, cy, z);
          if f >= 0 { _ = l.flames.remove(f); }
        }
      } else if i > 0 && holds(l, st[i - 1] ?? 0) && i == len(st) - 1 {
        to = lit_to(l, th);
        if to != 0 {
          _ = tile_world::take(l.w, cx, cy, z);
          tile_world::place(l.w, cx, cy, z, to);
          set_flame(l, cx, cy, z, at + l.k.burn_ms);
        }
      }
    }
    // What lies and stands here is thrown away from the blast (not what hangs on a wall).
    if d >= 1 && !opaque_kind(l, tile_world::terrain(l.w, cx, cy, z)) {
      a = away(l, x, y, cx, cy, z);
      blast_moves(l, cx, cy, z, a.0, a.1, d, at);
    }
  }
  if hero_d < 0 { return; }
  // The hero: a bomb it holds goes off a ripple later in its hands; a flame it holds goes out in
  // water; it is hurt 4 - d and pushed away 5 - d cells.
  if hero_d <= 2 && is_bomb(l, l.hero_item) && !fused(l, 0, 0, 0, true) {
    l.fuses += [Fuse { x: 0, y: 0, z: 0, held: true, at: at + l.k.ripple_ms }];
  }
  if water {
    to = doused_to(l, l.hero_item);
    if to != 0 {
      l.hero_item = to;
      l.hero_until = 0;
    }
  }
  harm(l, 4 - hero_d);
  a = away(l, x, y, l.hero_x, l.hero_y, z);
  blown(l, a.0, a.1, 5 - hero_d);
}

// --- What a blast moves ---
//
// Pushed away from the blast, faster the nearer (owner): d steps out, a small item flies 5 - d
// cells (it is light), a big thing that moves slides 3 - d (it resists, owner), a cart rolls off
// along its track at speed 4 - d — or, beside the blast, is blown off its track.

fn big_mover(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  !p.train && p.walk_on == "" && p.move != "none"
}

// The stack on (x, y, z) d steps from a blast, pushed (ax, ay): the items on top fly off first
// (an item resting on a big thing lands ahead of it), then the thing under them moves.
fn blast_moves(l: Level, x: integer, y: integer, z: integer, ax: integer, ay: integer, d: integer, at: integer) {
  guard = 0;
  while guard < 4 && item(l, tile_world::top(l.w, x, y, z)) {
    guard += 1;
    // A bomb the blast set off goes off where it lies: it is not thrown first.
    if is_bomb(l, tile_world::top(l.w, x, y, z)) && fused(l, x, y, z, false) { return; }
    n = len(tile_world::things(l.w, x, y, z));
    fling(l, x, y, z, ax, ay, 5 - d, d);
    if len(tile_world::things(l.w, x, y, z)) == n { return; }
  }
  t = tile_world::top(l.w, x, y, z);
  if t == 0 { return; }
  p = l.k.things[t];
  if trainlike(l, t) {
    if d == 1 { blown_off(l, x, y, z, ax, ay); } else { push_cart(l, x, y, z, ax, ay, 4 - d, at); }
  } else if d == 1 && p && p.rerails_to != "" {
    // A derailed cart beside the blast is pushed as a cart is blown off its rails (owner): the
    // first rail it comes to puts it back on a track.
    blown_off(l, x, y, z, ax, ay);
  } else if big_mover(l, t) {
    slide(l, x, y, z, ax, ay, 3 - d);
  }
}

// The item on top of (x, y, z) flies up to n cells (ax, ay): over other items, stopping before a
// wall, a big thing or the hero; over a drop it falls (landing, rolling off or lost, as a falling
// item does); into water it is lost.  Where it comes down on another item it rolls off beside it.
// A potion within one step shatters.  A flame keeps its time.
fn fling(l: Level, x: integer, y: integer, z: integer, ax: integer, ay: integer, n: integer, d: integer) {
  t = tile_world::top(l.w, x, y, z);
  p = l.k.things[t];
  if d <= 1 && p && p.walk_on == "boost" {
    _ = tile_world::take(l.w, x, y, z);
    return;
  }
  cx = x;
  cy = y;
  for _ in 0..n {
    if !hero_crosses(l, cx, cy, z, ax, ay) { break; }
    nx = cx + ax;
    ny = cy + ay;
    k = tile_world::terrain(l.w, nx, ny, z);
    if k == VOID {
      // Over a drop: it falls from there.
      r = fall(l, nx, ny, z - 1, ax, ay, 0);
      put_item(l, x, y, z, r);
      return;
    }
    if is_water(l, k) {
      put_item(l, x, y, z, (GONE, nx, ny, z));
      return;
    }
    if !walkable(l, k) || blocks_things(l, k) { break; }
    if l.hero_x == nx && l.hero_y == ny && l.hero_z == z { break; }
    o = tile_world::top(l.w, nx, ny, z);
    if o != 0 && !item(l, o) { break; }
    cx = nx;
    cy = ny;
  }
  if cx == x && cy == y { return; }
  o = tile_world::top(l.w, cx, cy, z);
  if o == 0 {
    put_item(l, x, y, z, (LANDS, cx, cy, z));
    return;
  }
  // Coming down on another item: it rolls off beside it, else stops a cell short.
  a = aside(l, cx, cy, z, ax, ay);
  if a.0 != 0 || a.1 != 0 {
    r = landing(l, cx, cy, z, a.0, a.1, false);
    put_item(l, x, y, z, r);
    return;
  }
  if cx - ax != x || cy - ay != y { put_item(l, x, y, z, (LANDS, cx - ax, cy - ay, z)); }
}

// Move the item on top of (x, y, z) to where `r` says it lands (or lose it: GONE), its flame with
// it; a bomb that fell bomb_fall layers or more goes off where it lands.
fn put_item(l: Level, x: integer, y: integer, z: integer, r: (integer, integer, integer, integer)) {
  if r.0 == NO_ROOM { return; }
  t = tile_world::take(l.w, x, y, z);
  i = flame_at(l, x, y, z);
  if r.0 == GONE {
    if i >= 0 { _ = l.flames.remove(i); }
    return;
  }
  tile_world::place(l.w, r.1, r.2, r.3, t);
  if i >= 0 {
    l.flames[i].x = r.1;
    l.flames[i].y = r.2;
    l.flames[i].z = r.3;
  }
  if is_bomb(l, t) && z - r.3 >= l.k.bomb_fall { impact(l, r.1, r.2, r.3, l.now); }
}

// The big thing on (x, y, z) slides up to n cells (ax, ay), over floor at its own height: it
// stops at a wall, an edge, a drop, the hero, another big thing (owner, proposed: it passes
// nothing on); an item in its way is pushed out of it, as by a push.
fn slide(l: Level, x: integer, y: integer, z: integer, ax: integer, ay: integer, n: integer) {
  cx = x;
  cy = y;
  ground = tile_world::rise(l.w, x, y, z);
  for _ in 0..n {
    if !tile_world::crossable(l.w, cx, cy, z, ax, ay) { return; }
    nx = cx + ax;
    ny = cy + ay;
    k = tile_world::terrain(l.w, nx, ny, z);
    if !walkable(l, k) || blocks_things(l, k) || tile_world::rise(l.w, nx, ny, z) != ground { return; }
    if l.hero_x == nx && l.hero_y == ny && l.hero_z == z { return; }
    o = tile_world::top(l.w, nx, ny, z);
    if o != 0 && !item(l, o) { return; }
    if !way_clear(l, nx, ny, z, ax, ay) { return; }
    clear_way(l, nx, ny, z, ax, ay);
    move_base(l, cx, cy, z, nx, ny);
    cx = nx;
    cy = ny;
  }
}

// The cart on (x, y, z), beside a blast: blown off its track (owner), sliding up to two cells
// (ax, ay) whatever way its track runs.  The first rail it comes to catches it — it stays a cart,
// on that track; come to rest on plain floor it lies derailed.  With no room to leave, it stays on
// its track (proposed).  A derailed cart beside a blast slides the same way, and a rail it comes
// to puts it back on that track, a cart again (owner).
fn blown_off(l: Level, x: integer, y: integer, z: integer, ax: integer, ay: integer) {
  if rolling_at(l, x, y, z) >= 0 { return; }
  cx = x;
  cy = y;
  for _ in 0..2 {
    if !tile_world::crossable(l.w, cx, cy, z, ax, ay) { break; }
    nx = cx + ax;
    ny = cy + ay;
    k = tile_world::terrain(l.w, nx, ny, z);
    if !walkable(l, k) || blocks_things(l, k) { break; }
    if height(l, nx, ny, z) != height(l, cx, cy, z) - thing_height(l, base(l, cx, cy, z)) { break; }
    if l.hero_x == nx && l.hero_y == ny && l.hero_z == z { break; }
    o = tile_world::top(l.w, nx, ny, z);
    if o != 0 && !item(l, o) { break; }
    if !way_clear(l, nx, ny, z, ax, ay) { break; }
    clear_way(l, nx, ny, z, ax, ay);
    move_base(l, cx, cy, z, nx, ny);
    cx = nx;
    cy = ny;
    if rail(l, k) {
      p = l.k.things[base(l, cx, cy, z)]?;
      to = if p.rerails_to != "" { thing_id(l.k, p.rerails_to) } else { 0 };
      if to != 0 { replace_base(l, cx, cy, z, to); }
      return;
    }
  }
  if cx == x && cy == y { return; }
  // Off the rails on plain floor: derailed.
  if !rail(l, tile_world::terrain(l.w, cx, cy, z)) {
    p = l.k.things[base(l, cx, cy, z)]?;
    to = if p.derails_to != "" { thing_id(l.k, p.derails_to) } else { 0 };
    if to != 0 { replace_base(l, cx, cy, z, to); }
  }
}

// The cart on (x, y, z), d > 1 from a blast pushing (ax, ay): along its track it rolls off at
// `speed`, the train behind it with it (owner); across its track the rails hold it.
fn push_cart(l: Level, x: integer, y: integer, z: integer, ax: integer, ay: integer, speed: integer, at: integer) {
  if speed <= 0 || rolling_at(l, x, y, z) >= 0 { return; }
  if (joins(l, x, y, z) & side_bit(ax, ay)) == 0 { return; }
  sp = if speed > l.k.max_speed { l.k.max_speed } else { speed };
  l.rolls += [Roll { cells: train_behind(l, x, y, z, ax, ay), dx: ax, dy: ay, speed: sp,
                     due: at + cell_ms(l, sp), flat: 0 }];
}

// --- Enemies ---
//
// They act on the world clock (DESIGN.md § Enemies).  A healthy enemy that sees the hero comes at
// it and bites when beside it; one that does not wanders near its nest.  A hurt one does not fight
// to the death: it goes home by a way that avoids the hero, steps away when it has no such way,
// and only cornered — no way home, no step away — fights on.  At its nest it heals.  The hero
// strikes it by walking into it or swinging at it: a weapon's damage, else 1; a blast strikes it
// 4 - d.  At no health it is bested, gone.

fn enemy_props(l: const Level, kind: text) -> EnemyProps {
  p = l.k.enemies[kind];
  if p { return p ?? EnemyProps { name: kind, hp: 1, bite: 1, move_ms: 600, chase_ms: 350, bite_ms: 900, sight: 5, roam: 3, heal_ms: 4000,
                     flies: false, climbs: false, shuns_light: false, likes_light: false, guard: false,
                     dark_sight: 5, searches: false, calls: 0, brave: false, holds: "", bombs: 0,
                     pulls: false, shoots: false }; }
  EnemyProps { name: kind, hp: 1, bite: 1, move_ms: 600, chase_ms: 350, bite_ms: 900, sight: 5, roam: 3, heal_ms: 4000,
                     flies: false, climbs: false, shuns_light: false, likes_light: false, guard: false,
                     dark_sight: 5, searches: false, calls: 0, brave: false, holds: "", bombs: 0,
                     pulls: false, shoots: false }
}

/// Put an enemy of `kind` on (x, y, z), its nest there; it first acts a wander's step from now.
/// Answers its id.
pub fn add_enemy(l: Level, kind: text, x: integer, y: integer, z: integer) -> integer {
  p = enemy_props(l, kind);
  id = l.next_enemy;
  l.next_enemy += 1;
  l.enemies += [Enemy { id: id, kind: kind, x: x, y: y, z: z, nest_x: x, nest_y: y, nest_z: z, hp: p.hp,
                        due: l.now + p.move_ms, heal_due: 0, steps: 0, face_x: 0, face_y: 1,
                        scared_until: 0, scare_x: 0, scare_y: 0, search_until: 0, search_x: 0, search_y: 0, saw: false,
                        item: 0, bombs: 0 }];
  arm_enemy(l, len(l.enemies) - 1, p.holds);
  id
}

/// Does enemy e hold what its kind holds unless told otherwise (a level file writes it only when not)?
pub fn armed_as_kind(l: const Level, e: const Enemy) -> boolean {
  h = enemy_props(l, e.kind).holds;
  e.item == (if h == "" { 0 } else { th(l, h) })
}

/// Enemy i holds the thing named `name` ("" or "none": nothing); holding bombs, its kind's number.
pub fn arm_enemy(l: Level, i: integer, name: text) {
  e = l.enemies[i] ?? no_enemy();
  t = if name == "" || name == "none" { 0 } else { th(l, name) };
  l.enemies[i].item = t;
  l.enemies[i].bombs = if t != 0 && is_bomb(l, t) { enemy_props(l, e.kind).bombs } else { 0 };
}

/// The enemy on (x, y, z), -1 for none.
pub fn enemy_at(l: const Level, x: integer, y: integer, z: integer) -> integer {
  for i in 0..len(l.enemies) {
    e = l.enemies[i];
    if e.x == x && e.y == y && e.z == z { return i; }
  }
  -1
}

fn steps_apart(x0: integer, y0: integer, x1: integer, y1: integer) -> integer {
  (if x0 > x1 { x0 - x1 } else { x1 - x0 }) + (if y0 > y1 { y0 - y1 } else { y1 - y0 })
}

// Can an enemy of kind p step from (x, y, z) by (dx, dy): across an edge things cross, onto ground
// it walks (water too if it flies, a rough wall if it climbs; at most a step up or down), with
// nothing on it but an item (a bat never onto a flame), no hero and no other enemy.
fn enemy_can(l: const Level, p: const EnemyProps, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  if !tile_world::crossable(l.w, x, y, z, dx, dy) { return false; }
  nx = x + dx;
  ny = y + dy;
  if !enemy_stands(l, p, nx, ny, z) { return false; }
  d = tile_world::rise(l.w, nx, ny, z) - tile_world::rise(l.w, x, y, z);
  d >= -1 && d <= 1
}

// Can an enemy of kind p be on (x, y, z): ground it walks (water too if it flies, a rough wall if
// it climbs), with nothing on it but an item (a bat never a flame), no hero and no other enemy?
fn enemy_stands(l: const Level, p: const EnemyProps, x: integer, y: integer, z: integer) -> boolean {
  k = tile_world::terrain(l.w, x, y, z);
  goes = (walkable(l, k) && !blocks_things(l, k)) || (p.flies && is_water(l, k)) || (p.climbs && rough(l, k));
  if !goes { return false; }
  t = tile_world::top(l.w, x, y, z);
  if t != 0 && !item(l, t) { return false; }
  if p.likes_light && t != 0 && is_flame(l, t) { return false; }
  if l.hero_x == x && l.hero_y == y && l.hero_z == z { return false; }
  enemy_at(l, x, y, z) < 0
}

fn rough(l: const Level, k: integer) -> boolean {
  tp = l.k.terrain[k];
  if tp { return tp.rough; }
  false
}

// The layer a climbing enemy (a spider) can climb to from where it stands, through an opening:
// up (+1), from the rough wall it is on onto what is over it, or down (-1), onto the rough wall
// under it — either way along the wall's face where the space in front of it is open: a cell
// beside the wall, on its layer, that is not a wall and has nothing covering it (the world's
// open sky: no layer set over it).  Never up through a ceiling.  0 for neither.
fn layer_way(l: const Level, p: const EnemyProps, e: const Enemy) -> integer {
  if !p.climbs { return 0; }
  if rough(l, tile_world::terrain(l.w, e.x, e.y, e.z)) && enemy_stands(l, p, e.x, e.y, e.z + 1)
      && opening_beside(l, e.x, e.y, e.z) {
    return 1;
  }
  if rough(l, tile_world::terrain(l.w, e.x, e.y, e.z - 1)) && enemy_stands(l, p, e.x, e.y, e.z - 1)
      && opening_beside(l, e.x, e.y, e.z - 1) {
    return -1;
  }
  0
}

// Is there open space in front of the wall on (x, y, z): a cell beside it, across an edge, that is
// no wall (opaque) and lies under the open sky?
fn opening_beside(l: const Level, x: integer, y: integer, z: integer) -> boolean {
  for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
    k = tile_world::terrain(l.w, x + d.0, y + d.1, z);
    if tile_world::crossable(l.w, x, y, z, d.0, d.1) && !opaque_kind(l, k)
        && tile_world::open_sky(l.w, x + d.0, y + d.1, z) {
      return true;
    }
  }
  false
}

// Enemy i flees the hero's layer by climbing (dz): it settles where it arrives — its nest now.
fn flee_layer(l: Level, i: integer, e: const Enemy, p: const EnemyProps, dz: integer) {
  // (`e` reads the list: its layer is taken before it is written.)
  z = e.z + dz;
  l.enemies[i].z = z;
  l.enemies[i].nest_x = e.x;
  l.enemies[i].nest_y = e.y;
  l.enemies[i].nest_z = z;
  l.enemies[i].steps = e.steps + 1;
  l.enemies[i].heal_due = 0;
  l.enemies[i].due = e.due + p.chase_ms;
}

/// The light round an enemy: the shades of the cells within `r` of (x, y) on layer z.
struct Shades {
  x0: integer,
  y0: integer,
  w: integer,
  v: vector<integer>
}

fn shades_round(l: const Level, x: integer, y: integer, z: integer, r: integer) -> Shades {
  Shades { x0: x - r, y0: y - r, w: 2 * r + 1,
           v: tile_world::shades(l.w, x - r, y - r, x + r, y + r, z, lights(l, z), light_starts(l, z)) }
}

fn no_shades() -> Shades {
  Shades { x0: 0, y0: 0, w: 0, v: [] }
}

// The shade of (x, y): DARKEST outside the window.
fn shade_at(s: const Shades, x: integer, y: integer) -> integer {
  if s.w == 0 || x < s.x0 || y < s.y0 || x >= s.x0 + s.w || y >= s.y0 + s.w { return 99; }
  s.v[(y - s.y0) * s.w + (x - s.x0)] ?? 99
}

// Is (x, y) lit, as a light-shunning enemy sees it: shade 2 or less.
fn lit_cell(s: const Shades, x: integer, y: integer) -> boolean {
  shade_at(s, x, y) <= 2
}

// The first step of the shortest way an enemy of kind p on (x, y, z) can walk to (gx, gy), and the
// way's length: neighbours tried north, east, south, west, so the way is always the same one.  The
// goal itself need not be enterable (the hero's cell).  With `avoid`, no cell of the way is beside
// the hero; with `dark`'s cells, none of it is lit.  (0, 0, -1) when there is none within 32 steps.
fn enemy_way(l: const Level, p: const EnemyProps, x: integer, y: integer, z: integer, gx: integer, gy: integer,
             avoid: boolean, dark: const Shades) -> (integer, integer, integer) {
  if x == gx && y == gy { return (0, 0, 0); }
  cells: vector<(integer, integer, integer)> = [(x, y, -1)];
  i = 0;
  while i < len(cells) && i < 2000 {
    c = cells[i] ?? (x, y, -1);
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      nx = c.0 + d.0;
      ny = c.1 + d.1;
      seen = false;
      for o in cells { if o.0 == nx && o.1 == ny { seen = true; } }
      if seen { continue; }
      goal = nx == gx && ny == gy;
      if goal {
        if !tile_world::crossable(l.w, c.0, c.1, z, d.0, d.1) { continue; }
      } else {
        if !enemy_can(l, p, c.0, c.1, z, d.0, d.1) { continue; }
        if avoid && steps_apart(nx, ny, l.hero_x, l.hero_y) <= 1 && l.hero_z == z { continue; }
        if lit_cell(dark, nx, ny) { continue; }
      }
      cells += [(nx, ny, i)];
      if goal {
        j = len(cells) - 1;
        n = 0;
        while (cells[j] ?? (x, y, -1)).2 > 0 {
          j = (cells[j] ?? (x, y, 0)).2;
          n += 1;
        }
        f = cells[j] ?? (x, y, -1);
        return (f.0 - x, f.1 - y, n + 1);
      }
    }
    i += 1;
    if steps_apart(c.0, c.1, x, y) > 32 { break; }
  }
  (0, 0, -1)
}

// The way an enemy takes to (gx, gy): a light-shunning one in the dark keeps to it — a dark way,
// when there is one at most twice as long as the shortest; else, when it has to (going home hurt),
// the shortest, lit or not; else none.  Standing in light already (daylight, a torch beside it),
// it has nothing to shun.  Any other enemy, the shortest.
fn chosen_way(l: const Level, p: const EnemyProps, e: const Enemy, gx: integer, gy: integer, avoid: boolean,
              has_to: boolean) -> (integer, integer, integer) {
  w = enemy_way(l, p, e.x, e.y, e.z, gx, gy, avoid, no_shades());
  if !p.shuns_light || w.2 <= 0 { return w; }
  s = shades_round(l, e.x, e.y, e.z, 12);
  if lit_cell(s, e.x, e.y) { return w; }
  dw = enemy_way(l, p, e.x, e.y, e.z, gx, gy, avoid, s);
  if dw.2 > 0 && dw.2 <= 2 * w.2 { return dw; }
  if has_to { w } else { (0, 0, -1) }
}

// For an enemy standing in light: the first step of the shortest way to a dark cell (shade 3 or
// more) within 4 steps, and its length; (0, 0, -1) when it stands in the dark already, or no dark
// is that near (daylight).
fn way_to_dark(l: const Level, p: const EnemyProps, e: const Enemy) -> (integer, integer, integer) {
  s = shades_round(l, e.x, e.y, e.z, 6);
  if !lit_cell(s, e.x, e.y) { return (0, 0, -1); }
  cells: vector<(integer, integer, integer, integer)> = [(e.x, e.y, -1, 0)];
  i = 0;
  while i < len(cells) {
    c = cells[i] ?? (e.x, e.y, -1, 0);
    if c.3 >= 4 { i += 1; continue; }
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      nx = c.0 + d.0;
      ny = c.1 + d.1;
      seen = false;
      for o in cells { if o.0 == nx && o.1 == ny { seen = true; } }
      if seen || !enemy_can(l, p, c.0, c.1, e.z, d.0, d.1) { continue; }
      cells += [(nx, ny, i, c.3 + 1)];
      if !lit_cell(s, nx, ny) {
        j = len(cells) - 1;
        while (cells[j] ?? (e.x, e.y, -1, 0)).2 > 0 { j = (cells[j] ?? (e.x, e.y, 0, 0)).2; }
        f = cells[j] ?? (e.x, e.y, -1, 0);
        return (f.0 - e.x, f.1 - e.y, c.3 + 1);
      }
    }
    i += 1;
  }
  (0, 0, -1)
}

// Does enemy e see the hero: on its layer, within its sight, nothing opaque between?
// The index of the enemy with id `id`, -1 when it is gone.
fn enemy_index(l: const Level, id: integer) -> integer {
  for i in 0..len(l.enemies) {
    if (l.enemies[i] ?? no_enemy()).id == id { return i; }
  }
  -1
}

// The hero in line with enemy e (its row or its column), between throw_near and its sight away,
// with the way to it clear for a rolling bomb: (dx, dy) to throw, (0, 0) when not.  A bomb thrown
// nearer would reach the thrower in its blast.
fn bomb_line(l: const Level, e: const Enemy, sight: integer) -> (integer, integer) {
  if e.z != l.hero_z || (e.x != l.hero_x && e.y != l.hero_y) { return (0, 0); }
  n = steps_apart(e.x, e.y, l.hero_x, l.hero_y);
  if n < l.k.blast_radius + 2 || n > sight { return (0, 0); }
  dx = if l.hero_x > e.x { 1 } else if l.hero_x < e.x { -1 } else { 0 };
  dy = if l.hero_y > e.y { 1 } else if l.hero_y < e.y { -1 } else { 0 };
  for k in 0..n - 1 {
    x = e.x + k * dx;
    y = e.y + k * dy;
    tx = x + dx;
    ty = y + dy;
    kind = tile_world::terrain(l.w, tx, ty, e.z);
    if !tile_world::crossable(l.w, x, y, e.z, dx, dy) || !walkable(l, kind) || blocks_things(l, kind)
        || tile_world::top(l.w, tx, ty, e.z) != 0 || enemy_at(l, tx, ty, e.z) >= 0
        || height(l, tx, ty, e.z) > height(l, x, y, e.z) + 1 {
      return (0, 0);
    }
  }
  (dx, dy)
}

// Enemy i throws a bomb (dx, dy): fused, rolling at the hero; one fewer left, none left its hands
// are empty.
fn hurl(l: Level, i: integer, e: const Enemy, p: const EnemyProps, dx: integer, dy: integer) {
  roll_out(l, e.x + dx, e.y + dy, e.z, dx, dy, e.item);
  l.hurled += 1;
  left = e.bombs - 1;
  l.enemies[i].bombs = left;
  if left <= 0 { l.enemies[i].item = 0; }
  l.enemies[i].face_x = dx;
  l.enemies[i].face_y = dy;
  l.enemies[i].due = e.due + p.bite_ms;
}

// Enemy i, holding the hero: a step towards its nest by the shortest way, the hero pulled into the
// cell it leaves — so only where the enemy itself walks, never over a ledge.  At its nest, or with
// no way, it holds on.  The hero no longer beside it (flung, fallen) is free.
fn pull_hero(l: Level, i: integer, e: const Enemy, p: const EnemyProps) {
  if !beside_hero(l, e) || !alive(l) {
    l.held_by = 0;
    l.enemies[i].due = e.due + p.chase_ms;
    return;
  }
  w = enemy_way(l, p, e.x, e.y, e.z, e.nest_x, e.nest_y, false, no_shades());
  if w.2 > 1 || (w.2 == 1 && enemy_can(l, p, e.x, e.y, e.z, w.0, w.1)) {
    x = e.x;
    y = e.y;
    enemy_step(l, i, w.0, w.1, p.move_ms);
    l.face_x = w.0;
    l.face_y = w.1;
    arrive(l, x, y, e.z);
    return;
  }
  l.enemies[i].due = e.due + p.move_ms;
}

// Does enemy e see (x, y) on its layer, as its kind sees: within `sight` in line of sight, lit
// (shade 2 or less) or within `dark_sight`.
fn sees_cell(l: const Level, e: const Enemy, p: const EnemyProps, x: integer, y: integer) -> boolean {
  n = steps_apart(e.x, e.y, x, y);
  if n > p.sight || !tile_world::line_of_sight(l.w, e.x, e.y, x, y, e.z) { return false; }
  p.dark_sight >= p.sight || n <= p.dark_sight || lit_cell(shades_round(l, x, y, e.z, 0), x, y)
}

// The way (dx, dy) enemy e's arrow would fly to strike (x, y) — the hero or an enemy there — in its
// row or column, within an arrow's range, meeting nothing before it; (0, 0) when it would not.
fn arrow_line(l: const Level, e: const Enemy, x: integer, y: integer) -> (integer, integer) {
  if (e.x != x && e.y != y) || (e.x == x && e.y == y) { return (0, 0); }
  n = steps_apart(e.x, e.y, x, y);
  if n > l.k.arrow_range { return (0, 0); }
  dx = if x > e.x { 1 } else if x < e.x { -1 } else { 0 };
  dy = if y > e.y { 1 } else if y < e.y { -1 } else { 0 };
  cx = e.x;
  cy = e.y;
  for k in 0..n {
    if !tile_world::see_through(l.w, cx, cy, e.z, dx, dy) { return (0, 0); }
    cx += dx;
    cy += dy;
    if k < n - 1 && arrow_meets(l, cx, cy, e.z, e.id) != 0 { return (0, 0); }
  }
  (dx, dy)
}

// Enemy i looses an arrow (dx, dy); it shoots again a bite's time later.
fn loose(l: Level, i: integer, e: const Enemy, p: const EnemyProps, dx: integer, dy: integer) {
  l.shots += [Shot { x: e.x, y: e.y, z: e.z, dx: dx, dy: dy, cells: 0, at: e.due, due: e.due + l.k.arrow_ms,
                     done: false, by: e.id }];
  if len(l.shots) > 8 { _ = l.shots.remove(0); }
  l.enemies[i].face_x = dx;
  l.enemies[i].face_y = dy;
  l.enemies[i].due = e.due + p.bite_ms;
}

// Does enemy e see the hero, as its kind sees: within `sight` only when the hero stands in light,
// within `dark_sight` in the dark too.
fn sees(l: const Level, e: const Enemy, p: const EnemyProps) -> boolean {
  if !sees_hero(l, e, p.sight) { return false; }
  p.dark_sight >= p.sight || steps_apart(e.x, e.y, l.hero_x, l.hero_y) <= p.dark_sight || hero_lit(l)
}

/// Does the hero stand in light (shade 2 or less: daylight, a flame near, its own torch)?  A
/// cyclops sees it from afar only then.
pub fn hero_lit(l: const Level) -> boolean {
  lit_cell(shades_round(l, l.hero_x, l.hero_y, l.hero_z, 0), l.hero_x, l.hero_y)
}

// Enemy i searches (x, y) until `until`.
fn search(l: Level, i: integer, x: integer, y: integer, until: integer) {
  l.enemies[i].search_x = x;
  l.enemies[i].search_y = y;
  l.enemies[i].search_until = until;
}

// Enemy i, hurt, at its nest: the first time it settles in, then every heal_ms a point back.
fn heal(l: Level, i: integer, e: const Enemy, p: const EnemyProps) {
  if e.heal_due == 0 {
    l.enemies[i].heal_due = e.due + p.heal_ms;
    l.enemies[i].due = e.due + p.heal_ms;
    return;
  }
  hp = e.hp + 1;
  l.enemies[i].hp = hp;
  l.enemies[i].heal_due = if hp < p.hp { e.heal_due + p.heal_ms } else { 0 };
  l.enemies[i].due = if hp < p.hp { e.due + p.heal_ms } else { e.due + p.move_ms };
}

fn sees_hero(l: const Level, e: const Enemy, sight: integer) -> boolean {
  e.z == l.hero_z && alive(l) && steps_apart(e.x, e.y, l.hero_x, l.hero_y) <= sight
    && tile_world::line_of_sight(l.w, e.x, e.y, l.hero_x, l.hero_y, e.z)
}

// Is the hero beside enemy e, across an edge things cross?
fn beside_hero(l: const Level, e: const Enemy) -> boolean {
  e.z == l.hero_z && steps_apart(e.x, e.y, l.hero_x, l.hero_y) == 1
    && tile_world::crossable(l.w, e.x, e.y, e.z, l.hero_x - e.x, l.hero_y - e.y)
}

/// Does the hero see (x, y) on its own layer, as the picture shows it: a straight line from the
/// hero's cell that no wall stops — a wall cell before it, or a wall edge it crosses (owner:
/// only walls; a door, a tree, a thing never does, so nothing pops in and out of view as they
/// move).  A diagonal step sees past a corner when either way round it is open: no wall cell and
/// no wall edge — two walls touching at their corners hide what is past them.
pub fn in_view(l: const Level, x1: integer, y1: integer) -> boolean {
  wall = tr(l, "wall");
  wall_edge = ed(l, "wall");
  z = l.hero_z;
  x0 = l.hero_x;
  y0 = l.hero_y;
  dx = if x1 > x0 { x1 - x0 } else { x0 - x1 };
  dy = if y1 > y0 { y0 - y1 } else { y1 - y0 };
  sx = if x0 < x1 { 1 } else { -1 };
  sy = if y0 < y1 { 1 } else { -1 };
  err = dx + dy;
  x = x0;
  y = y0;
  while x != x1 || y != y1 {
    if (x != x0 || y != y0) && tile_world::terrain(l.w, x, y, z) == wall { return false; }
    e2 = 2 * err;
    mx = e2 >= dy;
    my = e2 <= dx;
    if mx && my {
      // Either way round the corner: its cell no wall, and neither edge on the way.
      round_x = tile_world::terrain(l.w, x + sx, y, z) != wall
                && !walled(l, x, y, z, sx, 0, wall_edge) && !walled(l, x + sx, y, z, 0, sy, wall_edge);
      round_y = tile_world::terrain(l.w, x, y + sy, z) != wall
                && !walled(l, x, y, z, 0, sy, wall_edge) && !walled(l, x, y + sy, z, sx, 0, wall_edge);
      if !round_x && !round_y { return false; }
    } else if mx {
      if walled(l, x, y, z, sx, 0, wall_edge) { return false; }
    } else if my {
      if walled(l, x, y, z, 0, sy, wall_edge) { return false; }
    }
    if mx {
      err += dy;
      x += sx;
    }
    if my {
      err += dx;
      y += sy;
    }
  }
  true
}

// Is the edge stepped across from (x, y, z) by (dx, dy) a wall?
fn walled(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer, wall_edge: integer) -> boolean {
  side = if dx > 0 { tile_world::EAST } else if dx < 0 { tile_world::WEST } else if dy > 0 { tile_world::SOUTH } else { tile_world::NORTH };
  wall_edge != 0 && tile_world::edge(l.w, x, y, z, side) == wall_edge
}

/// Is the area round the hero clear: no enemy (a guard is none) within clear_area cells in sight
/// of it?  A well gives water, and a guard steps aside, only then.
pub fn clear_area(l: const Level) -> boolean {
  for e in l.enemies {
    if enemy_props(l, e.kind).guard || enemy_props(l, e.kind).talks || e.z != l.hero_z { continue; }
    if steps_apart(e.x, e.y, l.hero_x, l.hero_y) <= l.k.clear_area
        && tile_world::line_of_sight(l.w, l.hero_x, l.hero_y, e.x, e.y, e.z) {
      return false;
    }
  }
  true
}

// Every enemy whose time has come, the earliest first.
fn enemies_due(l: Level) {
  guard = 0;
  while guard < 1000 {
    guard += 1;
    first = -1;
    at = 0;
    for i in 0..len(l.enemies) {
      d = l.enemies[i].due ?? 0;
      if d <= l.now && (first < 0 || d < at) {
        first = i;
        at = d;
      }
    }
    if first < 0 { return; }
    enemy_act(l, first);
  }
}

// Enemy i steps (dx, dy) and acts again `wait` later.
fn enemy_step(l: Level, i: integer, dx: integer, dy: integer, wait: integer) {
  l.enemies[i].x = (l.enemies[i].x ?? 0) + dx;
  l.enemies[i].y = (l.enemies[i].y ?? 0) + dy;
  l.enemies[i].face_x = dx;
  l.enemies[i].face_y = dy;
  l.enemies[i].steps = (l.enemies[i].steps ?? 0) + 1;
  l.enemies[i].due = (l.enemies[i].due ?? l.now) + wait;
}

// Enemy i bites the hero beside it.
fn bite(l: Level, i: integer, p: const EnemyProps) {
  harm(l, p.bite);
  l.enemies[i].face_x = l.hero_x - (l.enemies[i].x ?? 0);
  l.enemies[i].face_y = l.hero_y - (l.enemies[i].y ?? 0);
  l.enemies[i].due = (l.enemies[i].due ?? l.now) + p.bite_ms;
}

// A guard: it stands, blocking; with the hero beside it and the area clear it steps aside — to the
// side its place prefers, then the other — and stays there.
fn guard_act(l: Level, i: integer, e: const Enemy, p: const EnemyProps) {
  l.enemies[i].due = e.due + p.move_ms;
  if !beside_hero(l, e) || !clear_area(l) || e.steps > 0 { return; }
  ax = e.x - l.hero_x;
  ay = e.y - l.hero_y;
  first = if prefers_right(e.x, e.y, e.z) { (-ay, ax) } else { (ay, -ax) };
  for d in [first, (-first.0, -first.1)] {
    if enemy_can(l, p, e.x, e.y, e.z, d.0, d.1) {
      enemy_step(l, i, d.0, d.1, p.move_ms);
      return;
    }
  }
}

// Enemy i acts: once, at its due time.
fn enemy_act(l: Level, i: integer) {
  e = l.enemies[i] ?? no_enemy();
  p = enemy_props(l, e.kind);
  if p.guard {
    guard_act(l, i, e, p);
    return;
  }
  // Talking, it stands where it is until the line is said.
  if e.talk_line >= 0 {
    l.enemies[i].due = (if e.talk_until > e.due { e.talk_until } else { e.due }) + p.move_ms;
    return;
  }
  if l.held_by == e.id {
    pull_hero(l, i, e, p);
    return;
  }
  // Hurt or scared with the hero on its layer, a climber flees to another layer when it can
  // (DESIGN.md § Spiders: through openings, never through a ceiling).
  if (e.hp < p.hp || e.due < e.scared_until) && !p.brave && l.hero_z == e.z {
    dz = layer_way(l, p, e);
    if dz != 0 {
      flee_layer(l, i, e, p, dz);
      return;
    }
  }
  // Scared by a blast: it flees the place, as far as it can step.
  if e.due < e.scared_until {
    here = steps_apart(e.x, e.y, e.scare_x, e.scare_y);
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if enemy_can(l, p, e.x, e.y, e.z, d.0, d.1) && steps_apart(e.x + d.0, e.y + d.1, e.scare_x, e.scare_y) > here {
        enemy_step(l, i, d.0, d.1, p.chase_ms);
        return;
      }
    }
    l.enemies[i].due = e.due + p.chase_ms;
    return;
  }
  // Caught in light with dark near (a torch came close): a light-shunning enemy gets out of it,
  // back into the dark.  In daylight, with no dark near, it carries on.
  if p.shuns_light && e.hp == p.hp {
    out = way_to_dark(l, p, e);
    if out.2 > 0 {
      enemy_step(l, i, out.0, out.1, p.chase_ms);
      return;
    }
  }
  home = e.x == e.nest_x && e.y == e.nest_y && e.z == e.nest_z;
  if e.hp < p.hp && !p.brave {
    // Hurt.  Beside the hero with a step away from it, it takes it; at its nest it heals.
    if home && !beside_hero(l, e) {
      heal(l, i, e, p);
      return;
    }
    if !home {
      // Home it has to go: through light, if there is no dark way.
      w = chosen_way(l, p, e, e.nest_x, e.nest_y, true, true);
      if w.2 > 0 {
        enemy_step(l, i, w.0, w.1, p.chase_ms);
        return;
      }
    }
    // No way home that avoids the hero: a step away from it, if there is one.
    here = steps_apart(e.x, e.y, l.hero_x, l.hero_y);
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      if enemy_can(l, p, e.x, e.y, e.z, d.0, d.1) && steps_apart(e.x + d.0, e.y + d.1, l.hero_x, l.hero_y) > here {
        enemy_step(l, i, d.0, d.1, p.chase_ms);
        return;
      }
    }
    // Cornered: it fights.
    if beside_hero(l, e) { bite(l, i, p); } else { l.enemies[i].due = e.due + p.chase_ms; }
    return;
  }
  seen = sees(l, e, p);
  if p.searches {
    // (`e` reads the list: what it saw last time is read before it is written.)
    saw = e.saw;
    l.enemies[i].saw = seen;
    if seen {
      // Seen anew, it shouts; it calls the others of its kind within `calls` cells to the place.
      if !saw { l.spotted += 1; }
      search(l, i, l.hero_x, l.hero_y, e.due + l.k.search_ms);
      for j in 0..len(l.enemies) {
        other = l.enemies[j] ?? no_enemy();
        if j != i && other.z == e.z && enemy_props(l, other.kind).searches
            && steps_apart(other.x, other.y, e.x, e.y) <= p.calls {
          search(l, j, l.hero_x, l.hero_y, e.due + l.k.search_ms);
        }
      }
    }
  }
  if seen {
    if beside_hero(l, e) {
      // With no weapon in hand (nothing, or bombs) a cyclops grabs the hero, to pull it home.
      if p.pulls && (e.item == 0 || is_bomb(l, e.item)) && l.held_by == 0 {
        l.held_by = e.id;
        l.struggles = 0;
        l.enemies[i].face_x = l.hero_x - e.x;
        l.enemies[i].face_y = l.hero_y - e.y;
        l.enemies[i].due = e.due + p.move_ms;
        return;
      }
      bite(l, i, p);
      return;
    }
    // A hunter with the hero in line and the arrow's way clear shoots.
    if p.shoots {
      a = arrow_line(l, e, l.hero_x, l.hero_y);
      if a.0 != 0 || a.1 != 0 {
        loose(l, i, e, p, a.0, a.1);
        return;
      }
    }
    // Holding bombs, with the hero in line and the way clear, it throws one.
    if e.item != 0 && is_bomb(l, e.item) {
      b = bomb_line(l, e, p.sight);
      if b.0 != 0 || b.1 != 0 {
        hurl(l, i, e, p, b.0, b.1);
        return;
      }
    }
    // It comes at the hero — a light-shunning one only by a dark way.
    w = chosen_way(l, p, e, l.hero_x, l.hero_y, false, false);
    if w.2 > 1 {
      enemy_step(l, i, w.0, w.1, p.chase_ms);
      return;
    }
  }
  // A hunter not seeing the hero hunts the nearest other enemy it sees (not a guard, not one of
  // its kind): in line it shoots, else it goes after it — a hurt one, fleeing home, leads it there.
  if p.shoots {
    prey = -1;
    best = 0;
    for j in 0..len(l.enemies) {
      cand = l.enemies[j] ?? no_enemy();
      if j == i || cand.z != e.z || cand.kind == e.kind || enemy_props(l, cand.kind).guard { continue; }
      n = steps_apart(e.x, e.y, cand.x, cand.y);
      if sees_cell(l, e, p, cand.x, cand.y) && (prey < 0 || n < best) {
        prey = j;
        best = n;
      }
    }
    if prey >= 0 {
      pe = l.enemies[prey] ?? no_enemy();
      a = arrow_line(l, e, pe.x, pe.y);
      if a.0 != 0 || a.1 != 0 {
        loose(l, i, e, p, a.0, a.1);
        return;
      }
      w = enemy_way(l, p, e.x, e.y, e.z, pe.x, pe.y, false, no_shades());
      if w.2 > 1 {
        enemy_step(l, i, w.0, w.1, p.chase_ms);
        return;
      }
    }
  }
  // Searching (a cyclops): to the place, by the shortest way; there it stands looking until its
  // search ends.
  if p.searches && e.due < e.search_until {
    if e.x != e.search_x || e.y != e.search_y {
      w = enemy_way(l, p, e.x, e.y, e.z, e.search_x, e.search_y, false, no_shades());
      if w.2 > 1 || (w.2 == 1 && enemy_can(l, p, e.x, e.y, e.z, w.0, w.1)) {
        enemy_step(l, i, w.0, w.1, p.chase_ms);
        return;
      }
    }
    l.enemies[i].due = e.due + p.move_ms;
    return;
  }
  // Brave and hurt, with nothing to search: home, to heal.
  if p.brave && e.hp < p.hp {
    if home {
      heal(l, i, e, p);
      return;
    }
    w = chosen_way(l, p, e, e.nest_x, e.nest_y, false, true);
    if w.2 > 0 {
      enemy_step(l, i, w.0, w.1, p.move_ms);
      return;
    }
  }
  // Away from its nest (fled, chased off): it walks home.
  if e.z == e.nest_z && steps_apart(e.x, e.y, e.nest_x, e.nest_y) > p.roam {
    w = chosen_way(l, p, e, e.nest_x, e.nest_y, false, true);
    if w.2 > 0 {
      enemy_step(l, i, w.0, w.1, p.move_ms);
      return;
    }
  }
  // Wandering: a step to a neighbour within its roam of the nest — a light-shunning enemy a dark
  // one when it has one, a light-loving one the brightest (never back where it just came from) —
  // chosen by its id and the steps it has taken (the same every time).
  options: vector<(integer, integer)> = [];
  for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
    if enemy_can(l, p, e.x, e.y, e.z, d.0, d.1) && e.z == e.nest_z
        && steps_apart(e.x + d.0, e.y + d.1, e.nest_x, e.nest_y) <= p.roam {
      options += [d];
    }
  }
  if p.shuns_light || p.likes_light {
    s = shades_round(l, e.x, e.y, e.z, 2);
    if p.shuns_light {
      dark: vector<(integer, integer)> = [];
      for o in options { if !lit_cell(s, e.x + o.0, e.y + o.1) { dark += [o]; } }
      if len(dark) > 0 { options = dark; }
    } else {
      best = 99;
      for o in options {
        if (o.0 != -e.face_x || o.1 != -e.face_y) && shade_at(s, e.x + o.0, e.y + o.1) < best {
          best = shade_at(s, e.x + o.0, e.y + o.1);
        }
      }
      bright: vector<(integer, integer)> = [];
      for o in options {
        if (o.0 != -e.face_x || o.1 != -e.face_y) && shade_at(s, e.x + o.0, e.y + o.1) == best { bright += [o]; }
      }
      if len(bright) > 0 { options = bright; }
    }
  }
  n = len(options);
  if n == 0 {
    l.enemies[i].due = e.due + p.move_ms;
    return;
  }
  pick = options[mix(e.id * 7919 + e.steps * 104729) % n ?? 0] ?? (0, 0);
  enemy_step(l, i, pick.0, pick.1, p.move_ms);
}

/// Enemy i takes a blow costing `damage`: hurt, it turns to go home; at no health it is bested,
/// and what it held in sight falls where it stood (owner: no hidden loot, but what is seen is
/// there) — one bomb of a bomber's, the one in its hand.
pub fn strike_enemy(l: Level, i: integer, damage: integer) {
  hp = (l.enemies[i].hp ?? 0) - damage;
  if hp <= 0 {
    // (`l.enemies[i]` reads the list: what it held is read before it is removed.)
    e = l.enemies[i] ?? no_enemy();
    held = e.item;
    x = e.x;
    y = e.y;
    z = e.z;
    fx = e.face_x;
    fy = e.face_y;
    _ = l.enemies.remove(i);
    l.killed += 1;
    if held != 0 { leave(l, held, x, y, z, fx, fy); }
    return;
  }
  l.enemies[i].hp = hp;
  l.enemies[i].heal_due = 0;
}

// What a blow by the hero costs an enemy: its weapon's damage, else 1.
fn blow(l: const Level) -> integer {
  p = l.k.things[l.hero_item]?;
  if p.damage > 0 { return p.damage; }
  1
}

// What the hero's blow costs enemy `foe`: what it holds costs a flier its `flier_damage` when it has
// one (a torch against a bat), else its `damage`; bare hands 1 (DESIGN.md § What the hero holds).
fn blow_on(l: const Level, foe: integer) -> integer {
  e = l.enemies[foe];
  p = l.k.things[l.hero_item]?;
  if e && p.flier_damage > 0 && enemy_props(l, e.kind).flies { return p.flier_damage; }
  blow(l)
}

// Does terrain `kind` stop sight and a swing (a wall)?
fn opaque_terrain(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.opaque
}

// How long the hero takes to ready what it holds again after a blow: its `recover_ms`, else blow_ms.
fn recovery(l: const Level) -> integer {
  p = l.k.things[l.hero_item]?;
  if p.recover_ms > 0 { p.recover_ms } else { l.k.blow_ms }
}

// Can the hero strike enemy `foe` beside it (dx, dy): across an edge it crosses, not a guard, not up
// on a wall (out of a sword's reach: a climbing spider there).
fn reachable_foe(l: const Level, foe: integer, dx: integer, dy: integer) -> boolean {
  e = l.enemies[foe];
  if !e || !hero_crosses(l, l.hero_x, l.hero_y, l.hero_z, dx, dy) { return false; }
  if enemy_props(l, e.kind).guard { return false; }
  walkable(l, tile_world::terrain(l.w, e.x, e.y, e.z)) || is_water(l, tile_world::terrain(l.w, e.x, e.y, e.z))
}

// --- The bow ---
//
// An arrow flies straight from the hero, up to arrow_range cells (proposed 8): over items, fences,
// water and chasms; a wall, a closed edge or a big thing stops it.  It strikes the first enemy on
// its way (1) — a spider up on the wall it reaches too; it throws a lever it hits (the hero's
// arrows; owner) and sets off a bomb (owner).  The aim (owner): the targets are the first thing an
// arrow would strike in each of the four ways, nearest first; `aim_next` locks on the next, and a
// lock is lost when its target is no longer one.

/// Does the hero hold a bow?
pub fn armed_with_bow(l: const Level) -> boolean {
  p = l.k.things[l.hero_item];
  if !p { return false; }
  p.shoots
}

// What an arrow coming into (x, y, z) strikes there: 0 nothing (it flies on), 1 an enemy, 2 a
// lever, 3 a bomb, 4 a wall or a big thing (it falls).
fn arrow_meets(l: const Level, x: integer, y: integer, z: integer, by: integer) -> integer {
  if by != 0 && l.hero_x == x && l.hero_y == y && l.hero_z == z && alive(l) { return 5; }
  if enemy_at(l, x, y, z) >= 0 { return 1; }
  if opaque_kind(l, tile_world::terrain(l.w, x, y, z)) { return 4; }
  t = base(l, x, y, z);
  lever = l.k.things[t];
  if lever && lever.switches_to != "" { return 2; }
  if is_bomb(l, tile_world::top(l.w, x, y, z)) { return 3; }
  if t != 0 && !item(l, t) { return 4; }
  0
}

// Where an arrow shot from the hero the way (dx, dy) would strike, as things stand: (x, y, cells,
// what) — `what` as arrow_meets says, 0 when it falls at the end of its range or at a closed edge.
fn arrow_flight(l: const Level, dx: integer, dy: integer) -> (integer, integer, integer, integer) {
  x = l.hero_x;
  y = l.hero_y;
  z = l.hero_z;
  for i in 0..l.k.arrow_range {
    if !tile_world::see_through(l.w, x, y, z, dx, dy) { return (x, y, i, 0); }
    x += dx;
    y += dy;
    m = arrow_meets(l, x, y, z, 0);
    if m == 4 { return (x, y, i + 1, 0); }
    if m != 0 { return (x, y, i + 1, m); }
  }
  (x, y, l.k.arrow_range, 0)
}

/// The targets of the bow: in each of the four ways, the first enemy, lever or bomb an arrow would
/// strike, as (x, y, dx, dy), nearest first (north, east, south, west among equals).
pub fn targets(l: const Level) -> vector<(integer, integer, integer, integer)> {
  found: vector<(integer, integer, integer, integer, integer)> = [];
  for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
    f = arrow_flight(l, d.0, d.1);
    if f.3 != 0 { found += [(f.0, f.1, d.0, d.1, f.2)]; }
  }
  out: vector<(integer, integer, integer, integer)> = [];
  for n in 1..l.k.arrow_range + 1 {
    for c in found { if c.4 == n { out += [(c.0, c.1, c.2, c.3)]; } }
  }
  out
}

/// Lock the aim on the next target: the nearest when none is locked (or the locked one is no
/// longer a target), else the one after it, round again.  Answers whether there is one.
pub fn aim_next(l: Level) -> boolean {
  ts = targets(l);
  n = len(ts);
  if n == 0 {
    l.aiming = false;
    return false;
  }
  at = -1;
  if l.aiming {
    for i in 0..n {
      t = ts[i] ?? (0, 0, 0, 0);
      if t.0 == l.aim_x && t.1 == l.aim_y { at = i; }
    }
  }
  t = ts[(at + 1) % n ?? 0] ?? (0, 0, 0, 0);
  l.aiming = true;
  l.aim_x = t.0;
  l.aim_y = t.1;
  true
}

/// The aim, while it holds: its target's way from the hero, or (0, 0) — no lock, or its target is
/// no longer one (the lock is lost then).
pub fn aimed(l: Level) -> (integer, integer) {
  if !l.aiming { return (0, 0); }
  for t in targets(l) {
    if t.0 == l.aim_x && t.1 == l.aim_y { return (t.2, t.3); }
  }
  l.aiming = false;
  (0, 0)
}

/// The hero shoots its bow: at the locked target, else the way it faces (and faces that way).  The
/// arrow flies a cell every arrow_ms (`arrows_due`), striking what it meets then.  Blocked without
/// a bow.
pub fn shoot(l: Level) -> Step {
  l.queued = false;
  if !alive(l) || !armed_with_bow(l) { return Step.Blocked; }
  a = aimed(l);
  if a.0 != 0 || a.1 != 0 {
    l.face_x = a.0;
    l.face_y = a.1;
  }
  l.shots += [Shot { x: l.hero_x, y: l.hero_y, z: l.hero_z, dx: l.face_x, dy: l.face_y, cells: 0, at: l.now,
                     due: l.now + l.k.arrow_ms, done: false, by: 0 }];
  if len(l.shots) > 8 { _ = l.shots.remove(0); }
  Step.Shot
}

// Every arrow whose next cell is due, the earliest first: it flies on, or strikes what is there.
fn arrows_due(l: Level) {
  guard = 0;
  while guard < 1000 {
    guard += 1;
    first = -1;
    at = 0;
    for i in 0..len(l.shots) {
      s = l.shots[i];
      if !s.done && s.due <= l.now && (first < 0 || s.due < at) {
        first = i;
        at = s.due;
      }
    }
    if first < 0 { return; }
    arrow_step(l, first);
  }
}

// Arrow i flies one cell on — or falls: at a closed edge, past its range.
fn arrow_step(l: Level, i: integer) {
  s = l.shots[i] ?? Shot { x: 0, y: 0, z: 0, dx: 0, dy: 0, cells: 0, at: 0, due: 0, done: true, by: 0 };
  x = s.x + s.dx * s.cells;
  y = s.y + s.dy * s.cells;
  if s.cells >= l.k.arrow_range || !tile_world::see_through(l.w, x, y, s.z, s.dx, s.dy) {
    l.shots[i].done = true;
    return;
  }
  x += s.dx;
  y += s.dy;
  l.shots[i].cells = s.cells + 1;
  l.shots[i].due = s.due + l.k.arrow_ms;
  m = arrow_meets(l, x, y, s.z, s.by);
  if m == 0 { return; }
  l.shots[i].done = true;
  // A hunter's arrow: the hero hit loses a point; a lever it meets stops it, unthrown (owner).
  if m == 5 {
    harm(l, 1);
    return;
  }
  if m == 2 && s.by != 0 { return; }
  if m == 1 {
    foe = enemy_at(l, x, y, s.z);
    if foe >= 0 && !enemy_props(l, (l.enemies[foe] ?? no_enemy()).kind).guard {
      strike_enemy(l, foe, 1);
    }
  } else if m == 2 {
    _ = throw_lever(l, x, y, s.z);
  } else if m == 3 {
    r = bomb_rolling_at(l, x, y, s.z);
    if r >= 0 { _ = l.bombs.remove(r); }
    _ = tile_world::take(l.w, x, y, s.z);
    explode(l, x, y, s.z, false, s.due);
  }
}
