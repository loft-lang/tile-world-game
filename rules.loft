// The rules of the game: what the hero and the things on the board do.  The world itself —
// layers, terrain, stacks, paths, sight and light — is the tile_world library's; the KINDS are
// data (kinds.json), and every rule here reads a kind's properties, never its name:
//
//   terrain: walk (can be stood on), opaque (stops sight and light), rail (carts run on it),
//            mount (a mountable thing can be fixed to it: a wall), height (the steps it stands
//            itself: a fence is climbed like a one-step stack), blocks_things (nothing is pushed
//            or pulled onto it, so a train stops at it), opens_to (walking into it turns it
//            into that kind: a door opens), stairs (1 or -1: walking onto it takes the hero to
//            the same cell a layer up or down), chopped_to (walking into it holding a thing
//            that chops turns it into that kind: a tree or a fence, felled to floor — after
//            `hits` such blows, 1 when not given; each blow leaves a `drops` thing beside it,
//            when there is room: a tree, a stick), saves
//            (walking into it saves the whole situation: a well — DESIGN.md's clear-area
//            condition joins it with the enemies, until then the area is always clear).
//   edges:   walk (crossed freely), opaque, climb (the hero climbs over it, nothing else
//            crosses: a fence between two cells).
//   things:  height (steps it adds to its stack), stand (the hero can stand on it), surface
//            (a lifting thing can rest on it), move ("none", "push", "push_pull"), rails (moves
//            only along rail terrain), train (a line of them moves as one), lift (pulled up or
//            down onto a surface), walk_on ("boost" or "take": walked over rather than into),
//            mount (can be fixed to mount terrain), light (gives light, carried or set down),
//            chops (held, it fells what can be chopped: an axe), opens_to (walking into it
//            turns it into that thing and scores its `points`: a chest opens), switches_to (a lever:
//            walked into, it sets the junctions beside it the other way and becomes that thing,
//            its handle over), tells ("chests":
//            walking into it says how many things are still to open: a signpost), rest (a light
//            item falling onto it comes to rest on top: a chest, a table, a stone — big things;
//            the hero takes it standing there, and a stone pushed along carries it), holds (a
//            mountable thing hangs in it: a wall socket — mounting needs one), dips (walking into
//            it turns what the hero holds into that thing's `dipped_to`: a tar barrel, a stick
//            into a torch), lit_to (lit from a flame it becomes that: a torch), flame (it burns:
//            it lights what has a `lit_to`, and after `burn_ms` of the level's clock it becomes
//            its `burns_to`, wherever it is — held, on the floor or in a socket; over that time
//            its light fades by `fade` shades, the warning that it burns down, and flickers: one
//            shade dimmer now and then, a step of `flicker_ms` in `flicker_odds`).
//
// A train runs along its TRACK: a rail cell joins the rail cells beside it, and a cart leaves a
// cell only through a side it joins (see Tracks); past a track's end, with free floor after it,
// the front cart becomes its `derails_to` (a derailed cart: fixed, stood on).
//
// The hero holds at most one item, and while it holds one it pushes, pulls and lifts nothing.
//
// Height counts in steps — a cell's rise and the things stacked on it — and a layer is
// `layer_height` steps, so the floor of the layer above stands `layer_height` high.  The hero
// steps up at most 1 and down any amount short of a full layer.  So one step below a layer's
// height — a chair on a table, a slope's top — climbs onto the floor of the layer above beside
// it, unless a ceiling is over the hero (the layer above set over its own cell); and walking
// into the void steps down onto what stands below.  A drop of a full layer or more is a FALL:
// it costs `fall_damage[n - 1]` of the hero's `health` for n layers fallen (the last entry for
// deeper falls), and a hero with no health left moves no more.  Walking into a thing pushes
// it one cell when it can go there, and climbs onto it when it cannot and can be stood on.  A
// train is pushed up to `push_strength` long and pulled up to `pull_strength`; a walk_on
// "boost" thing adds `boost` to both for `boost_ms` of the level's clock.
use tile_world;

/// Void: a cell nobody set.
pub const VOID = 0;

struct TerrainProps {
  const id: integer,
  name: text,
  walk: boolean,
  opaque: boolean,
  rail: boolean,
  mount: boolean,
  height: integer,
  blocks_things: boolean,
  opens_to: text,
  stairs: integer,
  chopped_to: text,
  hits: integer,
  drops: text,
  saves: boolean,
  glyph: text
}

struct EdgeProps {
  const id: integer,
  name: text,
  walk: boolean,
  opaque: boolean,
  climb: boolean,
  glyph: text
}

struct ThingProps {
  const id: integer,
  name: text,
  height: integer,
  stand: boolean,
  surface: boolean,
  move: text,
  rails: boolean,
  train: boolean,
  lift: boolean,
  walk_on: text,
  mount: boolean,
  light: boolean,
  chops: boolean,
  opens_to: text,
  points: integer,
  tells: text,
  rest: boolean,
  holds: boolean,
  dips: boolean,
  dipped_to: text,
  lit_to: text,
  flame: boolean,
  burns_to: text,
  derails_to: text,
  switches_to: text,
  glyph: text
}

/// The game's kinds, as kinds.json declares them, and the numbers its rules use.
pub struct Kinds {
  terrain: hash<TerrainProps[id]>,
  things: hash<ThingProps[id]>,
  edges: hash<EdgeProps[id]>,
  pub push_strength: integer,
  pub pull_strength: integer,
  pub boost: integer,
  pub boost_ms: integer,
  pub layer_height: integer,
  /// The hero's health at the start, and what a fall of 1, 2, 3, ... layers costs.
  pub health: integer,
  pub fall_damage: vector<integer>,
  /// How long a flame burns, in the level's clock, and the last part of it it burns low.
  pub burn_ms: integer,
  pub low_ms: integer,
  /// How many shades a flame's light fades over its burn_ms: it reaches that many cells less far
  /// at the end.
  pub fade: integer,
  /// A flame's light flickers: every `flicker_ms` it may be one shade dimmer, one step in
  /// `flicker_odds` (0: never).
  pub flicker_ms: integer,
  pub flicker_odds: integer
}

fn num(v: const JsonValue, name: text, default: integer) -> integer {
  f = v.field(name);
  if f.kind() == "JInteger" || f.kind() == "JNumber" { (f.as_number() as integer) ?? default } else { default }
}

fn flag(v: const JsonValue, name: text) -> boolean {
  v.field(name).as_bool() ?? false
}

fn word(v: const JsonValue, name: text, default: text) -> text {
  f = v.field(name);
  if f.kind() == "JString" { f.as_text() } else { default }
}

/// The kinds a JSON text declares (kinds.json's shape); null when it does not parse.
pub fn kinds_from_json(raw: text) -> Kinds? {
  v = json_parse(raw);
  if v.kind() != "JObject" { return null; }
  r = v.field("rules");
  k = Kinds {
    terrain: [], things: [], edges: [],
    push_strength: num(r, "push_strength", 3),
    pull_strength: num(r, "pull_strength", 2),
    boost: num(r, "boost", 2),
    boost_ms: num(r, "boost_ms", 60000),
    layer_height: num(r, "layer_height", 4),
    health: num(r, "health", 6),
    fall_damage: [],
    burn_ms: num(r, "burn_ms", 600000),
    low_ms: num(r, "low_ms", 60000),
    fade: num(r, "fade", 4),
    flicker_ms: num(r, "flicker_ms", 500),
    flicker_odds: num(r, "flicker_odds", 4)
  };
  fd = r.field("fall_damage");
  for i in 0..fd.len() { k.fall_damage += [(fd.item(i).as_number() as integer) ?? 0]; }
  t = v.field("terrain");
  for name in t.keys() {
    e = t.field(name);
    k.terrain += [TerrainProps {
      id: num(e, "id", 0), name: name, walk: flag(e, "walk"), opaque: flag(e, "opaque"),
      rail: flag(e, "rail"), mount: flag(e, "mount"), height: num(e, "height", 0),
      blocks_things: flag(e, "blocks_things"), opens_to: word(e, "opens_to", ""),
      stairs: num(e, "stairs", 0), chopped_to: word(e, "chopped_to", ""),
      hits: num(e, "hits", 1), drops: word(e, "drops", ""),
      saves: flag(e, "saves"), glyph: word(e, "glyph", "?")
    }];
  }
  ed = v.field("edges");
  for name in ed.keys() {
    e = ed.field(name);
    k.edges += [EdgeProps {
      id: num(e, "id", 0), name: name, walk: flag(e, "walk"), opaque: flag(e, "opaque"),
      climb: flag(e, "climb"), glyph: word(e, "glyph", "|")
    }];
  }
  th = v.field("things");
  for name in th.keys() {
    e = th.field(name);
    k.things += [ThingProps {
      id: num(e, "id", 0), name: name, height: num(e, "height", 1), stand: flag(e, "stand"),
      surface: flag(e, "surface"), move: word(e, "move", "none"), rails: flag(e, "rails"),
      train: flag(e, "train"), lift: flag(e, "lift"), walk_on: word(e, "walk_on", ""),
      mount: flag(e, "mount"), light: flag(e, "light"), chops: flag(e, "chops"),
      opens_to: word(e, "opens_to", ""), points: num(e, "points", 0), tells: word(e, "tells", ""),
      rest: flag(e, "rest"), holds: flag(e, "holds"), dips: flag(e, "dips"), dipped_to: word(e, "dipped_to", ""),
      lit_to: word(e, "lit_to", ""), flame: flag(e, "flame"), burns_to: word(e, "burns_to", ""),
      derails_to: word(e, "derails_to", ""), switches_to: word(e, "switches_to", ""),
      glyph: word(e, "glyph", "?")
    }];
  }
  k
}

/// The kinds in kinds.json — beside the program, or one directory up (where tests run).
pub fn kinds() -> Kinds {
  for path in ["kinds.json", "../kinds.json"] {
    raw = file(path).content() ?? "";
    if raw != "" {
      k = kinds_from_json(raw);
      if k { return k ?? Kinds { terrain: [], things: [], edges: [], push_strength: 3, pull_strength: 2,
                                 boost: 2, boost_ms: 60000, layer_height: 4, health: 6, fall_damage: [],
                                 burn_ms: 600000, low_ms: 60000, fade: 4, flicker_ms: 500,
                                 flicker_odds: 4 }; }
    }
  }
  Kinds { terrain: [], things: [], edges: [], push_strength: 3, pull_strength: 2, boost: 2, boost_ms: 60000,
          layer_height: 4, health: 6, fall_damage: [], burn_ms: 600000, low_ms: 60000, fade: 4,
          flicker_ms: 500, flicker_odds: 4 }
}

/// A terrain kind's number by its name in kinds.json; 0 (void) for a name it does not declare.
pub fn terrain_id(k: const Kinds, name: text) -> integer {
  for t in k.terrain {
    if t.name == name { return t.id; }
  }
  0
}

/// A thing's number by its name in kinds.json; 0 for a name it does not declare.
pub fn thing_id(k: const Kinds, name: text) -> integer {
  for t in k.things {
    if t.name == name { return t.id; }
  }
  0
}

/// An edge kind's number by its name in kinds.json; 0 for a name it does not declare.
pub fn edge_id(k: const Kinds, name: text) -> integer {
  for e in k.edges {
    if e.name == name { return e.id; }
  }
  0
}

/// An edge kind's name, "" for 0 or an undeclared number.
pub fn edge_name(k: const Kinds, kind: integer) -> text {
  p = k.edges[kind];
  if !p { return ""; }
  p.name
}

/// A thing's name, "" for 0 or an undeclared number.
pub fn thing_name(k: const Kinds, thing: integer) -> text {
  p = k.things[thing];
  if !p { return ""; }
  p.name
}

/// The terrain kinds kinds.json declares, by number, lowest first.
pub fn terrain_ids(k: const Kinds) -> vector<integer> {
  out: vector<integer> = [];
  for t in k.terrain {
    at = 0;
    while at < len(out) && (out[at] ?? 0) < t.id { at += 1; }
    out.insert(at, t.id);
  }
  out
}

/// The things kinds.json declares, by number, lowest first.
pub fn thing_ids(k: const Kinds) -> vector<integer> {
  out: vector<integer> = [];
  for t in k.things {
    at = 0;
    while at < len(out) && (out[at] ?? 0) < t.id { at += 1; }
    out.insert(at, t.id);
  }
  out
}

/// A terrain kind's glyph (its character in a level file), "" for void or an undeclared number.
pub fn terrain_glyph(k: const Kinds, kind: integer) -> text {
  p = k.terrain[kind];
  if !p { return ""; }
  p.glyph
}

/// A terrain kind's name, "" for void or an undeclared number.
pub fn terrain_name(k: const Kinds, kind: integer) -> text {
  p = k.terrain[kind];
  if !p { return ""; }
  p.name
}

/// A flame set down in the world — on the floor or in a socket — and when it burns out, in the
/// level's clock.  One a cell: a flame is an item, and a cell holds one item.
pub struct Flame {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub until: integer
}

/// A painted piece of track: the picture (a tile number) and the sides it joins (north 1, east 2,
/// south 4, west 8).  A junction is a straight and a bend sharing one side, its toe: a cart in by
/// the toe goes the way it is set — on to the straight's other side, or round to the bend's —
/// and one in by either of those goes on to the toe.  Its twin is the same junction set the other
/// way; a lever flips one into the other.
pub struct Piece {
  pub const tile: integer,
  pub joins: integer,
  pub toe: integer,
  pub straight: integer,
  pub turn: integer,
  pub set_turn: boolean,
  pub twin: integer
}

/// A cell being felled, and the blows it has taken.
pub struct Blows {
  pub x: integer,
  pub y: integer,
  pub z: integer,
  pub n: integer
}

/// A level being played: the world, its kinds and the hero on it.
pub struct Level {
  pub w: tile_world::World,
  pub k: Kinds,
  pub hero_x: integer,
  pub hero_y: integer,
  pub hero_z: integer,
  pub hero_h: integer,
  /// The level's clock in milliseconds (`tick`), and until when a boost lasts.
  pub now: integer,
  pub boost_until: integer,
  /// What the hero holds: 0 for nothing, or a thing it took.
  pub hero_item: integer,
  /// The points scored: a chest opened is one.
  pub points: integer,
  /// The hero's health: a fall costs some; at 0 the hero moves no more.
  pub health: integer,
  /// The flames set down in the world, and when the one the hero holds burns out.
  pub flames: vector<Flame>,
  pub hero_until: integer,
  /// Has the clock met the flames the level started with (`tick` kindles them once)?
  pub kindled: boolean,
  /// The trees (and anything else taking more than one blow) part felled.
  pub blows: vector<Blows>,
  /// The painted track pieces, by their picture (`add_piece`; theme.json's tracks and junctions).
  pub pieces: hash<Piece[tile]>
}

/// What a step did.
pub enum Step {
  Blocked,
  Walked,
  Pushed,
  Pulled,
  Climbed,
  /// The hero took a mounted thing off a wall, or fixed the one it held to a wall.
  Took,
  Placed,
  /// The hero opened a door or a chest.
  Opened,
  /// The hero read a signpost: `closed` says what it told.
  Read,
  /// The hero fell a layer or more, and lost health.
  Fell,
  /// The hero drank from a well: the game saves the whole situation here.
  Saved,
  /// The hero felled a tree or a fence with what it holds.
  Chopped,
  /// The hero threw a lever: the junctions beside it are set the other way.
  Switched,
  /// The hero dipped what it holds (a stick, in a tar barrel).
  Dipped,
  /// A flame lit a torch: the one the hero holds, or the one in a socket.
  Lit
}

/// An empty level whose world knows the kinds: what is walked on, what stops sight and light,
/// what gives light, how high each thing stands.
pub fn level(k: const Kinds) -> Level {
  w = tile_world::world();
  for t in k.terrain {
    tile_world::terrain_kind(w, t.id, t.walk, t.opaque, false, t.glyph);
  }
  for e in k.edges {
    tile_world::edge_kind(w, e.id, e.walk, e.opaque, e.glyph);
  }
  for t in k.things {
    blocks = t.walk_on == "";
    // A flame's light fades as it burns, so the game passes it in (`lights`); the world lights
    // only what always shines (the staff).
    tile_world::thing_kind(w, t.id, t.height, blocks, false, t.light && !t.flame, t.glyph);
  }
  Level { w: w, k: k, hero_x: 0, hero_y: 0, hero_z: 0, hero_h: 0, now: 0, boost_until: 0, hero_item: 0,
          points: 0, health: k.health, flames: [], hero_until: 0, kindled: false, blows: [], pieces: [] }
}

/// Terrain kind and thing numbers by name, for building a level.
pub fn tr(l: const Level, name: text) -> integer {
  terrain_id(l.k, name)
}

pub fn th(l: const Level, name: text) -> integer {
  thing_id(l.k, name)
}

pub fn ed(l: const Level, name: text) -> integer {
  edge_id(l.k, name)
}

// --- Properties ---

/// Can a cell of terrain kind `kind` be stood on or moved over.
pub fn walkable(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.walk
}

/// How high cell (x, y, z) stands, in steps: its terrain's own height (a fence), its rise, and
/// the things stacked on it.
pub fn height(l: const Level, x: integer, y: integer, z: integer) -> integer {
  p = l.k.terrain[tile_world::terrain(l.w, x, y, z)];
  (if p { p.height } else { 0 }) + tile_world::height(l.w, x, y, z)
}

// The kind terrain `kind` turns into when walked into (a door, open), 0 for none.
fn opens_to(l: const Level, kind: integer) -> integer {
  p = l.k.terrain[kind];
  if !p { return 0; }
  if p.opens_to == "" { return 0; }
  terrain_id(l.k, p.opens_to)
}

// Where terrain `kind` takes the hero who walks onto it: 1 a layer up, -1 down, 0 nowhere.
fn stairs(l: const Level, kind: integer) -> integer {
  p = l.k.terrain[kind];
  if !p { return 0; }
  p.stairs
}

// Does terrain `kind` keep things off: nothing pushed or pulled onto it?
fn blocks_things(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.blocks_things
}

/// Can the hero cross from (x, y, z) to the cell (dx, dy) beside it: no edge between, an edge
/// that is walked through (a door), or one it climbs over (a fence)?
pub fn hero_crosses(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  if tile_world::crossable(l.w, x, y, z, dx, dy) { return true; }
  side = if dx > 0 { tile_world::EAST } else if dx < 0 { tile_world::WEST }
         else if dy > 0 { tile_world::SOUTH } else { tile_world::NORTH };
  p = l.k.edges[tile_world::edge(l.w, x, y, z, side)];
  if !p { return false; }
  p.climb
}

fn rail(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.rail
}

fn mount_terrain(l: const Level, kind: integer) -> boolean {
  p = l.k.terrain[kind];
  if !p { return false; }
  p.mount
}

/// How many height steps a thing adds to its stack.
pub fn thing_height(l: const Level, thing: integer) -> integer {
  if thing == 0 { return 0; }
  p = l.k.things[thing];
  if !p { return 1; }
  p.height
}

/// Is this a thing the hero walks onto rather than into.
pub fn item(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.walk_on != ""
}

/// Can the hero stand on this thing.
pub fn standable(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.stand
}

/// Can a push move this thing.
pub fn movable(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.move == "push" || p.move == "push_pull"
}

fn pullable(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.move == "push_pull"
}

fn surface_kind(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.surface
}

fn trainlike(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.train
}

fn on_rails(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.rails
}

fn lifts(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.lift
}

// The thing `thing` turns into when walked into (a chest, open), 0 for none.
fn thing_opens_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p { return 0; }
  if p.opens_to == "" { return 0; }
  thing_id(l.k, p.opens_to)
}

/// Where the things still to open (closed chests) are, stack by stack.
pub fn closed_at(l: const Level) -> vector<(integer, integer, integer)> {
  out: vector<(integer, integer, integer)> = [];
  for s in tile_world::stacks(l.w) {
    for t in tile_world::things(l.w, s.0, s.1, s.2) {
      if thing_opens_to(l, t) != 0 { out += [s]; }
    }
  }
  out
}

/// How many things in the level are still to open (closed chests).
pub fn closed(l: const Level) -> integer {
  n = 0;
  for s in tile_world::stacks(l.w) {
    for t in tile_world::things(l.w, s.0, s.1, s.2) {
      if thing_opens_to(l, t) != 0 { n += 1; }
    }
  }
  n
}

// Does what the hero holds fell what can be chopped (an axe)?
fn holds_chopper(l: const Level) -> boolean {
  p = l.k.things[l.hero_item];
  if !p { return false; }
  p.chops
}

/// Are the hero's hands too busy to push, pull or lift?  They are while it holds an item.
pub fn hands_busy(l: const Level) -> boolean {
  l.hero_item != 0
}

// One blow of the axe at (x, y, z), a cell of terrain `kind` the hero strikes moving (dx, dy):
// what it drops lands beside it (the side its place prefers, then the other) when there is room,
// and at its last blow it is felled to `to`.
fn strike(l: Level, kind: integer, to: integer, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  p = l.k.terrain[kind];
  if !p { return; }
  dropped = thing_id(l.k, p.drops);
  if dropped != 0 {
    s = aside(l, x, y, z, dx, dy);
    if s.0 != 0 || s.1 != 0 {
      r = landing(l, x, y, z, s.0, s.1, false);
      if r.0 == LANDS { tile_world::place(l.w, r.1, r.2, r.3, dropped); }
    }
  }
  n = 1;
  i = 0;
  while i < len(l.blows) {
    b = l.blows[i];
    if b.x == x && b.y == y && b.z == z {
      n = b.n + 1;
      _ = l.blows.remove(i);
    } else {
      i += 1;
    }
  }
  if n >= p.hits {
    tile_world::set_terrain(l.w, x, y, z, to);
  } else {
    l.blows += [Blows { x: x, y: y, z: z, n: n }];
  }
}

// The kind terrain `kind` becomes when chopped (a tree, to floor), 0 when it cannot be.
fn chopped_to(l: const Level, kind: integer) -> integer {
  p = l.k.terrain[kind];
  if !p { return 0; }
  if p.chopped_to == "" { return 0; }
  terrain_id(l.k, p.chopped_to)
}

fn mounts(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.mount
}

fn walk_on(l: const Level, thing: integer) -> text {
  p = l.k.things[thing];
  if !p { return ""; }
  p.walk_on
}

fn gives_light(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.light
}

fn rests(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.rest
}

// What the hero meets at (x, y, z): the top thing, or — when that is an item resting on a big
// thing (a rest thing) — the big thing under it.
fn base(l: const Level, x: integer, y: integer, z: integer) -> integer {
  st = tile_world::things(l.w, x, y, z);
  n = len(st);
  if n == 0 { return 0; }
  t = st[n - 1] ?? 0;
  if n >= 2 && item(l, t) && rests(l, st[n - 2] ?? 0) { return st[n - 2] ?? 0; }
  t
}

// Move the thing at the top of (x, y, z) to (nx, ny, z) — a big thing with the item resting on
// it, which rides along (a flame with its time).
fn move_base(l: Level, x: integer, y: integer, z: integer, nx: integer, ny: integer) {
  on = 0;
  if base(l, x, y, z) != tile_world::top(l.w, x, y, z) { on = tile_world::take(l.w, x, y, z); }
  t = tile_world::take(l.w, x, y, z);
  tile_world::place(l.w, nx, ny, z, t);
  if on == 0 { return; }
  tile_world::place(l.w, nx, ny, z, on);
  i = flame_at(l, x, y, z);
  if i >= 0 {
    l.flames[i].x = nx;
    l.flames[i].y = ny;
  }
}

// Turn the thing at (x, y, z) — under an item resting on it, if any — into `to` (a chest opens);
// the item stays on top.
fn replace_base(l: Level, x: integer, y: integer, z: integer, to: integer) {
  on = 0;
  if base(l, x, y, z) != tile_world::top(l.w, x, y, z) { on = tile_world::take(l.w, x, y, z); }
  _ = tile_world::take(l.w, x, y, z);
  tile_world::place(l.w, x, y, z, to);
  if on != 0 { tile_world::place(l.w, x, y, z, on); }
}

fn holds(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.holds
}

fn dips(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.dips
}

/// Does `thing` burn (a burning torch)?
pub fn is_flame(l: const Level, thing: integer) -> boolean {
  p = l.k.things[thing];
  if !p { return false; }
  p.flame
}

// What `thing` becomes dipped (a stick: a torch), lit (a torch: a burning one) or burnt out (a
// burning torch: a stick); 0 when it does not.
fn dipped_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.dipped_to == "" { return 0; }
  thing_id(l.k, p.dipped_to)
}

fn lit_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.lit_to == "" { return 0; }
  thing_id(l.k, p.lit_to)
}

fn burns_to(l: const Level, thing: integer) -> integer {
  p = l.k.things[thing];
  if !p || p.burns_to == "" { return 0; }
  thing_id(l.k, p.burns_to)
}

// --- Flames ---

// The entry of the flame set down on (x, y, z), -1 for none.
fn flame_at(l: const Level, x: integer, y: integer, z: integer) -> integer {
  for i in 0..len(l.flames) {
    f = l.flames[i];
    if f.x == x && f.y == y && f.z == z { return i; }
  }
  -1
}

// The flame on (x, y, z) burns until `until`.
fn set_flame(l: Level, x: integer, y: integer, z: integer, until: integer) {
  i = flame_at(l, x, y, z);
  if i >= 0 {
    l.flames[i].until = until;
  } else {
    l.flames += [Flame { x: x, y: y, z: z, until: until }];
  }
}

// The hero took `thing` from (x, y, z): a flame keeps the time it had left there (a flame the
// clock never met — just placed by the editor — has all of it).
fn took(l: Level, thing: integer, x: integer, y: integer, z: integer) {
  l.hero_until = 0;
  if !is_flame(l, thing) { return; }
  i = flame_at(l, x, y, z);
  if i < 0 {
    l.hero_until = l.now + l.k.burn_ms;
    return;
  }
  l.hero_until = l.flames[i].until;
  _ = l.flames.remove(i);
}

// The hero set `thing` down on (x, y, z), a flame that burns until `until`.
fn set_down(l: Level, thing: integer, x: integer, y: integer, z: integer, until: integer) {
  if is_flame(l, thing) { set_flame(l, x, y, z, until); }
}

// Every flame the level started with (from its file, or the editor) starts burning now.
fn kindle(l: Level) {
  l.kindled = true;
  for c in tile_world::stacks(l.w) {
    for t in tile_world::things(l.w, c.0, c.1, c.2) {
      if is_flame(l, t) && flame_at(l, c.0, c.1, c.2) < 0 {
        l.flames += [Flame { x: c.0, y: c.1, z: c.2, until: l.now + l.k.burn_ms }];
      }
    }
  }
  if is_flame(l, l.hero_item) && l.hero_until == 0 { l.hero_until = l.now + l.k.burn_ms; }
}

// The flame on (x, y, z) burnt out: it becomes what it burns to, where it stands in the stack.
fn burnt(l: Level, x: integer, y: integer, z: integer) {
  above: vector<integer> = [];
  t = tile_world::take(l.w, x, y, z);
  while t != 0 && !is_flame(l, t) {
    above += [t];
    t = tile_world::take(l.w, x, y, z);
  }
  if t != 0 { tile_world::place(l.w, x, y, z, burns_to(l, t)); }
  i = len(above) - 1;
  while i >= 0 {
    tile_world::place(l.w, x, y, z, above[i] ?? 0);
    i -= 1;
  }
}

// Every flame whose time is up burns out, the one the hero holds too.
fn burn_out(l: Level) {
  i = 0;
  while i < len(l.flames) {
    f = l.flames[i];
    if f.until > l.now {
      i += 1;
      continue;
    }
    burnt(l, f.x, f.y, f.z);
    _ = l.flames.remove(i);
  }
  if is_flame(l, l.hero_item) && l.hero_until <= l.now {
    l.hero_item = burns_to(l, l.hero_item);
    l.hero_until = 0;
  }
}

/// Is the flame on (x, y, z) in its last `low_ms` (drawn low)?
pub fn low(l: const Level, x: integer, y: integer, z: integer) -> boolean {
  i = flame_at(l, x, y, z);
  if i < 0 { return false; }
  l.flames[i].until - l.now <= l.k.low_ms
}

/// Is the flame the hero holds in its last `low_ms`?
pub fn hero_low(l: const Level) -> boolean {
  is_flame(l, l.hero_item) && l.hero_until - l.now <= l.k.low_ms
}

// How far a flame burning until `until` has faded, in shades: 0 when lit, `fade` at its end.
fn faded(l: const Level, until: integer) -> integer {
  left = until - l.now;
  if left >= l.k.burn_ms || l.k.burn_ms <= 0 { return 0; }
  if left < 0 { left = 0; }
  (l.k.burn_ms - left) * l.k.fade / l.k.burn_ms ?? 0
}

/// Does the flame burning until `until` at (x, y, z) flicker one shade dimmer now?  Once a
/// `flicker_ms` step, one step in `flicker_odds`, chosen by a hash of the step and the flame (its
/// end and its place), so two flames lit together do not flicker together.
pub fn flicker(l: const Level, until: integer, x: integer, y: integer, z: integer) -> integer {
  if l.k.flicker_ms <= 0 || l.k.flicker_odds <= 0 { return 0; }
  h = mix((l.now / l.k.flicker_ms ?? 0) * 40503 + until * 7919 + place_key(x, y, z));
  if (h >> 4) % l.k.flicker_odds == 0 { 1 } else { 0 }
}

// --- The world's fixed choices ---
//
// Where the rules must choose (which way an item goes aside, when a flame flickers) they choose
// by a hash: the same situation always gives the same answer, so the game is deterministic, but
// the pattern follows no row, column or checkerboard a player could read off the grid.

// An integer mixed into 31 well-spread bits (two rounds of a known 32-bit integer hash), every
// product kept inside the integer range.
fn mix(v: integer) -> integer {
  h = v & 0x7FFFFFFF;
  h = (((h >> 16) ^ h) * 0x45d9f3b) & 0x7FFFFFFF;
  h = (((h >> 16) ^ h) * 0x45d9f3b) & 0x7FFFFFFF;
  (h >> 16) ^ h
}

// A cell as one integer to mix (large primes, so near cells land far apart).
fn place_key(x: integer, y: integer, z: integer) -> integer {
  (x * 73856093) ^ (y * 19349663) ^ (z * 83492791)
}

/// Does an item pushed aside on (x, y, z) try the right of its way first (else the left)?  Each
/// place on the ground has its own, fixed, preference.
pub fn prefers_right(x: integer, y: integer, z: integer) -> boolean {
  ((mix(place_key(x, y, z)) >> 7) & 1) == 1
}

/// The lights the game gives `tile_world::shades` on layer z, and the shade each starts at
/// (`light_starts`, the same order): what the hero carries, then every flame set down there.  A
/// flame fades as it burns; the staff does not.  Before the clock has met the level's flames
/// they are as bright as when lit.
pub fn lights(l: const Level, z: integer) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  if l.hero_item != 0 && gives_light(l, l.hero_item) { out += [(l.hero_x, l.hero_y)]; }
  if l.kindled {
    for f in l.flames { if f.z == z { out += [(f.x, f.y)]; } }
    return out;
  }
  for c in tile_world::stacks(l.w) {
    if c.2 != z { continue; }
    for t in tile_world::things(l.w, c.0, c.1, c.2) {
      if is_flame(l, t) { out += [(c.0, c.1)]; }
    }
  }
  out
}

pub fn light_starts(l: const Level, z: integer) -> vector<integer> {
  out: vector<integer> = [];
  if l.hero_item != 0 && gives_light(l, l.hero_item) {
    out += [if is_flame(l, l.hero_item) {
      faded(l, l.hero_until) + flicker(l, l.hero_until, l.hero_x, l.hero_y, l.hero_z)
    } else { 0 }];
  }
  if l.kindled {
    for f in l.flames { if f.z == z { out += [faded(l, f.until) + flicker(l, f.until, f.x, f.y, f.z)]; } }
  }
  out
}

/// Does anything burn — a flame set down, or the one the hero holds?  (The picture moves then.)
pub fn burning(l: const Level) -> boolean {
  len(l.flames) > 0 || is_flame(l, l.hero_item)
}

// --- The hero ---

/// Put the hero on (x, y, z), standing on the stack there.
pub fn put_hero(l: Level, x: integer, y: integer, z: integer) {
  l.hero_x = x;
  l.hero_y = y;
  l.hero_z = z;
  l.hero_h = height(l, x, y, z);
}

/// The light the hero carries, for `tile_world::shades`: its cell when it holds a light.
pub fn carried_lights(l: const Level) -> vector<(integer, integer)> {
  out: vector<(integer, integer)> = [];
  if l.hero_item != 0 && gives_light(l, l.hero_item) { out += [(l.hero_x, l.hero_y)]; }
  out
}

/// The level as text, the hero `@`.
pub fn view(l: const Level, x0: integer, y0: integer, x1: integer, y1: integer, z: integer) -> text {
  marks: vector<(integer, integer, text)> = [];
  if l.hero_z == z { marks += [(l.hero_x, l.hero_y, "@")]; }
  tile_world::view(l.w, x0, y0, x1, y1, z, marks)
}

// Can `thing`, sitting with its base at height `base`, go onto cell (x, y, z)?  The cell's
// surface must be that same height: a push or a pull moves a thing level, never up.  A rail
// thing goes only onto rail terrain's floor; a lifting thing also onto a surface's top.
fn fits(l: const Level, thing: integer, x: integer, y: integer, z: integer, base: integer) -> boolean {
  k = tile_world::terrain(l.w, x, y, z);
  if !walkable(l, k) || blocks_things(l, k) { return false; }
  surface = height(l, x, y, z);
  if surface != base { return false; }
  if on_rails(l, thing) { return rail(l, k) && surface == 0; }
  if surface == 0 { return true; }
  lifts(l, thing) && surface_kind(l, tile_world::top(l.w, x, y, z))
}

// --- Items in the way ---
//
// A floor cell holds at most one item (a walk_on thing), and nothing is ever put on one: a light
// item is pushed out of the way of what comes in.  It slides one cell on when there is room; when
// another item lies there — a string of two — that one goes to the side (the side its place
// prefers first, then the other), if there is room, and the first slides into its cell.  With no room the push or the
// pull does not happen.

/// What `landing` answers first: no room (the move does not happen), lands (at the position it
/// answers), or gone (the item fell to nowhere and is destroyed).
pub const NO_ROOM = 0;
pub const LANDS = 1;
pub const GONE = 2;

// Where an item on (x, y, z) goes moving one cell (dx, dy), across an edge things cross.  On its
// own layer: that cell, when it is floor at the item's height holding nothing (with `leaving`,
// what lies there is about to go aside) and not kept off things — else NO_ROOM.  Over a drop
// (void) it falls (`fall`): a fall always happens, and lands somewhere or is GONE.
fn landing(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
           leaving: boolean) -> (integer, integer, integer, integer) {
  nx = x + dx;
  ny = y + dy;
  if !tile_world::crossable(l.w, x, y, z, dx, dy) { return (NO_ROOM, x, y, z); }
  k = tile_world::terrain(l.w, nx, ny, z);
  if k == VOID { return fall(l, nx, ny, z - 1, dx, dy, 0); }
  if !walkable(l, k) || blocks_things(l, k) { return (NO_ROOM, x, y, z); }
  if !leaving && tile_world::top(l.w, nx, ny, z) != 0 { return (NO_ROOM, x, y, z); }
  if height(l, nx, ny, z) != height(l, x, y, z) { return (NO_ROOM, x, y, z); }
  (LANDS, nx, ny, z)
}

// Where a light item falling down column (x, y) from layer z comes to rest: the first floor below
// holding nothing, or a big thing (a rest thing) with nothing on it.  Onto anything else — another
// item, a chair — it rolls off beside it: the side the place prefers, then the other, then
// straight on (dx, dy), falling on over a drop there.  With nowhere to go (water, no floor at all,
// no room around) it is GONE.
fn fall(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
        depth: integer) -> (integer, integer, integer, integer) {
  bottom = lowest_layer(l);
  zb = z;
  while zb >= bottom && tile_world::terrain(l.w, x, y, zb) == VOID { zb -= 1; }
  if zb < bottom { return (GONE, x, y, zb); }
  kb = tile_world::terrain(l.w, x, y, zb);
  if !walkable(l, kb) || blocks_things(l, kb) { return (GONE, x, y, zb); }
  t = tile_world::top(l.w, x, y, zb);
  if t == 0 || rests(l, t) { return (LANDS, x, y, zb); }
  if depth >= 3 { return (GONE, x, y, zb); }
  first = if prefers_right(x, y, zb) { (-dy, dx) } else { (dy, -dx) };
  for d in [first, (-first.0, -first.1), (dx, dy)] {
    if !tile_world::crossable(l.w, x, y, zb, d.0, d.1) { continue; }
    cx = x + d.0;
    cy = y + d.1;
    ck = tile_world::terrain(l.w, cx, cy, zb);
    if ck == VOID {
      r = fall(l, cx, cy, zb - 1, d.0, d.1, depth + 1);
      if r.0 == LANDS { return r; }
      continue;
    }
    if !walkable(l, ck) || blocks_things(l, ck) { continue; }
    ct = tile_world::top(l.w, cx, cy, zb);
    if ct == 0 || rests(l, ct) { return (LANDS, cx, cy, zb); }
  }
  (GONE, x, y, zb)
}

// Is there room for the item on (x, y, z) one cell (dx, dy) on (`landing`)?
fn slides(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
          leaving: boolean) -> boolean {
  landing(l, x, y, z, dx, dy, leaving).0 != NO_ROOM
}

// The side the item on (x, y, z) goes to, out of the way (dx, dy): the side that place prefers
// (`prefers_right`), then the other; (0, 0) when neither has room.
fn aside(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> (integer, integer) {
  first = if prefers_right(x, y, z) { (-dy, dx) } else { (dy, -dx) };
  if slides(l, x, y, z, first.0, first.1, false) { return first; }
  if slides(l, x, y, z, -first.0, -first.1, false) { return (-first.0, -first.1); }
  (0, 0)
}

// Can something come onto (x, y, z) moving (dx, dy), as far as an item lying there goes?
fn way_clear(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  t = tile_world::top(l.w, x, y, z);
  if t == 0 || !item(l, t) { return true; }
  if slides(l, x, y, z, dx, dy, false) { return true; }
  if !item(l, tile_world::top(l.w, x + dx, y + dy, z)) || !slides(l, x, y, z, dx, dy, true) { return false; }
  a = aside(l, x + dx, y + dy, z, dx, dy);
  a.0 != 0 || a.1 != 0
}

// Move the item on top of (x, y, z) one cell (dx, dy), to where it lands (falling, over a drop);
// a flame takes its time along.  An item that falls to nowhere is gone, its flame with it.
fn shift(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  r = landing(l, x, y, z, dx, dy, false);
  if r.0 == NO_ROOM { return; }
  t = tile_world::take(l.w, x, y, z);
  i = flame_at(l, x, y, z);
  if r.0 == GONE {
    if i >= 0 { _ = l.flames.remove(i); }
    return;
  }
  tile_world::place(l.w, r.1, r.2, r.3, t);
  if i >= 0 {
    l.flames[i].x = r.1;
    l.flames[i].y = r.2;
    l.flames[i].z = r.3;
  }
}

// Push the item on (x, y, z) out of the way (dx, dy), as way_clear said it can be.
fn clear_way(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) {
  t = tile_world::top(l.w, x, y, z);
  if t == 0 || !item(l, t) { return; }
  if !slides(l, x, y, z, dx, dy, false) {
    a = aside(l, x + dx, y + dy, z, dx, dy);
    shift(l, x + dx, y + dy, z, a.0, a.1);
  }
  shift(l, x, y, z, dx, dy);
}

// Move the hero to (x, y, z), standing on the stack there.  A walk_on thing on that floor acts:
// "boost" is used up, "take" is picked up (and what the hero held is put down in its place).
fn arrive(l: Level, x: integer, y: integer, z: integer) {
  l.hero_x = x;
  l.hero_y = y;
  l.hero_z = z;
  l.hero_h = height(l, x, y, z);
  // An item on the floor, or resting on the big thing the hero stands on, is met.
  t = tile_world::top(l.w, x, y, z);
  effect = walk_on(l, t);
  if effect == "boost" {
    _ = tile_world::take(l.w, x, y, z);
    l.boost_until = l.now + l.k.boost_ms;
  } else if effect == "take" {
    held = l.hero_item;
    held_until = l.hero_until;
    _ = tile_world::take(l.w, x, y, z);
    l.hero_item = t;
    took(l, t, x, y, z);
    if held != 0 {
      tile_world::place(l.w, x, y, z, held);
      set_down(l, held, x, y, z, held_until);
    }
  }
}

// --- Strength and time ---

/// Put down what the hero holds where it stands — on the floor, or on the big thing (a rest thing:
/// a table, a chest, a stone) it stands on: the hero then stands on it, and picks it up again only
/// by walking off and back on.  Step.Placed, or Blocked when it holds nothing or stands on
/// anything else (an item already: one a cell; a chair).
pub fn drop(l: Level) -> Step {
  if l.hero_item == 0 { return Step.Blocked; }
  under = tile_world::top(l.w, l.hero_x, l.hero_y, l.hero_z);
  if under != 0 && !rests(l, under) { return Step.Blocked; }
  if under == 0 && l.hero_h != 0 { return Step.Blocked; }
  tile_world::place(l.w, l.hero_x, l.hero_y, l.hero_z, l.hero_item);
  set_down(l, l.hero_item, l.hero_x, l.hero_y, l.hero_z, l.hero_until);
  l.hero_item = 0;
  l.hero_until = 0;
  Step.Placed
}

/// Advance the level's clock by `ms` milliseconds.  The first tick kindles the flames the level
/// started with; a flame whose time is up burns out.
pub fn tick(l: Level, ms: integer) {
  if !l.kindled { kindle(l); }
  if ms > 0 { l.now += ms; }
  burn_out(l);
}

/// Is a boost still on?
pub fn boosted(l: const Level) -> boolean {
  l.now < l.boost_until
}

/// How long a train the hero pushes now, and pulls.
pub fn push_strength(l: const Level) -> integer {
  l.k.push_strength + (if boosted(l) { l.k.boost } else { 0 })
}

pub fn pull_strength(l: const Level) -> integer {
  l.k.pull_strength + (if boosted(l) { l.k.boost } else { 0 })
}

// --- Tracks ---
//
// A rail cell joins each rail cell beside it across an edge things cross: its sides, as bits —
// north 1, east 2, south 4, west 8.  One side is an end, two a straight or a bend, three or four
// a junction.  The theme draws the piece its sides name, so what is seen is what a cart follows.
// A cart leaves a cell through the joined side opposite the one it came in by: the other side of a
// straight or a bend, straight on through a junction (choosing a branch comes with the switches).
// Past a track's end it runs straight on, off the rails: it derails onto free floor there, and
// anything else there — a wall, a thing — stops it.

/// What `train_way` answers: the train cannot move, it moves on along the track, or its front
/// cart derails.
pub const STUCK = 0;
pub const ALONG = 1;
pub const DERAILS = 2;

fn side_bit(dx: integer, dy: integer) -> integer {
  if dy < 0 { return 1; }
  if dx > 0 { return 2; }
  if dy > 0 { return 4; }
  if dx < 0 { return 8; }
  0
}

fn bit_way(b: integer) -> (integer, integer) {
  if b == 1 { return (0, -1); }
  if b == 2 { return (1, 0); }
  if b == 4 { return (0, 1); }
  if b == 8 { return (-1, 0); }
  (0, 0)
}

/// Is terrain kind `kind` rail?
pub fn is_rail(l: const Level, kind: integer) -> boolean {
  rail(l, kind)
}

/// Teach the level a painted piece of track (see `Piece`): picture `tile` joins sides `joins`; for
/// a junction, its toe, the straight's and the bend's other side, which it is set to, and its twin
/// (0, 0, 0, false, 0 for a plain straight or bend).
pub fn add_piece(l: Level, tile: integer, joins: integer, toe: integer, straight: integer, turn: integer,
                 set_turn: boolean, twin: integer) {
  if tile == 0 || l.pieces[tile] { return; }
  l.pieces += [Piece { tile: tile, joins: joins, toe: toe, straight: straight, turn: turn, set_turn: set_turn,
                       twin: twin }];
}

// The piece painted on (x, y, z), its picture's; 0 for none (the rail's own look).
fn painted(l: const Level, x: integer, y: integer, z: integer) -> integer {
  t = tile_world::tile(l.w, x, y, z);
  if t == 0 || !l.pieces[t] { return 0; }
  t
}

/// The sides rail cell (x, y, z) joins: north 1, east 2, south 4, west 8; 0 for no rail.  A painted
/// piece joins what its picture shows; a plain rail cell each rail beside it that joins it back.
pub fn joins(l: const Level, x: integer, y: integer, z: integer) -> integer {
  if !rail(l, tile_world::terrain(l.w, x, y, z)) { return 0; }
  t = painted(l, x, y, z);
  if t != 0 {
    p = l.pieces[t];
    return if p { p.joins } else { 0 };
  }
  m = 0;
  for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
    nx = x + d.0;
    ny = y + d.1;
    if rail(l, tile_world::terrain(l.w, nx, ny, z)) && tile_world::crossable(l.w, x, y, z, d.0, d.1) {
      n = painted(l, nx, ny, z);
      np = l.pieces[n];
      if n == 0 || (np && (np.joins & side_bit(-d.0, -d.1)) != 0) { m += side_bit(d.0, d.1); }
    }
  }
  m
}

// The way a cart moving (dx, dy) in rail cell (x, y, z) goes on: the side it leaves by and what
// that is — ALONG (out to the joined cell there), DERAILS (an end: straight on, off the rails) or
// STUCK (it came in by a side the cell does not join, or a junction with no way straight on).
// `pushed`: the cart the hero pushes, which sits in the cell already — it also goes when the cell
// joins only the side it is pushed to (an end, pushed back onto the track).
fn way_on(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
          pushed: boolean, lean: (integer, integer) = (0, 0)) -> (integer, integer, integer) {
  w = way_through(l, x, y, z, dx, dy, pushed, lean);
  if w.2 != ALONG { return w; }
  // The way out leads on only into rail that joins back; past rail that does not, it stops.
  nx = x + w.0;
  ny = y + w.1;
  if (joins(l, nx, ny, z) & side_bit(-w.0, -w.1)) != 0 { return w; }
  if rail(l, tile_world::terrain(l.w, nx, ny, z)) { return (0, 0, STUCK); }
  (w.0, w.1, DERAILS)
}

/// The way a cart moving (dx, dy) leaves junction (x, y, z) by — in by its toe, the way it is set
/// unless the hero riding it leans (`lean`) towards the other branch; in by a branch, to the toe —
/// and (0, 0) for a cell that is no junction or a way in it has none.
pub fn junction_way(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
                    lean: (integer, integer) = (0, 0)) -> (integer, integer) {
  p = l.pieces[painted(l, x, y, z)];
  if !p || p.toe == 0 { return (0, 0); }
  entry = side_bit(-dx, -dy);
  if entry == p.straight || entry == p.turn { return bit_way(p.toe); }
  if entry != p.toe { return (0, 0); }
  leaned = side_bit(lean.0, lean.1);
  if leaned == p.straight || leaned == p.turn { return bit_way(leaned); }
  bit_way(if p.set_turn { p.turn } else { p.straight })
}

fn way_through(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer,
               pushed: boolean, lean: (integer, integer)) -> (integer, integer, integer) {
  jw = junction_way(l, x, y, z, dx, dy, lean);
  if jw.0 != 0 || jw.1 != 0 { return (jw.0, jw.1, ALONG); }
  m = joins(l, x, y, z);
  entry = side_bit(-dx, -dy);
  ahead = side_bit(dx, dy);
  if (m & entry) == 0 {
    if pushed && m == ahead { return (dx, dy, ALONG); }
    return (0, 0, STUCK);
  }
  rest = m - entry;
  if rest == 0 { return (dx, dy, DERAILS); }
  if (rest & ahead) != 0 { return (dx, dy, ALONG); }
  if rest == 1 || rest == 2 || rest == 4 || rest == 8 {
    w = bit_way(rest);
    return (w.0, w.1, ALONG);
  }
  (0, 0, STUCK)
}

/// The train a push (dx, dy) moves from (x, y, z) on — its carts along the track, front last —
/// and how its front goes on: STUCK, ALONG (one cell on along the rails) or DERAILS (off the end,
/// onto the floor), with the way it goes (`way`).
pub struct TrainWay {
  pub cells: vector<(integer, integer)>,
  pub how: integer,
  pub way: (integer, integer)
}

fn train_way(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> TrainWay {
  out = TrainWay { cells: [], how: STUCK, way: (0, 0) };
  if !car(l, x, y, z) { return out; }
  cx = x;
  cy = y;
  d = (dx, dy);
  first = true;
  while true {
    out.cells += [(cx, cy)];
    w = way_on(l, cx, cy, z, d.0, d.1, first);
    first = false;
    out.way = (w.0, w.1);
    out.how = w.2;
    if w.2 != ALONG || !car(l, cx + w.0, cy + w.1, z) { return out; }
    cx += w.0;
    cy += w.1;
    d = (w.0, w.1);
    if len(out.cells) > 64 { out.how = STUCK; return out; }
  }
  out
}

/// How many carts a push (dx, dy) at (x, y, z) moves: the train, counted along the track.
pub fn train(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> integer {
  len(train_way(l, x, y, z, dx, dy).cells)
}

// Push the train (dx, dy) from (x, y, z), when the hero is strong enough and its front can go on:
// along the rails onto a free cell (a light item there pushed out of the way), or off a track's
// end onto free floor, where it derails.  Answers whether it moved.
fn push_train(l: Level, x: integer, y: integer, z: integer, dx: integer, dy: integer) -> boolean {
  tw = train_way(l, x, y, z, dx, dy);
  n = len(tw.cells);
  if n == 0 || n > push_strength(l) || tw.how == STUCK { return false; }
  last = tw.cells[n - 1] ?? (x, y);
  fx = last.0 + tw.way.0;
  fy = last.1 + tw.way.1;
  front = base(l, last.0, last.1, z);
  if tw.how == ALONG {
    if !fits(l, front, fx, fy, z, 0) || !way_clear(l, fx, fy, z, tw.way.0, tw.way.1) { return false; }
  } else {
    k = tile_world::terrain(l.w, fx, fy, z);
    if !walkable(l, k) || blocks_things(l, k) || !tile_world::crossable(l.w, last.0, last.1, z, tw.way.0, tw.way.1)
        || height(l, fx, fy, z) != 0 || !way_clear(l, fx, fy, z, tw.way.0, tw.way.1) {
      return false;
    }
    t = tile_world::top(l.w, fx, fy, z);
    if t != 0 && !item(l, t) { return false; }
  }
  clear_way(l, fx, fy, z, tw.way.0, tw.way.1);
  move_base(l, last.0, last.1, z, fx, fy);
  if tw.how == DERAILS {
    p = l.k.things[front];
    to = if p { thing_id(l.k, p.derails_to) } else { 0 };
    if to != 0 { replace_base(l, fx, fy, z, to); }
  }
  k = n - 2;
  while k >= 0 {
    c = tw.cells[k] ?? (x, y);
    t = tw.cells[k + 1] ?? (x, y);
    move_base(l, c.0, c.1, z, t.0, t.1);
    k -= 1;
  }
  true
}

// Is (x, y, z) one car of a train: a train thing on its floor (an item resting on it or not).
fn car(l: const Level, x: integer, y: integer, z: integer) -> boolean {
  t = base(l, x, y, z);
  trainlike(l, t) && height(l, x, y, z) == thing_height(l, t)
}

// Can a line of n things from (x, y), each moving one step (dx, dy), cross every edge on the way.
fn crosses(l: const Level, x: integer, y: integer, z: integer, dx: integer, dy: integer, n: integer) -> boolean {
  for k in 0..n {
    if !tile_world::crossable(l.w, x + k * dx, y + k * dy, z, dx, dy) { return false; }
  }
  true
}



// The climb between layers, or null when this step is not one.
/// Can the hero go from height `from` to height `to`, both counted from the same floor: up at
/// most one step, down less than a full layer?
pub fn reach(l: const Level, from: integer, to: integer) -> boolean {
  to <= from + 1 && from - to < l.k.layer_height
}

fn climb(l: Level, dx: integer, dy: integer) -> Step? {
  tx = l.hero_x + dx;
  ty = l.hero_y + dy;
  z = l.hero_z;
  up = l.k.layer_height;
  // Up: onto the floor of the layer above, beside the hero, a layer's height plus that cell's
  // rise — never up through a ceiling.
  if walkable(l, tile_world::terrain(l.w, tx, ty, z + 1)) && tile_world::top(l.w, tx, ty, z + 1) == 0
      && tile_world::terrain(l.w, l.hero_x, l.hero_y, z + 1) == VOID
      && hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) && hero_crosses(l, l.hero_x, l.hero_y, z + 1, dx, dy)
      && reach(l, l.hero_h, up + tile_world::rise(l.w, tx, ty, z + 1)) {
    arrive(l, tx, ty, z + 1);
    return Step.Climbed;
  }
  // Down: into the void beside, onto the first cell below that is not void — a floor, a rise, a
  // thing the hero can stand on, some layers down.  Less than a layer is a step down; a layer or
  // more is a fall.
  if tile_world::terrain(l.w, tx, ty, z) == VOID && hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) {
    bottom = lowest_layer(l);
    zb = z - 1;
    while zb >= bottom && tile_world::terrain(l.w, tx, ty, zb) == VOID { zb -= 1; }
    if zb < bottom || !walkable(l, tile_world::terrain(l.w, tx, ty, zb)) { return null; }
    if zb == z - 1 && !hero_crosses(l, l.hero_x, l.hero_y, zb, dx, dy) { return null; }
    t = tile_world::top(l.w, tx, ty, zb);
    if t != 0 && !standable(l, t) && !item(l, t) { return null; }
    from = (z - zb) * up + l.hero_h;
    to = height(l, tx, ty, zb);
    if to > from + 1 { return null; }
    arrive(l, tx, ty, zb);
    fallen = (from - to) / up ?? 0;
    if fallen == 0 { return Step.Climbed; }
    hurt(l, fallen);
    return Step.Fell;
  }
  null
}

// The lowest layer the level has.
fn lowest_layer(l: const Level) -> integer {
  low = 0;
  first = true;
  for z in tile_world::layers(l.w) {
    if first || z < low { low = z; }
    first = false;
  }
  low
}

// The cost of falling `layers` layers: the kinds' fall_damage for that many, the last entry for
// more.
fn fall_cost(l: const Level, layers: integer) -> integer {
  n = len(l.k.fall_damage);
  if n == 0 { return 0; }
  l.k.fall_damage[if layers < n { layers - 1 } else { n - 1 }] ?? 0
}

// The hero falls `layers` layers and loses that fall's cost, down to no health.
fn hurt(l: Level, layers: integer) {
  l.health -= fall_cost(l, layers);
  if l.health < 0 { l.health = 0; }
}

/// Has the hero health left to move?
pub fn alive(l: const Level) -> boolean {
  l.health > 0
}

/// Move the hero one cell (dx, dy one of the four directions): walk, push, climb onto a thing,
/// or climb a layer.  The hero stays where it is when the step is Blocked.
pub fn walk(l: Level, dx: integer, dy: integer) -> Step {
  if !alive(l) { return Step.Blocked; }
  c = climb(l, dx, dy);
  if c != null { return c ?? Step.Blocked; }
  tx = l.hero_x + dx;
  ty = l.hero_y + dy;
  z = l.hero_z;
  // Mount terrain (a wall), the hero staying where it is: what hangs there is taken with an
  // empty hand; a flame hanging there lights the torch the hero holds, and the flame the hero
  // holds lights the torch hanging there; a mountable thing the hero holds hangs in an empty
  // socket — only in a socket (a thing on a bare wall, from an older level, is still taken).
  if mount_terrain(l, tile_world::terrain(l.w, tx, ty, z)) {
    on = tile_world::top(l.w, tx, ty, z);
    hung = if holds(l, on) { 0 } else { on };
    if hung != 0 && mounts(l, hung) && l.hero_item == 0 {
      l.hero_item = tile_world::take(l.w, tx, ty, z);
      took(l, l.hero_item, tx, ty, z);
      return Step.Took;
    }
    if hung != 0 && is_flame(l, hung) && lit_to(l, l.hero_item) != 0 {
      l.hero_item = lit_to(l, l.hero_item);
      l.hero_until = l.now + l.k.burn_ms;
      return Step.Lit;
    }
    if hung != 0 && is_flame(l, l.hero_item) && lit_to(l, hung) != 0 {
      _ = tile_world::take(l.w, tx, ty, z);
      tile_world::place(l.w, tx, ty, z, lit_to(l, hung));
      set_flame(l, tx, ty, z, l.now + l.k.burn_ms);
      return Step.Lit;
    }
    if hung == 0 && holds(l, on) && l.hero_item != 0 && mounts(l, l.hero_item) {
      tile_world::place(l.w, tx, ty, z, l.hero_item);
      set_down(l, l.hero_item, tx, ty, z, l.hero_until);
      l.hero_item = 0;
      l.hero_until = 0;
      return Step.Placed;
    }
  }
  // An edge between the hero and the cell it steps to: a wall or a window stops it; a fence is
  // climbed over.
  if !hero_crosses(l, l.hero_x, l.hero_y, z, dx, dy) { return Step.Blocked; }
  kind = tile_world::terrain(l.w, tx, ty, z);
  // Holding an axe, a tree or a fence takes a blow, and falls at its last; the hero stays where
  // it is.
  felled = chopped_to(l, kind);
  if felled != 0 && holds_chopper(l) {
    strike(l, kind, felled, tx, ty, z, dx, dy);
    return Step.Chopped;
  }
  // A well saves the situation (the game keeps it); the hero stays where it is.
  here = l.k.terrain[kind];
  if here && here.saves { return Step.Saved; }
  // A closed door opens; the hero stays where it is.
  open = opens_to(l, kind);
  if open != 0 {
    tile_world::set_terrain(l.w, tx, ty, z, open);
    return Step.Opened;
  }
  if !walkable(l, kind) { return Step.Blocked; }
  // What stands there: an item resting on a big thing is met through the big thing.
  thing = base(l, tx, ty, z);
  // A lever is thrown: every junction beside it is set the other way (its twin picture), and the
  // handle goes over; the hero stays where it is.
  lever = l.k.things[thing];
  if lever && lever.switches_to != "" {
    for d in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
      p = l.pieces[painted(l, tx + d.0, ty + d.1, z)];
      if p && p.twin != 0 {
        tile_world::set_terrain(l.w, tx + d.0, ty + d.1, z, tile_world::terrain(l.w, tx + d.0, ty + d.1, z), p.twin);
      }
    }
    replace_base(l, tx, ty, z, thing_id(l.k, lever.switches_to));
    return Step.Switched;
  }
  // A thing that dips (a tar barrel) turns what the hero holds into what it dips to (a stick,
  // into a torch); the hero stays where it is.
  if dips(l, thing) && dipped_to(l, l.hero_item) != 0 {
    l.hero_item = dipped_to(l, l.hero_item);
    return Step.Dipped;
  }
  // A closed thing (a chest) opens and scores its points; the hero stays where it is.
  opened = thing_opens_to(l, thing);
  if opened != 0 {
    replace_base(l, tx, ty, z, opened);
    p = l.k.things[thing];
    l.points += if p { p.points } else { 0 };
    return Step.Opened;
  }
  // A thing that tells (a signpost) is read: `closed` answers what it says.
  sign = l.k.things[thing];
  if sign && sign.tells != "" { return Step.Read; }
  if thing == 0 || item(l, thing) {
    // A rise is stepped like a stack: up one at most.
    if !reach(l, l.hero_h, height(l, tx, ty, z)) { return Step.Blocked; }
    // Stairs take the hero to the same cell a layer up or down, when it can stand there; the
    // stairs it lands on do not take it on.
    to = z + stairs(l, kind);
    if to != z && walkable(l, tile_world::terrain(l.w, tx, ty, to)) && tile_world::top(l.w, tx, ty, to) == 0 {
      arrive(l, tx, ty, to);
      return Step.Climbed;
    }
    arrive(l, tx, ty, z);
    return Step.Walked;
  }
  surface = height(l, tx, ty, z);
  base = surface - thing_height(l, thing);
  // A train moves as one, when the hero is strong enough and the cell after it takes it.
  // A train moves along its track (round a bend, off an open end), when the hero is strong
  // enough; one that cannot move is climbed, like a chair (below).
  if trainlike(l, thing) && l.hero_h == 0 && !hands_busy(l) && push_train(l, tx, ty, z, dx, dy) {
    arrive(l, tx, ty, z);
    return Step.Pushed;
  }
  // Any other movable thing at the hero's own level is pushed, when it can go one cell on.
  if !trainlike(l, thing) && movable(l, thing) && !hands_busy(l) && base == l.hero_h
      && fits(l, thing, tx + dx, ty + dy, z, base)
      && tile_world::crossable(l.w, tx, ty, z, dx, dy) && way_clear(l, tx + dx, ty + dy, z, dx, dy) {
    clear_way(l, tx + dx, ty + dy, z, dx, dy);
    move_base(l, tx, ty, z, tx + dx, ty + dy);
    arrive(l, tx, ty, z);
    return Step.Pushed;
  }
  // Otherwise a thing that can be stood on, no more than one step up, is climbed onto.
  if standable(l, thing) && surface <= l.hero_h + 1 {
    arrive(l, tx, ty, z);
    return Step.Walked;
  }
  Step.Blocked
}

/// Walk one cell and drag the thing behind the hero into the cell it left: a train along the
/// rails, a "push_pull" thing anywhere it fits there — a lifting one up onto a surface the hero
/// stands on, too.  A "push" thing stays.  Pulled when something came along, Walked when
/// nothing did, Blocked when the hero cannot take the step (a plain one, onto a cell no higher
/// than the hero stands).
pub fn pull(l: Level, dx: integer, dy: integer) -> Step {
  if !alive(l) { return Step.Blocked; }
  fx = l.hero_x;
  fy = l.hero_y;
  z = l.hero_z;
  tx = fx + dx;
  ty = fy + dy;
  bx = fx - dx;
  by = fy - dy;
  if !walkable(l, tile_world::terrain(l.w, tx, ty, z)) { return Step.Blocked; }
  if !hero_crosses(l, fx, fy, z, dx, dy) { return Step.Blocked; }
  target = tile_world::top(l.w, tx, ty, z);
  if (target != 0 && !item(l, target) && !standable(l, target))
      || height(l, tx, ty, z) > l.hero_h {
    return Step.Blocked;
  }
  // Behind the hero on a track is the rail cell its own joins, other than the way it goes — round
  // a bend too; elsewhere the cell behind it.
  m = joins(l, fx, fy, z) - (joins(l, fx, fy, z) & side_bit(dx, dy));
  if m == 1 || m == 2 || m == 4 || m == 8 {
    bw = bit_way(m);
    if car(l, fx + bw.0, fy + bw.1, z) {
      bx = fx + bw.0;
      by = fy + bw.1;
    }
  }
  thing = if hands_busy(l) { 0 } else { base(l, bx, by, z) };
  // The cell the hero leaves: the dragged thing lands on its surface, where the hero stood.
  left = height(l, fx, fy, z);
  base = height(l, bx, by, z) - thing_height(l, thing);
  if trainlike(l, thing) {
    // The whole train behind follows along its track, one cell each, when the hero can pull it
    // and the cell it leaves is rail the train's track joins.
    cars: vector<(integer, integer)> = [];
    cx = bx;
    cy = by;
    d = (bx - fx, by - fy);
    while car(l, cx, cy, z) && len(cars) < 64 {
      cars += [(cx, cy)];
      w = way_on(l, cx, cy, z, d.0, d.1, false);
      if w.2 != ALONG { break; }
      cx += w.0;
      cy += w.1;
      d = (w.0, w.1);
    }
    n = len(cars);
    under = tile_world::top(l.w, fx, fy, z);
    pulled_way = (fx - bx, fy - by);
    can = left == 0 && (joins(l, fx, fy, z) & side_bit(bx - fx, by - fy)) != 0 && (under == 0 || item(l, under));
    strong = n <= pull_strength(l);
    arrive(l, tx, ty, z);
    // An item where the hero stood goes out of the way, once the hero has moved on.
    if !can || !strong || !way_clear(l, fx, fy, z, pulled_way.0, pulled_way.1) { return Step.Walked; }
    clear_way(l, fx, fy, z, pulled_way.0, pulled_way.1);
    move_base(l, bx, by, z, fx, fy);
    for k in 1..n {
      c = cars[k] ?? (bx, by);
      t = cars[k - 1] ?? (bx, by);
      move_base(l, c.0, c.1, z, t.0, t.1);
    }
    return Step.Pulled;
  }
  ok = false;
  if thing != 0 && pullable(l, thing) {
    // Level, or — for a lifting thing — up or down at most two steps, onto the floor or a
    // surface's top.
    lift = left - base;
    reach = if lifts(l, thing) { 2 } else { 0 };
    ok = lift >= -reach && lift <= reach
         && (left == 0 || surface_kind(l, tile_world::top(l.w, fx, fy, z)))
         && !blocks_things(l, tile_world::terrain(l.w, fx, fy, z))
         && tile_world::crossable(l.w, bx, by, z, dx, dy);
  }
  arrive(l, tx, ty, z);
  if !ok || !way_clear(l, fx, fy, z, dx, dy) { return Step.Walked; }
  clear_way(l, fx, fy, z, dx, dy);
  move_base(l, bx, by, z, fx, fy);
  Step.Pulled
}

// --- Playing ---

/// Play a line of moves: `w` `a` `s` `d` walk north, west, south and east; `pw` `pa` `ps` `pd`
/// pull; `x` puts down what the hero holds.  Moves are separated by spaces; anything else is
/// skipped.  Answers how many moves were
/// not Blocked.
pub fn play(l: Level, moves: text) -> integer {
  done = 0;
  for m in moves.split(' ') {
    t = m.trim();
    if t == "x" {
      if drop(l) != Step.Blocked { done += 1; }
      continue;
    }
    pulling = t.starts_with("p");
    d = if pulling { t[1..] } else { t };
    dx = if d == "a" { -1 } else if d == "d" { 1 } else { 0 };
    dy = if d == "w" { -1 } else if d == "s" { 1 } else { 0 };
    if dx == 0 && dy == 0 { continue; }
    step = if pulling { pull(l, dx, dy) } else { walk(l, dx, dy) };
    if step != Step.Blocked { done += 1; }
  }
  done
}

// --- Goals ---

/// Is the hero out in the open, under the sky?
pub fn in_daylight(l: const Level) -> boolean {
  tile_world::open_sky(l.w, l.hero_x, l.hero_y, l.hero_z)
    && tile_world::terrain(l.w, l.hero_x, l.hero_y, l.hero_z) != VOID
}
